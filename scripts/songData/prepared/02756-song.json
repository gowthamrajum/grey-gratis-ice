{
  "song_name": "Yaesu Mammu Nadipinchu Needhu Kaapu",
  "author": {
    "Authored by": "",
    "రచన": "ఓకబ్ చేంబర్లేన్"
  },
  "main_stanza": {
    "telugu": [
      "యేసు, మమ్ము నడిపించు నీదు కాపు కావలెన్",
      "నీవు మమ్మును బోషించు మమ్ముఁ జేర్చు మందలోన్",
      "యేసునాధా, ప్రియనాధా! మిమ్ము విమోచించుమా."
    ],
    "english": [
      "Yaesu, Mammu Nadipinchu Needhu Kaapu Kaavalen",
      "Neevu Mammunu Boashinchu Mammu Jaerchu Mandhaloan",
      "Yaesunaadhaa, Priyanaadhaa! Mimmu Vimoachinchumaa."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మమ్ము నాదరించు యేసూ మాకు పాలకుండవు",
        "పాప మార్గమందు నుండి ప్రేమతో! దప్పించుమీ",
        "యేసునాధా, ప్రియనాధా! మొఱ్ఱ నాలకించుమా."
      ],
      "english": [
        "Mammu Naadharinchu Yaesoo Maaku Paalakundavu",
        "Paapa Maargamandhu Nundi Praemathoa! Dhappinchumee",
        "Yaesunaadhaa, Priyanaadhaa! Morra Naalakinchumaa."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బీద పాపు లైన మమ్ము నీ వంగీకరింతువు",
        "మమ్మును బవిత్రపర్చి మమ్ము విడిపించుమీ",
        "యేసునాధా, ప్రియనాధా! నిన్ను నాశ్రయింతుము"
      ],
      "english": [
        "Beedha Paapu Laina Mammu Nee Vangeekarinthuvu",
        "Mammunu Bavithraparchi Mammu Vidipinchumee",
        "Yaesunaadhaa, Priyanaadhaa! Ninnu Naashrayinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బాల్యమందు నిన్నుఁ జేరి నిన్ను హత్తుకొందుము",
        "ప్రియ రక్షకుండ, యేసూ నీ ప్రేమఁ జూపుమా",
        "యేసునాధా, ప్రియనాధా! మమ్మింకఁ బ్రేమించుమా."
      ],
      "english": [
        "Baalyamandhu Ninnu Jaeri Ninnu Haththukondhumu",
        "Priya Rakshakunda, Yaesoo Nee Praema Joopumaa",
        "Yaesunaadhaa, Priyanaadhaa! Mamminka Braeminchumaa."
      ]
    }
  ]
}
