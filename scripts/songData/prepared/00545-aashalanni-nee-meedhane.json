  "main_stanza": {
    "telugu": [
      "ఆశలన్నీ నీ మీదనే తీర్చవా ప్రభూ",
      "నా ఆశలన్నీ నీ మీదనే తీర్చవా ప్రభూ"
    ],
    "english": [
      "Aashalannee Nee Meedhane Theerchavaa Prabhoo",
      "Naa Aashalannee Nee Meedhane Theerchavaa Prabhoo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీరిక్షణ కలిగి ఎదురు చూచుచుంటిని",
        "పక్షి రాజు యవ్వనం వలె నూతన పరచుమా",
