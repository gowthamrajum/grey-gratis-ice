{
  "song_name": "Nee Udayakanthilo",
  "author": {
    "Authored by": "Lillian Christopher",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ ఉదయ కాంతిలో – నే నడచివెళ్ళెద",
      "నీ అడుగు జాడలే నే అనుసరించెద",
      "నదివలె నీ సమాధానము – విడిచిపోని సహవాసము",
      "నా తోడుగా ఉంచావయ్యా – నా తండ్రివై నా యేసయ్య"
    ],
    "english": [
      "Nee udaya kaantilo – ne nadachivellada",
      "Nee adugu jaadalae ne anusarinchada",
      "Nadivale nee samaadhaanamu – vidichiponi sahavaasamu",
      "Naa todugaa unchaavayya – naa tandrivi naa Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ వాక్యపు వెలుగులో",
        "నా స్థితిని చూచితి",
        "నా భారము, నా భయమును,",
        "తొలగించి దరి చేరితివి",
        "చీకటిలోనుండి ఆశ్చర్యమైన",
        "నీ వెలుగుకు పిలచిన దేవా",
        "నా రక్షణ దీపం వెలిగించినావే",
        "నీ మహిమకై ప్రకాశించెద",
        "ఏ జలమైనా ఏ జ్వాలైనా",
        "నే భయముచెందను",
        "విశ్వాసమే నా బలం",
        "నీతోనే విజయము",
        "నను మరువని నీ ప్రేమ, విడువని నీ కృపకు,",
        "మరిఏదీ సాటిరాదయా",
        "ఆ ప్రేమను తలచి, నీలోనే నిలచి,",
        "నీ కృపలో సాగెదనయ్యా"
      ],
      "english": [
        "Nee vaakayapu velugulo",
        "naa sthitini choochiti",
        "Naa bhaaramu, naa bhayamunu,",
        "tolaginchi dari cheritivi",
        "Cheekatilonundi aascharyamaina",
        "nee veluguku pilachina Devaa",
        "Naa rakshana deepam veliginchinaave",
        "nee mahimakai prakaashinchada",
        "Ee jalamaina ee jwaalaina",
        "ne bhayamuchendanu",
        "Vishvaasame naa balam",
        "neetone vijayamu",
        "Nanu maruvani nee prema, viduvani nee krupaku,",
        "mari edhi saatiraadaya",
        "Aa premanu talachi, neelone nilachi,",
        "nee krupalo saagedanayya"
      ]
    }
  ]
}
