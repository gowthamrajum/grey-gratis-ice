  },
  "main_stanza": {
    "telugu": [
      "భయము లేదుగా మనకు భయము లేదుగా",
      "దయగల మన దేవుడుండ భయము లేదుగా"
    ],
    "english": [
      "Bhayamu Laedhugaa Manaku Bhayamu Laedhugaa",
      "Dhayagala Mana Dhaevudunda Bhayamu Laedhugaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్షామ మరణ యుద్ధ ఖడ్గ బలము నుండియు",
        "ధరణి గిరులు అదరి సముద్రములు పొంగిన",
        "పరిశుద్ధుడు యేసుడే నిత్యము కాపాడు గనుక"
      ],
      "english": [
        "Kshaama Marana Yudhdha Khadga Balamu Nundiyu",
        "Dharani Girulu Adhari Samudhramulu Pongina",
        "Parishudhdhudu Yaesudae Nithyamu Kaapaadu Ganuka"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అపవాది తంత్రములపై విజయమిచ్చును",
        "అభయమిచ్చి క్షేమముగా ఆదరించును",
        "అక్షయుడగు యేసుడే నిత్యము కాపాడు గనుక"
      ],
      "english": [
        "Apavaadhi Thanthramulapai Vijayamichchunu",
        "Abhayamichchi Kshaemamugaa Aadharinchunu",
        "Akshayudagu Yaesudae Nithyamu Kaapaadu Ganuka"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దివారాత్రులు దేవుడు ధైర్యపరచును",
        "ఈ కాలపు శ్రమలే మనల మార్చు మహిమకు",
        "నిర్మలుడగు యేసుడే నిత్యము కాపాడు గనుక"
      ],
      "english": [
        "Dhivaaraathrulu Dhaevudu Dhairyaparachunu",
        "Ee Kaalapu Shramalae Manala Maarchu Mahimaku",
        "Nirmaludagu Yaesudae Nithyamu Kaapaadu Ganuka"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శ్రమలు దుఃఖ బాధలెన్నో మనకు సోకిన",
        "ఏకీడు తగులకుండ కాయుశక్తితో",
        "శక్తిమంతుడు యేసుడే నిత్యము కాపాడు గనుక"
      ],
      "english": [
        "Shramalu Duhkha Baadhalennoa Manaku Soakina",
        "Aekeedu Thagulakunda Kaayushakthithoa",
        "Shakthimanthudu Yaesudae Nithyamu Kaapaadu Ganuka"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాడెదము మన ప్రభునకే హృదయ గీతము",
        "మహిమరాజు మనకొరకై తిరిగి వచ్చును",
        "మన ప్రభువగు యేసుడే నిత్యము కాపాడు గనుక"
      ],
      "english": [
        "Paadedhamu Mana Prabhunakae Hrudhaya Geethamu",
        "Mahimaraaju Manakorakai Thirigi Vachchunu",
        "Mana Prabhuvagu Yaesudae Nithyamu Kaapaadu Ganuka"
      ]
    }
  ]
