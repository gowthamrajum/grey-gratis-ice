      "english": [
        "Paralokam nundi doraa naralokam vachchindu",
        "Mana seekati bathukullo eluthure thechchindu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సెంతజేరినోళ్ళకంత సింతలన్ని బాపెనంట",
        "ఎంతటి రోగాలైనా సిటికెలో తీసేసెనంట"
      ],
      "english": [
        "Senthajerinollakantha sinthalanni baapenanta",
        "Enthati rogaalainaa sitikelo theesesenanta"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సొరగానికి దారిసూప అడుగుబెట్టె భూమిమీద",
        "మరణానికి బుద్దిసెప్ప కన్నుమూసె సిలువమీద"
      ],
      "english": [
        "Soragaaniki dhaarisoopa adugubette bhoomimeedha",
        "Maranaaniki buddhiseppa kannumoose siluvameedha"
