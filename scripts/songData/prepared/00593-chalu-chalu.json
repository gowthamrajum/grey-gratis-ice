  "main_stanza": {
    "telugu": [
      "చాలు చాలు చాలు",
      "నాకు యేసు చాలు చాలు చాలు (2)"
    ],
    "english": [
      "Chalu Chalu Chalu",
      "Naku Yesu Chalu Chalu Chalu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అమ్మ నాన్న కన్నా నా యేసుని ప్రేమ మిన్న",
        "నన్ను తన కౌగిట్లో తను హత్తుకుంటాడు"
      ],
      "english": [
        "Amma Nanna Kanna Na Yesuni Prema Minna",
        "Nannu Tana Kaugitlo Tanu Hattukumtadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అక్కా అన్న కన్నా నా యేసుని ప్రేమ మిన్న",
        "నాతో ఆటలాడి సరదాగా వుంటాడు"
      ],
      "english": [
        "Akka Anna Kanna Na Yesuni Prema Minna",
        "Nato Ataladi Saradaga Vumtadu"
      ]
    }
  ]
}
