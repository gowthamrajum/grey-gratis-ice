{
  "song_name": "Yesu nee sadhaathma vrushti",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఎలిజబెత్ కాడ్నర్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "యేసు, నీ సదాత్మ వృష్టి",
      "భక్తు లెల్లవారిపై",
      "నీవు కుమ్మరింపఁగాను",
      "నాపైఁ గుమ్మరించుమీ.",
      "|| నన్నునున్, నన్ను నున్",
      "నన్నాశీర్వదించుమీ ||"
    ],
    "english": [
      "Yesu, nee sadhaathma vrushti",
      "Bhakthu lellavaaripai",
      "Neevu kummarimpagaanu",
      "Naapai gummarinchumee.",
      "|| Nannunun, nannu nun",
      "Nannaasheervadhinchumee ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "తండ్రి, నన్ను దాఁటవద్దు",
        "పాపి నంచు వేఁడెదన్",
        "నీ మన్నింపు నీదు కృప",
        "నా కనుగ్రహించుమీ"
      ],
      "english": [
        "Thandri, nannu dhaatavaddhu",
        "Paapi nanchu vedhedhan",
        "Nee mannimpu needu krupa",
        "Naa kanugrahinchumee"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రక్షకా, నన్ దాఁటి పోకు",
        "నేను నిన్ను నమ్మితిన్",
        "నీదు దయ పూర్తిగాను",
        "నాపైఁ గుమ్మరించుమీ."
      ],
      "english": [
        "Rakshakaa, nan daati poku",
        "Nenu ninnu nammithin",
        "Needu daya poorthigaanu",
        "Naapai gummarinchumee."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పావనాత్మ, దాఁటి పోకు",
        "నేను గుడ్డివాఁడను",
        "జ్ఞానదృష్టి నాకు నిమ్ము",
        "నాకు దైవ శక్తి నీ."
      ],
      "english": [
        "Paavanaathma, daati poku",
        "Nenu guddivaadanu",
        "Gnaanadhrushti naaku nimmu",
        "Naaku daiva shakthi nee."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మాఱనట్టి దైవ ప్రేమ.",
        "క్రీస్తు రక్త పుణ్యము",
        "పావనాత్మ ప్రేరణంబు",
        "నిండుగాను బోయుమీ."
      ],
      "english": [
        "Maaranatti daiva prema.",
        "Kreesthu raktha punyamu",
        "Paavanaathma preranambu",
        "Nindugaanu boyumee."
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నన్ను దాఁటిపోక యేసు",
        "నీకు సేవచేయ నా",
        "హృదయంబును బంధించి",
        "నన్నాశీర్వదించుమీ"
      ],
      "english": [
        "Nannu dhaatipoka Yesu",
        "Neeku sevacheya naa",
        "Hrudhayambunu bandhinchi",
        "Nannaasheervadhinchumee"
      ]
    }
  ]
}
