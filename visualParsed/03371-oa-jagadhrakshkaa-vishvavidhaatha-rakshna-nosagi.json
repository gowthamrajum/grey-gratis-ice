{
  "song_name": "O jagadhrakshakaa vishvavidhaatha rakshana nosagithivi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఓ జగద్రక్షకా విశ్వవిధాత - రక్షణ నొసగితివి",
      "సర్వకృపలకు దాతవు నీవే - బలియైతివి మాకై"
    ],
    "english": [
      "O jagadhrakshakaa vishvavidhaatha - Rakshana nosagithivi",
      "Sarvakrupalaku daathavu neeve - Baliyaithivi maakai"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృపద్వారా రక్షణ మాకొసగె - విశ్వాసము ద్వారానే",
        "అపాత్రులమైనట్టి మాకు - యిది నీ వరమేగా"
      ],
      "english": [
        "Krupadhvaaraa rakshana maakosage - Vishwaasamu dwaaraane",
        "Apaathrulamainatti maaku - Idhi nee varamegaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపములో మేము మరణించినప్పుడు - వచ్చితివి యిలకు",
        "ప్రభువా మేము నీ చెంతనుండ - జీవము నిచ్చితివి"
      ],
      "english": [
        "Paapamulo memu maraninchinappudu - Vachchithivi ilaku",
        "Prabhuvaa memu nee chenthanunda - Jeevamu nichchithivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపభారముచే పడిచెడియున్న - మమ్మును గాంచితివి",
        "కృప ద్వారానే మమ్మును పిలిచి శాంతిని వొసగితివి"
      ],
      "english": [
        "Paapabhaaramuche padichediyunna - Mammunu gaanchithivi",
        "Krupa dwaaraane mammunu pilichi shaanthini vosagithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రక్షణ సందేశమును ప్రభువా ప్రచురము చేసితివి",
        "రయముగ విశ్వసించిన మాకు ఆత్మను వొసగితివి"
      ],
      "english": [
        "Rakshana sandheshamunu prabhuvaa prachuramu chesithivi",
        "Rayamuga vishwasinchina maaku aathmanu vosagithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మరుగైన వాటిని అజ్ఞానులకు బయలుపరచితివి",
        "మర్మములను గ్రహియించుటకు జ్ఞానము నొసగితివి"
      ],
      "english": [
        "Marugaina vaatini ajnaanulaku bayaluparachithivi",
        "Marmamulanu grahiyinchutaku jnaanamu nosagithivi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సేవను మాకు నిచ్చితివయ్యా యుగయుగముల వరకు",
        "శక్తిమంతులమై నిను స్తుతియింప విజయము నొసగితివి"
      ],
      "english": [
        "Sevanu maaku nichchithivayyaa yugayugamula varaku",
        "Shakthimanthulamai ninu sthuthiyimpa vijayamu nosagithivi"
      ]
    }
  ]
}
