{
  "song_name": "Manovilasithambau dhinambu mahimaanvithambu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఇ జి ఆనందము"
    ]
  },
  "main_stanza": {
    "telugu": [
      "మనోవిలసితంబౌ దినంబు మహిమాన్వితంబు అనంతజగతీమనోహ",
      "రంబు ఘనాదిప్రభుయశః ప్రకాశంబు ||మనో||"
    ],
    "english": [
      "Manovilasithambau dhinambu mahimaanvithambu ananthajagateemanoha",
      "Rambu ghanaadhiprabhuyashah prakaashambu ||Mano||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మందమారుతములందము నొసగగ డెందములకు నానందము నిడగా",
        "సుందర పక్షుల సుమధురగానము సుఖావహంబై శోభించెనుగా  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Mandhamaaruthamulandhamu nosagaga dendhamulaku naanandhamu nidagaa",
        "Sundara pakshula sumadhuragaanamu sukhaavahambai shobhinchenugaa  ||Manovilasithambau||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అరుణభాస్కరుని కిరణాకరము ధరదిక్తటముల దరిజేరెనుగా ధరా",
        "వలయమాఖర భానునిచే ధగద్ధగీయంబై వెల్గెనుగా  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Arunabhaaskaruni kiranaakaramu dharadhikthatamula dharijerenugaa dharaa",
        "Valayamaakhara bhaanuniche dhagaddhageeyambai velgenugaa  ||Manovilasithambau||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పులుగిల కిలకిల కలరవములతో పొందుగ గలసిన భూరి రవంబు",
        "లలితమనోహరశ్రావ్యమ వినుమా తలపన్ దానికి కారణమేమో  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Pulugila kilakila kalaravamulatho pondhuga galasina bhoori ravambu",
        "Lalithamanoharashraavyama vinumaa thalapan dhaaniki kaaranamemo  ||Manovilasithambau||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రయమున నొలీవ నగంబుగనుమా రభసయుక్తమగు జనమును గనుమా",
        "జయంజయంబను జయ ధ్యానంబులు వియదంతము జనమ్రోగుట వినుమా  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Rayamuna noleeva nagambuganumaa rabhasayukthamagu janamunu ganumaa",
        "Jayanjayambanu jaya dhyaanambulu viyadhanthamu janamroguta vinumaa  ||Manovilasithambau||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రసన్నవదనుడు భానుతేజుడు అసంఖ్యజనగణ పరివృతబలుడు",
        "ప్రసితరాసభాసీనుడు యేసుడు అసమ శాంతితో నరుదెంచెనహో  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Prasannavadhanudu bhaanuthejudu asankhyajanagana parivruthabaludu",
        "Prasitharaasabhaaseenudu Yesudu asama shaanthitho narudhenchenaho  ||Manovilasithambau||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "జయములు బాడెడు బాల చయముతో సాత్వికుడై రాసభంబు నెక్కి",
        "జయోత్సవంబుతో సర్వేశ్వరుడు చనిహృదయము సమర్పించె దము  ||మనోవిలసితంబౌ||"
      ],
      "english": [
        "Jayamulu baadedu baala chayamutho saathvikudai raasabhambu nekki",
        "Jayothsavambutho sarveshvarudu chanihrudhayamu samarpinche dhamu  ||Manovilasithambau||"
      ]
    }
  ]
}
