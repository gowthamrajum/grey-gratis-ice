{
  "song_name": "Chesevannee adbhuthaale",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Samuel Karmoji"
    ],
    "రచన": [
      "శామ్యూల్ కర్మోజి"
    ]
  },
  "main_stanza": {
    "telugu": [
      "చేసేవన్నీ అద్భుతాలే మరువలేను నీదు మేలే",
      "చేసేవన్నీ అద్భుతాలే మరువలేను నీదు మేలే ||2||",
      "నీవు చేసిన మేళ్లను తలంచినా",
      "కంట కన్నీరు జారకుండా ఆగునా ||2||",
      "నిండు జీవితం నీకర్పించినా ||2||",
      "నీదు ప్రేమకు ఇల సరితూగునా ||2||",
      "|| చేసేవన్నీ ||"
    ],
    "english": [
      "Chesevannee adbhuthaale maruvalenu needu mele",
      "Chesevannee adbhuthaale maruvalenu needu mele ||2||",
      "Neevu chesina mellanu thalanchinaa",
      "Kanta kanneeru jaarakundaa aagunaa ||2||",
      "Nindu jeevitham neekarpinchinaa ||2||",
      "Needu premaku ila sarithoogunaa ||2||",
      "|| Chesevannee ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        ".నా అన్నవారు నను త్రోసినారు",
        "నే కన్నా కలలన్ని చేరిపేసినారు ||2||",
        "నా కొరకు నిలిచి నను దైర్యపరచి",
        "నా వెన్ను తట్టి నను నిలువబెట్టి ||2||",
        "మంచి సమరయునిలా వచ్చి మాలిచావు నన్ను నీవు..  ||చేసేవన్నీ||"
      ],
      "english": [
        ".Naa annavaaru nanu throsinaaru",
        "Ne kannaa kalalanni cheripesinaaru ||2||",
        "Naa koraku nilichi nanu dhairyaparachi",
        "Naa vennu thatti nanu niluvabetti ||2||",
        "Manchi Samarayunilaa vachchi maalichaavu nannu neevu..  ||Chesevannee||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నన్నేరుగువాడు ఒక్కడును లేడని",
        "నా యోగ క్షేమం అడుగువారేరని ||2||",
        "నా మనసు తలచి నిదురనే మరచిన",
        "నను పలకరించి బలపరచినావు ||2||",
        "నాతో తొలి అడుగు వేయించి గెలిపించావు నన్ను నీవు ||2||  ||చేసేవన్నీ||"
      ],
      "english": [
        "Nanneruguvaadu okkadunu ledani",
        "Naa yoga kshemam aduguvaarerani ||2||",
        "Naa manasu thalachi nidurane marachina",
        "Nanu palakarinchi balaparachinaavu ||2||",
        "Naatho tholi adugu veyinchi gelipinchaavu nannu neevu ||2||  ||Chesevannee||"
      ]
    }
  ]
}
