  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జయరాజు జెండా ఎత్తి చూపుచు - యుద్ధముచేయ వెళ్ళెదము",
        "జయమాలతోడ జయ మొందను - ఆనందముతో పాడెదము",
        "వెళ్ళుదాం గెలిచెదం రక్షకుని నామమునను",
        "విజయుడుగా యేలును భువిలో జ్యోతిర్మయముగ"
      ],
      "english": [
        "Jayaraaju jendaa etthi choopuchu - Yudhdhamucheya velledamu",
        "Jayamaalathoda jaya mondhanu - Aanandamutho paadedamu",
        "Velludhaam gelichedham rakshakuni naamamunanu",
        "Vijayudugaa yelunu bhuvilo jyothirmayamuga"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శత్రుసైన్యము గర్జించి వచ్చినన్ - రాజుజెండా చూపెదము",
        "గుమిగూడివచ్చి పోరాడినన్ - మేముజయ మొందెదము"
      ],
      "english": [
        "Shathrusainyamu garjinchi vachchinan - Raajujendaa choopedhamu",
        "Gumigoodivachchi poraadinan - Memujaya mondhedhamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఏ దేశ జాతి బాషవారును - సువార్త వినుటచే",
        "యేసునాథుని పాలన రోజులు - సమీపమైనందున"
      ],
      "english": [
        "E desha jaathi bhaashavaarunu - Suvaartha vinutache",
        "Yesunaathuni paalana rojulu - Sameepamainandhuna"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆ మంచి కాలము వచ్చినంతనే - పరిపాలన చేయును",
        "భక్తిహీనులెల్ల శూన్యులగుదురు - స్థిరపర్చు తన నీతి"
      ],
      "english": [
        "Aa manchi kaalamu vachchinanthane - Paripaalana cheyunu",
        "Bhakthiheenulella shoonyulagudhuru - Sthiraparchu thana neethi"
      ]
    }
  ]
}
