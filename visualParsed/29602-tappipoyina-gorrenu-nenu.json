  "main_stanza": {
    "telugu": [
      "తప్పిపోయిన గొర్రెను నేను",
      "నీ దరికి చేర్చుకో యేసయ్య",
      "యజమానుడా నా యజమానుడా",
      "నీవు తప్ప నాకు ఎవరూలేరయ్యా"
    ],
    "english": [
      "Thappipoyina gorrenu nenu",
      "Nee dariki cherchuko Yesayya",
      "Yajamaanudaa naa yajamaanudaa",
      "Neevu thappa naaku evaroolerayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్ను చేరే మార్గములో నేనుండగా",
        "ముల్లె నా కాళ్లకు అడ్డుగా ఉన్నది",
        "నా దారిలో వెలుగువై",
        "నా చెంతకు నీవు చేరువై",
        "నా దరికి నీవు రావా నా యేసయ్య"
      ],
      "english": [
        "Ninnu chere maargamulo nenundagaa",
        "Mullu naa kaallaku addugaa unnadi",
        "Naa daarilo veluguvai",
        "Naa chenthaku neevu cheruvai",
        "Naa dariki neevu raavaa naa Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అందరు ఉన్నను ఒంటరినైతిని",
        "చెంతనేవున్నను నీకు దూరముగుంటిని",
        "నీతోనే నేను ఉండాలని",
        "నీతోనే నేను నడవాలని",
        "ఆశతో ఉన్నాను యేసయ్య"
      ],
      "english": [
        "Andaru unnanu ontarinaithini",
        "Chenthanevunnanu neeku dhooramaguntini",
        "Neethone nenu undaalani",
        "Neethone nenu nadavaalani",
        "Aashatho unnaanu Yesayya"
      ]
    }
  ]
