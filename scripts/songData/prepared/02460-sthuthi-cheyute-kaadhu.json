  "main_stanza": {
    "telugu": [
      "స్తుతి చేయుటే కాదు ఆరాధన - దేవుని పని చేయుటయే ఆరాధన",
      "గమనించు దేవుని మనసులో ఆవేదన - వినిపించు ఈ సువార్తను ప్రతి వీధిన",
      "Work is worship - దేవునితో fellowship - 2",
      "ఆరాధనా ఆరాధన - ఆత్మను రక్షించుటయే ఆరాధన",
      "ఆరాధనా ఆరాధన - దేవుని పని చేయుటయే ఆరాధన"
    ],
    "english": [
      "Sthuthi Cheyute Kaadhu Aaraadhana - Devuni Pani Cheyutaye Aaraadhana",
      "Gamaninchu Devuni Manasulo Aavedana - Vinipinchu Ee Suvaarthanu Prathi Veedhina",
      "Work Is Worship - Devunitho Fellowship - 2",
      "Aaraadhanaa Aaraadhana - Aathmanu Rakshinchutaye Aaraadhana",
      "Aaraadhanaa Aaraadhana - Devuni Pani Cheyutaye Aaraadhana"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పెదవులతో ఘనపరచి - కూర్చుని లేస్తే సరిపోదు",
        "మోకరించి ప్రార్ధన చేస్తే - పాపి మారడు = 2",
        "ఆత్మతో సత్యముతో - తండ్రిని ఆరాధించాలి",
        "అర్పణ ఆరాధనలు - దేహంతో జరగాలి",
        "మనకున్న అవయవాలు - ప్రభు పనిలో అరగాలి",
        "ఆరాధనా ఆరాధన - ఆత్మను రక్షించుటయే ఆరాధన",
        "ఆరాధనా ఆరాధన - పాపిని రక్షించుటయే ఆరాధన"
      ],
      "english": [
        "Pedavulatho Ghanaparachi - Koorchuni Leste Saripodhu",
        "Mokarinchi Praardhana Cheste - Paapi Maaradu = 2",
        "Aathmatho Sathyamutho - Thandrini Aaraadhinchaali",
        "Arpana Aaraadhanalu - Dehantho Jaragaali",
        "Manakunna Avayavaalu - Prabhu Panilo Aragaali",
        "Aaraadhanaa Aaraadhana - Aathmanu Rakshinchutaye Aaraadhana",
        "Aaraadhanaa Aaraadhana - Paapini Rakshinchutaye Aaraadhana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆత్మల రక్షణ మరిచి - ఆచరిస్తేనే సరిపోదు",
        "ఆజ్ఞ మరిచి ఆరాధిస్తే - పాపి మారడు = 2",
        "ఆత్మను రక్షించే - వాక్యం ప్రకటించాలి",
        "బైబిల్ బాగా నేర్చుకుని - లోకానికి వెళ్లాలి",
        "దేహాన్ని దేవుని సేవకు - సజీవంగా ఇవ్వాలి",
        "ఆరాధనా ఆరాధన - ఆత్మను రక్షించుటయే ఆరాధన",
        "ఆరాధనా ఆరాధన - దేవుని పని చేయుటయే ఆరాధన"
      ],
      "english": [
