  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభువా తరతరముల నుండి - మాకు నివాసస్థలము నీవే",
        "యుగ యుగములకు నీవే మా",
        "దేవుడవు, దేవుడవు, దేవుడవు, దేవుడవు"
      ],
      "english": [
        "Prabhuvaa tharatharamula nundi - Maaku nivaasasthalamu neeve",
        "Yuga yugamulaku neeve maa",
        "Devudavu, devudavu, devudavu, devudavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పుట్టింపక మునుపే నీవు",
        "వున్నావు, వున్నావు, వున్నావు, వున్నావు"
      ],
      "english": [
        "Puttimpaka munupe neevu",
        "Vunnaavu, vunnaavu, vunnaavu, vunnaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నరపుత్రుల మంటికి మార్చి - తిరిగి రండని సెలవిచ్చెదవు",
        "వేయి సంవత్సరములు నీకు",
        "జామువలె, జామువలె, జామువలె, జామువలె"
      ],
      "english": [
        "Naraputhrula mantiki maarchi - Thirigi randani selavichchedhavu",
        "Veyi samvathsaramulu neeku",
        "Jaamuvale, jaamuvale, jaamuvale, jaamuvale"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీదు దుష్టికి వేయి ఏండ్లు - గతించిన నిన్నటి వలె నున్నవి",
        "రాత్రి యందొక జాముకు సమముగ",
        "నున్నవి, వున్నవి, వున్నవి, వున్నవి"
      ],
      "english": [
        "Needu drushtiki veyi endlu - Gathinchina ninnati vale nunnavi",
        "Raathri yandhoka jaamuku samamuga",
        "Nunnavi, vunnavi, vunnavi, vunnavi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీవు వారిని పారగొట్టగ - వరద చేతనైన రీతి",
        "గడ్డివలె చిగిరించి వాడి",
        "పోయెదరు, పోయెదరు, పోయెదరు, పోయెదరు"
      ],
      "english": [
        "Neevu vaarini paaragottaga - Varada chethanaina reethi",
        "Gaddivale chigirinchi vaadi",
        "Poyedharu, poyedharu, poyedharu, poyedharu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రొద్దుట మొలిచి చిగిరించును - సాయంతరమున కోయబడును",
        "వాడబారును నీ కోపముచే",
        "క్షీణించున్, క్షీణించున్, క్షీణించున్, క్షీణించున్"
      ],
      "english": [
        "Prodhdhuta molichi chigirinchunu - Saayantharamuna koyabadunu",
        "Vaadabaarunu nee kopamuche",
        "Ksheeninchun, ksheeninchun, ksheeninchun, ksheeninchun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీదు కోపము వలన మేము - క్షీణించు చున్నాము దేవా",
        "నీ యుగ్రతను బట్టి దిగులు",
        "పొందెదము, పొందెదము, పొందెదము, పొందెదము"
      ],
      "english": [
        "Needu kopamu valana memu - Ksheeninchu chunnaamu Deva",
        "Nee yugrathanu batti digulu",
        "Pondedamu, pondedamu, pondedamu, pondedamu"
      ]
    }
  ]
}
