  "main_stanza": {
    "telugu": [
      "సంఘమా సాగుమా",
      "ప్రభు ప్రేమలో సాగుమా",
      "పరిశుద్ధుల సంఘమై",
      "ప్రభు రాకడ వరకును",
      "క్రీస్తు ప్రేమ హతమార్చిన",
      "సౌలు పౌలుగా మారెనే",
      "పరిశుద్ధుల సంఘమునకై",
      "పత్రికలు వ్రాసెనే",
      "ప్రభు యేసుని వార్తను",
      "ఊరూరా చాటెనే",
      "తుది శ్వాస వరుకు",
      "ప్రభు కొరకై జీవింపసాగెనే",
      "పాపుల కొరకై ప్రభు యేసు",
      "ఈ లోకమునకొచ్చెనే",
      "పరలోకమే స్థిరమని",
      "ప్రకటింప సాగనే",
      "హృదయ శుద్ధి గలవారే",
      "దేవుని చూతురని చెప్పెనే",
      "సిద్ధపడిన వధువు సంఘమునకై",
      "ప్రభు మరల రానుండెనే"
    ],
