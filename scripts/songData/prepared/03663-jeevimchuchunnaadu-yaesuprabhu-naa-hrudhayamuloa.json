{
  "song_name": "Jeevinchuchunnaadu Yaesuprabhu Naa Hrudhayamuloa Nunnaadu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జీవించుచున్నాడు యేసుప్రభు నా హృదయములో నున్నాడు",
      "కష్టములలో నా సహాయుడై నిత్యము జీవించును"
    ],
    "english": [
      "Jeevinchuchunnaadu Yaesuprabhu Naa Hrudhayamuloa Nunnaadu",
      "Kashtamulaloa Naa Sahaayudai Nithyamu Jeevinchunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మాటచే సాగరము పాయలై పోయె",
        "కోటగోడలు కూలి మట్టలైనవి",
        "గ్రుడ్డివాడు దృష్టిపొందె ప్రభు మాటచే",
        "కుష్ఠరోగి శుద్ధుడాయె ప్రభుముట్టగా"
      ],
      "english": [
        "Maatachae Saagaramu Paayalai Poaye",
        "Koatagoadalu Kooli Mattalainavi",
        "Gruddivaadu Dhrushtipondhe Prabhu Maatachae",
        "Kushtaroagi Shudhdhudaaye Prabhumuttagaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నన్ను వదలక పట్టుకొనుము",
        "నిన్ను విడువక వెంబడింతును",
        "మరణించువేళ పరలోకపు",
        "ఇంటికి నడుపు విమోచకుడా"
      ],
      "english": [
        "Nannu Vadhalaka Pattukonumu",
        "Ninnu Viduvaka Vembadinthunu",
        "Maraninchuvaela Paraloakapu",
        "Intiki Nadupu Vimoachakudaa"
      ]
    }
  ]
}
