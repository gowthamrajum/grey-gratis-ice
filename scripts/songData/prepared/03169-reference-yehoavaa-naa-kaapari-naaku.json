{
  "song_name": "Yehoavaa Naa Kaapari Naaku Laemi Kalugadhu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు ప్రభూ కాపరి నాకు - వాసిగా స్తుతించెదన్",
      "యేసు గొఱ్ఱెపిల్లను - పోయెదను తన వెంట"
    ],
    "english": [
      "Yaesu Prabhoo Kaapari Naaku - Vaasigaa SthuthiMchedhan",
      "Yaesu GoRRepillanu - Poayedhanu Thana VeMta"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పచ్చిక పట్లకు - మచ్చికతో నడుపున్",
        "స్వచ్ఛ జలముచెంత - నిచ్చును విశ్రాంతి",
        "ముందు ముందు వెళ్లుచు - పొందుగా రక్షించు నన్ను",
        "తన మాధుర్య స్వరంబున - తనివి దీర్చును"
      ],
      "english": [
        "Pachchika Patlaku - Machchikathoa Nadupun",
        "SvachCha JalamucheMtha - Nichchunu VishraaMthi",
        "MuMdhu MuMdhu VeLluchu - PoMdhugaa RakShiMchu Nannu",
        "Thana MaaDhurya SvaraMbuna - Thanivi Dheerchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మరణపులోయ ద్వారా - సరిగా నడిపించును",
        "అడవి భయములెల్ల - ఎడబాపి రక్షించున్",
        "హత్తి ఒత్తి కట్టి గాయా - లెంతో ఆదరించును",
        "వింతగు ఆయన ప్రేమ సేవలో - సంతోషింతును"
      ],
      "english": [
        "MaraNapuloaya Dhvaaraa - Sarigaa NadipiMchunu",
        "Adavi Bhayamulella - Edabaapi RakShiMchun",
        "Haththi Oththi Katti Gaayaa - LeMthoa AadhariMchunu",
        "ViMthagu Aayana Praema Saevaloa - SaMthoaShiMthunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శత్రుల ముందాహారం - సంసిద్ధము జేయును",
        "నా గిన్నె నిండించి - పొర్లి పారజేసి",
        "కడిగి కడిగి శుద్ధిచేసి - ఆత్మదానమిచ్చెను",
        "వడిగా ఆయన సాయమున - జయమున వెళ్ళెదను"
      ],
      "english": [
        "Shathrula MuMdhaahaaraM - SaMsidhDhamu Jaeyunu",
        "Naa Ginne NiMdiMchi - Porli Paarajaesi",
        "Kadigi Kadigi ShudhDhichaesi - Aathmadhaanamichchenu",
        "Vadigaa Aayana Saayamuna - Jayamuna VeLLedhanu"
      ]
    }
  ]
