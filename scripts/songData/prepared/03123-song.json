{
  "song_name": "Mundhu Kandharunu Jaeranu Endhu Boayinan",
  "author": {
    "Authored by": "",
    "రచన": "జెర్మియా ఇ రేంకిన్"
  },
  "main_stanza": {
    "telugu": [
      "ముందు కందరును జేరను ఎందు బోయినన్ గాపాడి",
      "తొందరల్మ ఱేమ్మిరాక బంధుఁడేసు నిన్ను గావుతన్",
      "యేసుని సన్నిధి నేకమైగూడుదాఁక దాసుని ధీరతన్",
      "దైవపిత నిన్ను గావుతన్"
    ],
    "english": [
      "Mundhu Kandharunu Jaeranu Endhu Boayinan Gaapaadi",
      "Thondharalma Raemmiraaka Bandhudaesu Ninnu Gaavuthan",
      "Yaesuni Sannidhi Naekamaigoodudhaaka Dhaasuni Dheerathan",
      "Dhaivapitha Ninnu Gaavuthan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఱెక్క నీడ నిన్నుఁ జేర్చుచు మిక్కుటంపు ప్రేమఁజూపిఁ",
        "చిక్కులాప తిల్లకుండ మక్కువన్ ప్రభుండుగావుతన్"
      ],
      "english": [
        "Rekka Needa Ninnu Jaerchuchu Mikkutampu Praemajoopi",
        "Chikkulaapa Thillakunda Makkuvan Prabhundugaavuthan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాఁడు నాడాహారమిచ్చుచు వేడుకన్ గౌగిటఁ జేర్చి",
        "కీడులందు నిన్ను గాంచి ఱేడునిన్నుఁ బ్రోచికావుతన్"
      ],
      "english": [
        "Naadu Naadaahaaramichchuchu Vaedukan Gaugita Jaerchi",
        "Keedulandhu Ninnu Gaanchi Raeduninnu Broachikaavuthan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "చావు యొక్క భీతిలేకను జీవమార్గమందుఁ దోడై",
        "రేవుఁజేరుఁదాక బ్రోచి పావనుండు నిన్ను గావునన్"
      ],
      "english": [
        "Chaavu Yokka Bheethilaekanu Jeevamaargamandhu Dhoadai",
        "Raevujaerudhaaka Broachi Paavanundu Ninnu Gaavunan"
      ]
    }
  ]
}
