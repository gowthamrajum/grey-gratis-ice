    "english": [
      "Naa chinni thandri paraloka raajaa",
      "baala yesugaa",
      "pavalinchithivi pasula paakalo",
      "needhu jananamu maanavaaliki",
      "entho paravasamu",
      "needhu jananamu lokaaniki",
      "entho subhodhayam",
      "needhu jananamu maaku",
      "ila rakshanaku sreekaaramu"
    ]
  },
  "stanzas": [
