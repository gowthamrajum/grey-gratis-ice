{
  "song_name": "SthuthiyiMchu Prabhun SthuthiyiMchu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతియించు ప్రభున్ స్తుతియించు నీవు",
      "నా ప్రాణమా నా సమస్తమా"
    ],
    "english": [
      "SthuthiyiMchu Prabhun SthuthiyiMchu Neevu",
      "Naa PraaNamaa Naa Samasthamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆయన చేసిన ఉపకారములలో",
        "నా ప్రాణమా నీవు మరువకుమా - దేనిన్ - నా",
        "నీ దేవుని నీవు మరువకుమా"
      ],
      "english": [
        "Aayana Chaesina Upakaaramulaloa",
        "Naa PraaNamaa Neevu Maruvakumaa - Dhaenin - Naa",
        "Nee Dhaevuni Neevu Maruvakumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దోషములను మన్నించి వేసి",
        "నీ రోగముల నన్నింటిని - ప్రభు - నీకు",
        "దుర్చి వేయుచున్నాడు"
      ],
      "english": [
        "Nee DhoaShmulanu ManniMchi Vaesi",
        "Nee Roagamula NanniMtini - Prabhu - Neeku",
        "Dhurchi Vaeyuchunnaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా ప్రాణమును సమాధి నుండి",
        "విమోచించిన వాడని - ప్రభు - విమో",
        "కరుణా కిరీటము నియ్యన్"
      ],
      "english": [
        "Naa PraaNamunu SamaaDhi NuMdi",
        "VimoachiMchina Vaadani - Prabhu - Vimoa",
        "KaruNaa Kireetamu Niyyan"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పక్షిరాజు యౌవనము వలె",
        "నూతన యౌవన ముండునట్లు - నీకు - నూతన",
        "మేలుతో తృప్తిపరచును"
      ],
      "english": [
        "PakShiraaju Yauvanamu Vale",
        "Noothana Yauvana MuMdunatlu - Neeku - Noothana",
        "Maeluthoa Thrupthiparachunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "దీర్ఘశాంతుడు దయగల దేవుడు",
        "యెల్లప్పుడు వ్యాజ్యమాడడు - నీతో - ఎల్లప్పుడు",
        "ప్రతీకారము చేయడు"
      ],
      "english": [
        "DheerghashaaMthudu Dhayagala Dhaevudu",
        "Yellappudu Vyaajyamaadadu - Neethoa - Ellappudu",
        "Pratheekaaramu Chaeyadu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "భూమికంటె ఎంత ఆకాశమెత్తో",
        "భక్తుల యెడల కృపనంత - తన - భక్తుల",
        "అధికముగా చేసియున్నాడు"
      ],
      "english": [
        "BhoomikMte EMtha Aakaashameththoa",
        "Bhakthula Yedala KrupanMtha - Thana - Bhakthula",
        "ADhikamugaa Chaesiyunnaadu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పడమటికి తూర్పెంత యెడమో",
        "పాపములకును మనకంత - మన - పాప",
        "యెడము గలుగ జేసెను"
      ],
      "english": [
        "Padamatiki ThoorpeMtha Yedamoa",
        "Paapamulakunu ManakMtha - Mana - Paapa",
        "Yedamu Galuga Jaesenu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "తండ్రి తన కుమారుని యెడల",
        "జాలిపడునట్లు యెహోవా - బహు - జాలి",
        "భక్తులపై జాలిపడును"
      ],
      "english": [
        "ThMdri Thana Kumaaruni Yedala",
        "Jaalipadunatlu Yehoavaa - Bahu - Jaali",
        "Bhakthulapai Jaalipadunu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "మంటివాడవని ఆయన యెరుగున్",
        "నిర్మింపబడిన విధమెరుగున్ - నీవు - నిర్మి",
        "నీ దేవుడు నిన్ను నెరుగును"
      ],
      "english": [
        "MMtivaadavani Aayana Yerugun",
        "NirmiMpabadina ViDhamerugun - Neevu - Nirmi",
        "Nee Dhaevudu Ninnu Nerugunu"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "దేవదూతలారా దైవభక్తులారా",
        "యెహోవా మహాసైన్యములారా - ఓ - యెహోవా",
        "హల్లెలూయ పాట పాడుడి"
      ],
      "english": [
        "Dhaevadhoothalaaraa Dhaivabhakthulaaraa",
        "Yehoavaa Mahaasainyamulaaraa - Oa - Yehoavaa",
        "Hallelooya Paata Paadudi"
      ]
    }
  ]
}
