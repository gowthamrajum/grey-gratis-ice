  "main_stanza": {
    "telugu": [
      "క్రైస్తవకర్షక కదిలిరావయ్యా",
      "కన్నులు తెరచి కానవేమయ్యా"
    ],
    "english": [
      "Kraisthavakarshaka kadhiliraavayyaa",
      "Kannulu therachi kaanavemayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మనుష్యకుమారుడైన క్రీస్తుయేసు మంచివిత్తనమును",
        "విత్తెమున్న భూలోకంబనెడు పొలంబునందున",
        "వాక్యంబనె విత్తనంబు విత్తెను  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Manushyakumaarudaina Kreesthuyesu manchivitthanamunu",
        "Vitthemunna bhoolokambanedu polambunandhuna",
        "Vaakyambane vitthanambu vitthenu ||Kraisthavakarshaka||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆదిమ క్రైస్తవ బోధకుల వేదనతోను వాక్యంబు విత్తె",
        "రోదనతోను రక్తంబును గార్చి ప్రాణంబులను",
        "దానంబుజేసిరి  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Aadhima kraisthava bodhakula vedhanathonu vaakyambu vitthe",
        "Rodhanathonu rakthambunu gaarchi praanambulanu",
        "Dhaanambujesiri ||Kraisthavakarshaka||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "చల్లిన వాక్యము ఫలియింపను తొలకరి వర్షము",
        "గురిపించెను విలువైన ఫలములు ఫలియించువరకు",
        "కడవరి వర్షము కొరకు వేడుదం  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Challina vaakyamu phaliyimpanu tholakari varshamu",
        "Kuripinchenu viluvaina phalamulu phaliyinchuvaraku",
        "Kadavari varshamu koraku vedhudham ||Kraisthavakarshaka||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పొలములు తెల్లబారె తేరిచూడు కాలము చాల",
        "గతించిపోయె కోతయజమా నుడైన క్రీస్తుని",
        "కోతవారిని పంప కోరివేడుదం  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Polamulu thellabaare therichoodu kaalamu chaala",
        "Gathinchipoye kothayajamaa nudaina Kreesthuni",
        "Kothavaarini pampa korivedhudham ||Kraisthavakarshaka||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శత్రువగు సాతానుకూడా చెడ్డవిత్తనాలు చల్లిపోయె",
        "గోధుమల మధ్య గురుగులు కూడ ఘోరంబుగాను",
        "పెరుగుచుండెను  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Shathruvagu Saathaanukoodaa cheddavitthanaalu challipoye",
        "Godhumala madhya gurugulu kooda ghorambugaanu",
        "Peruguchundenu ||Kraisthavakarshaka||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కన్నీళ్ళతో విత్తు క్రైస్తవుడా కలవర మొందెద",
        "వెందులకు సంతోషముతో సంగీతాలతోను",
        "సాగిపోవుదుము ఆగిపోకను  ||క్రైస్తవకర్షక||"
      ],
      "english": [
        "Kanneellatho vitthu kraisthavudaa kalavara mondheda",
        "Vendhulaku santhoshamutho sangeethaalathonu",
        "Saagipovudhumu aagipokanu ||Kraisthavakarshaka||"
      ]
    }
  ]
