  "main_stanza": {
    "telugu": [
      "కథే మొదలాయెనె ఇలా",
      "కలం….. రచించలేదుగా",
      "మదే….ఊహించలేదిలా",
      "నీ ప్రేమ నన్ను వెదకి-సర్వాన్ని మార్చేగా"
    ],
    "english": [
      "Kadhe modalayele ila",
      "Kalam rachinchaleduga",
      "Madhe oohinchaledila",
      "Ne prema nannu vedaki sarvanni marchega"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ మాటను వినక నేనున్నా",
