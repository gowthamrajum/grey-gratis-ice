{
  "song_name": "Kalavara Padi Ne Kondala Vaipu",
  "author": {
    "Authored by": "Bro  Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కలవర పడి నే కొండల వైపు నా కన్నులెత్తుదునా?",
      "కొండలవైపు నా కనులెత్తి - కొదువతో నేను కుమిలెదనా? (2)",
      "నీవు నాకుండగా - నీవే నా అండగా",
      "నీవే నా ఆత్మదాహము తీర్చినా - వెంబడించిన బండవు"
    ],
    "english": [
      "Kalavara Padi Ne Kondala Vaipu Naa Kannuletthudunaa?",
      "Kondalavaipu Naa Kanuletthi - Koduvatho Nenu Kumiledanaa? (2)",
      "Neevu Naakundagaa - Neeve Naa Andagaa",
      "Neeve Naa Aathmadaahamu Theerchinaa - Vembadinchina Bandavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వకృపానిధివి - సంపదల ఘనివి -2",
        "సకలము -3 సకలము - చేయగల నీ వైపే",
        "నా కన్నులెత్తి చూచెద"
      ],
      "english": [
        "Sarvakrupaanidhivi - Sampadala Ghanivi -2",
        "Sakalamu -3 Sakalamu - Cheyagala Nee Vaipe",
        "Naa Kannuletthi Choocheda"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్యమూ కదలని - సీయోను కొండపై -2",
        "యేసయ్యా -3 యేసయ్యా - నీదు ముఖము చూచుచూ",
        "పరవశించి పాడెద"
      ],
      "english": [
        "Nithyamoo Kadalani - Seeyonu Kondapai -2",
        "Yesayyaa -3 Yesayyaa - Needu Mukhamu Choochuchoo",
        "Paravashinchi Paadeda"
      ]
    }
  ]
