{
  "song_name": "Nede viraboosele hrudaya nethrambule",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Rev S Vijay Paul",
      "JK Christopher",
      "Mrs Grace Lezitha Joshua"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నేడే విరబూసెలే హృదయ నేత్రంబులే",
      "రాగస్తొత్రాల స్వరములతోడ",
      "నేడే ఆనందమే యేసు ఉదయించెనె",
      "నా మదిలొన అరుణొదయ కాంతికిరణము"
    ],
    "english": [
      "Nede viraboosele hrudaya nethrambule",
      "Raagasthothraala swaramulathoda",
      "Nede aanandame Yesu udhayinchene",
      "Naa madilona arunodhaya kaanthikiranamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకట్లు బాప వెలిగిచ్చె ఈభువిలొ",
        "తన శాంతియే మనకిచ్చె పశులశాలలొ",
        "చెరనుండి విడుదల మరణంబు లెదిక",
        "ణిత్య సుఖశాంతియే మనకు నొసగు ఇలలొ ||2||"
      ],
      "english": [
        "Cheekatlu baapa veligichche eebhuvilo",
        "Thana shaanthiye manakichche pashulashaalalo",
        "Cheranundi vidudala maranambu ledika",
        "Nithya sukhashaanthiye manaku nosagu ilalo ||2||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఙ్ఞానులేతెంచె ఆనాడు బెత్లెహేములో",
        "లోకరక్షకుని దరిచేరి స్తుతియింపగా",
        "ఈ దినమే రక్షన అడిగినచో ఇచ్చును ||2||",
        "నిత్యజీవమును నేడే పొందెద నీవు ||2||"
      ],
      "english": [
        "Gnaanuletenche aanaadu Bethlehemulo",
        "Lokarakshakuni dharicheri sthuthiyimpagaa",
        "Ee diname rakshana adiginacho ichchunu ||2||",
        "Nithyajeevamunu nede pondeda neevu ||2||"
      ]
    }
  ]
}
