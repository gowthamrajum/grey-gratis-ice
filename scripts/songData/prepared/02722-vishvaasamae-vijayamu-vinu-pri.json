{
  "song_name": "Vishvaasamae Vijayamu Vinu Priyudaa",
  "author": {
    "Authored by": "",
    "రచన": "మురారి దావీదు"
  },
  "main_stanza": {
    "telugu": [
      "విశ్వాసమే విజయము విను ప్రియుఁడా య విశ్వాస మపజయము",
      "విశ్వాసాయుతమైన విసుకని సుకార్యములే",
      "విశ్వాసవంతునికి విజయ మొసంగును నిజము"
    ],
    "english": [
      "Vishvaasamae Vijayamu Vinu Priyudaa Ya Vishvaasa Mapajayamu",
      "Vishvaasaayuthamaina Visukani Sukaaryamulae",
      "Vishvaasavanthuniki Vijaya Mosangunu Nijamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భక్తుఁ డందు వలననే బ్రతుకును మరియు శక్తినొంది నిల్చును",
        "యుక్తముగ వర్తించి యుర్విని జయించి",
        "ముక్తినొందున టంచు రక్తిగాఁ బాడుదును"
      ],
      "english": [
        "Bhakthu Dandhu Valananae Brathukunu Mariyu Shakthinondhi Nilchunu",
        "Yukthamuga Varthinchi Yurvini Jayinchi",
        "Mukthinondhuna Tanchu Rakthigaa Baadudhunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మంచి పేరు నొందును సాతాను నెది రించి విజయ మొందును",
        "మించిన బాధ ల్స హించి జయించును",
        "నంచిత మరణము నానంద ముగఁగాంచు"
      ],
      "english": [
        "Manchi Paeru Nondhunu Saathaanu Nedhi Rinchi Vijaya Mondhunu",
        "Minchina Baadha Lsa Hinchi Jayinchunu",
        "Nanchitha Maranamu Naanandha Mugagaanchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రవిమల మొందెదము పాపమునుండి పరిహరింపఁబడుదుము",
        "అవి రతమును మనము నాశ్చర్యముగ ఘనము",
        "భువియందున్ దివియందున్ బుధులతో నొందుదుము"
      ],
      "english": [
        "Pravimala Mondhedhamu Paapamunundi Pariharimpabadudhumu",
        "Avi Rathamunu Manamu Naashcharyamuga Ghanamu",
        "Bhuviyandhun Dhiviyandhun Budhulathoa Nondhudhumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీతిమంతుల మౌదుము నిశ్చయము ప్ర ఖ్యాతి బోధను నేర్తుము",
        "ఆ తండ్రి దత్తముల నన్ని యార్జించుచు",
        "యాతని సుభద్రములో ననయ ముందుము నిజము"
      ],
      "english": [
        "Neethimanthula Maudhumu Nishchayamu Pra Khyaathi Boadhanu Naerthumu",
        "Aa Thandri Dhaththamula Nanni Yaarjinchuchu",
        "Yaathani Subhadhramuloa Nanaya Mundhumu Nijamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరిపూర్ణ విశ్వాసమే క్రియలతో నున్న మరి మంచి విశ్వాసమే",
        "ధరయందున్ బరమందున్ ధన్యాత్మునిగఁ జేయున్",
        "సరగు నద్దానినే సంపాదించుము ప్రియుఁడా"
      ],
      "english": [
        "Paripoorna Vishvaasamae Kriyalathoa Nunna Mari Manchi Vishvaasamae",
        "Dharayandhun Baramandhun Dhanyaathmuniga Jaeyun",
        "Saragu Nadhdhaaninae Sampaadhinchumu Priyudaa"
      ]
    }
  ]
}
