{
  "song_name": "Nimpumu O Prabhuvaa sarva sampoornathatho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నింపుము ఓ ప్రభువా! సర్వ సంపూర్ణతతో",
      "మేము నిండియుండెదము - పరిపూర్ణత నొందెదము"
    ],
    "english": [
      "Nimpumu O Prabhuvaa! Sarva sampoornathatho",
      "Memu nindiyundedhamu - Paripoornatha nondhedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాప క్షమాపణ నిచ్చి - జీవముతో నింపుము",
        "ఆత్మీయ వరమిచ్చిన - బలముతో నిండెదము"
      ],
      "english": [
        "Paapa kshamaapana nichchi - Jeevamutho nimpumu",
        "Aathmeeya varamichchina - Balamutho nindedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరమ సంతోషమిచ్చి - సమాధానంబిమ్ము",
        "చూపించు పరలోకమహిమ - ప్రకాశముతో నింపు"
      ],
      "english": [
        "Parama santhoshamichchi - Samaadhaanambimmu",
        "Choopinchu paralokamahima - Prakaashamutho nimpu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మ ఫలములతో నింపి - ప్రేమ సంతోషము",
        "మంచితనము సాత్వీకము విశ్వాసముతో నింపు"
      ],
      "english": [
        "Aathma phalamulatho nimpi - Prema santhoshamu",
        "Manchithanamu saathveekamu vishwaasamutho nimpu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నింపు సత్యముతో మమ్ము నిల్పు - ప్రత్యక్షతలో",
        "నీ జ్ఞానముతో నింపిన స్తుతితో నిండెదము"
      ],
      "english": [
        "Nimpu sathyamutho mammu nilpu - Prathyakshathalo",
        "Nee gnaanamutho nimpina sthuthitho nindedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరమాశీర్వాదమిచ్చి - తప్పించు యిహమునుండి",
        "అర్హులుగ చేయు పరమునకై - ఆశించుచున్నాము"
      ],
      "english": [
        "Paramaasheervaadhamichchi - Thappinchu ihamunundi",
        "Arhuluga cheyu paramunakai - Aashinchuchunnaamu"
      ]
    }
  ]
}
