{
  "song_name": "Dhayachaeyumu Paapakshmaa Dhay",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దయచేయుము పాపక్షమా దయచేయుము పాప క్షమా యేసుని రక్తము రక్తము వల్లనే||"
    ],
    "english": [
      "dhayachaeyumu paapakShmaa dhayachaeyumu paapa kShmaa yaesuni rakthamu rakthamu vallanae||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తుడుపుము పాపపుడాగులు తుడువుము పాపపుడాగులు ||యేసు||"
      ],
      "english": [
        "thudupumu paapapudaagulu thuduvumu paapapudaagulu ||yaesu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అనుగ్రహించు జయంసదా అనుగ్రహించు జయంసదా ||యేసు||"
      ],
      "english": [
        "anugrahiMchu jayMsadhaa anugrahiMchu jayMsadhaa ||yaesu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇమ్ము నిజసమాధానము ఇమ్ము నిజసమాధానము ||యేసు||"
      ],
      "english": [
        "immu nijasamaaDhaanamu immu nijasamaaDhaanamu ||yaesu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరమపురిని జేరనిమ్ము పరమపురిని జేరనిమ్ము ||యేసు||"
      ],
      "english": [
        "paramapurini jaeranimmu paramapurini jaeranimmu ||yaesu||"
      ]
    }
  ]
}
