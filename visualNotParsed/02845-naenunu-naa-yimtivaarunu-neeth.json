{
  "song_name": "Naenunu Naa Yintivaarunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఏ చార్లెస్ కిన్సింగర్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నేనును నా యింటివారును నీతి సూర్యుని గొలుతుము దీనమనసును",
      "గలిగి దేవుని దివ్యసేవను జేతుము||"
    ],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అనుదినంబును ప్రభుని దలచుచు అలయకను ప్రార్థింతుము అనవరత",
        "మా ప్రభుని చిత్తము ననుకరింతుము పనులలో ||"
      ],
      "english": []
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వేదవాక్య పఠనమందు విసుగు జెందక నుందుము ఆదరంబున",
        "దైవ చిత్తము ననుసరించుచు నడుతుము||"
      ],
      "english": []
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆశతోడను ప్రభుని దినమును నాచరింతుము మరువక విసుకు జెందక",
        "నాలయమునకు పిన్న పెద్దల దెత్తుము ||"
      ],
      "english": []
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సంఘ కార్యక్రమములందు సహకరింతుము ప్రతీతో భంగ పరచెడి",
        "పనులన్నిటి కృంగదీసెదమనిశము ||"
      ],
      "english": []
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమతోడను పొరుగువారిని ప్రియులుగను భావింతుము క్షమయు",
        "స్నేహము నేర్చి ప్రభుకడ శాంతితో జీవింతుము ||"
      ],
      "english": []
    },
    {
      "stanza_number": 6,
      "telugu": [
        "శక్తిగొలది శరీరబలమును శ్రమను క్రీస్తుకు నిత్తుము భక్తితో",
        "హృదయమును పూర్తిగ ప్రభునికే యర్పింతుము ||"
      ],
      "english": []
    },
    {
      "stanza_number": 7,
      "telugu": [
        "చిన్నవారలు దైవరాజ్యపు చిఱుత వారసులంచును అన్నివేళల వారి",
        "వృద్ధికి మిన్నగ దోడ్పడెదము ||"
      ],
      "english": []
    },
    {
      "stanza_number": 8,
      "telugu": [
        "పెద్దవారలు దైవజనులని పేర్మితో భావింతుము శుద్ధుడగు ప్రభు క్రీస్తు",
        "మనసును శ్రద్ధతోడను జూపుచు ||"
      ],
      "english": []
    },
    {
      "stanza_number": 9,
      "telugu": [
        "జీవితంబున ప్రభుని ప్రేమా శ్శీసులను ప్రసరింతుము దివ్యజ్యోతుల",
        "రీతి వెలుగుచు దివ్యసన్నిధి నుందుము ||"
      ],
      "english": []
    }
  ]
}
