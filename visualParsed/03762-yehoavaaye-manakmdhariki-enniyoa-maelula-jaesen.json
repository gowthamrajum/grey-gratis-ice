        "ఎంత అద్భుత రక్షకుడు"
      ],
      "english": [
        "Manamaayana janamu - Aayana santhathiyu",
        "Siluva maranamudvaaraa manaku - Thanadu jeevamunichche",
        "Entha adbhutha rakshakudu"
      ]
    },
    {
      "stanza_number": 2,
