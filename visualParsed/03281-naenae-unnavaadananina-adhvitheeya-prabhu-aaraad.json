{
  "song_name": "Nene unnavaadananina advitheeya Prabhu aaraadhinthu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నేనే ఉన్నవాడననిన అద్వితీయ ప్రభు ఆరాధింతు"
    ],
    "english": [
      "Nene unnavaadananina advitheeya Prabhu aaraadhinthu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆర్ఫాయు ఓమేగ వర్తమాన - భూత భవిష్యత్తులో నున్నవాడా",
        "నా సర్వము నిర్వహించువాడా - సర్వాధికారి నిన్నే స్తుతించి",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Alphaayu Omega varthamaana - Bhootha bhavishyatthulo nunnavaadaa",
        "Naa sarvamu nirvahinchuvaadaa - Sarvaadhikaari ninne sthuthinchi",
        "Arpinthu neeke naa aaraadhana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏడు సువర్ణ దీపస్తంభముల - మధ్య సంచరించుచున్నవాడా",
        "శుద్దీకరించితివి నన్ను - మేలిమిగ మార్చి సంఘమున",
        "చేర్చితివి నిన్నే ఆరాధింతు"
      ],
      "english": [
        "Edu suvarna dheepasthambhamula - Madhya sancharinchuchunnavaadaa",
        "Shuddheekarinchithivi nannu - Melimiga maarchi sanghamuna",
        "Cherchithivi ninne aaraadhinthu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తెల్లని ఉన్నిని పోలియున్న - వెంట్రుకలు కలిగి యున్నవాడా",
        "ఆలోచనకర్త నీవే నాకు - జ్ఞానమైతివి అసమానుండ",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Thellani unnini poliyunna - Ventrukalu kaligi yunnavaadaa",
        "Aalochanakartha neeve naaku - Gnaanamaithivi asamaanunda",
        "Arpinthu neeke naa aaraadhana"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సూర్యుని వంటి ముఖము కలిగి - అగ్నిజ్వాలల నేత్రముల్ కలిగి",
        "దృష్టించితివి నా హౄదయమున్ - దహించితివి దుష్టత్వము",
        "ప్రేమగల ప్రభూ నిన్నారాధింతు"
      ],
      "english": [
        "Sooryuni vanti mukhamu kaligi - Agnijvaalala nethramul kaligi",
        "Dhrushtinchithivi naa hrudhayamun - Dhahinchithivi dhushtathvamu",
        "Premagala Prabhoo ninnaaraadhinthu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అపరంజిని పోలిన పాదములు - కలవాడా తీర్పు తీర్చితివి",
        "పాపము లోకములనిల - దుష్ట సాతానున్ సిలువలొ గెలిచి",
        "విజయ మిచ్చినందుల కారాధింతున్"
      ],
      "english": [
        "Aparanjini polina paadamulu - Kalavaadaa theerpu theerchithivi",
        "Paapamu lokamulanila - Dushta Saathaanun siluvalo gelichi",
        "Vijaya michchinandhula kaaraadhinthun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ నోటినుండి బయలువెడలె - రెండంచులు గల వాడి ఖడ్గము",
        "అదియే పాత ఆదామును చంపె - నశింప చేసె నా శత్రుబలమున్",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Nee notinundi bayaluvedale - Rendanchulu gala vaadi khadgamu",
        "Adiye paata Aadhaamunu champe - Nashimpa chese naa shathrubalamun",
        "Arpinthu neeke naa aaraadhana"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఏడు నక్షత్రములు పట్టుకొనిన - మొదటివాడా కడపటివాడా",
        "సర్వ సంపూర్ణత నాకిచ్చితివి - అపాయములలో ఆదుకొనుచున్న",
        "ఆమేన్ అనువాడా హల్లెలూయ"
      ],
      "english": [
        "Edu nakshathramulu pattukonina - Modhativaadaa kadapativaadaa",
        "Sarva sampoornatha naakichchithivi - Apaayamulalo aadhukonuchunna",
        "Aamen anuvaadaa hallelooya"
      ]
    }
  ]
}
