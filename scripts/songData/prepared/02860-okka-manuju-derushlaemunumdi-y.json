    {
      "stanza_number": 5,
      "telugu": [
        "నూనె ద్రాక్షరసము పోసి గాయములను గట్టి వాని",
        "ఘనమగు వాహనముమీద నూరు చేర్చెను"
      ],
      "english": [
        "Noone Dhraaksharasamu Poasi Gaayamulanu Gatti Vaani",
