  "main_stanza": {
    "telugu": [
      "జయహే.. జయహే.. జయహే.. జయహే..",
      "జయ జయ దేవసుతా జయ జయ విజయసుతా"
    ],
    "english": [
      "Jayahe.. jayahe.. jayahe.. jayahe..",
      "Jaya jaya Dhevasuthaa jaya jaya vijayasuthaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సిలువలో పాపికి విడుదల కలిగెనువిడుదల కలిగెను",
        "కలువరిలో నవ జీవన మొదవెను జీవన మొదవెను",
        "సిలువ పతాకము జయమును గూర్చెను",
        "జయమని పాడెదనునా విజయము పాడెదను",
        "నా విజయము పాడెదను"
      ],
      "english": [
        "Siluvalo paapiki vidudala kaligenu vidudala kaligenu",
        "Kaluvarilo nava jeevana modhavenu jeevana modhavenu",
        "Siluva pathaakamu jayamunu goorchenu",
        "Jayamani paadedanu naa vijayamu paadedanu",
        "Naa vijayamu paadedanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మరణపు కోటలో మరణమే సమసెను మరణమే సమసెను",
        "ధరణిలో జీవిత భయములు దీరెను భయములు దీరెను",
        "మరణములో సహ జయములు నావే (2)"
      ],
      "english": [
        "Maranapu kotalo maraname samasenu maraname samasenu",
        "Dharanilo jeevitha bhayamulu dheerenu bhayamulu dheerenu",
        "Maranamulo saha jayamulu naave (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శోదనలో ప్రభుసన్నిది దొరికెను సన్నిది దొరికెను",
        "వేధనలే రణభూమిగా మారెను భూమిగ మారెను",
        "శోధన భాధలు బలమును గూర్చెను (2)"
      ],
      "english": [
        "Shodhanalo Prabhu sannidhi dorikenu sannidhi dorikenu",
        "Vedhanale ranabhoomigaa maarenu bhoomiga maarenu",
        "Shodhana baadhalu balamunu goorchenu (2)"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రార్ధనకాలము బహుప్రియమాయెను బహుప్రియ మాయెను",
        "సార్ధకమాయెను దేవుని వాక్యము దేవుని వాక్యము",
        "ప్రార్ధనలే భలి పీఠములాయెను (2)"
      ],
      "english": [
        "Praardhanakaalamu bahupriyamaayenu bahupriya maayenu",
        "Saardhakamaayenu devuni vaakyamu devuni vaakyamu",
        "Praardhanale bali peethamulaayenu (2)"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరిశుద్ధాత్ముని ప్రాపక మొదవెను ప్రాపక మొదవెను",
        "వరుడగు యేసుని వధువుగ మారితి వధువుగ మారితి",
        "పరిశుద్ధుడు నను సాక్షిగ పిలచెను (2)"
      ],
      "english": [
        "Parishuddhaathmuni praapaka modhavenu praapaka modhavenu",
        "Varudagu Yesuni vadhuvuga maarithi vadhuvuga maarithi",
        "Parishuddhudu nanu saakshiga pilachenu (2)"
      ]
    }
  ]
