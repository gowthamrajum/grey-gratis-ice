{
  "song_name": "Naa Thodu Neeve Deva",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా తోడు నీవే దేవా",
      "నా బలము నీవే ప్రభువా",
      "నా ధైర్యం నీవే దేవా",
      "నా క్షేమం నీవే ప్రభువా",
      "కాపాడే దైవం నీవేగా – కనుపాపగ నన్ను కాచేగా",
      "నీ దయలో, నీ కృపలో, నీ ఒడిలో నన్నిలలో"
    ],
    "english": [
      "Naa thodu neeve devaa",
      "naa balamu neeve prabhuvaa",
      "naa dhairyam neeve devaa",
      "naa kshemam neeve prabhuvaa",
      "kaapaade dhaivam neevegaa – kanupaapaga nannu kaachegaa",
      "nee dhayalo, nee krupalo nee odilo nannilalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాలో కన్నీరే నీవైపే చూడగా",
        "నీవే యేసయ్య సంతోషం నింపగా"
      ],
      "english": [
        "Naalo kanneere neevaipe choodagaa",
        "neeve yesayya santhosham nimpagaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిట్టూర్పు లోయలలో, గాఢాంధకారములో",
        "నీవే నా అండగా నన్ను బలపరచగా"
      ],
      "english": [
        "nitturpu loyalalo, ghaadandhakaaramulo",
        "neeve naa andagaa nannu balaparachagaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నడిపించే వాక్యం నీవైతివీ",
        "కరుణించే దైవం నీవైతివీ",
        "నీ దయలో, నీ కృపలో"
      ],
      "english": [
        "nadipinche vaakyam neevaithivi",
        "karuninche dhaivam neevaithivi",
        "nee dhayalo, nee krupalo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఎన్నో కలతలే నామదిలో నిండగా",
        "నీవే యేసయ్య నావెంటే ఉండగా"
      ],
      "english": [
        "Enno kalathale naa madhilo nindagaa",
        "neeve yesayya naavente undagaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా భయమును తొలగించి , విశ్వాసము కలిగించి",
        "నీవే నా అండగా నన్ను స్థిరపరచగా"
      ],
      "english": [
        "naa bhayamunu tholaginchi, viswaasamu kaliginchi",
        "neeve naa andagaa nannu sthiraparachagaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీవుంటే చాలు నా యేసయ్య",
        "నీ ప్రేమే నాకు చూపావయ్యా",
        "నీ దయలో, నీ కృపలో"
      ],
      "english": [
        "neevunte chaalu naa yesayya",
        "nee preme naaku choopaavayyaa",
        "nee dhayalo, nee krupalo"
      ]
    }
  ]
}
