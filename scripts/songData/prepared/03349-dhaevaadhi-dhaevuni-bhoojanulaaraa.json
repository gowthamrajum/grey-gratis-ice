  },
  "main_stanza": {
    "telugu": [
      "దేవాది దేవుని భూజనులారా - రండి స్తుతించ సదా"
    ],
    "english": [
      "Dhaevaadhi Dhaevuni Bhoojanulaaraa - Randi Sthuthincha Sadhaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కరుణ కృపా ప్రేమ - మయుడైన దేవుడు",
        "వరుసగ మనకన్ని - దయ చేయువాడు"
      ],
      "english": [
        "Karuna Krupaa Praema - Mayudaina Dhaevudu",
        "Varusaga Manakanni - Dhaya Chaeyuvaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వదలక అడుగుది - ఈయంబడు ననెన్",
        "వెదకుడి తట్టుడి - తీయంబడు ననెన్"
      ],
      "english": [
        "Vadhalaka Adugudhi - Eeyambadu Nanen",
        "Vedhakudi Thattudi - Theeyambadu Nanen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసుని పేరట - వేడిన దానిని",
        "దాసుల కిడును - దేవుడు వేగమే"
      ],
      "english": [
        "Yaesuni Paerata - Vaedina Dhaanini",
        "Dhaasula Kidunu - Dhaevudu Vaegamae"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సుతుని ఇచ్చినవాడు - కొరత గానీయడు",
        "ప్రేతిగా సమస్తము - నిచ్చును దయతో"
      ],
      "english": [
        "Suthuni Ichchinavaadu - Koratha Gaaneeyadu",
        "Praethigaa Samasthamu - Nichchunu Dhayathoa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సత్యమునందు - మనల నడిపించను",
        "నిత్యాత్మను శాశ్వతముగా నెచ్చెను"
      ],
      "english": [
        "Sathyamunandhu - Manala Nadipinchanu",
        "Nithyaathmanu Shaashvathamugaa Nechchenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రాకటముగా నల్లెలూయ పాడుటకు",
        "సకల మానవులు నిరతము స్తుతింపను"
      ],
      "english": [
        "Praakatamugaa Nallelooya Paadutaku",
        "Sakala Maanavulu Nirathamu Sthuthimpanu"
      ]
    }
  ]
}
