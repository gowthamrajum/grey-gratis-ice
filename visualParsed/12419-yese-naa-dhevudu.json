  "main_stanza": {
    "telugu": [
      "యేసే నా దేవుడు",
      "ఆయేసే నాకు సహాయుడు",
      "వ్యాధియైన బాధయైన (2)",
      "శోధనమరి ఏదైన నిందలెన్ని ఉన్న"
    ],
    "english": [
      "Yese naa Devudu",
      "Aayese naaku sahaayudu",
      "Vyaadhiyaina baadhayaina (2)",
      "Shodhanamari edhaina nindhalenni unna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆది యుందు వాక్కుయై యున్నవాడు",
        "సర్వ సృష్టికి రూపు నిచ్చినవాడు",
        "తన రూపంలో నరుని చేసిన వాడే",
        "నర రూపమెత్తినన్ను రక్షించాడు",
        "ఆ యేసే. నా దేవుడు||యేసే||"
      ],
      "english": [
        "Aadi yandu vaakkuyai yunnavaadu",
        "Sarva srushtiki roopu nichchinavaadu",
        "Thana roopamlo naruni chesina vaade",
        "Nara roopamettinannu rakshinchaadu",
        "Aa Yese. Naa Devudu||Yese||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యాధి బాధలు బాపిన ఆ దేవుడు",
        "చని పోయిన లాజరును లేపినవాడు",
        "మరణమును గెలిచిన ఆ మహానీయుడు",
        "రక్షకుడని రుజువులెన్నో చూపించాడు",
        "ఆ యేసే. నాదేవుడు||యేసే||"
      ],
      "english": [
        "Vyaadhi baadhalu baapina aa Devudu",
        "Chani poyina Laajarunu lepinavaadu",
        "Maranamunu gelichina aa mahaaneeyudu",
        "Rakshakudani rujuvulenno choopinchaadu",
        "Aa Yese. Naadhevudu||Yese||"
      ]
    }
  ]
