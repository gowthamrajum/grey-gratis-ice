{
  "song_name": "Asamanudainavadu",
  "author": {
    "Authored by": "Pastor David Varma",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అసామానుడైన వాడు – అవమానపరచడునిన్ను",
      "ఓటమిఎరుగనీ మన దేవుడు – ఒడిపోనివ్వడు నిన్ను",
      "ఘనకార్యాలెన్నో నీకై చేసినవాడు -కష్టకాలమందు",
      "నీ చేయి విడచునా",
      "అసాధ్యములెన్నో దాటించిన నాథుడు",
      "శ్రమలో నిన్ను దాటిపోవునా",
      "సియోను దేవుడే నిన్ను సిగ్గుపడనివ్వడు",
      "కనికర పూర్ణుడే నీ కన్నీరు తుడచును"
    ],
    "english": [
      "Asaamaanudaina vaadu",
      "Avamaanaparachaduninnu",
      "Otami eruganee mana devudu",
      "Odiponivvadu ninnu",
      "Ghanakaaryaalenno neekai chesinavaadu",
      "Kashta kaalamandu nee cheyi vidachunaa",
      "Asaadhyamulenno daatiinche naathudu",
      "Shramalo ninnu daatipovunaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అగ్ని గుండాములో నెట్టివేసిన – సింహాల నోటికి",
        "నిన్ను అప్పగించిన",
        "శత్రువే నీ స్థితిచూసి అతిశయ పడుచున్న",
        "సింహాలే నీ ఎదుటే మ్రింగివేయ నిలిచిన",
        "నాకే ఎలా శ్రమలంటూ కృంగిపోకుమా",
        "తేరిచూడు యేసుని అగ్నిలో నిలిచెను నీకై",
        "శుత్రువు చేతికి నిను అప్పగించడు"
      ],
      "english": [
        "Siyonu devude ninnu siggupadanivvadu",
        "Kanikara poornude nee kanneeru thudachunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిస్థితులన్నీ చేజారిపోయిన – ఎంతగానో శ్రమమపడిన ఫలితమే లేకున్నా",
        "అనుకున్నవన్నీ దూరమైపోయిన – మంచిరోజులొస్తాయనే నిరిక్షణే లేకున్నా",
        "మారదీ తలరాతని దిగులుపడకుమా",
        "మారాను మధురముగా మార్చును నీకై",
        "మేలులతో నిను తృప్తిపరచును"
      ],
      "english": [
        "Agni gundamulo nettivesina",
        "Simhaala notiki ninnu appaginchina",
        "Shetroove nee sthiti chusi atisheya paduchunna",
        "Simhaale nee edute mringiveya nilichina",
        "Naake ela shramalantu krungipokuma –",
        "Terichoodu yesuni agnilo nilichenu neekai",
        "Shutruvu chetiki ninu appaginchadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఒంటరి పోరాటమే విసుగురేపిన",
        "పొందిన పిలుపే బారమైపోయిన",
        "ఆత్మీయులందరు అవమానిస్తున్న",
        "నమ్మదగినవారులేక నిరాశతో నిలిచిన",
        "పిలుపునే విడచి మరలిపోకుమా",
        "న్యాయాధిపతియే నాయకునిగా నిలుపును నిన్ను",
        "పిలిచిన దేవుడు నిను మరచిపోవునా"
      ],
      "english": [
        "Paristhitulanni chejaaripoyin",
        "Enthagaano sremapadina phalitame lekunna",
        "Anukunnavanni dooramaipoyin",
        "Manchi rojulostayane nirikshane lekunna",
        "Maradi talarathani digulupadakumaa –",
        "Maranumadhuramuga marchanuneekai",
        "Melulatho ninu thrupthiparachunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [],
      "english": [
        "Ontari poratame visugurepina",
        "Pondina pilupe baaramaipoyina",
        "Aatmiyulandaroo avamaaninchina",
        "Nammadaginavaruleka niraasheto nilichina",
        "Pilipune vidachi maralipokumaa –",
        "Nyaayaadhipatiye naayakuniga nilupunu ninnu",
        "Pilichina devudu ninu marachipovunaa"
      ]
    }
  ]
}
