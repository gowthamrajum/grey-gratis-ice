{
  "song_name": "Praemaamruththadhaaralu Chimdhimchina Yaesuku Samamevaru",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రేమామృత్తధారలు చిందించిన యేసుకు సమమెవరు? ఆ-ఆ-ఆ",
      "ప్రేమయెతానై నిలచి ప్రేమవాక్కులనే బలికి",
      "ప్రేమతో ప్రాణము బెట్టి ప్రేమనగరికి చనియె"
    ],
    "english": [
      "Praemaamruththadhaaralu Chimdhimchina Yaesuku Samamevaru? Aa-Aa-Aa",
      "Praemayethaanai Nilachi Praemavaakkulanae Baliki",
      "Praemathoa Praanamu Betti Praemanagariki Chaniye"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిశ్చలమైన ప్రేమజీవికి యిలలో తావేది",
        "ప్రేమ ద్రోహులేగాని ప్రియమున చేరరు వాని",
        "చేరిన చెలికాడగురా సమయమిదే పరుగిడరా"
      ],
      "english": [
        "Nishchalamaina Praemajeeviki Yilaloa Thaavaedhi",
        "Praema Dhroahulaegaani Priyamuna Chaeraru Vaani",
        "Chaerina Chelikaadaguraa Samayamidhae Parugidaraa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎంత ఘోరపాపాత్ములనైన ప్రేమించునురారా",
        "పాపభారముతో రారా పాదములపై బడరా",
        "పాపుల రక్షకుడేసు తప్పక నిను రక్షించున్"
      ],
      "english": [
        "Emtha Ghoarapaapaathmulanaina Praemimchunuraaraa",
        "Paapabhaaramuthoa Raaraa Paadhamulapai Badaraa",
        "Paapula Rakshakudaesu Thappaka Ninu Rakshimchun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇంత గొప్ప రక్షణను నిర్లక్ష్యము చేసెదవేల?",
        "రక్షణ దిన మిదియేరా తక్షణమే కనుగొనరా",
        "ఇదియే దేవుని వరము ముదమారగ జేకొనుము"
      ],
      "english": [
        "Imtha Goppa Rakshananu Nirlakshyamu Chaesedhavaela?",
        "Rakshana Dhina Midhiyaeraa Thakshanamae Kanugonaraa",
        "Idhiyae Dhaevuni Varamu Mudhamaaraga Jaekonumu"
      ]
    }
  ]
}
