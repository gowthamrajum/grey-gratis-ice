{
  "song_name": "Thellaga thelavaarakamunde",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "తెల్లగ తెలవారకముందే",
      "తొలి కోడి కూయకముందే",
      "లేచినాడే యేసుదేవుడు",
      "సమాధిగుండె చాల్చినాడే మృత్యుంజయుడు"
    ],
    "english": [
      "Thellaga thelavaarakamunde",
      "Tholi kodi kooyakamunde",
      "Lechinaade Yesudhevudu",
      "Samaadhigunde chaalchinaade mruthyunjayudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ గుడిని పడగొట్టమన్నాడే",
        "మూడు రోజుల్లో లేపుతానన్నాడే",
        "తనదేహము గూర్చి ఈ మాట చెప్పినాడే",
        "మాట తప్పనివాడు చేసి చూపినాడే"
      ],
      "english": [
        "Ee gudini padagottamannaade",
        "Moodu rojullo leputhaanannaade",
        "Thanadhehamu goorchi ee maata cheppinaade",
        "Maata thappanivaadu chesi choopinaade"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్త్రీలు సుగంధాలు సిద్దపరచినారే",
        "యేసు దేహానికి పూయాలని తలచినారే",
        "తిరిగిలేస్తానన్న యేసుమాట మరచినారే",
        "ఖాళీ సమాధిని చూచి నిజమునెరిగినారే"
      ],
      "english": [
        "Streelu sugandhaalu siddhaparachinaare",
        "Yesu dhehaaniki pooyaalani thalachinaare",
        "Thirigilesthaananna Yesumaata marachinaare",
        "Khaalee samaadhini choochi nijamuneriginaare"
      ]
    }
  ]
}
