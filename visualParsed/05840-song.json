{
  "song_name": "Manujulaara manchi vaartha",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మనుజులార మంచి వార్త – మానుగాను దెచ్చినాడ",
      "మనలన్ గావ మహిని నేడు – మనుజుడై జన్మించె నహహ"
    ],
    "english": [
      "Manujulaara manchi vaartha - Maanugaanu dhechchinaada",
      "Manalan gaava mahini nedu - Manujudai janminche nahaha"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎంతో సంతసంబు గలిగె – నింతయని వర్ణింప దరమా",
        "చింతలన్ని వీడి ప్రభుని – చెంతజేరి నుతించుమయ్యయ్యో ||మనుజులారా||"
      ],
      "english": [
        "Entho santhasambu galige - Ninthayani varninpa dharamaa",
        "Chinthalanni veedi prabhuni - Chenthajeri nuthinchumayyayyo ||Manujulaaraa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బేతలేము పురమునందు – బీద యింట స్థలములేక",
        "దాత పశులశాలయందు – బ్రీతితో బరుండె నయ్యయ్యో ||మనుజులారా||"
      ],
      "english": [
        "Bethalemu puramunandu - Beeda intha sthalamuleka",
        "Daatha pashulashaalayandhu - Breethitho barunde nayyayyo ||Manujulaaraa||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఒక్క క్షణములోనే దూతల్ – గ్రక్కున మోక్షంబు విడచి",
        "ఒక్క స్వరముతోను బాడి – మక్కువ నుతించిరయ్యయ్యో ||మనుజులారా||"
      ],
      "english": [
        "Okka kshanamulone dhoothal - Grakkuna mokshambu vidachi",
        "Okka svaramuthonu baadi - Makkuva nuthinchirayyayyo ||Manujulaaraa||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సంతసంబని తాళములతో – యేసు జన్మదినమునందు",
        "సంతసంబు సంతసంబు – సంతసంబని బాడు డహాహా ||మనుజులారా||"
      ],
      "english": [
        "Santhasambani thaalamulatho - Yesu janmadhinamunandhu",
        "Santhasambu santhasambu - Santhasambani baadu dahaahaa ||Manujulaaraa||"
      ]
    }
  ]
}
