        "mammu vidipinchumee",
        "Yesunaadhaa, priyanaadhaa!",
        "ninnu naashrayinthumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బాల్యమందు నిన్నుఁ జేరి",
