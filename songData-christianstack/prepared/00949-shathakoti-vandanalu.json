{
  "song_name": "Shathakoti Vandanalu",
  "author": {
    "Authored by": "Samuel Karmoji",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "శతకోటి వందనాలు యేసు స్వామి నీకు",
      "కరుణించి కాపాడుమయా",
      "కాలాలన్ని మారినట్టు మారిపోని నీకు",
      "మా నిండు వందనాలయ్య"
    ],
    "english": [
      "Sathakoti vandhanaalu yesu swami neeku",
      "karuninchi kaapaadumaya",
      "kaalaalanni maarinattu maariponi neeku",
      "maa nindu vandhanaalayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ చల్లని చూపు మాపై నిలుపు",
        "నీ కరుణ హస్తం మాపై చాపు"
      ],
      "english": [
        "Nee challani choopu maapai nilupu",
        "nee karuna hastham maapai chaapu"
      ]
    }
  ]
}
