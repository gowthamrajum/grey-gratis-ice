  "main_stanza": {
    "telugu": [
      "జన్మించినాడు శ్రీ యేసురాజు బెత్లెహేమందున",
      "సర్వోన్నతుడు వెలసినాడు రక్షణిచ్చుటకు",
      "అక్షయ మార్గము నడిపించే మానవుడై",
      "నిజమే నిజమే దీనవరుడై ఉదయించే",
      "ఱేడు నేడు జనియించినాడు",
      "ఆనందం అద్భుతం",
      "రేడు నేడు జనియించినాడు",
      "సంతోషం సమాధానం",
      "లేఖనం నెరవేర్పుకై ఏతెంచెను ప్రభువు",
      "దూత తెలిపెను ప్రభు రాకను బాసురంబగు క్రీస్తు",
      "రాజితంబగు తేజంబవుతో ఉద్భవించినాడు",
      "అంబరముగా ఆవిర్భవించె నీతిసూర్యుడై",
      "రాజువైన మెస్సయ్యను పూజింపను రండి",
      "అద్వీతీయుండగు కుమారుని చూతము రండి",
      "మహిమ ఘనత ప్రభావముతో మహిలో వెలసెను నేడు",
      "భూమిపై దిగి వచ్చెను మనకొరకు పాపహరుడై"
    ],
