{
  "song_name": "Sakalaaseervaadhamula",
  "author": {
    "Authored by": "A.R.Stevenson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సకలాశీర్వాదముల కారణభూతుడా",
      "యేసూ నా ప్రియుడా",
      "నీ మేలుల తలంచుచుండ",
      "స్తుతి గానమే పెదవుల నిండా"
    ],
    "english": [
      "Sakalaaseervaadhamula kaarannabhuutuhdaa",
      "Yeasuu naa priyudaa",
      "Nii mealula thalanchuchunda",
      "Stuthi gaanamea pedavule nindaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జయశీలుడా విభుడా",
        "పరిపూర్ణుడా హితుడా"
      ],
      "english": [
        "Jayaseeludaa vibhudaa",
        "Paripuurnnudaa hithudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అన్నపానం లోటు రానీకుండా",
        "కార్యము చేసిన పోషకుడా",
        "ఆరోగ్యములను కుదుటపరచి",
        "ఆయుష్షు పెంచేవాడా"
      ],
      "english": [
        "Annapaanam lootu raaneekundaa",
        "Kaaryamu chease poshakudaa",
        "Aaroogyamulanu kudutaparachi",
        "Aayushhu pencheavaadaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవమార్గం తప్పిపోనీకుండా",
        "జ్ఞానము నేర్పిన ప్రాపకుడా",
        "ఆటంకములను అనువుపరచి",
        "ఆకాంక్ష తీర్చేవాడా"
      ],
      "english": [
        "Jiivamaargam tappipooniikundaa",
        "Gnyaanamulanu nearpina prapakudaa",
        "Aatamkamulanu anuvuparachi",
        "Aakaansha thiircheavaadaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కాయకష్టం పాడు కానీకుండా",
        "లాభము కూర్చిన శ్రీకరుడా",
        "ఆదాయములను పదిలపరచి",
        "ఆధిక్యమిచ్చేవాడా"
      ],
      "english": [
        "Kaayakashtam paadu kaaniikundaa",
        "Laabhamu kuurchina srikarudaa",
        "Aadaayamulanu padilaparachi",
        "Aadhikyamichheavaadaa"
      ]
    }
  ]
}
