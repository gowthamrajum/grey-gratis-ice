  "main_stanza": {
    "telugu": [
      "[Verse 1]",
      "కొండలతట్టు నా కన్నులెత్తి",
      "చూచున్నాను నీ వైపు",
      "కరములు చాపి నీ వాగ్దానముకై",
      "వేచియున్నాను నీ ముందు"
    ],
    "english": [
      "[Verse 1]",
      "Kondala thattu naa kannuletti",
      "Choochuchunnanu nee vaipu",
      "Karamulu chaapi nee vagdanamukai",
      "Vechiyunnanu nee mundu"
    ]
  },
  "stanzas": [
