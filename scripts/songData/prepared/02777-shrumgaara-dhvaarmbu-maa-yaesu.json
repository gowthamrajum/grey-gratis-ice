    {
      "stanza_number": 2,
      "telugu": [
        "యెరూషలేమాలయ పరిశుద్ధ స్థలమందు",
        "పరిశుద్ధ జనులుగ బ్రవేశ పెట్టు"
      ],
      "english": [
        "Yerooshalaemaalaya Parishuddha Sthalamandu",
