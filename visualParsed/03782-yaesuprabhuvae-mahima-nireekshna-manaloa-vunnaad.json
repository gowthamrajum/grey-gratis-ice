    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తేసే మనకు సర్వాధికారి మనమాయన గృహము",
        "అంతమువరకు స్థిరముగ నిలిచి మనమానందింతుము"
      ],
      "english": [
        "Kreesthese manaku sarvaadhikaari manamaayana gruhamu",
        "Anthamuvaraku sthiramuga nilichi manamaanandhinthumu"
