  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రియుడా నా ప్రాణమా",
        "నిన్ ఆరాధించెదన్",
        "నా జీవమా నా స్నేహమా",
        "నిన్ ఆరాధించెదన్"
      ],
      "english": [
        "Naa priyudaa naa praanamaa",
        "nin aaraadhinchedhan",
        "naa jeevamaa naa snehamaa",
        "nin aaraadhinchedhan"
      ]
    }
  ]
