{
  "song_name": "Enthadhooramu moyinchedharu Swaami",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఎంతదూరము మోయించెదరు స్వామి",
      "కింత సిలువనెత్తి నుంతైన దయలేక ||ఎంత||"
    ],
    "english": [
      "Enthadhooramu moyinchedharu Swaami",
      "Kintha siluvanetthi nunthaina dhayaleka ||Entha||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒంటిగా ప్రార్థించి యుపవాసములు జేసి",
        "కంటి నిదురలేక కలతజెందిన ప్రభుని  ||ఎంతదూరము||"
      ],
      "english": [
        "Ontigaa praarthinchi yupavaasamulu jesi",
        "Kanti niduraleka kalathajendhina Prabhuni ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సొమ్మునాశించి గురున్ అమ్ముకొన్న యూద",
        "నమ్మించి మీకిచ్చె నిమ్మానుయేలును  ||ఎంతదూరము||"
      ],
      "english": [
        "Sommunaashinchi gurun ammukonna Yooda",
        "Namminchi meekichchen Immaanuyelunu ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కరములు జోడించి కడకు గేత్సెమనిలో",
        "పరమ తండ్రిని వేడు నిరపరాదిని పట్టి  ||ఎంతదూరము||"
      ],
      "english": [
        "Karamulu jodinchi kadaku Gethsemanilo",
        "Parama thandrini vedu niraparaadhini patti ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పిరికి పిలాతుని బెదరించి యదలించి",
        "యెరుషాలేం వీధుల నేసుని ద్రిప్పుచు  ||ఎంతదూరము||"
      ],
      "english": [
        "Piriki Pilaathuni bedharinchi yadhalinchi",
        "Yerushaalem veedhulan Yesuni drippuchu ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఒడలలసి నా ప్రభువు తడబడుచుండగా",
        "ఘడియ ఘడియకు తిట్టి గట్టిగ కొట్టుచు  ||ఎంతదూరము||"
      ],
      "english": [
        "Odalalasi naa Prabhuvu thadabaduchundagaa",
        "Ghadiya ghadiyaku thitti gattiga kottuchu ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కలువరి గిరివరకు సిలువ మోయలేక",
        "అలసిన ప్రభుజంప నాలస్యమును చేసి  ||ఎంతదూరము||"
      ],
      "english": [
        "Kaluvari girivaraku siluva moyaleka",
        "Alasina Prabhujampa naalasyamunu chesi ||Enthadhooramu||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసు నీకొరకై నే నేడ్చుటకంటెను",
        "దోషినని గ్రహించి దోసిలొగ్గుటె మేలు  ||ఎంతదూరము||"
      ],
      "english": [
        "Yesu neekorakai ne nedchutakanthenu",
        "Dhoshinani grahinchi dhosiloggute melu ||Enthadhooramu||"
      ]
    }
  ]
}
