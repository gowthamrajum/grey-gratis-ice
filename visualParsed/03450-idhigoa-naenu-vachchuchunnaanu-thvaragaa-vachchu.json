{
  "song_name": "Idigo nenu vachchuchunnaanu thvaragaa vachchuchunnaanu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఇదిగో నేను వచ్చుచున్నాను - త్వరగా వచ్చుచున్నాను",
      "ఎవని క్రియల ఫలితము - వానికియ్య వచ్చుచున్నాను"
    ],
    "english": [
      "Idigo nenu vachchuchunnaanu - Thvaragaa vachchuchunnaanu",
      "Evani kriyala phalithamu - Vaanikiyya vachchuchunnaanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మేఘారూఢుడనై నిక్కముగా - తిరిగి వచ్చుచున్నాను",
        "ప్రతి నేత్రము వీక్షించును - పరిశుద్ధులై యుండుడి"
      ],
      "english": [
        "Meghaaroodhudanai nikkamugaa - Thirigi vachchuchunnaanu",
        "Prathi nethramu veekshinchunu - Parishudhdhulai yundudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నేను త్వరగా వచ్చుచున్నాను - ఎవడు నీ కిరీటమును",
        "అపహరింప కుండునట్లు - జాగ్రత్తగా చూచుకో"
      ],
      "english": [
        "Nenu thvaragaa vachchuchunnaanu - Evadu nee kireetamunu",
        "Apaharimpa kundunatlu - Jaagratthagaa choochuko"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసు ప్రభువే సర్వమును - నూతన పరచుచున్నాడు",
        "క్రీస్తుని రాకడను ప్రేమించి - కాయువారే ధన్యులు"
      ],
      "english": [
        "Yesu Prabhuve sarvamunu - Noothana parachuchunnaadu",
        "Kreesthuni raakadanu preminchi - Kaayuvaare dhanyulu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేవేగరా మా ప్రభు యేసు - వేచియున్నాను నీ కొరకే",
        "నీ దూతలతో వినుతించుచు - హల్లెలూయ పాడెదము"
      ],
      "english": [
        "Vevegaraa maa Prabhu Yesu - Vechiyunnaanu nee korake",
        "Nee doothalatho vinuthinchuchu - Hallelooya paadedamu"
      ]
    }
  ]
}
