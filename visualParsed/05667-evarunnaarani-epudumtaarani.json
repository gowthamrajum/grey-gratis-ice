  "main_stanza": {
    "telugu": [
      "ఎవరున్నారని ఎపుడుంటారని",
      "చితికిన బతుకున ఆశ్రయమెవరని|| 2||",
      "నీవె లేకపోతే నేనైమైయుందునో దేవా||2||",
      "ఉన్నావు మాకై ఇమ్మానుయేుగా -",
      "ఉంటావు తోడై యెహోవా షమ్మాగా",
      "ఎవరున్నారని"
    ],
    "english": [
      "Evarunnaarani epuduntaarani",
      "Chithikina bathukuna aashrayamevarani|| 2||",
      "Neeve lekapothe nenemaiyundhuno Deva||2||",
      "Unnaavu maakai Immanuyelugaa -",
      "Untaavu thodai Yehova shammaagaa",
      "Evarunnaarani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        ": ఆశు అడుగంటి వేసారిన బ్రతుకుకు",
        "ఆత్మీయత కరువై అమటించు వారికి||2||",
        "ఉన్నదా ఆశు తీర్చు తీరం ఉన్నదా ఆత్మీయతకు నియం",
        "నీవె లేకపోతే"
      ],
      "english": [
        ": Aasha aduganti vesaarina brathukuku",
        "Aathmeeyatha karuvai alamatinchu vaariki||2||",
        "Unnadaa aasha theerchu theeram unnadaa aathmeeyathaku nilayam",
        "Neeve lekapothe"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        ": తల్లి ప్రేమ కరువై తండ్రికి ఇ దూరమై",
        "తనయుకే భారమై బ్రతుకు గడుపు వారికి||2||",
        "ఉన్నదా అనాధకు సహాయం",
        "ఉన్నదా అభాగ్యుకాశ్రయం",
        "నీవె లేకపోతే"
      ],
      "english": [
        ": Thalli prema karuvai thandriki dooramai",
        "Thanayulake bhaaramai brathuku gadupu vaariki||2||",
        "Unnadaa anaadhaku sahaayam",
        "Unnadaa abhaagyulakaashrayam",
        "Neeve lekapothe"
      ]
    }
  ]
}
