{
  "song_name": "Srushtikarthavu Rakshanakarthavu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor J Devanand Kumar"
    ],
    "రచన": [
      "పాస్టర్ జె దేవానంద్ కుమార్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "సృష్టికర్తవు రక్షణకర్తవు",
      "ఆధరణకర్తవు త్రీయేక దేవుడా",
      "యెహోవా యేసయ్య",
      "పరిశుద్ధాత్ముడా ఏకైక దేవుడా"
    ],
    "english": [
      "Srushtikarthavu rakshanakarthavu",
      "Aadharanakarthavu threeyeka Devudaa",
      "Yehovaa Yesayya",
      "Parishuddhaathmudaa ekaika Devudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వసృష్టిని చేసి – మనిషికి నీ రూపమునిచ్చి",
        "జీవాత్మను ఊది – జీవమునిచ్చితివి",
        "కరుణావాత్సల్యుడా – కృపాకనికరుడా",
        "దయాదాక్షిణ్యుడా – దేవాది దేవుడా"
      ],
      "english": [
        "Sarvasrushtini chesi – Manishiki nee roopamunichchi",
        "Jeevaathmanu oodhi – Jeevamunichchithivi",
        "Karunaavaathsalyudaa – Krupaakanikarudaa",
        "Dhayaadhaakshinyudaa – Dhevaadhi Devudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మానవాళి రక్షణకు – పరమునుండి దిగి వచ్చి",
        "రక్తము చిందించి – ప్రాణము పెట్టితివి",
        "పునరుత్థానుడా – రానైయున్నవాడా",
        "ప్రభువుల ప్రభువా – రాజుల రాజా"
      ],
      "english": [
        "Maanavaali rakshanaku – Paramunundi digi vachchi",
        "Rakthamu chindinchi – Praanamu pettithivi",
        "Punarutthaanudaa – Raanaiyunnavaadaa",
        "Prabhuvula prabhuvaa – Raajula raajaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నూతన జన్మనిచ్చి – సర్వసత్యముకు నడిపించి",
        "కృపావరములతో నింపి – ఆత్మ ఫలమునిచ్చి",
        "అభిషేకించువాడా – ఆత్మతో నింపువాడా",
        "సత్యస్వరూపుడా – మహిమాస్వరూపుడా"
      ],
      "english": [
        "Noothana janmanichchi – Sarvasathyamuku nadipinchi",
        "Krupaavaramulatho nimpi – Aathma phalamunichchi",
        "Abhishekinchuvaadaa – Aathmatho nimpuvaadaa",
        "Sathyasvaroopudaa – Mahimaasvaroopudaa"
      ]
    }
  ]
}
