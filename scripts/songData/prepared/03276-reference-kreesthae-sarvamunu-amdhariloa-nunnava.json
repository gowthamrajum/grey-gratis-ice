  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వశక్తుడు నాకు - సర్వమాయనే",
        "సర్వమాయనే - నాకు సమస్తమాయనే"
      ],
      "english": [
        "Sarvashakthudu Naaku - Sarvamaayanae",
        "Sarvamaayanae - Naaku Samasthamaayanae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మార్గ సత్యజీవంబు - యేసునాథుడే",
        "మార్గమాయనే - ఏకమార్గమాయనే"
      ],
      "english": [
        "Maarga Sathyajeevambu - Yaesunaathudae",
        "Maargamaayanae - Aekamaargamaayanae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవాహారము జీవపానము నాయనే",
        "జలము నాయనే - శాంతజల మాయనే"
      ],
      "english": [
        "Jeevaahaaramu Jeevapaanamu Naayanae",
        "Jalamu Naayanae - Shaamthajala Maayanae"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆదియంతము అల్ఫా ఓమేగాయనే",
        "ఓమేగాయనే - ఏకసుతుడాయనే"
      ],
      "english": [
        "Aadhiyamthamu Alphaa Oamaegaayanae",
        "Oamaegaayanae - Aekasuthudaayanae"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షణ పరిశుద్ధత నీతియాయనే",
        "నీతియాయనే - దేవ నీతి యాయనే"
      ],
      "english": [
        "Rakshana Parishudhdhatha Neethiyaayanae",
        "Neethiyaayanae - Dhaeva Neethi Yaayanae"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పునరుత్థానము నిత్య జీవమాయనే",
        "జీవమాయనే - నిత్య జీవమాయనే"
      ],
      "english": [
        "Punaruththaanamu Nithya Jeevamaayanae",
        "Jeevamaayanae - Nithya Jeevamaayanae"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయకు సర్వపాత్రుడాయనే",
        "పాత్రుడాయనే - ఆశ్రయ దుర్గమాయనే"
      ],
      "english": [
        "Hallelooyaku Sarvapaathrudaayanae",
        "Paathrudaayanae - Aashraya Dhurgamaayanae"
      ]
    }
  ]
}
