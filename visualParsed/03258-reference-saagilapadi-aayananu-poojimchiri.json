    {
      "stanza_number": 3,
      "telugu": [
        "సుజనుండేసుని భజనలు చేసి",
        "నిరతంబాయన స్మరణము జేసి",
        "ధన్యుండేసే యని పాడుమా"
      ],
      "english": [
        "Sujanundesuni bhajanalu chesi",
        "Nirathambaayana smaranamu jesi",
        "Dhanyundese yani paadumaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సార్వత్రికము తన సృష్టియే",
