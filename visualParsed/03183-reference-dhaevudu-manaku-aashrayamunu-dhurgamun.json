{
  "song_name": "Devude manakaashrayamunu dhurgamunai yunnaadu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవుడే మనకాశ్రయమును",
      "దుర్గమునై యున్నాడు - ఆపదలో",
      "కావున భూమి - మార్పు నొందినను",
      "కొండలు మున్గినను - ఆపదలో ఆపదలో"
    ],
    "english": [
      "Devude manakaashrayamunu",
      "Dhurgamunai yunnaadu - Aapadalo",
      "Kaavuna bhoomi - Maarpu nondhinanu",
      "Kondalu munginanu - Aapadalo aapadalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సముద్ర జలములు - ఘోషంచుచు - నురుగు కట్టినను",
        "ఆ పొంగుకు పర్వతములు కదలినను - మనము - భయపడము"
      ],
      "english": [
        "Samudra jalamulu - Ghoshinchuchu - Nurugu kattinanu",
        "Aa ponguku parvathamulu kadhalinanu - Manamu - Bhayapadamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఒక నది కలదు - దాని కాలువలు - దేవుని పట్టణమును",
        "సర్వోన్నతుని - మందిర పరిశుద్ధ స్థలమును - సంతోషపర్చు చున్నవి"
      ],
      "english": [
        "Oka nadi kaladu - Daani kaaluvalu - Devuni pattanamunu",
        "Sarvonnathuni - Mandira parishuddha sthalamunu - Santhoshaparchu chunnavi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవుడా పట్టణములో - నున్నాడు దానికి - చలనము లేదు",
        "అరుణో - దయమున దానికి సహాయము చేయుచున్నాడు"
      ],
      "english": [
        "Devudaa pattanamulo - Nunnaadu dhaaniki - Chalanamu ledu",
        "Aruno - Dhayamuna dhaaniki sahaayamu cheyuchunnaadu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జనములు ఘోషించు - చున్నవి రాజ్యములు కదలు చున్నవి",
        "ఆయన కంఠధ్వని వినిపించగా - భూమి కరిగి పోవుచున్నది"
      ],
      "english": [
        "Janamulu ghoshinchu - Chunnavi raajyamulu kadhalu chunnavi",
        "Aayana kanthadhvani vinipinchagaa - Bhoomi karigi povuchunnadhi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సైన్యములధిపతి - యెహోవా మనకు తోడైయున్నాడు",
        "యాకోబు దేవుడు - మనకు ఆశ్రయమునై యున్నాడు"
      ],
      "english": [
        "Sainyamuladhipathi - Yehova manaku thodaiyunnaadu",
        "Yaakobu Devudu - Manaku aashrayamunai yunnaadu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యెహోవా చేసిన - కార్యములను వచ్చి చూడండి",
        "అగ్నిలో యుద్ధ రథములను కాల్చి వేయువాడాయనే"
      ],
      "english": [
        "Yehova chesina - Kaaryamulanu vachchi choodandi",
        "Agnilo yuddha rathamulanu kaalchi veyuvaadaayane"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఊరకుండుడి నేనే దేవుడనని తెలిసికొనుడి",
        "అగుదును అన్యజనులలో నేను మహోన్నతుండను"
      ],
      "english": [
        "Oorakundudi nene dhevudanani thelisikonudi",
        "Agudhunu anyajanulalo nenu mahonnathundanu"
      ]
    }
  ]
}
