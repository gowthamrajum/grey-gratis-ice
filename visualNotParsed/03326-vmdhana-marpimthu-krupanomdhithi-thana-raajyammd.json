  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు నంగీకరించితి దైవపుత్రుడ నైతిని",
        "పరమానందము నిజమైన శాంతియు అధిక జయము నొందితి",
        "వందన మర్పింతు కృపనొందితి",
        "తన రాజ్యమందున చేరితిని"
      ],
      "english": [
        "Yesu nangeekarinchithi dhaivaputhruda naithini",
        "Paramaanandhamu nijamaina shaanthiyu adhika jayamu nondhithi",
        "Vandhana marpinthu krupanondhithi",
        "Thana raajyamandhuna cherithini"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తండ్రి ప్రేమను పొందితి తనతో నైక్యత కలిగె",
        "చేతికుంగరమును కాళ్ళకు జోళ్ళను నూతన వస్త్రమొసగె"
      ],
      "english": [
        "Thandri premanu pondithi thanatho naikyatha kalige",
        "Chethikungaramunu kaallaku jollanu noothana vasthramosage"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దోషముల్ క్షమింపబడె నా పాపము కప్పబడె",
        "నా ఋణపత్రము మేకులగొట్టి నిర్దోషినిగా తీర్చె"
      ],
      "english": [
        "Dhoshamul kshamimpabade naa paapamu kappabade",
        "Naa runapathramu mekulagotti nirdhoshinigaa theerche"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపపు శిక్ష తొలగెన్ నే నూతన సృష్టినైతిని",
        "రాజుగజేసె యాజకునిగను పాడెద హల్లెలూయ"
      ],
      "english": [
        "Paapapu shiksha tholagen ne noothana srushtinaithini",
        "Raajugajese yaajakuniganu paadeda hallelooya"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇహమును నే వదలి పరమ ప్రభుని చేరుదును",
        "ఆదినమునకై ప్రీతితోనేను కనిపెట్టుచున్నాను"
      ],
      "english": [
        "Ihamunu ne vadhali parama Prabhuni cherudhunu",
        "Aa dhinamunakai preethithonenu kanipettuchunnaanu"
      ]
    }
  ]
}
