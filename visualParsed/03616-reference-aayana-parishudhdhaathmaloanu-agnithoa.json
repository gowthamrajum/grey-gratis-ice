  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరిశుద్ధ అగ్నిని పంపు దేవా - రాజిల్లి వ్యాపింపజేయు దేవా"
      ],
      "english": [
        "Parishuddha agnini pampu Deva - Raajilli vyaapimpajeyu Deva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కరుణతో అగ్నికణములను - కరిగించి హృదయము తాకించుము"
      ],
      "english": [
        "Karunatho agnikanamulanu - Kariginchi hrudayamu thaakinchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేశమెల్లడలను దివ్యాగ్నిచే - దోషమెల్లను కాల్చి వేయుటకు"
      ],
      "english": [
        "Dheshamelladalanu dhivyaagniche - Dhoshamellanu kaalchi veyutaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కన్యక వృద్ధులు యౌవనులు - ఉన్నత ఆత్మచే నింపబడన్"
      ],
      "english": [
        "Kanyaka vruddhulu yauvanulu - Unnatha aathmache nimpabadan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపులు పశ్చాత్తాపపడన్ - శుద్ధుల మలినము పోగొట్టన్"
      ],
      "english": [
        "Paapulu pashchaatthaapapadan - Shuddhula malinamu pogottan"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పాపము శాపము లన్నియును - భస్మమి కాలి నశించునట్లు"
      ],
      "english": [
        "Paapamu shaapamu lanniyunu - Bhasmamai kaali nashinchunatlu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసుని ప్రేమను రుచిచూడను - విశ్వాసమునందు వర్థిల్లను"
      ],
      "english": [
        "Yesuni premanu ruchichoodanu - Vishvaasamunandhu varthillanu"
      ]
    }
  ]
}
