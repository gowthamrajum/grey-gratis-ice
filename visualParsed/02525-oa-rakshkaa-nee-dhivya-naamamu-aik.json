{
  "song_name": "O rakshakaa nee divya naamamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "జాన్ ఎల్లెర్ టన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఓ రక్షకా, నీ దివ్య నామము",
      "ఐక్యంబుతోను స్తుతియింతుము",
      "ఆరాధనాంత మెందు వేళయం",
      "దను గ్రహించు నీదు దీవెనన్."
    ],
    "english": [
      "O rakshakaa, nee divya naamamu",
      "Aikyambuthonu sthuthiyinthumu",
      "Aaraadhanaantha mendhu velayam",
      "Dhanu grahinchu needu dheevenan."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "గృహంబుఁ జేర నాత్మ శాంతిని",
        "ఒసంగి మాతో నుండుము సదా",
        "ఇచ్చట సేవఁ జేయు మమ్మును",
        "పాపంబుఁ జేయకుండఁగాయుము."
      ],
      "english": [
        "Gruhambu jera naathma shaanthini",
        "Osangi maatho nundumu sadaa",
        "Ichchata seva jeyu mammunu",
        "Paapambu jeyakunda gaayumu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మా చుట్టు నుండు మబ్బునఁ ప్రభో",
        "నీ దివ్యకాంతిన్ మాకు నియ్యుమా",
        "పాపాంధకా బాధ నుండి నీ",
        "బిడ్డల మైన మమ్ముఁ బ్రోవుమా."
      ],
      "english": [
        "Maa chuttu nundu mabbuna Prabho",
        "Nee dhivyakaanthin maaku niyyumaa",
        "Paapaandhakaa baadha nundi nee",
        "Biddala maina mammu brovumaa."
      ]
    }
  ]
}
