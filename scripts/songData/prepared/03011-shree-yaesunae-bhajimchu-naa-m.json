{
  "song_name": "Shree Yaesunae Bhajinchu Naa Manasaa",
  "author": {
    "Authored by": "",
    "రచన": "యెషయా వీరమార్టిన్"
  },
  "main_stanza": {
    "telugu": [
      "శ్రీ యేసునే భజించు నా మనసా శ్రీ యేసునే భజించు",
      "శ్రీ యేసు ప్రభునే భజించు నా మనసా శ్రీ యేసునే భజించు"
    ],
    "english": [
      "Shree Yaesunae Bhajinchu Naa Manasaa Shree Yaesunae Bhajinchu",
      "Shree Yaesu Prabhunae Bhajinchu Naa Manasaa Shree Yaesunae Bhajinchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు త్రిత్వమం దీశ కుమారుఁడు",
        "భాసురుఁ డాతఁడు భూషిత రక్షకుఁడు"
      ],
      "english": [
        "Yaesu Thrithvamam Dheesha Kumaarudu",
        "Bhaasuru Daathadu Bhooshitha Rakshakudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నరుల దురితస్థితిఁ గరుణించి వారికిఁ",
        "పరమ సుఖము లిడ పరికించి వచ్చిన"
      ],
      "english": [
        "Narula Dhurithasthithi Garuninchi Vaariki",
        "Parama Sukhamu Lida Parikinchi Vachchina"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "స్వామికి మహిమయు భూమికి నెమ్మది",
        "క్షేమము నియ్యను లేమిడిఁ బుట్టిన"
      ],
      "english": [
        "Svaamiki Mahimayu Bhoomiki Nemmadhi",
        "Kshaemamu Niyyanu Laemidi Buttina"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నరులను తండ్రితో నైక్యము జేయగ",
        "నిరతము వేఁడెడి నిజప్రాపకుఁ డగు"
      ],
      "english": [
        "Narulanu Thandrithoa Naikyamu Jaeyaga",
        "Nirathamu Vaededi Nijapraapaku Dagu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మూఁడవ దినమున మృత్యువు నోడించి",
        "తడయక పునరు త్థానము నొందిన"
      ],
      "english": [
        "Moodava Dhinamuna Mruthyuvu Noadinchi",
        "Thadayaka Punaru Ththaanamu Nondhina"
      ]
    }
  ]
}
