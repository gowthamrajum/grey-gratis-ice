  "main_stanza": {
    "telugu": [
      "గురుపోతు కొమ్మువలె – నా తలను పైకెత్తితివి",
      "క్రొత్త తైలముతో అభిషేకించితివి",
      "సరికొత్త తైలముతో అభిషేకించితివి"
    ],
    "english": [
      "Gurupothu kommuvale – naa thalanu paiketthithivi",
      "krotha thailamutho abhishekinchithivi",
      "sarikotha thailamutho abhishekinchithivi"
    ]
  },
