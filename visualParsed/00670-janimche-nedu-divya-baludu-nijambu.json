  "main_stanza": {
    "telugu": [
      "జనించె నేడు దివ్య బాలుడు",
      "నిజంబు బెత్లెహేము పురమునందునా",
      "పాడెదం శుభములంచు హాయిగా",
      "మధురమైన ఈ ఉదయ వేళలో"
    ],
    "english": [
      "Janinche nedu divya baaludu",
      "Nijambu Bethlehemu puramunandhunaa",
      "Paadedam shubhamulanchu haayigaa",
      "Madhuramaina ee udaya velalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తలను దాల్చి స్ధలము లేక పొయిన",
        "తనదు జనులే తనను త్రీసి వేసిన",
        "దైవ ప్రేమ తనలో వక్తమగుటాకు",
        "తరలివెచ్చె తండ్రియే కుమారుడై"
      ],
      "english": [
        "Thalanu daalchi sthalamu leka poyina",
        "Thanadu janule thananu throsi vesina",
        "Daiva prema thanalo vyakthamagutaku",
        "Tharalivachche thandriye kumaarudai"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాడి దేవ దూతలాకాశంబున",
        "పాడే మనుజ కోటి భూతలంబున",
        "పాడవోయి నీదు హృదయమందున",
        "ముదము మీద ప్రభువు పవ్వళింపగా"
      ],
      "english": [
        "Paadi deva dhoothalaakaashambuna",
        "Paade manuja koti bhoothalambuna",
        "Paadavoyi needu hrudhayamandhuna",
        "Mudhamu meeda prabhuvu pavvalimpagaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరము నేల దివ్య రాజు సుతునిగా",
        "పవ్వళించే పశులశాల తోట్టెలో",
        "పవ్వళింప నీదు హృదయమందున",
        "వేచి వుండెనోయి ఈ దినంబున"
      ],
      "english": [
        "Paramu nela divya raaju suthunigaa",
        "Pavvalinche pashulashaala thottelo",
        "Pavvalimpa needu hrudhayamandhuna",
        "Vechi vundenoyi ee dhinambuna"
      ]
    }
  ]
