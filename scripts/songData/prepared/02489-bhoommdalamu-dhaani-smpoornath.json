    {
      "stanza_number": 6,
      "telugu": [
        "ద్వారంబు లార యింక మీ తల లెల్లబైకెత్త వలెన్",
        "రారాజు కొరకుఁతలుపులాలా మిమ్మెత్తుకొనుఁడి"
      ],
