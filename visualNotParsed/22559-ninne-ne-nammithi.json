  "main_stanza": {
    "telugu": [
      "నిన్నే నే నమ్మితీ",
      "నీవే నా వైధ్యుడవు",
      "నిన్నే నే నమ్మితీ",
      "నీవే నా ఆధారము",
      "ఏదేమైనా, ఏ స్థితియైన",
      "నీవే నా సహాయము",
      "ఎంతగానో వేదనతో",
      "బలమంతా కోల్పోతిని",
      "నిరీక్షణ నీవే దేవా",
      "నన్ను బాగుచేయుమయ్యా",
      "ఏ తోడు లేక చేయూత లేక",
      "నన్నందరు విడచిపోతిరే",
      "నా ఆధారం, ఆశ్రయం,",
      "ఆనందం, అభయం నీవేగా",
      "కృప చూపుము",
      "ఈ కన్నీరంతా ప్రేమతోనే తుడచివేయుమయ్యా",
      "దైవాత్మతో నన్ను తాకి నన్ను స్వస్థపరచుమయ్యా",
      "యెహోవా రాఫా, యెహోవా షమ్మా",
      "సర్వశక్తిమంతుడైన దేవా",
      "నీకసాధ్యమైనది ఏదియు లేదని నమ్మెద",
      "జీవింపుము"
    ],
