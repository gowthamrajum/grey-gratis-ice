{
  "song_name": "Bethlehemu Puramunanduna",
  "author": {
    "Authored by": "Renikuntla Vidya Sagar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "బెత్లెహేము పురమునందున",
      "కన్య మరియ గర్భమందున",
      "బాలయేసుడు పుట్టేనమ్మా",
      "గొల్లలు జ్ఞానులు ఆరాధించిరి",
      "మనము కూడా ఆరాధింతుము",
      "యేసుని హల్లెలుయ"
    ],
    "english": [
      "Bethlehemu puramunandhuna",
      "kanya mariya garbhamandhuna",
      "baala yesudu puttenamma",
      "gollalu gnaanulu aaraadhinchiri",
      "manamu kudaa aradhinthumu",
      "yesuni halleluyah"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శాపాన్ని తొలగించడానికి",
        "పాపాన్ని కడిగేయడానికి",
        "పశువుల పాకలో పుట్టాడు",
        "మానవులను రక్షించుటకు",
        "ఆరాధించిరి ఆనాడు యేసుని",
        "మనము కూడా ఆరాధింతుము",
        "కష్టాలను తీర్చడానికి",
        "కన్నీటిని తుడవడానికి",
        "కల్వరిలో ప్రాణమిచ్చుటకై",
        "ప్రభుయేసు జన్మించెన్",
        "ఆరాధించిరి ఆనాడు యేసుని",
        "మనము కూడా ఆరాధింతుము"
      ],
      "english": [
        "Shaapaanni tholaginchadaaniki",
        "paapaanni kadigeyadaaniki",
        "pasuvula paakalo puttaadu",
        "maanavulanu rakshinchutaku",
        "aaraadhinchiri aanaadu yesuni",
        "manamu kuudaa aaraadhinthumu",
        "Kashtaalanu theerchadaaniki",
        "kanniitini tudavadaaniki",
        "kalvarilo praanamichutakai",
        "prabhuyesu janminchen",
        "aaraadhinchiri aanaadu yesuni",
        "manamu kuudaa aaraadhintumu"
      ]
    }
  ]
}
