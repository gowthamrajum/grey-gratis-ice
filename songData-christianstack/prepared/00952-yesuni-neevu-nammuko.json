{
  "song_name": "Yesuni Neevu Nammuko",
  "author": {
    "Authored by": "Pastor Kasi Lazarus",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసుని నీవు నమ్ముకో – రక్షణ పొందుకో",
      "నిత్య రాజ్యమును సొంతం చేసుకో"
    ],
    "english": [
      "Yesuni neevu nammuko – rakshana pondhuko",
      "nithya raajyamunu sontham chesuko"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మన్ను నుండి వచ్చిన నీవు మన్నై పోదువు",
        "నీ ఆత్మకు మరణము లేదులే",
        "నీటి బుడగలాంటిది నీ జీవితం",
        "ఒక రోజు పగులునని తెలుసుకో",
        "లోకమును చూచి నీవు మోసపోకుమా",
        "యేసయ్యే మార్గమని తెలుసుకో సుమా!"
      ],
      "english": [
        "Mannu nundi vachina neevu mannai podhuvu",
        "nee aathmaku maranamu ledule",
        "Neeti budagalaantidhi nee jeevitham",
        "oka roju pagulunani thelusuko",
        "Lokamunu choochi neevu mosapokumaa",
        "yesayye maargamani thelusuko sumaa!"
      ]
    }
  ]
}
