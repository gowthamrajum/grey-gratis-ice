{
  "song_name": "Mahaa Devudu",
  "author": {
    "Authored by": "Dr. Negala Joshua",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మహాదేవుడా మహోన్నతుడా",
      "మహాఘనుడా మా పరిశుద్ధుడా",
      "యుగయుగములకు దేవుడవు",
      "తరతరములకు నీవే మా ప్రభుడవు"
    ],
    "english": [
      "Mahaa dhevudaa mahonnathudaa",
      "mahaaghanudaa maa parishuddhudaa",
      "yugayugamulaku dhevudavu",
      "tharatharamulaku neeve maa prabhudavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తోత్రార్హుడా స్తుతి పాత్రుడా",
        "స్తుతులందుకో నా యేసయ్య",
        "ఆరాధన నీకే యేసయ్య",
        "స్తుతి అర్పణ నీకే మెస్సయ్య"
      ],
      "english": [
        "Sthothraahudaa sthuthi paathrudaa",
        "sthuthulandhuko naa yesayya",
        "aaraadhana neeke yesayya",
        "sthuthi arpana neeke messayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవా ఈరే యెహోవా షమ్మా",
        "యెహోవా షాలోమ్ యెహోవా రాఫా"
      ],
      "english": [
        "Yehovaa yeerey yehovaa shammaa",
        "yehovaa shalom yehovaa raaphaa"
      ]
    }
  ]
}
