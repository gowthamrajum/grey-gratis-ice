{
  "song_name": "Ninu Matrame Ne Nammanaya",
  "author": {
    "Authored by": "John J",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిను మాత్రమే నే నమ్మానయా",
      "నీవు మాత్రమే నా ధైర్యం యేసయ్యా",
      "నీ బాహుబలమే నడిపించును",
      "నా స్థితులన్నిటిని సరిచేయును",
      "కృప చూపువాడవయా నీ పిల్లలకు"
    ],
    "english": [
      "Ninu maathrame ne nammaanaya",
      "neevu maathrame naa dhairyam Yesayya",
      "nee baahubalame nadipinchunu",
      "naa sthithulannitini saricheyunu",
      "krupa choopuvaadavaya nee pillalaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు సెలవియ్యగా కలుగనిదేముంది",
        "వాక్కును పంపగా జరుగనిదేముంది",
        "సకలము నీదెనయా శ్రీమంతుడా",
        "స్తుతి నీకు పాడెదనయా",
        "సమకూర్చువాడవయా నీ పిల్లలకు",
        "నా ముందు నీవుండగా ఎదురొచ్చువాడెవడు",
        "కార్యము చేయగా అడ్డుపడువాడెవడు",
        "యుద్ధము నీదెనయా ఓ శూరుడా",
        "ముందుకు సాగెదనయా",
        "జయమిచ్చువాడవయా నీ పిల్లలకు",
        "నీవు కరుణించగా కాదనువాడెవడు",
        "శక్తితో నింపగా ఓడించువాడెవడు",
        "సాయము నీదెనయా సహాయకుడా",
        "నీలో దాగెదనయా",
        "బలమిచ్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Neevu selaviyyagaa kaluganidhemundhi",
        "vaakkunu pampagaa jaruganidhemundhi",
        "sakalamu needhenayaa srimanthudaa",
        "sthuthi neeku paadedhanayaa",
        "samakoorchuvaadavayaa nee pillalaku",
        "Naa mundu neevundagaa edhurochuvaadevadu",
        "kaaryamu cheyagaa addupaduvadevadu",
        "yuddhamu needenayaa o soorudaa",
        "mundhuku saagedhanayaa",
        "jayamichuvaadavayaa nee pillalaku",
        "Neevu karuninchagaa kaadhanuvadevadu",
        "sakthitho nimpagaa odinchuvaadevadu",
        "saayamu needhenayaa sahaayakudaa",
        "neelo dhaagedhanayaa",
        "balamichuvaadavayaa nee pillalaku"
      ]
    }
  ]
}
