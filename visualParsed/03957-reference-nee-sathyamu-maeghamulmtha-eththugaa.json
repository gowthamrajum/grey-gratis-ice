{
  "song_name": "Nithyudesune sthuthinchu - Thana sathyamu korakai",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నీ సత్యము మేఘములంత ఎత్తుగా నున్నది కీర్తన సామ్ 108:4",
      "నిత్యుడేసునే స్తుతించు - తన సత్యము కొరకై",
      "మధ్యవర్తియాయే చెదరిన - పరిశుద్ధులకు తానే యిలలో"
    ],
    "english": [
      "Nee sathyamu meghamulantha etthugaa nunnadhi keerthana Psalm 108:4",
      "Nithyudesune sthuthinchu - Thana sathyamu korakai",
      "Madhyavarthiyaaye chedarina - Parishuddhulaku thaane ilalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మేఘ మండల మంటుచున్నది - నాకు దాహంబది తీర్చుచున్నది",
        "వేగమే మనుజులను మార్చివేయును - మార్చివేయునదియే"
      ],
      "english": [
        "Megha mandala mantuchunnadhi - Naaku dhaahambadhi theerchuchunnadhi",
        "Vegame manujulanu maarchiveyunu - Maarchiveyunadhiye"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విడుదలను ఇచ్చునదియే - విడిపించు ఘోరపాపము నుండి",
        "కడు శ్రమలనది స్వీకరించును స్వీకరించునదియె"
      ],
      "english": [
        "Vidudalanu ichchunadhiye - Vidipinchu ghorapaapamu nundi",
        "Kadu shramalanadhi sweekarinchunu sweekarinchunadhiye"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పృధివి నెల్లయు మారిపోయినన్ - సత్యమెన్నడు మారనే మారదు",
        "నిత్యమైన యేసు సత్యమాయెనిలలో - సత్యమాయెనిలలో"
      ],
      "english": [
        "Prudhivi nellayu maaripoyinan - Sathyamennadu maarane maaradu",
        "Nithyamaina Yesu sathyamaayenilalo - Sathyamaayenilalo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఖడ్గంబుబోలి కోయునదియె - పడగొట్టును దుష్టులనదియే",
        "వడివడిగా తనపని నెరవేర్చునదియె - నెరవేర్చునదియే"
      ],
      "english": [
        "Khadgambuboli koyunadhiye - Padagottunu dushtulanadhiye",
        "Vadivadigaa thanapani neraverchunadhiye - Neraverchunadhiye"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఉదకంబు బోలి కడుగునదియె - అద్దముబోలి చూపునదియే",
        "అది బంగారు విలువ గలది - విలువ గలదియే"
      ],
      "english": [
        "Udhakambu boli kadugunadhiye - Addhamuboli choopunadhiye",
        "Adhi bangaaru viluva galadi - Viluva galadhiye"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దీపమై చీకటిని పోగొట్టును - కోపమున్ బారద్రోలును నదియే",
        "ఆపదలనెల్ల తొలగించునదియె - తొలగించునదియే"
      ],
      "english": [
        "Deepamai cheekatini pogottunu - Kopamun baaradhrolunu nadhiye",
        "Aapadhalanella tholaginchunadhiye - Tholaginchunadhiye"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సుత్తెను బోలి పగులగొట్టును - మెత్తగా చేసి ఒప్పించునదియే",
        "క్రొత్త తేనెన్ బోలి రుచించునదియె - హల్లెలూయా ఆమెన్"
      ],
      "english": [
        "Sutthenu boli pagulagottunu - Metthagaa chesi oppinchunadhiye",
        "Krottha thenen boli ruchinchunadhiye - Hallelooyaa aamen"
      ]
    }
  ]
}
