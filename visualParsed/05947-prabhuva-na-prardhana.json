{
  "song_name": "Prabhuvaa naa praardhana",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నా ప్రార్ధన ఆలకించుమా",
      "దేవా నా మొట్ట నీ సన్నిధికి చేరనీయుమా"
    ],
    "english": [
      "Prabhuvaa naa praardhana aalakinchumaa",
      "Deva naa mora nee sannidhiki cheraneeyumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కారుచీకటి వేళలో నా దారి కానక పోయెనే",
        "నమ్మిన ఆ స్నేహమే నన్ను ఒంటరి(ని)గా చేసెనే",
        "కాదనని ప్రేమకై (నే) నిన్ను చేరితినయ్యా (2)"
      ],
      "english": [
        "Kaaru cheekati velalo naa daari kaanaka poyene",
        "Nammina aa snehame nannu ontari(ni)gaa chesene",
        "Kaadanani premakai (ne) ninnu cherithinayyaa (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మరపురాని నిందలే నా గాయములను రేపెనే",
        "మదిలో నిండిన భయములే నన్ను కృంగదీసెనే",
        "నన్ను మరువలేని ప్రేమకై (నే) నిన్ను చేరితినయ్యా (2)"
      ],
      "english": [
        "Marapuraani nindhale naa gaayamulanu repene",
        "Madilo nindina bhayamule nannu krungadheesene",
        "Nannu maruvaleni premakai (ne) ninnu cherithinayyaa (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేను చేసిన పాపమే నాకు శాపమై మిగిలెనే",
        "నాదు దోష కార్యములే నన్ను నీకు దూరము చేసెనే",
        "నన్ను మన్నించే ప్రేమకై (3) నిన్ను చేరితినయ్యా (2)"
      ],
      "english": [
        "Nenu chesina paapame naaku shaapamai migilene",
        "Naadu dosha kaaryamule nannu neeku dooramu chesene",
        "Nannu manninche premakai (3) ninnu cherithinayyaa (2)"
      ]
    }
  ]
}
