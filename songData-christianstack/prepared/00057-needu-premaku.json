{
  "song_name": "Needu Premaku",
  "author": {
    "Authored by": "Jyothi Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీదు ప్రేమకు హద్దు లేదయా",
      "నీదు ప్రేమకు కొలత లేదయా",
      "నీదు ప్రేమకు సాటి రారయా.. ఎవ్వరు",
      "పొగడదగిన ప్రేమమూర్తివి నీవయా.. యేసయ్యా"
    ],
    "english": [
      "Needhu premaku haddhu ledhayya",
      "Needhu premaku kolatha ledhayya",
      "Needhu premaku saati raarayya evvaru",
      "Pogadadhagina prema moorthivi neevayya Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తల్లి తండ్రులు చూపలేని ప్రేమ",
        "తనయులివ్వని తేటనైన ప్రేమ",
        "పేదలకు నిరు పేదలకు",
        "విధవలకు అనాథలకు",
        "బంధు మిత్రులు చూపలేని ప్రేమా",
        "కొనియాడదగిన ప్రేమమూర్తివి నీవయా.. యేసయ్యా"
      ],
      "english": [
        "Thallidhandrulu choopaleni prema",
        "Thanayuniyyani thetanaina prema",
        "Pedhalaku nirupedhalakunu",
        "Vidhavalakunu anaadhalakunu",
        "Bandhumithrulu choopaleni prema",
        "Koniyadadhagina prema moorthivi neevayya Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నరులకై నర రూపమైన ప్రేమ",
        "పరము చేర్చగ ప్రాణమిచ్చిన ప్రేమ",
        "దొంగలకు వ్యభిచారులకును",
        "కౄరులకు నర హంతకులకు",
        "మనుజులివ్వని మధురమైన ప్రేమా",
        "కీర్తించదగిన ప్రేమమూర్తివి నీవయా.."
      ],
      "english": [
        "Narulakai nararoopamaina prema",
        "Paramu cherchaga praanamichina prema",
        "Dhongalaku vyabhichaarulakunu",
        "Kroorulaku narahanthakulaku",
        "Manujulivvani madhuramaina prema",
        "Keerthinchadhagina prema moorthivi neevayya Yesayya"
      ]
    }
  ]
}
