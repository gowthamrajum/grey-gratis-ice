{
  "song_name": "Vishvaasa Sahithamuganu Prakatinchudi Yaesuni",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "విశ్వాస సహితముగను - ప్రకటించుడి యేసుని"
    ],
    "english": [
      "Vishvaasa Sahithamuganu - Prakatinchudi Yaesuni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిత్యజీవము చేపట్టి - సత్యవేదము చేబూని (2)",
        "పవిత్ర హృదయములతో - పోరాడుడి విజయముతో (2)"
      ],
      "english": [
        "Nithyajeevamu Chaepatti - Sathyavaedhamu Chaebooni (2)",
        "Pavithra Hrudhayamulathoa - Poaraadudi Vijayamuthoa (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీతిని భక్తిని గోరి - నిజమైన విశ్వాసులుగా",
        "ఓర్పును ప్రేమనుగల్గి - పోరాడుడి విజయముతో"
      ],
      "english": [
        "Neethini Bhakthini Goari - Nijamaina Vishvaasulugaa",
        "Oarpunu Praemanugalgi - Poaraadudi Vijayamuthoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆకాశమున నుండి - కలిగిన దర్శనమునకు",
        "అవిధేయత చూపకను - పోరాడుడి విజయముతో"
      ],
      "english": [
        "Aakaashamuna Nundi - Kaligina Dharshanamunaku",
        "Avidhaeyatha Choopakanu - Poaraadudi Vijayamuthoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తేసు మనసు కలిగి - సత్క్రియలను జరిగించి",
        "యోధులుగా నిలుచుండి - పోరాడుడి విజయముతో"
      ],
      "english": [
        "Kreesthaesu Manasu Kaligi - Sathkriyalanu Jariginchi",
        "Yoadhulugaa Niluchundi - Poaraadudi Vijayamuthoa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "దీన మనసు కలిగి - ప్రియులారా లోబడియు",
        "మహిమ కిరీటముకై - పోరాడుడి విజయముతో"
      ],
      "english": [
        "Dheena Manasu Kaligi - Priyulaaraa Loabadiyu",
        "Mahima Kireetamukai - Poaraadudi Vijayamuthoa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆత్మల రక్షణకొరకై - అర్పించుడి జీవితము",
        "అంతమువరకు నిలిచి - పోరాడుడి విజయముతో"
      ],
      "english": [
        "Aathmala Rakshanakorakai - Arpinchudi Jeevithamu",
        "Anthamuvaraku Nilichi - Poaraadudi Vijayamuthoa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసుని జీవము కలిగి - ఇలలో శ్రమనోర్చుచు",
        "విజయోత్సాహముతోడ - హల్లెలూయ పాడెదము"
      ],
      "english": [
        "Yaesuni Jeevamu Kaligi - Ilaloa Shramanoarchuchu",
        "Vijayoathsaahamuthoada - Hallelooya Paadedhamu"
      ]
    }
  ]
}
