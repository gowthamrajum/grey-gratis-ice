        "పరలోక రారాజు పాకలో జన్మించెను"
      ],
      "english": [
        "Pre-Chorus",
        "Dhevudai yundenu dhaasuniga maarenu",
        "Maanavuni Chesenu maanavuniga maarenu",
        "Balamaina Dhevudu baaluniga maarenu",
        "Paraloka raaraju paakalo janminchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మరణమే లేనివాడు మృతునిగా మారెను",
        "సర్వశక్తిమంతుడు సిలువపై వ్రేలాడెను",
