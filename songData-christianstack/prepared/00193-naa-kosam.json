{
  "song_name": "Naa Kosam",
  "author": {
    "Authored by": "Nathanael",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నాకోసం నీ ప్రాణం",
      "ఎందుకలా ఇచ్చావు",
      "నీవు మాట ఇచ్చావనా",
      "నీవు మనసు ఇచ్చావనా",
      "దేవా – ఎంత ప్రేమయ్యా – నా యేసయ్య",
      "అర్హత లేదయ్యా – యోగ్యుని కానయ్య"
    ],
    "english": [
      "Naakosam nee praanam",
      "Endukulaa ichaavu",
      "Neevu maata ichaavanaa",
      "Neevu manasu ichaavanaa",
      "Devaa – enta premayya – naa yesayya",
      "Arhata ledaayya – yogyuni kaanayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా రోగం భరియించి",
        "నా వ్యసనం సహియించి",
        "దోషమంత నాది కాగ",
        "నాకొరకై నీవు నలిగితివా",
        "నా శిక్ష నీపై పడిన",
        "నీ నోరు తెరువకున్నావు",
        "మౌనముగా ఉన్నావు"
      ],
      "english": [
        "Naa rogam bhariyinchi",
        "Naa vyasnam sahiyinchi",
        "Doshamantha naadi kaaga",
        "Naakorakai neevu naligitivaa",
        "Naa shiksha neepai padina",
        "Nee nooru teruvakunnaavu",
        "Mounamuga unnaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా పాపం మోసితివి",
        "అన్యాయం పొందితివి",
        "వేదనెంతో భారమైన",
        "చూసి తృప్తి పొందితివి",
        "నీ ప్రాణము దారపోసి",
        "పరిహారము చేసినావు",
        "శుద్ధినిగా చేసావు",
        "నిర్దోషిగా మార్చావు"
      ],
      "english": [
        "Naa paapam mositivi",
        "Anyaayam ponditivi",
        "Vedane ento bhaaramaina",
        "Choosi trupti ponditivi",
        "Nee praanamu daaraposi",
        "Parihaaramu chesinaavu",
        "Shuddhiniga chesavu",
        "Nirdoshiga maarchaavu"
      ]
    }
  ]
}
