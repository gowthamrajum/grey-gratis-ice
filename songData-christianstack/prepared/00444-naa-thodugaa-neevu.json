  },
  "main_stanza": {
    "telugu": [
      "నా తోడుగ నీవు – నీ నీడలో నేను",
      "కలకాలం ఉండాలనీ",
      "నీతోనే నేను రానా – నీతోనేనుండిపోనా"
    ],
    "english": [
      "Naa thodugaa neevu – nee needalo nenu",
      "kalakaalam undaalani",
      "neethoney nenu raanaa – neethone nundiponaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసయ్యా యేసయ్యా",
        "స్తుతి ఘన మహిమలతో",
        "నిన్నే ఆరాధించెదను"
      ],
      "english": [
        "Yesayya yesayya",
        "sthuthi ghana mahimalatho",
        "ninne aaraadhinchedhanu"
      ]
    }
  ]
}
