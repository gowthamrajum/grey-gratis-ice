{
  "song_name": "Nishabdhamlo",
  "author": {
    "Authored by": "Reshma Reigna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిశబ్దంలో ఓ నవరాగం వినిపించేలే",
      "నా గుండెల్లో ఎన్నడూ ఎరుగని హాయినిండేనే",
      "నాకున్న చీకటిబ్రతుకు మారిపోయే, దోషములన్నీ తొలగిపోయే, సంతోషమాగదే",
      "నాకున్న కన్నీరిఅంత వెలసిపోయే",
      "పాపభారం తొలిగే (నే)",
      "నీ రాకతోనే…"
    ],
    "english": [
      "Nishabdamlo o navaraagam vinipinchele",
      "Naa gundello ennadhu erugani haayinindeane",
      "Naakunna cheekati brathuku maaripoyene,",
      "Dhoshamulannee tholagipoyene, santhoshamagadhe",
      "Naakunna kanneerantha velasipoyene",
      "Paapabhaaram tholige (ne)",
      "Nee raakathone"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాలోన పొంగేలే ఆనందం ఈ దినాన",
        "నీలోన రక్షణ మార్గము కలిగే ఈ వేళ"
      ],
      "english": [
        "Naalona pongene aanandham ee dhinaana",
        "Neelona rakshana maargamu kalige ee vela"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాకై నీవే వచ్చినావే, మానవ రూపం ధరించినావే నా ఊహకందదే",
        "నీ నేరిగిన మరుక్షణం, నీ రూపంలో మార్చినావే, ప్రేమను మదిలో నింపినావే",
        "ఎంతో ఆశ్చర్యమే"
      ],
      "english": [
        "Naakai neeve vachinaave",
        "Maanava roopam dharichinaave",
        "Naa oohakandhadhe",
        "Neanerigina marukshanam",
        "Nee roopamlo marchinaave",
        "Premaanu madhilo nimpinaave",
        "Entho aascharyame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆ నింగిలో నక్షత్రాన్ని వెంబడించనే",
        "నా యేసు నీ సన్నిధి చేరి ఆరాధించనే",
        "నాకున్న చీకటిబ్రతుకు మారిపోయే, దోషములన్నీ తొలగిపోయే, సంతోషమాగదే",
        "కన్నీరిఅంత వెలసిపోయే",
        "పాపభారం తొలిగే (నే)",
        "నీ రాకతోనే…"
      ],
      "english": [
        "Aa ningilo nakshathraanni vembadinchanea",
        "Naa Yesaya, nee sannidhi cherii aaradhinchane",
        "Naakunna cheekati brathuku maaripoyene,",
        "Dhoshamulannee tholagipoyene, santhoshamagadhe",
        "Kanneerantha velasipoyene",
        "Paapabhaaram tholige (ne)",
        "Nee raakathone"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాలోన పొంగేలే ఆనందం ఈ దినాన",
        "నీలోన రక్షణ మార్గము కలిగే ఈ వేళ"
      ],
      "english": [
        "(Repeat):",
        "Naalona pongene aanandham ee dhinaana",
        "Neelona rakshana maargamu kalige ee vela"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నాకై నీవే వచ్చినావే, మానవ రూపం ధరించినావే నా ఊహకందదే",
        "నీ నేరిగిన మరుక్షణం, నీ రూపంలో మార్చినావే, ప్రేమను మదిలో నింపినావే",
        "ఎంతో ఆశ్చర్యమే !"
      ],
      "english": [
        "Naakai neeve vachinaave",
        "Maanava roopam dharichinaave",
        "Naa oohakandhadhe",
        "Neanerigina marukshanam",
        "Nee roopamlo marchinaave",
        "Premaanu madhilo nimpinaave",
        "Entho aascharyame"
      ]
    }
  ]
}
