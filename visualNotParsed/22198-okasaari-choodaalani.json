  "main_stanza": {
    "telugu": [
      "ఒకసారి చూడాలనీ",
      "ఒకసారి తాకాలనీ",
      "నీకోసం నే వేచి ఉన్నా",
      "ఆరాధనా ఆరాధనా ఆరాధనా యేసుకే",
      "నిత్యము నిను చూడాలని",
      "నీతోనే నడవాలనీ",
      "నా గుండె లోతుల్లోని ఆశయ్యా",
      "నా ప్రియుడా – నా యేసయ్యా",
      "నీ ధ్యాసయే నా శ్వాసయ్యా",
      "ఒక్క క్షణము యుగమాయే",
      "గుండంతా బరువాయే",
      "నేను నిన్ను చూడని రోజునా",
      "నా ప్రియుడా – నా యేసయ్యా",
      "నీ ధ్యాసయే నా శ్వాసయ్యా"
    ],
