{
  "song_name": "Pilichenu Prabhu Yesu",
  "author": {
    "Authored by": "A J Emmanuel",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పిలిచెను ప్రభు యేసు నాథుడు",
      "ప్రేమతో నిను తెలుసుకో",
      "అలక దృష్టితో పలుచ సేయక",
      "దీనమనస్సుతో చేరుకో.."
    ],
    "english": [
      "Pilichenu prabhu yesu naadhudu",
      "prematho ninu thelusuko",
      "alaka dhrustitho palucha seyaka",
      "dheena manassutho cheruko"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కంటికి కనబడునదెల్ల",
        "మంటికి మరి మరలిపోవు",
        "నేలనొలికిన నీటి వలెనే",
        "మరల రాదని తెలుసుకో",
        "నరుడుయగు ప్రతివాడు పాపియె",
        "మరణమే పాపపు ఫలితము",
        "నరులకు నిత్య జీవమొసగెడు",
        "యేసు ప్రభువును చేరుకో"
      ],
      "english": [
        "Kantiki kanabadunadhella",
        "mantiki mari maralipovu",
        "nela nolikina neeti valane",
        "marala raadhani thelusuko",
        "Naruduyagu prathivaadu paapiye",
        "maraname paapapu phalithamu",
        "narulaku nithya jeevamosagedu",
        "yesu prabhuvunu cheruko"
      ]
    }
  ]
}
