{
  "song_name": "Naadu praana moprabho nenu neekarpinthunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఫ్రాన్సెస్ రిడ్లీ హవగ్గల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నాదు ప్రాణ మోప్రభో,",
      "నేను నీకర్పింతును.",
      "నాదు చేతు లెప్పుడు",
      "నీదు సేవఁ జేయనీ",
      "నాదు కాళ్లు లెస్సగా",
      "నీదు త్రోవఁ బోవనీ",
      "నాదు స్వర మెన్నఁడు",
      "నీదు స్తుతిఁ బాడనీ"
    ],
    "english": [
      "Naadu praana moprabho,",
      "Nenu neekarpinthunu.",
      "Naadu chethu leppudu",
      "Needu seva jeyanee",
      "Naadu kaallu lessagaa",
      "Needu throva bovanee",
      "Naadu svara mennadu",
      "Needu sthuthi baadanee"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "నాదు నోరు నిత్యము",
        "నీదు బోధఁ బల్క నీ",
        "నాదు సొమ్ము సొత్తులు",
        "నీకు నిత్తు నెప్పుడు",
        "నాదు కాల మంతయు",
        "నిన్నుఁ బ్రస్తుతింపనీ",
        "బుద్ధి పూర్వకంబు",
        "నిన్ను నేను కొల్వనీ."
      ],
      "english": [
        "Naadu noru nithyamu",
        "Needu bodha balka nee",
        "Naadu sommu soththulu",
        "Neeku niththu neppudu",
        "Naadu kaala manthayu",
        "Ninnu brasthuthimpanee",
        "Buddhi poorvakambu",
        "Ninnu nenu kolvanee."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సొంత మేలుఁ గోరక",
        "నీదు కీర్తిఁ గోరుదు",
        "నాదు నంతరంగము",
        "స్వీకరించి యేలుము",
        "నాదు నిండు ప్రేమను",
        "నీకర్పింతు నెప్పుడు",
        "నన్ను నీదు సొత్తుగా",
        "నీ వంగీకరించుము."
      ],
      "english": [
        "Sontha melu goraka",
        "Needu keerthi gorudhu",
        "Naadu nantharangamu",
        "Sweekarinchi yelumu",
        "Naadu nindu premanu",
        "Neekarpinthu neppudu",
        "Nannu needu sotthugaa",
        "Nee vangeekarinchumu."
      ]
    }
  ]
