  "main_stanza": {
    "telugu": [
      "\"రారాజు పుట్టెను – నింగిలో తార వెలిసేను",
      "గొర్రెల కాపరులు – జ్ఞానులు పరుగున వచ్చేను\" (2)"
    ],
    "english": [
      "\"Raaraaju puttenu – Ningilo thaara velisenu",
      "Gorrela kaaparulu – Gnaanulu paruguna vachchenu\" (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మాహరాజు వచ్చెను – ప్రేమను పంచెను",
        "రారాజు పుట్టెను – రక్షణ ఇచ్చేను",
        "యేసు రాజు వచ్చెను - విమోచన తెచ్చెను"
      ],
      "english": [
        "Mahaaraaju vachchenu – Premanu panchenu",
        "Raaraaju puttenu – Rakshana ichchenu",
        "Yesu raaju vachchenu - Vimochana thechchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "\"యేసే - మన కన్నీరు తుడిచేది.",
        "యేసే - చిరు నవ్వును ఇచ్చేది\" (2)"
      ],
      "english": [
        "\"Yese - Mana kanneeru thudichedhi.",
        "Yese - Chiru navvunu ichchedhi\" (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గొర్రెల కాపరులు – జ్ఞానులు పరుగున వచ్చేను."
      ],
      "english": [
        "Gorrela kaaparulu – Gnaanulu paruguna vachchenu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "\"మనలో మన అందరిలో",
        "ఆనంద గానాలు నింపేది ఈ రాజే\" 2",
        "\"పాడు ..... కొనియాడు",
        "ఆనందముతో - గానమాడు\"(2)"
      ],
      "english": [
        "\"Manalo mana andarilo",
        "Aananda gaanaalu nimpedhi ee raaje\" 2",
        "\"Paadu ..... koniyaadu",
        "Aanandamutho - Gaanamaadu\"(2)"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
