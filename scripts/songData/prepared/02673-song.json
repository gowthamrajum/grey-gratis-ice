  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తు వీరులారా యుద్ధ మాడుఁడీ",
      "క్రీస్తు ధ్వజ మెత్తి జయ మొందుఁడీ"
    ],
    "english": [
      "Kreesthu Veerulaaraa Yudhdha Maadudee",
      "Kreesthu Dhvaja Meththi Jaya Mondhudee"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రీస్తు యోధులారా యుద్ధ మాడుఁడీ",
        "క్రీస్తు సిల్వ మీరు పట్టి గెల్వుఁడీ",
        "మన రాజు క్రీస్తు దండు నడ్పును",
        "చూడు మాకు ముందు క్రీస్తు ధ్వజము."
      ],
      "english": [
        "Kreesthu Yoadhulaaraa Yudhdha Maadudee",
        "Kreesthu Silva Meeru Patti Gelvudee",
        "Mana Raaju Kreesthu Dhandu Nadpunu",
        "Choodu Maaku Mundhu Kreesthu Dhvajamu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోక రాజ్య కీర్తి వాడిపోవును",
        "క్రీస్తు రాజ్యమైన నిత్య ముండును",
        "సాతా నాధిపత్య మాఁగిపోవును",
        "క్రీస్తు దివ్య సభ జయ మొందును."
      ],
      "english": [
        "Loaka Raajya Keerthi Vaadipoavunu",
        "Kreesthu Raajyamaina Nithya Mundunu",
        "Saathaa Naadhipathya Maagipoavunu",
        "Kreesthu Dhivya Sabha Jaya Mondhunu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఓ జనంబులారా వచ్చి చేరుఁడీ",
        "జయ కీర్తనంబు లెత్తి పాడుఁడీ",
        "కీర్తి, స్తుతి, ఘవ మెన్నఁ డుండును",
        "మన క్రీస్తు రాజు నిత్య మేలును."
      ],
      "english": [
        "Oa Janambulaaraa Vachchi Chaerudee",
        "Jaya Keerthanambu Leththi Paadudee",
        "Keerthi, Sthuthi, Ghava Menna Dundunu",
        "Mana Kreesthu Raaju Nithya Maelunu."
      ]
    }
  ]
