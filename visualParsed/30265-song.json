{
  "song_name": "Bhavishyadh gnaanamu pai nundi vachchu gnaanamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "లోక జ్ఞానము కన్నా మిన్నైనది – ప్రభు వాక్యములోని భవిష్యద్ జ్ఞానము",
      "చీకటి దారిలో వెలుగునిచ్చునది – పరిశుద్ధాత్మ ఇచ్చే పరలోక జ్ఞానము",
      "యేసు మార్గమే జీవపు బాట – ఆయన మాటయే మన రక్షణ కోట"
    ],
    "english": [
      "Loka gnaanamu kannaa minnainadhi – Prabhu vaakyamuloni bhavishyadh gnaanamu",
      "Cheekati daarilo velugunichchunadhi – Parishuddhaathma ichche paraloka gnaanamu",
      "Yesu maargame jeevapu baata – Aayana maataye mana rakshana kota"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవా భయమే జ్ఞానమునకు మూలము",
        "వాక్యము తెలుపును నిత్య సత్యము",
        "లోకపు ఆశలు ఎండమావుల వంటివి",
        "దైవ రాజ్యమే నిత్య మహిమ వంటిది",
        "మట్టిలో సాగే మన జీవితమును",
        "మహిమకు నడిపే దైవ జ్ఞానము"
      ],
      "english": [
        "Yehovaa bhayame gnaanamunaku moolamu",
        "Vaakyamu telupunu nithya sathyamu",
        "Lokapu aashalu endamaavula vantivi",
        "Daiva raajyame nithya mahima vantidi",
        "Mattilo saage mana jeevithamunu",
        "Mahimaku nadipe daiva gnaanamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రేపటి దినమున భయపడకు మనసా",
        "నీ భారము మోసే ప్రభువున్నాడుగా",
        "నేటి శ్రమలే జయమునకు విత్తనము",
        "ఓర్పుతో నడిచితే ఆత్మ ఫలము",
        "కాలము నెరిగి దేవుని చిత్తము చేయుటే",
        "నిజమైన జ్ఞానమునకు నిదర్శనమే"
      ],
      "english": [
        "Repati dinamuna bhayapadaku manasaa",
        "Nee bhaaramu mose Prabhuvunnaadugaa",
        "Neti shramale jayamunaku vitthanamu",
        "Orputho nadichithe aathma phalamu",
        "Kaalamu nerigi Devuni chitthamu cheyute",
        "Nijamaina gnaanamunaku nidharshaname"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరిశుద్ధ గ్రంథమే వెలుగునిచ్చే దీపము",
        "మన అడుగులకు అది నిత్య మార్గము",
        "అంత్య దినములలో మోసములెన్ని వచ్చినా",
        "దైవ వాక్యమే మనకు మహా బలము",
        "క్రీస్తు సాక్షులమై లోకాన చాటెదము",
        "మన భవిష్యత్తును ప్రభు చేతిలో ఉంచెదము"
      ],
      "english": [
        "Parishuddha granthame velugunichche deepamu",
        "Mana adugulaku adhi nithya maargamu",
        "Anthya dinamulalo mosamulenni vachchinaa",
        "Daiva vaakyame manaku mahaa balamu",
        "Kreesthu saakshulamai lokaana chaatedhamu",
        "Mana bhavishyatthunu Prabhu chethilo unchedhamu"
      ]
    }
  ]
}
