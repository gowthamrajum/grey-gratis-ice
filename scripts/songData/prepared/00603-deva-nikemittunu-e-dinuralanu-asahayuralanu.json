  "main_stanza": {
    "telugu": [
      "దేవా నీకేమిత్తును ఈ దనురాలను అసహాయురాలను",
      "దేవా నికేమిత్తును (2)"
    ],
    "english": [
      "Deva Nikemittunu E Dinuralanu Asahayuralanu",
      "Deva Nikemittunu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృంగిన వేళ ఓదార్పు నీవైతివి",
        "దుఃఖించు వేళ కన్నీరు తుడిచితివి",
        "ఏ తీరు పోల్చను నీ స్నేహమును",
        "కృతజ్జతాస్తుతులు చెల్లింతును (2)"
      ],
      "english": [
        "Krumgina Vela Odarpu Nivaitivi",
        "Duhkimchu Vela Kanniru Tudichitivi",
        "E Tiru Polchanu Ni Snehamunu",
        "Krutajjatastutulu Chellimtunu (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకలి అనగా మన్నాను కురిపింతువు",
        "బండ నుండి జలమును పంపింతువు",
        "ఏలాగు విడువను నీ త్యాగమును",
        "మేలిమికన్నా ప్రియమైనది (2)"
      ],
      "english": [
        "Akali Anaga Mannanu Kuripimtuvu",
        "Bamda Numdi Jalamunu Pampimtuvu",
        "Elagu Viduvanu Ni Tyagamunu",
        "Melimikanna Priyamainadi (2)"
      ]
    }
  ]
