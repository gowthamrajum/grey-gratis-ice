{
  "song_name": "Ascharya Karuda",
  "author": {
    "Authored by": "Jasper Kunapo",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆశ్చర్యకరుడా – ఆలోచన కర్తా",
      "నీతి సూర్యుండా – నిత్యుడవగు తండ్రి",
      "సమాధాన కర్తా – అధిపతియగు ప్రభువా",
      "బలవంతుడ నీవు – భజియింతుము చేరి"
    ],
    "english": [
      "Aascharya karudaa – aalochana karthaa",
      "neethi suryundaa – nityudavagu thandri",
      "samaadhaana karthaa – adhipathiyagu prabhuvaa",
      "balavanthuda neevu – bhajiyinthumu cheri"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హల్లెలూయ హల్లెలూయ నీకే స్తోత్రము"
      ],
      "english": [
        "Hallelujah Hallelujah neeke sthothramu"
      ]
    }
  ]
}
