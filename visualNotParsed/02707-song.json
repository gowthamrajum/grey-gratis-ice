{
  "song_name": "O praarthanaa supraarthanaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "విలియం వాల్ఫోర్డ్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఓ ప్రార్థనా సుప్రార్థనా",
      "నీ ప్రాభవంబున్ మరతునా?",
      "నా ప్రభువున్ ముఖా ముఖిన్",
      "నేఁ బ్రణుతింతు నీ ప్రభన్",
      "నా ప్రాణమా సు ప్రార్థనా",
      "నీ ప్రేరణంబుచేఁ గదా",
      "నీ ప్రేమధారఁ గ్రోలుదు",
      "నో ప్రార్థనా సుప్రార్థనా."
    ],
    "english": [
      "O praarthanaa supraarthanaa",
      "Nee praabhavambun marathunaa?",
      "Naa prabhuvun mukhaa mukhin",
      "Ne branuthinthu nee prabhan",
      "Naa praanamaa su praarthanaa",
      "Nee preranambuche gadaa",
      "Nee premadhaara groludhu",
      "No praarthanaa supraarthanaa."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "పిశాచి నన్ను యుక్తితో",
        "వశంబు చేయఁ జూచుచో",
        "నీ శాంతమైన దీప్తియే",
        "నా శంక లెల్ల మానుపున్",
        "నీ శక్తి నేను మరతునా",
        "నా శైలమన ప్రార్థనా",
        "నా శోక మెల్లఁ దీర్చెడు",
        "విశేషమైన ప్రార్థనా."
      ],
      "english": [
        "Pishaachi nannu yukthitho",
        "Vashambu cheya joochucho",
        "Nee shaanthamaina dheepthiye",
        "Naa shanka lella maanupun",
        "Nee shakthi nenu marathunaa",
        "Naa shailamana praarthanaa",
        "Naa shoka mella dheerchedu",
        "Visheshamaina praarthanaa."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ దివ్యమైన రెక్కలే",
        "నా దుఃఖభార మెల్లను",
        "నా దేవుఁ డేసు చెంతకు",
        "మోదంబుఁ గొంచుఁబోవును",
        "సదా శుభంబు లొందను",
        "విధంబుఁ జూప నీవెగా",
        "నా ధైర్యమిచ్చు ప్రార్థనా",
        "సుధా సుధార ప్రార్థనా"
      ],
      "english": [
        "Nee divyamaina rekkale",
        "Naa dhuhkhabhaara mellanu",
        "Naa Devu Desu chenthaku",
        "Modhambu gonchubovunu",
        "Sadaa shubhambu londhanu",
        "Vidhambu joopa neevega",
        "Naa dhairyamichchu praarthanaa",
        "Sudhaa sudhaara praarthanaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అరణ్యమైన భూమిలో",
        "నా రమ్యమౌ పిస్గా నగం",
        "బు రంగుగాను నెక్కి నా",
        "చిరగృహంబుఁ జూతును",
        "శరీరమున్ విదల్చి నేఁ",
        "బరంబు బోవు వేళలో",
        "కరంబు నిన్ను మెచ్చెదన్",
        "పరేశు ధ్యాన ప్రార్థనా."
      ],
      "english": [
        "Aranyamaina bhoomilo",
        "Naa ramyamau Pisgaa nagam",
        "Bu ranguganu nekki naa",
        "Chiragruhambu joothunu",
        "Shareeramun vidhalchi ne",
        "Barambu bovu velalo",
        "Karambu ninnu mechchedhan",
        "Pareshu dhyaana praarthanaa."
      ]
    }
  ]
}
