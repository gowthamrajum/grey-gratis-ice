{
  "song_name": "Snaehampu Bandhamaa Shubhambu Nondhumaa",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ ఫాసెట్"
  },
  "main_stanza": {
    "telugu": [
      "స్నేహంపు బంధమా శుభంబు నొందుమా",
      "సత్క్రైస్తవ సావాసము స్వర్గంబుఁ బోలును"
    ],
    "english": [
      "Snaehampu Bandhamaa Shubhambu Nondhumaa",
      "Sathkraisthava Saavaasamu Svargambu Boalunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పంశు పాదముల్ ప్రార్ధించి కొల్తుము",
        "భయ, నిరీక్షణాశలు ప్రార్థన లొక్కటే"
      ],
      "english": [
        "Pamshu Paadhamul Praardhinchi Kolthumu",
        "Bhaya, Nireekshanaashalu Praarthana Lokkatae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఒండొర్ల బాధలన్ ఓదార్చు కొందుము",
        "ఒలికెడి కన్నీటితో ఒప్పు మా స్నేహము"
      ],
      "english": [
        "Ondorla Baadhalan Oadhaarchu Kondhumu",
        "Olikedi Kanneethithoa Oppu Maa Snaehamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వియోగ కాలము విచారమైనను",
        "వీలౌ మరలకూడుట విజయ మైత్రితోన్"
      ],
      "english": [
        "Viyoaga Kaalamu Vichaaramainanu",
        "Veelau Maralakooduta Vijaya Maithrithoan"
      ]
    }
  ]
}
