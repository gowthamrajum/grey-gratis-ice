        "Nichchi hechchinche dhevudaayanan",
        "Sarvamupai sarvamupai - Silvaveyabadinattivaade",
        "Paadhamulabadi poojinthumu - Sarvamupai hechchinche devudu"
      ]
    },
    {
      "stanza_number": 2,
