  "main_stanza": {
    "telugu": [
      "నీ దయలో నే జీవింతును",
      "నీ దయ నన్ను నిలబెట్టెను",
      "నన్ను కాపడెను నన్ను హత్తుకొనెను",
      "నా సమస్తము నీ దయయే"
    ],
    "english": [
      "Nee dhayalo ne jeevinthunu",
      "nee dhaya nannu nilabettenu",
      "nannu kaapadenu nannu hathukonenu",
      "na samasthamu nee dayaye"
    ]
  },
