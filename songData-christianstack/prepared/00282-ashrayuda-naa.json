{
  "song_name": "Ashrayuda Naa",
  "author": {
    "Authored by": "Hosanna Ministries featuring Pastor Ramesh",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆశ్రయుడా నా యేసయ్యా",
      "స్తుతి మహిమ ప్రభావము నీకేనయా",
      "విశ్వవిజేతవు – సత్యవిధాతవు",
      "నిత్యమహిమకు – ఆధారము నీవు",
      "లోక సాగరాన క్రుంగినవేళ",
      "నిత్యమైన కృపతో వాత్సల్యము చూపి – నను చేరదీసిన నిర్మలుడా"
    ],
    "english": [
      "Aashrayudaa naa Yesayya",
      "sthuthi mahima prabhaavamu neekenayaa",
      "vishwavijethavu – Sathyavidhathavu",
      "nithyamahimaku – aadhaaramu neevu",
      "loka saagarana krunginaveela",
      "nithyamaina krupatho vaathsalyamu choopi – nanu cheradheesina nirmaludaa",
      "neekenayaa aaraadhana – Neekenayaa sthuthi aaraadhana"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీకేనయా ఆరాధన – నీకేనయా స్తుతి ఆరాధన"
      ],
      "english": [
        "Tellani vennela kaanthivi neevu",
        "challani mamathala manasse neevu",
        "karunanuchoopi kalushamu baapi",
        "nanu preminchina premavu neevu",
        "janulaku dhaivam – Jagathiki dheepam",
        "neevugaaka evarunnaru",
        "neeve neeve ee srushtilo",
        "koniyaadabaduchunna Maharaajuvu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తెల్లని వెన్నెల కాంతివి నీవు",
        "చల్లని మమతల మనస్సే నీవు",
        "కరుణనుచూపి కలుషము బాపి",
        "నను ప్రేమించిన ప్రేమవు నీవు",
        "జనులకు దైవం – జగతికి దీపం",
        "నీవుగాక ఎవరున్నారు",
        "నీవే నీవే ఈ సృష్టిలో కొనియాడబడుచున్న మహరాజువు"
      ],
      "english": [
        "Jeevitha dhinamulu adhikamulagunani",
        "vaagdhaanamu chesi dheevinchithivi",
        "aapatkaalamuna andaganilichi",
        "aashalajaadalu choopinchathivi",
        "sreemanthudavai sirikeraajuvai",
        "vethalanubaapi naasthithi maarchithivi",
        "anuraagame nee aishwaryamaa",
        "saathvikame nee saundaryamaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవిత దినములు అధికములగునని",
        "వాగ్దానము చేసి దీవించితివి",
        "ఆపత్కాలమున అండగనిలిచి",
        "ఆశలజాడలు చూపించితివి",
        "శ్రీమంతుడవై సిరికేరాజువై",
        "వెతలనుబాపి నాస్థితి మార్చితివి",
        "అనురాగమే నీ ఐశ్వర్యమా సాత్వికమే నీ సౌందర్యమా"
      ],
      "english": [
        "Neechitthamukai arunodhayaamuna",
        "arpinchedhanu naa sthuthi arpana",
        "parishuddhulalo nee swaasthyamuyokka",
        "mahimaishwaryamu nee pondhutaku",
        "prathi vishayamulo sthuthi chellinchuchu",
        "parishuddhaathmalo praardhinchedhanu",
        "parishuddhudaa paripoornudaa",
        "nee chitthame naalo neraverchumaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీచిత్తముకై అరుణోదయమున",
        "అర్పించెదను నా స్తుతి అర్పణ",
        "పరిశుద్ధులలో నీ స్వాస్థ్యముయొక్క",
        "మహిమైశ్వర్యము నే పొందుటకు",
        "ప్రతి విషయములో స్తుతి చెల్లించుచు",
        "పరిశుద్ధాత్మలో ప్రార్థించెదను",
        "పరిశుద్ధుడా పరిపూర్ణుడా నీ చిత్తమే నాలో నెరవేర్చుమా"
      ],
      "english": []
    }
  ]
}
