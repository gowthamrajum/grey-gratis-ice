{
  "song_name": "Paahiloka Prabho paahi loka Prabho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "బన్యన్ జోసఫ్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "పాహిలోక ప్రభో పాహి లోక ప్రభో",
      "పాహి యని వేఁడు మాం పాహిలోక ప్రభో||"
    ],
    "english": [
      "Paahiloka Prabho paahi loka Prabho",
      "Paahi yani vedu maam paahiloka Prabho||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్ను స్తుతియించుచు నీవు ప్రభుఁడ వని",
        "చెన్నుమీరఁగ నమ్మియున్నాము సత్ర్పభో||"
      ],
      "english": [
        "Ninnu sthuthiyinchuchu neevu Prabhuda vani",
        "Chennumeeraga nammiyunnaamu sath Prabho||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్య మా తండ్రి భూలోకం బంతయు నిన్ను",
        "భక్తితో నారాధించుచున్నది మా ప్రభో||"
      ],
      "english": [
        "Nithya maa thandri bhoolokam banthayu ninnu",
        "Bhakthitho naaraadhinchuchunnadhi maa Prabho||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవ లోకాధిపతులు దూతల సమూహము",
        "దేవాయని కొల్చుచున్నారు నిన్నుఁ బ్రభో||"
      ],
      "english": [
        "Deva lokaadhipathulu doothala samoohamu",
        "Dhevaayani kolchuchunnaaru ninnu Prabho||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధ పరిశుద్ధ పరిశుద్ధ ప్రభువా",
        "పరలోక సేనాధిపతివైన మా ప్రభో||"
      ],
      "english": [
        "Parishuddha parishuddha parishuddha Prabhuvaa",
        "Paraloka senaadhipathivaina maa Prabho||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇహలోకం బంతయుఁ బరలోకం బంతయు నీ",
        "మహి మహాత్మ్యముతో నున్నవని ప్రభో||"
      ],
      "english": [
        "Ihalokam banthayu baralokam banthayu nee",
        "Mahi mahaathmyamutho nunnavani Prabho||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కెరూబులను దూతలు సెరూపులను దూతలు",
        "తిరముగా నిన్ గొనియాడుచున్నారు మా ప్రభో||"
      ],
      "english": [
        "Keroobulanu doothalu seroopulanu doothalu",
        "Thiramugaa nin goniyaaduchunnaaru maa Prabho||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీ దపొస్తలుల మహిమగల సంఘము",
        "ప్రోదిగా నిన్నుతించుచున్నది మా ప్రభో||"
      ],
      "english": [
        "Nee dhaposthalula mahimagala sanghamu",
        "Prodhigaa ninnuthinchuchunnadhi maa Prabho||"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నిత్యము ప్రవక్తల యుత్తమ సంఘము",
        "సత్యముగ నిన్నుతించుచున్నది మా ప్రభో||"
      ],
      "english": [
        "Nithyamu pravakthala yutthama sanghamu",
        "Sathyamuga ninnuthinchuchunnadhi maa Prabho||"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "ధీర హత సాక్షుల వీర సైన్య మంతయు",
        "సారెకు నిన్నుతించుచున్నది మా ప్రభో||"
      ],
      "english": [
        "Dheera hatha saakshula veera sainya manthayu",
        "Saareku ninnuthinchuchunnadhi maa Prabho||"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "నిత్య మహాత్మ్యముగల తండ్రి వైన నిన్నును",
        "నీదు పూజ్యుఁడగు నిజ అద్వితీయ సుతినిన్||"
      ],
      "english": [
        "Nithya mahaathmyamugala thandri vaina ninnunu",
        "Needu poojyudagu nija advitheeya suthinin||"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "ఆదరణ కర్తయైనట్టి శుద్ధాత్ముని",
        "నంతట నుండు సభ యొప్పుకొనునునిన్ బ్రభో||"
      ],
      "english": [
        "Aadarana karthayainatti shuddhaathmuni",
        "Nanthata nundu sabha yoppukonununin Prabho||"
      ]
    }
  ]
}
