  "main_stanza": {
    "telugu": [
      "నువ్వులేని నన్ను ఊహించలేను",
      "నిన్ను వీడి నేను ఉండలేనే..",
      "నాలోనే నిన్ను నే దాచుకున్నాలే",
      "నాకంటూ ఉన్నది నీవేలే.."
    ],
    "english": [
      "Nuvvuleni nannu oohinchalenu",
      "Ninnu veedi nenu undalelene",
      "Naalone ninnu ne daachukunnale",
      "Naakantu unnadi neevele"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీలోనే నన్ను చూసి",
