{
  "song_name": "Aadi premanu vidachipettithivaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆది ప్రేమను విడచిపెట్టితివా",
      "ఓ నాదు ప్రియుడా మాదిరిగ జీవించ మానితివా (2)"
    ],
    "english": [
      "Aadi premanu vidachipettithivaa",
      "O naadu priyudaa maadhiriga jeevincha maanithivaa (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవే నా రక్షకుడవనియు దేవుని క్రీస్తుండవనియు",
        "నిశ్చయముగ ఒప్పుకొంటివి స్వంత పనులకు సాగిపోతివి"
      ],
      "english": [
        "Neeve naa rakshakudavaniyu Devuni Kreesthundavaniyu",
        "Nishchayamuga oppukontivi swantha panulaku saagipothivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సిలువ మోయుచు యేసు ప్రభుకే కాలమెల్ల సేవ చేయుచు",
        "ఎల్ల ప్రజలకు సాక్ష్యమిచ్చుచు వెళ్ళెదనను పలికితివిగా"
      ],
      "english": [
        "Siluva moyuchu Yesu Prabhuke kaalamella seva cheyuchu",
        "Ella prajalaku saakshyamichchuchu velledhananu palikithivigaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మనుష్య సంగతులను తలంచి మనుష్యేచ్ఛలకు లొంగిపోయి",
        "యేసు ప్రభుని అనుమానించి ధనమోసంబులో చిక్కుకొంటివి"
      ],
      "english": [
        "Manushya sangathulanu thalanchi manushyechchhalaku longipoyi",
        "Yesu Prabhuni anumaaninchi dhanamosambulo chikkukontivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఏమి తిని త్రాగుచుందునో ఏమి ధరించుదునోయని",
        "నమ్మకత్వము కోల్పోయి అమ్ముకొంటివా నీదు ప్రభుని"
      ],
      "english": [
        "Emi thini thraaguchundhuno emi dharinchudhunoyani",
        "Nammakathvamu kolpoyi ammukontivaa needu Prabhuni"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మేడమిద్దెల పొలము ఆస్తుల పుడమి నికనెన్నో ఘనతలకు",
        "ఇదియే సమయమని తలంచి నీదు ప్రభునెదిరించి పోదువా"
      ],
      "english": [
        "Medamiddhela polamu aasthula pudami nikanenno ghanathalaku",
        "Idiye samayamani thalanchi needu Prabhunedhirinchi podhuvaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యేసు క్రీస్తుని సేవయందు ఏమి కొదువను చూచి యిట్లు",
        "మార్చుకొంటివి నీదునడతను నాథుడేసుడు ఏడ్చుచుండె"
      ],
      "english": [
        "Yesu Kreesthuni sevayandhu emi kodhuvanu choochi itlu",
        "Maarchukontivi needu nadathanu naathudesudu edchuchunde"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీదు దీపము యింక యిలలో ఆరిపోవక ముందెనెరిగి",
        "సాధువై ప్రార్థించు యేసుని ఆది ప్రేమతో సేవ జేయుము"
      ],
      "english": [
        "Needu deepamu inka ilalo aaripovaka mundhenerigi",
        "Saadhuvai praarthinchu Yesuni aadi prematho seva jeyumu"
      ]
    }
  ]
}
