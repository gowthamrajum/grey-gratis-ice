{
  "song_name": "Kreesthulaeche Hallelooya Laeche Jayasheeludu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తులేచె! హల్లెలూయ! లేచె జయశీలుడు!",
      "స్తోత్రమైన హల్లెలూయ! క్రీస్తు మళ్ళీ లేచెను"
    ],
    "english": [
      "Kreesthulaeche! Hallelooya! Laeche Jayasheeludu!",
      "Sthoathramaina Hallelooya! Kreesthu Mallee Laechenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రీస్తులేచె! హల్లెలూయ! లేచె జయశీలుడు!",
        "స్తోత్రమైన హల్లెలూయ! క్రీస్తు మళ్ళీ లేచెను",
        "చూచి మళ్ళీ తనకాంతి - హృదుల్ నాయనన్",
        "చింతవీడి సంతసాన వంగి క్రీస్తునెదుట"
      ],
      "english": [
        "Kreesthulaeche! Hallelooya! Laeche Jayasheeludu!",
        "Sthoathramaina Hallelooya! Kreesthu Mallee Laechenu",
        "Choochi Mallee Thanakaanthi - Hrudhul Naayanan",
        "Chinthaveedi Santhasaana Vangi Kreesthunedhuta"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రీస్తులేచె! మండలపు - చింతయంత తీరెను!",
        "హర్ష ద్వార మొప్పదీసి - మళ్ళీ జీవ మొందెను",
        "చావు నరకాలు మ్రొక్కి - దూతలెల్ల గల్వను",
        "కోట్లు చుట్టు కాంతి గూడ - లేచెనిప్డు శూరుడు"
      ],
      "english": [
        "Kreesthulaeche! Mandalapu - Chinthayantha Theerenu!",
        "Harsha Dhvaara Moppadheesi - Mallee Jeeva Mondhenu",
        "Chaavu Narakaalu Mrokki - Dhoothalella Galvanu",
        "Koatlu Chuttu Kaanthi Gooda - Laechenipdu Shoorudu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తులేచె! నాటి వంత - యంత యంత మొందెను",
        "నేడు గొప్ప హర్షమాయె - క్రీస్తు లేచినందునన్",
        "శుద్ధ భూసమాధి తొలి - పంటను గల్గించెను",
        "వింతగన్ సజీవుడాయె - బోయిమళ్ళి కన్పడెన్"
      ],
      "english": [
        "Kreesthulaeche! Naati Vantha - Yantha Yantha Mondhenu",
        "Naedu Goppa Harshamaaye - Kreesthu Laechinandhunan",
        "Shuddha Bhoosamaadhi Tholi - Pantanu Galginchenu",
        "Vinthagan Sajeevudaaye - Boayimalli Kanpaden"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తులేచె! నింక చావు! నరకాల భయము",
        "లేనె లేదు! క్రీస్తు నందు నన్ని గెల్చినారము",
        "మా భయాదులన్ని పోయి - శంకదిగులుంబాసె",
        "నేడు పునరుత్థానంపు - దీవెనల నొందుదము"
      ],
      "english": [
        "Kreesthulaeche! Ninka Chaavu! Narakaala Bhayamu",
        "Laene Laedhu! Kreesthu Nandhu Nanni Gelchinaaramu",
        "Maa Bhayaadhulanni Poayi - Shankadhigulumbaase",
        "Naedu Punaruththaanampu - Dheevenala Nondhudhamu"
      ]
    }
  ]
}
