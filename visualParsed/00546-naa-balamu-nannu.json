{
  "song_name": "Naa balamu nannu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నా బలము నన్ను విడిచిపోయినా",
      "నీ కృపయే నన్ను లేవనేత్తెను",
      "హల్లెలూయ పాటలు పాడెదను",
      "దినమంతా నిన్నే కీర్తించేదను"
    ],
    "english": [
      "Naa balamu nannu vidichipoyinaa",
      "Nee krupaye nannu levanetthenu",
      "Hallelooya paatalu paadedanu",
      "Dhinamanthaa ninne keerthinchedanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భూమి మార్పు నొందినను నడి సంద్రములో",
        "పర్వతములు మునిగినను",
        "నాకు ఏహాని కలుగకుండా",
        "నీ కృప నాతో వున్నది దేవా"
      ],
      "english": [
        "Bhoomi maarpu nondhinanu nadi sandramulo",
        "Parvathamulu muniginanu",
        "Naaku e haani kalugakundaa",
        "Nee krupa naatho vunnadhi Deva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యాధి లేని జీవితము నాకిచ్చుటకై",
        "వ్యాధిగ్రస్తునిగా నీవు మారితివా",
        "నాకు ఏ హాని కలుగకుండా",
        "నీ కృప నాలో వున్నది దేవా"
      ],
      "english": [
        "Vyaadhi leni jeevithamu naakichchutakai",
        "Vyaadhigrasthunigaa neevu maarithivaa",
        "Naaku e haani kalugakundaa",
        "Nee krupa naalo vunnadhi Deva"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సమస్తమును జయించిన దేవుడవు నీవు",
        "నీ కృప నను విడువదంటివే",
        "నాకు ఏహాని కలుగకుండా",
        "నీ కృప నాతో వున్నది దేవా"
      ],
      "english": [
        "Samasthamunu jayinchina Devudavu neevu",
        "Nee krupa nanu viduvadhantive",
        "Naaku e haani kalugakundaa",
        "Nee krupa naatho vunnadhi Deva"
      ]
    }
  ]
}
