  "main_stanza": {
    "telugu": [
      "ఇమ్మానుయేలు దేవా నాతో ఉన్నవాడా",
      "నా కొండా కోట నీవే దేవా (2)"
    ],
    "english": [
      "Immaanuyelu Deva naatho unnavaadaa",
      "Naa kondaa kota neeve Deva (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భయపడను నేను – నా తోడు నీవుండగ",
        "దిగులిడను నేను – నా అండ నీవేగా"
      ],
      "english": [
        "Bhayapadanu nenu – Naa thodu neevundaga",
        "Dhigulidanu nenu – Naa anda neevegaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ కౌగిలిలో నను దాచుకున్నావు",
        "నీ మాటలతో నన్నాదరించావు"
      ],
      "english": [
        "Nee kaugililo nanu dhaachukunnaavu",
        "Nee maatalatho nannaadharinchaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా కాపరివై నను పోషించావు",
        "కనుపాపలా నను కాచుకున్నావు"
      ],
      "english": [
        "Naa kaaparivai nanu poshinchaavu",
        "Kanupaapalaa nanu kaachukunnaavu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భయపడను నేను – నా తోడు నీవుండగ",
        "దిగులిడను నేను – నా అండ నీవేగా"
      ],
      "english": [
        "Bhayapadanu nenu – Naa thodu neevundaga",
        "Dhigulidanu nenu – Naa anda neevegaa"
      ]
    }
  ]
