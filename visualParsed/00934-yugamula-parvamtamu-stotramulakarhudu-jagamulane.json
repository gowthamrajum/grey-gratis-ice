    },
    {
      "stanza_number": 3,
      "telugu": [
        "అల్ఫయు ఓమేగయు అద్యంత రహితుడు",
        "కరుణామయుడు కమనీయుడు కలువరినాధుడు నా యేసుడు"
      ],
      "english": [
        "Alphayu Omegayu adhyantha rahithudu",
        "Karunaamayudu kamaneeyudu Kaluvarinaadhudu naa Yesudu"
      ]
    }
  ]
