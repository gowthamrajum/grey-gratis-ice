  "main_stanza": {
    "telugu": [
      "హోసన్న హల్లేలూయ హోసన్న"
    ],
    "english": [
      "Hosanna Hallelujah Hosanna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆనంద ధ్వని చేసెదం",
        "ఆర్భాటముతో సాగెదం",
        "సైన్యములకు అధిపతియైన",
        "యెహోవా మన పక్షము",
        "మన బలముగా కోటగా నిలుచును",
        "ఏ అపాయం రాకుండ కాపాడును"
      ],
      "english": [
        "Aananda dhwani chesedham",
        "aarbhaatamutho saagedham",
        "sainyamulaku adhipathiyaina",
        "yehovaa mana pakshamu",
        "mana balamugaa kotagaa niluchunu",
        "ey apaayam raakunda kaapaadunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "హోసన్న జయం ఎల్లవేళల విజయమే",
        "హోసన్న జయం ఘనపరచెద రారాజునే"
      ],
      "english": [
        "Hosanna jayam ellavelala vijayame",
        "Hosanna jayam ghanaparacheda raaraajune"
      ]
    }
  ]
