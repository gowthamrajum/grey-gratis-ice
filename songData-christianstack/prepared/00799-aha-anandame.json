{
  "song_name": "Aha Anandame",
  "author": {
    "Authored by": "Mary Vijay Nanneti",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆహా ఆనందమే మహా సంతోషమే యేసు పుట్టె ఇలలో",
      "ఆనందమే మహా సంతోషమే యేసు పుట్టె ఇలలో"
    ],
    "english": [
      "Aha aanandame maha aanandame yesu putte ilalo",
      "aanandame maha santhoshame yesu putte ilalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెషయా ప్రవచనము నేడు రుజువాయే",
        "జన్మించె కుమారుండు కన్య గర్భమందున",
        "మీకా ప్రవచనము నేడు రుజువాయే",
        "ఇశ్రాయేల్ నేలెడివాడు జన్మించె బెత్లేహేమున",
        "తండ్రి వాగ్ధానం నేడు నెరవేరే",
        "దేవుని బహుమానం శ్రీ యేసుని జన్మము"
      ],
      "english": [
        "Yeshayaa pravachanamu nedu rujuvaaye",
        "janminche kumaarundu kanya garbhamandhuna",
        "Meekaa pravachanamu nedu rujuvaaye",
        "israel neledi vaadu janminche bethlehemuna",
        "Thandri vaagdhaanam nedu nerevere",
        "devuni bahumaanam sri yesuni janmamu"
      ]
    }
  ]
}
