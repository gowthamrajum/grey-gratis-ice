{
  "song_name": "Sadaakaalamu Neetho Nenu",
  "author": {
    "Authored by": "Pastor Timothy",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సదాకాలము నీతో నేను జీవించెదను యేసయ్య",
      "యేసయ్యా యేసయ్యా యేసయ్యా యేసయ్యా"
    ],
    "english": [
      "Sadaakaalamu Neetho Nenu",
      "Jeevinchedanu Yessayya",
      "Yesayyaa Yesayyaa Yesayyaa Yesayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపాల ఊభిలో పడియున్న నన్ను",
        "నీ ప్రేమతో నన్ను లేపావయ్యా",
        "ఏ తోడులేని నాకు నా తోడుగా",
        "నా అండగా నీవు నిలిచావయ్యా",
        "నీ వాత్సల్యమును నాపై చూపించి",
        "నీ సాక్షిగా నన్ను నిలిపావయ్యా",
        "ఆశ్చర్యకార్యములు ఎన్నో చేసి",
        "నీ పాత్రగా నన్ను మలిచావయ్యా"
      ],
      "english": [
        "Paapaala Oobhilo Padiyunna Nannu",
        "Nee Prematho Nannu Lepaavayyaa",
        "Ae Thoduleni Naaku Naa Thodugaa",
        "Naa Andagaa Neevu Nilichaavayyaa",
        "Nee Vaathsalyamunu Naapai Choopinchi",
        "Nee Saakshigaa Nannu Nilipaavayyaa",
        "Aascharyakaaryamulu Enno Chesi",
        "Nee Paathragaa Nannu Malichaavayyaa"
      ]
    }
  ]
}
