  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రియ యేసు నీవే నా శ్రేయంపు రాజవు",
        "దయచే ప్రాయశ్చిత్తమైతివి నాదు రోజవు"
      ],
      "english": [
        "Naa priya Yesu neeve naa shreyampu raajavu",
        "Dhayache praayashchitthamaithivi naadu raajavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సాతానుకు నే దాసుదనై నాశమొందగా",
        "నాతాను ద్వారా తెలిపితివి నాదు ప్రియుడా"
      ],
      "english": [
        "Saathaanuku ne dhaasudanai naashamondhagaa",
        "Naathaanu dwaaraa thelipithivi naadu priyudaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వ్యాదిగ్రస్తుండనై హౄదయక్షీణ మొందితిన్",
        "బాధల నొంది తప్పియుంటి నాదు ప్రియుడా"
      ],
      "english": [
        "Vyaadhigrasthundanai hrudhayaksheena mondhithin",
        "Baadhala nondi thappiyunti naadu priyudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తప్పిన రూక, పిల్లవాడు, గొర్రెవలెనే",
        "తప్పిన నన్ను వెదకి రక్షించితివి ప్రియుడా"
      ],
      "english": [
        "Thappina rooka, pillavaadu, gorrevalene",
        "Thappina nannu vedaki rakshinchithivi priyudaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తలిదండ్రులు విడిచినను నీవు విదువవు",
        "చల్లగ ప్రక్కజేర్చి బ్రోతువీవు ప్రియుడా"
      ],
      "english": [
        "Thalidhandrulu vidichinanu neevu viduvavu",
        "Challaga prakkajerchi brothuveevu priyudaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నావాదవైతివి నేను నీదు వాడను",
        "నాయాపదయందున్న ప్రభువు నాదు ప్రియుడా"
      ],
      "english": [
        "Naavaadavaithivi nenu needu vaadanu",
        "Naayaapadhayandhunna prabhuvu naadu priyudaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ప్రభావముతో సాక్ష్యమీయ రాజ్యమేలుచు",
        "ఆ భాగ్యమును చూడనిమ్ము నాదు ప్రియుడా"
      ],
      "english": [
        "Prabhaavamutho saakshyameeya raajyameluchu",
        "Aa bhaagyamunu choodanimmu naadu priyudaa"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "రక్షించితివి హల్లెలూయ పాడునట్లుగా",
        "ఈ క్షితిలో నెల్లరకు చాట నాదు ప్రియుడా"
      ],
      "english": [
        "Rakshinchithivi hallelooya paadunatlugaa",
        "Ee kshithilo nellaraku chaata naadu priyudaa"
      ]
    }
  ]
}
