{
  "song_name": "Oa Praemagala Yaesu Praemimchinaavu Mammu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఓ ప్రేమగల యేసు - ప్రేమించినావు మమ్ము",
      "స్మరించుచు స్తుతింతున్ - రక్షణ నిచ్చినావు"
    ],
    "english": [
      "Oa Praemagala Yaesu - Praemimchinaavu Mammu",
      "Smarimchuchu Sthuthimthun - Rakshana Nichchinaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అద్భుత యాగమందు - అందరికై బలియై",
        "అందరి పాపములకు - ప్రాయశ్చిత్తమైతివి"
      ],
      "english": [
        "Adhbhutha Yaagamamdhu - Amdharikai Baliyai",
        "Amdhari Paapamulaku - Praayashchiththamaithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దాసులమై మేముండ - మోషేను పంపితివి",
        "చేసితివి స్వతంత్రులుగా - నీ బాహుబలము తోడ"
      ],
      "english": [
        "Dhaasulamai Maemumda - Moashaenu Pampithivi",
        "Chaesithivi Svathamthrulugaa - Nee Baahubalamu Thoada"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్షమాపణానందముతో - సాగింపచేసి మమ్ము",
        "యాత్రలో మాకు తోడై - విజయము నిచ్చితివి"
      ],
      "english": [
        "Kshamaapanaanamdhamuthoa - Saagimpachaesi Mammu",
        "Yaathraloa Maaku Thoadai - Vijayamu Nichchithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఎడారి అడవిలోన - ఊటల నదులు నడిపి",
        "ఎండిన నేలనంత - పచ్చిక బయలు చేసెన్"
      ],
      "english": [
        "Edaari Adaviloana - Ootala Nadhulu Nadipi",
        "Emdina Naelanamtha - Pachchika Bayalu Chaesen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "బాబెలు నుండి మమ్ము - విడిపించితివి నీవు",
        "బంధకముల తెంచి - తప్పు బోధ బాపినావు"
      ],
      "english": [
        "Baabelu Numdi Mammu - Vidipimchithivi Neevu",
        "Bamdhakamula Themchi - Thappu Boadha Baapinaavu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సహవాసమిచ్చి సంఘ - అంగముల జేసినావు",
        "సాక్షులను చేసి మమ్ము - శత్రువుల సిగ్గుపరచె"
      ],
      "english": [
        "Sahavaasamichchi Samgha - Amgamula Jaesinaavu",
        "Saakshulanu Chaesi Mammu - Shathruvula Sigguparache"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మహా ప్రేమ గల యేసు - మాకై చేసితివన్ని",
        "ఘనపరతు హల్లెలూయ - ఈ గొప్ప రక్షణ కొరకు"
      ],
      "english": [
        "Mahaa Praema Gala Yaesu - Maakai Chaesithivanni",
        "Ghanaparathu Hallelooya - Ee Goppa Rakshana Koraku"
      ]
    }
  ]
}
