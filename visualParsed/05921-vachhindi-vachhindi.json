  "main_stanza": {
    "telugu": [
      "వచ్చింది వచ్చింది మధురమైన సమయం",
      "తెచ్చింది నూతన కాంతుల ఉదయం",
      "రావయ్యా వరుడా (రావమ్మా వదువా) సుస్వాగతం",
      "నీకోసమే ఈ స్వాగత గీతం"
    ],
    "english": [
      "Vachchindi vachchindi madhuramaina samayam",
      "Thechchindhi noothana kaanthula udayam",
      "Raavayyaa varudaa (raavammaa vadhuvaa) suswaagatham",
      "Neekosame ee swaagatha geetham"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
