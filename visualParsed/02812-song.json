      ],
      "english": [
        "Neethini koraka yallaaduvaani",
        "Yesu rakshinchutakai kaachunu",
        "Prematho vaarini biluchukondi",
        "Yesunu nammina rakshinchunu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపవిషంబు మనస్సున దాగి",
