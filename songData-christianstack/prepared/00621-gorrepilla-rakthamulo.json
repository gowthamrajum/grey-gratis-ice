{
  "song_name": "Gorrepilla Rakthamulo",
  "author": {
    "Authored by": "Pastor Nani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గొర్రెపిల్ల రక్తములో",
      "కడుగబడినవారే పరిశుద్ధులు",
      "పరిశుద్ధుడా యేసయ్యా",
      "నను శుద్ధి చేయుమయా",
      "నను శుద్ధి చేయుమయా"
    ],
    "english": [
      "Gorrepilla rakthamulo",
      "kadugabadinavaare parishuddhulu",
      "parishuddhudaa yesayya",
      "nanu shuddhi cheyumayaa",
      "nanu shuddhi cheyumayaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశము ఈ భూమియు",
        "గతియించినా గతియించవు నీ మాటలు",
        "శాశ్వతమైనది నీ రాజ్యము",
        "ఆ రాజ్యాములో నన్ను",
        "చేర్చుమయా యేసయ్యా",
        "వేవేళ దూతలు అనునిత్యము",
        "కొనియాడుచున్న ఆ పరలోకము",
        "పరిశుద్ధులతో నిండిన నీ రాజ్యము",
        "ఆ రాజ్యాములో నన్ను",
        "చేర్చుమయా యేసయ్యా"
      ],
      "english": [
        "Aakasamu ee bhoomiyu",
        "gathiyinchina gathiyinchavu nee maatalu",
        "saaswathamainadhi nee raajyamu",
        "aa raajyamulo nannu",
        "cherchumayaa yesayya",
        "Vevela dhoothalu anu nithyamu",
        "koniyaaduchunna aa paralokamu",
        "parishuddhulatho nindina nee raajyamu",
        "aa raajyamulo nannu",
        "cherchumayaa yesayya"
      ]
    }
  ]
}
