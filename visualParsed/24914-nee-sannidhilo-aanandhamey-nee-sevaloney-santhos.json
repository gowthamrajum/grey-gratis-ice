{
  "song_name": "Nee sannidhilo aanandame nee sevalone santhoshame",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Joshua Shaik"
    ],
    "రచన": [
      "జాషువా షేక్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నీ సన్నిధిలో ఆనందమే – నీ సేవలోనే సంతోషమే",
      "స్తుతులందుకో స్తోత్రార్హుడా – పదివేలలో అతి సుందరుడా",
      "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
    ],
    "english": [
      "Nee sannidhilo aanandame – Nee sevalone santhoshame",
      "Sthuthulanduko sthothraarhudaa – Padivelalo athi sundarudaa",
      "Karuninchumaa karunaamayaa – Mahima ghanatha neeke Deva"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా హృదయాలను నీ ఆలయముగా",
        "నీ ఆలయమే మా దాగు చోటుగా",
        "నీ చిత్తము మాలో నెరవేరగా",
        "పరిపూర్ణమైన నీ ప్రేమ పొందగా",
        "కృప చూపుము దేవా – దీవించు ప్రభువా",
        "నీ ఆత్మ శక్తితో నింపుము దేవా",
        "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
      ],
      "english": [
        "Maa hrudhayaalanu nee aalayamugaa",
        "Nee aalayame maa daagu chotugaa",
        "Nee chitthamu maalo neraveragaa",
        "Paripoornamaina nee prema pondagaa",
        "Krupa choopumu Deva – Deevinchu Prabhuvaa",
        "Nee aathma shakthitho nimpumu Deva",
        "Karuninchumaa karunaamayaa – Mahima ghanatha neeke Deva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ మహిమార్థమే మా క్రియలన్నియు",
        "నీ కనికరములే మేలులన్నియు",
        "విశ్వాసముతో ప్రార్ధింప నేర్పుమా",
        "నీ వాక్య వెలుగులో దర్శించుమా",
        "దరి చేర్చు ప్రభువా – పరలోక దేవా",
        "కడ వరకు మమ్ము నడిపించుమా",
        "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
      ],
      "english": [
        "Nee mahimaarthame maa kriyalanniyu",
        "Nee kanikaramule melulanniyu",
        "Viswaasamutho praardhimpa nerpumaa",
        "Nee vaakya velugulo dharshinchumaa",
        "Dari cherchu Prabhuvaa – Paraloka Deva",
        "Kada varaku mammu nadipinchumaa",
        "Karuninchumaa karunaamayaa – Mahima ghanatha neeke Deva"
      ]
    }
  ]
}
