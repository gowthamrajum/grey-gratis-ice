  },
  "main_stanza": {
    "telugu": [
      "స్తుతించుడి స్తుతించుడి - ఆయన మందిరపు ఆవరణములో",
      "యెహోవా దేవుని స్తుతించుడి",
      "భూమి ఆకాశమందున మీరెల్లరు కూడి స్తుతించుడి",
      "రాజా రాజా ఓ రాజులకు రాజువంచు స్తుతించుడి"
    ],
    "english": [
      "SthuthiMchudi SthuthiMchudi - Aayana MaMdhirapu AavaraNamuloa",
      "Yehoavaa Dhaevuni SthuthiMchudi",
      "Bhoomi AakaashamaMdhuna Meerellaru Koodi SthuthiMchudi",
      "Raajaa Raajaa Oa Raajulaku RaajuvaMchu SthuthiMchudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వాధికారుడంచు - సర్వశక్తి మంతుడంచు",
        "సంపూర్ణ ప్రేమరూపి - సాధుల శ్రీమంతుడంచు",
        "సృష్టి నిన్ స్మరణ చేసెనో - ఓ ... స్తుతించుడి"
      ],
      "english": [
        "SarvaaDhikaarudaMchu - Sarvashakthi MaMthudaMchu",
        "SaMpoorNa Praemaroopi - SaaDhula ShreemaMthudaMchu",
        "SruShti Nin SmaraNa Chaesenoa - Oa ... SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పెళపెళ మ్రోగెడు ఉరుములలోన - రాజా రాజా",
        "తళతళ మెరిసెడు మెరుపులలోన - రాజా రాజా",
        "చననము గలిగిన జీవులలోన - రాజా రాజా",
        "పలుకులు లేని ప్రకృతిలోన - రాజా రాజా",
        "రాజాధి రాజుల రాజా - ఓ ... స్తుతించుడి"
      ],
      "english": [
        "PeLapeLa Mroagedu Urumulaloana - Raajaa Raajaa",
        "ThaLathaLa Merisedu Merupulaloana - Raajaa Raajaa",
        "Chananamu Galigina Jeevulaloana - Raajaa Raajaa",
        "Palukulu Laeni Prakruthiloana - Raajaa Raajaa",
        "RaajaaDhi Raajula Raajaa - Oa ... SthuthiMchudi"
