{
  "song_name": "Nee Krupatho",
  "author": {
    "Authored by": "Mrs. Grace Solomon",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కలకాలం నీ కృపతో",
      "నను నడిపే నా దేవా",
      "బ్రతుకంత నీ సాక్షిగా",
      "నను నిలుపుము నా ప్రభువా",
      "కలనైనా మరువనయా",
      "నీ కడకు చేరాలని"
    ],
    "english": [
      "Kalakaalam nee krupatho",
      "nanu nadipe naa devaa",
      "brathukantha nee saakshiga",
      "nanu nilupumu naa prabhuvaa",
      "kalanaina maruvanayaa",
      "nee kadaku cheralani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "⁠కటిక చీకటెదురైన",
        "నా జ్యోతివి నీవేగదా",
        "కన్నీటి లోయలో నుండి",
        "నన్ను లేవనెత్తిన నా యేసువా",
        "నా యేసువా",
        "శ్రమలెన్ని నన్ను చుట్టినా",
        "నా శాంతివి నీవేగదా",
        "శోధన, వేదనలో",
        "నన్ను వెన్నంటిన నా యేసువా",
        "నా యేసువా"
      ],
      "english": [
        "Katika cheekatedhuraina",
        "naa jyothivi neevegadhaa",
        "kanniti loyalo nundi",
        "nannu levanethina naa yesuvaa",
        "naa yesuvaa",
        "Sramalenni nannu chuttina",
        "naa shaanthivi neevegadhaa",
        "sodhana, vedhanalo",
        "nannu vennantina naa yesuvaa",
        "naa yesuvaa"
      ]
    }
  ]
}
