{
  "song_name": "Udhayakalamulo",
  "author": {
    "Authored by": "M Prakash",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఉదయకాలంలో నిన్ను ఆరాధింతును",
      "ఇంకా చీకటి ఉండగనే ఆరాధింతును",
      "మధ్యాహన కాలములో సాయంత్ర సమయంలో",
      "అన్ని వేళలయందు నిన్ను ఆరాధింతును"
    ],
    "english": [
      "Udhayakalamulo ninnu aaraadhinthunu",
      "inkaa cheekati undagaane aaraadhinthunu",
      "madhyahaana kaalamulo saayanthra samayamlo",
      "anni velalayandhu ninnu aaraadhinthunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆరాధన ఆరాధన ఆరాధన స్తుతి ఆరాధన",
        "హల్లేలూయా హల్లేలూయా హల్లేలూయా అని కీర్తించెద"
      ],
      "english": [
        "Aaraadhana aaraadhana aaraadhana",
        "hallelujah hallelujah hallelujah ani keerthinchedha"
      ]
    }
  ]
}
