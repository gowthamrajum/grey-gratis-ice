{
  "song_name": "Ni Devudedamchu Nannaduguchunnaru Ekkadunnavani Cheppanu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ దేవుడేడంచు నన్నడుగుచున్నారు",
      "ఎక్కడున్నావని చెప్పనూ ఎలా వున్నావని చూపను యేసు (2)"
    ],
    "english": [
      "Ni Devudedamchu Nannaduguchunnaru",
      "Ekkadunnavani Cheppanu Ela Vunnavani Chupanu Yesu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశముల నడుగరాదా అంతరిక్షము చెప్పలేదా",
        "యేసురాజే స్రుస్టికర్తయని యేసు నాధుడే సార్వభౌముడని",
        "అంతరిక్షము చెప్పలేదా ఆకాశముల నడుగరాదా"
      ],
      "english": [
        "Akasamula Nadugarada Amtarikshamu Cheppaleda",
        "Yesuraje Srustikartayani Yesu Nadhude Sarvabaumudani",
        "Amtarikshamu Cheppaleda Akasamula Nadugarada"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నక్షత్రముల నడుగరాదా సాక్షులై అవి చెప్పలేదా",
        "యేసురాజే దేవదేవుడని విశ్వమంత యేసు సృస్టియని",
        "సాక్షులై అవి చెప్పలేదా నక్షత్రముల నడుగరాదా"
      ],
      "english": [
        "Nakshatramula Nadugarada Sakshulai Avi Cheppaleda",
        "Yesuraje Devadevudani Visvamamta Yesu Srustiyani",
        "Sakshulai Avi Cheppaleda Nakshatramula Nadugarada"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మానవాత్మను అడుగరాదా అంతరాత్మే చెప్పలేదా",
        "యేసు దేవుడే నిన్ను చేసేనని యేసు లేనిదే ఏది కలుగలేదని",
        "అంతరాత్మే చెప్పలేదామానవాత్మను అడుగరాదా"
      ],
      "english": [
        "Manavatmanu Adugarada Amtaratme Cheppaleda",
        "Yesu Devude Ninnu Chesenani Yesu Lenide Edi Kalugaledani",
        "Amtaratme Cheppaledamanavatmanu Adugarada"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దైవ వాక్యం చదువరాదా వాక్యసత్యం చెప్పలేదా",
        "యేసు ప్రజల రక్షకుండని యేసే ప్రజల విమోచకుండని",
        "వాక్యసత్యం చెప్పలేదాదైవ వాక్యం చదువరాదా"
      ],
      "english": [
        "Daiva Vakyam Chaduvarada Vakyasatyam Cheppaleda",
        "Yesu Prajala Rakshakumdani Yese Prajala Vimochakumdani",
        "Vakyasatyam Cheppaledadaiva Vakyam Chaduvarada"
      ]
    }
  ]
}
