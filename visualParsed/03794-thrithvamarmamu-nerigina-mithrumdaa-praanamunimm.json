{
  "song_name": "Thrithvamarmamu nerigina mithrundaa praanamunimmu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "త్రిత్వమర్మము నెరిగిన - మిత్రుండా ప్రాణమునిమ్ము",
      "విలువ గలిగిన ప్రభుని - సిలువ భుజముపై మోసి"
    ],
    "english": [
      "Thrithvamarmamu nerigina - Mithrundaa praanamunimmu",
      "Viluva galigina Prabhuni - Siluva bhujamupai mosi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గోధుమ భూమిలోపడిన - బహుగాను ఫలియించును",
        "మోదమున ప్రభుయేసునితో మరణించవలెను ప్రియుడా"
      ],
      "english": [
        "Godhuma bhoomilopadina - Bahugaanu phaliyinchunu",
        "Modhamuna Prabhuyesunitho maraninchavalenu priyudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మహిమ నొందుటకు నీవు సాత్వికుండవు కావలెను",
        "మహిమ స్వరూపిని పోలి - నీవును జీవించవలెను"
      ],
      "english": [
        "Mahima nondutaku neevu saathvikundavu kaavalenu",
        "Mahima svaroopini poli - Neevunu jeevinchavalenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తును ప్రేమను త్రాగి - ఆత్మవశుడవైనచో",
        "సైతాను సహవాసమును - సంపూర్ణముగా వదిలెదవు"
      ],
      "english": [
        "Kreesthunu premanu thraagi - Aathmavashudavainacho",
        "Saithaanu sahavaasamunu - Sampoornamugaa vadhiledhavu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పొలము దున్నెడువాడు - వెనుక తిరిగి చూడడు",
        "ఇలలో నీవున్నను ప్రియుడా - యిలనే మరచిపోవలెను"
      ],
      "english": [
        "Polamu dhunneduvaadu - Venuka thirigi choodadu",
        "Ilalo neevunnanu priyudaa - Ilane marachipovalenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రాణంబు పోయినగాని - విశ్వాసము విడువ వలదు",
        "ప్రియుడా నీదు ద్వారానే - పృథివి బాగుపడవలెను"
      ],
      "english": [
        "Praanambu poyinagaani - Vishwaasamu viduva valadu",
        "Priyudaa needu dwaaraane - Pruthivi baagupadavalenu"
      ]
    }
  ]
}
