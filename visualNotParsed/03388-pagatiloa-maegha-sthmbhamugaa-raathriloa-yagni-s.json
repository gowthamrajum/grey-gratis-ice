        "శాంతిని నా కిచ్చితివి"
      ],
      "english": [
        "Vaakyamannaatho poshinchi",
        "Banda neellanu thraaginchithivi",
        "Aathmaku thrupthi nichchi Prabhuvaa",
        "Shaanthini naa kichchithivi"
      ]
    },
    {
      "stanza_number": 3,
