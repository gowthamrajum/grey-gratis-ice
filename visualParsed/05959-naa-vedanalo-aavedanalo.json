  },
  "main_stanza": {
    "telugu": [
      "నా వేదనలో ఆవేదనలో",
      "నీ వాక్యమే నను బ్రతికించినది",
      "నా రోదనలో నా యాతనలో",
      "నీ మాటలే నను ఓదార్చినవి",
      "యేసయ్యా----- యేసయ్యా------(2)"
    ],
    "english": [
      "Naa vedhanalo aavedhanalo",
      "Nee vaakyame nanu brathikinchinadhi",
      "Naa rodhanalo naa yaathanalo",
      "Nee maatale nanu odhaarchinavi",
      "Yesayyaa----- Yesayyaa------(2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చేయని నేరము చేసెను గాయము",
        "వేసిన నెపము మోపెను భారము",
        "నా కృప చాలును అన్న నీ మాటే",
        "నను బ్రతికించెనయ్యా.",
        "యేసయ్యా. యేసయ్యా.....",
        "నీ వాత్సల్యమునే మరువలేనయ్యా"
      ],
      "english": [
        "Cheyani neramu chesenu gaayamu",
        "Vesina nepamu mopenu bhaaramu",
        "Naa krupa chaalunu anna nee maate",
        "Nanu brathikinchenayyaa.",
        "Yesayyaa. Yesayyaa.....",
        "Nee vaathsalyamune maruvalenayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చేసిన మేలే కీడుగా మారె",
        "చూపిన ప్రేమే చేదుగా మిగిలె",
        "ఒంటరినైన నన్ను చేరదీసావే",
        "నన్ను ఆదరించినావే (నడిపించినావే)",
        "యేసయ్యా...... యేసయ్యా......",
        "నీ మమకారమునే మరువలేనయ్యా"
      ],
      "english": [
        "Chesina mele keedugaa maare",
        "Choopina preme chedhugaa migile",
        "Ontarinaina nannu cheradheesaave",
        "Nannu aadharinchinaave (nadipinchinaave)",
        "Yesayyaa...... Yesayyaa......",
        "Nee mamakaaramune maruvalenayyaa"
      ]
    }
  ]
