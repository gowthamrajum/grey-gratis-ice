{
  "song_name": "Randi Paada Dhoothalaaraa",
  "author": {
    "Authored by": "",
    "రచన": "జేమ్సు మాంట్ గోమరీ"
  },
  "main_stanza": {
    "telugu": [
      "రండి నేడు పుట్టినట్టి రాజు నారాధించుడి."
    ],
    "english": [
      "Randi Naedu Puttinatti Raaju Naaraadhinchudi."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రండి పాడ దూతలారా నిండు సంతోషంబుతో",
        "యేసుని జన్మంబు గూర్చి ఈ భూలోకమంతట"
      ],
      "english": [
        "Randi Paada Dhoothalaaraa Nindu Santhoashambuthoa",
        "Yaesuni Janmambu Goorchi Ee Bhooloakamanthata"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మందగాయు గొల్లలార! మనుష్యులతో నేడు",
        "వాసంబు జేయుచున్నాఁడు వాసిగాను దేవుండు"
      ],
      "english": [
        "Mandhagaayu Gollalaara! Manushyulathoa Naedu",
        "Vaasambu Jaeyuchunnaadu Vaasigaanu Dhaevundu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జ్ఞానులారా! మానుడింక యోచనలం జేయుట",
        "మానుగాను వెదకుడేసున్ చూచుచు నక్షత్రమున్"
      ],
      "english": [
        "Jnyaanulaaraa! Maanudinka Yoachanalam Jaeyuta",
        "Maanugaanu Vedhakudaesun Choochuchu Nakshathramun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధులారా! మీరు నిరీక్షించుచుండిన",
        "యేసు ప్రభువాలయంబు యేతెంచెను చూడుడి"
      ],
      "english": [
        "Parishuddhulaaraa! Meeru Nireekshinchuchundina",
        "Yaesu Prabhuvaalayambu Yaethenchenu Choodudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పశ్చాత్తాప మొందియున్న పాపులార! మీకు వి ముక్తి గల్గె;",
        "శక్తి నొంది రక్తి నేసుంజేరుడి"
      ],
      "english": [
        "Pashchaaththaapa Mondhiyunna Paapulaara! Meeku Vi Mukthi Galge;",
        "Shakthi Nondhi Rakthi Naesunjaerudi"
      ]
    }
  ]
}
