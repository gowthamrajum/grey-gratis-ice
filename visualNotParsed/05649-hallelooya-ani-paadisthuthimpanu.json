        "Thallidhandrulakanna preminchu devudani",
        "Kallaakapatamuleni karunaa sampannudani",
        "Poojinchi poojinchi paatinchi chaatincharaare ||Halle||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బంధుమిత్రులకన్న బలమైన దేవుడని",
