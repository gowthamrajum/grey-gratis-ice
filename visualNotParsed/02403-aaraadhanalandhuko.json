  "main_stanza": {
    "telugu": [
      "ఆరాధనాలందుకో ఆరాధనాలందుకో",
      "పాప క్షమాపణ జీవము నిచ్చిన",
      "కరుణామయా అందుకో ||",
      "అబ్రాహాము ఇస్సాకు యాకోబుల దేవా మోషేతో",
      "అన్నావు ఉన్నానని || 2 ||",
      "అల్ఫయు నీవే ఓమేగయును || 2 ||"
    ],
    "english": [
      "Aaraadhanaalandhuko aaraadhanaalandhuko",
      "Paapa kshamaapana jeevamu nichchina",
      "Karunaamayaa anduko ||",
      "Abraahaamu Issaaku Yaakobula Deva Moshetho",
      "Annaavu unnaanani || 2 ||",
      "Alphayu neeve Omegayunu || 2 ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆద్యంత రహితుడవు నీవేనని",
        "|| ఘనత మహిమ నీకేయని హల్లెలూయ",
        "గానము చేసేదము || || పాప క్షమాపణ ||"
      ],
      "english": [
        "Aadyantha rahithudavu neevenani",
        "||Ghanatha mahima neekeyani hallelooya",
        "Gaanamu chesedamu || ||Paapa kshamaapana||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపంబున జీవించి నశియించితిని లోకంబు",
        "నాదంటు ఆశించితిని అయినా నీవు రక్షణ",
        "నివ్వ ప్రేమించి పంపితివి",
        "యేసుప్రభుని || ఘనత || || పాప క్షమాపణ ||"
      ],
      "english": [
        "Paapambuna jeevinchi nashiyinchithini lokambu",
        "Naadantu aashinchithini ayinaa neevu rakshana",
        "Nivva preminchi pampithivi",
        "Yesuprabhuni ||Ghanatha|| ||Paapa kshamaapana||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తెలిసికొంటిని నా యేసు నిన్ను సర్వ శక్తిగల ప్రభువనియు",
        "రానున్నావు మరల నాకై ఆనంద దేశములో",
        "నన్నుంచుటకై || ఘనత || || పాప క్షమాపణ ||"
      ],
      "english": [
        "Thelisikontini naa Yesu ninnu sarva shakthigala prabhuvaniyu",
        "Raanunnaavu marala naakai aananda deshamulo",
        "Nannunchutakai ||Ghanatha|| ||Paapa kshamaapana||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అంద సౌందర్యములు వ్యర్థంబనీ ఆశించితి",
        "ముత్యంబుగా నుండుటకై",
        "నిన్న నేడు నిరంతరము మారని మా ప్రభు",
        "నీకే స్తుతులు || ఘనత || || పాప క్షమాపణ ||"
      ],
      "english": [
        "Anda saundharyamulu vyarthambanee aashinchithi",
        "Muthyambugaa nundutakai",
        "Ninna nedu nirantharamu maarani maa Prabhu",
        "Neeke sthuthulu ||Ghanatha|| ||Paapa kshamaapana||"
      ]
    }
  ]
}
