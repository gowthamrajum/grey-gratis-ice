{
  "song_name": "Vintimayyaa nee swaramu - Kantimayyaa nee roopamunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వింటిమయ్యా నీ స్వరము - కంటిమయ్యా నీ రూపమును",
      "ప్రియప్రభూ నిన్నుగాక వేరెవరిని చూడము వినము"
    ],
    "english": [
      "Vintimayyaa nee swaramu - Kantimayyaa nee roopamunu",
      "Priyaprabhoo ninnugaaka verevarini choodamu vinamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భక్తి మర్మము గొప్పది యెంతో",
        "శరీరుడుగా మారిన దేవా, దూతలకు కనబడితివి",
        "లోకమందు నమ్మబడియున్న దేవా"
      ],
      "english": [
        "Bhakthi marmamu goppadi entho",
        "Shareerudugaa maarina Deva, dhoothalaku kanabadithivi",
        "Lokamandu nammabadiyunna Deva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "భయపడవలదని దూతలు తెల్పె",
        "మహా సంతోషకరమైన వార్త, రక్షకుడు పుట్టెనని",
        "పరమందు మహిమ భువికి శాంతియనిరి"
      ],
      "english": [
        "Bhayapadavaladhani doothalu thelpe",
        "Mahaa santhoshakaramaina vaartha, rakshakudu puttenani",
        "Paramandu mahima bhuviki shaanthiyaniri"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నరరూప ధారివి యైతివి ప్రభువా",
        "అద్భుతములు చేసియున్నవు, వేరెవ్వరు చేయలేరు",
        "అద్భుతకరుడ ఘనత కలుగును గాక"
      ],
      "english": [
        "Nararoopa dhaarivi aithivi Prabhuvaa",
        "Adbhuthamulu chesiyunnavu, verevvaru cheyaleru",
        "Adbhuthakaruda ghanatha kalugunu gaaka"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మూగవారికి మాటలిచ్చితివి",
        "గ్రుడ్డి కుంటిని బాగు జేసితివి, మృతులను లేపితివి",
        "పరాక్రమ శాలివి నీవే ఓ ప్రభువా"
      ],
      "english": [
        "Moogavaariki maatalichchithivi",
        "Gruddi kuntini baagu jesithivi, mruthulanu lepithivi",
        "Paraakrama shaalivi neeve O Prabhuvaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమించి ప్రభువా ప్రాణమిచ్చితివి",
        "అధికారముతో తిరిగి లేచితివి, మరణపు ముల్లు విరచితివి",
        "నమాధి నిన్ను గెలువక పోయెను"
      ],
      "english": [
        "Preminchi Prabhuvaa praanamichchithivi",
        "Adhikaaramutho thirigi lechithivi, maranapu mullu virachithivi",
        "Samaadhi ninnu geluvaka poyenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఇహము నుండి పరమున కేగి",
        "మా కొరకై నీవు రానై యున్నావు, ఆనందముతో కనిపెట్టెదము",
        "మదియందె నిరీక్షణ కలిగి స్తుతింతుం"
      ],
      "english": [
        "Ihamu nundi paramuna kegi",
        "Maa korakai neevu raanai yunnaavu, aanandamutho kanipettedhamu",
        "Madhiyandhe nireekshana kaligi sthuthinthum"
      ]
    }
  ]
