      ],
      "english": [
        "Saayambeeve vere naakendhuku?",
        "Vere cheyi meeda naanu konanu",
        "Prabhoo nijambugaa neede chaalun",
        "Nee shakthilone naa balamundun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
