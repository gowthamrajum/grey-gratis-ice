{
  "song_name": "Alalu (Neevu Nakundaga)",
  "author": {
    "Authored by": "Prasanna Kumar Kaki",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ రెక్కల చాటున",
      "నను దాచిన నా ప్రభు",
      "నీ చేతుల మీదను",
      "నను మోసిన దైవమా"
    ],
    "english": [
      "Nee rekkala chaatuna",
      "nanu daachina naa prabhu",
      "nee chethula meedanu",
      "nanu mosina daivamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మనుషులు ఎదురు తిరిగిన",
        "మనసు చెదరిపోయిన",
        "నీవే ఆదారము",
        "నీలోన ఆశ్రయం"
      ],
      "english": [
        "Manushulu eduru thirigina",
        "manasu chedaripoyina",
        "neeve aadaaramu",
        "neelona aasrayam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అలలు నాపై లేచినా",
        "ఆకాశమే ఉరిమినా",
        "నే అదరను, నే బెదరను",
        "నీవు నాకుండగా"
      ],
      "english": [
        "Alalu naapai lechinaa",
        "aakaasame uriminaa",
        "ne adharanu, ne bedharanu",
        "neevu naakundagaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవే సర్వాధికారివి",
        "నీవే సాటిలేనివాడివి",
        "నీవే సర్వ సృష్టికర్తవు",
        "నీవే సర్వోన్నతుడు"
      ],
      "english": [
        "Neevea sarvaadhikaarivi",
        "neevea saatilenivaadivi",
        "neevea sarvasrushtikarthavu",
        "neevea sarvonnathudu"
      ]
    }
  ]
}
