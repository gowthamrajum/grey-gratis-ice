  "main_stanza": {
    "telugu": [
      "మన్నించుమా మన్నించుమా",
      "మన్నించుమా దేవా మన్నించుమా",
      "మాట తప్పాను నిన్ను మరిచాను",
      "క్షమియించి నన్ను బ్రోవుమా",
      "కాదనక నన్ను కావుమా"
    ],
    "english": [
      "Manninchumaa manninchumaa",
      "Manninchumaa Deva manninchumaa",
      "Maata thappaanu ninnu marichaanu",
      "Kshamiyinchi nannu brovumaa",
      "Kaadhanaka nannu kaavumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదాము పాపమును క్షమియించినావే",
        "చర్మపు వస్త్రమును నిర్మించినావే",
        "కడపటి ఆదామై ఏతెంచినావే",
        "ఈ పాపి కొరకై రిక్తునిగా మారావే",
        "ఇంత చేసిన నీవు నా యెడల మోనమా",
        "చెంత చేరిన నన్ను కాదనకు ప్రాణమా"
      ],
      "english": [
        "Aadaamu paapamunu kshamiyinchinaave",
        "Charmapu vasthramunu nirminchinaave",
        "Kadapati Aadhaamai ethenchinaave",
        "Ee paapi korakai rikthunigaa maaraave",
        "Intha chesina neevu naa edala maunamaa",
        "Chentha cherina nannu kaadhanaku praanamaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దావీదు పాపమును క్షమియించినావే",
        "ఆ మరణ శాసనము రద్దు చేసినావే",
        "దావీదు పట్టణమందు నా కొరకె పుట్టావే",
        "ఈ గోరపాపి కొరకే బలియాగమయ్యావే",
        "ఇంత చేసిన నీవు నా యెడల మోనమా",
        "చెంత చేరిన నన్ను కాదనకు నేస్తమా"
      ],
      "english": [
        "Daaveedu paapamunu kshamiyinchinaave",
        "Aa marana shaasanamu raddu chesinaave",
        "Daaveedu pattanamandhu naa korake puttaave",
        "Ee ghorapaapi korake baliyaagamayyaave",
        "Intha chesina neevu naa edala maunamaa",
        "Chentha cherina nannu kaadhanaku nesthamaa"
      ]
    }
  ]
}
