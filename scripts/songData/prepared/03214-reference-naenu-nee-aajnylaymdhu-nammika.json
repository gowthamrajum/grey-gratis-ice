{
  "song_name": "Yehoavaa Nee Yokka Maata Choppun",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యెహోవా నీ యొక్క మాట చొప్పున",
      "నీ దాసునికి మేలు చేసియున్నావు"
    ],
    "english": [
      "Yehoavaa Nee Yokka Maata Choppun",
      "Nee Dhaasuniki Maelu Chaesiyunnaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మంచి వివేచన మంచి జ్ఞానమునకు - కర్త నీవే నాకు బోధ చేయుము",
        "నీ యాజ్ఞలందు నమ్మిక నుంచితిని"
      ],
      "english": [
        "MMchi Vivaechana MMchi JnYaanamunaku - Kartha Neevae Naaku BoaDha Chaeyumu",
        "Nee YaajnYlMdhu Nammika NuMchithini"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాకు శ్రమ కలుగక మునుపు - నా దేవా నేను త్రోవ వీడితిని",
        "నేడు నీ మాట నెరవేర్చు చున్నాను"
      ],
      "english": [
        "Naaku Shrama Kalugaka Munupu - Naa Dhaevaa Naenu Throava Veedithini",
        "Naedu Nee Maata Neravaerchu Chunnaanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవా నీవు దయగలవాడవు - దేవా నీవు మేలు చేయుచున్నావు",
        "నీ కట్టడల నాకు బోధించుము"
      ],
      "english": [
        "Dhaevaa Neevu Dhayagalavaadavu - Dhaevaa Neevu Maelu Chaeyuchunnaavu",
        "Nee Kattadala Naaku BoaDhiMchumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "గర్విష్ఠులు నాకు విరోధముగా - కల్పించుదురెన్నో అబద్ధములు",
        "నీ యుపదేశము లనుసరింతును"
      ],
      "english": [
        "GarviShTulu Naaku ViroaDhamugaa - KalpiMchudhurennoa AbadhDhamulu",
        "Nee Yupadhaeshamu Lanusarimthunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వారి హృదయములు క్రొవ్వువలె - చాల మందముగానై యున్నవి",
        "ఆజ్ఞలలో ఆనందించుచున్నాను"
      ],
      "english": [
        "Vaari Hrudhayamulu Krovvuvale - Chaala MMdhamugaanai Yunnavi",
        "AajnYlaloa AanMdhiMchuchunnaanu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దేవా నేను నీ కట్టడలను - నేర్చుకొనునట్లు",
        "శ్రమల నొందియుండుట నాకు యెంతో మేలాయెను"
      ],
      "english": [
        "Dhaevaa Naenu Nee Kattadalanu - Naerchukonunatlu",
        "Shramala NoMdhiyuMduta Naaku YeMthoa Maelaayenu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "వేలాది వెండి నాణెముల కంటె - వేలాది బంగారు నాణెముల కంటె",
        "నీ విచ్చిన ఆజ్ఞలు నాకు మేలు"
      ],
      "english": [
        "Vaelaadhi VeMdi NaaNemula KMte - Vaelaadhi BMgaaru NaaNemula KMte",
        "Nee Vichchina AajnYlu Naaku Maelu"
      ]
    }
  ]
}
