{
  "song_name": "Rakshakundudayinchi Naadata",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రక్షకుండుదయించి నాడట - మన కొరకు - బరమ రక్షకుండుదయించి నాడట",
      "రక్షకుండుదయించి నాడట - రారె - గొల్లబోయలార తక్షణమున",
      "బోయి మన నిరీక్షణ ఫలమొందెదము"
    ],
    "english": [
      "Rakshakundudayinchi Naadata - Mana Koraku - Barama Rakshakundudayinchi Naadata",
      "Rakshakundudayinchi Naadata - Raare - Gollaboyalaara Takshanamuna",
      "Boyi Mana Nireekshana Phalamondedamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు వంశమందు ధన్యుండు జన్మించినాడు",
        "దేవుడగు యెహోవా మన దిక్కు జేరి చూచినాడు"
      ],
      "english": [
        "Daaveedu Vamshamandu Dhanyundu Janminchinaadu",
        "Devudagu Yehowaa Mana Dikku Jeri Choochinaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గగనమునుండి దిగి - ఘనుడు గబ్రియేలు దూత",
        "తగినట్టు చెప్పె వారికి మిగుల సంతోషవార్త"
      ],
      "english": [
        "Gaganamunundi Digi - Ghanudu Gabriyelu Doota",
        "Taginattu Cheppe Vaariki Migula Santoshavaarta"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వర్తమానము జెప్పి దూత - వైభవమున బోవుచున్నాడు",
        "కర్తను జూచిన వెనుక కాంతుము విశ్రమం బప్పుడు"
      ],
      "english": [
        "Vartamaanamu Jeppi Doota - Vaibhavamuna Bovuchunnaadu",
        "Kartanu Joochina Venuka Kaantumu Vishramam Bappudu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పశువుల తొట్టిలోన - భాసిల్లు వస్త్రముల జుట్టి",
        "శిశువును గనుగొందురని - శీఘ్రముగను దూత తెల్పె"
      ],
      "english": [
        "Pashuvula Tottiloona - Bhaasillu Vastramula Jutti",
        "Shishuvunu Ganugondurani - Shiighramuganu Doota Telpe"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అనుచు గొల్ల లొకరి కొక రానవాలు జెప్పుకొనుచు",
        "అనుమతించి కడకు క్రీస్తు నందరికినీ దెల్పినారు"
      ],
      "english": [
        "Anuchu Golla Lokari Koka Raanavaalu Jeppukonuchu",
        "Anumatinchi Kadaku Kreesthu Nandarikini Delpinaaru"
      ]
    }
  ]
}
