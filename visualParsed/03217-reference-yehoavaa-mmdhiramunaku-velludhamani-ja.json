      ],
      "english": [
        "Yerooshalemaa ninnu preminchuvaaru",
        "Ennadunu vardhilledharu gaaka"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "నీ ప్రాకారములలో నెమ్మది",
        "నీ నగరులలో క్షేమముండును గాక"
      ],
      "english": [
        "Nee praakaaramulalo nemmadi",
        "Nee nagarulalo kshemamundunu gaaka"
      ]
