{
  "song_name": "Prabhuvaa Mammunudheevinchi Pampumu",
  "author": {
    "Authored by": "",
    "రచన": "మొలతాటి విద్యానందము"
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా మమ్మునుదీవించి పంపుము నీ కృపనందించి",
      "అభినందన ములఁ జేకొనుమా విభవము మహిమోన్నతి",
      "కీర్తి యుగయుగములకు నీకగుతన్"
    ],
    "english": [
      "Prabhuvaa Mammunudheevinchi Pampumu Nee Krupanandhinchi",
      "Abhinandhana Mula Jaekonumaa Vibhavamu Mahimoannathi",
      "Keerthi Yugayugamulaku Neekaguthan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పగతురఁ బ్రేమించెడు శక్తిన్ తగఁబొరుగును జూచెడి రక్తిన్",
        "మిగులందయ చేయుము దైవ జగదేక కుమారా",
        "కీర్తి యుగయుగములకు నీ కగుతన్"
      ],
      "english": [
        "Pagathura Braeminchedu Shakthin Thagaborugunu Joochedi Rakthin",
        "Migulandhaya Chaeyumu Dhaiva Jagadhaeka Kumaaraa",
        "Keerthi Yugayugamulaku Nee Kaguthan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గుడిలో వినిన నీవాక్యము మా గుండెలఁ బదిలము జేయఁగను",
        "గుడిబయటను నా చారములో నడువగఁ దోడ్పడుమో",
        "కీర్తి యుగయుగము లకు నీ కగుతన్"
      ],
      "english": [
        "Gudiloa Vinina Neevaakyamu Maa Gundela Badhilamu Jaeyaganu",
        "Gudibayatanu Naa Chaaramuloa Naduvaga Dhoadpadumoa",
        "Keerthi Yugayugamu Laku Nee Kaguthan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రైస్తవ మైత్రిని సంఘములో విస్తరణము జేయఁగనిమ్ము",
        "నేస్తవ భావము లోకములో నెరపఁగ దయఁగనుమో",
        "కీర్తి యుగయుగములకు నీ కగుతన్"
      ],
      "english": [
        "Kraisthava Maithrini Sanghamuloa Vistharanamu Jaeyaganimmu",
        "Naesthava Bhaavamu Loakamuloa Nerapaga Dhayaganumoa",
        "Keerthi Yugayugamulaku Nee Kaguthan"
      ]
    }
  ]
}
