  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వశక్తి యుతుడా - సభకు శిరస్సా",
        "కొఱతయెక్కువాయెను - త్వరగా కృపనిమ్ము",
        "జీవింపచేయుము నమ్మి ప్రార్థింతుము",
        "వాక్కు నెరవేరువరకు - కాచియుండెదము"
      ],
      "english": [
        "Sarvashakthi yuthudaa - Sabhaku shirassaa",
        "Korathayekkuvaayenu - Thvaragaa krupanimmu",
        "Jeevimpacheyumu nammi praarthinthumu",
        "Vaakku neraveruvaraku - Kaachiyundedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రేమతో పిల్చితివి - నన్ను రక్షించితివి",
        "నీ జీవము నాలో వాడెను - నాదేవా దిగుము"
      ],
      "english": [
        "Prematho pilchithivi - Nannu rakshinchithivi",
        "Nee jeevamu naalo vaadenu - Naadhevaa dhigumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమ చల్లారెనే - ఆత్మ కొఱతచే",
        "శవమువలె నైతిని - నీ చేత నన్నెత్తు"
      ],
      "english": [
        "Prema challaarene - Aathma korathache",
        "Shavamuvale naithini - Nee chetha nannetthu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రార్థన వాంఛయు - వాక్యంబు నాసక్తి",
        "నాలో నూటగా రానిమ్ము - సర్వం సమర్పింతున్"
      ],
      "english": [
        "Praarthana vaanchayu - Vaakyambu naasakthi",
        "Naalo nootagaa raanimmu - Sarvam samarpinthun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వైరి చెఱ వీడన్ - పోరుపట్టుదలతో",
        "సల్పి జీవపత్రిక గా - నీచే ప్రకాశింతున్"
      ],
      "english": [
        "Vairi chera veedan - Porupattudhalatho",
        "Salpi jeevapathrika gaa - Neeche prakaashinthun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆత్మ పెండ్లికుమారా - నీరాక కొరకై",
        "నిర్భయముతో వేచియుండ - నానిద్ర పోగొట్టు"
      ],
      "english": [
        "Aathma pendlikumaaraa - Neeraaka korakai",
        "Nirbhayamutho vechiyunda - Naanidhra pogottu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాడను - మరుపులు తొలగును",
        "శుద్ధాత్మను వెదకును - ఎల్లరకున్ చాటన్"
      ],
      "english": [
        "Hallelooya paadanu - Marupulu tholagunu",
        "Shuddhaathmanu vedhakunu - Ellarakun chaatan"
      ]
    }
  ]
}
