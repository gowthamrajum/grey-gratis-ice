{
  "song_name": "Peturu Vale Nenu",
  "author": {
    "Authored by": "Jasper Kunapo",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆరాద్యుడవు నీవే ప్రభు",
      "ఆనందముతో ఆరాధింతును",
      "అత్యున్నత ప్రేమను కనుపరచి నావు",
      "నిత్యము నిను కొనియాడి కీర్తింతును"
    ],
    "english": [
      "Aaraadhyudavu neeve prabhu",
      "aanandhamutho aaraadhinthunu",
      "athyunnatha premanu kanuparachi naavu",
      "nithyamu ninu koniyaadi keerthinthunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పేతురు వలె నేను ప్రభునకు దూరముగా",
        "పనులతో జనులతో జతబడి పరుగెత్తగా",
        "ప్రయాసమే ప్రతిక్షణం ప్రతి నిమిషం పరాజయం",
        "గలిలయ తీరమున నన్ను గమనించితివా",
        "ప్రభురాకడ నెరిగి జలజీవరాసులు",
        "తీరము చేరిరి కర్తను తేరి చూడగా",
        "పరుగెత్తెను పలు చేపలు ప్రభు పనికై సమకూడి",
        "సంతోషముతో ఒడ్డున గంతులేసేను",
        "నిన్నెరుగను అని పలికి అన్యునిగా జీవించితి",
        "మీనముతో భోజనము సమకూర్చితివా",
        "ఆ చేపల సమర్పణ నేర్చితి నిను వెంబడింతు",
        "అద్వితీయ దేవుడవు నీవే ప్రభు"
      ],
      "english": [
        "Pethuru valey nenu prabhunaku dhooramugaa",
        "panulatho janulatho jathabadi parugethagaa",
        "prayaasamey prathi kshanam prathi nimisham paraajayam",
        "galilaya theeramuna nannu gamaninchithivaa",
        "prabhu raakada nerigi jala jeevaraasulu",
        "theeramu cheriri karthanu theri choodagaa",
        "parugethenu palu chepalu prabhu panikai samakoodi",
        "santhoshamutho odduna ganthulesenu",
        "ninneruganu ani paliki anyunigaa jeevinchithi",
        "meenamutho bhojanamu samakoorchithivaa",
        "aa chepala samarpana nerchithi ninu vembadinthu",
        "adhvitheeya dhevudavu neeve prabhu"
      ]
    }
  ]
}
