{
  "song_name": "Raajula Raajuga Yaesu Prabhumdu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రాజుల రాజుగ యేసు ప్రభుండు రయమున రానై యున్నాడు"
    ],
    "english": [
      "Raajula Raajuga Yaesu PrabhuMdu Rayamuna Raanai Yunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్షణాలంకారముతో - తక్షణమే సిద్ధపడి",
        "అక్షయుడగు నా రక్షకుని - నిరీక్షణతో వేడండి"
      ],
      "english": [
        "RakShNaalMkaaramuthoa - ThakShNamae SidhDhapadi",
        "AkShyudagu Naa RakShkuni - NireekShNathoa VaedMdi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మన ప్రభు యేసుని రక్తము - మన పాపములను పోగొట్టి",
        "మన ప్రభురాకడ మనకెంతో - మహిమానదము కలిగించున్"
      ],
      "english": [
        "Mana Prabhu Yaesuni Rakthamu - Mana Paapamulanu Poagotti",
        "Mana Prabhuraakada ManakeMthoa - Mahimaanadhamu KaligiMchun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మొదట గొఱ్ఱెపిల్ల వలె - నొదిగి వచ్చెను మన ప్రభువు",
        "కొదమసింహముగా వచ్చును - గుండెదిగులు పాపికి"
      ],
      "english": [
        "Modhata GoRRepilla Vale - Nodhigi Vachchenu Mana Prabhuvu",
        "KodhamasiMhamugaa Vachchunu - GuMdedhigulu Paapiki"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "గురుతులన్నియు జరుగుచుండ - సరిగా చూడుము విశ్వాసి",
        "త్వరపడుము నీ ప్రభుని జూడ - కరములెత్తి ప్రార్థించు"
      ],
      "english": [
        "Guruthulanniyu JaruguchuMda - Sarigaa Choodumu Vishvaasi",
        "Thvarapadumu Nee Prabhuni Jooda - Karamuleththi PraarThiMchu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఎల్లరు క్రీస్తుని రాకను - ఉల్లాసముతో కోరుచు",
        "హల్లెలూయ పాటలు పాడి - ఎల్లప్పుడు స్తుతియించెదము"
      ],
      "english": [
        "Ellaru Kreesthuni Raakanu - Ullaasamuthoa Koaruchu",
        "Hallelooya Paatalu Paadi - Ellappudu SthuthiyiMchedhamu"
      ]
    }
  ]
}
