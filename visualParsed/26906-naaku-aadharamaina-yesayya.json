        "పరిశుద్దాత్మతో అభిషేకించి",
        "నా జ్ఞానమునకు ఆధారమైతివి  ||నాకు||"
      ],
      "english": [
        "Naa hrudaya bhaaram neevu mosi",
        "Vaagdhaanamulaku aadhaaramaina",
        "Parishuddhaathmatho abhishekinchi",
        "Naa jnaanamunaku aadhaaramaithivi  ||Naaku||"
      ]
