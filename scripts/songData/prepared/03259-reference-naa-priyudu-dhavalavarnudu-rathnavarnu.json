{
  "song_name": "Priyayaesu Priyayaesu Athi Priyudaesu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రియయేసు ప్రియయేసు అతి ప్రియుడేసు",
      "పదివేలలో ఆయనే నా దిక్కుగా కెవ్వరు?"
    ],
    "english": [
      "Priyayaesu Priyayaesu Athi Priyudaesu",
      "Padhivaelaloa Aayanae Naa Dhikkugaa Kevvaru?"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇహమందు వేరేది పేరే లేదు",
        "ఆయనే నా కొసగె ఆత్మానందం",
        "నన్ను విమోచించి నా కొసగె విడుదల",
        "ఆహా నా కందించె నిత్య ముక్తి"
      ],
      "english": [
        "Ihamandhu Vaeraedhi Paerae Laedhu",
        "Aayanae Naa Kosage Aathmaanandham",
        "Nannu Vimoachinchi Naa Kosage Vidudhala",
        "Aahaa Naa Kandhinche Nithya Mukthi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దైవపుత్రుండే నా ప్రియుడు యేసు",
        "ప్రాయశ్చిత్తుడైన గొర్రెపిల్ల",
        "యిహమున కరిగెను తన రక్తమిచ్చెను",
        "కల్వరిపై ప్రాణమర్పించెను"
      ],
      "english": [
        "Dhaivaputhrunde Naa Priyudu Yaesu",
        "Praayashchiththudaina Gorrepilla",
        "Yihamuna Karigenu Thana Rakthamichchenu",
        "Kalvaripai Praanamarpinchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సిలువలో వ్రేలాడి బలిగా నాయెన్",
        "విలువైన ప్రాణము అప్పగించెన్",
        "నలుగ గొట్టబడి గాయముల నొంది",
        "తిరిగి లేచెను నా ప్రియుడు యేసు"
      ],
      "english": [
        "Siluvaloa Vraelaadi Baligaa Naayen",
        "Viluvaina Praanamu Appaginchen",
        "Naluga Gottabadi Gaayamula Nondhi",
        "Thirigi Laechenu Naa Priyudu Yaesu"
      ]
    }
  ]
}
