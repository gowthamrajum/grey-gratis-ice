{
  "song_name": "Premapoornuda Snehaseeluda",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రేమపూర్ణుడా – స్నేహశీలుడా",
      "విశ్వనాధుడా- విజయవీరుడా",
      "ఆపత్కాలమందున – సర్వలోకమందున్న",
      "దీనజనాళి దీపముగా – వెలుగుచున్నవాడా",
      "ఆరాధింతు నిన్నే- లోకరక్షకుడా",
      "ఆనందింతు నీలో-జీవితాంతము",
      "నీకృప ఎంత ఉన్నతమో వర్ణించలేను స్వామి",
      "నీ కృపయందు తుదివరకు నడిపించు యేసయ్య"
    ],
    "english": [
      "Preama puurnudaa sneaha seeludaa",
      "viswa naadhudaa vijaya veerudaa",
      "aapathkaalamandunna – sarwaralookamandunna",
      "deena janaala deepamuga veluguchunna vaada",
      "aaraadhinchu ninnea looka rakshakudaa",
      "aanandhinthu neeloo jeevithanthamu",
      "nee krupa entha vunnathamoo varnnichaleanu swaamee",
      "nee krupa yandu thudi varaku nadipinchu yeasayya",
      "naathoodu neevuntea anthea chaalayyaa",
      "naa mundu nee vuntea bhayamea leadayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పూర్ణమై – సంపూర్ణమైన – నీదివ్య చిత్తమే",
        "నీవు నను నడిపే నూతనమైన జీవమార్గము",
        "ఇహమందు పరమందు ఆశ్రయమైనవాడవు",
        "ఇన్నాళ్లు క్షణమైనా ననుమరువని యేసయ్య",
        "నా తోడు నీవుంటే అంతే చాలయ్య",
        "నాముందు నీవుంటే భయమే లేదయ్యా"
      ],
      "english": [
        "Puurnnamai sampuurnnamainaa nee dhivya chithamea",
        "neevu nanu nadipea nuuthanamaina jeeva maargamu",
        "ihamandu paramandu naaku aasrayamaina vaadavu",
        "innaallu kshannmainaa nannu maruvani yeasayyaa",
        "naa thoodu neevuntea anthea chaalayyaa",
        "naamundu nee vuntea bhayamea leadhayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "భాగ్యమే – సౌభాగ్యమే నీ దివ్య సన్నిధి",
        "బహు విస్తారమైన నీకృప నాపై చూపితివి",
        "బలమైన – ఘనమైన నీనామమందు హర్షించి",
        "భజియించి – కీర్తించి ఘనపరతు నిన్ను యేసయ్య",
        "నా తోడు నీవుంటే అంతే చాలయ్య",
        "నాముందు నీవుంటే భయమే లేదయ్యా"
      ],
      "english": [
        "Baagyamea soubhaagyamea nee dhivya sannidhi",
        "bhahu vistaaramaina nee krupaa naapai chuupithivea",
        "balamaina gannamaina nee naamamandhu harshinchi",
        "bajiyinchi keerthinchi gannaparathu ninnu yeasayyaa",
        "naa thoodu neevuntea anthea chaalayyaa",
        "naa mundhu nee vuntea bhayamea leadhayyaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిత్యము – ప్రతి నిత్యము నీ జ్ఞాపకాలతో",
        "నా అంతరంగమందు నీవు-కొలువై వున్నావులే",
        "నిర్మలమైన నీ మనసే – నా అంకితం చేసావు",
        "నీతోనే జీవింప నన్ను కొనిపో-యేసయ్య",
        "నా తోడు నీవుంటే అంతే చాలయ్య",
        "నాముందు నీవుంటే భయమే లేదయ్యా"
      ],
      "english": [
        "Nithyamu prathi nithyamu – nee gnapakaalatho",
        "naa antharangamandhu neevu – koluvai unnavule",
        "nirmalamaina nee manase – naa ankitham chesavu",
        "neethone jeevimpa nannu konipo – yesayya",
        "naa thoodu neevuntea anthea chaalayyaa",
        "naa mundhu nee vuntea bhayamea leadhayyaa"
      ]
    }
  ]
}
