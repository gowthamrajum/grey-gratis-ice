      ],
      "english": [
        "Neerikshana Kaligi Eduru Choochuchuntini",
        "Pakshi Raaju Yavvanam Vale Noothana Parachumaa",
        "Alayaka Solayaka Parugettheda Sevalo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
