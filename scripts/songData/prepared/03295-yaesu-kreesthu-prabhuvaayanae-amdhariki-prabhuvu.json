{
  "song_name": "Yaesu Kreesthu Prabhuvaayanae Amdhariki Prabhuvu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు క్రీస్తు ప్రభువాయనే అందరికి ప్రభువు",
      "పశువుల పాకన్ పరుండెను తానే దేవుడై యుండి"
    ],
    "english": [
      "Yaesu Kreesthu Prabhuvaayanae Amdhariki Prabhuvu",
      "Pashuvula Paakan Parumdenu Thaanae Dhaevudai Yumdi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నరులన్ గావన్ శ్రమల బొందెన్ క్రీస్తు ప్రభువు",
        "తిరిగెన్ భువిన్ సుఖమున్ విడచి శిష్యులు వెంటనుండన్"
      ],
      "english": [
        "Narulan Gaavan Shramala Bomdhen Kreesthu Prabhuvu",
        "Thirigen Bhuvin Sukhamun Vidachi Shishyulu Vemtanumdan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్యజీవం నిత్య శాంతి నిండు నెమ్మది",
        "నిత్యుండేసు మనకు నివ్వ మృత్యువున్ గెల్చెను"
      ],
      "english": [
        "Nithyajeevam Nithya Shaamthi Nimdu Nemmadhi",
        "Nithyumdaesu Manaku Nivva Mruthyuvun Gelchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భీతిన్ గొలుపు అలలు పైకి లేచినంతనే",
        "భీతిన్ విడచి యేసు వైపు చూడు నిమ్మళించును"
      ],
      "english": [
        "Bheethin Golupu Alalu Paiki Laechinamthanae",
        "Bheethin Vidachi Yaesu Vaipu Choodu Nimmalimchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మరణమేలు లోయలందు సంచరించెడు",
        "తరుణములు కలిగినను క్రీస్తు మీ చెంతనుండున్"
      ],
      "english": [
        "Maranamaelu Loayalamdhu Samcharimchedu",
        "Tharunamulu Kaliginanu Kreesthu Mee Chemthanumdun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మన జీవము క్రీస్తే గదా క్రీస్తున్ తేరి చూచి",
        "తనయులమై యుద్ధమందు జయము నొందెదము"
      ],
      "english": [
        "Mana Jeevamu Kreesthae Gadhaa Kreesthun Thaeri Choochi",
        "Thanayulamai Yudhdhamamdhu Jayamu Nomdhedhamu"
      ]
    }
  ]
}
