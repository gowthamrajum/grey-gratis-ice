  "main_stanza": {
    "telugu": [
      "స్తుతి స్తుతి సదయుఁడైన యేసు",
      "నూటి న్నీకుసృష్టి చెల్లించును",
      "నీతిమంతా నిఖిల దూతలు చేరి",
      "నీకే కీర్తి భక్తిఁజెల్లింతురు.",
      "చేతనుంచి పిల్లల నెల్లను యేసు",
      "మితిలేని ప్రేమను గాచును.",
      "||స్తుతి స్తుతి సదయుఁడైన యేసు",
      "ఖ్యాతితో నీకెన్నఁడొనర్తుము||"
    ],
    "english": [
      "Sthuthi sthuthi sadhayudaina Yesu",
      "Nooti nneeku srushti chellinchunu",
      "Neethimanthaa nikhila doothalu cheri",
      "Neeke keerthi bhakthi jellinthuru.",
      "Chethanunchi pillala nellanu Yesu",
      "Mithileni premanu gaachunu.",
      "||Sthuthi sthuthi sadhayudaina Yesu",
      "Khyaathitho neekennadonarthumu||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
