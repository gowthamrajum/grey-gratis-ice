{
  "song_name": "Vedakudi",
  "author": {
    "Authored by": "Jasper Kunapo",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "వెదకుడి వెదకుడి",
      "సత్యము విడుదల తధ్యము",
      "నడువుడి బలపడి",
      "యేసుని మార్గమే సత్యము",
      "ఆయనే ద్వారము ఆయనే జీవము",
      "ఆయనే ఆధారము"
    ],
    "english": [
      "Vedhakudi Vedhakudi",
      "sathyamu vidudhala thadhyamu",
      "naduvudi balapadi",
      "yesuni maargame sathyamu",
      "aayane dwaaramu aayane jeevamu",
      "aayane aadhaaramu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవకుమారుడు మానవరూపుడై",
        "మహోన్నతుడు మహిమ విడిచి",
        "అరుదెంచె ఇలలో",
        "మనవలె మనుగడ శోధనలున్న",
        "మచ్చలేదు మరకలేదు",
        "జీవన నడవడిలో జననము జీవనం",
        "పరిశుద్ధం పరిపూర్ణం",
        "పస్కాబలి గొఱ్ఱెపిల్ల ప్రతిరూపము",
        "నీతిమంతుడను అనుకున్నావా",
        "మోసపోయి స్వనీతనే",
        "చెరలో పడినావా",
        "చెడును విసర్జించుట నీ తరమా",
        "చెడు నిలయము నీ హృదయము కనుమా",
        "పాపివని తెలుసుకో పావనుడే కడుగును",
        "యేసు రక్తప్రోక్షణకై వేడుకో"
      ],
      "english": [
        "Daivakumaarudu maanavaroopudai",
        "mahonnathudu mahima vidichi",
        "arudhenche ilalo",
        "manavaley manugada shodhanalunna",
        "machaledu marakaledu",
        "jeevana nadavadilo jananamu jeevanam",
        "parishuddham paripoornam",
        "paskaabali gorrepilla prathiroopamu",
        "Neethimanthudanu anukunnaavaa",
        "mosapoyi swaneethaney",
        "cheralo padinaavaa",
        "chedunu visarjinchuta nee tharamaa",
        "chedu nilayamu nee hrudhayamu kanumaa",
        "paapivani thelusuko paavanude kadugunu",
        "yesu rakthaprokshanakai veduko"
      ]
    }
  ]
}
