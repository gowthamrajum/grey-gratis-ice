{
  "song_name": "Kanumooyaka munde thelusuko o nijaanni",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కనుమూయక ముందే తెలుసుకో ఓ నిజాన్ని",
      "ఈ భూమిపై ఎందరో పుట్టారు",
      "ప్రతి పుట్టినరోజు చావుకు దగ్గరవుతారు",
      "తినుచు త్రాగుచు సంతోషించుమని చెప్పి",
      "నిన్ను అర్ధాంతరంగా వదిలివేస్తుంది",
      "మట్టి నుండి పుట్టింది మట్టికి చేరింది",
      "ఆరని అగ్నికి అత్మను పంపేస్తుంది",
      "తెలుసుకో ఈ నిజాన్ని",
      "నీ శరీరమే నీకు శత్రువని"
    ],
    "english": [
      "Kanumooyaka munde thelusuko o nijaanni",
      "Ee bhoomipai endaro puttaaru",
      "Prathi puttinaroju chaavuku daggaravuthaaru",
      "Thinuchu thraaguchu santhoshinchumani cheppi",
      "Ninnu ardhaantharangaa vadhilivesthundhi",
      "Matti nundi puttindi mattiki cherindhi",
      "Aarani agniki aathmanu pampesthundhi",
      "Thelusuko ee nijaanni",
      "Nee shareerame neeku shathruvani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మేనుపైన మమకారం పెంచుకోకుమా",
        "మరణించగానే ఎవరూ నిను ఉంచుకోరు సుమా",
        "ఆశా మమకారాలు పెను ఉచ్చులు సుమా",
        "నీ దేహాన్ని తగులబెట్టు కట్టెలనీ మరువకుమా",
        "తెలుసుకో ఈ నిజాన్ని"
      ],
      "english": [
        "Menupaina mamakaaram penchukokumaa",
        "Maraninchagaane evaroo ninu unchukoru sumaa",
        "Aashaa mamakaaraalu penu uchchulu sumaa",
        "Nee dehaanni thagulabettu kattelanee maruvakumaa",
        "Thelusuko ee nijaanni"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దేహం దేవునికై వినియోగిస్తే",
        "నీ ప్రాణం ప్రభునికై పణముగా పెడితే",
        "మన్నయిన నీ దేహం మహిమగా మారును",
        "అంతరిక్షమే దానికి అడ్డుతొలగి పోవును",
        "పుట్టి తెలుసుకున్నావీ లోకముందని",
        "మరణిస్తే తెల్లుస్తుంది మరోలోకముందనీ",
        "తెలుసుకో ఈ నిజాన్ని",
        "నీ మృత్యువు వెనుకే ఉంది మిష్టరీ",
        "దైవ గ్రంధం తెలిపింది దాని హిష్టరీ",
        "కనుమూయక ముందే తెలుసుకో ఈ నిజాన్ని"
      ],
      "english": [
        "Nee deham dhevunikai viniyogisthe",
        "Nee praanam prabhunikai panamugaa pedithe",
        "Mannayina nee deham mahimagaa maarunu",
        "Antharikshame daaniki addutholagi povunu",
        "Putti telusukunnaavee lokamundhani",
        "Maranisthe thelusthundhi marolokamundhanee",
        "Thelusuko ee nijaanni",
        "Nee mruthyuvu venuke undi mishtaree",
        "Daiva grandham thelipindhi daani hishtaree",
        "Kanumooyaka munde thelusuko ee nijaanni"
      ]
    }
  ]
}
