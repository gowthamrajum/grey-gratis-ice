  "main_stanza": {
    "telugu": [
      "130",
      "యెహోవా అగాధ స్థలములలో నుండి - నీకు మొర పెట్టుచున్నాను",
      "ప్రభువా నా ప్రార్థనకు చెవి యొగ్గి నా ఆర్తధ్వని వినుము"
    ],
    "english": [
      "130",
      "Yehova agaadha sthalamulalo nundi - Neeku mora pettuchunnaanu",
      "Prabhuvaa naa praarthanaku chevi yoggi naa aarthadhvani vinumu"
    ]
  },
  "stanzas": [
    {
