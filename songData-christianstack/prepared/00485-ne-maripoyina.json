{
  "song_name": "Ne Maripoyina",
  "author": {
    "Authored by": "Sharon Praveen",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నేమారిపోయినా నివు మారనన్నావు",
      "నా ప్రేమ మారినా నీ ప్రేమ మారదు"
    ],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇదియేమి బంధమో నీ ప్రేమ అనుభందం",
        "వర్ణంచలేను నీ ప్రేమను",
        "వివరించలేను నీ ప్రేమను"
      ],
      "english": []
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నేనెంత వద్దన్నా నావెంట పడ్డావు",
        "వెంటాడి వెంటాడి నీవైపు తిప్పావు"
      ],
      "english": []
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేను మాట్లాడకున్నా నాతోనే",
        "మాటాడి",
        "నా మదిని గెలిచావు నా",
        "దైవమైనావు"
      ],
      "english": []
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాలో యేమిలేకున్నా",
        "యేరికోరుకున్నావు నేనేమి కాకున్నా",
        "నా ప్రాణమన్నావు",
        "నేను నిన్ను యెరుగకున్నా నీవు",
        "నన్ను యెరిగావు",
        "నా హ్రుదిలొ నిలిచావు నా",
        "తండ్రివైనావు"
      ],
      "english": []
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నేనేమి అడగకున్నా నాకన్ని",
        "యిచ్చావు ఆశ్చర్యకార్యములెన్నో",
        "నాపట్ల చేశావు",
        "ఊహంచలేనంత ఉన్నతముగ",
        "ఉంచావు",
        "నన్ను నీకొరకే అర్పించుకొందును"
      ],
      "english": []
    }
  ]
}
