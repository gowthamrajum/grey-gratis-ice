{
  "song_name": "Thaara Velisenu Choodu Aakaasamlona",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Asha Ashirwadh"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "తార వెలిసెను చూడు ఆకాశంలోన",
      "రక్షణ పుట్టెను నేడు క్రిస్మస్ కాంతిలోన",
      "మహా అద్భుతము జరిగెను ఈ భువిలోనా",
      "వినిపించెను సువర్తమానము ఈ ప్రపంచానా"
    ],
    "english": [
      "Thaara velisenu choodu aakaasamlona",
      "Rakshana puttenu nedu Christmas kaanthilona",
      "Mahaa adbhuthamu jarigenu ee bhuvilonaa",
      "Vinipinchenu suvarthamaanamu ee prapanchaanaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సంతోషంతో ఆనందంతో",
        "ప్రభువుని పూజించుదాం ఆరాధించుదాం",
        "అందరు రండీ సందడి చేద్దాం…."
      ],
      "english": [
        "Santhoshantho aanandhantho",
        "Prabhuvuni poojinchudhaam aaraadhinchudhaam",
        "Andaru randee sandadi cheddaam…."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బెత్లెహేము పురములో – ఆ పశువుల పాకలో",
        "రాజుల రాజు ప్రభువుల ప్రభువు ఉదయించెను మన కోసము(2)",
        "సర్వపాప పరిహార్ధమగుటకు పాపులను రక్షించుటకు పుట్టినాడని తెలిపింది ఆ గొప్ప మహతార.(2)",
        "గొల్లలు జ్ఞానులు వచ్చిరి – ప్రభువును పూజించిరి",
        "బంగారు సాంబ్రాణి భోళముతో ఆరాధించిరి(2)",
        "మహిమ వెలుగుతో బాల యేసుడు పరుండియుండుట చూచిరి – ఎంత ధన్యత చేసుకొంటిరో ఆ గొల్లలు జ్ఞానులు(2)"
      ],
      "english": [
        "Bethlehemu puramulo – Aa pashuvula paakalo",
        "Raajula raaju prabhuvula prabhuvu udayinchenu mana kosamu(2)",
        "Sarvapaapa parihaardhamagutaku paapulanu rakshinchutaku puttinaadani telipindhi aa goppa mahathaara.(2)",
        "Gollalu gnaanulu vachchiri – Prabhuvunu poojinchiri",
        "Bangaaru saambraani bolamutho aaraadhinchiri(2)",
        "Mahima velugutho baala Yesudu parundiyunduta choochiri – Entha dhanyatha chesukontiro aa gollalu gnaanulu(2)"
      ]
    }
  ]
}
