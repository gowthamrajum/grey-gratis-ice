  "main_stanza": {
    "telugu": [
      "ఈరోజు క్రొత్త వెలుగు",
      "మన జీవితాలలో ఆ వెలుగు",
      "ఆ వెలుగే యేసుక్రీస్తు ॥2॥"
    ],
    "english": [
      "Eeroju krotta velugu",
      "Mana jeevithaalalo aa velugu",
      "Aa veluge Yesukreesthu ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మన కోసం పుట్టాడు",
