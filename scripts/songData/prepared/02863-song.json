{
  "song_name": "Thandri Vantivaadu Manaku Dharanini Boashinchuvaadu",
  "author": {
    "Authored by": "",
    "రచన": "దేవుఁడు బలే మంచివాఁడు ధరణిని బాలించువాఁడు ఈవుల నిచ్చువా"
  },
  "main_stanza": {
    "telugu": [
      "తండ్రి వంటివాఁడు మనకు ధరణిని బోషించువాఁడు",
      "దండ్రి ప్రియుఁ డు నందరికిఁ దగినవాని నొసగువాఁడు"
    ],
    "english": [
      "Thandri Vantivaadu Manaku Dharanini Boashinchuvaadu",
      "Dhandri Priyu Du Nandhariki Dhaginavaani Nosaguvaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అన్నవస్త్రములనే గాక యన్నిఁటిని నిచ్చువాడు",
        "మన్ననతోఁ బ్రోచు వాడు మనతో నెప్పుడు మెలఁగువాఁడు"
      ],
      "english": [
        "Annavasthramulanae Gaaka Yannitini Nichchuvaadu",
        "Mannanathoa Broachu Vaadu Manathoa Neppudu Melaguvaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కష్టబాధలందు మనలఁ గనికరముతోఁ గాచువాఁడు",
        "దుష్టమనసు తీసివేసి యిష్టముతో నుండువాఁడు"
      ],
      "english": [
        "Kashtabaadhalandhu Manala Ganikaramuthoa Gaachuvaadu",
        "Dhushtamanasu Theesivaesi Yishtamuthoa Nunduvaadu"
      ]
    }
  ]
}
