{
  "song_name": "Prabhuva Nee Karyamulu",
  "author": {
    "Authored by": "Lillian Christopher",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నీ కార్యములు ఆశ్చర్యకరమైనవి",
      "దేవా నీదు క్రియలు అద్భుతముయున్నవి",
      "నే పాడెదన్ నే చాటెదన్ నీదు నామమును భువిలో",
      "సన్నుతించెదను నా యేసయ్యా నా జీవితము నీకేనయ్యా"
    ],
    "english": [
      "Prabhuvaa nee kaaryamulu aascharyakaramainavi",
      "deva needhu kriyalu adbhuthamulai vunnavi",
      "ne paadedhan ne chaatedhan needhu naamamunu bhuvilo",
      "sannuthinchedhanu naa yesayya naa jeevithamu neekenayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హాలేలూయ హాలేలూయ"
      ],
      "english": [
        "Hallelujah Hallelujah"
      ]
    }
  ]
}
