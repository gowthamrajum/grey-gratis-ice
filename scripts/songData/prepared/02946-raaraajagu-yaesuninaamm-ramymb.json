{
  "song_name": "Raaraajagu Yaesuninaamam",
  "author": {
    "Authored by": "",
    "రచన": "పి  రవివర్మ"
  },
  "main_stanza": {
    "telugu": [
      "రారాజగు యేసునినామం రమ్యంబగు దేవుని నామం",
      "ఈశుండగు యేసునినామం ఈధర నిదె పావననామం",
      "యేసునినామం దేవునినామం రమ్యంబగు దేవుని నామం"
    ],
    "english": [
      "Raaraajagu Yaesuninaamam Ramyambagu Dhaevuni Naamam",
      "Eeshundagu Yaesuninaamam Eedhara Nidhe Paavananaamam",
      "Yaesuninaamam Dhaevuninaamam Ramyambagu Dhaevuni Naamam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గగనమువీడిన గురునామం కలుషాత్మలబ్రోచెడు నామం"
      ],
      "english": [
        "Gaganamuveedina Gurunaamam Kalushaathmalabroachedu Naamam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్లీవాంకముగల యినామం సుజనుల జేసెడు స్థిరనామం"
      ],
      "english": [
        "Sleevaankamugala Yinaamam Sujanula Jaesedu Sthiranaamam"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విజయం బొపగెడు నిజనామం విమలాత్ముల కిదివరనామం"
      ],
      "english": [
        "Vijayam Bopagedu Nijanaamam Vimalaathmula Kidhivaranaamam"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనమున కిది యజ్జ్వలనామం జనములకిదియే ఋజునామం"
      ],
      "english": [
        "Manamuna Kidhi Yajjvalanaamam Janamulakidhiyae Rujunaamam"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఈధరస్తుతులను గొనునామం ఈయేసుని యమృతనామం"
      ],
      "english": [
        "Eedharasthuthulanu Gonunaamam Eeyaesuni Yamruthanaamam"
      ]
    }
  ]
}
