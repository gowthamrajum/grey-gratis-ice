{
  "song_name": "Prema prema - Prema priyudavu neeve",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రేమా ప్రేమా - ప్రేమా ప్రియుడవు నీవే - ఆనంద మానందమే"
    ],
    "english": [
      "Prema prema - Prema priyudavu neeve - Aananda maanandhame"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ ప్రేమ రుచియించిననాడే - నన్ను నేను మరచితినయ్యా",
        "నీ ప్రేమధికమయ్యా - నా పై - నీ ప్రేమధికమయ్యా"
      ],
      "english": [
        "Nee prema ruchiyinchinanaade - Nannu nenu marachithinayyaa",
        "Nee premadhikamayyaa - Naa pai - Nee premadhikamayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరలోక ప్రశస్తరాజా - ప్రేమతో నేతెంచినావా",
        "ప్రేమ తెలియగలనా - నీ ప్రేమ - లోతునెరుగగలనా?"
      ],
      "english": [
        "Paraloka prashastharaajaa - Prematho nethenchinaavaa",
        "Prema theliyagalanaa - Nee prema - Lothunerugagalanaa?"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ద్రోహినై ఎన్నాళ్ళో నిన్ను - గాంచక తిరిగితినయ్యా",
        "ప్రేమతో నా ప్రియుడా - నన్ను - కౌగిలించితివే"
      ],
      "english": [
        "Dhrohinai ennaallo ninnu - Gaanchaka thirigithinayyaa",
        "Prematho naa priyudaa - Nannu - Kaugilinchithive"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇహలోక సకల మహిమ - పువ్వులవలె వాడిపోవున్",
        "వాడదే అయ్యా - నీ ప్రేమ - వాడిపోదయ్యా"
      ],
      "english": [
        "Ihaloka sakala mahima - Puvvulavale vaadipovun",
        "Vaadadhe ayyaa - Nee prema - Vaadipodhayyaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ ప్రేమ మాధుర్యమును - వివరింప తరమౌనే నాకు",
        "అతి సులభముగానే - పరమున - వివరించగలను"
      ],
      "english": [
        "Nee prema maadhuryamunu - Vivarimpa tharamaune naaku",
        "Athi sulabhamugaane - Paramuna - Vivarinchagalanu"
      ]
    }
  ]
}
