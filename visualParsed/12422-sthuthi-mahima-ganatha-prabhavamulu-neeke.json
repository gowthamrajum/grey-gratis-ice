      ],
      "english": [
        "Kaluvarilo kaarchina - Nee viluvaina rakthamuche",
        "Kalushamulan baapina - Maa prabhuvaa sthothramu",
        "Kadavaraku nee premalo - Nadipinchu naayaka |Hallelooya||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
