{
  "song_name": "Simhaasanamandhu aaseenudai yunduvaani kudichethilo",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఓ కరుణానిధీ, మహా ప్రభుయేసు - నీవే సింహాసనాసీనుడవైతివి"
    ],
    "english": [
      "O karunaanidhee, mahaa Prabhu Yesu - Neeve simhaasanaaseenudavaithivi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సత్యస్వరూపివి పరిశుద్ధుడవు - దావీదు తాళము కల్గియున్నావు",
        "నీవు తెరచినది మూయగలేరు",
        "బంధించినది తెరువగలేరెవ్వరు - నీ మహాత్మ్యమదే"
      ],
      "english": [
        "Sathyasvaroopivi parishuddhudavu - Daaveedu thaalamu kalgiyunnaavu",
        "Neevu therachinadhi mooyagaleru",
        "Bandhinchinadhi theruvagalerevvaru - Nee mahaathmyamadhe"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏడు నక్షత్రములు నీచేత కలవు - దీప స్తంభముల మధ్య",
        "సంచరించెదవు - జీవించువాడవు ఆది అంతములు - రెండంచుల",
        "ఖడ్గం కలిగిన ప్రభువా - అదియే నీ ఘనత"
      ],
      "english": [
        "Edu nakshathramulu neechetha kalavu - Deepa sthambhamula madhya",
        "Sancharinchedhavu - Jeevinchuvaadavu aadi anthamulu - Rendanchula",
        "Khadgam kaligina Prabhuvaa - Adiye nee ghanatha"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అగ్నివంటి నేత్రములు కల్గి - అపరాపరంజి వంటి పాదములు కలిగి",
        "దేవుని ఏడు ఆత్మలు కలిగి - గ్రంధము తెరచే యోగ్యుడవీవే",
        "ధన్యుడవు నీవే"
      ],
      "english": [
        "Agnivanti nethramulu kalgi - Aparaaparanji vanti paadamulu kaligi",
        "Devuni edu aathmalu kaligi - Grandhamu therache yogyudaveeve",
        "Dhanyudavu neeve"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నమ్మకమైన సత్యసాక్షియు - సర్వసృష్టికి కర్తయైయుండి",
        "నీతిమంతుడు బహుజ్వాలామయుడు దీర్ఘశాంతుడు",
        "శక్తిమంతుడు - ఆమెన్ అనువాడు"
      ],
      "english": [
        "Nammakamaina sathyasaakshiyu - Sarvasrushtiki karthayaiyundi",
        "Neethimanthudu bahujvaalaamayudu dheerghashaanthudu",
        "Shakthimanthudu - Aamen anuvaadu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఎల్లరు ప్రభుని స్తుతించెదరు - సాగిల పడెదరు కృతజ్ఞులై",
        "ఆశ్చర్యక్రియలు చేసితివంచు - ప్రభువా నీవే అగమ్యుడవంచు",
        "నినుకొనియాడెదము"
      ],
      "english": [
        "Ellaru Prabhuni sthuthinchedharu - Saagila padedharu kruthajnulai",
        "Aashcharyakriyalu chesithivanchu - Prabhuvaa neeve agamyudavanchu",
        "Ninukoniyaadedhamu"
      ]
    }
  ]
}
