{
  "song_name": "Theerpu theerchu ghadiya vachchuchunnadhi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "తీర్పు తీర్చు గడియ వచ్చుచున్నది",
      "కాలము సంపుర్ణమౌతున్నాది ॥2॥"
    ],
    "english": [
      "Theerpu theerchu ghadiya vachchuchunnadhi",
      "Kaalamu sampoornamauthunnaadhi ||2||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృపకాలమంతమొందక ముందే",
        "క్రిస్తు యేసుని మనసారా వేడుకో ॥2॥"
      ],
      "english": [
        "Krupakaalamanthamondhaka munde",
        "Kreesthu Yesuni manasaaraa veduko ||2||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లెక్కింపబడును నీ దినకార్యములన్నియు",
        "లిఖింపబడును పరలోకమందునా ॥2॥"
      ],
      "english": [
        "Lekkimpabadunu nee dhinakaaryamulanniyu",
        "Likhimpabadunu paralokamandhunaa ||2||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తప్పింప తరము కాదు ఎవరికి ఇలాలో",
        "తప్పదు మరణించిన తిర్పు పోందుట ॥2॥"
      ],
      "english": [
        "Thappimpa tharamu kaadu evariki ilaalo",
        "Thappadu maraninchina theerpu pondhuta ||2||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తులతూగును త్రాసులో నీ స్థితి గతులు",
        "తేలికై పోయినచో తప్పదు నరకం ॥2॥"
      ],
      "english": [
        "Thulathoogunu thraasulo nee sthithi gathulu",
        "Thelikai poyinacho thappadu narakam ||2||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రహస్య పాపాలైన వ్రాయును లెక్కలో",
        "నశింపకుండునట్లు ప్రభుని వేడుమా ॥2॥"
      ],
      "english": [
        "Rahasya paapaalaina vraayunu lekkalo",
        "Nashimpakundunatlu Prabhuni vedumaa ||2||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రతివారి తరుపునా ప్రతివాదిగా",
        "క్షమించమని క్రీస్తు తండ్రిని వేడున్ ॥2॥"
      ],
      "english": [
        "Prathivaari tharupunaa prathivaadhigaa",
        "Kshaminchamani Kreesthu thandrini vedun ||2||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పరలోక మందు జీవగ్రంధములో",
        "నిపేరు ఉండునట్లు ప్రభుని వేడుమా ॥2॥"
      ],
      "english": [
        "Paraloka mandu jeevagrandhamulo",
        "Nee peru undunatlu Prabhuni vedumaa ||2||"
      ]
    }
  ]
}
