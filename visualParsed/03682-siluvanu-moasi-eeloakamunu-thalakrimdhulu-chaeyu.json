      ],
      "english": [
        "Lelemmu sodharudaa nidhranundi",
        "Prakatimpanu Yesu naamamunu",
        "Somari yela nidhrinchedavu",
        "Ee dharanu lepedu samayamide"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధాత్మ కవచము తోడిగి",
