  "main_stanza": {
    "telugu": [
      "దిగివచ్చెను మరణించుటకై",
      "పరిశుద్ధుడు పరమును వీడి",
      "మన దోషములు తొలగించుటకై",
      "తలవంచెను ఆ శిలువపై",
      "లోకమును తానెంతో ప్రేమించెను",
      "తన ప్రాణమును బలియాగముగా అర్పించెను",
      "మనకై యేసు మరణించెను"
    ],
    "english": [
      "Dhigivachchenu maraninchutakai",
      "Parishuddhudu paramunu veedi",
      "Mana doshamulu tholaginchutakai",
      "Thalavanchenu aa siluvapai",
      "Lokamunu thaanentho preminchenu",
      "Thana praanamunu baliyaagamugaa arpinchenu",
      "Manakai Yesu maraninchenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవసుతుడు యేసు దేవుడు",
        "ఈ భూమిపై ఉదయించెను",
        "తాను సృజించిన మనుష్యులతో",
        "మాటలాడ దిగివచ్చెను",
        "తండ్రి పంపిన ప్రేమ సువార్తను",
        "వారికి తెలిపెను",
        "ఆ మాటలు నమ్మని కఠినులు",
        "యేసుని సిలువకీడ్చిరి",
        "సకల జనుల పాపమంత",
        "తన భుజముపై మోసెను",
        "నెత్తురు ధారలై కారుచుండగ",
        "నొప్పిని బరియించెను",
        "తండ్రి గుండెలో నిండిన ప్రేమను",
        "శిలువపై చూపించెను",
        "ఆ ప్రేమను మరువక నమ్మిన వారికి",
        "జీవము దొరుకును"
      ],
      "english": [
        "Daivasuthudu Yesu Devudu",
