{
  "song_name": "Naa praana aathma shareeram",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Yesanna"
    ],
    "రచన": [
      "బ్రదర్ యేసన్న"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రాణ ఆత్మ శరీరం - అంకితం నీకే ప్రభూ",
      "అంకితం నీకే ప్రభూ"
    ],
    "english": [
      "Naa praana aathma shareeram - Ankitham neeke prabhoo",
      "Ankitham neeke prabhoo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపపు ఊబిలో మరణించిన నన్ను - పరమందు చేర్చుటకు",
        "ప్రాణమిచ్చి నన్ను రక్షించినా - ప్రేమను మరువలేను",
        "నీ కృపను మరువలేను  ||నా||"
      ],
      "english": [
        "Paapapu oobhilo maraninchina nannu - Paramandu cherchutaku",
        "Praanamichchi nannu rakshinchinaa - Premanu maruvalenu",
        "Nee krupanu maruvalenu ||Naa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నన్ను నీ వలె మార్చుటకేగా - ఆత్మతో నింపితివి",
        "ఆత్మతో సత్యముతో ఆరాధించి",
        "ఆనంద ప్రవాహముతో నీదరి చేరెదను  ||నా||"
      ],
      "english": [
        "Nannu nee vale maarchutakegaa - Aathmatho nimpithivi",
        "Aathmatho sathyamutho aaraadhinchi",
        "Aananda pravaahamutho needhari cheredanu ||Naa||"
      ]
    }
  ]
}
