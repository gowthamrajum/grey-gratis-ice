    "english": [
      "Ellappudu ellappudu ellappudu santhoshamu",
      "Yesu naathokooda nunnandhuna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎల్లను పెంటతోడ తుల్యము - నరు",
        "లెల్లరును మన్నై పోవుదురు",
