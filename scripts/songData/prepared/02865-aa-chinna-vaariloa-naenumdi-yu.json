{
  "song_name": "Aa Chinna Vaariloa Naenundi Yunna",
  "author": {
    "Authored by": "",
    "రచన": "తూపిలి యోహాను"
  },
  "main_stanza": {
    "telugu": [
      "ఆ చిన్న వారిలో నేనుండి యున్న",
      "నహాహా మా యేసును నేఁ జూచి యుందు"
    ],
    "english": [
      "Aa Chinna Vaariloa Naenundi Yunna",
      "Nahaahaa Maa Yaesunu Nae Joochi Yundhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభు యేసు ప్రపంచమం దుండినపుడు",
        "పసి బాలకులఁ బిల్చి ప్రార్థించె ననెడు",
        "ప్రాచీన కథను నేఁ జదువుచున్నప్పుడు",
        "వారిలో నే నున్న నెంతో బాగుండు"
      ],
      "english": [
        "Prabhu Yaesu Prapanchamam Dhundinapudu",
        "Pasi Baalakula Bilchi Praarthinche Nanedu",
        "Praacheena Kathanu Nae Jadhuvuchunnappudu",
        "Vaariloa Nae Nunna Nenthoa Baagundu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆ కరుణ కరము నా తలపైని వ్రాలి",
        "యాకాశ బాహువు నా చుట్టు నిలిచి",
        "య నేక బాలకుల రానిమ్మను జాలి",
        "తోఁ గర్త పిలుపు విన నాకెంతో మేల్మి"
      ],
      "english": [
        "Aa Karuna Karamu Naa Thalapaini Vraali",
        "Yaakaasha Baahuvu Naa Chuttu Nilichi",
        "Ya Naeka Baalakula Raanimmanu Jaali",
        "Thoa Gartha Pilupu Vina Naakenthoa Maelmi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇ కమీఁదఁ బ్రార్థన ద్వారా దర్శింతున్",
        "బ్రకటిత ప్రభు ప్రేమ పంచి యియ్యమందు",
        "న మ్మకముతో యేసుని వెదకుచు నుందు",
        "సుఖ లోకమందునఁ జూచి వినుచుందు"
      ],
      "english": [
        "I Kameedha Braarthana Dhvaaraa Dharshinthun",
        "Brakatitha Prabhu Praema Panchi Yiyyamandhu",
        "Na Mmakamuthoa Yaesuni Vedhakuchu Nundhu",
        "Sukha Loakamandhuna Joochi Vinuchundhu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శుద్ధుల కొఱకు రాజ్యము నేలన్",
        "సిద్ధము చేయఁ బ్రభు యేసు వెళ్లెన్",
        "ముద్దు పాపలు వత్తు రందున విను",
        "మ శ్రద్ధ సేయకు వారి దాకాశ రాజ్య"
      ],
      "english": [
        "Shudhdhula Koraku Raajyamu Naelan",
        "Sidhdhamu Chaeya Brabhu Yaesu Vellen",
        "Mudhdhu Paapalu Vaththu Randhuna Vinu",
        "Ma Shradhdha Saeyaku Vaari Dhaakaasha Raajya"
      ]
    }
  ]
}
