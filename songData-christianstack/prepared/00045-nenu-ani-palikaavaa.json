{
  "song_name": "Nenu Ani Palikaavaa",
  "author": {
    "Authored by": "Ashakiran Pallikonda",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీకు వంగు స్తుతించు ప్రతిమోకాలు",
      "ఏదైనా రాయైనా విరిగెనా",
      "కరుణించి మన్నించి కాపాడు.”"
    ],
    "english": [
      "Neeku vangu sthuthinchu prathi mokaalu",
      "Edhaina raayaina virigenaa",
      "Karuninchi manninchi kaapaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "“నేను “అని పలికావా?",
        "“నేనే “అని చూపేవా ?",
        "నన్ను సజీవునిగా నాలో నీవుండుమా."
      ],
      "english": [
        "“Nenu” ani palikaavaa?",
        "“Nene” ani choopevaa?",
        "Nannu sajivunigaa naalo neevundumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అనగనగా అలసటలేని ఊపిరి నీవీగా",
        "విన వినగ బోధపడే మ్రొక్కెద ఈ పూట."
      ],
      "english": [
        "Anaganagaa alasataleni oopiri neeveegaa",
        "Vina vinagaa bodhapade mrokkeda ee poota"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిన్నా, నేడు, రేపూ నీవు ఏకరీతిగానే ఉన్నావు.",
        "బ్రతికేను ఉసరవెల్లినై — క్షమించి, మన్నించుము; ఇవే నా ప్రార్థనలు.",
        "నీ ప్రజలే నా ప్రజలు,",
        "నీ దేవుడే నా దైవం అని అన్న రూతులు",
        "లేరయ్యా —నాకెవరు లేరయ్యా",
        "నన్ను కాదనకయ్యా;",
        "బ్రతిమాలి వేడుకొంటినే."
      ],
      "english": [
        "Ninnaa, nedu, repu neevu ekareethigaane unnaavu",
        "Brathikenu usaravellinai — kshaminchi,",
        "Manninchumu; ive naa praarthanalu",
        "Nee prajale naa prajalu",
        "Nee devude naa daivam ani anna Ruthulu",
        "Lerayya — naakevaru lerayya",
        "Nannu kaadanakayya",
        "Brathimaali vedukontine"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నేను చూసి చాలుకున్నా",
        "జక్కయ్య ను చూచావు",
        "జనసంద్రములో ఊహించనులేదే-",
        "పేరు పెట్టి పిలిచి రమ్మని రక్షణ ఇంటికి తెచ్చావు.",
        "శతాధిపతి కున్న నేమాట చాలు అనే విశ్వాసం-",
        "తనయునకే జీవం ఇచ్చెనా",
        "ఓటమి దారి చేరదు",
        "నీలోనే నా విజయం",
        "రాజా నీవే శరణం."
      ],
      "english": [
        "Nenu choosi chaalukunnā",
        "Jakkayyanu choochaavu",
        "Janasandramulo oohinchanu lede",
        "Peru petti pilichi rammani rakshana intiki techchaavu",
        "Shataadhipatiki unna ne maata chaalu ane vishvaasam",
        "Tanayunake jeevam ichchenaa",
        "Otami daari cheradu",
        "Neelone naa vijayam",
        "Raajaa neeve sharanam"
      ]
    }
  ]
}
