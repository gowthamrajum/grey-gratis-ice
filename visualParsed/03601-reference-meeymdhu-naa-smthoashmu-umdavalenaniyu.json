{
  "song_name": "Reference: Meeyandhu naa santhoshamu undavalenaniyu,",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆనంద మహానందం ప్రభువే మనకానందం",
      "మనయందు నిలిచి యుండును పరలోకపు ఆనందం"
    ],
    "english": [
      "Aananda mahaanandham Prabhuve manakaanandham",
      "Manayandhu nilichi yundunu paralokapu aanandam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూతలు తెచ్చిరి శుభవార్త యెంతో గొప్పానందము",
        "కుమ్మరించును మదిలో పరమునుండి పాపి నలిగినప్పుడే"
      ],
      "english": [
        "Doothalu thechchiri shubhavaartha entho goppaanandhamu",
        "Kummarinchunu madilo paramunundi paapi naliginappude"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆనందించుడనె ప్రభువే పరమందున మీ పేరుల్",
        "గొఱ్ఱెపిల్ల జీవగ్రంథమందు వ్రాయబడియున్నవని"
      ],
      "english": [
        "Aanandhinchudane Prabhuve paramanduna mee perul",
        "Gorrepilla jeevagranthamandhu vraayabadiyunnavani"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ సన్నిధియందే కలవు నిత్యసంతోషములు",
        "నీ చిత్తము నెరవేర్చువారెల్లరు ఆనందించెదరు సదా"
      ],
      "english": [
        "Nee sannidhiyandhe kalavu nithyasanthoshamulu",
        "Nee chitthamu neraverchuvaarellaru aanandhinchedharu sadaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇదివరకును మీరేమియును అడుగలేదు నన్ను",
        "మీ సంతోషము పూర్ణమగునట్లు అడిగి పొందుమనెను"
      ],
      "english": [
        "Idhivarakunu meeremiyunu adugaledu nannu",
        "Mee santhoshamu poornamagunatlu adigi pondhumanenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యెహోవా విమోచించిన వారే పాటలు పాడి",
        "శిరములపై నిత్య సంతసము గలవారై వచ్చెదరు"
      ],
      "english": [
        "Yehova vimochinchina vaare paatalu paadi",
        "Shiramulapai nithya santhasamu galavaarai vachchedaru"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆయన కొరకవమానమును మరినిందకు పాత్రులము",
        "తన వాక్యమెవ్వరి మదియందుండునో సంతోషింతురు మిగుల"
      ],
      "english": [
        "Aayana korakavamaanamunu marinindhaku paathrulamu",
        "Thana vaakyamevvari madhiyandhundhuno santhoshinthuru migula"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆత్మలు రక్షింపబడిన అధికముగా సంతసించు",
        "సర్వకాలము సంతోషము కలిగి హెల్లెలూయ పాడెదరు"
      ],
      "english": [
        "Aathmalu rakshimpabadina adhikamugaa santhasinchu",
        "Sarvakaalamu santhoshamu kaligi hellelooya paadedaru"
      ]
    }
  ]
}
