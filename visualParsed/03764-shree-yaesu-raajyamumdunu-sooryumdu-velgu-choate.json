{
  "song_name": "Shree Yesu raajyamundunu sooryundu velgu chotella",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శ్రీ యేసు రాజ్యముండును - సూర్యుండు వెల్గు చోటెల్ల",
        "కల్పాంత కాలమౌదాక - యా రాజ్యము వ్యాపించును"
      ],
      "english": [
        "Shree Yesu raajyamundunu - Sooryundu velgu chotella",
        "Kalpaantha kaalamaudhaaka - Yaa raajyamu vyaapinchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిరతంబు ప్రార్థనల్ - నిత్యస్తుతుల్ శ్రీ యేసుకు",
        "తన్నామము ప్రత్యహము - సుగంధమట్లు లేచును"
      ],
      "english": [
        "Nirathambu praarthanal - Nithyasthuthul Shree Yesuku",
        "Thannaamamu prathyahamu - Sugandhamatlu lechunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సమస్తదేశవాసులు - గణింతురేసు ప్రేమను",
        "శ్రీ యేసు పేరు బాలకుల్ - బాల్యంబున స్తుతింతురు"
      ],
      "english": [
        "Samasthadheshavaasulu - Ganinthuresu premanu",
        "Shree Yesu peru baalakul - Baalyambuna sthuthintharu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసుని యీవు లొల్కును - ఖైదీకి సంకెళ్ళూడును",
        "డాయంగ శాంతి కల్గును - సుభాగ్య మబ్బుఁపేదకున్"
      ],
      "english": [
        "Yesuni eevu lolkunu - Khaidheeki sankelloodunu",
        "Daayanga shaanthi kalgunu - Subhaagya mabbupedhakun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శ్రీ యేసు శక్తిచేతను - స్వస్థంబు గల్గు నెల్లడన్",
        "దచ్ఛక్తియున్న మేరలను - నశించు మృత్యుశాపముల్"
      ],
      "english": [
        "Shree Yesu shakthichethanu - Swasthambu galgu nelladan",
        "Dhachchhakthiyunna meralanu - Nashinchu mruthyushaapamul"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మా రాజు మాకెల్ల సృష్టియున్ - విశేష స్తుతుల్ సల్పుతన్",
        "దూతాళి మళ్ళి పాడఁగా - ఘోషించు భూమియు ఆమేన్"
      ],
      "english": [
        "Maa raaju maakella srushtiyun - Vishesha sthuthul salputhan",
        "Doothaali malli paadagaa - Ghoshinchu bhoomiyu aamen"
      ]
    }
  ]
}
