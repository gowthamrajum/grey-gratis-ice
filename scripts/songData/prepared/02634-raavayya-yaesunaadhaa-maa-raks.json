{
  "song_name": "Raavayya Yaesunaadhaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రావయ్య యేసునాధా మా రక్షణమార్గము",
      "నీ సేవఁ జేయ మమ్ముఁ జేపట్టుటకు"
    ],
    "english": [
      "Raavayya Yaesunaadhaa Maa Rakshanamaargamu",
      "Nee Saeva Jaeya Mammu Jaepattutaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హద్దు లేక మేము ఇల మొద్దులమై యుంటిమి",
        "మా కొద్ది బుద్ధులన్ని దిద్ది రక్షింపను"
      ],
      "english": [
        "Hadhdhu Laeka Maemu Ila Modhdhulamai Yuntimi",
        "Maa Kodhdhi Budhdhulanni Dhidhdhi Rakshimpanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిండు వేడుకతోను మమ్ము బెండువడక చేసి",
        "మా గండంబు లన్నియు ఖండించుటకు"
      ],
      "english": [
        "Nindu Vaedhukathonu Mammu Benduvadaka Chaesi",
        "Maa Gandambu Lanniyu Khandinchutaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మేర లేని పాపము మాకు భారమైన మోపు",
        "నీవు దూరంబుగాఁ జేసి దారిఁ జూపుటకు"
      ],
      "english": [
        "Maera Laeni Paapamu Maaku Bhaaramaina Mopu",
        "Neevu Dhoorambugaa Jaesi Dhaari Jooputaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపుల మయ్య మేము పరమ తండ్రిని గానకను",
        "మా పాపంబు లన్నియుఁ పారఁ దోలుటకు"
      ],
      "english": [
        "Paapula Mayya Maemu Parama Thandrini Gaanakanu",
        "Maa Paapambu Lanniyu Paara Dholutaku"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అందమైన నీదు పరమానంద పురమందు మే మందరముజేరి ఆనందించుటకు"
      ],
      "english": [
        "Andhamaina Needhu Paramaanandha Puramandhu Mae Mandharamujaeri Aanandhinchutaku"
      ]
    }
  ]
}
