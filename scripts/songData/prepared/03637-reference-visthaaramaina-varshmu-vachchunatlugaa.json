  "main_stanza": {
    "telugu": [
      "ప్రభువా పంపు వర్షమును",
      "నీ వాగ్దానములు స్థిరపరచి భీకర ధ్వనితో రానిమ్ము"
    ],
    "english": [
      "Prabhuvaa PMpu VarShamunu",
      "Nee Vaagdhaanamulu SThiraparachi Bheekara Dhvanithoa Raanimmu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏలియా మొరపెట్టగానే",
        "మేఘములు కారుగమ్మెను",
        "మోపైన వాన - భువిపైన గురిసే",
        "మా దీన ప్రార్థన వినుమా"
      ],
      "english": [
        "Aeliyaa Morapettagaanae",
        "Maeghamulu Kaarugammenu",
        "Moapaina Vaana - Bhuvipaina Gurisae",
        "Maa Dheena PraarThana Vinumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
