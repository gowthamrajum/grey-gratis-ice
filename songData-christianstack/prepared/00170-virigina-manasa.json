  "main_stanza": {
    "telugu": [
      "విరిగిన మనసా నీకు గాయమాయాన",
      "కోరినవన్నీ నీకు దూరమాయాన"
    ],
    "english": [
      "Virigina manasa Neku gaayamayenaa",
      "Koorina vanni Neku dhuramayena"
    ]
