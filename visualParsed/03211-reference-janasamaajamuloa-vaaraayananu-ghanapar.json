  },
  "main_stanza": {
    "telugu": [
      "వారాయనను జనసమాజములో ఘనపరచుదురు గాక",
      "వారాయనను పెద్దల సమాజములో కీర్తింతురు గాక"
    ],
    "english": [
      "Vaaraayananu janasamaajamulo ghanaparachudhuru gaaka",
      "Vaaraayananu peddhala samaajamulo keerthinthuru gaaka"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేశనివాసుల చెడుగును బట్టి - నదుల నడవిగ జేసెను",
        "నీటి బుగ్గల నెండిన నేలగాను మార్చెను"
      ],
      "english": [
        "Dheshanivaasula chedugunu batti - Nadula nadaviga jesenu",
        "Neethi buggala nendina nelagaanu maarchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అడవిని నీటిమడుగుగా - మార్చివేసె నెహోవా",
        "ఎండిన నేలను నీటి - ఊటగాను మార్చెను"
      ],
      "english": [
        "Adavini neetimadugugaa - Maarchivesen Yehova",
        "Endina nelanu neethi - Ootagaanu maarchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పురములు నివాసమునకై - వారేర్పరచుకొనునట్లు",
        "పొలములలో విత్తనములు చల్లి - ద్రాక్షాతోటలు నాటిరి"
      ],
      "english": [
        "Puramulu nivaasamunakai - Vaarerparachukonunatlu",
        "Polamulalo vitthanamulu challi - Dhraakshaathotalu naatiri"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సస్య ఫల సమృద్ధి పొందు - నట్లు వాటివలన",
        "ఆయన ఆకలిగొనిన వారిని - అచ్చట కాపురముంచెను"
      ],
      "english": [
        "Sasya phala samruddhi pondu - Natlu vaativalana",
        "Aayana aakaligonina vaarini - Achchata kaapuramunchenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మరియు ఆయన వాని నధికము - గా నాశీర్వదించగా",
        "వారి సంతానాభివృద్ధి - అధికముగా వర్ధిల్లెను"
      ],
      "english": [
        "Mariyu aayana vaani nadhikamu - Gaa naasheervadhinchagaa",
        "Vaari santhaanaabhivruddhi - Adhikamugaa vardhillenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వారు విచార బాధ వలన - తగ్గిపోయినపుడు",
        "రాజులను తృణీకరించి - ఎడారిలో తిరుగజేసె"
      ],
      "english": [
        "Vaaru vichaara baadha valana - Thaggipoyinapudu",
        "Raajulanu thruneekarinchi - Edaarilo thirugajese"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "అట్టి దరిద్రుల బాధను బాపి - వారిని లేవనెత్తెను",
        "అట్టివారి వంశము మంద - వలె వృద్ధిచేసెను"
      ],
      "english": [
        "Atti dharidhrula baadhanu baapi - Vaarini levanetthenu",
        "Attivaari vamshamu manda - Vale vruddhichesenu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "యధార్థవంతులు దాని - చూచి సంతోషింతురు",
        "మోసము చేయువారందరు - మౌనముగా నుందురు"
      ],
      "english": [
        "Yadhaarthavanthulu daani - Choochi santhoshinthuru",
        "Mosamu cheyuvaarandharu - Maunamugaa nundhuru"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "బుద్ధిమంతులు యీ విషయ-ముల నాలోచించును",
        "యెహోవ కృపాతిశయముల - దలంచెదరు గాక"
      ],
      "english": [
        "Buddhimanthulu ee vishaya-mula naalochinchunu",
        "Yehova krupaathishayamula - Dhalanchedharu gaaka"
      ]
    }
  ]
}
