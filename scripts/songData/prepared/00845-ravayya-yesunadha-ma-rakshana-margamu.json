{
  "song_name": "Ravayya Yesunadha Ma Rakshana Margamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రావయ్య యేసునాధా మా రక్షణ మార్గము",
      "నీ సేవ జేయ మమ్ము జేపట్టుటకు"
    ],
    "english": [
      "Ravayya Yesunadha Ma Rakshana Margamu",
      "Ni Seva Jeya Mammu Jepattutaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హద్దులేక మేము ఇల మొద్దులమై యుంటిమి",
        "మా కొద్ది బుద్దులన్ని దిద్ది రక్షింపను"
      ],
      "english": [
        "Hhadduleka Memu Ila Moddulamai Yumtimi",
        "Ma Koddi Buddulanni Diddi Rakshimpanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిండు వేడుకతోను మమ్ము బెండువడక చేసి",
        "మా గండంబులన్నియు ఖండించుటకు"
      ],
      "english": [
        "Nimdu Vedukatonu Mammu Bemduvadaka Chesi",
        "Ma Gamdambulanniyu Kamdimchutaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపుల మయ్యమేము పరమ తండ్రిని గానకను",
        "మా పాపంబు లన్నియు పారద్రోలుటకు"
      ],
      "english": [
        "Papula Mayyamemu Parama Tamdrini Ganakanu",
        "Ma Papambu Lanniyu Paradrolutaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అందమైన నీదు పరమానంద పురమందు",
        "మే మందరము జేరి యానందించుటకు"
      ],
      "english": [
        "Amdamaina Nidu Paramanamda Puramamdu",
        "Me Mamdaramu Jeri Yanamdimchutaku"
      ]
    }
  ]
}
