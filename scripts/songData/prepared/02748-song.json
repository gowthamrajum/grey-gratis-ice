{
  "song_name": "Naadhaa Samuyaelu Reethi Nee Yaamoadha Shabdhamu",
  "author": {
    "Authored by": "",
    "రచన": "ఫ్రాన్సెస్ రిడ్లీ హవర్గల్"
  },
  "main_stanza": {
    "telugu": [
      "నాధా! సముయేలు రీతి నీ యామోద శబ్దము",
      "సేవకుఁడ నైన నన్ను నాతో డాలకింపనీ",
      "నాతో నీవేమందువో నే నాలించువాఁడను."
    ],
    "english": [
      "Naadhaa! Samuyaelu Reethi Nee Yaamoadha Shabdhamu",
      "Saevakuda Naina Nannu Naathoa Daalakimpanee",
      "Naathoa Neevaemandhuvoa Nae Naalinchuvaadanu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ మాట గ్రహించునట్లు దానిఁ దేటపర్చుము",
        "నిన్ను వెంబడించునట్లు నిబ్బరింపఁ జేయుము",
        "నేను నీదు గొఱ్ఱెను 'బండ నీడలో మేపు'"
      ],
      "english": [
        "Nee Maata Grahinchunatlu Dhaani Dhaetaparchumu",
        "Ninnu Vembadinchunatlu Nibbarimpa Jaeyumu",
        "Naenu Needhu Gorrenu 'Banda Needaloa Maepu'"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నేను స్వల్పశిష్యుడను నన్ నిరాకరింపకు",
        "నిన్నాలింప నెంత యాశ నీ వెఱింగి యుందువు",
        "ఆత్మ యక్కరల్ తీర్చు ధన్యుఁడన్ నే నౌదును"
      ],
      "english": [
        "Naenu Svalpashishyudanu Nan Niraakarimpaku",
        "Ninnaalimpa Nentha Yaasha Nee Veringi Yundhuvu",
        "Aathma Yakkaral Theerchu Dhanyudan Nae Naudhunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాధా, నీ శబ్ద మాలింప నన్ను సిద్ధపర్చుము",
        "నీదుమాట లక్ష్య పెట్టి నిత్యసేవఁ జేయనీ",
        "నాతో నీవేమందువో నే నాలించువాఁడనే."
      ],
      "english": [
        "Naadhaa, Nee Shabdha Maalimpa Nannu Sidhdhaparchumu",
        "Needhumaata Lakshya Petti Nithyasaeva Jaeyanee",
        "Naathoa Neevaemandhuvoa Nae Naalinchuvaadanae."
      ]
    }
  ]
}
