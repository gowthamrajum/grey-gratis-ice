      "english": [
        "Vishvaasamandhu sampoorna nishchayamutho saagudhumu",
        "Neevu choopina maargamulo nilichiyundudhumu",
        "Muginpu varaku mammu nindhaarahithulugaa kaapaadumu",
        "Nee mahimalo Yesayyaa sampoornulamugaa nilupumu",
