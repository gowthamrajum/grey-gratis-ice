  "main_stanza": {
    "telugu": [
      "ఎవరేమనుకుంటున్నా నిన్ ఆరాధిస్తున్న",
      "నేనేమై పోతున్న నిన్ కీర్తిస్తున్న",
      "నిరాశ నిస్పృహలోన నీ వైపే చూస్తున్నా",
      "ఈ లోకపు అలజడిలో నా ఒడి నీవేగ"
    ],
    "english": [
      "Evaremanakuntunna nin aaradhistunna",
      "nenemai pothunna nin keerthistunna",
      "niraasha nispruhalona nee vaipe choostunna",
      "ee lokapu alajadilo naa odi neevega"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మదిలో మనశ్శాంతి లేక – మాటకేదో మిగిలి ఉన్న",
        "మతి వీడి వున్న నన్ను – మళ్ళీ కలిసి మన్నించావే",
        "మదిలో మనశ్శాంతి లేక – మాటకేదో మిగిలి ఉన్న",
        "మతి వీడి వున్న నన్ను – మళ్ళీ కలిసి మన్నించి",
        "నా కథలో ఓ మలుపే తెచ్చావు",
        "నా గుండెలో గొప్ప మార్పే ఇచ్చావే",
        "యేసయ్య నాకున్నది నీవయ్యా",
        "యేసయ్య నీవుంటే చాలయ్యా",
        "బ్రతుకు బాట బరువుగున్నా – బయటికొకల బ్రతుకుతున్న",
        "బరిలేని నన్ను చేరి – భ్రమనుండి వేరుచేసావే",
        "బ్రతుకు బాట బరువుగున్నా – బయటికొకల బ్రతుకుతున్న",
        "బరిలేని నన్ను చేరి – భ్రమనుండి వేరుచేసి",
        "యేసయ్య నన్నే భరించావే",
        "యేసయ్య నాకై బలైయ్యావా",
        "దోషినైన నన్నే ప్రేమించావా",
        "దరిలేని నను నీ దరి చేర్చావా"
      ],
      "english": [
        "Madilo manasshaanti leeka",
