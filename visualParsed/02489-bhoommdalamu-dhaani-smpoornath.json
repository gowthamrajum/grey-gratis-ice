{
  "song_name": "Bhoomandalamu daani sampoornathayunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "మల్లెల దావీదు"
    ]
  },
  "main_stanza": {
    "telugu": [
      "భూమండలము దాని సంపూర్ణత యును లోకమును",
      "భూమండల వాసులను బొల్పార యెహోవావే ||భూ||"
    ],
    "english": [
      "Bhoomandalamu daani sampoornatha yunu lokamunu",
      "bhoomandala vaasulanu bolpaara Yehovaave ||Bhoo||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవ సంద్రము మీఁద భుమి పునాది వేసె",
        "మహాజలమూల మీఁద మనదేవుఁడది స్థిరపర్చె ||భూ||"
      ],
      "english": [
        "Yehova sandramu meeda bhoomi punaadi vese",
        "mahaajalamoola meeda manadhevudadhi sthiraparche ||Bhoo||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవ పర్వతమునకు నెక్కంగఁ బాత్రుడెవఁడు",
        "మహాలయంబునందు మరి నిల్వ యోగ్యుం డెవఁడు ||భూ||"
      ],
      "english": [
        "Yehova parvathamunaku nekkanga baathrudevadu",
        "mahaalayambunandhu mari nilva yogyum devadu ||Bhoo||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అపవిత్ర మనసులేక కపట ప్రమాణము లేక",
        "సుపవిత్రమౌ చేతులను శుద్ధాత్మ గల్గినవాఁడే ||భూ||"
      ],
      "english": [
        "Apavithra manasuleka kapata pramaanamu leka",
        "supavithramau chethulanu shuddhaathma galginavaade ||Bhoo||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆలాటి వాఁడు ప్రభుని యాశీర్వచనము నొందు",
        "భులోకమున రక్షణ దేవుని నీతి మత్వముపొందు ||భూ||"
      ],
      "english": [
        "Aalaati vaadu prabhuni yaasheervachanamu nondhu",
        "bhoolokamuna rakshana Devuni neethi mathvamupondhu ||Bhoo||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రభునాశ్ర యించు నట్టి వారు యాకోబు దేవ",
        "ప్రభుసన్నిధానము వెదకు ప్రజలెల్ల రట్టివారే ||భూ||"
      ],
      "english": [
        "Prabhunaashra yinchu natti vaaru Yaakobu Deva",
        "prabhusannidhaanamu vedhaku prajalella rattivaare ||Bhoo||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ద్వారంబు లార యింక మీ తల లెల్లబైకెత్త వలెన్",
        "రారాజు కొరకుఁతలుపులాలా మిమ్మెత్తుకొనుఁడి ||భూ||"
      ],
      "english": [
        "Dvaarambu laara inka mee thala lellabaikettha valen",
        "raaraaju korakuthalupulaalaa mimmetthukonudi ||Bhoo||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఇలలో మహా మహిమంబు గలిగిన యీ రాజెవఁడు",
        "బలశౌర్యముల యెహోవ బహుశూరుడౌ యెహోవ ||భూ||"
      ],
      "english": [
        "Ilalo mahaa mahimambu galigina ee raajevadu",
        "balashauryamula Yehova bahushoorudau Yehova ||Bhoo||"
      ]
    }
  ]
}
