      ],
      "english": [
        "Rajulu Manakevvaru Leru Surulu Manakevvaru Leru",
        "Sainyamulaku Adhipatiyaina Yehova Manaamda (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యాధులు మనలను పడద్రోసిన బాధలు మనలను కృంగదీసిన",
        "విశ్వాసమునకు కర్తయైన యేసయ్య మనఅండ (2)"
      ],
      "english": [
        "Vyadhulu Manalanu Padadrosina Badhalu Manalanu Krumgadisina",
        "Visvasamunaku Kartayaina Yesayya Manaamda (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యెరికో గోడలు ముందున్న ఎఱ్ఱ సముద్రము ఎదురైన",
        "అద్భుత దేవుడు మనకుండ భయమేల మనకింక (2)"
      ],
      "english": [
        "Yeriko Godalu Mumdunna Erra Samudramu Eduraina",
        "Adbuta Devudu Manakumda Bayamela Manakimka (2)"
      ]
    }
  ]
