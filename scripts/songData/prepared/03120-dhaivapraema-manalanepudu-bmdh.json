{
  "song_name": "Dhaivapraema Manalanepudu Bandhinchugaa",
  "author": {
    "Authored by": "",
    "రచన": "ఎ చార్లెస్ కిన్సింగర్"
  },
  "main_stanza": {
    "telugu": [
      "దైవప్రేమ మనలనెపుడు బంధించుగా దివిని భువిని",
      "దీన జనులను దిరముగా కాపాడుగా"
    ],
    "english": [
      "Dhaivapraema Manalanepudu Bandhinchugaa Dhivini Bhuvini",
      "Dheena Janulanu Dhiramugaa Kaapaadugaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమతండ్రి గద్దెముందట ప్రార్థనల్ మరిజేతుము",
        "పలు విధముల మార్గములలో ప్రభువే తోడైయుండుగా"
      ],
      "english": [
        "Paramathandri Gaddhemundhata Praarthanal Marijaethumu",
        "Palu Vidhamula Maargamulaloa Prabhuvae Thoadaiyundugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్యప్రభువు సత్యసేవను నిరతమును మదినుంతుము",
        "నిలిచియుందుము క్రీస్తుకొరకై నిత్యసేవక జనముగా"
      ],
      "english": [
        "Nithyaprabhuvu Sathyasaevanu Nirathamunu Madhinunthumu",
        "Nilichiyundhumu Kreesthukorakai Nithyasaevaka Janamugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మనము విడిచి వెళ్లునపుడు మదిని కల్గును వేదన",
        "మనసు హృదయము కలిసియుండగ మరల గలియుదు మెచ్చటో"
      ],
      "english": [
        "Manamu Vidichi Vellunapudu Madhini Kalgunu Vaedhana",
        "Manasu Hrudhayamu Kalisiyundaga Marala Galiyudhu Mechchatoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జనక తనయ పరిశుద్ధాత్మకు జయము మహిమయు ఘనతయు",
        "ఆదినుండి యిపుడు యెపుడు అవని పరమున జెల్లుగా"
      ],
      "english": [
        "Janaka Thanaya Parishudhdhaathmaku Jayamu Mahimayu Ghanathayu",
        "Aadhinundi Yipudu Yepudu Avani Paramuna Jellugaa"
      ]
    }
  ]
}
