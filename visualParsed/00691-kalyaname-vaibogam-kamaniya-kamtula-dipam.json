  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమదైవమే ప్రారంభించిన పరిశుద్ధమైన కార్యం",
        "నరుని మంచికై తన చేతులతో ప్రభు రాసిచ్చిన పత్రం"
      ],
      "english": [
        "Paramadhaivame praarambhinchina parishuddhamaina kaaryam",
        "Naruni manchikai thana chethulatho Prabhu raasichchina pathram"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కీడు తొలగించి మేలుతో నింపు ఆశీర్వాదాల వర్షం",
        "మోడుగానున్న జీవితాలు చిగురింపజేసే వసంతం"
      ],
      "english": [
        "Keedu tholaginchi melutho nimpu aasheervaadhaala varsham",
        "Modugaanunna jeevithaalu chigurimpajese vasantham"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవదూతలే తొంగిచూసేటి రమణీయమైన దృశ్యం",
        "భావమధురిమలు పొంగజేసేటి కమనీయమైన చత్రం"
      ],
      "english": [
        "Dhevadhoothale thongichooseti ramaneeyamaina drushyam",
        "Bhaavamadhurimalu pongajeseti kamaneeyamaina chithram"
      ]
    }
  ]
