{
  "song_name": "Stuthiyincheda Sarvonnatha",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీవే ఆశ – నీవే శ్వాస – నీవేగా – అతిశ్రేష్ఠుడా",
      "నాలో ప్రాణం – నాలో జీవం – నీవేగా – బలవంతుడా"
    ],
    "english": [
      "Neeve aasa – neeve swaasa – neevegaa – athisreshtudaa",
      "naalo praannam – naalo jeevam – neevegaa – balavanthudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమ పూర్ణుడ – నా దేవ",
        "పావనాత్ముడ – యేసయ్య",
        "స్తుతికి పాత్రుడ – నా దేవ",
        "నా నిరీక్షణ – నీవేగ"
      ],
      "english": [
        "Prema purnuda – naa devaa",
        "paavanaathumdaa – yesayya",
        "stuthiki paathruda – naa deva",
        "naa nireekshanna – neevega"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్తుతియించెద – సర్వోన్నతా – పూజించెద – ప్రభువా యేసయా",
        "బలమైన నీ నామం"
      ],
      "english": [
        "Stuthiyincheda – sarvonnathaa – poojincheda – prabhuva yesayyaa",
        "balamaina nee naamam"
      ]
    }
  ]
}
