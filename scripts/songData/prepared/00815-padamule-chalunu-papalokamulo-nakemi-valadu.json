    {
      "stanza_number": 2,
      "telugu": [
        "తీరని నా పాప భారమునంతయు",
        "తీర్చెను సిలువను మోసి నడచిన"
      ],
      "english": [
        "Tirani Na Papa Baramunamtayu",
        "Tirchenu Siluvanu Mosi Nadachina"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సాదకముగ యేసు పాదములు గెలచిన",
        "ఆశ్రయమిచ్చి మోక్షము నొసగెను"
      ],
      "english": [
        "Sadakamuga Yesu Padamulu Gelachina",
        "Asrayamichchi Mokshamu Nosagenu"
      ]
    }
  ]
