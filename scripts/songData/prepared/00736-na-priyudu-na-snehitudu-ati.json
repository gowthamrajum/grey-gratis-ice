{
  "song_name": "Na Priyudu Na Snehitudu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రియుడు నా స్నేహితుడు అతి మధురం అతి కాంక్షనీయుడు",
      "దవళవర్ణుడు రత్నవర్ణుడు అతడే నా ప్రియుండు అతడే నా స్నేహితుడు"
    ],
    "english": [
      "Na Priyudu Na Snehitudu Ati Madhuram Ati Kamkshaniyudu",
      "Davalavarnudu Ratnavarnudu Atade Na Priyumdu Atade Na Snehitudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభువా పది వేళలో అతి సుందరుడా",
        "పరిశుద్ధుల కొరకై వచ్చు చున్నావా (2)",
        "పరలోకములో మమ్ము చేర్చుకొందువా (2)"
      ],
      "english": [
        "Prabuva Padi Velalo Ati Sumdaruda",
        "Parisuddhula Korakai Vachchu Chunnava (2)",
        "Paralokamulo Mammu Cherchukomduva (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సుగంధ పరిమళాల సువ్వాసనా",
        "పరిశుద్దులు కుమ్మరించు ఆరాధనా (2)",
        "షూలమ్మితి సంఘమునే కోరుకొందువా (2)"
      ],
      "english": [
        "Sugamdha Parimalala Suvvasana",
        "Parisuddulu Kummarimchu Aradhana (2)",
        "Shulammiti Samgamune Korukomduva (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభు యేసు నామమందు విశ్వసించినా",
        "పవిత్రా రక్తములో కడుగ బడుదువు (2)",
        "పరిశుద్ధుల విందులో ఆనందింతువు (2)"
      ],
      "english": [
        "Prabu Yesu Namamamdu Visvasimchina",
        "Pavitra Raktamulo Kaduga Baduduvu (2)",
        "Parisuddhula Vimdulo Anamdimtuvu (2)"
      ]
    }
  ]
}
