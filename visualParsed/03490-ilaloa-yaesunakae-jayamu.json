{
  "song_name": "Ilalo Yesunake jayamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "72:17",
      "ఇలలో యేసునకే జయము - సర్వజనమా పాడు జయం"
    ],
    "english": [
      "72:17",
      "Ilalo Yesunake jayamu - Sarvajanamaa paadu jayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జగముకొరకై ప్రభువు తన ప్రాణమిచ్చెను",
        "సర్వజనమా వినుడి మీరు, తానే రక్షకుడు"
      ],
      "english": [
        "Jagamukorakai prabhuvu thana praanamichchenu",
        "Sarvajanamaa vinudi meeru, thaane rakshakudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపులను ప్రేమించువాడు, పాపి కాశ్రయుడు",
        "పాపులను తన దాపున జేర్చి, పావనపరచును"
      ],
      "english": [
        "Paapulanu preminchuvaadu, paapi kaashrayudu",
        "Paapulanu thana daapuna jerchi, paavanaparachunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తానే మనకు నిత్య ప్రభువు, రాజులకు రాజు",
        "అందర మొకటే పాడెదమిలలో, ఆయనకే జయము"
      ],
      "english": [
        "Thaane manaku nithya prabhuvu, raajulaku raaju",
        "Andhara mokate paadedhamilalo, aayanake jayamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జయధ్వనులను చేయరండి, విజయుడేసునకే",
        "సర్వజనమా జయమని పాడు డాయనే జయశాలి"
      ],
      "english": [
        "Jayadhvanulanu cheyarandi, vijayudesunake",
        "Sarvajanamaa jayamani paadu daayane jayashaali"
      ]
    }
  ]
}
