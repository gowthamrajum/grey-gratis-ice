  "main_stanza": {
    "telugu": [
      "ప్రార్థించుము - ప్రియుడా ప్రభు సన్నిధిలో",
      "పోరాడుచుండుము - పట్టు విడువక"
    ],
    "english": [
      "Praarthinchumu - priyudaa Prabhu sannidhilo",
      "Poraaduchundumu - pattu viduvaka"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అడుగుము నీకు ఇవ్వబడును",
        "తట్టుము - నీ కెల్లప్పుడు తెరువబడును"
      ],
      "english": [
        "Adugumu neeku ivvabadunu",
        "Thattumu - nee kellappudu theruvabadunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆవగింజంత విశ్వాసమున్న - అవనియందు",
        "కదలింతువు పర్వతములను"
      ],
      "english": [
        "Aavaginjantha vishvaasamunna - avaniyandhu",
        "Kadalinthuvu parvathamulanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అడుగు వాటిని - పొందితివని నమ్ము",
        "ఊహించు వాటికన్నను పొందెదవు"
      ],
      "english": [
        "Adugu vaatini - pondhithivani nammu",
        "Oohinchu vaatikannanu pondedavu"
      ]
    }
  ]
}
