  "main_stanza": {
    "telugu": [
      "విత్తనం విరుగకపోతే – ఫలించునా",
      "కష్టాలే లేకపోతే – కిరీటమే వచ్చునా"
    ],
    "english": [
      "Vithanam virugakapothe – phalinchunaa",
      "kastaaley lekapothe – kireetamey vachunaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అను-పల్లవి:",
        "శ్రమలే నా అతిశయం – శ్రమలోనే ఆనందం",
        "శ్రమలయందే ఉత్సాహం – విశ్వానమే నా బలం"
      ],
      "english": [
        "Pre-chorus:",
        "Sramaley naa athisayam – sramaloney aanandham",
        "sramalayandhey uthsaaham – viswaasamey naa balam"
      ]
    }
  ]
