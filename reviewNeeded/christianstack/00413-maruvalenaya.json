{
  "song_name": "Maruvalenaya",
  "author": {
    "Authored by": "Chandra Mohan",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మరువలేనయా నీ మధురప్రేమను మహోపకారి",
      "చింతలేదయా నీ చెంతనుండను పరోపకారి",
      "నా ప్రాణ ప్రియుడా నా యేసయ్యా",
      "నీ రక్తమిచ్చి నన్ను కొన్నావయ్యా"
    ],
    "english": [
      "Maruvalenayaa nee madhurapremanu mahoopakaari",
      "chinthaledhaya nee chethanundanu paroopakaari",
      "naa praanna preyudaa naa yesayyaa",
      "nee rakthamicchi nannu konnaavayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీలాగా ప్రేమించేవారెవ్వరు",
        "నీలాగా క్షమియించే హృదయమేది",
        "నీ కృపలో నన్ను దాచితివి",
        "నీ ప్రేమలో నన్ను పెంచితివి",
        "నీ వాక్యము నాలో ఉంచి",
        "నీ వెలుగులో నను నడిపితివి",
        "యేసయ్యా….యేసయ్యా …..యేసయ్యా",
        "నా యేసయ్యా",
        "పచ్చికగల చోట పరుండజేసి",
        "జీవజలపు ఊటలు నాలో ఉంచి",
        "సమ్రృద్ధి జీవము నాకిచ్చితివి",
        "సంతోష గానాలు పాడించితివి",
        "నీ జీవము నాలో ఉంచి",
        "నిత్యజీవము నాకిచ్చితివి",
        "యేసయ్యా…..యేసయ్యా …..యేసయ్యా",
        "నా యేసయ్యా"
      ],
      "english": [
        "Neelaagaa preminchevaarevvaru",
        "neelaagaa kshamiyinche hrudhayamedhi",
        "nee krupaloo nannu dhaachithivi",
        "nee premaloo nannu penchithivi",
        "nee vaakyamu naaloo unchi",
        "nee veluguloo nanu nadipithivi",
        "yesayyaa …yesayyaa….yesayyaa…",
        "naa yesayyaa",
        "Pacchikagala choota parunjesi",
        "jeevajalapu ootalu naaloo unchi",
        "samudhrudhi jeevamu naakicchithivi",
        "santhoosha gaanaalu paadinchithivi",
        "nee jeevamu naaloo unchi nithyajeevamu naakicchithivi",
        "yesayyaa …"
      ]
    }
  ]
}
