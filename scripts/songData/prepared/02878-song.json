{
  "song_name": "Yaesu Nannu Braeminchi",
  "author": {
    "Authored by": "",
    "రచన": "అన్న చార్ట్లెట్ హర్నర్"
  },
  "main_stanza": {
    "telugu": [
      "యేసు నన్నుఁ బ్రేమించి దాసు నన్నుఁ బిల్చెను",
      "ఈ సత్యంబు బైబిలు తేటగాను దెల్పెను.",
      "యేసు ప్రేమించును దాసుల నందఱిన్ ఆ స్వామి వేదమే ఈ సత్య మిచ్చెను"
    ],
    "english": [
      "Yaesu Nannu Braeminchi Dhaasu Nannu Bilchenu",
      "Ee Sathyambu Baibilu Thaetagaanu Dhelpenu.",
      "Yaesu Praeminchunu Dhaasula Nandharin Aa Svaami Vaedhamae Ee Sathya Michchenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బాలురమౌ మమ్మును బాగుగాఁ ప్రేమించును",
        "శక్తిలేనివారము బలవంతుఁ డేసుఁడు."
      ],
      "english": [
        "Baaluramau Mammunu Baagugaa Praeminchunu",
        "Shakthilaenivaaramu Balavanthu Daesudu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బుద్ధిలేని వారికిఁ తాను బోధపర్చును",
        "శుద్ధిలేని వారిని శుద్ధిఁ జేసి ప్రోచును."
      ],
      "english": [
        "Budhdhilaeni Vaariki Thaanu Boadhaparchunu",
        "Shudhdhilaeni Vaarini Shudhdhi Jaesi Proachunu."
      ]
    }
  ]
}
