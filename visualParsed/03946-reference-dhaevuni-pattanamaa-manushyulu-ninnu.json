{
  "song_name": "Devuni pattanamaa manushyulu ninnu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవపట్నమా? సీయోను - నీ మహాత్య మాడితం",
        "ఆడితప్పనట్టివాడు - చేసే నిన్ స్వదేహము",
        "గుట్టమీద గట్టబడ్డ - నిన్ గదల్తు రెవ్వరు",
        "రక్షణంపు గోడలున్న - త్రుంచవచ్చు శత్రులన్"
      ],
      "english": [
        "Dhevapatnamaa? Seeyonu - Nee mahaathmya maaditham",
        "Aadithappanattivaadu - Chese nin swadhehamu",
        "Guttameedha gattabaddha - Nin gadhalthu revvaru",
        "Rakshanampu godalunna - Thrunchavachchu shathrulan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శాశ్వతంపు బ్రేమసూరు - జీవ వారి జూడుము",
        "వాంఛితంబు లిచ్చినీదు - లేములన్ని బాపును",
        "ఎప్డుపారునె రిటుండ - దప్పిగూరు నెవ్వడు",
        "నిత్యమా కృపాఝరంబు - క్రీస్తుదాత బోలు"
      ],
      "english": [
        "Shaashvathampu bremasooru - Jeeva vaari joodumu",
        "Vaanchhithambu lichchineedhu - Lemulanni baapunu",
        "Epdupaarune ritunda - Dhappigooru nevvadu",
        "Nithyamaa krupaajharambu - Kreesthudhaatha bolu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నే సీయోను వాసినైతి - నేని క్రీస్తు సత్కృపన్",
        "బాడుకొందు నీదు ప్రేమ - భూమి గేళిచేసినన్",
        "ఐహికంబు సుఖంబు - లన్నియు యస్తిరంబులు",
        "నిత్యసౌఖ్యమిచ్చు స్వాస్థ్యమే - సీయోను బిడ్డలు ఆమెన్"
      ],
      "english": [
        "Ne Seeyonu vaasinaithi - Neni Kreesthu sathkrupan",
        "Baadukondhu needu prema - Bhoomi gelichesinan",
        "Aihikambu sukhambu - Lanniyu asthirambulu",
        "Nithyasaukhyamichchu swaasthyame - Seeyonu biddhalu aamen"
      ]
    }
  ]
}
