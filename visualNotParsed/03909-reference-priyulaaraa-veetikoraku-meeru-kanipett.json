  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓ సంఘమా శుభవార్త యిదే ప్రభుయేసు వచ్చుచుండె",
        "ఆయనను సంధింప త్వరపడుము సమయము గతించుచుండె",
        "చూడుమదే చూడుమదే నీ వరుడు వచ్చుచుండె",
        "నిన్ను కొనిపోవుటకు ప్రియుడేసు వచ్చుచుండె"
      ],
      "english": [
        "O sanghamaa shubhavaartha idhe Prabhuyesu vachchuchunde",
        "Aayananu sandhimpa thvarapadumu samayamu gathinchuchunde",
        "Choodumadhe choodumadhe nee varudu vachchuchunde",
        "Ninnu konipovutaku Priyudesu vachchuchunde"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకమున కేతెంచెను యేసు రక్తమును చిందించె",
        "కల్వరిలో క్రయమును చెల్లించి నిన్ను తానే కొనెను"
      ],
      "english": [
        "Lokamuna kethenchenu Yesu rakthamunu chindinche",
        "Kalvarilo krayamunu chellinchi ninnu thaane konenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఈ లోకమంతయు మోసమేగా కలుషముతో నిండె",
        "ఈ లోకము నీకు సత్రమేగా విడచిపోవలెనుగా"
      ],
      "english": [
        "Ee lokamanthayu mosamegaa kalushamutho ninde",
        "Ee lokamu neeku sathramegaa vidachipovalenugaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జరుగును వెయ్యేండ్ల పాలన ప్రభు వచ్చినప్పుడు",
        "తరుణమునందు శుద్ధి పొందినచో కరుణను గాంచలేవు"
      ],
      "english": [
        "Jarugunu veyyendla paalana Prabhu vachchinappudu",
        "Tharunamunandhu shuddhi pondhinacho karununu gaanchalevu"
      ]
    }
  ]
}
