{
  "song_name": "Nenaithe nee krupayandhu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నేనైతే నీ కృపయందు నమ్మికయుంచియున్నాను",
      "న బలహీనతను బలముగా మార్చే దేవుడవు",
      "నీ వాక్యమే నా జీవితాన్ని బలముగా మార్చింది",
      "నీ సన్నిధిలో నిత్యమూ నే నిలబడుచున్నాను"
    ],
    "english": [
      "Nenaithe nee krupayandhu nammikayunchiyunnaanu",
      "Naa balaheenathanu balamugaa maarche Devudavu",
      "Nee vaakyame naa jeevithaanni balamugaa maarchindi",
      "Nee sannidhilo nithyamoo ne nilabaduchunnaanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నేనేమైయున్నగాని నీ కొరకే జీవింతున్",
        "నా స్థితిఏదైనాగాని నిన్నే ప్రకటింతున్ || 2  ||నేనైతే||"
      ],
      "english": [
        "Nenemaiyunnagaani nee korake jeevinthun",
        "Naa sthithi edhainaagaani ninne prakatinthun || 2  ||Nenaithe||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        ": దావీదును రాజుగా నీవే చేసావు",
        "భూరాజులలో గానుడిగా స్థిరపరిచావు",
        "మోషేను జనములకు దిక్సూచిగా చేసితివి",
        "రాజుల మధ్యన మహిమతో నీవే నిలిపితివి",
        "ఎలా వర్ణింతునయ్య నీ ప్రేమను",
        "ఏమని వివరింతు నయ్యా నీ త్యాగము ॥2  ||నేనైతే||"
      ],
      "english": [
        ": Dhaaveedhunu raajugaa neeve chesaavu",
        "Bhooraajulalo ghanudigaa sthiraparichaavu",
        "Moshenu janamulaku dhiksoochigaa chesithivi",
        "Raajula madhyana mahimatho neeve nilipithivi",
        "Elaa varninthunayya nee premanu",
        "Emani vivarinthu nayyaa nee thyaagamu ॥2  ||Nenaithe||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        ": శాశ్వతమైన ప్రేమతో నను ప్రేమించితివి",
        "నిరీక్షణనిచ్చి నాకు ఆశ్రయమిచ్చితివి",
        "పాపభారము తొలగించి శుద్ధునిగా చేసితివి",
        "నీ దరికి నను పిలచి నిత్యజీవమునిచ్చితివి"
      ],
      "english": [
        ": Shaashwathamaina prematho nanu preminchithivi",
        "Nireekshananichchi naaku aashrayamichchithivi",
        "Paapabhaaramu tholaginchi shuddhunigaa chesithivi",
        "Nee dariki nanu pilachi nithyajeevamunichchithivi"
      ]
    }
  ]
