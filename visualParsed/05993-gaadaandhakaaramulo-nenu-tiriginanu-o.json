  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చ1: ఎన్నెన్నో ఆపదలు నన్ను చుట్టినను",
        "నిన్ను తలచినచో నన్ను విడనాడు (2)",
        "అన్ని కాలముల నిన్నే స్మరియింతు",
        "ఎన్నరానివయా నీకున్న సుగుణములు  ||గాడాధకారములొ||"
      ],
      "english": [
        "Cha1: Ennenno aapadhalu nannu chuttinanu",
        "Ninnu thalachinacho nannu vidanaadu (2)",
        "Anni kaalamula ninne smariyinthu",
        "Ennaraanivayaa neekunna sugunamulu ||Gaadaandhakaaramulo||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చ2: నాకున్న మనుజులెల్ల నన్ను విడచినను",
        "నా దేవ ఎపుడయిన నన్ను విడచితివా (2)",
        "నా హృదయ కమలమున నిను నేను నిలిపెదను",
        "నీ పాద కమలమున నా దేవ కొలిచెదను  ||గాడాధకారములొ||"
      ],
      "english": [
        "Cha2: Naakunna manujulella nannu vidachinanu",
        "Naa Deva epudayina nannu vidachithivaa (2)",
        "Naa hrudaya kamalamuna ninu nenu nilipedhanu",
        "Nee paada kamalamuna naa Deva kolichedanu ||Gaadaandhakaaramulo||"
      ]
    }
  ]
