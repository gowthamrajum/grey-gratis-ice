{
  "song_name": "Saathveekudaa deenulanu karuninche",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "సాత్వీకుడా దీనులను కరుణించే నా యేసయ్య",
      "సమ్మతి కలిగిన మనస్సుతో నిమ్మళముగా నేను బ్రతుకుటకు",
      "సమృద్ది అయిన కృపతో నింపుము",
      "నిత్యము నీ సన్నిధిలో నన్ను నిలుపుము"
    ],
    "english": [
      "Saathveekudaa deenulanu karuninche naa Yesayya",
      "Sammathi kaligina manassutho nimmalamugaa nenu brathukutaku",
      "Samruddhi ayina krupatho nimpumu",
      "Nithyamu nee sannidhilo nannu nilupumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈర్షా ద్వేషాలతో పాడైన పుడమిపై",
        "నిలువ నీడ కరువై శిలువపై ఒంటరయ్యావు",
        "అల్పకాల శ్రమలకే అలసిన నా హృదయములో",
        "సహనము కలిగించి నడుపుము నను తుది వరకు"
      ],
      "english": [
        "Eershaa dhweshaalatho paadaina pudamipai",
        "Niluva needa karuvai shiluvapai ontarayyaavu",
        "Alpakaala shramalake alasina naa hrudayamulo",
        "Sahanamu kaliginchi nadupumu nanu thudi varaku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కలతల కెరటాలలో నా తోడుగా నిలిచావు",
        "ఉప్పొంగిన సంద్రమే నిమ్మలమై మౌనమూనింది",
        "గుండెలో నిండిన స్తుతి నొందే పూజ్యుడా",
        "మమకారపు గుడిలో నిన్నే కొలిచెదనయ్య"
      ],
      "english": [
        "Kalathala kerataalalo naa thodugaa nilichaavu",
        "Uppongina sandhrame nimmalamai maunamoonindhi",
        "Gundelo nindina sthuthi nondhe poojyudaa",
        "Mamakaarapu gudilo ninne kolichedhanayya"
      ]
    }
  ]
}
