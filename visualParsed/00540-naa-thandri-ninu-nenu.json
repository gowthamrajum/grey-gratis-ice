      ],
      "english": [
        "Ghanudaa ninu battiye naaku ee sthaanam",
        "Emundi naalo nanu aasheervadhinchutaku",
        "Naakevvaru leru ilalo neeve naa aashrayam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
