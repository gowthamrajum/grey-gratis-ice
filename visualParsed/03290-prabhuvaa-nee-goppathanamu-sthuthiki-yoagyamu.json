{
  "song_name": "Prabhuvaa nee goppathanamu sthuthiki yogyamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నీ గొప్పతనము - స్తుతికి యోగ్యము",
      "అశక్యమైనది - వర్ణించలేమిల"
    ],
    "english": [
      "Prabhuvaa nee goppathanamu - Sthuthiki yogyamu",
      "Ashakyamainadhi - Varninchalemila"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సృష్టి గొప్పది అద్భుతమేగా - సంకల్పమెంతో వుత్తమము",
        "మానవజాతి కొరకై ప్రభూ - సిద్దపరచె సమస్తము",
        "నీదు పనులు నీ సామర్ధ్యము వర్ణించలేమిల"
      ],
      "english": [
        "Srushti goppadi adbhuthamegaa - Sankalpamentho vutthamamu",
        "Maanavajaathi korakai Prabhoo - Siddhaparache samasthamu",
        "Needu panulu nee saamardhyamu varninchalemila"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ రూపమున నరుని సృజించి - అధికారము నిచ్చితివి",
        "క్రీస్తునందు నిర్దోషినిగా - నిలువబెట్ట గోరితివి",
        "నీదు దయ నీ మంచితనము వర్ణించలేమిల"
      ],
      "english": [
        "Nee roopamuna naruni srujinchi - Adhikaaramu nichchithivi",
        "Kreesthunandu nirdhoshinigaa - Niluvabetta gorithivi",
        "Needu daya nee manchithanamu varninchalemila"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సృష్టిని చేసిన శక్తికంటె - పాపికి రక్షణ గొప్పది",
        "నీ యొద్ద నున్న సర్వమిచ్చి - విలువగు ముత్యము కొన్నావు",
        "నీ ఐశ్వర్యము నీ మహిమను వర్ణించలేమిల"
      ],
      "english": [
        "Srushtini chesina shakthikante - Paapiki rakshana goppadi",
        "Nee yodda nunna sarvamichchi - Viluvagu muthyamu konnaavu",
        "Nee aishwaryamu nee mahimanu varninchalemila"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీకు మానవుడమూల్యము - నీవు ప్రేమించుచున్నావు",
        "అందుకే నీ ప్రాణమర్పించి - రక్తము కార్చి రక్షించితివి",
        "నీ అద్భుత ప్రేమ నీ కృప వర్ణించలేమిల"
      ],
      "english": [
        "Neeku maanavudamoolyamu - Neevu preminchuchunnaavu",
        "Anduke nee praanamarpinchi - Rakthamu kaarchi rakshinchithivi",
        "Nee adbhutha prema nee krupa varninchalemila"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అద్భుతమైన నూతన సృష్టి - మానవునికి నిచ్చితివి",
        "రాజులనుగ యాజకులుగ వారసులుగను చేసితివి",
        "నీ రాజ్యము నీ ప్రభావము వర్ణించలేమిల"
      ],
      "english": [
        "Adbhuthamaina noothana srushti - Maanavuniki nichchithivi",
        "Raajulanuga yaajakuluga vaarasuluganu chesithivi",
        "Nee raajyamu nee prabhaavamu varninchalemila"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఉల్లాసముతో సృష్టి మైమరచే - అద్భుత కార్యములను చూచి",
        "సంతోషించి ఆరాధించిరి - నీవే సర్వమని చెప్పిరి",
        "నీ ప్రభుత్వము నీదు సత్యము వర్ణించలేమిల"
      ],
      "english": [
        "Ullaasamutho srushti maimarache - Adbhutha kaaryamulanu choochi",
        "Santhoshinchi aaraadhinchiri - Neeve sarvamani cheppiri",
        "Nee prabhuthvamu needu sathyamu varninchalemila"
      ]
    }
  ]
}
