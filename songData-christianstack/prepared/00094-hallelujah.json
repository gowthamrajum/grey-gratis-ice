  "main_stanza": {
    "telugu": [
      "ఉదయము రాత్రియు హల్లెలుయా",
      "నా ప్రతి శ్వాసయు హల్లెలుయా",
      "నే సొమ్మసిల్లు వేళ నా బలముగా మారున్",
      "నే సోలిపోవు వేళ నా ఆత్మ పాడు పాట"
    ],
    "english": [
      "Udayamu Rathriyu Hallelujah",
      "Naa prathi Swasayu Hallelujah",
      "Ne sommasillu vela Naa balamuga marun",
      "Ne solipovu vela Naa athma padu pata"
    ]
  },
  "stanzas": [
    {
