{
  "song_name": "Apathkaalamandu Yehova",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "అపత్కాలమందు యెహెూవా నీకు ఉత్తరమిచ్చును",
      "యాకోబు దేవుని నామమే నిన్ను ఉద్దరించును"
    ],
    "english": [
      "Apathkaalamandu Yehova neeku uttharamichchunu",
      "Yaakobu Devuni naamame ninnu uddharinchunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరిశుద్ధ స్థలమునుండి నీకు సమయము చేయును",
        "సీయోనులో నుండి నిను నిత్యము ఆదుకొనును (2)",
        "నీ నైవేద్యములన్నీ జ్ఞాపకము చేసుకొనును",
        "నీ దహన బలులన్నీ ఆయన అంగీకరించును (2)"
      ],
      "english": [
        "Parishuddha sthalamunundi neeku sahaayamu cheyunu",
        "Seeyonulo nundi ninu nithyamu aadhukonunu (2)",
        "Nee naivedhyamulannee gnaapakamu chesukonunu",
        "Nee dhahana balulannee aayana angeekarinchunu (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ కోరికను సఫలపరచి నీ ఆలోచన నెరవేర్చును",
        "తన దక్షిన హస్తబలమే నిను నిత్యము ఆదుకొనును (2)",
        "దురభిమాన పాపమునుండి నిన్ను తప్పించును",
        "దేవునియందు భయమే నిన్ను పవిత్ర పరచును (2)"
      ],
      "english": [
        "Nee korikanu saphalaparachi nee aalochana neraverchunu",
        "Thana dakshina hasthabalame ninu nithyamu aadhukonunu (2)",
        "Dhurabhimaana paapamunundi ninnu thappinchunu",
        "Devuniyandu bhayame ninnu pavithra parachunu (2)"
      ]
    }
  ]
}
