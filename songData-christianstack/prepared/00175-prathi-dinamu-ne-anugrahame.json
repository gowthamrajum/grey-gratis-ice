{
  "song_name": "Prathi Dinamu Ne Anugrahame",
  "author": {
    "Authored by": "Pastor Moses Dayakar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రతిదినము నీ అనుగ్రహమే – ఈ జీవితం నీదాయ్య",
      "నాదంటూ ఏమి లేదయ్య"
    ],
    "english": [
      "Prathidhinamu nee anugrahamea",
      "Ee jeevitham needhayya",
      "Naadantuu emi ledayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ పాపి క్షేమంకై ఆ ప్రాణ త్యాగమా",
        "నీ ప్రేమ చాలు నాకు తీరని ఓ రుణమా..",
        "ఈ జీవితం నీవయ్యా నాదంటూ ఏమి లేదయ్య…"
      ],
      "english": [
        "Ee paapi kshemankai",
        "Aa praana thyaagama",
        "Nee prema chaalu naaku",
        "Theerani o runamaa",
        "Ee jeevitham neevayya",
        "Naadhantuu emi ledhayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తీరమే దూరమై – భారమే చేరువై",
        "మమతాలే మాయమై – మౌనమే స్నేహనైనా"
      ],
      "english": [
        "Theeramea dhooramai",
        "Bhaaramea cheruvai",
        "Mamathaalea maayamai",
        "Mounamea snehanaaina"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాతోడు నీవైన్నావు",
        "కేడెమై నడిపించావు…",
        "ఈ జీవితం నీదాయ్య",
        "నాదంటూ ఏమి లేదయ్య.."
      ],
      "english": [
        "Na thodu neevainnaavu",
        "Kedemai nadipinchaavu",
        "Ee jeevitham needhayya",
        "Naadhantuu emi ledhayya"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యోగ్యతే లేని నాపై – భాద్యతను చూపావు",
        "శ్రమలందు చేయి విడువక – శ్రద్దగా నను దాచావు"
      ],
      "english": [
        "Yogyathe leni naapai",
        "Bhaadhyathanu choopaavu",
        "Shramalandhu cheyi viduvaka",
        "Shraddhaga nanu dhaachaavu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వేచియున్న కన్నీటికి",
        "దాచియున్న దీవెనలొసగే",
        "నా కన్న తండ్రి నీవయ్య..",
        "నీవుంటే కొడువే లేదయ్య…"
      ],
      "english": [
        "Vechiyunna kanneetiki",
        "Dhaachiyunna dheevenalosagea",
        "Naa kanna thandri neevayya",
        "Neevuntae kodhuve ledhayya"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రళయమంటి శత్రుమూఖలు – చుట్టి నన్ను ఆవరించాగా",
        "స్థిరము అనుకున్న ఆప్తులు – కరము విడిచి నన్ను త్రోయగా"
      ],
      "english": [
        "Pralayamanti shathrumukhulu",
        "Chutti nannu aavarinchaga",
        "Sthiramu anukunna aapthulu",
        "Karamu vidichi nannu throyaga"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీవు కలుగజేసుకున్నావు..",
        "దారి చూపి నెమ్మదినిచ్చావు..",
        "ఏ ప్రేమ సరిరాదయ్య..",
        "నీ సాక్షిని నేనే యేసయ్య…"
      ],
      "english": [
        "Neevu kalugajeasukunnaavu",
        "Dhaari choopi nemmadhinichhavu",
        "Ee prema sariradhayya",
        "Nee saakshini neane Yesayya"
      ]
    }
  ]
}
