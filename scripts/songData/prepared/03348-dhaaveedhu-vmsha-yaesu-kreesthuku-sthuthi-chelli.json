{
  "song_name": "Dhaaveedhu Vamsha Yaesu Kreesthuku Sthuthi Chellinchudi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దావీదు వంశ యేసు క్రీస్తుకు - స్తుతి చెల్లించుడి",
      "స్వర్గస్తులమగుటకు మనలను విడిపించిన ప్రభువునకు",
      "హోసన్నా హోసన్నా - భువిలో సంతొషం"
    ],
    "english": [
      "Dhaaveedhu Vamsha Yaesu Kreesthuku - Sthuthi Chellinchudi",
      "Svargasthulamagutaku Manalanu Vidipinchina Prabhuvunaku",
      "Hoasannaa Hoasannaa - Bhuviloa Santhosham"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "మానుజావతారమున భువికి వచ్చి",
        "తన స్వంత జీవమును బలిగా యిచ్చి",
        "హోసన్నా యేసుని పేరట పరమును మనకొసగెన్"
      ],
      "english": [
        "Maanujaavathaaramuna Bhuviki Vachchi",
        "Thana Svantha Jeevamunu Baligaa Yichchi",
        "Hoasannaa Yaesuni Paerata Paramunu Manakosagen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రియ తండ్రీ ఈ భువిలో సకల మహిమయు నీకే",
        "సూర్య చంద్ర సృష్టియావత్తు స్తుతియించి మహిమపరచున్",
        "హోసన్నా హోసన్నా క్రొత్త యెరూషలేములో"
      ],
      "english": [
        "Priya Thandree Ee Bhuviloa Sakala Mahimayu Neekae",
        "Soorya Chandhra Srushtiyaavaththu Sthuthiyinchi Mahimaparachun",
        "Hoasannaa Hoasannaa Kroththa Yerooshalaemuloa"
      ]
    }
  ]
}
