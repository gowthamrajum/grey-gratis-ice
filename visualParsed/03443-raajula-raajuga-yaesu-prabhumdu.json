{
  "song_name": "Raajula raajuga Yesu prabhundu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రాజుల రాజుగ యేసు ప్రభుండు",
      "రయమున రానై యున్నాడు"
    ],
    "english": [
      "Raajula raajuga Yesu prabhundu",
      "Rayamuna raanai yunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్షణాలంకారముతో - తక్షణమే సిద్ధపడి",
        "అక్షయుడగు నా రక్షకుని - నిరీక్షణతో వేడండి"
      ],
      "english": [
        "Rakshanaalankaaramutho - Thakshaname siddhapadi",
        "Akshayudagu naa rakshakuni - Nireekshanatho vedandi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మన ప్రభు యేసుని రక్తము - మన పాపములను పోగొట్టి",
        "మన ప్రభురాకడ మనకెంతో - మహిమానదము కలిగించున్"
      ],
      "english": [
        "Mana prabhu Yesuni rakthamu - Mana paapamulanu pogotti",
        "Mana prabhuraakada manakentho - Mahimaanadhamu kaliginchun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మొదట గొఱ్ఱెపిల్ల వలె - నొదిగి వచ్చెను మన ప్రభువు",
        "కొదమసింహముగా వచ్చును - గుండెదిగులు పాపికి"
      ],
      "english": [
        "Modhata gorrepilla vale - Nodhigi vachchenu mana prabhuvu",
        "Kodhamasimhamugaa vachchunu - Gundedhigulu paapiki"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "గురుతులన్నియు జరుగుచుండ - సరిగా చూడుము విశ్వాసి",
        "త్వరపడుము నీ ప్రభుని జూడ - కరములెత్తి ప్రార్థించు"
      ],
      "english": [
        "Guruthulanniyu jaruguchunda - Sarigaa choodumu vishwaasi",
        "Thvarapadumu nee prabhuni jooda - Karamuletthi praarthinchu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఎల్లరు క్రీస్తుని రాకను - ఉల్లాసముతో కోరుచు",
        "హల్లెలూయ పాటలు పాడి - ఎల్లప్పుడు స్తుతియించెదము"
      ],
      "english": [
        "Ellaru Kreesthuni raakanu - Ullaasamutho koruchu",
        "Hallelooya paatalu paadi - Ellappudu sthuthiyinchedhamu"
      ]
    }
  ]
}
