{
  "song_name": "Raathrimbavallu paadedanu Yesu naamam Kreesthu naamam",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రాత్రింబవళ్లు పాడెదను",
      "యేసు నామం - క్రీస్తు నామం"
    ],
    "english": [
      "Raathrimbavallu paadedanu",
      "Yesu naamam - Kreesthu naamam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పురుగు వంటి నరుడ నాకు - ప్రభువు రాజ్య మియ్యదలచి",
        "పరమునుండి ధరకేతెంచి - ప్రాణమున్ బలిగా నిచ్చె"
      ],
      "english": [
        "Purugu vanti naruda naaku - Prabhuvu raajya miyyadhalachi",
        "Paramunundi dharakethenchi - Praanamun baligaa nichche"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎన్నిక లేని చిన్నమంద - భయపడకు నీవిలన్",
        "ఘనమైన పరమతండ్రి - రాజ్యమివ్వ నిష్టపడెన్"
      ],
      "english": [
        "Ennika leni chinnamandha - Bhayapadaku neevilan",
        "Ghanamaina paramathandri - Raajyamivva nishtapaden"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాప కూపమునందు నేను - పడి చెడి యుండగా",
        "గొప్ప రక్షణ నిచ్చి పరమ - రాజ్యమందు చేర్చెను"
      ],
      "english": [
        "Paapa koopamunandhu nenu - Padi chedi undagaa",
        "Goppa rakshana nichchi parama - Raajyamandu cherchenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీతి హేనుడనైన నాకు - నీతి రాజ్యమివ్వదలచి",
        "నీతి రక్షణ వస్త్రములను - ప్రీతి తోడ తొడిగెను"
      ],
      "english": [
        "Neethi henudanaina naaku - Neethi raajyamivvadhalachi",
        "Neethi rakshana vasthramulanu - Preethi thoda thodigenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పేరుపెట్టి పిలచినన్ను - పరమ రాజ్యమును తండ్రి",
        "వారసునిగా నన్ను జేసి - వైరినిల సిగ్గుపరచెన్"
      ],
      "english": [
        "Perupetti pilachinannu - Parama raajyamunu thandri",
        "Vaarasunigaa nannu jesi - Vairinila sigguparachen"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పరమందు దూతలు - వింత పొందునట్లుగా",
        "ఏర్పరచుకొంటివి నరుని - నరుడు ఏపాటి వాడు?"
      ],
      "english": [
        "Paramandu doothalu - Vintha pondhunatlugaa",
        "Erparachukontivi naruni - Narudu epaati vaadu?"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దానియేలు షద్రక్ మేషాక్ - అబెద్నెగో యనువారలన్",
        "చిన్నమందగా జేసి - రాజ్యమేల జేసెన్"
      ],
      "english": [
        "Daaniyelu Shadrak Meshaak - Abednego anuvaaralan",
        "Chinnamandhagaa jesi - Raajyamela jesen"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ఎన్ని శ్రమలు వచ్చినను - సన్నుతింతు నా ప్రభున్",
        "ఘనత మహిమ కర్హుడని - హల్లెలూయ పాడెదన్"
      ],
      "english": [
        "Enni shramalu vachchinanu - Sannuthinthu naa prabhun",
        "Ghanatha mahima karhudani - Halleluya paadedan"
      ]
    }
  ]
}
