{
  "song_name": "Kanipettuchuntini",
  "author": {
    "Authored by": "Bro. Augustine, M Ashok",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కనిపెట్టుచుంటిని.. ప్రభువా నీ సన్నిధినీ….",
      "నిన్ను ఆశ్రయించితినీ .. శరణము నీవనీ…",
      "దాసి కన్నులు చుస్తున్నట్లుగా",
      "నా కన్నులు నిన్ను చూచుచుండగా",
      "దాసుడు ఆశతో నిలుచునట్లుగా",
      "నీ యెదుట నేను నిలచి యుంటిని …"
    ],
    "english": [
      "Kanipettuchuntini.. prabhuvaa nee sannidhini",
      "ninnu aasrayinchithini.. saranam neevani",
      "dhaasi kannulu choosthunnatlugaa",
      "naa kannulu ninnu choochuchundagaa",
      "dhaasudu aasatho niluchunatlugaa",
      "nee yedhuta nenu nilachiyuntini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా కన్నీరు కాదనకూ…నన్నుచూడు ఈ క్షణం",
        "నీ ఎన్నికను కృప నిలుపూ కీడు నుండి తప్పించూ"
      ],
      "english": [
        "Naa kanneeru kaadhanaku.. nannu choochu ee kshanam",
        "nee ennikanu krupa nilupu keedu nundi thappinchu"
      ]
    }
  ]
}
