    {
      "stanza_number": 8,
      "telugu": [
        "దొంగతనము వ్యభిచారమునకు లొంగి శాపగ్రస్తులునై",
        "దొంగిలించిన దశమభాగమే లొంగుట కారణమని తుదకు ||దొ||"
      ],
      "english": [
        "Dhongathanamu vyabhichaaramunaku longi shaapagrasthulunai",
        "Dhongilinchina dhashamabhaagame longuta kaaranamani thudaku ||Dho||"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "కొంతయిచ్చిన దశభాగ మంత యిదియని తప్పుకున్న",
        "కొంతయిచ్చిన కయీనువలె కొంతయిచ్చిన అననియవలె ||దొ||"
      ],
      "english": [
        "Konthayichchina dhashabhaaga mantha idhiyani thappukunna",
        "Konthayichchina Kayeenuvale konthayichchina Ananiyavale ||Dho||"
