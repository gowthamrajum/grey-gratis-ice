{
  "song_name": "Yehovaaye aashcharya kaaryamulanu chesiyunnaadu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యెహోవాయే ఆశ్చర్య కార్యములను చేసియున్నాడు",
      "మేలుతో నీహృదయమును - తృప్తిపరచుచున్నాడు"
    ],
    "english": [
      "Yehovaaye aashcharya kaaryamulanu chesiyunnaadu",
      "Melutho neehrudhayamunu - Thrupthiparachuchunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవా నీదు కృపతో - నన్ను కరుణింపుము",
        "నీ వాత్సల్యతతో నా - గత పతనంబుల క్షమియించు"
      ],
      "english": [
        "Deva needu krupatho - Nannu karuninpumu",
        "Nee vaathsalyathatho naa - Gatha pathanambula kshamiyinchu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకాశమున నుండి కలిగిన - దర్శనమునకు",
        "నే నవిధేయుడను కాను - నా దేవా జూపుము కృపను"
      ],
      "english": [
        "Aakaashamuna nundi kaligina - Dharshanamunaku",
        "Ne navidheyudanu kaanu - Naa Deva joopumu krupanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బాధించు శత్రువు నన్ను - బలముగ బాధించినను",
        "నే ధైర్యము విడువను - నను బలపరచుము నీలోన"
      ],
      "english": [
        "Baadhinchu shathruvu nannu - Balamuga baadhinchinanu",
        "Ne dhairyamu viduvanu - Nanu balaparachumu neelona"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రతిచోట నీ సాక్షిగా - ప్రభువా నేనుండెద నిలలో",
        "పావనమగు నీ యాత్మన్ - ప్రాపుగ నొసగుము నీదయతో"
      ],
      "english": [
        "Prathichota nee saakshigaa - Prabhuvaa nenundeda nilalo",
        "Paavanamagu nee yaathman - Praapuga nosagumu needhayatho"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రభుయేసు నామమిలలో - ప్రాకటముగ నే బ్రకటింతు",
        "ప్రత్యక్షముగ నీ శక్తిన్ - ప్రసాదించుము నాకిలలో"
      ],
      "english": [
        "Prabhuyesu naamamilalo - Praakatamuga ne prakatinthu",
        "Prathyakshamuga nee shakthin - Prasaadinchumu naakilalo"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీయందు నేను నిలిచి - నిత్యము నే ఫలియింతున్",
        "సత్యాత్ముడా నాకిమ్ము - నిత్యముగను నీ జీవం"
      ],
      "english": [
        "Neeyandhu nenu nilichi - Nithyamu ne phaliyinthun",
        "Sathyaathmudaa naakimmu - Nithyamuganu nee jeevam"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆత్మాగ్ని చేత దేవా - అజ్ఞానుండగు నను నింపు",
        "నీ జ్ఞానము నాకిమ్ము - సుజ్ఞానుండా హల్లెలూయా"
      ],
      "english": [
        "Aathmaagni chetha Deva - Ajnaanundagu nanu nimpu",
        "Nee jnaanamu naakimmu - Sujnaanundaa halleluyaa"
      ]
    }
  ]
}
