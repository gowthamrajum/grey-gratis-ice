      "Rakshimpabaduchunna manaku Devuni shakthee",
      "Vinumaa o priyaa janamaa",
      "Kanugonumaa Kreesthu prema shakthee ॥Siluvanu॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
