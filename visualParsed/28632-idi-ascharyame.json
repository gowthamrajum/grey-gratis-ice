{
  "song_name": "Idhi aashcharyame",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Ps Philip Gariki"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కాలం సంపూర్ణమైనపుడు యేసయ్య భువికొచ్చెను",
      "తానే మనలను ప్రేమించి రక్షకుడై జన్మించెను",
      "రాజాధి రాజైనను ఇలలో దాసునిగా జీవించెను",
      "సత్యమును స్థాపించుటకు దైవసుతునిగా ఉదయించెను",
      "ఇది ఆశ్చర్యమే - ఇది అద్భుతమే",
      "ఆహా ఆనందమే - హాపీ హ్యాపీ క్రిస్మస్",
      "ఇది ఆశ్చర్యమే - ఇది అద్భుతమే...",
      "ఆహా ఆనందమే - మెర్రి మెర్రి క్రిస్మస్"
    ],
    "english": [
      "Kaalam sampoornamainapudu Yesayya bhuvikochchenu",
      "Thaane manalanu preminchi rakshakudai janminchenu",
      "Raajaadhi raajainanu ilalo dhaasunigaa jeevinchenu",
      "Sathyamunu sthaapinchutaku dhaivasuthunigaa udayinchenu",
      "Idhi aashcharyame - Idhi adbhuthame",
      "Aahaa aanandame - Haapee hyaapee krismas",
      "Idhi aashcharyame - Idhi adbhuthame...",
      "Aahaa aanandame - Merri merri krismas"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జ్ఞానులు సాగిలపడిరి - మ్రొక్కిరి ప్రభువుల ప్రభువును",
        "అటువలె విశ్వసించుచు - పూజించెదం ప్రభు యేసును",
        "సర్వోన్నతమైన స్థలములలోన - దేవదేవునికే మహిమ",
        "తనకిష్టులైన ప్రజలందరికి - భూమి మీద సమాధానము"
      ],
      "english": [
        "Gnaanulu saagilapadiri - Mrokkiri prabhuvula prabhuvunu",
        "Atuvale vishwasinchuchu - Poojinchedham Prabhu Yesunu",
        "Sarvonnathamaina sthalamulalona - Dhevadhevunike mahima",
        "Thanakishtulaina prajalandhariki - Bhoomi meeda samaadhaanamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గొల్లలు దేవుని మాటను - గ్రహియించిరి దూత చెప్పగా",
        "విధేయతే మనకు ముఖ్యము - గ్రహియించుము దేవుని చిత్తము",
        "వాక్యమైన దేవుడు శరీరధారిగా - మన మధ్యలో నివసించెను",
        "నమ్మి విశ్వసించుము కలుగు నిత్యజీవము - యేసు క్రీస్తే లోకరక్షకుడు"
      ],
      "english": [
        "Gollalu Devuni maatanu - Grahiyinchiri dootha cheppagaa",
        "Vidheyathe manaku mukhyamu - Grahiyinchumu Devuni chitthamu",
        "Vaakyamaina Devudu shareeradhaarigaa - Mana madhyalo nivasinchenu",
        "Nammi vishwasinchumu kalugu nithyajeevamu - Yesu Kreesthe lokarakshakudu"
      ]
    }
  ]
}
