{
  "song_name": "Alasatapadda neevu dhevokthi vinu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "జాన్ మేసన్ నీ"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అలసటపడ్డ నీవు",
      "దేవోక్తి విను",
      "రా, నా యొద్ద, సు విశ్రాంతి",
      "పొందుము"
    ],
    "english": [
      "Alasatapadda neevu",
      "Dhevokthi vinu",
      "Raa, naa yodda, su vishraanthi",
      "Pondumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "నేను చూచు గుర్తు లేవి,",
        "వాని కుండునా?",
        "'ప్రక్కఁ గాలుసేతులందు",
        "గాయముల్'"
      ],
      "english": [
        "Nenu choochu gurthu levi,",
        "Vaani kundunaa?",
        "'Prakka gaalusethulandhu",
        "Gaayamul'"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రాజుఁబోలి కిరీటంబు",
        "వాని కుండునా",
        "'యుండుగాని ముండ్లచేత",
        "నల్లరి'"
      ],
      "english": [
        "Raajuboli kireetambu",
        "Vaani kundunaa",
        "'Yundugaani mundlachetha",
        "Nallari'"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నన్ను ఁ జేర్చుకొమ్మనంగఁ",
        "జేర్చుకొనునా?",
        "'ఔను లోకాంతంబు దాఁక",
        "చేర్చును'"
      ],
      "english": [
        "Nannu jerchukommanamga",
        "Jerchukonunaa?",
        "'Aunu lokaanthambu daaka",
        "Cherchunu'"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వాని వెంబడింతు నేని",
        "యేమి లాభము?",
        "'పాప దుఃఖ కష్టములు",
        "వచ్చును'"
      ],
      "english": [
        "Vaani vembadinthu neni",
        "Emi laabhamu?",
        "'Paapa duhkha kashtamulu",
        "Vachchunu'"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "చావుమట్టు కోర్తునేని",
        "ఏమి యిచ్చును?",
        "'సంతోషంబు సౌఖ్య మింక",
        "మోక్షము'"
      ],
      "english": [
        "Chaavumattu korthuneni",
        "Emi ichchunu?",
        "'Santhoshambu saukhya minka",
        "Mokshamu'"
      ]
    }
  ]
}
