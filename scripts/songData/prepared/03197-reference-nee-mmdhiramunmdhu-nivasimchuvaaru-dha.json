{
  "song_name": "Nee Mandhiramunandhu Nivasinchuvaaru Dhanyulu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సైన్యముల యెహోవా"
    ],
    "english": [
      "Sainyamula Yehoavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సైన్యముల కధిపతివగు యెహోవా",
        "నీ నివాసములు ఎంతో రమ్యములు"
      ],
      "english": [
        "Sainyamula Kadhipathivagu Yehoavaa",
        "Nee Nivaasamulu Enthoa Ramyamulu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవా మందిరము చూడవలెనని",
        "నా ప్రాణమెంతో ఆశతో సొమ్మసిల్లెను"
      ],
      "english": [
        "Yehoavaa Mandhiramu Choodavalenani",
        "Naa Praanamenthoa Aashathoa Sommasillenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవముగల దేవుని దర్శించ నా హృదయము",
        "నా శరీర మానంద కేక వేయుచున్నది"
      ],
      "english": [
        "Jeevamugala Dhaevuni Dharshincha Naa Hrudhayamu",
        "Naa Shareera Maanandha Kaeka Vaeyuchunnadhi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సైన్యముల యెహోవా నా రాజా నీ బలిపీఠమునొద్దనే",
        "పిచ్చుకలకు గూళ్ళు దొరికెను"
      ],
      "english": [
        "Sainyamula Yehoavaa Naa Raajaa Nee Balipeethamunodhdhanae",
        "Pichchukalaku Goollu Dhorikenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పిల్లలు పెట్టుటకు వానకోవెలకు",
        "గూటి స్థలము దొరికెను నా దేవా"
      ],
      "english": [
        "Pillalu Pettutaku Vaanakoavelaku",
        "Gooti Sthalamu Dhorikenu Naa Dhaevaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ మందిరములో నుండువారు ధన్యులు",
        "వారు నిత్యము నిన్ను సన్నుతించెదరు"
      ],
      "english": [
        "Nee Mandhiramuloa Nunduvaaru Dhanyulu",
        "Vaaru Nithyamu Ninnu Sannuthinchedharu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీవలన బలము నొందు వారు ధన్యులు",
        "యాత్ర మార్గము లతి ప్రియములు వారికి"
      ],
      "english": [
        "Neevalana Balamu Nondhu Vaaru Dhanyulu",
        "Yaathra Maargamu Lathi Priyamulu Vaariki"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "వారు బాకా లోయలోబడి వెళ్లుచు",
        "దానిని జలమయముగా చేయుదురు"
      ],
      "english": [
        "Vaaru Baakaa Loayaloabadi Velluchu",
        "Dhaanini Jalamayamugaa Chaeyudhuru"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "తొలకరి వాన దాని దీవెనలతో కప్పును",
        "వారు బలాభివృద్ధి నొందుచు వెళ్ళుదురు"
      ],
      "english": [
        "Tholakari Vaana Dhaani Dheevenalathoa Kappunu",
        "Vaaru Balaabhivrudhdhi Nondhuchu Velludhuru"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "వారిలో ప్రతివాడు సీయోనులోని",
        "దేవుని సన్నిధిలో కనబడును"
      ],
      "english": [
        "Vaariloa Prathivaadu Seeyoanuloani",
        "Dhaevuni Sannidhiloa Kanabadunu"
      ]
    }
  ]
}
