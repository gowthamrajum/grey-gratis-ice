{
  "song_name": "Padhivaelaloa Priyuni Choochi Thelisikontivaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పదివేలలో ప్రియుని - చూచి తెలిసికొంటివా?",
      "నీ హృదయము పట్టుకొన్న - వాని కోరుకొనుము"
    ],
    "english": [
      "Padhivaelaloa Priyuni - Choochi Thelisikontivaa?",
      "Nee Hrudhayamu Pattukonna - Vaani Koarukonumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "విగ్రహము లాకర్షంచెన్ - లోక యాశలు నిను",
        "పాప క్రియలు మెరయుచు - నిన్ను విడనాడవు"
      ],
      "english": [
        "Vigrahamu Laakarshanchen - Loaka Yaashalu Ninu",
        "Paapa Kriyalu Merayuchu - Ninnu Vidanaadavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విగ్రహములకు దృష్టి - లేక లేదు అందము",
        "మంచి చెడ్డ తెలియదు - అందుచేత వ్యర్థము"
      ],
      "english": [
        "Vigrahamulaku Dhrushti - Laeka Laedhu Andhamu",
        "Manchi Chedda Theliyadhu - Andhuchaetha Vyarthamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వాని పగుల గొట్టుటచే - వాని నుండి తొల్గదు",
        "యేసు అందము కిరణ - మాయన హృదయమే"
      ],
      "english": [
        "Vaani Pagula Gottutachae - Vaani Nundi Tholgadhu",
        "Yaesu Andhamu Kirana - Maayana Hrudhayamae"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వాని వత్తినార్పువాడు - ఎవరో తెలియునా?",
        "చలికాలమును వేస-విగ మార్చు ప్రభువే"
      ],
      "english": [
        "Vaani Vaththinaarpuvaadu - Evaroa Theliyunaa?",
        "Chalikaalamunu Vaesa-Viga Maarchu Prabhuvae"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పేతురును మార్చిన చూపు - స్తెఫన్ చూచిన ముఖము",
        "మరియతో నేడ్చిన హృదయం - మాత్రం ఆకర్షించెన్"
      ],
      "english": [
        "Paethurunu Maarchina Choopu - Sthephan Choochina Mukhamu",
        "Mariyathoa Naedchina Hrudhayam - Maathram Aakarshinchen"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆకర్షించి నిండ చేయున్ - గిన్నెనిండ పొర్లగ",
        "విగ్రహములు మాకు వద్దు - యేసుతో మేముందుము"
      ],
      "english": [
        "Aakarshinchi Ninda Chaeyun - Ginneninda Porlaga",
        "Vigrahamulu Maaku Vadhdhu - Yaesuthoa Maemundhumu"
      ]
    }
  ]
}
