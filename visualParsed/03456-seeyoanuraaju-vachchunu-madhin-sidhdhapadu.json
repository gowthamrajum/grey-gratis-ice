      ],
      "english": [
        "Lokasthulu prashninthuru mari mee raaju evarani",
        "Thana shakthini vinnavaaru chooda naashinthurugaa",
        "Kreesthe mana raaraajani uthsahinchedhamu"
      ]
    },
    {
      "stanza_number": 2,
