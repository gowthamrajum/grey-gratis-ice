{
  "song_name": "Dhraakshaavallini Naenu Dhraakshaatheegelu Meeru",
  "author": {
    "Authored by": "",
    "రచన": "ఎం జే  రామాంజులు"
  },
  "main_stanza": {
    "telugu": [
      "ద్రాక్షావల్లిని నేను ద్రాక్షాతీగెలు మీరు",
      "అక్షయు డేసిటు బలికె అతిముదమునను వినరండి"
    ],
    "english": [
      "Dhraakshaavallini Naenu Dhraakshaatheegelu Meeru",
      "Akshayu Daesitu Balike Athimudhamunanu Vinarandi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాయందుండని తీగె నాశనమొందును నిజము",
        "నాశనమొందక మీరు నాయందుండుడి ఫలియింపన్"
      ],
      "english": [
        "Naayandhundani Theege Naashanamondhunu Nijamu",
        "Naashanamondhaka Meeru Naayandhundudi Phaliyimpan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఫలముల నివ్వని తీగె పనికిరాదని నరికి",
        "పారవేయంబడును నిరతము తధ్యము నిప్పులలో"
      ],
      "english": [
        "Phalamula Nivvani Theege Panikiraadhani Nariki",
        "Paaravaeyambadunu Nirathamu Thadhyamu Nippulaloa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఫలించు ప్రతి తీగె ఫలముల పెక్కుగ నివ్వన్",
        "పరిశుద్ధి చేయబడున్ యెఱుగరే మీరది అనవరతం"
      ],
      "english": [
        "Phalinchu Prathi Theege Phalamula Pekkuga Nivvan",
        "Parishuddhi Chaeyabadun Yerugarae Meeradhi Anavaratham"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాయందుండినగాని నయమగు కాపుండదిలన్",
        "నాయందుండిన వాడు నాణ్యపు ఫలములనిచ్చు నాహా"
      ],
      "english": [
        "Naayandhundinagaani Nayamagu Kaapundadhilan",
        "Naayandhundina Vaadu Naanyapu Phalamulanichchu Naahaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మీరు యేదియు చేయ లేరు నాకు వేరై",
        "వేరుగ మీరుండినచో వెంటనే యెండిపోయెదరు"
      ],
      "english": [
        "Meeru Yaedhiyu Chaeya Laeru Naaku Vaerai",
        "Vaeruga Meerundinachoa Ventanae Yendipoayedharu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కాన యేసుని యందు మానకనుందుము స్వేచ్ఛన్",
        "మాన్యుడేసుని పలుకుల్ మదిదలచెద మిల మరువకను"
      ],
      "english": [
        "Kaana Yaesuni Yandhu Maanakanundhumu Svechchan",
        "Maanyudaesuni Palukul Madhidhalachedha Mila Maruvakanu"
      ]
    }
  ]
}
