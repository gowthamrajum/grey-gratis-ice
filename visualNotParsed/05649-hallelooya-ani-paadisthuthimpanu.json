        "పూజించి పూజించి పాటించి చాటించరారె ||హల్లే||"
      ],
      "english": [
        "Paadipantalanichchi paalinchu devudani",
        "Kooduguddanichchi poshinchu devudani",
        "Thodu needaga ninnu kaapaadu naathudani",
        "Poojinchi poojinchi paatinchi chaatincharaare ||Halle||"
      ]
    },
    {
      "stanza_number": 2,
