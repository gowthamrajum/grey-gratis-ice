{
  "song_name": "Evaru Cheyagalarayya",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఎవరు చేయగలరయ్య నీలాంటి త్యాగము",
      "ఎవరు చూపగలరయ్య నీలాంటి ప్రేమను",
      "శాశ్వతమైనది అవధులు లేనిది",
      "అమరము అయినది అమూల్యమైనది",
      "నీ ప్రేమకై స్తోత్రము నీ కృపకై వందనము"
    ],
    "english": [
      "Evaru cheyagalarayya neelanti thyagamu",
      "Evaru chupagalarayya neelanti premanu",
      "Shashvathamainadhi avadhulu lenidhi",
      "Amaramainadhi amulyamainadhi",
      "Nee premakai sthothramu nee krupakai vandhanamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్ను దూషించిన వాడనయ్యా",
        "నీకు దూరమై పోతినయ్యా",
        "నిన్ను ద్వేషించిన వాడనయ్యా నీ దయను కోల్పోతినయ్యా",
        "అయిన నన్ను క్షమియించినావు కృపలోగిలిలో నన్ను దాచినావు",
        "నీ ప్రేమ ఎంతో ఉన్నతం"
      ],
      "english": [
        "Ninnu dushinchina vaadanayya neeku dhooramaipothinayya",
        "Ninnu dveshinchina vaadanayya nee dhayanu kolpothinayya",
        "Ayina nannu kshaminchinaavu krupaloo needaloo nanu dhachinaavu",
        "Nee prema entho unnatham"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపముతో నేనుండగా అంధకారమే కమ్మియుండగా",
        "వాక్యమనే వెలుగుతో నన్ను వెలిగించినావు యేసయ్యా",
        "వెలిగించుమా దివ్య జ్యోతిగా నడిపించుమా నీ సేవలో",
        "మరణము వరకు నాతో ఉండుమా"
      ],
      "english": [
        "Papamutho nenuandaga andhakaramay kammiyundaga",
        "Vakyamane velugutho nannu veliginchinaavu Yesayya",
        "Veliginchuma dhivya jyothiga nadipinchuma nee sevalo",
        "Maranamu varaku natho nunduma"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఓటి కుండనైనా నన్ను తృణీకరించి విసిరివేయక",
        "పనికిరాని వాడనైనా నీ పరిచర్యకు పిలిచావయ్యా",
        "శిల్పకారుడా నన్ను చెక్కుము నీ రూపముకే వచ్చేవరకు",
        "నీ స్వారూప్యము నాలో కలిగేవరకు"
      ],
      "english": [
        "Koti kundanaina nannu thrunikarinchu visiriveyaka",
        "Panikirani vaadanaina nee paricharyaku pilichavayya",
        "Shilpakaruda nannu chekkumu nee roopamu vacche varaku",
        "Nee svarupyamu naalo kalige varaku"
      ]
    }
  ]
}
