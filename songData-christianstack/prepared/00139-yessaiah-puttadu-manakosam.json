  },
  "main_stanza": {
    "telugu": [
      "రాజులకు రాజు పుట్టాడయ్యా",
      "ప్రభువుల ప్రభువు పుట్టాడయ్యా",
      "రారాజు యేసు పుట్టాడయ్యా",
