  "main_stanza": {
    "telugu": [
      "భజియింప రండి ప్రభుయేసుని",
      "ఆత్మసత్యములతో ప్రేమామయుని పరమ తండ్రిని"
    ],
    "english": [
      "Bhajiyimpa randi Prabhuyesuni",
      "Aathmasathyamulatho premaamayuni parama thandrini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాప క్షమాపణ మనకిచ్చెను",
        "మనల విమోచించె రక్తముతో",
