      "english": [
        "Adhuguvaatikante - Adhikamuga nichche",
        "Thana nibandhananu sthiraparachi - Thana vaakkulu neraverche",
        "Maata thappanivaadavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
