    {
      "stanza_number": 2,
      "telugu": [
        "నిత్యజీవం నిత్య శాంతి నిండు నెమ్మది",
        "నిత్యుండేసు మనకు నివ్వ మృత్యువున్ గెల్చెను"
      ],
      "english": [
        "Nithyajeevam nithya shaanthi nindu nemmadi",
        "Nithyundesu manaku nivva mruthyuvun gelchenu"
      ]
