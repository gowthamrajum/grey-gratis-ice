  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అద్యంతరహితుడవగు మా జ్యోతి",
        "మేదిని ప్రభూ నిన్ స్తుతింతుము - మేదిని",
        "నా దీన కాపరి నీతి కృపానిధి",
        "శుధ్ధ దివ్యగత్రుడా"
      ],
      "english": [
        "Adhyantharahithudavagu maa jyothi",
        "Medhini Prabhoo nin sthuthinthumu - Medhini",
        "Naa deena kaapari neethi krupaanidhi",
        "Shuddha dhivyagaathrudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మనోహరమగు నీ కృప పొందను",
        "మానవు లెల్లరము చేరితిమి - మానవు",
        "ఆత్మరూప కృపామయా నీ కరుణా",
        "వరముల మాకీయుమా"
      ],
      "english": [
        "Manoharamagu nee krupa pondhanu",
        "Maanavu lellaramu cherithimi - Maanavu",
        "Aathmaroopa krupaamayaa nee karunaa",
        "Varamula maakeeyumaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాలచే కడుగబడిన - ధవళాక్షుడా",
        "వళ్లిపూలయందు తిరుగువాడా - వళ్లి",
        "షాలేము రాజా షారోను రోజా",
        "శాంత భూపతివి నీవే"
      ],
      "english": [
        "Paalache kadugabadina - Dhavalaakshudaa",
        "Vallipoolayandhu thiruguvaadaa - Valli",
        "Shaalemu raajaa Shaaronu rojaa",
        "Shaantha bhoopathivi neeve"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "లక్షల దూతల స్తుతుల నందువాడా",
        "అక్షయ హేమమకుట ధారుడా - అక్షయ",
        "హేమ కిరీటధారులమై స్వర్గంబు",
        "చేర కడవరి వర్షమీ"
      ],
      "english": [
        "Lakshala doothala sthuthula nandhuvaadaa",
        "Akshaya hemamakuta dhaarudaa - Akshaya",
        "Hema kireetadhaarulamai swargambu",
        "Chera kadavari varshamee"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "క్రొత్త యెరూషలేం నగర రాజా",
        "రత్నాల పునాది వేసితివి - రత్నాల",
        "ధీరతతో నీ సాక్ష్యము చాటను",
        "స్థిరమగునాత్మ నిమ్ము"
      ],
      "english": [
        "Kroththa Yerooshalem nagara raajaa",
        "Rathnaala punaadi vesithivi - Rathnaala",
        "Dheerathatho nee saakshyamu chaatanu",
        "Sthiramagunaathma nimmu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "శ్రేష్ఠురాలా పావురమా నిరుపమాన",
        "ఇష్టంపురూప లావణ్యవతీ - ఇష్ట",
        "అట్లంచు పిల్చు దివ్య ధ్వనికి మమ్ము",
        "పాత్రులుగా చేయుమా"
