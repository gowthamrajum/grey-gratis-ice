{
  "song_name": "Reference: kaabatti neevu lechi, neevunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "లేచిరండి విశ్వాసులారా యోర్దాన్ నదిని దాటను",
      "విడిచి పెట్టుడి మిశ్రాయీం సుఖవిలాస మాయలన్"
    ],
    "english": [
      "Lechirandi vishvaasulaaraa Yordhaan nadini daatanu",
      "Vidichi pettudi Mishraayeem sukhavilaasa maayalan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సందేహించక లేశమైన - యేసుని వాగ్దానముల్",
        "ముందంజవేసి నిరాశ వీడి - ప్రభుపై నమ్మికయుంచుడి"
      ],
      "english": [
        "Sandhehinchaka leshamaina - Yesuni vaagdhaanamul",
        "Mundhanjavesi niraasha veedi - Prabhupai nammikayunchudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యాత్రలో సముద్రముల్ ఘోషించి పర్వతముల్ కంపించినన్",
        "సొదొమవైపు తిరిగి చూడక - వెళ్ళుడి - సీయోన్ నగరునకు"
      ],
      "english": [
        "Yaathralo samudhramul ghoshinchi parvathamul kampinchinan",
        "Sodhomavaipu thirigi choodaka - Velludi - Seeyon nagarunaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరికించుడి యేసుని కల్వరిలో కన్నులతో",
        "దూరపరచి బంధకముల నశింపజేసె మరణమున్"
      ],
      "english": [
        "Parikinchudi Yesuni Kalvarilo kannulatho",
        "Dhooraparachi bandhakamula nashimpajese maranamun"
      ]
    }
  ]
}
