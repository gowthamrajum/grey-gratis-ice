  "main_stanza": {
    "telugu": [
      "శరీరధారుని గ్రహింపజాలను",
      "శరీరధారుని వర్ణింపజాలను"
    ],
    "english": [
      "Shareera dhaaruni grahimpajaalanu",
      "Shareera dhaaruni varnimpajaalanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదియందు దేవుడు వాక్యమై యుండెను",
        "ఆ వాక్యమే దేవుడై యుండెను",
        "ఆదినున్న వాక్యము సర్వము సృజించెను",
        "ఆ వాక్యమే శరీరధారి ఆయెను"
      ],
      "english": [
        "Aadhiyandhu Dhevudu vaakyamai yundenu",
        "Aa vaakyame Dhevudai yundenu",
        "Aadhinunna vaakyamu sarvamu srujinchenu",
        "Aa vaakyame shareera dhaari aayenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "Pre-chorus",
        "దేవుడై యుండెను దాసునిగ మారెను",
