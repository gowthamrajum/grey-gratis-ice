  },
  "main_stanza": {
    "telugu": [
      "ప్రభు దయచేయు - నిత్య దీవెనలు బెరాకాలో చూతురు"
    ],
    "english": [
      "Prabhu dhayacheyu - nithya deevenalu Beraakaalo choothuru"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కీడు, యుద్ధము, తెగులు, కరువైనను",
        "దాడి చేయబూని విజృంభించి నపుడు",
        "నీవు మొరపెట్టిన నీకు దొరుకు - నిజముగా - రక్షణ"
      ],
      "english": [
        "Keedu, yudhdhamu, thegulu, karuvainanu",
        "Daadi cheyabooni vijrumbhinchi napudu",
        "Neevu morapettina neeku dhoruku - nijamugaa - rakshana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శత్రు శోధనలు పై బడినప్పుడు",
        "శక్తిహీనులమై పోయినప్పుడు",
        "క్రీస్తు దయచేయు నిత్యాదరణ - నిజముగా - చూతురు"
      ],
      "english": [
        "Shathru shodhanalu pai badinappudu",
