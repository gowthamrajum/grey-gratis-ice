    {
      "stanza_number": 1,
      "telugu": [
        "నమస్కరింప రండి - దావీదు పుత్రుని",
        "శ్రీ యేసు రక్షకుండు - ఏతెంచె నేలను",
        "న్యాయంబు లోకమందు - స్థాపించి నిత్యము",
        "అన్యాయమంత దాను - పోగొట్ట వచ్చెను"
      ],
      "english": [
        "Namaskarimpa randi - Daaveedu puthruni",
        "Sree Yesu rakshakundu - ethenche nelanu",
        "Nyaayambu lokamandu - sthaapinchi nithyamu",
        "Anyaayamantha dhaanu - pogotta vachchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వర్షంబు పడునట్లు - శుష్కించు నేలను",
        "దుఃఖించు వారికెల్ల - హర్షంబు నిచ్చును",
        "శ్రీ యేసు రాజ్యమందు సద్భక్తులందరు",
        "ఖర్జూర వృక్షరీతిన్ వర్థిల్లు చుందురు"
      ],
      "english": [
        "Varshambu padunatlu - shushkinchu nelanu",
        "Duhkhinchu vaarikella - harshambu nichchunu",
        "Sree Yesu raajyamandu sadbhakthulandharu",
        "Kharjoora vrukshareethin varthillu chundhuru"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దిగంత వాసులైన - భూరాజులందరు",
        "శ్రీ యేసు బుల్ నమస్కరింతురు",
        "భూలోకవాసులైన - జనంబులందరు",
        "క్రీస్తే స్వాధీనమందు జీవింతు రెప్పుడు"
      ],
      "english": [
        "Dhigantha vaasulaina - bhooraajulandharu",
        "Sree Yesu Prabhun namaskarinthuru",
        "Bhoolokavaasulaina - janambulandharu",
        "Kreesthe swaadheenamandhu jeevinthu reppudu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విరోధులైన వారిన్ - జయింప నెన్నడున్",
        "సింహాసనంబు మీద - నాసీనుడగును",
        "అత్యంత ప్రేమమూర్తి - శ్రీ యేసు ప్రభువు",
        "ఆ దివ్యనామ కీర్తి - వ్యాపించు నీ భువిన్"
      ],
      "english": [
        "Virodhulaina vaarin - jayimpa nennadun",
        "Simhaasanambu meeda - naaseenudagunu",
        "Athyantha premamoorthi - Sree Yesu Prabhuvu",
        "Aa dhivyanaama keerthi - vyaapinchu nee bhuvin"
      ]
