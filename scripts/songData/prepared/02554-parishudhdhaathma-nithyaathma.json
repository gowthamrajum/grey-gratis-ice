{
  "song_name": "Parishudhdhaathma Nithyaathma Parama Paavuramaa",
  "author": {
    "Authored by": "",
    "రచన": "బేతాళ జాన్"
  },
  "main_stanza": {
    "telugu": [
      "పరిశుద్ధాత్మ నిత్యాత్మ పరమ పావురమా",
      "దురతేచ్ఛలను దూర పరచు సత్యాత్మా"
    ],
    "english": [
      "Parishudhdhaathma Nithyaathma Parama Paavuramaa",
      "Dhurathaechchhalanu Dhoora Parachu Sathyaathmaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిత్యంపు వెల్గుచే నింపు జ్ఞానాత్మ",
        "సత్యంపు శుభ వార్త సంధించు నాత్మ"
      ],
      "english": [
        "Nithyampu Velguchae Nimpu Jnaanaathma",
        "Sathyampu Shubha Vaartha Sandhinchu Naathma"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జీవమార్గంబున జీవింప నేర్పి",
        "త్రోవఁ దప్పిన వారి భావంబు మార్చు"
      ],
      "english": [
        "Jeevamaargambuna Jeevimpa Naerpi",
        "Throava Dhappina Vaari Bhaavambu Maarchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపాంధకారంబుఁ బాపు నీ వెలుఁగుఁ జూపి",
        "మింటికి నడిపి కాపాడి మెలఁగు"
      ],
      "english": [
        "Paapaandhakaarambu Baapu Nee Velugu Joopi",
        "Mintiki Nadipi Kaapaadi Melagu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భక్తుఁడు శోధింపఁ బడుచుండునేని",
        "యుక్తిఁ దెల్పెడి సర్వ శక్తి నీదౌను"
      ],
      "english": [
        "Bhakthudu Shoadhimpa Baduchundunaeni",
        "Yukthi Dhelpedi Sarva Shakthi Needhaunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తిన్ననైన తెలివి తేట నాకిమ్ము",
        "నిన్ను సేవించెద నిజము స్తోత్రమ్ము"
      ],
      "english": [
        "Thinnanaina Thelivi Thaeta Naakimmu",
        "Ninnu Saevinchedha Nijamu Sthoathrammu"
      ]
    }
  ]
}
