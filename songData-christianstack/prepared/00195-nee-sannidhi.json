{
  "song_name": "Nee Sannidhi",
  "author": {
    "Authored by": "Kishore Kathula",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆనందము ఆద్యంతము",
      "నీతో నామది సంబంధము",
      "ఆశ్చర్యము అసమానము",
      "ఈ దీనునికై నీవిచ్చిన స్థానము",
      "నా తోడుగా యేసు నీవుండగా",
      "నా హృదయమునకు భద్రత నిండుగా",
      "నీ సన్నిధి నా ముందుండగా",
      "అతిశయించి నే పరవశము పొందగా"
    ],
    "english": [
      "Anandamu adyanthamu",
      "Neetho naamadhi sambandhamu",
      "Aascharyamu asamaanamu",
      "Ee deenunikai neevichchina sthaanamu",
      "Naa thodugaa Yesu neevundaga",
      "Naa hrudayamanaku bhadratha ninduga",
      "Nee sannidhi naa mundhundaga",
      "Athishayinchi ne paravashamu pondhaga"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోకము నా దేహము",
        "నన్నెంతగానో నిష్ఫలుని చేసెను",
        "మతిమాలిన క్రియలన్నియూ",
        "మృతమైన స్థితికి నను మార్చెను",
        "నా యేసు నాధా నీ స్నేహము",
        "తొలగించె నా శాపకర మార్గము",
        "జవ జీవమంతా జత చేయుచూ",
        "జయ కేతనముగా నను మార్చెను"
      ],
      "english": [
        "Ee lokamu naa dhehamu",
        "Nannenthagano nishphaluni chesenu",
        "Mathimaalina kriyalanniyu",
        "Mruthamainaa sthithiki nanu maarchenu",
        "Naa Yesu naadha nee snehmu",
        "Tholaginchenaa shaapakaara maargamu",
        "Java jeevamantha jatha cheyuchu",
        "Jaya kethanamuga nanu maarchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వెలిగింపు లేక జ్ఞానిని కాగలనా",
        "వివరంబు లేక గ్రహియింప తరమా",
        "తరుణంబు లేక వరమొందగలనా",
        "నడిపింపు లేక గురి చేరగలనా",
        "నీ సన్నిధి నను నిల్పుచూ",
        "ఈవులన్నియూ దానమీయుచూ",
        "నెమ్మదంతయూ మనసున నిండ",
        "మరువనుగా అందిన సాయము నీవలన"
      ],
      "english": [
        "Veligimpu leka jnaanini kaagalanaa",
        "Vivarambu leka grahiyimpa tharamaa",
        "Tharunambu leka varamondagalanaa",
        "Nadipimpu leka guri cheragalanaa",
        "Nee sannidhi nanu nilpuchu",
        "Eevulanniyu dhaanameeyuchu",
        "Nemmadanthayu manasuna ninda",
        "Maruvanugaa andhina saayamu neevalana"
      ]
    }
  ]
}
