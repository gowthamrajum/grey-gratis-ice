  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నృపా విమోచకా ప్రభూ - వేలాది నోళ్ల నీ",
        "గృపా జయప్రభావముల్ - నుతింతు నెంతయున్"
      ],
      "english": [
        "Nrupaa vimochakaa Prabhoo - Velaadi nolla nee",
        "Krupaa jayaprabhaavamul - Nuthinthu nenthayun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కృపాధికార దేవ నీ సాయంబు జేయుమా",
        "భవత్ర్వభావ కీర్తులన్ - జాటంగ నెల్లడన్"
      ],
      "english": [
        "Krupaadhikaara Deva nee saayambu jeyumaa",
        "Bhavathsvabhaava keerthulan - Jaatanga nelladan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భయంబు చింతబావును - హర్షంబు పాపికి",
        "సౌఖ్యంబు జీవశాంతులు - నీనామ మిచ్చును"
      ],
      "english": [
        "Bhayambu chinthabaapunu - Harshambu paapiki",
        "Saukhyambu jeevashaanthulu - Neenaama michchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విముక్తి జేయు ఖైదిని - పాపంబు బావును",
        "పాపాత్ము శుద్ధిచేయును శ్రీ యేసు రక్తము"
      ],
      "english": [
        "Vimukthi jeyu khaidhini - Paapambu baapunu",
        "Paapaathmu shuddhicheyunu Shree Yesu rakthamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జనాళి పాపు లెల్లరు - శ్రీ యేసున్ నమ్ముడి",
        "కృపా విముక్తులందరు - నంపూర్ణ భక్తితో"
      ],
      "english": [
        "Janaali paapu lellaru - Shree Yesun nammudi",
        "Krupaa vimukthulandharu - Nampoorna bhakthitho"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అర్పించె యేసు ప్రాణమున్ - నరాళిగావను",
        "యజ్ఞంబు దేవ గొఱ్ఱెపై - నఘంబు వేయుడి"
      ],
      "english": [
        "Arpinche Yesu praanamun - Naraaligaavanu",
        "Yagnambu Deva gorrepai - Naghambu veyudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సత్కీర్తి స్తోత్ర ప్రేమల - నభావ భూమిని",
        "సర్వత్ర దేవుడొందుగా - సద్భక్తవాళిచే"
      ],
      "english": [
        "Sathkeerthi sthothra premala - Nabhaava bhoomini",
        "Sarvathra dhevudondhugaa - Sadbhakthavaaliche"
      ]
    }
  ]
}
