  "main_stanza": {
    "telugu": [
      "యేసయ్య జన్మించే నీ కొరకే",
      "యేసయ్య జన్మించే నా కొరకే",
      "యేసయ్య జన్మించే మన కొరకే",
      "పాటలే పాడెదము నాట్యమే ఆడెదము",
      "హ్యాపీ హ్యాపీ హ్యాపీ హ్యాపీ హ్యాపీ క్రిస్మస్",
      "మెర్రీ మెర్రీ మెర్రీ మెర్రీ మెర్రీ క్రిస్మస్",
      "దివి నుండి దిగి వచ్చే దూత",
      "గొల్లలకు తెలిపే శుభవార్త",
      "ఓహో దివి నుండి దిగి వచ్చే దూత",
      "గొల్లలకు తెలిపే శుభవార్త",
      "ఆకాశాన కలిగిందో వింత",
      "ఓహో ఆకాశాన కలిగిందో వింత",
      "లోకానికిక లేదు చింత",
      "అందుకే పాటలే పాడెదము నాట్యమే ఆడెదము",
      "సమాధాన శుభ వర్తమానం",
      "రక్షణ కలిగించు నామం",
      "ఓహో సమాధాన శుభ వర్తమానం",
      "రక్షణ కలిగించు నామం",
      "హృదయాలను వెలిగించే గానం",
      "ఓహో హృదయాలను వెలిగించే గానం",
      "చాటెదము యేసయ్య జననం",
      "అందుకే పాటలే పాడెదము నాట్యమే ఆడెదము"
    ],
