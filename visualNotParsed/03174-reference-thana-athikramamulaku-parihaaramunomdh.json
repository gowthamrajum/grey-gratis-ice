      ],
      "english": [
        "Nee sannidhi naa paapamula noppukonagaa",
        "Neevu naa dhoshamunu manninchithivigaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కావున నీ దర్శన కాలమందు",
        "భక్తిగలవారు నిన్ను ప్రార్థించెదరు"
      ],
      "english": [
        "Kaavuna nee dharshana kaalamandu",
        "Bhakthigalavaaru ninnu praarthinchedharu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "విస్తార జలప్రవాహములు పొర్లినను",
