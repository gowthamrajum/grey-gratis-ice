{
  "song_name": "Manulu maanikyamulunnaa medamiddhelu ennunnaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మణులు మాణిక్యములున్నా మేడమిద్దెలు ఎన్నున్నా",
      "మదిలో యేసులేకున్నా ఏది ఉన్నా అది సున్నా ||మణు||"
    ],
    "english": [
      "Manulu maanikyamulunnaa medamiddhelu ennunnaa",
      "Madilo Yesulekunnaa edhi unnaa adhi sunnaa ||Manu||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చదువులెన్నో చదివివున్నా పదవులెన్నో చేస్తున్నా",
        "విద్యవున్నా బుద్ధివున్నా జ్ఞానమున్నా అది సున్నా  ||మణులు||"
      ],
      "english": [
        "Chadhuvulenno chadhivivunnaa padhavulenno chesthunnaa",
        "Vidhyavunnaa buddhivunnaa gnaanamunnaa adhi sunnaa ||Manulu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అందచందా లెన్నున్నా అండములపై కూర్చున్నా",
        "సుందరుడు ప్రభులేక యున్నా అందమున్నా అది సున్నా  ||మణులు||"
      ],
      "english": [
        "Andhachandhaa lennunnaa andamulapai koorchunnaa",
        "Sundarudu prabhuleka yunnaa andhamunnaa adhi sunnaa ||Manulu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రాజ్యములు రమణులు ఉన్నా శౌర్యములు వీర్యము",
        "లున్నా బలము ఉన్నా బలగమున్నా ఎన్నివున్నా అవి సున్నా  ||మణులు||"
      ],
      "english": [
        "Raajyamulu ramanulu unnaa shauryamulu veeryamu",
        "Lunnaa balamu unnaa balagamunnaa ennivunnaa avi sunnaa ||Manulu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పూజ్యుడా పుణ్యాత్ముండా పుణ్యకార్య సిద్ధుడా",
        "దానధర్మము జపము తపము యేసులేనిది అదిసున్నా  ||మణులు||"
      ],
      "english": [
        "Poojyudaa punyaathmundaa punyakaarya siddhudaa",
        "Dhaanadharmamu japamu thapamu Yesulenidhi adhisunnaa ||Manulu||"
      ]
    }
  ]
}
