{
  "song_name": "Raavayya Yesunaadhaa maa rakshana maargamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రావయ్య యేసునాధా మా రక్షణ మార్గము",
      "నీ సేవ జేయ మమ్ము జేపట్టుటకు"
    ],
    "english": [
      "Raavayya Yesunaadhaa maa rakshana maargamu",
      "Nee seva jeya mammu jepattutaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హద్దులేక మేము ఇల మొద్దులమై యుంటిమి",
        "మా కొద్ది బుద్దులన్ని దిద్ది రక్షింపను"
      ],
      "english": [
        "Haddhuleka memu ila moddhulamai yuntimi",
        "Maa koddi buddhulanni dhiddhi rakshimpanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిండు వేడుకతోను మమ్ము బెండువడక చేసి",
        "మా గండంబులన్నియు ఖండించుటకు"
      ],
      "english": [
        "Nindu vedukathonu mammu benduvadaka chesi",
        "Maa gandambulanniyu khandinchutaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపుల మయ్యమేము పరమ తండ్రిని గానకను",
        "మా పాపంబు లన్నియు పారద్రోలుటకు"
      ],
      "english": [
        "Paapula mayyamemu parama thandrini gaanakanu",
        "Maa paapambu lanniyu paaradhrolutaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అందమైన నీదు పరమానంద పురమందు",
        "మే మందరము జేరి యానందించుటకు"
      ],
      "english": [
        "Andamaina needu paramaananda puramandhu",
        "Me mandaramu jeri yaanandhinchutaku"
      ]
    }
  ]
}
