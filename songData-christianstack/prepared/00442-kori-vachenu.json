{
  "song_name": "Kori Vachenu",
  "author": {
    "Authored by": "Davidson Gajulavarthi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తండ్రి తనయుని భూమికి పంపిన ఈ వేళ శుభవేళ",
      "భూమిని తలక్రిందులుగా చేసే మెసయ్యే వచ్చె బాలునిగా",
      "ఆకాశంలో దూతలు పాడే",
      "భూమి అంతా సంబరమయే",
      "సింహాసనమే వదిలాడయ్యా",
      "మనుష రూపము దాల్చి వచ్చాడయ్య"
    ],
    "english": [
      "Thandri thanayuni bhoomiki pampina ee vela shubavela",
      "bhoomini thalakrindhulugaa chese messayye vache baalunigaa",
      "aakaasamlo dhoothalu paadey",
      "bhoomi antha sambaramaayey",
      "simhaasanamey vadhilaadayya",
      "manusha roopamu dhaalchi vachaadayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కోరి వచ్చెను కారణ జన్ముడే",
        "కాడి మోయను కదిలెను కరుణాత్ముడే"
      ],
      "english": [
        "Kori vachenu kaarana janmudey",
        "kaadi moyanu kadhilenu karunaathmudey"
      ]
    }
  ]
}
