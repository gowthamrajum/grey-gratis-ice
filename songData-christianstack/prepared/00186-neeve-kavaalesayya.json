{
  "song_name": "Neeve Kavaalesayya",
  "author": {
    "Authored by": "Blessy Kingsley",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రాణ ప్రియుడా మహనీయుడా",
      "నా యేసయ్యా నీతో ఉంటానయ్యా"
    ],
    "english": [
      "Naa praana priyudaa mahaneyudaa",
      "Naa yesayya neetho untaanayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవే కావాలేసయ్యా నీతో ఉంటానయ్యా",
        "నీతోనే ఉంటానేసయ్యా నిను విడువలేనయ్యా"
      ],
      "english": [
        "Neeve kaavalesayya neetho untaanayya",
        "Neethone untaanesayya ninu viduvalenayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆశలే ఆవిరైపోయినా",
        "నా బ్రతుకే భారమైపోయినా",
        "శ్రమలు శోధించినా…",
        "నాతో నీవున్న ! ధైర్యమే కలిగేనా !!",
        "ప్రాణం పోయేంతవరకు నీతోనేనయ్యా",
        "తుదిశ్వాస వరకు నీతో ఉంటానయ్యా"
      ],
      "english": [
        "Aashale aaviraipooyinaa",
        "Naa brathuke bhaaramaipooyinaa",
        "Sramalu shodhinchinaa",
        "Naatho neeyunna – dhairyame kaligenaa",
        "Praanam poye enta varaku neethonenayya",
        "Thudishwaasa varaku neetho untaanayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కన్నీరే సముద్రమైపోయినా",
        "తుఫాను అలలే చెలరేగినా",
        "నే నలిగిపోయినా….",
        "నాతో నీవున్న ! ధైర్యమే కలిగేనా !!",
        "ప్రాణం పోయేంతవరకు నీతోనేనయ్యా",
        "తుదిశ్వాస వరకు నీతో ఉంటానయ్యా"
      ],
      "english": [
        "Kanneere sandramaipooyinaa",
        "Tufaana alale cheleragina",
        "Né nalgipooyinaa",
        "Naatho neeyunna – dhairyame kaligenaa",
        "Praanam poye enta varaku neethonenayya",
        "Thudishwaasa varaku neetho untaanayya"
      ]
    }
  ]
}
