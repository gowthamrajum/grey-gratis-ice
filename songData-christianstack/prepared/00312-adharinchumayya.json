{
  "song_name": "Adharinchumayya",
  "author": {
    "Authored by": "Dr P Satish Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆదరించుమయ్యా – ఆదుకొనేవాడా",
      "చేరదీయుమయ్యా – సేదదీర్చేవాడా",
      "యేసయ్య – యేసయ్య – నీ మీదే నా ఆశయ్య"
    ],
    "english": [
      "Aadhainchumayyaa – aadhukonevaadaa",
      "cheradheeyumayyaa -sedhadheerchevaadaa",
      "yesayya – yesayya – nee meedhe naa aasayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రెక్కలే విరిగినా – గువ్వనై నే వొరిగినా",
        "ఎండలో వాడినా – పువ్వునై నే రాలినా",
        "దిక్కు తోచక నిన్ను చేరితి",
        "కాదనవని నిన్ను నే వేడితి",
        "నను దర్శించుమో నా యేసయ్య",
        "నను ధైర్యపరచుమో నా యేసయ్యా",
        "ఆశలే అడుగంటెనే – నిరాశలే నను ముంచెనే",
        "నీడయే కరువాయెనే – గూడుయే చెదరిపోయెనే",
        "నీ తోడు నే కోరుకొంటిని",
        "నీ పిలుపుకై వేచియుంటిని",
        "నీ దరిచేర్చుకో- నా యేసయ్య",
        "నన్ను కాదనకుమా – నా యేసయ్యా"
      ],
      "english": [
        "Rekkale virigina – guvvanai ne voriginaa",
        "endalo vaadinaa – puvvunai ne raalinaa",
        "dhikku thochaka ninnu cherithi",
        "kaadhanavani ninnu ne vedithi",
        "nanu dharsinchumo naa yesayya",
        "nanu dhairya parachumo naa yesayya",
        "Aasale adugantene – niraasale nanu munchene",
        "Needaye karuvaayane – gooduye chedharipoyene",
        "nee thodu ne korukontini",
        "nee pilipukai vechiyuntini",
        "nee dhari cherchuko – naa yesayya",
        "nannu kaadhanakumaa – naa yesayya"
      ]
    }
  ]
}
