{
  "song_name": "Bangaaram thandri",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "బంగారం తండ్రి నా యేసయ్యా",
      "స్తోత్రము చెల్లింతును యేసయ్యా",
      "నేరము చేసితిని నేనయ్యా నా భారాన్ని మోసిన యేసయ్యా"
    ],
    "english": [
      "Bangaaram thandri naa Yesayya",
      "Sthothramu chellinthunu Yesayya",
      "Neramu chesithini nenayya naa bhaaraanni mosina Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపమునుండి నన్ను విడిపించి నీ రక్తము నాకై",
        "నీవు చిందించి రక్షణ వస్త్రమును నాకిచ్చి",
        "నా రక్షకుడైనావు యేసయ్యా"
      ],
      "english": [
        "Paapamunundi nannu vidipinchi nee rakthamu naakai",
        "Neevu chindinchi rakshana vasthramunu naakichchi",
        "Naa rakshakudainaavu Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శత్రువు నుండి నన్ను విడిపించి నీ రెక్కల నీడలో",
        "దాచితివి దుఃఖములన్నియు బాపితివా",
        "నా చక్కని తండ్రివయ్యా యేసయ్యా"
      ],
      "english": [
        "Shathruvu nundi nannu vidipinchi nee rekkala needalo",
        "Daachithivi dhuhkhamulanniyu baapithivaa",
        "Naa chakkani thandrivayya Yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అడుగులు జారక నను నడిపితివి నీ ఉన్నత సేవకై",
        "పిలిచితివి ఎన్నిక లేని నన్ను ఎన్నుకొని",
        "ఇంత భాగ్యము నిచ్చావు యేసయ్యా"
      ],
      "english": [
        "Adugulu jaaraka nanu nadipithivi nee unnatha sevakai",
        "Pilichithivi ennika leni nannu ennukoni",
        "Intha bhaagyamu nichchaavu Yesayya"
      ]
    }
  ]
}
