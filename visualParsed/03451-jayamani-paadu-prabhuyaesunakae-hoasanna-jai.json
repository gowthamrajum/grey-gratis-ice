{
  "song_name": "Jayamani paadu Prabhuyesunake hosanna jai",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "జయమని పాడు ప్రభుయేసునకే హోసన్న జై",
      "ప్రభు వచ్చుచుండె యెంతో సంతసము",
      "మధ్యాకాశమందు సంధించెదము"
    ],
    "english": [
      "Jayamani paadu Prabhuyesunake hosanna jai",
      "Prabhu vachchuchunde entho santhasamu",
      "Madhyaakaashamandhu sandhinchedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మనము మారెదము మర్మమిది గొప్పదే",
        "బూరధ్వని మ్రోగగానే మన మెత్తబడెదము",
        "ప్రియ యేసుని సంధింప, మనమాయనవారమే"
      ],
      "english": [
        "Manamu maaredhamu marmamidhi goppadhe",
        "Booradhvani mrogagaane mana metthabadedhamu",
        "Priya Yesuni sandhimpa, manamaayanavaarame"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభుని పోలియుందుము ప్రభుని సంతతిగా",
        "ప్రభువు ప్రత్యక్షమైనప్పుడు అమర్త్యత ధరింతుము",
        "పొందెదము ప్రభువునే, మనమాయనవారమే"
      ],
      "english": [
        "Prabhuni poliyundhumu Prabhuni santhathigaa",
        "Prabhuvu prathyakshamainappudu amarthyatha dharinthumu",
        "Pondedamu Prabhuvune, manamaayanavaarame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన నిరీక్షణయే ప్రభుని చూతుమని",
        "తృప్తి చెంది నింపబడెదం వాంఛలు తీరును",
        "ప్రభుని రుచించెదము, మనమాయనవారమే"
      ],
      "english": [
        "Mana nireekshanaye Prabhuni choothumani",
        "Thrupthi chendhi nimpabadedham vaanchalu theerunu",
        "Prabhuni ruchinchedhamu, manamaayanavaarame"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దైవ సంకల్పమే ప్రభువుతో నుండుటే",
        "దేవుని గృహ మానంద మహిమతో నిండియుండును",
        "ప్రభువు మనవాడు, మనమాయనవారమే"
      ],
      "english": [
        "Daiva sankalpame Prabhuvutho nundute",
        "Devuni gruha maanandha mahimatho nindiyundunu",
        "Prabhuvu manavaadu, manamaayanavaarame"
      ]
    }
  ]
}
