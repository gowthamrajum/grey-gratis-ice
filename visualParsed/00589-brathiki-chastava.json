  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గొంగలి తన రూపం మార్చుకున్నది",
        "సీతాకోక చిలుకగా ఎగురుచున్నది (2)",
        "ఆ రూపము కొరకే దాచుకున్నది",
        "ఆ రూపము కొరకే కలలుకన్నది",
        "సృష్టిలో ప్రధముడా! దేవుని కుమారుడా! (2)",
        "నీకు బ్రతుకులేదన్నది ఎవడురా?",
        "మరో బ్రతుకులేదన్నది ఎవడురా? (2)"
      ],
      "english": [
        "Gongali thana roopam maarchukunnadhi",
        "Seethaakoka chilukagaa eguruchunnadhi (2)",
        "Aa roopamu korake dhaachukunnadhi",
        "Aa roopamu korake kalalukannadhi",
        "Srushtilo prathamudaa! Devuni kumaarudaa! (2)",
        "Neeku brathuku ledhannadhi evaduraa?",
        "Maro brathuku ledhannadhi evaduraa? (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రతీ చెట్టు పెరుగుచున్నది నీకొసమే",
        "ప్రతీ జీవి బ్రతుకుచున్నది నీకొసమే (2)",
        "బ్రతికి బలౌతుంది నిన్ను బ్రతికించుట కొరకే",
        "బ్రతకాలి నీవు దేవుని కొరకే!",
        "చావే ముగింపు కాదని",
        "ఆత్మకు చావు లేదని (2)",
        "ప్రకటించి మరణించి తిరిగిలేచెను",
        "సజీవుడైనాడు సకపురుషుడైన క్రీస్తు యేసు (2)"
      ],
      "english": [
        "Prathee chettu peruguchunnadhi neekosame",
        "Prathee jeevi brathukuchunnadhi neekosame (2)",
        "Brathiki balauthundhi ninnu brathikinchuta korake",
        "Brathakaali neevu Devuni korake!",
        "Chaave mugimpu kaadani",
        "Aathmaku chaavu ledani (2)",
        "Prakatinchi maraninchi thirigilechenu",
        "Sajeevudainaadu sakapurushudaina Kreesthu Yesu (2)"
      ]
    }
  ]
