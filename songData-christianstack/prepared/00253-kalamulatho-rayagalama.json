{
  "song_name": "Kalamulatho Rayagalama",
  "author": {
    "Authored by": "Daniel J. Kiran",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కలములతో రాయగలమా",
      "కవితలతో వర్ణించగలమా",
      "కలలతో వివరించగలమా",
      "నీ మహోన్నతమైన ప్రేమా",
      "ఆరాధింతును",
      "రారాజువు నీవే",
      "నా తండ్రివి నీవే",
      "నిను విడువను ఎడబాయను"
    ],
    "english": [
      "Kalamulatho raayagalamaa",
      "kavithalatho varninchagalamaa",
      "kalalatho vivarinchagalamaa",
      "nee mahonnathamaina premaa",
      "aaraadhinthunu",
      "raaraajuvu neeve",
      "naa thandrivi neeve",
      "ninu viduvanu edabaayanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశములు నీ మహిమను",
        "వివరించుచున్నవి",
        "అంతరిక్షము నీ చేతి పనిని",
        "వర్ణించుచున్నది"
      ],
      "english": [
        "Aakaashamulu nee mahimanu",
        "vivarinchuchunnavi",
        "antharikshamu nee chethi panini",
        "varninchuchunnadi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవా నా ప్రాణము",
        "నీ కొరకై తపియించుచున్నది"
      ],
      "english": [
        "Devaa naa praanamu",
        "nee korakai thapiyinchuchunnadi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సెరాపులు కెరూబులు",
        "నిత్యము నిను స్తుతియించుచున్నవి",
        "మహా దూతలు ప్రధాన దూతలు",
        "నీ నామము కీర్తించుచున్నవి"
      ],
      "english": [
        "Seraapulu keroobulu",
        "nithyamu ninu sthuthiyinchuchunnavi",
        "mahaa doothalu pradhaana doothalu",
        "nee naamamu keerthinchuchunnavi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దేవా నా ప్రాణము",
        "నీ కొరకై తపియించుచున్నది"
      ],
      "english": [
        "Devaa naa praanamu",
        "nee korakai thapiyinchuchunnadi"
      ]
    }
  ]
}
