      ],
      "english": [
        "Paapamula bhayamunundi",
        "Vidipinchina Immaanuyelu ||Eeroju||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ జననం లోకానికి రక్షణకు ఆధారం ॥2॥"
      ],
      "english": [
        "Nee jananam lokaaniki rakshanaku aadhaaram ॥2॥"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బలహీనులకు బలమైన",
