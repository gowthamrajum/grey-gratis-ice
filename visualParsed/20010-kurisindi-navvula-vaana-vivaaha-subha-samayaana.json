{
  "song_name": "Kurisindi navvula vaana – Vivaaha shubha samayaana",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "కురిసింది నవ్వుల వాన – వివాహ శుభ సమయాన",
      "నాలో కలిగే సందడి – నాలో కలిగే సవ్వడి",
      "హృదయాలు పండించే వేళ ఈవేళ /కురి/"
    ],
    "english": [
      "Kurisindi navvula vaana – Vivaaha shubha samayaana",
      "Naalo kalige sandadi – Naalo kalige savvadi",
      "Hrudayaalu pandinche vela eevela /Kuri/"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "​1. కోయిలమ్మ పాడె అందమైన ఏదో రాగం",
        "దాగెనమ్మ సిగ్గు తొందరల్లో ఏదో భావం",
        "ఒంటరి జీవితం జంటగ మార్చెనే – ఇరు హృదయాలను ఒకటిగా కూర్చెనే",
        "దేవుడు కల్పిన బంధం – వీడిపోని అనుబంధం /కురి/"
      ],
      "english": [
        "1. Koyilamma paade andamaina edho raagam",
        "Dhaagenamma siggu thondarallo edho bhaavam",
        "Ontari jeevitham jantaga maarchene – Iru hrudhayaalanu okatigaa koorchene",
        "Devudu kalpina bandham – Veediponi anubandham /Kuri/"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గోరుమావిడమ్మా పూచెనమ్మా అనురాగం",
        "మరువకూడదమ్మా చేసుకున్న ఈ ప్రమాణం",
        "వాక్యపు వెలుగులో బ్రతుకులు పండగా",
        "దేవుడు తోడుగా నీతో నుండగా",
        "సాగేటి ఈ బంధం – వీడిపోని అనుబంధం /కురి/"
      ],
      "english": [
        "Gorumaavidammaa poochenammaa anuraagam",
        "Maruvakoodadhammaa chesukunna ee pramaanam",
        "Vaakyapu velugulo brathukulu pandagaa",
        "Devudu thodugaa neetho nundagaa",
        "Saageti ee bandham – Veediponi anubandham /Kuri/"
      ]
    }
  ]
}
