{
  "song_name": "Nenu elugetthi Devuniki morrapettudhunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవునికి మొఱ్ఱపెట్టుదును ఎలుగెత్తి",
        "చెవియొగ్గువరకు మనవి చేయుచుందును"
      ],
      "english": [
        "Devuniki morrapettudhunu elugetthi",
        "Cheviyogguvaraku manavi cheyuchundhunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభుని ఆపదల యందు వెదకువాడను",
        "ప్రాణము పొంద జాలకున్నది యోదార్పును"
      ],
      "english": [
        "Prabhuni aapadhala yandu vedhakuvaadanu",
        "Praanamu ponda jaalakunnadhi yodhaarpunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పూర్వ సంవత్సరములను తలచుకొందును",
        "పాడిన పాట రాత్రి జ్ఞప్తినుంచుకొందును"
      ],
      "english": [
        "Poorva samvathsaramulanu thalachukondhunu",
        "Paadina paata raathri gnapthinunchukondhunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "హృదయమున నిన్ను ధ్యానించుకొందురు",
        "శ్రద్ధగ నా యాత్మ నీ తీర్పు వెదకుచున్నది"
      ],
      "english": [
        "Hrudayamuna ninnu dhyaaninchukonduru",
        "Shraddhaga naa yaathma nee theerpu vedhakuchunnadhi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రభువు నన్ను నిత్యము విడిచిపెట్టునా?",
        "ప్రభువింకెన్నటికిని కటాక్షముంచడా?"
      ],
      "english": [
        "Prabhuvu nannu nithyamu vidichipettunaa?",
        "Prabhuvinkennatikini kataakshamunchadaa?"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దేవుడు నన్ను కనికరింపక మానివేసెనా?",
        "దేవుడు కోపముతో కృప చూపకుండునా?"
      ],
      "english": [
        "Devudu nannu kanikarimpaka maanivesenaa?",
        "Devudu kopamutho krupa choopakundunaa?"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మహోన్నతుని దక్షిణ హస్తము మారెను",
        "అనుకొనుటకు నా శ్రమలే కారణము"
      ],
      "english": [
        "Mahonnathuni dakshina hasthamu maarenu",
        "Anukonutaku naa shramale kaaranamu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "దేవా నీ పూర్వపు ఆశ్చర్యకార్యములను",
        "తలంచు కొందు నాదు మనస్సులో నిప్పుడు"
      ],
      "english": [
        "Deva nee poorvapu aashcharyakaaryamulanu",
        "Thalanchu kondhu naadu manassulo nippudu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "నీ కార్యమంతటిని ధ్యానించుకొందును",
        "నీ క్రియలను ధ్యానము నే జేసికొందును"
      ],
      "english": [
        "Nee kaaryamanthatini dhyaaninchukondhunu",
        "Nee kriyalanu dhyaanamu ne jesikondhunu"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "మహా పరిశుద్ధమైనది నీదు మార్గము",
        "మహా దేవా నీ వంటివాడు ఎక్కడున్నాడు?"
      ],
      "english": [
        "Mahaa parishuddhamainadhi needu maargamu",
        "Mahaa Deva nee vantivaadu ekkadunnaadu?"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "ఆశ్చర్య క్రియలు జరిగించు దేవుడవు నీవే",
        "జనములలో ప్రభావమును చూపియున్నావు"
      ],
      "english": [
        "Aashcharya kriyalu jariginchu devudavu neeve",
        "Janamulalo prabhaavamunu choopiyunnaavu"
      ]
    }
  ]
}
