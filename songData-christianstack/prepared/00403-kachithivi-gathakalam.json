{
  "song_name": "Kachithivi Gathakalam",
  "author": {
    "Authored by": "Nazaresh",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కాచితివి గతకాలం",
      "నీ కృపలో నా దేవా",
      "ఊహించలేని మేలులు చేసి",
      "నీ సన్నిథిలో సాక్షిగా నిలిపితివి"
    ],
    "english": [
      "Kaachithivi gathakaalam",
      "nee krupalo naa dhevaa",
      "oohinchaleni melulu chesi",
      "nee sannidhilo saakshigaa nilipithivi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంజూర చెట్లు పూయకుండిననూ",
        "ద్రాక్ష చెట్లు ఫలింపక పోయిననూ",
        "నీయందే నేను ఆనందించెదను",
        "నీలోనే నేను అతిశయించెదను"
      ],
      "english": [
        "Anjoora chetlu pooyakundinanu",
        "dhraaksha chetlu phaliyimpaka poyinanu",
        "nee yandey nenu aanandhinchedhanu",
        "neelone nenu athisayinchedhanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేసయ్యా యేసయ్యా",
        "నా క్షేమం నీవయ్యా",
        "యేసయ్యా యేసయ్యా",
        "నా సర్వం నీవయ్యా"
      ],
      "english": [
        "Yesayya yesayya",
        "naa kshemam neevayyaa",
        "yesayya yesayya",
        "naa sarvam neevayyaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పైరు పంటకు రాకపోయినను",
        "శాలలో పశువులు లేకపోయినను",
        "నీయందే నేను ఆనందించెదను",
        "నీలోనే నేను నిలచి ఉండెదను"
      ],
      "english": [
        "Pairu pantaku raakapoyinanu",
        "saalalo pasuvulu lekapoyinanu",
        "nee yandey nenu aanandhinchedhanu",
        "neelone nenu nilachi undedhanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసయ్యా యేసయ్యా",
        "నా క్షేమం నీవయ్యా",
        "యేసయ్యా యేసయ్యా",
        "నా సర్వం నీవయ్యా"
      ],
      "english": [
        "Yesayya yesayya",
        "naa kshemam neevayyaa",
        "yesayya yesayya",
        "naa sarvam neevayyaa"
      ]
    }
  ]
}
