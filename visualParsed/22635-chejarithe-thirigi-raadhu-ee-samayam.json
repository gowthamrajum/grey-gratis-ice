        "మరణఛాయా కమ్మకముందే క్రీస్తు కొరకు బ్రతుకుమా"
      ],
      "english": [
        "Thirigiraadhu ee kaalam vyardhamugaa gadapakoo",
        "Paapamulo brathukuthoo naashanaanni pondhaku",
        "Durdinamulu raakamunde Prabhu chenthaku cherumaa",
        "Maranachhaayaa kammakamundhe Kreesthu koraku brathukumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవుడిచ్చిన వరమే ఈ జీవత సమయం",
