{
  "song_name": "Neeve Naaku Aadharam",
  "author": {
    "Authored by": "Pas. Vinay Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీవే నాకు ఆధారమై",
      "నీవే నాకు ఆశ్రయమై",
      "నన్నాదరించిన నా యేసయ్య",
      "నన్నాదుకున్న నా యేసయ్య",
      "నీవే నాకు ఆధారమై‌"
    ],
    "english": [
      "Neeve naaku aadharamai",
      "Neeve naaku aashrayamai",
      "Nannaadharinchina naa Yesayya",
      "Nannaadhukunnna naa Yesayya",
      "Neeve naaku aadharamai"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎవరులేరని ఏడ్చిన వేళ",
        "నన్ను ఓదార్చిన యేసయ్య",
        "ఆదరణ కరువైన ఆ సమయాన",
        "నన్నాదరించిన నా యేసయ్య",
        "కరములు చాపి నీదరి చేర్చి",
        "కరుణతో నీ ప్రేమను పంచి",
        "నన్ను పిలచిన నా యేసయ్య",
        "నీవే నాకు ఆధారమై"
      ],
      "english": [
        "Evaru lerani edchina vela",
        "Nannu odhaarchina Yesayya",
        "Aadharana karuvaina aa samayana",
        "Nannaadharinchina naa Yesayya",
        "Karamulu chaapi needhari cherchi",
        "Karunatho nee premanu panchi",
        "Nannu pilichina naa Yesayya",
        "Neeve naaku aadharamai"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏ దరి కానక తిరిగిన నన్ను",
        "నదరి చేర్చిన నా యేసయ్య",
        "ఆధామే లేని ఆసమయా",
        "నన్నాదుకున్నది నీవేనయ్క",
        "పేరుతో పిలిచి నీదరి చేర్చి",
        "నీ కౌగిలిలో నన్ను ఓదర్చి",
        "నన్సు బ్రతికించిన నా",
        "యేసయ్య"
      ],
      "english": [
        "Ee dhari kanaka thirigina nannu",
        "Nadhari cherchina naa Yesayya",
        "Aadhaaram leeni aa samayaa",
        "Nannaadhukunnadi neevenaika",
        "Perutho pilichi needhari cherchi",
        "Nee kougililo nannu odharchi",
        "Nannu brathikinchina naa",
        "Yesayya"
      ]
    }
  ]
}
