  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కలువరిలో కార్చిన -నీ విలువైన రక్తముచే",
        "కలుషములన్ బాపిన-మా ప్రభువా స్తోత్రము",
