  "main_stanza": {
    "telugu": [
      "ఎంత సౌందర్య నగరము",
      "అద్భుత మహిమ ప్రభావముతో నిండెను",
      "పరిశుద్ధం, పరిశుద్ధం, పరిశుద్ధం, అన్నియు"
    ],
    "english": [
      "Entha saundharya nagaramu",
      "Adbhutha mahima prabhaavamutho nindenu",
      "Parishuddham, parishuddham, parishuddham, anniyu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆ నగర పునాది ఎంతో దృఢమైనది",
        "స్థిరమై కదలని శాశ్వతమైనది",
        "ప్రభువే తన వారిన్ సిద్ధపరచుచున్నాడు",
        "అద్భుతం అద్భుతం అద్భుతనగరం"
      ],
      "english": [
        "Aa nagara punaadi entho dhrudhamainadhi",
        "Sthiramai kadalani shaashwathamainadi",
        "Prabhuve thana vaarin siddhaparachuchunnaadu",
        "Adbhutham adbhutham adbhuthanagaram"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పవిత్ర జనులు తనతో వసింతురు",
        "ఎవరిని ప్రభువు రక్తముతో కొనెనో",
        "జయవంతులే అచ్చట చేరుదురు",
        "విజయులై విజయులై అత్యంత విజయులై"
      ],
      "english": [
        "Pavithra janulu thanatho vasinthuru",
        "Evarini Prabhuvu rakthamutho koneno",
        "Jayavanthule achchata cherudhuru",
        "Vijayulai vijayulai athyantha vijayulai"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇవి మానవులకు గ్రాహ్యము కానివి",
        "ప్రభుని ఆత్మీయ జనులె గ్రహింతురు",
        "ఆత్మయే బోధించున్ ఆత్మ సంగతులన్",
        "ఆత్మీయం ఆత్మీయం అన్నియు ఆత్మీయం"
      ],
      "english": [
        "Ivi maanavulaku graahyamu kaanivi",
        "Prabhuni aathmeeya janule grahinthuru",
        "Aathmaye bodhinchun aathma sangathulan",
        "Aathmeeyam aathmeeyam anniyu aathmeeyam"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆ నగర స్థితి ఆత్మకే గ్రాహ్యం",
        "యేసు ప్రభువే ఆ రుచిని చూపించెను",
        "పై నున్న వాటిని నిలచి చూతుము",
        "ఆనందం ఆనందం పరలోక ఆనందం"
      ],
      "english": [
        "Aa nagara sthithi aathmake graahyam",
        "Yesu Prabhuve aa ruchini choopinchenu",
        "Pai nunna vaatini nilachi choothumu",
        "Aanandam aanandam paraloka aanandam"
      ]
    }
  ]
