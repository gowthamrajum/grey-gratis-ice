{
  "song_name": "Munduku Sagedanu",
  "author": {
    "Authored by": "Raja Mandru",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ముందుకు సాగెదను",
      "నా ఈ జీవిత పోరాటంలో",
      "ఎందరు నన్ను చూసి నవ్విన",
      "ముందుకు సాగెదను",
      "యేసయ్యే నా గమ్యము",
      "ఆయన్ను చేరు వరుకు సాగెదను"
    ],
    "english": [
      "Munduku saagedhanu",
      "naa ee jeevitha poraatamlo",
      "endharu nannu choosi navvina",
      "munduku saagedhanu",
      "yesayye naa gamyamu",
      "aayannu cheru varuku saagedhanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా అని అనుకున్న వారందరు",
        "నీవెవరు అంటు నన్ను వెలివేసారే",
        "ఎవరు నిన్ను విడచినను",
        "నే విడువనంటూ నా యేసు పిలిచాడే",
        "ఆరాధనా ఆరాధనా",
        "ఆరాధనా నా యేసుకే",
        "అడుగులు నావి తడబడినను",
        "వెళ్లే దారి నాకు తెలియకపోయినను",
        "దారి చూపి నడిపిస్తున్నాడు",
        "పాడుటయే నా పని అన్నాడు",
        "ఆరాధనా ఆరాధనా",
        "ఆరాధనా నా యేసుకే"
      ],
      "english": [
        "Naa ani anukunna vaarandharu",
        "neevevaru antu nannu velivesaare",
        "evaru ninnu vidachinanu",
        "ne viduvanantuu naa yesu pilichaade",
        "aaraadhanaa aaraadhanaa",
        "aaraadhanaa naa yesuke",
        "Adugulu naavi thadabadinanu",
        "velle dhaari naaku theliyakapoyinanu",
        "dhaari choopi nadipisthunnaadu",
        "paadutaye naa pani annaadu",
        "aaraadhanaa aaraadhanaa",
        "aaraadhanaa naa yesuke"
      ]
    }
  ]
}
