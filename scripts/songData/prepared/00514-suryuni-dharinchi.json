{
  "song_name": "Suryuni Dharinchi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సూర్యుని ధరించి - చంద్రుని మీద నిలిచి",
      "ఆకాశములో కనుపించే ఈమె ఎవరు ?"
    ],
    "english": [
      "Sooryuni Dharinchi - Chandruni Meeda Nilichi",
      "Aakaashamulo Kanupinche Eeme Evaru ?"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆత్మల భారం - ఆత్మాభిషేకం ఆత్మ వరములు - కలిగియున్న",
        "మహిమ గలిగిన - సంఘమే"
      ],
      "english": [
        "Aathmala Bhaaram - Aathmaabhishekam Aathma Varamulu - Kaligiyunna",
        "Mahima Galigina - Sanghame"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జయ జీవితము - ప్రసవించుటకై వేదన పడుచు - సాక్షియైయున్న",
        "కృపలో నిలిచిన - సంఘమే"
      ],
      "english": [
        "Jaya Jeevithamu - Prasavinchutakai Vedana Paduchu - Saakshiyaiyunna",
        "Krupalo Nilichina - Sanghame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆది అపోస్తలుల - ఉపదేశమునే మకుటముగా - ధరించియున్న",
        "క్రొత్త నిబంధన - సంఘమే"
      ],
      "english": [
        "Aadi Apostalula - Upadeshamune Makutamugaa - Dharinchiyunna",
        "Krotha Nibandhana - Sanghame"
      ]
    }
  ]
}
