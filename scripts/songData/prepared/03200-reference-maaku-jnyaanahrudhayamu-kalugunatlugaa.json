{
  "song_name": "Maaku Jnaanahrudhayamu Kalugunatlugaa Chaeyumu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవా తరతరములకు మాని-వాస స్థలము నీవే"
    ],
    "english": [
      "Dhaevaa Tharatharamulaku Maani-Vaasa Sthalamu Neevae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా దోషములను నీవు నీ యెదుట - నుంచుకొని యున్నావు",
        "నీ ముఖకాంతిలో మా రహస్య పా-పములు కనబడుచున్నవి"
      ],
      "english": [
        "Maa Dhoashamulanu Neevu Nee Yedhuta - Nunchukoni Yunnaavu",
        "Nee Mukhakaanthiloa Maa Rahasya Paa-Pamulu Kanabaduchunnavi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మా దినములన్ని గడిపితిమి - నీ యుగ్రత భరించుచు",
        "నిట్టూర్పులు విడచినట్లు మా జీ-వితము జరుపుకొందుము"
      ],
      "english": [
        "Maa Dhinamulanni Gadipithimi - Nee Yugratha Bharinchuchu",
        "Nittoorpulu Vidachinatlu Maa Jee-Vithamu Jarupukondhumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "డెబ్బది సంవత్సరములేగా - మాదు ఆయుష్కాలము",
        "అధిక బలమున్న యెడల యెనుబది - సంవత్సరములగును"
      ],
      "english": [
        "Debbadhi Samvathsaramulaegaa - Maadhu Aayushkaalamu",
        "Adhika Balamunna Yedala Yenubadhi - Samvathsaramulagunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అయినను వాటి వైభవమంత - ఆయాసమే దుఃఖమే",
        "అది త్వరగా గతించును మే-మెగిరి పోయెదము"
      ],
      "english": [
        "Ayinanu Vaati Vaibhavamantha - Aayaasamae Dhuhkhamae",
        "Adhi Thvaragaa Gathinchunu Mae-Megiri Poayedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీకే జెందవలసినట్టి భయము - కొలది పుట్టినట్టి",
        "నీదు ఆగ్రహ క్రోధ బలము - ఎవ్వరికి తెలియున్"
      ],
      "english": [
        "Neekae Jendhavalasinatti Bhayamu - Koladhi Puttinatti",
        "Needhu Aagraha Kroadha Balamu - Evvariki Theliyun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మాకు నీ జ్ఞాన హృదయమును - కలుగునట్లు చేయుము",
        "మాదినములు లెక్కించుటకు - మాకు నీవే నేర్పుము"
      ],
      "english": [
        "Maaku Nee Jnaana Hrudhayamunu - Kalugunatlu Chaeyumu",
        "Maadhinamulu Lekkinchutaku - Maaku Neevae Naerpumu"
      ]
    }
  ]
}
