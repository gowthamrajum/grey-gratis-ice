{
  "song_name": "Hrudaya marpinchedhamu prabhunaku sthuthi prashamsalatho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "హృదయ మర్పించెదము ప్రభునకు",
      "స్తుతి ప్రశంసలతో పరిశుద్దులము చేరి"
    ],
    "english": [
      "Hrudaya marpinchedhamu prabhunaku",
      "Sthuthi prashamsalatho parishuddhulamu cheri"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపభారము మోయన్ వచ్చె నేసు జగతిన్",
        "పాపుల పాపము తొలగించుటకు",
        "నిత్యజీవము నిచ్చెన్"
      ],
      "english": [
        "Paapabhaaramu moyan vachchen Yesu jagathin",
        "Paapula paapamu tholaginchutaku",
        "Nithyajeevamu nichchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంకట క్లేశము భరించెన్ నమ్రతతో దీనుడై",
        "రక్షణ ద్వారము తెరచెను ప్రభువు",
        "నిత్య నిరీక్షణ నిచ్చెన్"
      ],
      "english": [
        "Sankata kleshamu bharinchen namrathatho deenudai",
        "Rakshana dwaaramu terachenu Prabhuvu",
        "Nithya nireekshana nichchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆశ్చర్య పరలోక ప్రేమ పాపులమగు మనకే",
        "తిరిగి వెళ్ళకు పాపమునకు",
        "నిలువకు పాపములో"
      ],
      "english": [
        "Aashcharya paraloka prema paapulamagu manake",
        "Thirigi vellaku paapamunaku",
        "Niluvaku paapamulo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అర్పించెదము ప్రభువా ఆత్మ ప్రాణ దేహం",
        "కాపాడు మా జీవితముల",
        "ఇదియే మా వినతి"
      ],
      "english": [
        "Arpinchedhamu Prabhuvaa aathma praana deham",
        "Kaapaadu maa jeevithamula",
        "Idiye maa vinathi"
      ]
    }
  ]
}
