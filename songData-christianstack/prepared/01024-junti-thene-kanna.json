{
  "song_name": "Junti Thene Kanna",
  "author": {
    "Authored by": "Joel Kodali",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జుంటి తేనే కన్న తీయనిది",
      "వెండి పసిడి కన్న మిన్న అది",
      "పొంగి పొర్లుచున్న ప్రేమ నిధి",
      "యేసు నీ నామము",
      "సుర్యకాంతి కన్న ప్రకాశమైనది",
      "పండు వెన్నెల కన్న నిర్మలమైనది",
      "మంచు కొండలకన్న చల్లనిది",
      "యేసు నీ నామము"
    ],
    "english": [
      "Junti thene kanna theeyanidhi",
      "vendi pasidi kanna minna adhi",
      "pongi porluchunna prema nidhi",
      "yesu nee namamu",
      "surya kaanthi kanna prakaashamainadhi",
      "pandu vennela kanna nirmalamainadhi",
      "manchu kondala kanna challanidhi",
      "yesu nee namamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు అసాధ్యుడవు నీవు",
        "మరణన్నే జయించిన వీరుడవు",
        "సర్వాన్నే శాసించే యోధుడవు",
        "నీకు సాటి లేరెవరు",
        "రక్షకా! నీవేగా మా బలము",
        "దేవ మా దాగు స్థలము నీవే",
        "నీవే నిజమైన దేవుడవు",
        "ప్రణమిల్లి మ్రొక్కెదము"
      ],
      "english": [
        "yesu asaadhyudavu neevu",
        "maranaanne jeyinchina veerudavu",
        "sarvaanne saasinche yodhudavu",
        "neeku saati lerevaru",
        "rakshaka! neevega ma balamu",
        "deva ma dhaagu sthalamu neeve",
        "neeve nijamaina devudavu",
        "pranamilli mrokkedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకాశము కన్న విశాలమైనది",
        "విశ్వమంతటిలో వ్యాపించియున్నది",
        "ఊహలకందని ఉన్నతమైనది",
        "యేసు నీ నామము",
        "లోకమంతటికి రక్షణ మార్గము",
        "జనులందరిని బ్రతికించు జీవము",
        "సర్వ కాలములలో నివసించు సత్యము",
        "యేసు నీ నామము"
      ],
      "english": [
        "aakashamu kanna vishala mainadhi",
        "viswamanthatilo vyapinchiyunadhi",
        "oohala kandhani unnatha mainadhi",
        "yesu nee namamu",
        "lokamanthatiki rakshana maargamu",
        "janulandharini brathikinchu jeevamu",
        "sarva kaalamulo nivasinchu satyamu",
        "yesu nee namamu"
      ]
    }
  ]
}
