{
  "song_name": "Parugetthi ninu cheri",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Guru Krishna Kadoni",
      "Vishal Dass",
      "Annoz Kamalakar"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పరుగెత్తి నిను చేరి",
      "నీ సన్నిధిలో మోకరించెదా",
      "యేసు నీతో నే నడచి",
      "నీ అడుగులన్ని లెక్కించెదా",
      "నా హృదయం నా మనసు",
      "నా సమస్తము నీకేనయ్యా"
    ],
    "english": [
      "Parugetthi ninu cheri",
      "Nee sannidhilo mokarinchedhaa",
      "Yesu neetho ne nadachi",
      "Nee adugulanni lekkinchedhaa",
      "Naa hrudayam naa manasu",
      "Naa samasthamu neekenayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అత్మతోను సత్యముతో",
        "నిన్నే నే సేవించెదా",
        "ఆరాధన నీకే ఆరాధన",
        "హల్లేలూయా హల్లేలూయా",
        "హల్లేలూయా ఆమేన్"
      ],
      "english": [
        "Aathmathonu sathyamutho",
        "Ninne ne sevinchedhaa",
        "Aaraadhana neeke aaraadhana",
        "Hallelooyaa hallelooyaa",
        "Hallelooyaa aamen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పేతురువలె నీటి మీద నడచి వచ్చెదా",
        "పౌలువలె నీ గురి యొద్దకే నే పరుగెత్తెదా",
        "అలలే వచ్చి నన్ను బెదిరించినా",
        "విశ్వాసముతో నే ముందుకెళ్ళెదా",
        "సంద్రమే లేచి నన్ను ముంచివేసినా",
        "నీ చేయి పట్టుకొనెదా"
      ],
      "english": [
        "Pethuruvale neethi meeda nadachi vachchedhaa",
        "Pauluvale nee guri yoddake ne parugetthedaa",
        "Alale vachchi nannu bedhirinchinaa",
        "Vishwaasamutho ne mundhukelledhaa",
        "Sandhrame lechi nannu munchivesinaa",
        "Nee cheyi pattukonedhaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దావీదువలె నాట్యముతో నిన్నే ఆరాధించెదా",
        "దానియేలువలె మూడు మార్లు నీకే ప్రార్ధించెదా",
        "శ్రమలే వచ్చి నన్ను కదిలించినా",
        "నీ సహాయముతో నే జయించెదా",
        "నిందలెన్నో నన్ను కృంగదీసినా",
        "నీ మార్గములో నడిచెదా"
      ],
      "english": [
        "Dhaaveedhuvale naatyamutho ninne aaraadhinchedhaa",
        "Dhaaniyeluvale moodu maarlu neeke praardhinchedhaa",
        "Shramale vachchi nannu kadhilinchinaa",
        "Nee sahaayamutho ne jayinchedhaa",
        "Nindhalenno nannu krungadeesinaa",
        "Nee maargamulo nadichedhaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా మార్గము నీవే నా గమ్యము నీవే",
        "నా వెలుగు నీవే ఆధారము నీవే",
        "నా సైన్యము నీవే నా ఖడ్గము నీవే",
        "నా ధైర్యము నీవే నా విజయము నీవే"
      ],
      "english": [
        "Naa maargamu neeve naa gamyamu neeve",
        "Naa velugu neeve aadhaaramu neeve",
        "Naa sainyamu neeve naa khadgamu neeve",
        "Naa dhairyamu neeve naa vijayamu neeve"
      ]
    }
  ]
}
