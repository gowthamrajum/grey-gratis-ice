{
  "song_name": "Kruthagnatha",
  "author": {
    "Authored by": "Suneeth Bobby",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కృతజ్ఞత స్తోత్రార్పణలు నీకే చెల్లింతును",
      "కృతజ్ఞత హృదయార్పణలు నీకే అర్పింతును",
      "మహోన్నతుడా – నీకే ఆరాధనా",
      "ప్రేమపూర్ణుడా – నీకే ఆరాధనా …ఆ …ఆ",
      "ఆరాధనా ఆరాధనా – నీకె నా యేసయ్యా"
    ],
    "english": [
      "Krutagnatha sthothraarpanalu neeke chellinthunu",
      "Krutagnatha hrudayaarpanalu neeke arpinthunu",
      "Mahonnathuda – Neeke Aaradhanaa",
      "Prema poornuda – Neeke Aaradhana… aa… aa…",
      "Aaradhana Aaradhana – Neeke naa Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీదు ప్రేమను, నీదు కృపలను దినదినము నేను అనుభవిస్తున్నా",
        "యెహోవా యీరే గా – నాకు తోడుండి",
        "ప్రతి సమయమున – ప్రతి అవసరమును తీర్చుచున్నవాడా",
        "ఆరాధనా ఆరాధనా – నీకె నా యేసయ్యా"
      ],
      "english": [
        "Needu premanu, needu krupalanu",
        "dinadinamunu nenu anubhavisthunna",
        "Yehova Yeere gaa – naaku thodundi",
        "Prathi samayamuna – prathi avasaramunu theerchuchunnavadaa",
        "Aaradhana Aaradhana – Neeke naa Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాడు జీవమై, నాదు సర్వమై నీవై ఉండి బ్రతికించుచుంటివే",
        "యెహోవా ఎల్ షడ్డాయ్ – సర్వ శక్తిమంతుడా",
        "నూతన బలముతో – పరిశుద్ధాత్మతో అభిషేకించువాడా",
        "ఆరాధనా ఆరాధనా – నీకె నా యేసయ్యా"
      ],
      "english": [
        "Naadu jeevamai, naadu sarvamai,",
        "neevai undi brathikinchuchuntive",
        "Yehova El Shaddai – Sarva shakthimanthudaa",
        "Noothana balamutho – Parishuddhaathmatho abhishekinchuvadaa",
        "Aaradhana Aaradhana – Neeke naa Yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఏ అపాయము, నాగుడారము సమీపించకుండ కాపాడుచుంటివే",
        "యోహావ కాపారిగా – నా మార్గమంతటిలో",
        "నా చేయి విడువక – నను ధైర్య పరచి నడిపించుచున్నవాడా",
        "ఆరాధనా ఆరాధనా – నీకె నా యేసయ్యా"
      ],
      "english": [
        "Ye apaayamu, naagudaaramu",
        "sameepinchakunda kaapaaduchuntive",
        "Yehova Kaapaarigaa – naa maargamanthatilo",
        "Naa cheyi viduvaka – nannu dhairya parachu nadipinchuchunnavada",
        "Aaradhana Aaradhana – Neeke naa Yesayya"
      ]
    }
  ]
}
