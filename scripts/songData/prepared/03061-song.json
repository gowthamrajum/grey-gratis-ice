{
  "song_name": "Maemichchu Kaanukal Neevae Maakichchithi",
  "author": {
    "Authored by": "",
    "రచన": "విలియం వాల్షా హౌ"
  },
  "main_stanza": {
    "telugu": [
      "మేమిచ్చు కానుకల్ నీవే మాకిచ్చితి",
      "మా యాస్తియంత ప్రభువా నీ దానమే గదా."
    ],
    "english": [
      "Maemichchu Kaanukal Neevae Maakichchithi",
      "Maa Yaasthiyantha Prabhuvaa Nee Dhaanamae Gadhaa."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ వుచితంబుగా మా కిచ్చువాడవు",
        "అన్యుల కుచితంబుగా మేమిచ్చుచుందుము."
      ],
      "english": [
        "Nee Vuchithambugaa Maa Kichchuvaadavu",
        "Anyula Kuchithambugaa Maemichchuchundhumu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సర్వత్ర బీదలు అన్నంబునొందరు",
        "కన్నీళ్లు రాల్చు ప్రజలు అనేకులుందురు."
      ],
      "english": [
        "Sarvathra Beedhalu Annambunondharu",
        "Kanneellu Raalchu Prajalu Anaekulundhuru."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఈలాటివారికి సహాయమిచ్చుట",
        "దూతలు చేయు సేవకు సమానమగును."
      ],
      "english": [
        "Eelaativaariki Sahaayamichchuta",
        "Dhoothalu Chaeyu Saevaku Samaanamagunu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పోషించి బీదలన్ రక్షించి పాపులన్",
        "అందరిన్ సంరంక్షించుట శ్రీ యేసు కార్యమే."
      ],
      "english": [
        "Poashinchi Beedhalan Rakshinchi Paapulan",
        "Andharin Samrankshinchuta Shree Yaesu Kaaryamae."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా బీదవారికి నీవిచ్చు దానము",
        "నా కిత్తువను వాక్యము శ్రీ యేసు చెప్పెను."
      ],
      "english": [
        "Naa Beedhavaariki Neevichchu Dhaanamu",
        "Naa Kiththuvanu Vaakyamu Shree Yaesu Cheppenu."
      ]
    }
  ]
}
