{
  "song_name": "Yesuni jera vegamu raa maargamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "జి ఎఫ్ రూట్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "యేసుని జేరఁ వేగము రా",
      "మార్గముఁ జూపి వేదములో",
      "దాపున నుండి క్రీస్తు దయన్",
      "రమ్మని పిల్చును.",
      "|| సంతసంబు సంతసంబు బల్",
      "పాపశుద్ధి మేము పొందఁగా",
      "యేసుని యెద్దనుండ సదా",
      "మోక్ష పథంబున ||"
    ],
    "english": [
      "Yesuni jera vegamu raa",
      "maargamu joopi vedhamulo",
      "daapuna nundi Kreesthu dhayan",
      "rammani pilchunu.",
      "|| Santhasambu santhasambu bal",
      "paapashuddhi memu pondagaa",
      "Yesuni eddanunda sadaa",
      "moksha pathambuna ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "బాలురమైన మమ్మును దా",
        "నెంతటి ప్రేమతోఁ బిలుచున్",
        "యేసుని స్వీకరించుటకై",
        "వత్తుము వేగమే."
      ],
      "english": [
        "Baaluramaina mammunu dhaa",
        "nenthati prematho biluchun",
        "Yesuni sweekarinchutakai",
        "vatthumu vegame."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా ముద్దు బిడ్డ రమ్మనఁగా",
        "నాతని ప్రేమ కన్పడఁగా",
        "నాయన నేఁడు నిన్చిలువన్",
        "రానని యందువా? ||"
      ],
      "english": [
        "Naa muddu bidda rammanagaa",
        "naathani prema kanpadagaa",
        "naayana nedu nin chiluvan",
        "raanani yandhuvaa? ||"
      ]
    }
  ]
}
