{
  "song_name": "Ennenno melulatho nanu deevinchaavu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Sayaram Gattu"
    ],
    "రచన": [
      "సాయారం గట్టు"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఎన్నెనో మేలులతో నను దీవించావు",
      "నా జీవితకాలమంత యెరిగి ఉన్నావు",
      "ఏమిచ్చి నీ ఋణము నే తీర్చగలను",
      "ఎన్ని రీతులుగా కీర్తించగలను",
      "వందనాలు యేసయ్య నీకే",
      "శతకోటి స్తోత్రలయ్యా నీకే (2) || ఎన్నెనో మేలులతో ||"
    ],
    "english": [
      "Ennenno melulatho nanu deevinchaavu",
      "Naa jeevithakaalamantha erigi unnaavu",
      "Emichchi nee runamu ne theerchagalanu",
      "Enni reethulugaa keerthinchagalanu",
      "Vandanaalu Yesayya neeke",
      "Shathakoti sthothraalayyaa neeke (2) || Ennenno melulatho ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కష్టాల మార్గములో అలసిన పయణములో",
        "నిందలు మోయలేక కృంగిన సమయములో (2)",
        "సంపూర్ణముగా నాకు పరిశుద్దతనిచ్చావు",
        "సమాధాన కర్తవు నీవై నన్ను ఆదరించావు (2) || వందనాలు ||"
      ],
      "english": [
        "Kashtaala maargamulo alasina payanamulo",
        "Nindalu moyaleka krungina samayamulo (2)",
        "Sampoornamugaa naaku parishuddhathanichchaavu",
        "Samaadhaana karthavu neevai nannu aadarinchaavu (2) || Vandanaalu ||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏ గమ్యము ఎరుగని నా జీవిత యాత్రలో",
        "అలజడి అలలెన్నో చెలరేగెను నా మదిలో (2)",
        "కలవరమును కరిగించి, కరుణను కురిపించావు",
        "నా భయమును గద్దించి, నీ శాంతితో నింపావు (2) || వందనాలు ||"
      ],
      "english": [
        "E gamyamu erugani naa jeevitha yaathralo",
        "Alajadi alalenno chelaregenu naa madilo (2)",
        "Kalavaramunu kariginchi, karununu kuripinchaavu",
        "Naa bhayamunu gaddhinchi, nee shaanthitho nimpaavu (2) || Vandanaalu ||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కలిగేటి శోధనలు, కనపడని మార్గములు",
        "నీ వాక్యమే దీపముగా, సాగెను నా పాదములు (2)",
        "అపవాదిని నా చేత, ఓడింప జేసావు",
        "వాగ్దాన పూర్ణుడిగా జయ జీవిత మిచ్చావు (2) || వందనాలు ||"
      ],
      "english": [
        "Kaligeti shodhanalu, kanapadani maargamulu",
        "Nee vaakyame deepamugaa, saagenu naa paadamulu (2)",
        "Apavaadhini naa chetha, odimpa jesaavu",
        "Vaagdhaana poornudigaa jaya jeevitha michchaavu (2) || Vandanaalu ||"
      ]
    }
  ]
}
