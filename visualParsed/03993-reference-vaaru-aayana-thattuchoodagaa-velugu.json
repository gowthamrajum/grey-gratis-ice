{
  "song_name": "Vaaru aayana thattu choodagaane",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వారు ఆయన తట్టు చూడగానే - వారికి వెలుగు కలిగెను"
    ],
    "english": [
      "Vaaru aayana thattu choodagaane - Vaariki velugu kaligenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృపా సత్య సంపూర్ణుడగు ప్రభువు",
        "కాపాడును మనల ప్రతి శోధన నుండి",
        "చూపించు తన మహిమ నిత్యము మనకు",
        "స్థాపించును మనలను తన రాజ్యముగా"
      ],
      "english": [
        "Krupaa sathya sampoornudagu prabhuvu",
        "Kaapaadunu manala prathi shodhana nundi",
        "Choopinchu thana mahima nithyamu manaku",
        "Sthaapinchunu manalanu thana raajyamugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కనుగొంటివా నీవు దేవుని మహిమ",
        "తన కుమారుడైన యేసు ప్రభువులో",
        "తన ప్రజలను విడిపింప క్రీస్తేసు",
        "తనయుండై యిహమున జన్మించెను"
      ],
      "english": [
        "Kanugontivaa neevu Devuni mahima",
        "Thana kumaarudaina Yesu prabhuvulo",
        "Thana prajalanu vidipimpa Kreesthesu",
        "Thanayundai ihamuna janminchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అంత్య దినంబు వచ్చుచుండెను చూడు",
        "చింతించెదరు పాపులందరిలలో",
        "చింతించుచు నేడే పశ్చాత్తాపముతో రా",
        "వింత రక్షణను పొంది ఆనందింతువు"
      ],
      "english": [
        "Anthya dhinambu vachchuchundenu choodu",
        "Chinthinchedharu paapulandharilalo",
        "Chinthinchuchu nede pashchaatthaapamutho raa",
        "Vintha rakshananu pondi aanandhinthuvu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యెహోవా తేజస్సు ఆయన శక్తితో",
        "మహిమతో మందిరము నిండి యుండెను",
        "మహామహుని పాదముల నేడే వేడిన",
        "మహిమానందము పొంది సంతసింతువు"
      ],
      "english": [
        "Yehovaa thejassu aayana shakthitho",
        "Mahimatho mandiramu nindi yundenu",
        "Mahaamahuni paadamula nede vedina",
        "Mahimaanandhamu pondi santhasinthuvu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "క్రీస్తు యేసు ప్రజలకు యీ భువిని",
        "నీతి సూర్యుడు ఉదయించును మెండుగా",
        "అతని రెక్కలు ఆరోగ్యము నిచ్చును",
        "నిత్యము సంతోష గానము చేతురు"
      ],
      "english": [
        "Kreesthu Yesu prajalaku ee bhuvini",
        "Neethi sooryudu udhayinchunu mendugaa",
        "Athani rekkalu aarogyamu nichchunu",
        "Nithyamu santhosha gaanamu chethuru"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "రక్షింపబడిన ప్రభుని జనమా",
        "రక్షకుడేసుని స్వకీయ ధనమా",
        "రక్తముతో కొన్నట్టి క్రీస్తు సంఘమా",
        "ముక్తి దాతను శ్లాఘించి కొనియాడుము"
      ],
      "english": [
        "Rakshimpabadina prabhuni janamaa",
        "Rakshakudesuni swakeeya dhanamaa",
        "Rakthamutho konnatti Kreesthu sanghamaa",
        "Mukthi dhaathanu shlaaghinchi koniyaadumu"
      ]
    }
  ]
}
