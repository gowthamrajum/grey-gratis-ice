  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసూ నా ప్రభువా - నీ ప్రేమ లేకున్న",
        "నా యాత్మ కేదియు - విశ్రాంతి నియ్యదు",
        "ఒక్కొక్క గంట నేను - నిన్నాశించుకొందు",
        "నీ యాశీర్వాదమిమ్ము - నా రక్షకా"
      ],
      "english": [
        "Yesoo naa prabhuvaa - Nee prema lekunna",
        "Naa yaathma kedhiyu - Vishraanthi niyyadhu",
        "Okkokka ganta nenu - Ninnaashinchukondhu",
        "Nee yaasheervaadhamimmu - Naa rakshakaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేసూ, రేబగళ్ళు - నాయొద్ద నుండుము",
        "నాతో నీ వుండిన - ఏ భయముండదు"
      ],
      "english": [
        "Yesoo, rebagallu - Naayoddha nundumu",
        "Naatho nee vundina - E bhayamundadhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సుఖంబు బొందగా - నిన్నే యాశింతును",
        "దుఃఖంబు నొందగా నీవే శరణ్యము"
      ],
      "english": [
        "Sukhambu bondhagaa - Ninne yaashinthunu",
        "Dhuhkhambu nondhagaa neeve sharanyamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీదు మార్గమందున - నే నడ్వనేర్పుము",
        "నీ మాట చొప్పున - నన్నున్ దీవించుము"
      ],
      "english": [
        "Needu maargamandhuna - Ne nadvanerpumu",
        "Nee maata choppuna - Nannun dheevinchumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నిన్నే యాశింతును - యేసూ నా ప్రభువా",
        "నీ వంటి వాడనై - నన్నుండ జేయుము"
      ],
      "english": [
        "Ninne yaashinthunu - Yesoo naa prabhuvaa",
        "Nee vanti vaadanai - Nannunda jeyumu"
      ]
    }
  ]
}
