{
  "song_name": "Krupa Kaligina Deva",
  "author": {
    "Authored by": "King Joshua",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కృప కలిగిన దేవా నా యెహోవా",
      "కల్వరి నాధా నా యేసయ్యా",
      "నా ప్రార్ధన అలకించుమా",
      "నా పాప బంధాన్ని విడిపించుమా"
    ],
    "english": [
      "Krupa kaligina devaa naa yehovaa",
      "kalvari naadhaa naa yesayya",
      "naa praardhana aalakinchumaa",
      "naa paapa bandhaanni vidipinchumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కృపతో నన్ను కాయుము ప్రభువా",
        "నీ కృపతో నన్ను దరిచేర్చు యేసయ్య",
        "నీ కృపతో నన్ను రక్షించు ప్రభువా",
        "నీ కృపతో నన్ను నడిపించు యేసయ్యా",
        "నా పూర్ణ హృదయముతో స్తుతియించెదను",
        "నీ ఘన కార్యములు ప్రకటించెదను",
        "నీ అద్భుతములను వివరించెదను",
        "నీ దివ్య నామమునే కీర్తించెదను"
      ],
      "english": [
        "Nee krupatho nannu kaayumu prabhuvaa",
        "nee krupatho nannu dharicheruchu yesayya",
        "nee krupatho nannu rakshinchu prabhuvaa",
        "nee krupatho nannu nadipinchu yesayyaa",
        "naa poorna hrudhayamutho sthuthinchedhanu",
        "nee ghana kaaryamulu prakatinchedhanu",
        "nee adbhuthamulanu vivarinchedhanu",
        "nee divya naamamune keerthinchedhanu"
      ]
    }
  ]
}
