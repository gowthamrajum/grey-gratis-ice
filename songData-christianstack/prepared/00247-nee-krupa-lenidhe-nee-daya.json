{
  "song_name": "Nee Krupa Lenidhe Nee Daya",
  "author": {
    "Authored by": "Pastor. Samuel Nethala",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ కృప లేనిదే నీ దయ లేనిదే",
      "క్షణమైనా బ్రతుకలేనయ్య",
      "నేనేమైయున్నానో నాకెమున్నాను",
      "కేవలం నీ కృప",
      "యేసయ్యా యేసయ్యా నీ కృప చాలయ్యా"
    ],
    "english": [
      "Nee Krupa Lenide Nee Daya Lenide",
      "Kshanamainaa Bratukalenayya",
      "Nenemaayunnaano Naakemunnaanu",
      "Kevalam Nee Krupa",
      "Yesayya Yesayya Nee Krupa Chalayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాశనకరమైన గోతి నుండి",
        "నను లేవనెత్తినది నీ కృప",
        "నీ కృపలోనే నా జీవితం",
        "కడవరకు కొనసాగించెదన్",
        "యేసయ్యా యేసయ్యా నీ కృప చాలయ్యా",
        "ఏ దిక్కులేని నాకు సర్వము నీవే",
        "ఆదరించినది నీ కృప",
        "మాటరని నాకు రాగమునిచ్చి",
        "నీ కృపాను చాటె దన్యతనిచ్చావు",
        "యేసయ్యా యేసయ్యా నీ కృప చాలయ్యా"
      ],
      "english": [
        "Naashanakaramaina Goti Nundi",
        "Nanu Levanettinadi Nee Krupa",
        "Nee Krupalone Naa Jeevitam",
        "Kadavaraku Konasaginchedanu",
        "Yesayya Yesayya Nee Krupa Chalayya",
        "E Dikkuleni Naaku Sarvamu Neeve",
        "Aadarinchinadi Nee Krupa",
        "Maatarani Naaku Raagamunichchi",
        "Nee Krupanu Chaate Danyatanichchaavu",
        "Yesayya Yesayya Nee Krupa Chalayya"
      ]
    }
  ]
}
