  "main_stanza": {
    "telugu": [
      "ఎంతో వింత ఎంతో చింత -యేసునాధున్ మరణమంత=",
      "పంతముతోఁ జేసిరంతా-సొంత ప్రజలూ యేసునంత !!ఎంతో!!"
    ],
    "english": [
      "Entho vintha entho chintha -Yesunaadhun maranamantha=",
      "Panthamuthon jesiranthaa-Sontha prajaloo Yesunantha !!Entho!!"
