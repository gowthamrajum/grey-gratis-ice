{
  "song_name": "Prakaasha Vasthramuthoa Paraloaka Mahimathoa Loakambuna Kaethenchunu Maeghambupai Prabhuvae",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రకాశ వస్త్రముతో పరలోక మహిమతో",
      "లోకంబున కేతెంచును మేఘంబుపై ప్రభువే"
    ],
    "english": [
      "Prakaasha Vasthramuthoa Paraloaka Mahimathoa",
      "Loakambuna Kaethenchunu Maeghambupai Prabhuvae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంత్య సూచనలు చూడుము - ప్రభు రాకకు మునుపు",
        "క్రీస్తు నిశ్చయముగా వచ్చును - బూర శబ్దముతో",
        "విస్తరించు లోకమందు - యుద్ధము కరవులు",
        "విస్తరించు పాపములు దుహ్ఖము కలవరము"
      ],
      "english": [
        "Anthya Soochanalu Choodumu - Prabhu Raakaku Munupu",
        "Kreesthu Nishchayamugaa Vachchunu - Boora Shabdhamuthoa",
        "Vistharinchu Loakamandhu - Yudhdhamu Karavulu",
        "Vistharinchu Paapamulu Dhuhkhamu Kalavaramu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపముచే జన్మించిరి - తల్లి గర్భమునుండి",
        "కోపము దుష్టమోసము - ఎల్లరి హృదయములు",
        "పాప దృష్టి జారచోర - దేవదూషణ హత్యలు",
        "వేపుగా దుష్టగర్వముల్ - హృదయ రోగములు"
      ],
      "english": [
        "Paapamuchae Janminchiri - Thalli Garbhamunundi",
        "Koapamu Dhushtamoasamu - Ellari Hrudhayamulu",
        "Paapa Dhrushti Jaarachoara - Dhaevadhooshana Hathyalu",
        "Vaepugaa Dhushtagarvamul - Hrudhaya Roagamulu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వెళ్ళరు పరలోకమునకు - ఎవ్వరు పాపముతో",
        "చాలవు నీతి క్రియలు - ప్రార్థనలు రక్షింపవు",
        "చాలును యేసు రక్షింప - ప్రాణమర్పించెను",
        "కలుషములు కడుగును - తన రక్తము చిందించె"
      ],
      "english": [
        "Vellaru Paraloakamunaku - Evvaru Paapamuthoa",
        "Chaalavu Neethi Kriyalu - Praarthanalu Rakshimpavu",
        "Chaalunu Yaesu Rakshimpa - Praanamarpinchenu",
        "Kalushamulu Kadugunu - Thana Rakthamu Chindhinche"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్షణములోనే గతించును - జీవిత మేపాటిది",
        "తన యాస్తి విడచి నరుడు - నరకము పాలగున్",
        "నిన్ను రక్షింప నీ ప్రభు - సిద్ధముగ నిలిచె",
        "పెన్నుగ పొందుము రక్షణ - నమ్మి యేసు ప్రభువులో"
      ],
      "english": [
        "Kshanamuloanae Gathinchunu - Jeevitha Maepaatidhi",
        "Thana Yaasthi Vidachi Narudu - Narakamu Paalagun",
        "Ninnu Rakshimpa Nee Prabhu - Sidhdhamuga Niliche",
        "Pennuga Pondhumu Rakshana - Nammi Yaesu Prabhuvuloa"
      ]
    }
  ]
}
