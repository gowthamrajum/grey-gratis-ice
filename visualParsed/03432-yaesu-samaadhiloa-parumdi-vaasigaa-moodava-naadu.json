      "english": [
        "Yesu samaadhilo - Parundi",
        "Vaasigaa moodava - Naadu lechen",
        "Lechen samaadhinundi - Mruthyuvupai vijayamondi",
        "Shathruvu nodinchi jayashaaliyai - Nithyam jeevincha",
        "Madhyavarthiyai - Lechenu! lechenu! hallelooya!"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యర్థమే కావలి - సమాధియొద్ద",
