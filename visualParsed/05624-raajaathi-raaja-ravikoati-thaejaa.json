      "అందుకొనుము నాదు హృదయం (2) ||రాజాతి||"
    ],
    "english": [
      "Raajaathi raaja- Ravikoti theja",
      "Mahipaala o Yesuvaa",
      "Karunaa swabhaavaa - Ramaneeya Devaa",
      "Premaa swaroopa - O divya theja",
      "Arpinthunu naa jeevitham",
      "Andhukonumu naadu hrudayam (2) ||Raajaathi||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
