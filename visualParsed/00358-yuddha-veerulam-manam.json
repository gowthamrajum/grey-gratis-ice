{
  "song_name": "Yuddha Veerulam Manam",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Yesanna"
    ],
    "రచన": [
      "బ్రదర్ యేసన్న"
    ]
  },
  "main_stanza": {
    "telugu": [
      "యుద్ధ వీరులం - మనము యుద్ధ వీరులం",
      "మహిమాత్మను పొందిన ప్రార్థనా వీరులం",
      "భయపడము జడియము",
      "అపవాడిని ఎదిరించే ఆత్మఖడ్గ యోధులం"
    ],
    "english": [
      "Yuddha veerulam - Manamu yuddha veerulam",
      "Mahimaathmanu pondina praarthanaa veerulam",
      "Bhayapadamu jadiyamu",
      "Apavaadhini edhirinche aathmakhadga yodhulam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృపకు ఆధారమగు - ఆత్మ పొందియున్నాము",
        "పిరికి ఆత్మను పొంది - బానిసలము కాలేదు",
        "బలహీనతలో - మనము బలవంతులమయ్యాము",
        "శక్తిమంతుడగు యేసు - మనలో నిలిచి యుండగా  ||యుద్ధ||"
      ],
      "english": [
        "Krupaku aadhaaramagu - Aathma pondhiyunnaamu",
        "Piriki aathmanu pondi - Baanisalamu kaaledhu",
        "Balaheenathalo - Manamu balavanthulamayyaamu",
        "Shakthimanthudagu Yesu - Manalo nilichi yundagaa  ||Yuddha||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విస్వాసమనే డాలు చేతితో పట్టుకొని",
        "మహిమ శిరస్త్రాణమును - యేసువలన పొందాము",
        "సర్వాంగ కవచమును - ధరించుకొని యున్నాము",
        "స్వీకృత పుత్రాత్మయే - జయం మనకు ఇవ్వగా  ||యుద్ధ||",
        "హోసన్నా - హోసన్నా - హోసన్నా",
        "యోధులమై సాగిపోదము"
      ],
      "english": [
        "Vishvaasamane daalu chethitho pattukoni",
        "Mahima shirasthraanamunu - Yesuvalana pondhaamu",
        "Sarvaanga kavachamunu - Dharinchukoni yunnaamu",
        "Sveekrutha puthraathmaye - Jayam manaku ivvagaa  ||Yuddha||",
        "Hosannaa - Hosannaa - Hosannaa",
        "Yodhulamai saagipodhamu"
      ]
    }
  ]
}
