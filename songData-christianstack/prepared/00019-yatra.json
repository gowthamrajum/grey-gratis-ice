{
  "song_name": "Yatra",
  "author": {
    "Authored by": "Hadlee Xavier",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా దీపము నీవు వెలిగించితివి",
      "తేజోమయుడవు నాకు నీవే",
      "రారాజువై నా యజమానుడవై",
      "నడిపించిన ఈ నావ నీదే",
      "ఇక నా జీవితం నే సాగించెదా",
      "ఇలలోన నీ బాటలోనే",
      "ఇక ఈ లోక యాత్రంతా ముగిసేవరకు",
      "నీవుండు నాతోనే ప్రభువా"
    ],
    "english": [
      "Naa deepamu neevu veliginchithivi",
      "thejomayudavu naaku neeve",
      "raaraajuvai naa yajamaanudavai",
      "nadipinchina ee naava needhe",
      "ika naa jeevitham ne saagenchedhaa",
      "ilalona nee baatalone",
      "ika ee loka yaathrantha mugisevaraku",
      "neevundu naathone prabhuvaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీలోనే నన్ను నడిపించినావు",
        "నీతోనే యాత్రంత గడిచే",
        "నాకోసమేగా ఈ కల్వరి త్యాగం",
        "రక్షించి కాపాడినావా",
        "ఈ యాత్రలోనే పడిపోకుండా",
        "నీతోనే నడిపించు దేవా",
        "నీ శక్తితో నన్ను బలపరచుము దేవా",
        "బలము మహిమ నీవే"
      ],
      "english": [
        "Neelone nannu nadipinchinaavu",
        "neethone yaathrantha gadiche",
        "naakosamegaa ee kalvari thyaagam",
        "rakshinchi kaapaadinaavaa",
        "ee yaathralone padipokundaa",
        "neethone nadipinchu dhevaa",
        "nee shakthitho nannu balaparachumu dhevaa",
        "balamu mahima neeve"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీతోనే నన్ను పరలోకమందు",
        "స్వాస్థ్యముగా నన్నుచ్చి",
        "నీ వెలుగును గూర్చి సాక్ష్యమిచ్చి",
        "నీ సాక్షిగా నన్ను ఉండనిచ్చి",
        "ఈనాడు నీవు బ్రతికించినావు",
        "నీ సేవను నేను చేయ",
        "రుచి చూచి ఎరిగి బోధించినాను",
        "నా బోధకుడవు నీవే",
        "నీ స్నేహము అత్యున్నతము",
        "నీకంటే బలశూరులు లేరే",
        "ప్రేమంతయు నీవు నాకిచ్చితివి",
        "ప్రేమామయుడవు నీవు యేసు"
      ],
      "english": [
        "Neethone nannu paralokamandu",
        "swaasthyamugaa nannuchchi",
        "nee velugunu goorchi saakshyamichchi",
        "nee saakshigaa nannu undanichchi",
        "eenaadu neevu brathikinchinaavu",
        "nee sevanu nenu cheya",
        "ruchi choochi erigi bodhinchinaanu",
        "naa bodhakudavu neeve",
        "nee snehamu athyunnathamu",
        "nee kante balashoorulu lere",
        "premanthayu neevu naakichchithivi",
        "premaamayudavu neevu yesu"
      ]
    }
  ]
}
