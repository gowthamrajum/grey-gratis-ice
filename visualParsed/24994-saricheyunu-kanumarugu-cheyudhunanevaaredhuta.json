{
  "song_name": "Saricheyunu - Kanumarugu cheyudhunanevaaredhuta",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor John Jebaraj"
    ],
    "రచన": [
      "పాస్టర్ జాన్ జెబరాజ్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "కనుమరుగు చేయుదుననేవారెదుట,",
      "ఎనలేని వృద్ధిచేయు దేవా",
      "నిన్ను కనుమరుగు చేయుదుననేవారెదుట",
      "ఎనలేని వృద్ధిచేయు దేవా",
      "సరిచేయ జాలని నీ బ్రతుకు",
      "సరిపరచ తానే వచ్చుచున్నాడు"
    ],
    "english": [
      "Kanumarugu cheyudhunanevaaredhuta,",
      "Enaleni vruddhicheyu Deva",
      "Ninnu kanumarugu cheyudhunanevaaredhuta",
      "Enaleni vruddhicheyu Deva",
      "Saricheya jaalani nee brathuku",
      "Sariparacha thaane vachchuchunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓహో సరిచేయును స్థిరపరచును బలపరచి పూర్ణునిచేయున్",
        "నిన్ను సరిచేయును స్థిరపరచును బలపరచి పూర్ణునిచేయున్",
        "నిన్ను బలపరచి పూర్ణునిచేయున్"
      ],
      "english": [
        "Oho saricheyunu sthiraparachunu balaparachi poornunicheyun",
        "Ninnu saricheyunu sthiraparachunu balaparachi poornunicheyun",
        "Ninnu balaparachi poornunicheyun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అల్పకాలం పాటు, పొందిన శ్రమలన్ని",
        "మంచువలె నీ యెదుట కరిగిపోవున్",
        "నీ కష్టము, నష్టము అన్నియును తీరున్",
        "క్షేమములె నీ దరిచేరున్"
      ],
      "english": [
        "Alpakaalam paatu, pondina shramalanni",
        "Manchuvale nee eduta karigipovun",
        "Nee kashtamu, nashtamu anniyunu theerun",
        "Kshemamule nee daricherun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఖ్యాతిని అణచివేయు, కూటములు అన్నియును",
        "యేసు నీ తోడని తలలు వంచున్",
        "విరోధులు చేసిన గాయములు మానున్",
        "నీ ఖ్యాతి నీ దరిచేరున్"
      ],
      "english": [
        "Khyaathini anachiveyu, kootamulu anniyunu",
        "Yesu nee thodani thalalu vanchun",
        "Virodhulu chesina gaayamulu maanun",
        "Nee khyaathi nee daricherun"
      ]
    }
  ]
}
