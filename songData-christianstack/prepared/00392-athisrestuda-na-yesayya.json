{
  "song_name": "Athisrestuda Na Yesayya",
  "author": {
    "Authored by": "K Y Ratnam, Snigdha Ratnam",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అతి శ్రేష్ఠుడా నా యేసయ్యా",
      "మహాఘనుడా మహోన్నతుడా",
      "నీ కార్యములు గంభీరముల్",
      "గళమెత్తి స్వరమెత్తి నే పాడెదన్"
    ],
    "english": [
      "Athisrestuda na yesayya",
      "mahaaghanudhaa mahonnathudaa",
      "nee kaaryamulu gambheeramul",
      "galamethi swaramethi ne paadedhan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతులు చెల్లించగానే యెరికో గోడలు కూలెనే",
        "కీర్తనలు పాడగానే చెరసాల బ్రద్దలాయే",
        "నీ జనుల ముందు శత్రువులే నిలుచునా",
        "నీ బలము ముందు బందకాలుండునా",
        "బందకాలుండునా",
        "గళమెత్తి స్వరమెత్తి నే పాడెదన్",
        "నీ ముందు నిలిపిన దాగోను ముక్కలాయెనుగా",
        "నిన్ను చూసిన సేనా దెయ్యాలు వణికి పోయెనుగా",
        "నీ శక్తి ముందు ఏదైనా నిలుచునా",
        "నీ అగ్ని అన్నిటిని దహించి వేయునుగా",
        "దహించి వేయునుగా",
        "గళమెత్తి స్వరమెత్తి నే పాడెదన్",
        "సియోనులోనుండి మమ్ము ఆశీర్వదించితివి",
        "శిథిలమైన బ్రతుకులను శిఖరముపై నిలిపితివి",
        "నీ మహిమముందు శాపమే నిలుచునా",
        "కృపవెంబడి కృపతో నడుపుచున్నావయ్యా",
        "నడుపుచున్నావయ్యా",
        "గళమెత్తి స్వరమెత్తి నే పాడెదన్"
      ],
      "english": [
        "Sthuthulu chellinchagaane yeriko godalu koolene",
        "keerthanalu paadagaane cherasaala braddhalaaye",
        "nee janula mundhu sathruvule niluchunaa",
        "nee balamu mundhu bandhakaalundunaa",
        "bandhakaalundunaa",
        "galamethi swaramethi ne paadedhan",
        "Nee mundhu nilipina dhaagonu mukkalaayenugaa",
        "ninnu choosina sena dheyyaalu vaniki poyenugaa",
        "nee sakthi mundhu edhyaina niluchunaa",
        "nee agni annitini dhayinchi veyunugaa",
        "dhayinchi veyunugaa",
        "galamethi swaramethi ne paadedhan",
        "Siyonulo nundi mammu aaseervadhinchithivi",
        "sithilamaina brathukulanu sikaramupai nilipithivi",
        "nee mahima mundhu saapame niluchunaa",
        "krupa vembadi krupatho nadupuchunnaavayyaa",
        "nadupuchunnaavayyaa",
        "galamethi swaramethi ne paadedhan"
      ]
    }
  ]
}
