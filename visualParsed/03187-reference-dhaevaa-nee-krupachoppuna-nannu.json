{
  "song_name": "Devaa nee krupachoppuna nannu karunimpumu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృప చొప్పున నా అతిక్రమ - ములను తుడిచివేయుము",
        "యెహోవా నా దేవా"
      ],
      "english": [
        "Krupa choppuna naa athikrama - Mulanu thudichiveyumu",
        "Yehova naa Devaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీకు విరోధముగానే - పాపము చేసియున్నాను",
        "నీ దృష్టి యెడల చెడు - తనము నే చేసియున్నాను"
      ],
      "english": [
        "Neeku virodhamugaane - Paapamu chesiyunnaanu",
        "Nee drushti edala chedu - Thanamu ne chesiyunnaanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆజ్ఞ యిచ్చునపుడు - నీతిమంతుడవుగను",
        "తీర్పు తీర్చునపుడు నిర్మలుడవుగ నుందువు"
      ],
      "english": [
        "Aagna ichchunapudu - Neethimanthudavuganu",
        "Theerpu theerchunapudu nirmaludavuga nundhuvu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపములోనే పుట్టిన - వాడను పాపములోనే",
        "నాదు తల్లి నన్ను గర్భము ధరియించెను"
      ],
      "english": [
        "Paapamulone puttina - Vaadanu paapamulone",
        "Naadu thalli nannu garbhamu dhariyinchenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ వంతరంగమున - సత్యము కోరుచున్నావు",
        "ఆంతర్యములో నాకు జ్ఞనము తెలియజేయుదువు"
      ],
      "english": [
        "Nee vantharangamuna - Sathyamu koruchunnaavu",
        "Aantharyamulo naaku gnaanamu theliyajeyudhuvu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హిస్సోపుతో శుద్ధీకరించు - పవిత్రుడనగుదును",
        "హిమము కంటె తెల్లగా నుండునట్లు కడుగుము"
      ],
      "english": [
        "Hissoputho shuddheekarinchu - Pavithrudanagudhunu",
        "Himamu kante thellagaa nundunatlu kadugumu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ఉత్సాహ సంతోషములు - నాకు వినిపింపుము",
        "అప్పుడు నీవు విరిచిన - యెముకలు హర్షించును"
      ],
      "english": [
        "Uthsaaha santhoshamulu - Naaku vinipimpumu",
        "Appudu neevu virichina - Emukalu harshinchunu"
      ]
    }
  ]
}
