{
  "song_name": "Naa Vedhanalo Vedhikithini",
  "author": {
    "Authored by": "Bro  Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా వేదనలో - వెదకితిని శ్రీ యేసుని - పాదాలను",
      "నా మనస్సులో - కోరితిని నీ రూపమునే - దీనుడనై",
      "నీ రూపమునే - దీనుడనై",
      "నా వేదనలో - వెదకితిని"
    ],
    "english": [
      "Naa Vedanalo - Vedakithini Sri Yesuni - Paadaalanu",
      "Naa Manassulo - Korithini Nee Roopamune - Deenudanai",
      "Nee Roopamune - Deenudanai",
      "Naa Vedanalo - Vedakithini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వేకు జాములో - విలపించితిని",
        "నా పాపములో - వ్యసనములో -2",
        "ఓదార్చుము - విసుగొందక",
        "నీ కృపలో - నా ప్రభువా -2"
      ],
      "english": [
        "Veku Jaamulo - Vilapinchithini",
        "Naa Paapamulo - Vyasanamulo -2",
        "Odaarchumu - Visugondaka",
        "Nee Krupalo - Naa Prabhuvaa -2"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ హస్తములో - నిదురింప జేయుమా",
        "నీ ప్రేమలో - లాలించుమా -2",
        "ఓదార్చుము - విసుగొందక",
        "నీ కృపలో - నా ప్రభువా -2"
      ],
      "english": [
        "Nee Hasthamulo - Nidurimpa Jeyumaa",
        "Nee Premalo - Laalinchumaa -2",
        "Odaarchumu - Visugondaka",
        "Nee Krupalo - Naa Prabhuvaa -2"
      ]
    }
  ]
