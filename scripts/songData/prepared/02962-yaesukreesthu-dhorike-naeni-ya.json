{
  "song_name": "Yaesukreesthu Dhorike Naeni",
  "author": {
    "Authored by": "",
    "రచన": "గొల్లపల్లి నతానియేలు"
  },
  "main_stanza": {
    "telugu": [
      "యేసుక్రీస్తు దొరికె నేని యేమికొదువింకేమి భయము",
      "దోసకారి జనుల కెంతోఁ గ్రాసమవునా యేసు పేరు"
    ],
    "english": [
      "Yaesukreesthu Dhorike Naeni Yaemikodhuvinkaemi Bhayamu",
      "Dhoasakaari Janula Kenthoa Graasamavunaa Yaesu Paeru"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తల్లిదండ్రులకన్న చాలాఁ దన ప్రేమ మనమీద",
        "నెల్లకాలమందు నుంచు యేసుఁడే మా తండ్రియౌను"
      ],
      "english": [
        "Thallidandrulakanna Chaalaa Dhana Praema Manameedha",
        "Nellakaalamandhu Nunchu Yaesudae Maa Thandriyaunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వల్లగాని వశములేని యెల్ల మేళ్లన్నిటి నెల్లపుడు",
        "కొల్లగా మన కిచ్చెడి దేవ కొమరుఁడే వేరెవరు లేరు"
      ],
      "english": [
        "Vallagaani Vashamulaeni Yella Maellanniti Nellapudu",
        "Kollagaa Mana Kichchedi Dhaeva Komarudae Vaerevaru Laeru"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దండియైన గండములు మెండుగాను మముఁజుట్టిన",
        "తండ్రివలె మా దరికి వచ్చి గండములను గదిమిఁ బ్రోచున్"
      ],
      "english": [
        "Dandiyaina Gandamulu Mendugaanu Mamujuttina",
        "Thandrivale Maa Dhariki Vachchi Gandamulanu Gadhimi Broachun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సత్యము మార్గముతానె నిత్యజీవమింకా తానే",
        "భ్రుత్యుల మనకీయ మోక్షము భువిని రక్తమంత గార్చె"
      ],
      "english": [
        "Sathyamu Maargamuthaane Nithyajeevaminkaa Thaanae",
        "Bhruthyula Manakeeya Moakshamu Bhuvini Rakthamantha Gaarche"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఎన్నరాని పాపాత్ముల కన్నులారా కనికరించి",
        "పున్నెమైన తన ప్రాణము భువిని బలిపెట్టినాఁడు"
      ],
      "english": [
        "Ennaraani Paapaathmula Kannulaaraa Kanikarinchi",
        "Punnemaina Thana Praanamu Bhuvini Balipettinaadu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఒడలు నిండా గాయములతో నడరు చుండమరల లేచి",
        "వెడలి పరమందునుండి వేడుకలు మాకంపినాఁడు"
      ],
      "english": [
        "Odalu Nindaa Gaayamulathoa Nadaru Chundamarala Laechi",
        "Vedali Paramandhunundi Vaedukalu Maakampinaadu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆశతోడఁ తన్ను నమ్ము యాత్మలకు దర్శనమిచ్చెడి",
        "యేసుతో నింకెవరు సాటి లేశమైనా లేరుసుండీ"
      ],
      "english": [
        "Aashathoada Thannu Nammu Yaathmalaku Dharshanamichchedi",
        "Yaesuthoa Ninkevaru Saati Laeshamainaa Laerusundee"
      ]
    }
  ]
}
