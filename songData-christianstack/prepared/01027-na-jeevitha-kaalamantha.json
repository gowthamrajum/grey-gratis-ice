{
  "song_name": "Na Jeevitha Kaalamantha",
  "author": {
    "Authored by": "Joel Kodali",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా జీవిత కాలమంత",
      "నిను కీర్తించిన చాలునా",
      "నా సమస్త సంపద",
      "నీకిచ్చిన చాలునా",
      "యేసు నీదు మేలులకై",
      "నే బదులుగా ఏమిత్తును",
      "నా దేహమే యాగముగా",
      "అర్పించినా చాలునా      || నా జీవిత ||"
    ],
    "english": [
      "Na jeevitha kaalamantha",
      "ninu keerthinchina chaalunaa",
      "na samastha sampadha",
      "neekichchina chaalunaa",
      "yesu needhu melulakai",
      "ne badhulugaa emitthunu",
      "naa dhehame yaagamugaa",
      "arpinchinaa chaalunaa      || naa jeevitha ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా బాల్యమంతా నా తోడుగ నిలిచి",
        "ప్రతి కీడు నుండి తప్పించినావు",
        "యవ్వనకాలమున నే త్రోవ తొలగిన",
        "మన్నించి నాతోనే కొనసాగినావు",
        "ఎన్నో శ్రమలు ఆపదలన్నిటిలో",
        "నను ధైర్యపరచి నను ఆదుకొన్నావు",
        "యేసు నీవె నీవె యేసు నీవె నా సర్వస్వము || నా జీవిత ||",
        "కన్నీటి రాత్రులు నే గడిపిన వెంటనే",
        "సంతోష ఉదయాలు నాకిచ్చినావు",
        "హృదయాషలన్నీ నెరవేర్చినావు",
        "యోగ్యుడను కాకున్న హెచ్చించినావు",
        "ఎంతో ప్రేమ మితిలేని కృపను",
        "నాపై చూపించి నను హత్తుకొన్నావు",
        "యేసు నీవె నీవె యేసు నీవె నా ఆనందము || నా జీవిత ||"
      ],
      "english": [
        "na baalyamanthaa naa thoduga nilichi",
        "prathi keedu nundi tappinchinaavu",
        "yavvanakaalamuna ne throva tholagina",
        "manninchi naathone konasaaginaavu",
        "enno sramalu aapadalannitilo",
        "nanu dhairyaparachi nanu aadhukonnaaavu",
        "yesu neeve neeve yesu neeve naa sarwaswamu || naa jeevita ||",
        "kanneeti raathrulu ne gadipina ventane",
        "santhosha udayaalu naakichchinaavu",
        "hrudayaashalanni neraverchinaavu",
        "yogyudanu kaakunna hechinchinaavu",
        "entho prema mithileni krupanu",
        "naapai choopinchi nanu hatthukonnaavu",
        "yesu neeve neeve yesu neeve naa aanandamu || naa jeevita ||"
      ]
    }
  ]
}
