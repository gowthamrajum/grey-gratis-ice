      ],
      "english": [
        "Naligina vaariki neeve mahaa durgamu",
        "Daari thappina vaariki krupaa maargamu",
        "Nannu nadipinchu neeve naa praanamu (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
