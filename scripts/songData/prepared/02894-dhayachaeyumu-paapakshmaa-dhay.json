{
  "song_name": "Dhayachaeyumu Paapakshamaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దయచేయుము పాపక్షమా దయచేయుము పాప క్షమా",
      "యేసుని రక్తము రక్తము వల్లనే"
    ],
    "english": [
      "Dhayachaeyumu Paapakshamaa Dhayachaeyumu Paapa Kshamaa",
      "Yaesuni Rakthamu Rakthamu Vallanae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తుడుపుము పాపపుడాగులు తుడువుము పాపపుడాగులు"
      ],
      "english": [
        "Thudupumu Paapapudaagulu Thuduvumu Paapapudaagulu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అనుగ్రహించు జయంసదా అనుగ్రహించు జయంసదా"
      ],
      "english": [
        "Anugrahinchu Jayamsadhaa Anugrahinchu Jayamsadhaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇమ్ము నిజసమాధానము ఇమ్ము నిజసమాధానము"
      ],
      "english": [
        "Immu Nijasamaadhaanamu Immu Nijasamaadhaanamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరమపురిని జేరనిమ్ము పరమపురిని జేరనిమ్ము"
      ],
      "english": [
        "Paramapurini Jaeranimmu Paramapurini Jaeranimmu"
      ]
    }
  ]
}
