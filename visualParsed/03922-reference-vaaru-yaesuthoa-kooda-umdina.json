  "main_stanza": {
    "telugu": [
      "యేసు మనతోనుండగ ధైర్యముగా సాగుచు",
      "కఠిన మార్గమైనను వెనుకకు తిరుగము"
    ],
    "english": [
      "Yesu manathonundaga dhairyamugaa saaguchu",
      "Katina maargamainanu venukaku thirugamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాత సంగతులన్నియు గతించె మరల రావుగ",
