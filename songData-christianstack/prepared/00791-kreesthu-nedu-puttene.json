{
  "song_name": "Kreesthu Nedu Puttene",
  "author": {
    "Authored by": "Samuel Karmoji",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తు నేడు పుట్టెనె రక్షణ దొరికెనే",
      "వేదాలు ఘోషించే కన్యక పుత్రుడే"
    ],
    "english": [
      "Kreesthu nedu puttene rakshana dhorikene",
      "vedhaalu ghoshinche kanyaka puthrude"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకటి తెరలు తొలగిపోయి వెలుగు కలిగెనె",
        "మా మంచి రాజు మనసున్న యేసు",
        "మాకై నేడు పుట్టెను చూడు"
      ],
      "english": [
        "Cheekati theralu tholagipoyi velugu kaligene",
        "maa manchi raaju manasunna yesu",
        "maakai nedu puttenu choodu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆహా ఆనందం ఓహో క్రిస్మస్ సంబరం"
      ],
      "english": [
        "aahaa aanandham oho christmas sambaram"
      ]
    }
  ]
}
