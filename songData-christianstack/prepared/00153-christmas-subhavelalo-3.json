{
  "song_name": "Christmas Subhavelalo-3",
  "author": {
    "Authored by": "Suresh Nittala",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసుని జన్మదినం లోకానికే పర్వదినం",
      "పరిశుద్ధుని ఆగమనం లోకపాప పరిహారం"
    ],
    "english": [
      "Yesuni janmadhinam lokaanikey parvadhinam",
      "Parishuddhuni aagamanam lokapaapa parihaaram"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "HAPPY CHRISTMAS… HAPPY CHRISTMAS…",
        "MERRY CHRISTMAS… MERRY CHRISTMAS…",
        "HAPPY CHRISTMAS… JOYFUL CHRISTMAS…"
      ],
      "english": [
        "HAPPY CHRISTMAS… HAPPY CHRISTMAS…",
        "MERRY CHRISTMAS… MERRY CHRISTMAS…",
        "HAPPY CHRISTMAS… JOYFUL CHRISTMAS…"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జన్మించే సర్వోన్నతుడు రక్షకుడై ఈ భువి లో",
        "నరరూపిగా దీనునిగా బేత్లేహేమను గ్రామంలో",
        "ఇమ్మానుయేలుగా ఆ దావీదు వంశములో"
      ],
      "english": [
        "Janminche sarvonnathudu rakshakudai ee bhuvi lo",
        "Nararupigaa deenunigaa Bethlehemanu graamamlo",
        "Immaanuyelugaa aa Dhaavidhu vamsamulo"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సర్వోన్నతమైన స్థలములలో దేవునికే మహిమ",
        "భూమి మీద ప్రజలందరికి శాంతి సమాధానము",
        "కలుగునుగాక ఆ దూతలి స్తోత్రించిరి"
      ],
      "english": [
        "Sarvonnathamainaa sthalamulalo dhevunikey mahima",
        "Bhoomi meedh prajalandhariki shanthi samaadhaanamu",
        "Kalugunugaaka aa dhoothalu sthothrinchiri"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనసారా స్తుతించేదం ప్రభుల ప్రభువని",
        "కొనియాడుచు కీర్తించెదం రాజులకే రాజని",
        "ప్రభు యేసు జన్మదినం మనకెంతో ఆనందం"
      ],
      "english": [
        "Manasaaraa sthuthinchedam prabhula prabhuvani",
        "Koniyaaduchu keerthinchedham raajulake raajani",
        "Prabhu Yeshu janmadhinam manakentho aanandam"
      ]
    }
  ]
}
