      "english": [
        "Bhoomyaakaashamulu pattani vyomapeethudu bhuviki vachchen",
        "Neethitho raajyamu nelutaku",
        "Jyothithoda lona vachchunesu nedu vachchu nesu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాట చాటింపన్ ఆశతో నిన్నాహ్వానింపన్",
        "ఫలము లనేకము లర్పించన్",
        "ఎల్లరిలోన ప్రవేశించుము ప్రవేశించుము"
      ],
      "english": [
        "Hallelooya paata chaatimpan aashatho ninnaahvaanimpan",
        "Phalamu lanekamu larpinchan",
        "Ellarilona praveshinchumu praveshinchumu"
      ]
    }
  ]
