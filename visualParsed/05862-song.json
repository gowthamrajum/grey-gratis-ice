{
  "song_name": "Muddulolike chinni notitho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ముద్దులోలికే చిన్ని నోటితో – మృదువైన పెదవులతో",
      "అబద్దాలు చెప్పొద్దు – నిజమే చెప్పాలి"
    ],
    "english": [
      "Muddulolike chinni notitho – Mrudhuvaina pedhavulatho",
      "Abaddhaalu cheppoddhu – Nijame cheppaali"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అబద్ధమాడిన గెహజి – కుష్టరోగి ఐనాడు",
        "అననీయ సప్పిర చచ్చిపోయారు",
        "అబద్దాలు నేర్పేవాడు మన విరోధి సాతానె",
        "అబద్ధమాడిన వారు అగ్నిగుండములో పడతారు/ముద్దు/"
      ],
      "english": [
        "Abaddhamaadina Gehaji – kushtarogi ainaadu",
        "Ananeeya Sappira chachchipoyaaru",
        "Abaddhaalu nerpevaadu mana virodhi Saathaane",
        "Abaddhamaadina vaaru agnigundamulo padathaaru/Muddu/"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సత్యమంటే యేసయ్యే – సత్యసాక్షి ఐయ్యాడు",
        "సత్యమునే చెప్పాడు – సిలువపై మరణించాడు",
        "ప్రాణం పోతున్నా గాని – నిజమే చెప్పాలి",
        "దేవుని మెప్పుని కోరాలి – జీవ కిరీటం పొందాలి /ముద్దు/"
      ],
      "english": [
        "Sathyamante Yesayye – Sathyasaakshi aiyyaadu",
        "Sathyamune cheppaadu – Siluvapai maraninchaadu",
        "Praanam pothunnaa gaani – Nijame cheppaali",
        "Devuni meppuni koraali – Jeeva kireetam pondaali /Muddu/"
      ]
    }
  ]
}
