  },
  "main_stanza": {
    "telugu": [
      "ఎవరు జయించెదరో",
      "వారే సమస్తమును పొందెదరు"
    ],
    "english": [
      "Evaru jayinchedharo",
      "Vaare samasthamunu pondedaru"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎవరు కష్ట బాధ లోర్చెదరో",
        "పట్టువదలక ప్రభుతో నుండు వారే",
        "దిట్టముగా నత్యధిక విజయమును పొంది",
        "గట్టిగా నిలిచెదరు వారెల్లరు ప్రభులో"
      ],
      "english": [
        "Evaru kashta baadha lorchedharo",
        "Pattuvadhalaka Prabhutho nundu vaare",
        "Dittamugaa nathyadhika vijayamunu pondi",
        "Gattigaa nilichedharu vaarellaru Prabhulo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎవరు శోధనలను జయింతురో",
        "జీవమకుటము వారే పొందెదరు",
        "పావనుడైన పరమ క్రీస్తేసు తోడ",
        "పరిపాలింతురు ప్రభుని దివ్య రాజ్యములో"
      ],
      "english": [
        "Evaru shodhanalanu jayinthuro",
        "Jeevamakutamu vaare pondedaru",
        "Paavanudaina parama Kreesthesu thoda",
        "Paripaalinthuru Prabhuni divya raajyamulo"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎవరు లోకాశలను జయింతురో",
        "వారే సైతానును ఓడింతురు",
        "పరిపూర్ణముగా ప్రభుని బలము గలవారై",
        "పరలోక స్వాస్థ్యమును పొందెదరు"
      ],
      "english": [
        "Evaru lokaashalanu jayinthuro",
        "Vaare Saithaanunu odinthuru",
        "Paripoornamugaa Prabhuni balamu galavaarai",
        "Paraloka svaasthyamunu pondedaru"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఎవరు క్రీస్తేసు సంబంధులో",
        "వారే పాప మరణము జయింతురు",
        "ఓ మరణమా నీ ముల్లెక్కడ యనుచు",
        "వీక్షింతురు పరమ విభుని రాకడ కొరకై"
      ],
      "english": [
        "Evaru Kreesthesu sambandhulo",
        "Vaare paapa maranamu jayinthuru",
        "O maranamaa nee mullekkada yanuchu",
        "Veekshinthuru parama vibhuni raakada korakai"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఎవరు ప్రభు సేవను చేసెదరో",
        "వారే పొందెదరు బహుమానము",
        "ఓరిమి కలిగి పరుగును ముగించి",
        "మురిసెదరు హల్లెలూయ పాటలతో"
      ],
      "english": [
        "Evaru Prabhu sevanu chesedharo",
        "Vaare pondedaru bahumaanamu",
        "Orimi kaligi parugunu muginchi",
        "Murisedharu hallelooya paatalatho"
      ]
    }
  ]
