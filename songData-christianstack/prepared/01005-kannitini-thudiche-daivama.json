{
  "song_name": "Kannitini Thudiche Daivama",
  "author": {
    "Authored by": "Pastor Vinod Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నాకై దీనునిగా భువికి వచ్చినావయా",
      "పశువుల పాకలో పుట్టిన యేసయ్య",
      "దివారాత్రములు స్తుతికి అర్హుడు నీవయ్య",
      "స్తిరమైన ఇల్లు నీకు లేకుండెనా"
    ],
    "english": [
      "Nakai dheenuniga bhuviki vacchinavaiya",
      "Pasuvula paakalo puttina yesayya",
      "Dhiva rathramulu stuthiki arhudu neevaiya",
      "Sthiramaina illu neeku lekundena"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశపక్షులకు గూళ్ళు ఉండే",
        "నక్కలకు బొరియలుండే",
        "మనుష్యకుమారునికి స్థలమే లేకుండెనే",
        "భూమి పునాదులు వేసినవానికి",
        "సృష్టినంతటిని చేసిన వానికి",
        "పశువుల పాకే మిగిలెనే"
      ],
      "english": [
        "Akasha pakshulaku goollu unde",
        "Nakkalaku boriyalunde manushakumaruniki",
        "Sthalame lekundene",
        "Bhumi punadhulu vesinavaniki",
        "srushtinanthatini chesinavaniki",
        "Pashuvula paake migilene"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఐనా నీవు తిరిగి వెళ్ళలేదయ్య",
        "ఐనా నీవు విడిచి వెళ్ళలేదయ్య",
        "మాతో నివసించినావయ్య"
      ],
      "english": [
        "Aina neevu thirigi vellaledhaiya",
        "Aina neevu vidachi vellaledhaiya",
        "Matho nivasinchinavayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కన్నీటిని తుడిచే దైవమా",
        "కిరిటము విడచినావుగ",
        "కృంగి పడిన వేళలో",
        "కదలి వచ్చినావయ్య",
        "నలిగిన రెళ్ళును విరువవు",
        "నీ ప్రేమతో చేర్చుకొందువు",
        "అనాదగా ఎన్నడు విడువవు",
        "ఆధారం నీవై ఉందువు"
      ],
      "english": [
        "Kanneetini tudiche daivama",
        "Kireetamu vidachinavuga",
        "Krungi padina velalo",
        "Kadhali vacchinavaiya",
        "Naligina rellunu viruvavu",
        "Nee prematho cherchukundhuvu",
        "Anadhaga ennadu viduvavu",
        "Aadharam neevai undhuvu"
      ]
    }
  ]
}
