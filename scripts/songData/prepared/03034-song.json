{
  "song_name": "Paapal Hoasannaa Paatal Paadina Reethigan",
  "author": {
    "Authored by": "",
    "రచన": "తియోడల్ప్ అర్లియన్స్"
  },
  "main_stanza": {
    "telugu": [
      "పాపల్ హోసన్నా పాటల్ పాడిన రీతిగన్",
      "నృపాలస్తుతి కీర్తుల్ నీకుఁ జెల్లింతుము",
      "దావీదు పుత్రకుండా యిశ్రాయేల్ పాలకా",
      "దేవుని పేర వచ్చు ధీరుండా ధన్యాత్మ."
    ],
    "english": [
      "Paapal Hoasannaa Paatal Paadina Reethigan",
      "Nrupaalasthuthi Keerthul Neeku Jellinthumu",
      "Dhaaveedhu Puthrakundaa Yishraayael Paalakaa",
      "Dhaevuni Paera Vachchu Dheerundaa Dhanyaathma."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూత లాకాశమందు దొడ్డగఁ గొల్తురు",
        "భూతలమందు సృష్టి పూజించును నిన్ను",
        "హెబ్రీయుల్ ఖర్జూరంపు శాఖల్ చేఁబూనుచు",
        "హెచ్చించి మొక్కినట్లు నిను స్తోత్రింతుము."
      ],
      "english": [
        "Dhootha Laakaashamandhu Dhoddaga Golthuru",
        "Bhoothalamandhu Srushti Poojinchunu Ninnu",
        "Hebreeyul Kharjoorampu Shaakhal Chaeboonuchu",
        "Hechchinchi Mokkinatlu Ninu Sthoathrinthumu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ శ్రమలకు ముందు, నిన్ గౌరవించిరి",
        "నీ జయమొందువెన్న మా కీర్తన స్తుతి",
        "అవ్వారి స్తుతుల్ నీవు అంగీకరించితి",
        "మా కీర్తంబుగూడ మన్నన జేయుమీ."
      ],
      "english": [
        "Nee Shramalaku Mundhu, Nin Gauravinchiri",
        "Nee Jayamondhuvenna Maa Keerthana Sthuthi",
        "Avvaari Sthuthul Neevu Angeekarinchithi",
        "Maa Keerthambugooda Mannana Jaeyumee."
      ]
    }
  ]
}
