{
  "song_name": "Prathi Roju Chudalani",
  "author": {
    "Authored by": "Prabhakar Khande",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రతి రోజు చూడాలని నా ప్రభువైన యేసయ్యను",
      "పలుమార్లు చూడాలని నా ప్రియుడైన యేసయ్యను",
      "తనివి తీర చూసినా నా యేసయ్య రూపం",
      "నా హృదయమే పొంగి పొర్లును",
      "నా మనసే సంతోషించును"
    ],
    "english": [
      "Prathi Roju chudalani naa prabhuvaina yesayyanu",
      "palumarlu chudalani naa priyudaina yesayyanu",
      "thanivi theera chusinaa naa yesayya roopam",
      "naa hrudayame pongi porlunu",
      "naa manase santhoshinchunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోకమందున పరిశుద్ధ",
        "దూతలతో",
        "పరిశుద్ధుడు పరిశుద్ధుడు అని స్తుతియించబడుచుండెను",
        "జీవ జలము యొద్దకు నడిపించును",
        "ప్రతి బాష్ప బిందువు తుడిచివేయును",
        "నా హృదయమే పొంగి పొర్లును",
        "నా మనసే సంతోషించును",
        "ఆకాశమందున రారాజుగా వచ్చును",
        "భూజనులందరు రొమ్ము కొట్టుకొనుచుందురు",
        "కడబూరధ్వని వినిపించును",
        "పరలోక సైన్యముతో వచ్చును",
        "నా హృదయమే పొంగి పొర్లును",
        "నా మనసే సంతోషించును"
      ],
      "english": [
        "Paralokamandhuna parishuddha dhuthalatho",
        "parishuddhudu parishuddhudhu ani sthuthiyinchabaduchundenu",
        "jeeva jalamu yoddhaku nadipinchunu",
        "prathi bashpabindhuvu thudachiveyunu",
        "naa hrudayame pongi porlunu",
        "naa manase santhoshinchunu",
        "Aakasamandhuna raraajugaa vachunu",
        "bhujanula andharu rommu kottukonuchundhuru",
        "kadabooradwani vinipinchunu",
        "paraloka sainyamutho vachunu",
        "naa hrudayame pongi porlunu",
        "naa manase santhoshinchunu"
      ]
    }
  ]
}
