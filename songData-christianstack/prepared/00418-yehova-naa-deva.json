{
  "song_name": "Yehova Naa Deva",
  "author": {
    "Authored by": "P James",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యెహోవా నా దేవా నీ దయలో కాయుమా",
      "ఎన్నికే లేని నన్ను ప్రేమించితివే",
      "ఏలికగా నను మలచితివే"
    ],
    "english": [
      "Yehovaa naa devaa nee dhayalo kaayumaa",
      "ennike leni nannu preminchithive",
      "elika gaa nanu malachithive"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవా నా దేవా నీ దయలో కాచితివే",
        "పాపినైన నన్ను ప్రేమించితివే",
        "నీ వారసునిగా నిలిపితివే"
      ],
      "english": [
        "Yehovaa naa devaa nee dhayalo kaayumaa",
        "paapinaina nannu preminchithive",
        "nee vaarasunigaa nilipithive"
      ]
    }
  ]
}
