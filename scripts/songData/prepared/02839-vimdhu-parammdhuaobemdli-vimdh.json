    {
      "stanza_number": 5,
      "telugu": [
        "నిత్యజీవ పదార్ధములు నిండి యున్నవి",
        "సత్యమచట మనము చేర సర్వము మనవి రండు"
      ],
      "english": [
        "Nithyajeeva Padhaardhamulu Nindi Yunnavi",
        "Sathyamachata Manamu Chaera Sarvamu Manavi Randu"
