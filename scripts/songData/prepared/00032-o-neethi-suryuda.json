{
  "song_name": "O Neethi Sooryudaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఓ నీతి సూర్యుడా - క్రీస్తేసు నాథుడా",
      "నీ దివ్య కాంతిని - నాలో వుదయింప జేయుమా",
      "ప్రభూ నన్ను వెలిగించుమా"
    ],
    "english": [
      "O Neethi Sooryudaa - Kreesthesu Naathudaa",
      "Nee Divya Kaanthini - Naalo Vudayimpa Jeyumaa",
      "Prabhoo Nannu Veliginchumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నేనే లోకానికి - వెలుగై యున్నానని",
        "మీరు లోకానికి - వెలుగై యుండాలని",
        "ఆదేశమిచ్చినావుగావున - నాలో వుదయించుమా",
        "ప్రభూ నన్ను వెలిగించుమా"
      ],
      "english": [
        "Nene Lokaaniki - Velugai Yunnaanani",
        "Meeru Lokaaniki - Velugai Yundaalani",
        "Aadeshamichchinaavugaavuna - Naalo Vudayinchumaa",
        "Prabhoo Nannu Veliginchumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా జీవితమునే - తూకంబు వేసిన",
        "నీ నీతి త్రాసులో - సరితూగ బోనని",
        "నే నెరిగియింటిగావున - నాలో వుదయించుమా",
        "ప్రభూ నన్ను వెలిగించుమా"
      ],
      "english": [
        "Naa Jeevithamune - Thookambu Vesina",
        "Nee Neethi Thraasulo - Sarithooga Bonani",
        "Ne Nerigiyintigaavuna - Naalo Vudayinchumaa",
        "Prabhoo Nannu Veliginchumaa"
      ]
    }
  ]
}
