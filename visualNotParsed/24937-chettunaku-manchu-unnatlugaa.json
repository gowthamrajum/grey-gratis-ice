  "main_stanza": {
    "telugu": [
      "చెట్టునకు మంచు ఉన్నట్లుగా",
      "యేసు నీవే నాకున్నావుగా",
      "నీ శ్రేష్టమైన ప్రసన్నత",
      "నన్నావరించెనుగా",
      "హల్లెలూయా హల్లెలూయా",
      "స్తోత్రాలు నీకే యేసయ్యా",
      "నీవిచ్చు ఆత్మీయత అనుభవం",
      "నను వాడిపోనీయదు",
      "బలవంతుడనైయుందును",
      "నీవల్ల ప్రాప్తించిన పరిమళం",
      "నను సోలిపోనీయదు",
      "నలుదిక్కుల వ్యాపింతును",
      "నీ స్పర్శ చేకూర్చిన అనునయం",
      "నను కృంగిపోనీయదు",
      "తగురీతిగా ఫలియింతును"
    ],
