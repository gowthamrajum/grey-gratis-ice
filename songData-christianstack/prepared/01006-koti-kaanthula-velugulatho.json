{
  "song_name": "Koti Kaanthula Velugulatho",
  "author": {
    "Authored by": "Bapu Kondeti",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కోటి కాంతుల వెలుగులతో",
      "ఉదయించెను ఒక కిరణం",
      "లోకమందున ప్రతి హృదయం",
      "చిగురించెను ఈ తరుణం",
      "దివిని విడిచి భువిని మనకై",
      "మానవునిగా జన్మించెను",
      "దిగులు చెందక గతము మరచి",
      "యేసుని ఆరాధింతుము"
    ],
    "english": [
      "Koti kaanthula velugulatho",
      "udayinchenu oka kiranam",
      "lokamandhuna prathi hrudhayam",
      "chigurinchenu ee tharunam",
      "dhivini vidichi bhuvini manakai",
      "maanavunigaa janminchenu",
      "dhigulu chendhaka gathamu marachi",
      "yesuni aaraadhinthumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకానికే ఇది పర్వదినం",
        "మహాదానందమే ప్రతి క్షణం"
      ],
      "english": [
        "Lokaanike idi parvadinam",
        "mahaadaanandame prathi kshanam"
      ]
    }
  ]
}
