{
  "song_name": "Yedabayani Nee Krupa",
  "author": {
    "Authored by": "Pastor Mathews",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఎడబాయని నీ కృప",
      "నను విడువదు ఎన్నటికీ",
      "యేసయ్యా నీ ప్రేమానురాగం",
      "నను కాయును అనుక్షణం"
    ],
    "english": [
      "Yedabaayani Nee Krupa",
      "Nanu Viduvadu Ennatiki",
      "Yesayyaa Nee Premaanuraagam",
      "Nanu Kaayunu Anukshanam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శోకపు లోయలలో – కష్టాల కడగండ్లలో",
        "కడలేని కడలిలో – నిరాశ నిస్పృహలో",
        "అర్ధమేకాని ఈ జీవితం",
        "ఇక వ్యర్థమని నేననుకొనగా",
        "కృపా కనికరముగల దేవా",
        "నా కష్టాల కడలిని దాటించితివి",
        "విశ్వాస పోరాటంలో – ఎదురాయే శోధనలు",
        "లోకాశల అలజడిలో – సడలితి విశ్వాసములో",
        "దుష్టుల క్షేమమునే చూచి",
        "ఇక నీతి వ్యర్థమని అనుకొనగా",
        "దీర్ఘశాంతముగల దేవా",
        "నా చేయి విడువక నడిపించితివి",
        "నీ సేవలో ఎదురైన – ఎన్నో సమస్యలలో",
        "నా బలమును చూచుకొని – నిరాశ చెందితిని",
        "భారమైన ఈ సేవను",
        "ఇక చేయలేనని అనుకొనగా",
        "ప్రధాన యాజకుడా యేసు",
        "నీ అనుభవాలతో బలపరిచితివి"
      ],
      "english": [
        "Shokapu Loyalalo – Kashtaala Kadagandlalo",
        "Kadaleni Kadalilo – Niraasha Nispruhalo",
        "Ardhame Kaani Ee Jeevitham",
        "Ika Vyardhamani Nenanukonaga",
        "Krupaa Kanikaramugala Devaa",
        "Naa Kashtaala Kadalini Daatinchithivi",
        "Vishwaasa Poraatamlo – Eduraaye Shodhanalu",
        "Lokaashala Alajadilo – Sadalithi Vishwaasamulo",
        "Dushtula Kshemamune Choochi",
        "Ika Neethi Vyardhamani Anukonaga",
        "Deerghashaanthamugala Devaa",
        "Naa Cheyi Viduvaka Nadipinchithivi",
        "Nee Sevalo Eduraina – Enno Samasyalalo",
        "Naa Balamunu Choochukoni – Niraasha Chendithini",
        "Bhaaramaina Ee Sevanu",
        "Ika Cheyalenani Anukonaga",
        "Pradhaana Yaajakudaa Yesu",
        "Nee Anubhavaalatho Balaparachithivi"
      ]
    }
  ]
}
