{
  "song_name": "Manchi Hrudayam",
  "author": {
    "Authored by": "Samuel Pammi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మంచి హృదయం నాకు దయచేయి",
      "శుద్ధ హృదయం నాకు దయచేయుమా"
    ],
    "english": [
      "Manchi Hrudayam naaku dhayacheyi",
      "shuddha hrudayam naaku dhayacheyuma"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మహిమతో నింపు శక్తితో నింపు",
        "నీ ఆత్మతో నను నింపు",
        "నీ ప్రేమా సహనం శాంతి నెమ్మది",
        "హృదయాన్ని ఏలనిమ్ము"
      ],
      "english": [
        "Mahimatho nimpu shakthitho nimpu",
        "nee aathmatho nanu nimpu",
        "nee prema sahanam shaanthi nemmadhi",
        "hrudhayaanni eylanimmu (manchi)"
      ]
    }
  ]
}
