{
  "song_name": "Krupa Sampannudu",
  "author": {
    "Authored by": "Y.Sunilkumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీతో భువిలో సమమెవరయ్య",
      "నీతో ఎవరూ నిలువగ లేరయ్యా",
      "నీలాంటి దేవుడు లోకాన్న లేరు",
      "సరిపోల్చదగినది ఎవరు",
      "మా ఆది అంతము నీవే",
      "ఆధారమైనవాడా",
      "మా దాగుచోటువు నీవే కృపాసంపన్నుడా",
      "యుగయుగయుగాలు తరతరాలు",
      "నీవే ఏకైక దేవుడవు"
    ],
    "english": [
      "Neetho bhuvilo samamevarayya",
      "Neetho evaru niluvaga lerayya",
      "Neelanti dhevudu lokhanna leru",
      "Saripolchadhaginadhi evaru",
      "Maa aadhi anthamu neeve",
      "Aadharamainavaadaa",
      "Maa daaguchotuvu neeve krupaasampannudaa",
      "Yuga yuga yugaalu tharatharaalu",
      "Neeve ekaika dhevudavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సృుష్టిని చేసినవాడవు",
        "చరితలో నిలిచిన వాడవు",
        "పరిశుద్ధుడా ఆదిసంభూతుడా",
        "సత్యస్వరూపుడా నా ప్రాణనాధుడా",
        "నాలో వశియించు నా దైవమా",
        "ఉన్నత స్ధలములో ఆశీనుడా"
      ],
      "english": [
        "Srushtini chesinavaadavu",
        "Charithalo nilichinavadavu",
        "Parishuddhuda aadhi sambhoothuda",
        "Sathyasvaroopuda naa prananadhuda",
        "Naalo vasiyinchu naa dhaivama",
        "Unnatha sthalamulo aaseenuda"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రాజులకు రాజువు నీవే",
        "ప్రభువులకు ప్రభుడవు నీవే",
        "ఏకైకుడా మాకై ఏతెంచినావా",
        "భూలోకమంతట నిన్నే స్తుతించగా",
        "వేవేల దూతలతో కొనియాడు దైవమా",
        "నా స్తుతి గానము నీవేనయ్యా"
      ],
      "english": [
        "Raajulaku raajuvu neeve",
        "Prabhulaku prabhudavu neeve",
        "Ekaikudaa maakai yethenchinaavaa",
        "Bhoolokamanthata ninne sthuthinchaga",
        "Veaveala duthalatho koniyadu dhaivamaa",
        "Naa sthuthi gaanamu neevenayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అన్నికాలంబులలోన",
        "ఉన్నవాడనువాడవుగా",
        "మా పక్షమై కృపలను చూపితివి",
        "నీ ప్రేమ చాలును నే వెనుకచూడను",
        "నాతో నడిచే నా నేస్తమా",
        "శరణం నీకే శ్రీమంతు"
      ],
      "english": [
        "Annikaalambulalona",
        "Unnavaadanuvaadavugaa",
        "Maa pakshamai krupalanu chupithivi",
        "Nee prema chaalunu",
        "Ne venukachoodanu",
        "Naatho nadiche naa nesthama",
        "Saranam neeke srimanthu"
      ]
    }
  ]
}
