{
  "song_name": "Paapa Samudhramandhu Pagile Naa Hrudhayanaava",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పాప సముద్రమందు - పగిలె నా హృదయనావ",
      "నావను దరికి యేసు - నడిపించు చక్కజేసి"
    ],
    "english": [
      "Paapa Samudhramandhu - Pagile Naa Hrudhayanaava",
      "Naavanu Dhariki Yaesu - Nadipinchu Chakkajaesi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రక్కలో కారిన రక్త - చుక్కల దర్శనమిమ్ము",
        "నా తండ్రి నడుపు సత్య - నూతన మార్గమందు"
      ],
      "english": [
        "Prakkaloa Kaarina Raktha - Chukkala Dharshanamimmu",
        "Naa Thandri Nadupu Sathya - Noothana Maargamandhu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నజరేయుడా యేసు నీదు - నాణ్యంపు ముఖమును జూపి",
        "స్వస్థపర్చు రోగుల - సర్వజనుల బ్రతికించు"
      ],
      "english": [
        "Najaraeyudaa Yaesu Needhu - Naanyampu Mukhamunu Joopi",
        "Svasthaparchu Roagula - Sarvajanula Brathikinchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సీయోను పర్వత మహిమ - చూపించుము ఎల్లరికి",
        "నా హృదయముపైనున్న - నల్ల తెరను చింపుము"
      ],
      "english": [
        "Seeyoanu Parvatha Mahima - Choopinchumu Ellariki",
        "Naa Hrudhayamupainunna - Nalla Theranu Chimpumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా ప్రాణ ప్రియుడా యేసు - నా ప్రార్థన వినుమా",
        "సంపూర్ణునిగా చేయు - నీ చక్కని దర్శనమిచ్చి"
      ],
      "english": [
        "Naa Praana Priyudaa Yaesu - Naa Praarthana Vinumaa",
        "Sampoornunigaa Chaeyu - Nee Chakkani Dharshanamichchi"
      ]
    }
  ]
}
