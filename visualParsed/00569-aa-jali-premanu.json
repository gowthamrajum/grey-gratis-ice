{
  "song_name": "Aa jaali premanu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Raj Prakash Paul"
    ],
    "రచన": [
      "బ్రదర్ రాజ్ ప్రకాష్ పాల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఆ జాలి ప్రేమను గమనింపకుందువా?",
      "ఆ దివ్య ప్రేమను గ్రహియింపకుందువా?",
      "ఓ సోదరా. . . ఓ సోదరా . . . ఆ ప్రేమమూర్తి యేసు దరిచేరవా?"
    ],
    "english": [
      "Aa jaali premanu gamanimpakunduvaa?",
      "Aa divya premanu grahiyimpakunduvaa?",
      "O sodaraa. . . O sodaraa . . . Aa premamoorthi Yesu dharicheravaa?"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ పాప జీవితాన ఆ ప్రేమమూర్తియే",
        "ఆ సిల్వపైన నీకై మరణ బాధ నొందెను",
        "నీ శిక్ష బాపగా రక్షణను చూపగా",
        "ని హృదయ ద్వారమందు వేచియుండెగా",
        "నీ రక్షకుండు యేసు నిన్ను పలచుచుండెను",
        "ఆ ప్రేమమూర్తి పలుకు ఆలకింపజాలవా?"
      ],
      "english": [
        "Nee paapa jeevithaana aa premamoorthiye",
        "Aa silvapaina neekai marana baadha nondenu",
        "Nee shiksha baapagaa rakshananu choopagaa",
        "Nee hrudaya dhvaaramandhu vechiyundegaa",
        "Nee rakshakundu Yesu ninnu pilachuchundenu",
        "Aa premamoorthi paluku aalakimpajaalavaa?"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎంత పాపినైనా గాని యేసు చేర రమ్మనె",
        "యేసు చెంత చేరువాని త్రోసివేయజాలడు",
        "నీ పాప జీవితం ప్రభుయేసు మార్చగా",
        "నీ చెంత చేరి నిన్ను పిలచుచుండెను",
        "విలువైన రక్త ధార ప్రేమతోడ గార్చెను",
        "ఆ ప్రేమ మూర్తి పిలుపు ఆలకింపజాలవా?"
      ],
      "english": [
        "Entha paapinainaa gaani Yesu chera rammane",
        "Yesu chentha cheruvaani throsiveyajaaladu",
        "Nee paapa jeevitham Prabhu Yesu maarchagaa",
        "Nee chentha cheri ninnu pilachuchundenu",
        "Viluvaina raktha dhaara premathoda gaarchenu",
        "Aa prema moorthi pilupu aalakimpajaalavaa?"
      ]
    }
  ]
}
