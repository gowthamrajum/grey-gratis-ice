  "main_stanza": {
    "telugu": [
      "ఆరాధింతు ఆరాధింతు యేసయ్య నామం అన్నింట ఘన నామం (2)",
      "స్తుతి పాటలెన్నో పాడుచు ధ్యానింతును",
      "క్రీస్తు నామమందు మహిమను కీర్తింతును (2)",
      "వేవేనోళ్లతో స్తుతి నే పాడెదా. (2)",
      "యేసునందే సత్యం యేసులోనే మార్గం యేసే నా నిత్యజీవము (2)"
    ],
    "english": [
      "Aaraadhinthu aaraadhinthu Yesayya naamam anninta ghana naamam (2)",
      "Sthuthi paatalenno paaduchu dhyaaninthunu",
      "Kreesthu naamamandhu mahimanu keerthinthunu (2)",
      "Vevenollatho sthuthi ne paadedaa. (2)",
      "Yesunande sathyam Yesulone maargam Yese naa nithyajeevamu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభు నామము ఎంతో ఘనమైనది",
        "అన్ని నామములకంటె హెచ్చైనది (2)",
        "ఆ నామమందే రక్షణ సోదరా (2)",
        "యేసయ్య రక్తము చిందించెగా (2)",
        "యేసే నా రక్షణ యేసే విమోచన యేసే నా నిరీక్షణా (2)"
      ],
      "english": [
        "Prabhu naamamu entho ghanamainadi",
        "Anni naamamulakante hechchainadhi (2)",
        "Aa naamamandhe rakshana sodaraa (2)",
        "Yesayya rakthamu chindhinchegaa (2)",
        "Yese naa rakshana Yese vimochana Yese naa nireekshanaa (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభు నామము ఎంతో బలమైనది",
        "అపవాది క్రియ లయపరుచునది (2)",
        "భయమేల నీకు ఓ సోదరా (2)",
        "సాతాను సిలువలో ఓడిపోయెగా (2)",
        "యేసే రక్తమే జయం యేసు నామమే జయం యేసునందే విజయం (2)"
      ],
      "english": [
        "Prabhu naamamu entho balamainadi",
        "Apavaadi kriya layaparuchunadhi (2)",
        "Bhayamela neeku o sodaraa (2)",
        "Saathaanu siluvalo odipoyegaa (2)",
