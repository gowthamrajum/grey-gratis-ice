{
  "song_name": "Bethlehemulo Puttadu",
  "author": {
    "Authored by": "Ch. Grace Mani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "బేత్లెహేములో పుట్టాడు యేసయ్య ఆనాడు",
      "నా హృదిలో ఉన్నాడు యేసయ్య ఈనాడు",
      "ఇమ్మానుయేలుగా ఉన్నాడు",
      "నాకు భయమేమీ లేదని అన్నాడు"
    ],
    "english": [
      "Bethlehemulo puttadu Yesayya aanaadu",
      "Naa hrudhilo unnaadu Yesayya eenaadu",
      "Immanueluga unnaadu",
      "Naaku bhayameemi ledhani annaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మహాఘనుడు మహోన్నతుడు",
        "మహిమ గలవాడు మహిలోనికి రాగా",
        "సర్వోన్నతునికి స్థలమే లేదనగా",
        "పశుల పాకలో పవళించెనుగా"
      ],
      "english": [
        "Mahaaghanudu mahonnathudu",
        "Mahima galavaadu mahiloniki raaga",
        "Sarvonnathuniki sthalame ledanaga",
        "Pashula paakalo pavalinchenugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీలో సంచరింతును నీలో నివసింతును",
        "నీవే నా ఆలయమని ప్రభు పలికెనుగా",
        "ఆహ్వానించినచో ఆశీర్వాదములన్ని",
        "నీ స్వంతమేగా ఈనాడు"
      ],
      "english": [
        "Neelo sancharinthunu neelo nivasinthunu",
        "Neeve naa aalayamani Prabhu palikenugaa",
        "Aahvaaninchinacho aasheervaadamulanni",
        "Nee swanthamegaa eenaadu"
      ]
    }
  ]
}
