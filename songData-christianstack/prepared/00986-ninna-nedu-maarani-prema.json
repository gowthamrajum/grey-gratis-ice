{
  "song_name": "Ninna Nedu Maarani Prema",
  "author": {
    "Authored by": "Pastor Ravinder Vottepu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిన్న నేడు మారని ప్రేమ నీదే",
      "ఎన్నడైన వీడని తోడు నీవే",
      "యేసయ్య ఆ ఆ ఆ యేసయ్య"
    ],
    "english": [
      "Ninna nedu maarani prema needhai",
      "ennadaina veedani thodu neeve",
      "yesayya aa aa aa yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా తల్లి నను మరచునేమో",
        "నా తండ్రి నను విడచునేమో",
        "నను ఎన్నడు విడనాడని ఎడబాయని దేవుడు",
        "నా ఊపిరై నా కాపరై నను హత్తుకున్నవారు",
        "యేసయ్య ఆ ఆ ఆ యేసయ్య",
        "నా వారే నను విడచునేమో",
        "నా స్నేహితులే నను మరచునేమో",
        "నను ఎన్నడు విడనాడని ఎడబాయని దేవుడు",
        "నా తోడుగా నా నీడగ నా వెంటవున్నవారు",
        "యేసయ్య ఆ ఆ ఆ యేసయ్య"
      ],
      "english": [
        "Naa thalli nanu marachunemo",
        "naa thandri nanu vidachunemo",
        "nanu ennadu vidanaadani edabaayani dhevudu",
        "naa oopirai naa kaaparai nanu hatthukunnavaaru",
        "yesayya aa aa aa yesayya",
        "Naa vaarey nanu vidachunemo",
        "naa snehithuley nanu marachunemo",
        "nanu ennadu vidanaadani edabaayani devudu",
        "naa thodugaa naa needaga naa ventavunnavaaru",
        "yesayya aa aa aa yesayya"
      ]
    }
  ]
}
