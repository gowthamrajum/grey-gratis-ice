    "english": [
      "Doothalu dhigivachche bhuvilo - Prabhuvuni sthuthiyimpaa (2)",
      "Kaanthulu vedhajalle divilo - Thaaraka udayinche(2)",
      "Manakai Prabhuve deenudai udayinche (2)",
      "Mahima ghanathayu - Prabhuke chellunoo (2)"
    ]
  },
  "stanzas": [
    {
