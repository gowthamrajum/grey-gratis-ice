{
  "song_name": "Kummaree Oa Kummaree",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కుమ్మరీ ఓ కుమ్మరీ జగదుత్పత్తిదారీ",
      "జిగటమన్నై నా వంక చల్లగ చూడుమయ్యా"
    ],
    "english": [
      "Kummaree Oa Kummaree Jagadhuthpaththidhaaree",
      "Jigatamannai Naa VMka Challaga Choodumayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పనికిరాని పాత్రనని పారవేయకుమా పొంగిపొరలు పాత్రగా జేసి నన్ను నింపుమా",
        "సువార్తలోని పాత్రలన్నీ శ్రీ యేసున్ పొగడుచుండ",
        "సాక్షిగ నుండు పాత్రగజేసి సత్యముతో నింపుము తండ్రి"
      ],
      "english": [
        "Panikiraani Paathranani Paaravaeyakumaa PoMgiporalu Paathragaa Jaesi Nannu NiMpumaa",
        "Suvaarthaloani Paathralannee Shree Yaesun PogaduchuMda",
        "SaakShiga NuMdu Paathragajaesi Sathyamuthoa NiMpumu ThMdri"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విలువలేని పాత్రన్ నేను కొనువారు లెరెవ్వరూ",
        "వెలలేని నీదు రక్తంబుతో వెలుగొందు పాత్రగజేసి",
        "ఆటంకములనుండి తప్పించి నన్ను ఎల్లప్పుడు కావుమయ్యా"
      ],
      "english": [
        "Viluvalaeni Paathran Naenu Konuvaaru Lerevvaroo",
        "Velalaeni Needhu RakthMbuthoa VelugoMdhu Paathragajaesi",
        "AatMkamulanuMdi ThappiMchi Nannu Ellappudu Kaavumayyaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "లోకాశతో నింజి ఉప్పొంగుచు మార్గంబునే తప్పితిన్",
        "మనుష్యేచ్చలన్నియున్ స్థిరమనుచు నే మనశ్శాంతి కోల్పోతిని",
        "పోగొట్టుకొన్న పాత్రయనుచు పరుగెత్తి నను పట్టితీ",
        "ప్రాణంబు నాలో ఉన్నప్పుడే నీ పాదంబుల్ నే పట్టితిన్"
      ],
      "english": [
        "Loakaashathoa NiMji UppoMguchu MaargMbunae Thappithin",
        "ManuShyaechchalanniyun SThiramanuchu Nae ManashshaaMthi Koalpoathini",
        "Poagottukonna Paathrayanuchu Parugeththi Nanu Pattithee",
        "PraaNMbu Naaloa Unnappudae Nee PaadhMbul Nae Pattithin"
      ]
    }
  ]
}
