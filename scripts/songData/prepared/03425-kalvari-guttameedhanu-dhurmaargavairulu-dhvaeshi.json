  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కల్వరి గుట్టమీదను - దుర్మార్గవైరులు",
        "ద్వేషించి సిల్వ మీదను - శ్రీ యేసుజంపిరి"
      ],
      "english": [
        "Kalvari Guttameedhanu - Dhurmaargavairulu",
        "Dhvaeshinchi Silva Meedhanu - Shree Yaesujampiri"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శ్రీయేసు శ్రమలన్నియు - నే నెంచజాలను",
        "నన్నున్ రక్షించులాగున - ప్రాణంబు బెట్టెను"
      ],
      "english": [
        "Shreeyaesu Shramalanniyu - Nae Nenchajaalanu",
        "Nannun Rakshinchulaaguna - Praanambu Bettenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నే జీవ మొందులాగున - చావును పొందెను",
        "నన్నున్ రక్షింప శ్రమను - శ్రీ యేసు పొందెను"
      ],
      "english": [
        "Nae Jeeva Mondhulaaguna - Chaavunu Pondhenu",
        "Nannun Rakshimpa Shramanu - Shree Yaesu Pondhenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శ్రీ యేసు గాక గురువు - లేరింక నాకును",
        "నా వంటి పాపులెల్లరిన్ - రక్షింప వచ్చెను"
      ],
      "english": [
        "Shree Yaesu Gaaka Guruvu - Laerinka Naakunu",
        "Naa Vanti Paapulellarin - Rakshimpa Vachchenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా యేసు ప్రేమగొప్పది - యమూల్యమైనది",
        "నే ప్రేమతోను యేసును - సేవింతు నిత్యము"
      ],
      "english": [
        "Naa Yaesu Praemagoppadhi - Yamoolyamainadhi",
        "Nae Praemathoanu Yaesunu - Saevinthu Nithyamu"
      ]
    }
  ]
