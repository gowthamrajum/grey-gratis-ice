{
  "song_name": "Ningi Nela Yekamayenu",
  "author": {
    "Authored by": "KY Ratnam",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నింగి నేల ఏకమాయెను రారాజుని చూడ",
      "లోకమంతా సంతోషించెను",
      "పండగే ఇది పండగే",
      "పండగే యేసయ్య పుట్టెను"
    ],
    "english": [
      "Ningi nela yekamayenu raaraajuni chooda",
      "lokamantha santhoshinchenu",
      "pandage idhi pandage",
      "pandage yesayya puttenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకానికి రక్షణివ్వ యేసు పుట్టెను",
        "సర్వ జనులారా రండి మ్రొక్కెదం"
      ],
      "english": [
        "Lokaniki rakshanivva yesu puttenu",
        "sarva janulaaraa randi mrokkedham"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తూర్పు నుండి ముగ్గురు జ్ఞానులు",
        "సర్వ జ్ఞాని ని చుడవచ్చిరి",
        "సాంబ్రాణి బోళం బంగారము తెచ్చి",
        "భక్తి తో యేసుని పుజించిరి",
        "రక్షకుడు ఏసని సాగుల పడిరి",
        "రక్షణనేరిగి దన్యులైరి."
      ],
      "english": [
        "Thoorpu nundi mugguru gnanulu",
        "sarva gnanini choodavachiri",
        "sambrani bolam bangaram thechi",
        "bhakthitho yesuni poojinchiri",
        "rakshakudu yesani sagilapadiri",
        "rakshananerigi dhanyulairi",
        "pandage idhi pandage pandage yesayya puttenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సర్వ లోకము యేసే దేవుడని",
        "అంగీకరించి పూజించుట",
        "హృదయం తెరచి క్రీస్తుని చేర్చుకొని",
        "ఆయన నామములో పాలోందితే"
      ],
      "english": [
        "Sarva lokamu yese dhevudani",
        "angeekarinchi poojinchuta",
        "hrudhayam therachi kreesthuni cherchukoni",
        "ayana naamamulo paalondhithe"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రక్షకుడేసని అంగీకరించిన",
        "జీవము నొసగి పరమున చేర్చును",
        "పండగే ఇది పండగే",
        "పండగే యేసయ్య పుట్టెను"
      ],
      "english": [
        "Rakshakudesani angeekarinchina",
        "jeevamu nosagi paramuna cherchunu",
        "pandage idhi pandage",
        "pandage yesayya puttenu"
      ]
    }
  ]
}
