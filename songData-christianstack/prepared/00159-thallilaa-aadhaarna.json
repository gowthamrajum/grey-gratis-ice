{
  "song_name": "Thallilaa Aadhaarna",
  "author": {
    "Authored by": "Ravi Bharath",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తల్లిలా ఆదరణ ఎల్ షద్దాయి రొమ్మున",
      "హేతువు చూడని నీ ప్రేమా",
      "హత్తుకున్నది హృదయాన"
    ],
    "english": [
      "Thallila aadharana El Shaddai rommuna",
      "Hethuvu choodani nee prema",
      "Hatthukunnadhi hrudhayaanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎల్ షద్దాయి ఆదరణ",
        "నా ఆవేదనను ఆరాధన గా మార్చివేసావే",
        "మార్చివేసావే"
      ],
      "english": [
        "El Shaddai aadharana",
        "Naa aavedhananu aaradhana gaa maarchivesaave",
        "Maarchivesaave"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ సన్నిధే మేలు నీ ప్రేమయే చాలు",
        "అమ్మ కన్న కమ్మనైనది",
        "ప్రభు యేసు నీ ప్రేమ",
        "వివరించ వీలవునా నన్నెన్నడు వీడనన్నది"
      ],
      "english": [
        "Nee sannidhe melu, nee premaye chaalu",
        "Amma kanna kammanaainadhi",
        "Prabhu Yeshu nee prema",
        "Vivarimpa veelavunaa, nannennadu veedanannadhi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కడసారి కలవరి యాత్ర లో –",
        "తల్లడిల్లిన తనయా తల్లితో",
        "అమ్మ ఇదిగో నీ కుమారుడెయని –",
        "ప్రాణాలే పోతున్నా ఆదరించావే",
        "తల్లినే నిర్మించిన మనసుకు ఉండదా ఈ ప్రేమ",
        "తల్లి లాంటి ఆదరణే తుడిచినది నా కన్నీళ్లే"
      ],
      "english": [
        "Kadasaari kalavari yaathra lo",
        "Thalladillina thanayaa thallitho",
        "“Amma, idigo nee kumaarudeyani”",
        "Praanaale pothunnaa aadharinchave",
        "Thalline nirminchina manasuku undadhaa ee prema?",
        "Thallilaanti aadharane thudichinadhi naa kannille"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రతిసారి ప్రభుని రొమ్మున –",
        "ఆనుకునే నీ ప్రియ శిష్యునితో",
        "ఇకపైనా ఆ రొమ్ము ఉండబోదని",
        "ఇదిగో నీ తల్లి అని ఆదరించావే",
        "అనాథగా నన్నెన్నడు విడువనిధి నీ ప్రేమ",
        "క్రీస్తు ప్రేమ నుండి నన్నేది యెడబాపదు"
      ],
      "english": [
        "Prathisari Prabhuni rommuna",
        "Aanukune nee priya shishyunitho",
        "Ikapaina aa rommu undabodhani",
        "“Idigo nee thalli” ani aadharinchave",
        "Anaathaga nannennadu viduvanidhi nee prema",
        "Kristhu prema nundi nannedhiyu edabapadhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పిల్లలు పోయిన ఎలుగు బంటిలా –",
        "శత్రువునే చీల్చివేసావే",
        "అరచేతులలోనే చెక్కుకున్నావే –",
        "రోషముతో ఒడిలో దాచుకున్నావే",
        "నన్ను ముట్టిన వాడు నీ కన్ను గుడ్డునే ముట్టాడని",
        "నా యెడల నీ ప్రేమ – ఎందాకైన వెళుతుంది"
      ],
      "english": [
        "Pillalu poyina elugu bantila",
        "Shathruvune cheelchivesaave",
        "Arachethulalone chekkukunnave",
        "Roshmutho odilo dhaachukunnave",
        "“Nannu muttina vaadu nee kannu guddune muttadu” ani",
        "Naa yedala nee prema endakaina veluthundhi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దినమెల్ల చేతులు చాపావు –",
        "లోబడనోల్లని మా యెడ నీ ప్రేమ",
        "కోడి తన పిల్లలను చేర్చునట్లుగా –",
        "నిరతము రెక్కల క్రింద దాచియుంచావే",
        "బలమైన మరణాన్ని లెక్క చేయనిది ఈ ప్రేమ",
        "రక్తాన్నే కార్చినది పాణాలే అర్పించినది"
      ],
      "english": [
        "Dhinamella chethulu chaapaavu",
        "Lobadanollani maa yeda nee prema",
        "Kodi thana pillalanu cherchunatluga",
        "Nirathamu rekkaala kindhaa dhaachiyunchaave",
        "Balamaina marananni lekka cheyanidhi ee prema",
        "Rakthaanne kaarchinadhi, praanale arpinchinadhi"
      ]
    }
  ]
}
