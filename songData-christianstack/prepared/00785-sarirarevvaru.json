{
  "song_name": "Sarirarevvaru",
  "author": {
    "Authored by": "Bro. Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సరిరారెవ్వరూ నా ప్రియుడైన యేసయ్యకు",
      "సర్వము నెరిగిన సర్వేశ్వరునికి",
      "సరిహద్దులు లేని పరిశుద్ధునికి",
      "సరిరారెవ్వరూ నా ప్రియుడైన యేసయ్యకు"
    ],
    "english": [
      "Sariraarevvaru naa priyudaina yesayyaku",
      "sarvamu nerigina sarveswaruniki",
      "sarihaddhulu leni parishuddhuniki",
      "sariraarevvaru naa priyudaina yesayyaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నమ్మదగిన వాడే నలుదిశల నెమ్మది కలుగజేయువాడే",
        "నాజీరు వ్రతము జీవితమంతా అనుసరించినాడే",
        "నాకై నిలువెల్ల సిలువలో నలిగి కరిగినాడే",
        "ఆరోగ్య ప్రదాతయే సంపూర్ణ స్వస్థత అనుగ్రహించువాడే",
        "ఆశ్చర్య క్రియలు జీవితమంతా చేయుచు తిరిగినాడే",
        "నాకై కొరడాల దెబ్బలను అనుభవించినాడే",
        "పునరుత్థానుడే జయశీలి మృతిని జయించి లేచినాడే",
        "శ్రేష్ఠమైన పునరుత్థాన బలము యిచ్చినాడే",
        "నాకై అతిత్వరలో మహిమతో రానైయున్నావాడే"
      ],
      "english": [
        "Nammadhagina vaade naludhisala nemmadhi kalugajeyuvaade",
        "naajeeru vrathamu jeevithamanthaa anusarinchinaade",
        "naakai niluvella siluvalo naligi kariginaade",
        "Aarogya pradhataye sampoorna swasthatha anugrahinchuvaade",
        "aascharya kriyalu jeevithamanthaa cheyuchu thiriginaade",
        "naakai koradaala dhebbalanu anubhavinchinaade",
        "Punaruddhanude jayaseeli mruthini jayinchi lechinaade",
        "sreshtamaina punaruddhana balamu ichinaade",
        "naakai athitwaralo mahimatho raanaiyunnavaade"
      ]
    }
  ]
}
