  "main_stanza": {
    "telugu": [
      "లాలి లాలి లాలి లాలమ్మ లాలీ",
      "లాలియని పాడరే బాలయేసునకు"
    ],
    "english": [
      "Laali laali laali laalamma laalee",
      "Laaliyani paadare baala Yesunaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోక దేవుని తనయుడో యమ్మా",
