{
  "song_name": "Sajeevula Dhaeshamuna Naenu Yehoavaa Dhayanu PoMdhudhu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవా నీ ముఖమును నాకు - దాచకుము నా ప్రభువా",
      "నీ సేవకుని కోపముచే - త్రోసివేయకు యెహోవా"
    ],
    "english": [
      "Dhaevaa Nee Mukhamunu Naaku - Dhaachakumu Naa Prabhuvaa",
      "Nee Saevakuni Koapamuchae - Throasivaeyaku Yehoavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవా నా రక్షణకర్త - నీవే నాసహాయుడవు",
        "నన్ను దగనాడవలదు - నన్ను విడువకుము"
      ],
      "english": [
        "Dhaevaa Naa RakShaNakartha - Neevae Naasahaayudavu",
        "Nannu Dhaganaadavaladhu - Nannu Viduvakumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాదు తలిదండ్రులు - నన్ను విడచినను",
        "నా దేవుండగు యెహోవా - నన్ను చేరదీయును"
      ],
      "english": [
        "Naadhu ThalidhaMdrulu - Nannu Vidachinanu",
        "Naa DhaevuMdagu Yehoavaa - Nannu Chaeradheeyunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాకై పొంచియున్నట్టి - వారిని చూచి నన్ను",
        "సరళ దారిని నడుపు - మంచి మార్గము భోధించు"
      ],
      "english": [
        "Naakai PoMchiyunnatti - Vaarini Choochi Nannu",
        "SaraLa Dhaarini Nadupu - MaMchi Maargamu BhoaDhiMchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాపై లేచియున్నారు - అబద్ధ సాక్షులు క్రూరుల్",
        "నన్నప్పగించకు దేవా - నాదు విరోధులకు"
      ],
      "english": [
        "Naapai Laechiyunnaaru - AbadhDha SaakShulu Kroorul",
        "NannappagiMchaku Dhaevaa - Naadhu ViroaDhulaku"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యెహోవా దయ పొందెదను - సజీవుల దేశమున",
        "ఇట్టి నమ్మకము లేని - యెడల నే నేమగుదును"
      ],
      "english": [
        "Yehoavaa Dhaya PoMdhedhanu - Sajeevula Dhaeshamuna",
        "Itti Nammakamu Laeni - Yedala Nae Naemagudhunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ధైర్యము తెచ్చుకొని - నిబ్బర హృదయము గల్గి",
        "యెహోవా దేవుని కొరకు - కనిపెట్టుకొని యుండుము"
      ],
      "english": [
        "Dhairyamu Thechchukoni - Nibbara Hrudhayamu Galgi",
        "Yehoavaa Dhaevuni Koraku - Kanipettukoni YuMdumu"
      ]
    }
  ]
}
