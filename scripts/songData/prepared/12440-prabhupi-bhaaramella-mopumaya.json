  "main_stanza": {
    "telugu": [
      "ప్రభుపై భారమెల్ల మోపుమయా కలత చెందకుమా కాపాడు ప్రభుడొక్కడున్నాడయా కనుపాపలా కాచునూ"
    ],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీతిమంతుడు పడిపోడయ్యా నిత్యము కాపాడి నడిపించును ||ప్రభు||"
      ],
      "english": []
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీడగ ఉండి కాపాడును ఆశ్రయమిచ్చి ఆదుకొనును ||ప్రభు||"
      ],
      "english": []
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తల్లియు తండ్రియు విడిచిననూ కౌగిలిలో నన్ను దాచుకొనును ||ప్రభు||"
      ],
      "english": []
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మన పక్షమున ప్రభువుండగా కదలక మెదలక నేనుందును ||ప్రభు||"
      ],
      "english": []
    }
  ]
}
