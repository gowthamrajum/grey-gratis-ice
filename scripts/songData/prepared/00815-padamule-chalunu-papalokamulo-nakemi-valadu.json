  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఘోర తుఫాను సముద్రము పొంగగా",
        "గద్దించి నీటిపై నడిచి వచ్చిన"
      ],
      "english": [
        "Gora Tupanu Samudramu Pomgaga",
        "Gaddimchi Nitipai Nadichi Vachchina"
      ]
