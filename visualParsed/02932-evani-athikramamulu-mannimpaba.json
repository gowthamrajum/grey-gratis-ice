{
  "song_name": "Evani athikramamulu mannimpabadeno",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఎవని అతిక్రమములు మన్నింపబడెనో",
      "పాపపరిహార మెవడొందెనో వాడే ధన్యుండు"
    ],
    "english": [
      "Evani athikramamulu mannimpabadeno",
      "Paapaparihaara mevadondeno vaade dhanyundu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహో వాచే నిర్దోషిగా తీర్చబడియు",
        "ఆత్మలో కపటము లేనివాడే ధన్యుండు  ||ఎవని||"
      ],
      "english": [
        "Yehovaache nirdhoshigaa theerchabadiyu",
        "Aathmalo kapatamu lenivaade dhanyundu  ||Evani||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మౌనియై యుండి దినమెల్ల నే జేసినట్టి",
        "ఆర్తధ్వనిచే నా యెముకలు క్షీణించెను  ||ఎవని||"
      ],
      "english": [
        "Mauniyai yundi dinamella ne jesinatti",
        "Aarthadhwaniche naa emukalu ksheeninchenu  ||Evani||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దివారాత్రులు నీ చేయి నాపై బరువైయుండ",
        "నా సారము వేసవిలో ఎండినట్లాయె  ||ఎవని||"
      ],
      "english": [
        "Dhivaaraathrulu nee cheyi naapai baruvaiyunda",
        "Naa saaramu vesavilo endinatlaaye  ||Evani||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నేను నా దోషమును కప్పుకొనక",
        "నీ యెదుట నా పాపమును ఒప్పుకొంటిని  ||ఎవని||"
      ],
      "english": [
        "Nenu naa dhoshamunu kappukonaka",
        "Nee eduta naa paapamunu oppukontini  ||Evani||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ సన్నిధి నా పాపముల నొప్పుకొనగా",
        "నీవు నా దోషమును మన్నించితివిగా  ||ఎవని||"
      ],
      "english": [
        "Nee sannidhi naa paapamula noppukonagaa",
        "Neevu naa dhoshamunu manninchithivigaa  ||Evani||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కావున నీ దర్శనకాలమందు",
        "భక్తిగలవారు నిన్ను ప్రార్థించెదరు  ||ఎవని||"
      ],
      "english": [
        "Kaavuna nee dharshanakaalamandu",
        "Bhakthigalavaaru ninnu praarthinchedharu  ||Evani||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "విస్తార జలప్రవాహము పొర్లినను",
        "నిశ్చయముగ అవి వారి మీదికి రావు  ||ఎవని||"
      ],
      "english": [
        "Visthaara jalapravaahamu porlinanu",
        "Nishchayamuga avi vaari meediki raavu  ||Evani||"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నాకు దాగుచోటు నీవే శ్రమలోనుండి",
        "నీవు నన్ను రక్షించెదవు నాదు దుర్గమా  ||ఎవని||"
      ],
      "english": [
        "Naaku dhaaguchotu neeve shramalonundi",
        "Neevu nannu rakshinchedhavu naadu durgamaa  ||Evani||"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "విమోచన గానములతో నీవు నన్ను",
        "ఆదరించి నాకుపదేశము చేసెదవు  ||ఎవని||"
      ],
      "english": [
        "Vimochana gaanamulatho neevu nannu",
        "Aadarinchi naakupadheshamu chesedavu  ||Evani||"
      ]
    }
  ]
}
