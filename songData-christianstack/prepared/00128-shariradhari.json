      ],
      "english": [
        "Maraname lenivaadu mruthunigaa maarenu",
        "Sarvashakthimanthudu siluvapai vreladenu",
        "Parishuddha Dhevudu paapamuga maarenu",
        "Jeevaadhipathiye nirjeevi aayenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "Pre-chorus",
        "శరీరము ధరించెను శాపగ్రస్తుడాయెను",
        "సుందరుడైనవాడు సురూపు కోల్పోయెను",
        "శరీరము ధరించెను శిక్షను తొలగించెను",
        "మరణము ఓడించెను సమాధిని గెలిచెను"
      ],
      "english": [
        "Pre-Chorus",
        "Shareeramu dharinchenu shaapagrasthudayenu",
        "Sundharudainavaadu surupu kolpoyenu",
        "Shareeramu dharinchenu shikshanu tholaginchenu",
        "Maranamu odinchenenu samadhini gelichenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శరీరధారుని గ్రహింపజాలను",
        "శరీరధారుని వర్ణింపజాలను"
      ],
      "english": [
        "Shareera dhaaruni grahimpajaalanu",
        "Shareera dhaaruni varnimpajaalanu"
