{
  "song_name": "Devudu lokamunu entho preminchenu advitheeya kumaaruni anugrahinchenu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవుడు లోకమును యెంతో ప్రేమించెను",
      "అద్వితీయ కుమారుని అనుగ్రహించెను"
    ],
    "english": [
      "Devudu lokamunu entho preminchenu",
      "Advitheeya kumaaruni anugrahinchenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎవరాయనను విశ్వసించెదరో నశింపక నిత్యజీవము పొందెదరు"
      ],
      "english": [
        "Evaraayananu vishvasinchedaro nashimpaka nithyajeevamu pondedaru"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తన ప్రేమ యెంతో శాశ్వతమైనది రక్తము కార్చి ప్రాణమునిచ్చె"
      ],
      "english": [
        "Thana prema entho shaashwathamainadi rakthamu kaarchi praanamunichche"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభువు పిలిచెను పాపుల నెల్ల - వచ్చినవారె కడుగబడెదరు"
      ],
      "english": [
        "Prabhuvu pilichenu paapula nella - Vachchinavaare kadugabadedaru"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తప్పినవారిని వెదకుచున్నాడు - వచ్చినవారె ముక్తి పొందెదరు"
      ],
      "english": [
        "Thappinavaarini vedhakuchunnaadu - Vachchinavaare mukthi pondedaru"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపముచేత చచ్చిన మిమ్ము - ప్రభుకోరుచుండె జీవమునివ్వ"
      ],
      "english": [
        "Paapamuchetha chachchina mimmu - Prabhukoruchunde jeevamunivva"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నలిగిన మనస్సు కలిగినవారె - గొప్ప రక్షణను పొందెదరిలలో"
      ],
      "english": [
        "Naligina manassu kaliginavaare - Goppa rakshananu pondhedarilalo"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "క్రొత్త జన్మమును ఎత్తనివారు ప్రవేశింపలేరు ప్రభురాజ్యమందు"
      ],
      "english": [
        "Krottha janmamunu etthanivaaru praveshimpaleru prabhuraajyamandhu"
      ]
    }
  ]
}
