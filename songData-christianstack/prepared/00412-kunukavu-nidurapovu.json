  "main_stanza": {
    "telugu": [
      "పాదములకు రాయి తగులకుండా కాపాడు దేవుడవు",
      "తెగులు గుడారము రానియ్యక కాచేది నాధుడవు",
      "కునుకవవూ నిధురపోవూ",
      "ఇశ్రాయేలు కాపరి మా మంచి యేసయ్యా",
      "ఆరాధన యేసు ఆరాధన",
      "ఆరధన స్తుతి ఆరధనా",
      "ఆరాధన యేసు ఆరాధన",
      "ఆరాధన నీకే ఆరాధనా …"
    ],
    "english": [
      "Paadhamulaku raayi thagalakundaa kaapaadu dhevudavu",
      "thegulu gudaaramu raaniyyaka kaachedi naadhudavu",
