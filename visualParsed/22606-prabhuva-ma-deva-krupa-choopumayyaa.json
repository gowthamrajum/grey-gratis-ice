      "Maa praarthana angeekarinchumayyaa",
      "Ee thegulu nundi mammu kaapaadumayyaa",
      "Swasthatha daya cheyumayyaa",
      "Maa dheshaanni kaapaadumayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎటు చూసినా మరణ రోదనలు",
