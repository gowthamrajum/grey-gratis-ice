    "english": [
      "Mattiviraa vattiviraa mannuvuraa mannavuraa",
      "Kaayamu maayamu khaayamuraa ayyayyo!"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అటుచేసి ఇటుచేసి అందరిని మోసం చేసి",
        "సంఘాన్ని రెండుగ చీల్చావే అయ్యయ్యో",
