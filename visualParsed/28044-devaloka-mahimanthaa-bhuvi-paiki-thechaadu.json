  "main_stanza": {
    "telugu": [
      "దేవలోక మహిమనంతా భువిపైకి తెచ్చాడు",
      "దీనురాలి కడుపునుండి యేసు ఉదయించాడు",
      "మానుజాళి పై ప్రేమతో దేవదేవుడు",
      "నరరూపమెత్తి బాలుడై నేల కాలు మోపినాడు"
    ],
    "english": [
      "Dhevaloka mahimanantha bhuvipaiki thechchaadu",
      "Dheenuraali kadupunundi Yesu udhayinchaadu",
      "Maanujaali pai prematho Dhevadhevudu",
      "Nararoopametthi baaludai nela kaalu mopinaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కలిగెను విడుదల సంతోషం క్రిస్మస్",
        "వెలిగిన మనసుల సంబరం క్రిస్మస్"
      ],
      "english": [
        "Kaligenu vidudala santhosham Krismas",
        "Veligina manasula sambaram Krismas"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చీకటిని దూరం చేసి దివ్యమైన కాంతిని చూపి",
        "ఎప్పుడూ మన తోడై నడిపిస్తాడు",
        "కీడు ఏది రాకుండా దీవెనలు పోకుండా",
        "కంటి పాపలా కాచి భద్రం చేసే ప్రాణప్రియుడు",
        "పాపితోటి స్నేహం చేసి పాపముల శిక్షను బాపి",
        "ఎప్పుడూ మన మధ్యే నివసిస్తాడు",
        "లోటు చూడనీకుండా ఆటంకాలు లేకుండా",
        "అన్నింటిని సమకూర్చి సాయం చేసే ప్రాణప్రియుడు",
        "వేదనను మాయం చేసి గుండెలోని బాధను మాన్పి",
        "ఎప్పుడూ మనతోనే పయనిస్తాడు",
        "శత్రుబారి పడకుండా ఆశయాలు చెడకుండా",
        "చుట్టూ కేడెమై యుండి కార్యం చేసే ప్రాణప్రియుడు"
      ],
      "english": [
        "Cheekatini dooram chesi divyamaina kaanthini choopi",
        "Eppudoo mana thodai nadipisthaadu",
        "Keedu edhi raakundaa deevenalu pokundaa",
        "Kanti paapalaa kaachi bhadhram chese praanapriyudu",
        "Paapithoti sneham chesi paapamula shikshanu baapi",
        "Eppudoo mana madhye nivasisthaadu",
        "Lothu choodaneekundaa aatankaalu lekundaa",
        "Annintini samakoorchi saayam chese praanapriyudu",
        "Vedananu maayam chesi gundeloni baadhanu maanpi",
        "Eppudoo manathone payanisthaadu",
        "Shathrubaari padakundaa aashayaalu chedakundaa",
        "Chuttoo kedemai yundi kaaryam chese praanapriyudu"
      ]
    }
  ]
