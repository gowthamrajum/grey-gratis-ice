      ],
      "english": [
        "Ishraayelu Dhevudaina Yehova",
        "Devudu sthuthimpabadunu gaaka"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఆయనే బహు ఆశ్చర్యకార్యములు",
