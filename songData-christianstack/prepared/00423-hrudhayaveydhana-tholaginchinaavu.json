{
  "song_name": "Hrudhayaveydhana Tholaginchinaavu",
  "author": {
    "Authored by": "Pastor Korneli",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స మ గ మ ప మ గ రి గ స",
      "స మ గ ప మ",
      "స మ గ మ ప మ గ రి గ స",
      "స ని స గ రి గ స స ని స గ రి గ స"
    ],
    "english": [
      "Sa ma ga ma pa ma ga ri ga sa",
      "sa ma ga pa ma",
      "sa ma ga ma pa ga ri ga sa",
      "sa ni sa ga ri ga sa sa ni sa ga ri ga sa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హృదయ వేదన తొలగించినావు బలహీనతలో తోడుండినావు",
        "జీవమే లేని నా ప్రాణమును",
        "సేదదీర్చి జీవమిచ్చావు",
        "నీకే నీకే స్తోత్రము",
        "నాపై చూపిన ప్రేమకు స్తోత్రము"
      ],
      "english": [
        "Hrudaya veydhana tholaginchinaavu balaheenathaloo thoodundinaavu",
        "jeevavey leyni naa praanamunu",
        "seydhadheerchi jeevamicchaavu",
        "neekey neekey sthootramu",
        "naapai choopina premaku sthootramu"
      ]
    }
  ]
}
