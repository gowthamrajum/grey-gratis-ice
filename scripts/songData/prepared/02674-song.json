{
  "song_name": "Oa Yaesu Bhakthulaaraa Mee Raaju Dhvajamu",
  "author": {
    "Authored by": "",
    "రచన": "జార్జి డఫీల్డ్"
  },
  "main_stanza": {
    "telugu": [
      "ఓ యేసు భక్తులారా, మీ రాజు ధ్వజము",
      "గ్రహించి సాహసించి పోరాడి గెల్వుఁడీ",
      "విశ్వాసులార, రండి మీ రక్షణార్థమై",
      "ప్రయాసపడ్డ యేసు విజయ మిచ్చును."
    ],
    "english": [
      "Oa Yaesu Bhakthulaaraa, Mee Raaju Dhvajamu",
      "Grahinchi Saahasinchi Poaraadi Gelvudee",
      "Vishvaasulaara, Randi Mee Rakshanaarthamai",
      "Prayaasapadda Yaesu Vijaya Michchunu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మీయం దసూయఁ బట్టి మీ యాత్మ నాశము",
        "నెన్నండుఁ గోరునట్టి యనేకు లుందురు",
        "మీ రెల్ల రేసు పేరు వచించి",
        "యాయనే సర్వాధికారి యంచు సేవింపవలెను."
      ],
      "english": [
        "Meeyam Dhasooya Batti Mee Yaathma Naashamu",
        "Nennandu Goarunatti Yanaeku Lundhuru",
        "Mee Rella Raesu Paeru Vachinchi",
        "Yaayanae Sarvaadhikaari Yanchu Saevimpavalenu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రచండ మైన దండు పోరాడ లేచినన్",
        "విరోధి శక్తి కొద్ది మరీ తెగించుఁడీ",
        "స్వకీయ శక్తిఁగాక శ్రీ యేసు నామమున్",
        "స్మరించి వానియందు విశ్వాస ముంచుండీ."
      ],
      "english": [
        "Prachanda Maina Dhandu Poaraada Laechinan",
        "Viroadhi Shakthi Kodhdhi Maree Theginchudee",
        "Svakeeya Shakthigaaka Shree Yaesu Naamamun",
        "Smarinchi Vaaniyandhu Vishvaasa Munchundee."
      ]
    }
  ]
}
