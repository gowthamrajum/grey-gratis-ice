{
  "song_name": "Yaesuraaju Needhu Praema Nencha",
  "author": {
    "Authored by": "",
    "రచన": "చదలవాడ తామస్"
  },
  "main_stanza": {
    "telugu": [
      "యేసురాజు నీదు ప్రేమ నెంచ తరముగాదయా",
      "దోషియైన నన్ను బ్రోవ నీసుప్రాణమిడితివా"
    ],
    "english": [
      "Yaesuraaju Needhu Praema Nencha Tharamugaadhayaa",
      "Dhoashiyaina Nannu Broava Neesupraanamidithivaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మంచివాని కొరకు నొకఁడు మరణ మొందుటరుదుగా",
        "అంచితమగు ప్రేమ చేత మించి గాయము లొందినా"
      ],
      "english": [
        "Manchivaani Koraku Nokadu Marana Mondhutarudhugaa",
        "Anchithamagu Praema Chaetha Minchi Gaayamu Londhinaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చెయ్యరాని దుష్కర్మములుఁ చేసి నే చెడియుండగా",
        "అయ్యో మ్రానుమీఁ దికీవు ఇయ్యకొని మోసితివా"
      ],
      "english": [
        "Cheyyaraani Dhushkarmamulu Chaesi Nae Chediyundagaa",
        "Ayyoa Mraanumee Dhikeevu Iyyakoni Moasithivaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గెత్సేమనె వనములోకిఁ జొచ్చి తండ్రికి చిత్తమై",
        "యిచ్చిన నా శ్రమలపాత్రన్ బుచ్చుకొని భరించినా"
      ],
      "english": [
        "Gethsaemane Vanamuloaki Jochchi Thandriki Chiththamai",
        "Yichchina Naa Shramalapaathran Buchchukoni Bharinchinaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "హస్తము,పాదము,ప్రక్కలు మస్తకపు గాయములలో",
        "విస్తరించి చిందె నీ ప్ర శస్త రక్తమంతయున్"
      ],
      "english": [
        "Hasthamu,Paadhamu,Prakkalu Masthakapu Gaayamulaloa",
        "Vistharinchi Chindhe Nee Pra Shastha Rakthamanthayun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కొండమీద నిన్నుఁజూడ గుండెలదిరిపోవునే",
        "నిండు ప్రేమ చేత నావగు మెండుబాధల నోర్చినా"
      ],
      "english": [
        "Kondameedha Ninnujooda Gundeladhiripoavunae",
        "Nindu Praema Chaetha Naavagu Mendubaadhala Noarchinaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మరువలేను నీదు ప్రేమ మరణపరియంతంబు",
        "నా నరక బాధలన్ని నీవా కొరతపై వహించినా"
      ],
      "english": [
        "Maruvalaenu Needhu Praema Maranapariyanthambu",
        "Naa Naraka Baadhalanni Neevaa Korathapai Vahinchinaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నిన్నుదలఁచ నా నిరీక్షణ యున్నతము గానుండును",
        "యెన్నడు నీ మహిమను నా కన్నులారఁజూతునో"
      ],
      "english": [
        "Ninnudhalacha Naa Nireekshana Yunnathamu Gaanundunu",
        "Yennadu Nee Mahimanu Naa Kannulaarajoothunoa"
      ]
    }
  ]
}
