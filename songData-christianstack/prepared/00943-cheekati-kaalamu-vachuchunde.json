{
  "song_name": "Cheekati Kaalamu Vachuchunde",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తలుపులు తెరచియుండగనే – విరిగిన మనస్సుతో సాగెదవా?",
      "కాలమపాయముగా నుండె – సమయము సద్వినియోగించు"
    ],
    "english": [
      "Talupulu terachiyundagane – virigina manassuto sagedava ?",
      "kaala mapaayamuga – nunde – samayamu sadviniyoginchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకటి కాలము వచ్చుచుండె – కృపకాలము నుపయోగించు",
        "తలుపులు తెరచియుండగనే – విరిగిన మనస్సుతో సాగెదవా?"
      ],
      "english": [
        "Cheekati kaalamu vachuchunde – krupakaalamu nupayoginchu",
        "talupulu terachiyundagane – virigina manassutho saagedavaa ?"
      ]
    }
  ]
}
