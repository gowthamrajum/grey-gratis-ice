{
  "song_name": "Chaerikolvudi Kreesthuni Paadhamula",
  "author": {
    "Authored by": "",
    "రచన": "కాజా అనంతము"
  },
  "main_stanza": {
    "telugu": [
      "చేరికొల్వుఁడి క్రీస్తుని పాదములఁ జేరి కొల్వుఁడి",
      "చేరి కొల్వుఁడి స్థిరమతితో మీ నోరు నిండ మది కోరికఁ దీరఁ"
    ],
    "english": [
      "Chaerikolvudi Kreesthuni Paadhamula Jaeri Kolvudi",
      "Chaeri Kolvudi Sthiramathithoa Mee Noaru Ninda Madhi Koarika Dheera"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ధీరకలితుఁ డుప కారకుఁ డితఁ డని",
        "యారూఢిగ మదిఁ గోరి ప్రియమునఁ"
      ],
      "english": [
        "Dheerakalithu Dupa Kaaraku Ditha Dani",
        "Yaaroodiga Madhi Goari Priyamuna"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జనకుని యుగ్రం బును దా నోరిచి",
        "జనులకు మేలు నో సంగి ఘనునిఁ"
      ],
      "english": [
        "Janakuni Yugram Bunu Dhaa Noarichi",
        "Janulaku Maelu Noa Sangi Ghanuni"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సార చరిత్రో దారుఁడు పాతక ధీరుఁడు",
        "శుద్ధా చారుండితఁడని"
      ],
      "english": [
        "Saara Charithroa Dhaarudu Paathaka Dheerudu",
        "Shudhdhaa Chaarundithadani"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దేవుని కొమరుఁడు ధీవిస్తారుఁడు",
        "సేవ కావనుఁడు క్షేమకరుండని"
      ],
      "english": [
        "Dhaevuni Komarudu Dheevisthaarudu",
        "Saeva Kaavanudu Kshaemakarundani"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసుని వారల నీశుఁడు మన్నన జేసి",
        "తప్పు క్షమ చేయునుగానఁ"
      ],
      "english": [
        "Yaesuni Vaarala Neeshudu Mannana Jaesi",
        "Thappu Kshama Chaeyunugaana"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మరణము నొందిన నరులను గృపఁ గ్ర",
        "మ్మరఁ బ్రతికించిన మహిమోజ్వలునిఁ"
      ],
      "english": [
        "Maranamu Nondhina Narulanu Grupa Gra",
        "Mmara Brathikinchina Mahimoajvaluni"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పలు దయ్యంబులఁ బారఁదరిమి రో",
        "గుల రక్షించిన మలినాపహునిఁ"
      ],
      "english": [
        "Palu Dhayyambula Baaradharimi Roa",
        "Gula Rakshinchina Malinaapahuni"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "జను లచ్చెరు వొం దను మూఁగకు నో",
        "రును గన్నులు చీఁ కునకిడినాఁ డని"
      ],
      "english": [
        "Janu Lachcheru Vom Dhanu Moogaku Noa",
        "Runu Gannulu Chee Kunakidinaa Dani"
      ]
    }
  ]
}
