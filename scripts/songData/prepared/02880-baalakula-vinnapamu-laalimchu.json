      ],
      "english": [
        "Prakatithamagu Needhu Praema Yanubhavinchuchu",
        "Ikanu Ninnu Saeva Jaethu Makhilakaalamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పుడమి నీదు సిలువ కృపను పుణ్యలగుచును",
        "కడను నీదు మహిమ జేర గరుణజూపుము"
      ],
      "english": [
        "Pudami Needhu Siluva Krupanu Punyalaguchunu",
        "Kadanu Needhu Mahima Jaera Garunajoopumu"
