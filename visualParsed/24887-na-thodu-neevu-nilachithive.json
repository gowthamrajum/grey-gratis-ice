{
  "song_name": "Naa thodu neevu nilachithive",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor D Chrisostam"
    ],
    "రచన": [
      "పాస్టర్ డి క్రిసోస్తం"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నాతోడు నీవు నిలచితివే",
      "నీ ప్రేమ నాపై చూపితివే ||2||",
      "నను వెంటాడే నీ కృప క్షేమములే",
      "నను కాచే నీ కరుణ కటాక్షములే ||2||",
      "యేసయ్య నీకే స్తోత్రము... ||4||"
    ],
    "english": [
      "Naathodu neevu nilachithive",
      "Nee prema naapai choopithive ||2||",
      "Nanu ventaade nee krupa kshemamule",
      "Nanu kaache nee karuna kataakshamule ||2||",
      "Yesayya neeke sthothramu... ||4||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అగ్ని గుండములో సింహపు బోనులో",
        "నను రక్షించు వారెవరు లేక",
        "నే ఒంటరినైయున్న వేళా",
        "నిలిచావు నాకై తోడుగా",
        "నిలిపావు నన్ను నీదు సాక్షిగా",
        "నను చేసావు నీ రక్షణకే రుజువుగా",
        "యేసయ్య నీకే స్తోత్రము... ||4||"
      ],
      "english": [
        "Agni gundamulo simhapu bonulo",
        "Nanu rakshinchu vaarevaru leka",
        "Ne ontarinaiyunna velaa",
        "Nilichaavu naakai thodugaa",
        "Nilipaavu nannu needu saakshigaa",
        "Nanu chesaavu nee rakshanake rujuvugaa",
        "Yesayya neeke sthothramu... ||4||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అనారోగ్యములో వ్యాధిబాదలో",
        "నను స్వస్థపరచు వారెవరులేక",
        "నే వేదనలో క్రుంగియున్న వేళా",
        "తాకావునన్ను నీ చేతితో",
        "స్వస్థ పరచావు నన్ను నీదు వాక్కుతో",
        "నను చేసావు నీ ప్రేమ్మతో పరిపూర్ణముగా",
        "యేసయ్య నీకే స్తోత్రము... ||4||"
      ],
      "english": [
        "Anaarogyamulo vyaadhi baadhalo",
        "Nanu swasthaparachu vaarevaruleka",
        "Ne vedhanalo krungiyunna velaa",
        "Thaakaavunannu nee chethitho",
        "Svastha parachaavu nannu needu vaakkutho",
        "Nanu chesaavu nee prematho paripoornamugaa",
        "Yesayya neeke sthothramu... ||4||"
      ]
    }
  ]
}
