{
  "song_name": "Manne Kadhayya",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మన్నేగదయ్యా మన్నేగదయ్యా",
      "మహిలోని ఆత్మ జ్యోతియు తప్ప",
      "మహిలోనిదంతా మన్నేగదయ్యా"
    ],
    "english": [
      "Mannegadayyaa mannegadayyaa",
      "mahiloni aathma jyothiyu thappa",
      "mahilonidantha mannegadayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మంచిదంచు ఒకని యించు సంచిలోనే ఉంచినా",
        "మించిన బంగారము మించిన నీ దేహము",
        "ఉంచుము ఎన్నాళ్ళకుండునో",
        "మరణించగానే మన్నేగదయ్యా"
      ],
      "english": [
        "Manchidanchu okani yinchu sanchilone unchinaa",
        "minchina bangaaramu minchina nee dehamu",
        "unchumu ennaallakunduno",
        "maraninchagaane mannegadayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎన్ని నాళ్ళు లోకమందు ఉన్నతముగా నిలిచినా",
        "నిన్ను చూచి లోకులంతా ధన్యుడవని పిలిచినా",
        "మెల్లని పుష్పంబు పోలినా",
        "పుష్పంబుతోనే ఊడిపడినది"
      ],
      "english": [
        "Enni naallu lokamandu unnathamugaa nilachinaa",
        "ninnu choochi lokulantha dhanyudavani pilachinaa",
        "mellani pushpambu polinaa",
        "pushpambuthone oodipadinadi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మిక్కిలి సౌందర్యమగు చక్కని నీ దేహము",
        "ఒక్కనాడు ఆరిపోగా నీలో ఆత్మ దీపము",
        "కుక్క శవంతో సమమేగా",
        "నిక్కముగనదియు మన్నేగదయ్యా"
      ],
      "english": [
        "Mikkili soundaryamagu chakkani nee dehamu",
        "okkanaadu aaripoga neelo aathma deepamu",
        "kukka shavamutho samamegaa",
        "nikkamuganadiyu mannegadayyaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మానవునికి మరణమింత ఎంచనంత మన్నిల",
        "మరణమును జయించుచున్న కాలమింత మన్నిల",
        "మరణ విజయుడేసు క్రీస్తుడే",
        "మది నమ్ము నిత్య జీవమిచ్చ్చును"
      ],
      "english": [
        "Maanavuniki maranamintha enchanantha mannila",
        "maranamunu jayinchuchunna kaalamintha mannila",
        "marana vijayudesu kreesthude",
        "madi nammu nithya jeevamichchunu"
      ]
    }
  ]
}
