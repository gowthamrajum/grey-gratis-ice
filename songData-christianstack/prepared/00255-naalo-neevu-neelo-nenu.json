{
  "song_name": "Naalo Neevu Neelo Nenu",
  "author": {
    "Authored by": "Pastor B Shalem Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నాలో నీవు – నీలో నేను ఉండాలనీ",
      "నీ యందే పరవశించాలని",
      "నా హృదయ ఆశయ్యా",
      "ప్రియుడా యేసయ్యా"
    ],
    "english": [
      "Naalo neevu – neelo nenu undaalani,",
      "nee yandhe paravashinchalani",
      "naa hridaya aashayyaa,",
      "priyudaa yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కడలి యెంత ఎగసిపడినా",
        "హద్దు దాటదు నీ ఆజ్ఞలేక",
        "కలతలన్ని సమసిపోయే",
        "కన్న తండ్రి నిను చేరినాక",
        "కమనీయమైనది నీ దివ్య రూపము",
        "కలనైనా మరువను నీ నామ ధ్యానము",
        "( నాలో నీవు )"
      ],
      "english": [
        "Kadali yentha egasipadina,",
        "haddu datadu nee aagnalekaa",
        "kalathalanni samasipoye,",
        "kanna thandri ninu cherinaa.",
        "kamaneeyamainadi nee divya roopamu,",
        "kalanainaa maruvanu nee naama dhyanamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కమ్మనైనా బ్రతుకు పాట",
        "పాడుకొందును నీలో యేసయ్యా",
        "కంటి పాప యింటి దీపం",
        "నిండు వెలుగు నీవేకదయ్యా",
        "కరుణా తరంగము తాకేను హృదయము",
        "కనురెప్ప పాటులో మారేను జీవితం"
      ],
      "english": [
        "Kammanainaa brathuku paata,",
        "paadukondunu neelo yesayya.",
        "kanti paapa yinti deepam,",
        "nindu velugu neevekadayya.",
        "karunaa tharangamu thaakenu hridayamu,",
        "kanureppa paatulo maarenu jeevitamu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "స్నేహమైనా సందడైనా",
        "ప్రాణమైనా నీవే యేసయ్యా",
        "సన్నిదైనా సౌఖ్యమైనా",
        "నాకు ఉన్నది నీవేకదయ్యా",
        "నీలోనే నా బలం నీలోనే నా ఫలం",
        "నీలోనే నా వరం నీవేగ నా జయం"
      ],
      "english": [
        "Snehamainaa sandadainaa,",
        "praanamainaa neeve yesayya.",
        "sannidainaa soukhyamainaa,",
        "naaku unnadi neevekadayya.",
        "neelone naa balam, neelone naa phalam,",
        "neelone naa varam, neevega naa jayam."
      ]
    }
  ]
}
