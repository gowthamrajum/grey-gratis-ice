{
  "song_name": "Yaesu Vachchedi Vaelaaye Soadharulaaraa",
  "author": {
    "Authored by": "",
    "రచన": "చెదలవాడ తామస్"
  },
  "main_stanza": {
    "telugu": [
      "యేసు వచ్చెడి వేళాయె సోదరులారా",
      "కాశమేఘములతోను భాసురమగుతన నివాసంబునకుమనల",
      "దీసుకపోయిప్రకాశితులను జేయ"
    ],
    "english": [
      "Yaesu Vachchedi Vaelaaye Soadharulaaraa",
      "Kaashamaeghamulathoanu Bhaasuramaguthana Nivaasambunakumanala",
      "Dheesukapoayiprakaashithulanu Jaeya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిద్రమేల్కొను వేళాయె సమయము దెలిసి ఓరిమితో నుండరే",
        "భద్రముగా శత్రుయుపద్రవమును దాటి",
        "సిద్ధపడుఁడి ప్రభునియొద్ద నివసించుటకు"
      ],
      "english": [
        "Nidhramaelkonu Vaelaaye Samayamu Dhelisi Oarimithoa Nundarae",
        "Bhadhramugaa Shathruyupadhravamunu Dhaati",
        "Sidhdhapadudi Prabhuniyodhdha Nivasinchutaku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తనువును బలిపెట్టిన మన రక్షకుఁడు ఘన మహిమలోకి వెళ్లి",
        "తన యింట స్థలములు మనకు సిద్ధముఁజేసి",
        "చనుదెంచు వేళాయె కనిపెట్టి యుందాము."
      ],
      "english": [
        "Thanuvunu Balipettina Mana Rakshakudu Ghana Mahimaloaki Velli",
        "Thana Yinta Sthalamulu Manaku Sidhdhamujaesi",
        "Chanudhenchu Vaelaaye Kanipetti Yundhaamu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "చాలారాత్రి గతించెను సోదరులారా",
        "వెలుగు సమీపించెను వేల దూతలతోడ యేసయ్యవచ్చును",
        "కాలగురుతులగని మేలుకొనరెవేగ"
      ],
      "english": [
        "Chaalaaraathri Gathinchenu Soadharulaaraa",
        "Velugu Sameepinchenu Vaela Dhoothalathoada Yaesayyavachchunu",
        "Kaalaguruthulagani Maelukonarevaega"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శోధన కాలమీదే యీధరణిలో బాధలురావచ్చును",
        "నాధుఁడైన యేసుపాదముల కడనుండ",
        "యేది కీడుచేయలేదు మనపై నెపుడు"
      ],
      "english": [
        "Shoadhana Kaalameedhae Yeedharaniloa Baadhaluraavachchunu",
        "Naadhudaina Yaesupaadhamula Kadanunda",
        "Yaedhi Keeduchaeyalaedhu Manapai Nepudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మనలను బ్రేమించుచూ మన పాపముల దనరక్తమున గడుగుచు",
        "ఘన దేవునికి నర్చకులనుజేసిన ప్రభుని కొనియాడి",
        "బలమహిమలను జెల్లింతుము నిరత"
      ],
      "english": [
        "Manalanu Braeminchuchoo Mana Paapamula Dhanarakthamuna Gaduguchu",
        "Ghana Dhaevuniki Narchakulanujaesina Prabhuni Koniyaadi",
        "Balamahimalanu Jellinthumu Niratha"
      ]
    }
  ]
}
