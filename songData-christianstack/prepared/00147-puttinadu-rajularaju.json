  },
  "main_stanza": {
    "telugu": [
      "పుట్టినాడు రాజులరాజు క్రీస్తు మనకోసమే",
      "వచ్చినాడు యూదుల రాజు యేసు మనకోసమే",
      "పాపుల కొరకై పరమ పవిత్రుడు",
      "దీనుల కొరకై దైవ కుమారుడు"
    ],
    "english": [
      "Puttinaadu raajula raaju kreesthu manakosamea",
      "Vachinaadu yudula raaju yeasu manakosamea",
      "Paapula korakai parama pavithrudu",
      "Deenula korakai dhaiva kumaarudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పుట్టినాడు రాజులరాజు క్రీస్తు మనకోసమే",
