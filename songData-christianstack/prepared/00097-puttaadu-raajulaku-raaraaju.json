{
  "song_name": "Puttaadu Raajulaku Raaraaju",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రాజులకు రారాజు జన్మించె నేడు",
      "దూతాలి పాడ ఇహపరమందు",
      "సర్వోన్నత స్థలములలో దేవునికి మహిమ",
      "ఇష్టులైన ప్రజలకు భూమి మీద సమాధానము"
    ],
    "english": [
      "Raajulaku raaraaju janminche nedu",
      "Dhoothalu paada ihaparamandu",
      "Sarvonnatha sthalamulalo Dhevuniki mahima",
      "Ishtulaina prajalaku bhumimeedha samaadhanamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లా లా లా లా లా లా లా లా లా",
        "హే హే హే హే హే లా లా లా లా"
      ],
      "english": [
        "La la la la la la la la la",
        "He he he he he la la la la"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [],
      "english": [
        "Thaara okati velase kaanthule chinde",
        "Jnaanulaku maargadharsiyai raaraajunu choope",
        "Saagilapadi poojinchi kanukalu arpichi",
        "Sarvaanga sundharuni sanmaaninchiri"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [],
      "english": [
        "Dhaaveedu pattanamandhu rakshakudu puttaadani",
        "Dhoothalu kaaparulaku subhavaarthanu chaatiri",
        "Bethlehemunaku velli Yeasayyanu dharshinchi",
        "Sthuthiyinchi mahima parachiri aa gorrela kaaparulu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [],
      "english": [
        "Kanyaka garbhamulo rakshakudu janmisthaadani",
        "Yeshaya pravachanam neraverina shubhadhinam",
        "Sarvaloka paapamulu pariharinchi rakshinchataku",
        "Simhaasanamu vidachi dhigi vachchina raaraaju"
      ]
    }
  ]
}
