  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశము భువిలో నెల్ల యేసు ఉన్నతుడు",
        "మనుజులు దూతలు దయ్యాలు యేసుకు మ్రొక్కెదరు",
        "నే నమ్ముదు - నే నమ్ముదు యేసు నాకై మరణించెనని",
        "పాపంబు పోవ సిలువలో రక్తము చిందెను"
      ],
      "english": [
        "Aakaashamu bhuvilo nella Yesu unnathudu",
        "Manujulu doothalu dayyaalu Yesuku mrokkedaru",
        "Ne nammudhu - Ne nammudhu Yesu naakai maraninchenani",
        "Paapambu pova siluvalo rakthamu chindhenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రక్షకుడు ప్రాణముబెట్టినది నా కొరకే",
        "వేరేమి వాగ్వాదంబులు అక్కరయే లేదు"
      ],
      "english": [
        "Rakshakudu praanamubettinadhi naa korake",
        "Veremi vaagvaadhambulu akkaraye ledu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రతిపాపి భయమంతయు తీర్చు నామమిదే",
        "నరకదండన యంతయు తొలగించు నామము"
      ],
      "english": [
        "Prathipaapi bhayamanthayu theerchu naamamidhe",
        "Narakadhandana yanthayu tholaginchu naamamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాప సంకెళ్ళు అన్నియు విడగొట్టును యేసు",
        "సాతాను వాని తలను యేసు చితుక గొట్టెన్"
      ],
      "english": [
        "Paapa sankellu anniyu vidagottunu Yesu",
        "Saathaanu vaani thalanu Yesu chithuka gotten"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపంబులో మరణించెడి వారికి ప్రాణమిడున్",
        "బలహీనమైన ఆత్మలకు శక్తి నిచ్చును యేసు"
      ],
      "english": [
        "Paapambulo maraninchedi vaariki praanamidun",
        "Balaheenamaina aathmalaku shakthi nichchunu Yesu"
      ]
    }
  ]
}
