{
  "song_name": "Nikkamuraa lokamu cheddadhiraa thakshaname meluko",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నిక్కమురా లోకము చెడ్డదిరా తక్షణమే మేలుకో సోదారా",
      "ఈ లోకపు పాపపు చీకటిలో నీలోనే వెలుగును చూపుమురా"
    ],
    "english": [
      "Nikkamuraa lokamu cheddadhiraa thakshaname meluko sodhaaraa",
      "Ee lokapu paapapu cheekatilo neelone velugunu choopumuraa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "విన్నాననుకొంటివి కాని గ్రహియింపకున్నావా ?",
        "చూసాననుకొంటూనే తెరువలేకున్నావా",
        "దగ్గరగా ఉంటూనే దూరాన నిలిచేవా",
        "త్రోవను జారా విడిచి కుడి ఎడమకు తప్పావా",
        "పాపేచ్చలతోటి క్రీస్తేసుని మరిచావా",
        "తన గాయములను రేపుటకు కారకుడైయున్నావా"
      ],
      "english": [
        "Vinnaananukontivi kaani grahiyimpakunnaavaa ?",
        "Choosaananukontoone theruvalekunnaavaa",
        "Daggaragaa untoone dooraana nilichevaa",
        "Throvanu jaaraa vidichi kudi edamaku thappaavaa",
        "Paapechchalathoti Kreesthesuni marichaavaa",
        "Thana gaayamulanu reputaku kaarakudaiyunnaavaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శోధనల పోరుటముతో సరిపెట్టకు నీ పయనం",
        "కష్టానష్టాలను సాకులు తప్పించవు నీ గమ్మం",
        "పానార్పణనొందే గాని సుఖమెరుగకు అది శూన్యం",
        "ప్రేమ విశ్వాసముతోటి నడిచేదే నీ జీవితం",
        "నీ పరుగును కడముట్టించే నీదే మంచి పోరాటం",
        "పరభాగ్యము నీవు పొంద ప్రకటించుము యేసుని వాక్యం"
      ],
      "english": [
        "Shodhanala porutamutho saripettaku nee payanam",
        "Kashtaanashtaalanu saakulu thappinchavu nee gamyam",
        "Paanaarpananonde gaani sukhamerugaku adhi shoonyam",
        "Prema vishwaasamuthoti nadichede nee jeevitham",
        "Nee parugunu kadamuttinche neede manchi poraatam",
        "Parabhaagyamu neevu ponda prakatinchumu Yesuni vaakyam"
      ]
    }
  ]
}
