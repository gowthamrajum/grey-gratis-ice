    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "లెవిటికస్ 26:12"
    ],
    "english": [
      "Leviticus 26:12"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మహిమతో నిండిన మా రాజా - మహిమతో తిరిగి వచ్చువాడా",
        "శరీరమును దాని క్రియలెల్లను",
        "ఆశతో వాక్యముచే తొలగించుము - వచ్చి తొలగించుము"
      ],
      "english": [
        "Mahimatho nindina maa raajaa - Mahimatho thirigi vachchuvaadaa",
        "Shareeramunu daani kriyalellanu",
        "Aashatho vaakyamuche tholaginchumu - Vachchi tholaginchumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకస ఆసనమును వీడి - లోకమును జూడ వచ్చితివి",
        "ఇంపుగ వాసము చేయుటకు",
        "సొంపుగ లోన - ప్రవేశించుము ప్రవేశించుము"
      ],
      "english": [
        "Aakaasa aasanamunu veedi - Lokamunu jooda vachchithivi",
        "Impuga vaasamu cheyutaku",
        "Sompuga lona - Praveshinchumu praveshinchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గుడారమున వసించితివి తోడ నిలిచితివి మేఘమువలె",
        "కొఱతలేక జనుల నడిపితివి",
        "వాక్య ప్రకారము కోరి రమ్ము - నేడు కోరి రమ్ము"
      ],
      "english": [
        "Gudaaramuna vasinchithivi thoda nilichithivi meghamuvale",
        "Korathaleka janula nadipithivi",
        "Vaakya prakaaramu kori rammu - Nedu kori rammu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇశ్రాయేలీయులతో నేగితివి ఎజ్రాతోడనే యుంటివి",
        "సొలమోను గుడులో వసియించితివి",
        "కాలమెల్ల మాతో నుండుము మాతో నుండుము"
      ],
      "english": [
        "Ishraayeleeyulatho negithivi Ezraathodane yuntivi",
        "Solamonu gudulo vasiyinchithivi",
        "Kaalamella maatho nundumu maatho nundumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "గిరిపైన చూపిన మాదిరిని మరువక సొంపుగ చేసితివి",
        "అక్కరగా మనము లోబడిన",
        "చక్కగా మనలను పాలించును యేసు"
      ],
      "english": [
        "Giripaina choopina maadhirini maruvaka sompuga chesithivi",
        "Akkaragaa manamu lobadina",
        "Chakkagaa manalanu paalinchunu Yesu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "భూమ్యాకాశములు పట్టని వ్యోమపీఠుడు భువికి వచ్చెన్",
        "నీతితో రాజ్యము నేలుటకు",
        "జ్యోతితోడ లోన వచ్చునేసు నేడు వచ్చు నేసు"
