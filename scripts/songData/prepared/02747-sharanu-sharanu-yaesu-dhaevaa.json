{
  "song_name": "Sharanu Sharanu Yaesu Dhaevaa",
  "author": {
    "Authored by": "",
    "రచన": "మిక్కిలి సమూయేలు"
  },
  "main_stanza": {
    "telugu": [
      "శరణు శరణు యేసు దేవా నన్నుఁ గరుణింపవే నిత్య జీవా",
      "పరమ దేవుని తనూ భవుఁడవై ధరణిలో",
      "నర రూపమైతివి నరులను రక్షింప"
    ],
    "english": [
      "Sharanu Sharanu Yaesu Dhaevaa Nannu Garunimpavae Nithya Jeevaa",
      "Parama Dhaevuni Thanoo Bhavudavai Dharaniloa",
      "Nara Roopamaithivi Narulanu Rakshimpa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవోగ్రమునకుఁ బాత్రుఁడను విమల భావమునకే నసహ్యుఁడను",
        "గావరించిన పాప కర్ముఁడన్ కఠినుఁడన్",
        "జానవలసిన యట్టి స్వామి ద్రోహు డ నయ్య"
      ],
      "english": [
        "Dhaivoagramunaku Baathrudanu Vimala Bhaavamunakae Nasahyudanu",
        "Gaavarinchina Paapa Karmudan Kathinudan",
        "Jaanavalasina Yatti Svaami Dhroahu Da Nayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మద మత్సరమ్ములు మెండై నాదు మది నాక్రమించెను నిండై",
        "సదయుండ నీ దివ్య సర్వాజ్ఞలన్ మీరి",
        "విదితముగఁ బాపముల్ వేడ్కను జేసితి"
      ],
      "english": [
        "Madha Mathsarammulu Mendai Naadhu Madhi Naakraminchenu Nindai",
        "Sadhayunda Nee Dhivya Sarvaagnyalan Meeri",
        "Vidhithamuga Baapamul Vaedkanu Jaesithi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మోసంబులోఁ జిక్కి చాల నేను దోసంబు చేసితినిల",
        "యేసు నాధుని సిలువ నేమాత్రమైన",
        "నే నాసతోఁ జూడని యన్యాయ పరుఁడను"
      ],
      "english": [
        "Moasambuloa Jikki Chaala Naenu Dhoasambu Chaesithinila",
        "Yaesu Naadhuni Siluva Naemaathramaina",
        "Nae Naasathoa Joodani Yanyaaya Parudanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నెమ్మ దించుక యైన మదిలో లేక గ్రమ్ముకొని",
        "యఘము నా యెదలోఁ ద్రిమ్మరినై భువిన్ దిరిగి వేసారఁగ",
        "సమ్మతము దొరక దో సర్వేశ నీకంటె"
      ],
      "english": [
        "Nemma Dhinchuka Yaina Madhiloa Laeka Grammukoni",
        "Yaghamu Naa Yedhaloa Dhrimmarinai Bhuvin Dhirigi Vaesaaraga",
        "Sammathamu Dhoraka Dhoa Sarvaesha Neekante"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా తండ్రి యో యేసునాధా నిన్ను ఘాతఁజేసిన దేనుగాదా",
        "నీతిమాలిన పాప నీచుఁడన్ దుష్టుఁడన్",
        "నా తప్పు క్షమియించి నన్నేలి రక్షించు"
      ],
      "english": [
        "Naa Thandri Yoa Yaesunaadhaa Ninnu Ghaathajaesina Dhaenugaadhaa",
        "Neethimaalina Paapa Neechudan Dhushtudan",
        "Naa Thappu Kshamiyinchi Nannaeli Rakshinchu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కడుదయా శాంతస్వభావా నన్ను దడవుజేయక యేలుకోవా",
        "యొడబడి కుజనులకై యోర్చియలసటను బడి",
        "జీవమిడిననా ప్రాణ రక్షక కావు"
      ],
      "english": [
        "Kadudhayaa Shaanthasvabhaavaa Nannu Dhadavujaeyaka Yaelukoavaa",
        "Yodabadi Kujanulakai Yoarchiyalasatanu Badi",
        "Jeevamidinanaa Praana Rakshaka Kaavu"
      ]
    }
  ]
}
