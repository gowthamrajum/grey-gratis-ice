{
  "song_name": "Mariyaku suthuduga dharanu janminchi Immaanuyelaayen",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మరియకు సుతుడుగ ధరను జన్మించి",
      "ఇమ్మానుయేలాయెన్",
      "నిరుపేదగాను పశువుల పాకలో",
      "తేజోమయ ప్రభు భువుని శిశువుగ బుట్టెను"
    ],
    "english": [
      "Mariyaku suthuduga dharanu janminchi",
      "Immaanuyelaayen",
      "Nirupedhagaanu pashuvula paakalo",
      "Thejomaya prabhu bhuvuni shishuvuga buttenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపసంకటము పోగొట్ట ధరను - ప్రాపకుడు నరునిగ బేత్లెహేమున",
        "పాపపరిహారుడు నరుల మిత్రుడు - అవనిలో జన్మించెన్"
      ],
      "english": [
        "Paapasankatamu pogotta dharanu - Praapakudu naruniga Bethlehemuna",
        "Paapaparihaarudu narula mithrudu - Avanilo janminchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకాశచుక్క భాసిల్లుచుండ - వీకతో దీనోపకారుడు వెలసెన్",
        "హీన సైతానుడు కూలిపోవగన్ - ప్రియముతో ఉదయించెన్"
      ],
      "english": [
        "Aakaashachukka bhaasilluchunda - Veekatho dheenopakaarudu velasen",
        "Heena Saithaanudu koolipovagan - Priyamutho udhayinchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దూత గణములు గీతముల్ పాడ - క్షితిలో నరులు మంగళము పాడ",
        "కన్య మరియమ్మ పాడెను లాలి - పుణ్యుడు జన్మించగా"
      ],
      "english": [
        "Dootha ganamulu geethamul paada - Kshithilo narulu mangalamu paada",
        "Kanya Mariyamma paadenu laali - Punyudu janminchagaa"
      ]
    }
  ]
}
