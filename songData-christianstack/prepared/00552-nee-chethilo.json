{
  "song_name": "Nee Chethilo",
  "author": {
    "Authored by": "Dr Noah R Ajay Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీచేతిలో ఒక కలముగా చిత్రించే కుంచెగ",
      "నీరూపుకు ప్రతిరూపుగ మలిచావు నన్నిలా",
      "నీ గాయపు కిరణాల ప్రోగుగ",
      "నీవాక్యపు నెరవేర్పుల కృతినిగ",
      "చేశావు నన్నిలా"
    ],
    "english": [
      "Nee chethilo oka kalamuga chithrinche kunchega",
      "nee roopuku prathiroopuga malichaavu nannilaa",
      "nee gaayapu kiranaala proguga",
      "nee vaakyapu neraverpula kruthuniga",
      "chesaavu nannilaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ స్వరం విన్న క్షణం",
        "కరిగిపోయె నా హృదయం",
        "చేరువై నీ ప్రేమకు దాసోహమైతిని",
        "తల వంచి నీదు పాదాల చెంత",
        "జీవింతు నీ కోసమే",
        "నీవు నాకుండగా",
        "కొదవయే నాకు లేదుగా",
        "సాక్షిగా నీ సేవలో తుదివరకు నడిచెద",
        "దేదీప్యమైన నీ రాజ్యమందు",
        "వశియింతు నాయేసయ్య."
      ],
      "english": [
        "Nee swaram vinna kshanam",
        "karigipoye naa hrudhayam",
        "cheruvai nee premaku dhaasohamaithini",
        "thalavanchi needhu paadhaala chentha",
        "jeevinthu nee kosame",
        "Neevu naakundagaa",
        "kodhavaye naaku ledhugaa",
        "saakshigaa nee sevalo thudhi varaku nadichedha",
        "dhedheepyamaina nee rajyamandhu",
        "vasiyinthu naa yesayya"
      ]
    }
  ]
}
