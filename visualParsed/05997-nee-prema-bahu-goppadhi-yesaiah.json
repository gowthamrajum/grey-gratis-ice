{
  "song_name": "Nee prema bahu goppadi Yesayya",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Rev G Samuel"
    ],
    "రచన": [
      "రెవరెండ్ జి శామ్యూల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నీ ప్రేమ బహు గొప్పది యేసయ్య"
    ],
    "english": [
      "Nee prema bahu goppadi Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపాల సుడిగాలిలో- పడిపొతి నిను తెలియక",
        "శాపాల సముద్రములో- దిగిపోతి నిను యెరుగక",
        "కరుణించినావు - కాపాడినావు, కరములు చాపి నన్ను లేపావు"
      ],
      "english": [
        "Paapaala sudigaalilo- Padipothi ninu theliyaka",
        "Shaapaala samudhramulo- Dhigipothi ninu erugaka",
        "Karuninchinaavu - Kaapaadinaavu, karamulu chaapi nannu lepaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపిని రక్శింపనూ-పరలొకము విడచినాయ్య",
        "నన్ను పరిశుద్దునిగా చేయనూ - నీ రక్తన్ని కార్చావయ్య",
        "నీచుని ప్రేమించి-నీ ప్రాణమిచ్చావు",
        "నీ నిత్యరాజ్యములో వారసునిగా చేశావు"
      ],
      "english": [
        "Paapini rakshimpanoo-Paralokamu vidachinayya",
        "Nannu parishuddhunigaa cheyanoo - Nee rakthanni kaarchaavayya",
        "Neechuni preminchi-Nee praanamichchaavu",
        "Nee nithyaraajyamulo vaarasunigaa cheshaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ ప్రేమనే చాటను- నన్నిలలో నిలిపావయ్య",
        "నీ సాక్శిగా బ్రతుకను-నీ క్రుప నాకు చూపావయ్య",
        "ఏమిచ్చి నీ రుణం - నే తీర్చగలనయ్య",
        "నా జీవితం- నీకు అర్పింతును యెసయ్య"
      ],
      "english": [
        "Nee premane chaatanu- Nannilalo nilipaavayya",
        "Nee saakshigaa brathukanu-Nee krupa naaku choopaavayya",
        "Emichchi nee runam - Ne theerchagalanayya",
        "Naa jeevitham- Neeku arpinthunu Yesayya"
      ]
    }
  ]
}
