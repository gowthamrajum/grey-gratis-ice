        "Chevraathanu vraasaadu charithraheenudu",
        "Lokamlo endaro mahaathmalunnanoo",
        "Kaalaanni lekkinchutaku Kreesthe shakapurushudani",
        "Vaadhinchi oppinche kraisthavudunnaadu",
        "Chaalenj visirithe mundhukevadu raadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బైబిల్ మహాజ్ఞాన గ్రంధమని",
