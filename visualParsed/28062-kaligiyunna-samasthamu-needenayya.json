{
  "song_name": "Kaligiyunna samasthamu needhenayya",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Sudheer Nelaturi"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కలిగియున్న సమస్తము నీదేనయ్యా",
      "పొందుకున్నది నీ దగ్గరేనయ్యా",
      "నీదే ఆ త్యాగము నీదే మా జీవము"
    ],
    "english": [
      "Kaligiyunna samasthamu needhenayya",
      "Pondhukunnadhi nee dhaggarenayya",
      "Neede aa thyaagamu neede maa jeevamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా బలము నీ బలహీనతను వివరింపగలదా",
        "మా ధనము నీ దీనత్వమును వర్ణింపదగునా",
        "మాకున్న సమస్తము నీ లేమిలోనిదే",
        "మా శక్తి బలములు బలహీనుడ నీవే",
        "మా ధనము ఈ బలము",
        "నిను కొలచుటకై చాలదయ్యా",
        "మా అధికారం నీ దాసత్వమును వెక్కిరింపగలదా",
        "ఈ అలంకార అందములు నీ గాయపడిన శరీరము సాటిదా",
        "మాకున్న సమస్తము నీ లేమిలోనిదే",
        "ఈ అధికారంధములు నీ పాత్రలోనిదే",
        "మా జ్ఞానము ఈ ప్రాయము",
        "నిను స్తుతించుటకై చాలదయ్యా"
      ],
      "english": [
        "Maa balamu nee balaheenathanu vivarimpagaladhaa",
        "Maa dhanamu nee dheenathvamunu varnimpadhagunaa",
        "Maakunna samasthamu nee lemilonidhe",
        "Maa shakthi balamulu balaheenuda neeve",
        "Maa dhanamu ee balamu",
        "Ninu kolachutakai chaaladhayya",
        "Maa adhikaaram nee dhaasathvamunu vekkirimpagaladhaa",
        "Ee alankaara andamulu nee gaayapadina shareeramu saatidhaa",
        "Maakunna samasthamu nee lemilonidhe",
        "Ee adhikaaraandhamulu nee paathralonidhe",
        "Maa gnaanamu ee praayamu",
        "Ninu sthuthinchutakai chaaladhayya"
      ]
    }
  ]
}
