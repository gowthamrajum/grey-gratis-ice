    {
      "stanza_number": 2,
      "telugu": [
        "తంబుర వీణతోను సితార నాదముతో",
        "కొనియాడను మన స్వామి యేసును సాగిలపడి రావా"
      ],
      "english": [
        "Thambura veenathonu sithaara naadamutho",
        "Koniyaadanu mana swaami Yesunu saagilapadi raavaa"
      ]
