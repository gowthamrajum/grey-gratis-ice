        "Rogike aushadhamu - Baagugaa naa rakthadhaare",
        "Haa divya rakthamu - Entho amoolyamu",
        "Nan shudhdhicheyunu - Yesuyokka rakthadhaare"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాప పరిహారము - ప్రాపు యేసురక్తధారే",
        "శాపపు సంహారము - స్వామి యేసు రక్తధారే"
      ],
      "english": [
