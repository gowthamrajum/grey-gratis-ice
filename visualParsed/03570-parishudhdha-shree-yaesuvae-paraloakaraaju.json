      "నిరతము తన పాలనము జరిగించుచున్నరాజు"
    ],
    "english": [
      "Parishuddha Shree Yesuve - Paralokaraaju",
      "Muriyuchu ne poojinthunu - Nirathamu",
      "Paraloka mahimanundi - Narula raajyamulalo",
      "Nirathamu thana paalanamu jariginchuchunnaraaju"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
