{
  "song_name": "Chandhamama",
  "author": {
    "Authored by": "Asha Ashirwadh Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "చందమామ చందమామ",
      "రాజు పుట్టాడంట ఓయమ్మా",
      "వెన్నెలమ్మిది నిజమా",
      "అతన్నికన్నా సుందరుడంటమ్మా",
      "నవ్వుల పసిబాలూడోయమ్మ",
      "అధ్వితీయుడే అరుదించడమ్మా",
      "నశియించే మనకోసం ప్రేమించి ఇలా వచ్చాడమ్మా",
      "రండయ్యో రండమ్మా స్వాగతీద్దాం",
      "మన హృదయంలోనే వేదికేదాం",
      "సంతోష సంబరాలు చేసేదాం",
      "మనమంతా కలిసి పండుగ చేదాం"
    ],
    "english": [
      "Chandamaama chandamaama",
      "Raaju puttadanta ooyammaa",
      "Vennelammidi nijamaa",
      "Athannikannaa sundarudantammaa",
      "Navvula pasibaaluudooyammaa",
      "Adhvithiiyudea arudinchadammaa",
      "Nasiyinchea manakoosam peaminchi ilaa vacchhaadammaa",
      "Randyyoo randammaa swagathiiddaam",
      "Mana hrudayamloonea veadikeadaam",
      "Santhoosha sambaraalu cheaseadaam",
      "Manamanthaa kalasi panduga cheadaam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యూదయ దేశమున బేత్లేహేము గ్రామమున",
        "ఓ గొప్ప వెలుగు ప్రకాశించే",
        "ఏమిటని సూడబోతే ఓ దూత ఎదురుపడి",
        "మెస్సయా పుట్టాడని వార్త చెప్పే",
        "పరుగున పరుగున సూడ వెళ్ళామే",
        "రారాజునే దర్శించామే",
        "ఆ సుందరుని హృదిలో మేము నిండామే",
        "ఎంత భాగ్యమిదని గొల్లలు పాడారే"
      ],
      "english": [
        "Yuudaya deasamuna bethlehemu graamamuna",
        "Oo goppa velugu prakaasinchea",
        "Eamitani suudaboolea oo duutha eadurupadi",
        "Messayyaa puttaadani vaartha cheppea",
        "Paruguna paruguna suuda vellaamea",
        "Raaraajunea darsinchaamea",
        "Aa sundaruni hrudiloo meamu nindaamea",
        "Eantha bhaagyamidani gollalu paadaarea"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఓరోరి సిన్నవాడా సూడరా గొప్ప తార",
        "మనరాజు పుట్టే సూచనరా",
        "ఆరా తెదామురా పండుగ చేదమురా",
        "విలువైనవన్నీ అర్పిదామురా",
        "అంటూ జ్ఞానులే చూడ వెళ్లారే",
        "ఆ గొప్ప రాజుని పూజించారే",
        "దేవధూతలే మహిమతో నిండారె",
        "ఎంత అద్భుతమిదని పరవశించారే"
      ],
      "english": [
        "Ooroori sinnavaadaa suudaraa goppa thaara",
        "Manaraaju puttea suuchanaraa",
        "Aaraa thedaamudaa panduga cheadamuraa",
        "Viluvainavannii arpidaamuraa",
        "Antuu gnaanulea chuuda vellaarea",
        "Aa goppa raajuni puujinchaarea",
        "Deavadhuuthalea mahimathoo nidaarea",
        "Eantha adbhuthamidani paravasinchaarea"
      ]
    }
  ]
}
