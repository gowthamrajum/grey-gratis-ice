{
  "song_name": "Chirakaalam Nee Sannidhilo",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "చిరకాలం నీ సన్నిధిలో",
      "చిరునవ్వులతో స్తుతియింతును",
      "నా యేసయ్యా నాయేసయ్యా ॥2॥"
    ],
    "english": [
      "Chirakaalam nee sannidhilo",
      "Chirunavvulatho sthuthiyinthunu",
      "Naa Yesayyaa naa Yesayyaa ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ మందిరములో నీ సముఖములో",
        "స్తుతులతో ఆరాధన గొప్పదేవునికీ",
        "ధూపముగా పరమునకు ఎక్కుచుండగా",
        "స్తుతులూ స్వీకరించి మేఘాలు సృజించీ",
        "ఆశీర్వాద వర్షము కురిపిస్తావూ  ||చిరకాలం||"
      ],
      "english": [
        "Nee mandiramulo nee samukhamulo",
        "Sthuthulatho aaraadhana goppa Dhevunikee",
        "Dhoopamugaa paramunaku ekkuchundagaa",
        "Sthuthuloo sweekarinchi meghaalu srujinchee",
        "Aasheervaadha varshamu kuripisthaavoo  ||Chirakaalam||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "హల్లెలూయ పాటలతో స్తుతియించినచో",
        "మెరుపులతో ఉరుములను పుట్టిస్తావు",
        "తొలకరీ వానగా కడవరీ జల్లులై",
        "నీ దీవెన వర్షాలు కురిపిస్తావు  ||చిరకాలం||"
      ],
      "english": [
        "Hallelooya paatalatho sthuthiyinchinacho",
        "Merupulatho urumulanu puttisthaavu",
        "Tholakaree vaanagaa kadavaree jallulai",
        "Nee deevena varshaalu kuripisthaavu  ||Chirakaalam||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మ సంబంధమైన పద్యములన్నీ",
        "దైవాత్మ ఫలములనూ సృష్ఠిస్తావూ",
        "ఆత్మ జల ప్రళయమై స్తూతీ ప్రవాహముగా",
        "కృపాత్మా వర్షాలు కురిపిస్తావూ  ||చిరకాలం||"
      ],
      "english": [
        "Aathma sambandhamaina padyamulannee",
        "Dhaivaathma phalamulanoo srushtisthaavoo",
        "Aathma jala pralayamai sthuthee pravaahamugaa",
        "Krupaathmaa varshaalu kuripisthaavoo  ||Chirakaalam||"
      ]
    }
  ]
}
