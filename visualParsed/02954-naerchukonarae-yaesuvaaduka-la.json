{
  "song_name": "Nerchukonare Yesuvaaduka",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఈతకోట ప్రకాశము"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నేర్చుకొనరే యేసువాడుక లనుదినము మీ బ్రతుకునందున",
      "నేర్చుకొనిన మీరలాయన జనముగ నొప్పుదురు ఇలలో ||నేర్చుకొనరే||"
    ],
    "english": [
      "Nerchukonare Yesuvaaduka lanudhinamu mee brathukunandhuna",
      "Nerchukonina meeralaayana janamuga noppudhuru ilalo ||Nerchukonare||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆలయ ఆరాధనలకు బోయెడియలవాటుగలిగియు చాలమారులు",
        "ఆలయమునకు అరగిన యా ప్రభుని వాడుక  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Aalaya aaraadhanalaku boyediyalavaatugaligiyu chaalamaarulu",
        "Aalayamunaku aragina yaa prabhuni vaaduka  ||Nerchukonare||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవవాక్య పఠనమందున దీక్షగలిగియు మరియ సుతుడు దివ్యముగ",
        "నా గ్రంథ పఠనము జేసినవిధంబు మీరలు  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Dhevavaakya pathanamandhuna dheekshagaligiyu Mariya suthudu dhivyamuga",
        "Naa grantha pathanamu jesinavidhambu meeralu  ||Nerchukonare||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరమ తండ్రికి ప్రార్థనలు ప్రతివేళ జేయుట పరమవిధియని మరువకను",
        "ప్రార్ధించి మనలను నిరతమును ప్రార్ధింపమనెను  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Parama thandriki praarthanalu prathivela jeyuta paramavidhiyani maruvakanu",
        "Praardhinchi manalanu nirathamunu praardhimpamanenu  ||Nerchukonare||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బీద పాపులు బాధితులు బంధింపబడిన వారి కెల్లను ఆదరము",
        "జూపించి మేలును జేసిన విధంబు మీరలు  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Beeda paapulu baadhithulu bandhimpabadina vaari kellanu aadharamu",
        "Joopinchi melunu jesina vidhambu meeralu  ||Nerchukonare||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సువార్త ప్రకటనజేయుట సుభాగ్యముగ దానెంచి యీ భువి సేవలో",
        "సువార్త జాటుచు సంచరించిన యేసు వాడుక ||నేర్చుకో||"
      ],
      "english": [
        "Suvaartha prakatanajeyuta subhaagyamuga dhaanenchi ee bhuvi sevalo",
        "Suvaartha jaatuchu sancharinchina Yesu vaaduka ||Nerchuko||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అక్కరలలో దన్నుజేరి మక్కువతో బ్రార్ధించి వేడిన పెక్కు జనముల",
        "యక్కరలను జక్కగ దీర్చిన విధంబును  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Akkaralalo dhannujeri makkuvatho braardhinchi vedina pekku janamula",
        "Yakkaralanu jakkaga dheerchina vidhambunu  ||Nerchukonare||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దైవచిత్తము దీర్చుటయే తన ధర్మ విధిగ నెరిగి యాయన ధరణిలో నా",
        "ధర్మమునకై మరణమొందిన విభుని మాదిరి  ||నేర్చుకొనరే||"
      ],
      "english": [
        "Dhaivachitthamu dheerchutaye thana dharma vidhiga nerigi yaayana dharanilo naa",
        "Dharmamunakai maranamondhina vibhuni maadiri  ||Nerchukonare||"
      ]
    }
  ]
}
