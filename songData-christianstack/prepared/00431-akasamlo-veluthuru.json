{
  "song_name": "Akasamlo Veluthuru",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆకాశంలో వెలుతురు- ఎక్కడిదమ్మ ఈ వెలుతురు",
      "ఏ రాజు ఉదయించెనమ్మా- యేసు రాజు ఉదయించెనమ్మా"
    ],
    "english": [
      "Aakaasamloo veluthuru – ekkadidhamma ee veluthuru",
      "ea raaju udhayinchenammaa – yeasu raaju udhayinchenammaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీలి నీలి నింగిలోన బహు బృంద గానాలు",
        "పాడిరి దూతలు ఆనందముతో",
        "ఇలలోన వెలసిన మన యేసుకు"
      ],
      "english": [
        "Niili niili ningiloona bahu brundhagaanaalu",
        "paadiri dhuuthalu aanandhamuthoo",
        "ilaloona velasina mana yeasuku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చీకటి కమ్మిన లోకంలో అద్భుత దీపం వెలిగింది",
        "సర్వ సృష్టికి శుభ దినము",
        "యేసు వెలసిన ఈ దినము"
      ],
      "english": [
        "Chiikati kammina lookamloo adbhtha dheepam veligindhi",
        "sarva srusttiki subha dhinamu",
        "yeasu velasina ee dhinamu"
      ]
    }
  ]
}
