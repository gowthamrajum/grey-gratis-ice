{
  "song_name": "Anudinamu maa bhaaramu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "అనుదినము మా భారము - భరించే దేవా",
      "అనిశము నీ మేళ్ళతో - నింపుచున్నావు"
    ],
    "english": [
      "Anudinamu maa bhaaramu - Bharinche Deva",
      "Anishamu nee mellatho - Nimpuchunnaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సన్నుతించు మనిశము - నా ప్రణమా యేసుని",
        "పరిశుద్ధ నామమును - పొగడు మెప్పుడు",
        "ఒంటె బరువు దీవెనలు - వీపున మోసె"
      ],
      "english": [
        "Sannuthinchu manishamu - Naa praanamaa Yesuni",
        "Parishuddha naamamunu - Pogadu meppudu",
        "Onte baruvu deevenalu - Veepuna mose"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా శరీరమున ముల్లు - బాధపరచుచుండగా",
        "వేదనతో వేడగా - ధైర్యమిచితివి",
        "నా కృప నీ కెల్లప్పుడు - చాలునంటివి"
      ],
      "english": [
        "Naa shareeramuna mullu - Baadhaparachuchundagaa",
        "Vedanatho vedagaa - Dhairyamichchithivi",
        "Naa krupa nee kellappudu - Chaalunantivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అపరాధముతో మేము చిక్కుకొని యుండగా",
        "నీ రక్తముతో మమ్ము - విమోచించితివి",
        "నీదు కృప మహదై-శ్వర్యంబును బట్టి"
      ],
      "english": [
        "Aparaadhamutho memu chikkukoni yundagaa",
        "Nee rakthamutho mammu - Vimochinchithivi",
        "Needu krupa mahadhai-shwaryambunu batti"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అన్నిటిలో నెప్పుడు - సకల సంపదలతోను",
        "సమృద్ధితో మమ్ములను - సాకుచుంటివి",
        "కృపా క్షేమములను మాపై - కుమ్మరించితివి"
      ],
      "english": [
        "Annitilo neppudu - Sakala sampadhalathonu",
        "Samruddhitho mammulanu - Saakuchuntivi",
        "Krupaa kshemamulanu maapai - Kummarinchithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సర్వవేళల సంతృప్తిని - నేర్పినావు మాకిల",
        "సకలంబును చేయుటకు - శక్తి నిచ్చితివి",
        "బలపరచుము నిన్ను బట్టి - బలుడవు దేవా"
      ],
      "english": [
        "Sarvavelala santhrupthini - Nerpinaavu maakila",
        "Sakalambunu cheyutaku - Shakthi nichchithivi",
        "Balaparachumu ninnu batti - Baludavu Deva"
      ]
    }
  ]
}
