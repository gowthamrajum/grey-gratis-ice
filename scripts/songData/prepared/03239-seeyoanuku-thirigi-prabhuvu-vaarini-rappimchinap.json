{
  "song_name": "Seeyoanuku Thirigi Prabhuvu Vaarini RappiMchinapudu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సీయోనుకు తిరిగి ప్రభువు వారిని రప్పించినపుడు",
      "మనము కలలను కనిన వారివలె నుంటిమిగా"
    ],
    "english": [
      "Seeyoanuku Thirigi Prabhuvu Vaarini RappiMchinapudu",
      "Manamu Kalalanu Kanina Vaarivale NuMtimigaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అప్పుడు నోటి నిండ నవ్వుండెనుగా మనకు",
        "అందుకే మన నాలుక ఆనంద గానముతో నిండె"
      ],
      "english": [
        "Appudu Noati NiMda NavvuMdenugaa Manaku",
        "AMdhukae Mana Naaluka AanaMdha Gaanamuthoa NiMde"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవా వీరి కొరకు గొప్ప కార్యములు జేసె",
        "అన్య జనులెల్లరు చెప్పుకొనుచుండిరిగా"
      ],
      "english": [
        "Yehoavaa Veeri Koraku Goppa Kaaryamulu Jaese",
        "Anya Janulellaru CheppukonuchuMdirigaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఘనకార్యంబులను యెన్నో యెహోవా చేసె మనకు",
        "మన మందరము యెంతో ఆనందభరితులమైతిమి"
      ],
      "english": [
        "GhanakaaryaMbulanu Yennoa Yehoavaa Chaese Manaku",
        "Mana MaMdharamu YeMthoa AanaMdhabharithulamaithimi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దక్షిణ దేశములో నదులు పారునట్లుగా",
        "దయతో చెరలో నున్న మా జనులను రక్షించుము ప్రభువా"
      ],
      "english": [
        "DhakShiNa Dhaeshamuloa Nadhulu Paarunatlugaa",
        "Dhayathoa Cheraloa Nunna Maa Janulanu RakShiMchumu Prabhuvaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పిడికెడు విత్తనములు పట్టుకొని పోవువాడు",
        "పంటను కోయును ముదముగ కన్నీటితో విత్తువాడు"
      ],
      "english": [
        "Pidikedu Viththanamulu Pattukoni Poavuvaadu",
        "PaMtanu Koayunu Mudhamuga Kanneetithoa Viththuvaadu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఎన్నో ప్రయాసములతో సమకూర్చును పంటంతటిని",
        "సంతోష గానము చేయుచు పనల మోసికొని వచ్చును"
      ],
      "english": [
        "Ennoa Prayaasamulathoa Samakoorchunu PaMtaMthatini",
        "SaMthoaSha Gaanamu Chaeyuchu Panala Moasikoni Vachchunu"
      ]
    }
  ]
}
