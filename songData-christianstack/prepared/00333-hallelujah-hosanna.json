{
  "song_name": "Hallelujah Hosanna",
  "author": {
    "Authored by": "Bishop Rachel jyothi Komanapalli",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "హల్లెలూయా హల్లెలూయా హల్లెలూయా పాడెదం",
      "హోసన్నా హోసన్నా హోసన్నా యేసుకే"
    ],
    "english": [
      "Hallelujah hallelujah hallelujah paadedham",
      "hosannaa hosannaa hosannaa yesuke"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమతో యేతెంచెను పాపమును మోసెను",
        "ప్రాయశ్చిత్తబలిగా ప్రాణమునర్పించెను",
        "మృత్యువును గెలిచెను దుఃఖమును బాపెను",
        "క్రీస్తు గీతం పాడి శ్రీ యేసుని కీర్తింతుము",
        "నిరీక్షణానిచ్చెను",
        "నిట్టూర్పు పోగొట్టెను",
        "నిత్యండైన యేసుతో నిశ్చింతగా సాగెదన్",
        "విశ్వాసమూనిచ్చెను విజయము చేకూర్చెను",
        "విశ్వమంత చాటన్ ప్రభు యేసు వార్తను",
        "అద్భుతమునిచ్చెను భయమును బాపెను",
        "అభయ హస్తమిచ్చీ ఈ భూమిలో నిల్పెను"
      ],
      "english": [
        "Prematho yethenchenu paapamunu mosenu",
        "praayaschittabalagaa praanamarpinchenu",
        "Mruthyuvunu gelichenu dhukkhamunu baapenu",
        "kreesthu geetham paadi sree yesuni keerthinthumu",
        "Nireeksjannaa nicchenu",
        "nittoorpu pogottenu",
        "nithyudaina yesutho nischinthagaa saagedhan",
        "Viswaasamunicchenu vijayamu chekoorchenu",
        "viswamantha chaatan prabhu yesu vaarthanu",
        "Adbhuthamunicchenu bhayamunu baapenu",
        "abhaya hasthamicchee ee bhoomilo nilpenu"
      ]
    }
  ]
}
