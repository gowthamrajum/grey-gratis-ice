{
  "song_name": "Ennelo Ennela Kannullo Ennela",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఎన్నెలో ఎన్నెలా కన్నుల్లో ఎన్నెలా యేసయ్యను నమ్ముకుంటే ఎన్నెలో ఎన్నెలా",
      "ఆ సామిని కొలుసుకుంటే బతుకంతా ఎన్నెలా"
    ],
    "english": [
      "Ennelo Ennela Kannullo Ennela Yesayyanu Nammukumte Ennelo Ennela",
      "A Samini Kolusukumte Batukamta Ennela"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోకం నుండి దొరా నరలోకం వచ్చిండు",
        "మన సీకటి బతుకుల్లో ఎలుతురే తెచ్చిండు"
      ],
      "english": [
        "Paralokam Numdi Dora Naralokam Vachchimdu",
        "Mana Sikati Batukullo Eluture Techchimdu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సెంతజేరినోళ్ళకంత సింతలన్ని బాపెనంట",
        "ఎంతటి రోగాలైనా సిటికెలో తీసేసెనంట"
      ],
      "english": [
        "Semtajerinollakamta Simtalanni Bapenamta",
        "Emtati Rogalaina Sitikelo Tisesenamta"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సొరగానికి దారిసూప అడుగుబెట్టె భూమిమీద",
        "మరణానికి బుద్దిసెప్ప కన్నుమూసె సిలువమీద"
      ],
      "english": [
        "Soraganiki Darisupa Adugubette Bumimida",
        "Marananiki Buddiseppa Kannumuse Siluvamida"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సక్కనయ్య మోముజూడ సిక్కులన్ని తీరిపోవు",
        "మక్కువతో శరణువేడ బతుకంతా మనలగాయు"
      ],
      "english": [
        "Sakkanayya Momujuda Sikkulanni Tiripovu",
        "Makkuvato Saranuveda Batukamta Manalagayu"
      ]
    }
  ]
}
