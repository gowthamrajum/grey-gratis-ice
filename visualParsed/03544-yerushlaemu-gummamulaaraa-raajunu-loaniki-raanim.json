{
  "song_name": "Yerushalemu gummamulaaraa raajunu loniki raanimmu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యెరుషలేము గుమ్మములారా రాజును లోనికి రానిమ్ము",
      "చిరునవ్వుతో ప్రభు యేసుని నేడే ఆహ్వానించుము"
    ],
    "english": [
      "Yerushalemu gummamulaaraa raajunu loniki raanimmu",
      "Chirunavvutho prabhu Yesuni nede aahvaaninchumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "విజయుడై వచ్చుచున్నాడు శత్రు సాతానును ఓడించి",
        "ఖర్జూర మట్టలు వస్త్రము లెందుకు",
        "మీ హృదయములను పరువుడి"
      ],
      "english": [
        "Vijayudai vachchuchunnaadu shathru Saathaanunu odinchi",
        "Kharjoora mattalu vasthramu lendhuku",
        "Mee hrudhayamulanu paruvudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అభ్యంతర పరచకుము పిల్లలు, వృద్ధులు, యౌవనులన్",
        "ప్రభుని విజయమునందు వారిని",
        "స్తుతిస్తోత్రములు పాడనిమ్ము"
      ],
      "english": [
        "Abhyanthara parachakumu pillalu, vruddhulu, yauvanulan",
        "Prabhuni vijayamunandhu vaarini",
        "Sthuthisthothramulu paadanimmu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ ధుష్టక్రియలను బట్టి ప్రభుని దయము త్రోసెదవా",
        "పరమ రాజును హృదయ మందిరమున",
        "నేడే రానిమ్ము స్నేహితుడా"
      ],
      "english": [
        "Nee dhushtakriyalanu batti prabhuni dhayamu throsedhavaa",
        "Parama raajunu hrudaya mandhiramuna",
        "Nede raanimmu snehithudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నిన్ను దర్శించుటకే ప్రభు నీ చెంతకు వచ్చెనుగా",
        "గాయపడిన హస్తమును చాచి",
        "నీ మదిలో చోటిమ్మనెను"
      ],
      "english": [
        "Ninnu dharshinchutake Prabhu nee chenthaku vachchenugaa",
        "Gaayapadina hasthamunu chaachi",
        "Nee madilo chotimmanenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పశ్చాత్తాపము నొందుము నేడే నీ పాపము లొప్పుకొనుము",
        "జీవము రక్షణ శాంతి నొసగును",
        "ఆయనే ప్రభువు శ్లాఘించుము"
      ],
      "english": [
        "Pashchaaththaapamu nondhumu nede nee paapamu loppukonumu",
        "Jeevamu rakshana shaanthi nosagunu",
        "Aayane Prabhuvu shlaaghinchumu"
      ]
    }
  ]
}
