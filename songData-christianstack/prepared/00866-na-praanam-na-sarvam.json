{
  "song_name": "Na Praanam Na Sarvam",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రాణం నా సర్వం",
      "అంతరంగమున సమస్తము",
      "ఆయన చేసిన మేళ్లను మరువకుమా"
    ],
    "english": [
      "Naa praanam naa sarvam",
      "antharangamuna samasthamu",
      "aayana chesina mellanu maruvakumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా దోషములను క్షమించు దేవుడు",
        "వేదనలను తొలగించును",
        "కరుణా కటాక్షము కీరీటముగా ఉంచావు",
        "నీ ఆత్మతో నన్ను నింపావు",
        "నీ రక్షణ నాకిచ్చావు",
        "కుమారునిగా నన్ను చేర్చుకున్నావు పరమతండ్రివి"
      ],
      "english": [
        "Naa doshamulanu kshaminchu devudu",
        "vedanalanu tholaginchunu",
        "karunaa kataakshamu keeritamugaa unchaavu",
        "Nee aathmatho nannu nimpaavu",
        "nee rakshana naakichaavu",
        "kumaarunigaa nannu cherchukunnaavu paramathandrivi"
      ]
    }
  ]
}
