{
  "song_name": "Jeevamaargamun Yaesoo Choopavae",
  "author": {
    "Authored by": "",
    "రచన": "నికొలాస్ జింజెండార్ఫ్"
  },
  "main_stanza": {
    "telugu": [
      "జీవమార్గమున్ యేసూ, చూపవే నీవు మాకు",
      "ముందు వేగ వెంట వత్తు మేము వేగ",
      "తండ్రి యింటికే మమ్ము నడ్పవే"
    ],
    "english": [
      "Jeevamaargamun Yaesoo, Choopavae Neevu Maaku",
      "Mundhu Vaega Venta Vaththu Maemu Vaega",
      "Thandri Yintikae Mammu Nadpavae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హింస కల్గెన మమ్ము గావుమా",
        "మమ్ము కష్టకాలమందు నాదరించు",
        "భూమియందు మింటిత్రోవలో మమ్ము నడ్పవే."
      ],
      "english": [
        "Hinsa Kalgena Mammu Gaavumaa",
        "Mammu Kashtakaalamandhu Naadharinchu",
        "Bhoomiyandhu Mintithroavaloa Mammu Nadpavae."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సొంత వేదనన్ చింత కల్గినన్",
        "అన్య హింసఁ గూర్చి యేడ్వ మమ్ములన్",
        "సహింపనిమ్ము మేము సత్యమున్ చూడ నేర్పవే."
      ],
      "english": [
        "Sontha Vaedhanan Chintha Kalginan",
        "Anya Hinsa Goorchi Yaedva Mammulan",
        "Sahimpanimmu Maemu Sathyamun Chooda Naerpavae."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మా ప్రవర్తన చక్కపర్చుమా",
        "మాకు నెట్టి హింసలైన నీ సహాయ మిచ్చి,",
        "నేటి యాత్రకాఁగానే తలుపు దీయవే."
      ],
      "english": [
        "Maa Pravarthana Chakkaparchumaa",
        "Maaku Netti Hinsalaina Nee Sahaaya Michchi,",
        "Naeti Yaathrakaagaanae Thalupu Dheeyavae."
      ]
    }
  ]
}
