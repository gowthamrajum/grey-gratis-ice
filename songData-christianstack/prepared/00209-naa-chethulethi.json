    {
      "stanza_number": 4,
      "telugu": [
        "మరణభయము నుండి రక్షించితివి",
        "నూతన జీవము నిచ్చితివి",
        "నా పేరుతో నన్ను పిలిచితివి",
        "మహిమతో నింపితివి"
      ],
      "english": [
        "Maranabayamu nundi rakshinchithivi",
        "Nuuthana jeevamunichithivi",
        "Naa perutho nannu pilichithivi",
        "Mahimatho nimpithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "Pre-Chorus",
        "Chorus"
      ],
      "english": [
        "Pre-Chorus",
        "Chorus"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "Bridge:",
        "మహిమ ప్రభావములు నీకే",
        "నీవే మా ప్రభుడవు",
        "నీ చిత్తమే జరగించుము",
        "నీ రాజ్యం వచ్చును"
      ],
      "english": [
        "Bridge:",
        "Mahima prabhaavamulu neeke",
        "Neeve maa prabhudavu",
