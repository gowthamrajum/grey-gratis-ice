{
  "song_name": "Nasiyinchedi Lokamlo",
  "author": {
    "Authored by": "Dr. John Wesly",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నశియించెడి లోకంలో – వసియించవు కలకాలం",
      "మేలైనది చేపట్టి – సాగించు నీ పయనం",
      "అది నాదంటూ ఇది నాదంటూ – ఆనందం కోల్పోతూ",
      "పరమార్ధం గ్రహియించకనే – గతియించిపోతావా"
    ],
    "english": [
      "Nasiyinchedi lokamlo – vasiyinchavu kalakaalam",
      "melainadhi chepatti – saaginchu nee payanam",
      "adhi naadhantu idhi naadhantu – aanandam kolpothu",
      "paramaardham grahiyinchakane – gathinchipothaava"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కాలంతో పాటుగా కృశియించును శరీరం",
        "మరణం కబళించును ఏ ఘడియలోనైనా",
        "క్రీస్తు దారిలో సాగి – నిత్య రాజ్యమే చేరి",
        "వసియించు కలకాలం – సత్యమైన లోకంలో",
        "నిలచిపోవును మహిలోన బంధాలన్ని",
        "మట్టిలో కలియును దేహం రిక్త హస్తాలతో",
        "ఇకనైనా తేరుకొని – గ్రహియించు సత్యాన్ని",
        "యేసులోకి మళ్ళించు – నీ జీవిత గమనాన్ని"
      ],
      "english": [
        "Kaalamtho paatugaa krushiyinchunu shareeram",
        "manaram kabalinchunu ey ghadiyalonainaa",
        "kreesthu dhaariloa saagi – nithya raajyame cheri",
        "vasiyinchu kalakaalam – sathyamaina lokamlo",
        "Nilichipovunu mahimalona bhandhaalanni",
        "mattilo kaliyunu dheham riktha hasthaalatho",
        "ikanaina therukoni – grahiyinchu sathyaanni",
        "yesuloki mallinchu – nee jeevitha gamanaanni"
      ]
    }
  ]
}
