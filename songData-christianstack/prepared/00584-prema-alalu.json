  "main_stanza": {
    "telugu": [
      "నా యేసు ప్రేమ – శాశ్వత ప్రేమ",
      "అవదులు లేని ప్రేమ – షరతులు కోరని ప్రేమ"
    ],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప – మ ప ద – ప ద ని – ని ద ప",
        "ప – మ ప ద – ప ద ని – స ని రి"
      ],
      "english": []
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కడలిలో నీళ్ళన్ని సిరగా మారితే",
        "ఆకాశం ఒక కాగితమైతే",
        "ధరణిపై ఉన్న ప్రతి కొమ్మ కలమైతే",
        "జీవిస్తున్న ప్రతి మనిషి కవి అయితే",
        "దేవుని ప్రేమను గూర్చి వ్రాస్తు ఊండే వాడైతే",
        "కొన్నాళ్లకే నీళ్లు యెండి పోవును",
        "ఆకాశం నిండి పోవును",
        "ప్రతి కొమ్మ అరిగి పోవును",
        "ప్రతి మనిషి కృషించి పోవును"
      ],
      "english": []
    }
  ]
