{
  "song_name": "Prakaasha vasthramutho paraloka mahimatho lokambuna kethenchunu meghambupai Prabhuve",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రకాశ వస్త్రముతో పరలోక మహిమతో",
      "లోకంబున కేతెంచును మేఘంబుపై ప్రభువే"
    ],
    "english": [
      "Prakaasha vasthramutho paraloka mahimatho",
      "Lokambuna kethenchunu meghambupai Prabhuve"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంత్య సూచనలు చూడుము - ప్రభు రాకకు మునుపు",
        "క్రీస్తు నిశ్చయముగా వచ్చును - బూర శబ్దముతో",
        "విస్తరించు లోకమందు - యుద్ధము కరవులు",
        "విస్తరించు పాపములు దుహ్ఖము కలవరము"
      ],
      "english": [
        "Anthya soochanalu choodumu - Prabhu raakaku munupu",
        "Kreesthu nishchayamugaa vachchunu - Boora shabdhamutho",
        "Vistharinchu lokamandu - Yuddhamu karavulu",
        "Vistharinchu paapamulu dukhamu kalavaramu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపముచే జన్మించిరి - తల్లి గర్భమునుండి",
        "కోపము దుష్టమోసము - ఎల్లరి హృదయములు",
        "పాప దృష్టి జారచోర - దేవదూషణ హత్యలు",
        "వేపుగా దుష్టగర్వముల్ - హృదయ రోగములు"
      ],
      "english": [
        "Paapamuche janminchiri - Thalli garbhamunundi",
        "Kopamu dhushtamosamu - Ellari hrudhayamulu",
        "Paapa drushti jaarachora - Dhevadhooshana hathyalu",
        "Vepugaa dhushtagarvamul - Hrudaya rogamulu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వెళ్ళరు పరలోకమునకు - ఎవ్వరు పాపముతో",
        "చాలవు నీతి క్రియలు - ప్రార్థనలు రక్షింపవు",
        "చాలును యేసు రక్షింప - ప్రాణమర్పించెను",
        "కలుషములు కడుగును - తన రక్తము చిందించె"
      ],
      "english": [
        "Vellaru paralokamunaku - Evvaru paapamutho",
        "Chaalavu neethi kriyalu - Praarthanalu rakshimpavu",
        "Chaalunu Yesu rakshimpa - Praanamarpinchenu",
        "Kalushamulu kadugunu - Thana rakthamu chindinche"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్షణములోనే గతించును - జీవిత మేపాటిది",
        "తన యాస్తి విడచి నరుడు - నరకము పాలగున్",
        "నిన్ను రక్షింప నీ ప్రభు - సిద్ధముగ నిలిచె",
        "పెన్నుగ పొందుము రక్షణ - నమ్మి యేసు ప్రభువులో"
      ],
      "english": [
        "Kshanamulone gathinchunu - Jeevitha mepaatidhi",
        "Thana yaasthi vidachi narudu - Narakamu paalagun",
        "Ninnu rakshimpa nee Prabhu - Siddhamuga niliche",
        "Pennuga pondumu rakshana - Nammi Yesu Prabhuvulo"
      ]
    }
  ]
}
