        "Sammathin Raagaa SMDhiMthumu Vaega",
        "Aa ... AanMdhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బూరశబ్దించగానే - వాంచలు తీరుటకు",
