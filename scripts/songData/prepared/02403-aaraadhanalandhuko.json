        "Aadyantha Rahithudavu Neevenani",
        "Ghanatha Mahima Neekeyani Halleluya Gaanamu Chesedamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపంబున జీవించి నశియించితిని",
        "లోకంబు నాదంటు ఆశించితిని",
