{
  "song_name": "Jalari Panduga",
  "author": {
    "Authored by": "Dr. R. Santhi Jyothi Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రాజువైన యేసయ్య – మమ్ము యేలేటి మా రాజా",
      "మా చీకటి బ్రతుకుల్లో – వెలుగు నింపావు",
      "మేము కోరేటి రేవునకు – చక్కంగ నడిపావు"
    ],
    "english": [
      "Rajuvaina Yesayya – Mammu yeleti maa raaja",
      "Maa cheekati brathukullo – Velugu nimpavu",
      "Memu koreti revunaku – Chakkanga nadipaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అను పల్లవి:",
        "కన్న వాటిని మరి విన్నవాటిని",
        "చెప్పలేకుండా మారి మేము ఉండలేమయా",
        "ఉన్నా వాడవు నీవే మాకు",
        "అన్ని వేళల అండవు నీవేనయ్య"
      ],
      "english": [
        "Anu Pallavi:",
        "Kanna vaatini mari vinna vaatini",
        "Cheppalekunda mari memu undalemaya",
        "Unnavaadavu neeve maaku",
        "Anni velala andavu neevenayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చేపలు పట్టే జాలరివి – చదువే రాని పామరుని",
        "మనిషిని పట్టే జాలరిగ – చక్కంగ మలిచావు",
        "నీ మార్గములోనికి నడిపేటి మాటలు నా నోట ఉంచావు",
        "మహిమల రాజ్యము దారి చూపే మనసును నిమ్మలపరచావు"
      ],
      "english": [
        "Chepalu patte jalarivi – Chaduve raani paamaruni",
        "Manishini patte jalariga – Chakkanga malichavu",
        "Nee maargamuloniki nadipeti maatalu naa nota unchaavu",
        "Mahimala raajyamu daari chupe manasunu nimmalaparachaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అను పల్లవి:",
        "కన్న వాటిని మరి విన్నవాటిని",
        "చెప్పలేకుండా మారి మేము ఉండలేమయా",
        "ఉన్నా వాడవు నీవే మాకు",
        "అన్ని వేళల అండవు నీవేనయ్య"
      ],
      "english": [
        "Chepa leka chintha padithini – Raathirantha valavesithini",
        "Lothuga valalu veyamani – Challanga palikaavu",
        "Naa valalu pagilipoyeti – Goppa vetanichavu",
        "Brathiketi daari naaku chupi – Chinthanantha teesavu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "చేప లేక చింత పడితిని – రాతిరంతా వలవేసితిని",
        "లోతుగా వలలు వేయమని – చల్లంగ పలికావు",
        "నా వలలు పగిలిపోయేటి – గొప్ప వేటనిచ్చావు",
        "బ్రతికేటి దారి నాకు చూపి – చింతనంత తీసావు"
      ],
      "english": [
        "Addariki pova chuchithini – Donenu nenu ekkithini",
        "Trovalo thufanu thakidiki – Thalladilli pothini",
        "Bhoothamani bhayapadithini – Nene bhayapadakantivi",
        "Devakumara neeve ani ninduga ninne mrokkithini"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అను పల్లవి:",
        "కన్న వాటిని మరి విన్నవాటిని",
        "చెప్పలేకుండా మారి మేము ఉండలేమాయ",
        "ఉన్నా వాడవు నీవే మాకు",
        "అన్ని వేళల అండవు నీవేనయ్య"
      ],
      "english": [
        "O O O – O O O",
        "O O O – O O O"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అద్దరికి పోవ చూచితిని – దోనెను నేను ఎక్కితిని",
        "త్రోవలో తుఫాను తాకిడికి – తల్లడిల్లి పోతిని",
        "బూతమని భయపడితిని – నేనే భయపడకంటివి",
        "దేవకుమార నీవే అని నిండుగా నిన్నే మ్రొక్కితిని"
