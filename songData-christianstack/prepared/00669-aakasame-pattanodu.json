{
  "song_name": "Aakasame Pattanodu",
  "author": {
    "Authored by": "K R John",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అవనిలో ఉద్భవించే ఆదిసంభూతిని చూడరే",
      "పుడమియే పరవసించే పసిబాలుని చూడగనే",
      "పసిబాలుని చూడగనే"
    ],
    "english": [
      "Avanilo udbhavinche aadhisambhuthuni chudarey",
      "pudamiye paravasinche pasibaaluni chudaganey",
      "pasibaaluni chudaganey"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశమే పట్టనోడు ధరణిలో పుట్టినాడు",
        "దావీదు పురమునందు దీనుడై వెలసినాడు రక్షకుడు"
      ],
      "english": [
        "Aakasamey pattanodu dharanilo puttinaadu",
        "dhaaveedu puramunandhu dheenudai velasinaadu rakshakudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆనందమే మహా ఆనందమే",
        "అందరికి ఇలలో సంతోషమే",
        "ఆశ్చర్యమే ఇది అద్భుతమే",
        "యేసు జననం అద్భుతమే"
      ],
      "english": [
        "Aanandhame mahaa aanandamey",
        "andhariki ilalo santhoshamey",
        "aascharyamey idhi adbhuthamey",
        "yesu jananam adbhuthamey"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అదృశ్య దేవుని మహిమ స్వరూపుడు",
        "ఆది అంతమైన పరలోక నాధుడు",
        "ఆదియందు వాక్యంబుగా సృష్టి కార్యము జరిగించినాడు",
        "ఆనాది నుండి జ్ణానంబుగా సృష్టి క్రమము నడిపించినాడు",
        "అన్నిటిని కలిగించిన మహరాజు కన్నీటిని తుడచుటకు దిగివచ్చినాడు"
      ],
      "english": [
        "Adhrushya devuni mahimaa swaroopudu",
        "aadhi anthamaina paraloka naadhudu",
        "aadhiyandu vaakyambugaa srushtikaaryamu jariginchinaadu",
        "anaadi nundi gnaanambugaa srushtikramamu nadipinchinaadu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రేమను పంచే ప్రేమామయుడు",
        "రక్షణ ఇచ్చే రక్షించే దేవుడు"
      ],
      "english": [
        "Premanu panchey premaamayudu",
        "rakshana ichi rakshinchey devudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపమే లేని సుగుణాల సుందరుడు",
        "శాపము బాపను జన్మించెను చూడు",
        "నిత్యముండు నీతి సూర్యుడు సత్యసాక్షిగా ఇలకొచ్చినాడు",
        "ప్రేమను పంచే పావనాత్ముడు పశుల పాకలో పవళించినాడు",
        "సర్వాధికారియైన మహారాజు దీనులకు దీవెనగా దిగివచ్చినాడు"
      ],
      "english": [
        "Paapamey leni sugunaala sundarudu",
        "shaapamu baapanu janminchenu chudu",
        "nithyamundu neethi suryudu sathyasaakshiga ilakochinaadu",
        "premanu panchey paavanaathmudu pasulapaakaloo pavalinchinaadu",
        "sarvaadhikaariyaina mahaaraaju dheenulaku dheevenaga dhigivachinaadu"
      ]
    }
  ]
}
