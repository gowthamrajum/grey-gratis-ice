{
  "song_name": "Krutagnatato Samarpanato",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కృతజ్ఞతతో సమర్పణతో ఆయన సన్నిది చేరెదము",
      "ప్రధమ ఫలము ప్రతిష్టర్పన పదియవ బాగము ఆయనదే",
      "మనసార సమర్పించెదము వెనుకాడకు ఇచ్చుటలో ఆ.ఆ"
    ],
    "english": [
      "Kruthagnathatho Samarpanatho Aayana Sannidi Cheredamu",
      "Pradhama Phalamu Prathishtarpana Padiyava Baagamu Aayanade",
      "Manasaara Samarpinchedamu Venukaadaku Ichchutalo Aa.Aa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆయన ఆలయము దీవెనలకు నిలయం",
        "ఆకాశ వాకిళ్ళు తెరువగను పట్టజాలని దీవెన నీకుండును ఆ.ఆ"
      ],
      "english": [
        "Aayana Aalayamu Deevenalaku Nilayam",
        "Aakaasha Vaakillu Theruvaganu Pattajaalani Deevena Neekundunu Aa.Aa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కలిగినదంతయు అపోస్తులుల చెంత వదిలిరి శిష్యులు",
        "దేవునికి సిరిసంపదలన్ని ఆ.ఆ"
      ],
      "english": [
        "Kaliginadanthayu Aposthulula Chentha Vadiliri Shishyulu",
        "Devuniki Sirisampadalanni Aa.Aa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరలోక నిదిని సంపాదించితివా పరముకు చేరే గవిని",
        "ఇది సమర్పణ చేయుము కానుకలు ఆ.ఆ"
      ],
      "english": [
        "Paraloka Nidini Sampaadinchithivaa Paramuku Chere Gavini",
        "Idi Samarpana Cheyumu Kaanukalu Aa.Aa"
      ]
    }
  ]
}
