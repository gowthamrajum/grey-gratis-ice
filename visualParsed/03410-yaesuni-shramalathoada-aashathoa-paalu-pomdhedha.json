  },
  "main_stanza": {
    "telugu": [
      "యేసుని శ్రమలతోడ - ఆశతో పాలు పొందెదను",
      "ఇతని ఓదార్పు నిజము - ఇతర ఓదార్పు వృథయే"
    ],
    "english": [
      "Yesuni shramalathoda - Aashatho paalu pondedanu",
      "Ithani odaarpu nijamu - Ithara odaarpu vruthaye"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిందలెల్ల ఏకముగా - మహామహునిమీద బడగా",
        "వింతగానే యోర్చుకొనెను - తండ్రి మాట నేరవేర్చెన్"
      ],
      "english": [
        "Nindhalella ekamugaa - Mahaamahunimeedha badagaa",
        "Vinthagaane yorchukonenu - Thandri maata neraverchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దుఃఖముతో నిండియుండెన్ - ప్రక్కలోన గ్రుచ్చబడెను",
        "రక్తితోడయోర్చుకొని వి - రక్తి మాట పల్కకుండెన్"
      ],
      "english": [
        "Duhkhamutho nindiyunden - Prakkalona gruchchabadenu",
        "Rakthithodayorchukoni vi - Rakthi maata palkakunden"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శోకంబు చెత నేను - నాకంబు కదిలింతును",
        "రక్తంబుధార పోసెన్ - రిక్తులమైన మనకు"
      ],
      "english": [
        "Shokambu chetha nenu - Naakambu kadhilinthunu",
        "Rakthambudhaara posen - Rikthulamaina manaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సదయుని రక్తముచే - హృదయాలంకారముచే",
        "కలుగు నాహారమిదే - ఎల్లరకు శ్రేష్టాహారం"
      ],
      "english": [
        "Sadhayuni rakthamuche - Hrudhayaalankaaramuche",
        "Kalugu naahaaramidhe - Ellaraku shreshtaahaaram"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తల్లి ప్రేమకన్న మిగుల - తన ప్రేమ చూపె మనకై",
        "నోటి మాటతోడ శత్రున్ - కోటల నశింపజేసెన్"
      ],
      "english": [
        "Thalli premakanna migula - Thana prema choope manakai",
        "Noti maatathoda shathrun - Kotala nashimpajesen"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నా యేసు రక్తచెమట - నాయప్పు యంతయున్ తీర్చెన్",
        "ఎల్లరికి నగీకారమిదే - ఎల్లప్పుడు నా ధ్యానమున్"
      ],
      "english": [
        "Naa Yesu rakthachemata - Naayappu yanthayun theerchen",
        "Ellariki nageekaaramidhe - Ellappudu naa dhyaanamun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయా గీతమును - ఎల్లపుడు చాటుచుందున్",
        "ఎల్లరియందు తానే - ఎల్లప్పుడు వసించున్"
      ],
      "english": [
        "Hallelooyaa geethamunu - Ellapudu chaatuchundhun",
        "Ellariyandhu thaane - Ellappudu vasinchun"
      ]
    }
  ]
