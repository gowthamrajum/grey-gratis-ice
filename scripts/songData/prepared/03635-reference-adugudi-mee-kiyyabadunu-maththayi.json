{
  "song_name": "Adugudi Meeru Mana Prabhuvichchun",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అడుగుడి మీరు మన ప్రభువిచ్చున్ - తప్పక యిచ్చున్",
      "అడిగెడి ప్రతివాడు పొందున్"
    ],
    "english": [
      "Adugudi Meeru Mana Prabhuvichchun - Thappaka Yichchun",
      "Adigedi Prathivaadu PoMdhun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భక్తులుభక్తులు విశ్వాసముతో - ప్రార్థించి పొందిరి",
        "వారి జీవితముల నెంచి చూచి",
        "మీ మేలు కొరకై ప్రార్థించి పొందు"
      ],
      "english": [
        "Bhakthulubhakthulu Vishvaasamuthoa - PraarThiMchi PoMdhiri",
        "Vaari Jeevithamula NeMchi Choochi",
        "Mee Maelu Korakai PraarThiMchi PoMdhu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మనలో తన శక్తికొలది - అనుగ్రహించును",
        "ఊహకుమించి చేయు దేవునిని",
        "మీ మేలు కొరకై ప్రార్థించి పొందు"
      ],
      "english": [
        "Manaloa Thana Shakthikoladhi - AnugrahiMchunu",
        "OohakumiMchi Chaeyu Dhaevunini",
        "Mee Maelu Korakai PraarThiMchi PoMdhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన ప్రార్థనల నాలకించి - సంతృప్తి చెందును",
        "తన నామమునకు మహిమ కలుగ",
        "మీ మేలు కొరకై ప్రార్థించి పొందు"
      ],
      "english": [
        "Mana PraarThanala NaalakiMchi - SMthrupthi CheMdhunu",
        "Thana Naamamunaku Mahima Kaluga",
        "Mee Maelu Korakai PraarThiMchi PoMdhu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇదివరకు మీరేమియు - అడుగకుంటిరి",
        "మీరానంద భరితులగునట్లు",
        "మీ మేలు కొరకై ప్రార్థించి పొందు"
      ],
      "english": [
        "Idhivaraku Meeraemiyu - AdugakuMtiri",
        "MeeraanMdha Bharithulagunatlu",
        "Mee Maelu Korakai PraarThiMchi PoMdhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "దేవుని కేదైనను - చేయ నసాధ్యమా",
        "సర్వశక్తిగల మన దేవునడిగి",
        "ప్రభు మహిమ కొరకై ప్రార్థించి పొందు"
      ],
      "english": [
        "Dhaevuni Kaedhainanu - Chaeya NasaaDhyamaa",
        "Sarvashakthigala Mana Dhaevunadigi",
        "Prabhu Mahima Korakai PraarThiMchi PoMdhu"
      ]
    }
  ]
}
