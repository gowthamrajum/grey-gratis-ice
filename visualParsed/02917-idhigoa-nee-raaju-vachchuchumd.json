  "main_stanza": {
    "telugu": [
      "ఇదిగో నీ రాజు వచ్చుచుండె సీయోను కుమారి",
      "సంతోషించు యెరుషలేం కుమారి ఉల్లసించు ||ఇదిగో||"
    ],
    "english": [
      "Idigo nee raaju vachchuchunde Seeyonu kumaari",
      "Santhoshinchu Erushalem kumaari ullasinchu ||Idigo||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీదురాజు నీతితో దోషమేమియు లేకయే",
