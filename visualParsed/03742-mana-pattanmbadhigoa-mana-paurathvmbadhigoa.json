  "main_stanza": {
    "telugu": [
      "మన పట్టణంబదిగో - మన పౌరత్వంబదిగో",
      "కానాను పురమదిగో - మన యేసుకు జేయునమో"
    ],
    "english": [
      "Mana pattanambadhigo - Mana paurathvambadhigo",
      "Kaanaanu puramadhigo - Mana Yesuku jeyunamo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆర్భాటంబులతో - విజయోత్సవంబులతో",
        "ఏతెంచిన ప్రభు జేరి - పాత భక్తుల జేరి",
