{
  "song_name": "Parimala Sumamulu",
  "author": {
    "Authored by": "Rev. Acharya Dr. A B Masilamani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పరిమళ సుమములు పూసెను",
      "ప్రభుదయ ధర విరబూసెను"
    ],
    "english": [
      "Parimala sumamulu poosenu",
      "prabhu daya dhara viraboosenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అరుణోదయముగ మారెను రాత్రి",
        "కరుణావరములు కురిసెను ధాత్రి",
        "పరమ రహాస్యము ప్రేమతో",
        "ప్రసరించెను ప్రభు జన్మతో || పరిమళ ||",
        "దరిసెనమాయెను వరదుని నీతి",
        "విరమణమాయెను నరకపు భీతి",
        "విరిసె క్షమాపణ హాయిగా",
        "మరియ కిశోరుని జన్మగా || పరిమళ ||",
        "మెరిసెను మనమున వరుని సుహాసం",
        "పరిచయమాయెను పరమ నివాసం",
        "మురిసెను హృదయము కొల్లగా",
        "అరుదెంచగ ప్రభు చల్లగా || పరిమళ ||"
      ],
      "english": [
        "Arunodayamuga maarenu raathri",
        "karunaavaramulu kurisenu dhaatri",
        "parama rahasyamu prematho",
        "prasarinchenu prabhu janmatho || Parimala ||",
        "Darisenamaayenu varadhuni neethi",
        "viramanamaayenu narakapu bheethi",
        "virise kshamaapana haayiga",
        "mariya kishoruni janmaga || Parimala ||",
        "Merisenu manamuna varuni suhaasam",
        "parichayamaayenu parama nivaasam",
        "murisenu hrudhayam kollaga",
        "arudenchaga prabhu challaga || Parimala ||"
      ]
    }
  ]
}
