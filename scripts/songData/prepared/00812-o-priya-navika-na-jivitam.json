      ],
      "english": [
        "Penu Gali Vichaga Sudigali Chuttaga",
        "Nive Nato Numdaga (2)",
        "Nakimka Bayamela Na Deva",
        "O Priya Na Priya Na Yesuva . ."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నెమ్మది లేక నా మది ఉండగ",
        "నీ ఆత్మతో నన్ను లేపితివి (2)",
        "నీకేమి నేను అర్పించెదన్",
        "ఓ ప్రియ నా ప్రియ నా యేసువా . ."
      ],
      "english": [
        "Nemmadi Leka Na Madi Umdaga",
        "Ni Atmato Nannu Lepitivi (2)",
        "Nikemi Nenu Arpimchedan",
        "O Priya Na Priya Na Yesuva . ."
      ]
    }
  ]
