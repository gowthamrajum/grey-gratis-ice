{
  "song_name": "Karuna Rasa Bharita",
  "author": {
    "Authored by": "Rev. Acharya Dr. A B Masilamani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కరుణా రసభరిత యెహోవ",
      "ఏతావ తార ప్రభో",
      "శరణార్థులకిల ఆశ్రయ గృహమౌ",
      "క్రైస్తవ సమాక్య జీవప్రధాత"
    ],
    "english": [
      "karuna rasabharitha Yehova",
      "ethaava thaara prabho",
      "saranaarthulakila aasraya gruhamau",
      "kraistava samaakya jeevapradhaatha"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దివ్య వదువు భువిపై జన్మింపను",
        "శిలువలో కార్చిన రుదిరములో",
        "భవ్యముగా నీ ప్రాణము నొసగిన",
        "నవ యుగ వరుడవు నీవెగదా || కరుణా ||",
        "భూమి పునాదులు వేయకమునుపే",
        "ప్రేమలో మమ్మును భరియించి",
        "సుమంగలికి నీ వాక్యము తాళిగ",
        "సదయుగ నొసగిన నీవెగదా || కరుణా ||",
        "కల్వరిలో జన్మించిన సంఘము",
        "చెల్వముగ నీ లోగిలిలో",
        "ఫలభరితంబగు వల్లిగ మెలగను",
        "విలువలు గూర్చిన నీవెగదా || కరుణా ||"
      ],
      "english": [
        "divya vadhuvu bhuvipai janmimpanu",
        "siluvalo kaarchina rudhiramulo",
        "bhavyamuga ni praanamu nosagina",
        "nava yuga varudavu neevegada || karuna ||",
        "bhoomi punaadhulu veyakamunupe",
        "premalo mammunu bhariyinchi",
        "sumangaliki nee vaakyamu thaaliga",
        "sadayuga nosagina neevegada || karuna ||",
        "kalvarilo janminchina sanghamu",
        "chelvamuga nee logililo",
        "phalabharitambagu valliga melaganu",
        "viluvalu goorchina neevegada || karuna ||"
      ]
    }
  ]
}
