{
  "song_name": "Idhigoa Nee Raaju Vachchuchumde",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇదిగో నీ రాజు వచ్చుచుండె సీయోను కుమారి సంతోషించు",
      "యెరుషలేం కుమారి ఉల్లసించు"
    ],
    "english": [
      "Idhigoa Nee Raaju Vachchuchumde Seeyoanu Kumaari Samthoashimchu",
      "Yerushalaem Kumaari Ullasimchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీదురాజు నీతితో దోషమేమియు లేకయే",
        "పాపరహితుడు ప్రభు వచ్చు చుండె"
      ],
      "english": [
        "Needhuraaju Neethithoa Dhoashamaemiyu Laekayae",
        "Paaparahithudu Prabhu Vachchu Chumde"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రక్షణగలవాడుగ అక్షయుండగు యేసుడు",
        "ఇచ్చతోడ యెరుషలేం వచ్చు చుండె"
      ],
      "english": [
        "Rakshanagalavaaduga Akshayumdagu Yaesudu",
        "Ichchathoada Yerushalaem Vachchu Chumde"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "స్వాతికుండు యీభువిన్ అత్యంతమగు ప్రేమతో",
        "నిత్యరాజు నరులకై వచ్చుచుండె"
      ],
      "english": [
        "Svaathikumdu Yeebhuvin Athyamthamagu Praemathoa",
        "Nithyaraaju Narulakai Vachchuchumde"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దీనవరుడు నీ ప్రభు ఘనత కలిగిన దేవుడు",
        "ప్రాణమీయ పాపులకై వచ్చుచుండె"
      ],
      "english": [
        "Dheenavarudu Nee Prabhu Ghanatha Kaligina Dhaevudu",
        "Praanameeya Paapulakai Vachchuchumde"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇలను గాడిదనెక్కియే బాలుర స్తోత్రములతో",
        "బలుడగు నీ ప్రభు వచ్చుచుండె"
      ],
      "english": [
        "Ilanu Gaadidhanekkiyae Baalura Sthoathramulathoa",
        "Baludagu Nee Prabhu Vachchuchumde"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దావీదు కుమారుడు దేవుడు పాపులకు",
        "జయగీతములతో వచ్చుచుండె"
      ],
      "english": [
        "Dhaaveedhu Kumaarudu Dhaevudu Paapulaku",
        "Jayageethamulathoa Vachchuchumde"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసుని ప్రేమించుచు హోసన్న పాడెదము",
        "యేసుడిల వచ్చుచుండె హల్లెలూయ వచ్చుచుండె"
      ],
      "english": [
        "Yaesuni Praemimchuchu Hoasanna Paadedhamu",
        "Yaesudila Vachchuchumde Hallelooya Vachchuchumde"
      ]
    }
  ]
}
