  },
  "main_stanza": {
    "telugu": [
      "అల్ఫాయు ఓమేగ (2) నీవే ప్రభువా (2)"
    ],
    "english": [
      "Alphaayu Omega (2) neeve Prabhuva (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇహపరములలో నీ జన్మ - మహానందము కలిగించె (2)",
        "అభయము నిచ్చి మాకు - భయభీతిని బాపితివి (2)",
        "భయభీతిని బాపితివి"
      ],
      "english": [
        "Ihaparamulalo nee janma - Mahaanandhamu kaliginche (2)",
        "Abhayamu nichchi maaku - Bhayabheethini baapithivi (2)",
        "Bhayabheethini baapithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ జీవిత వాక్కులన్ని - సజీవము జనులందరికి",
        "పావనుడా మా ప్రభు యేసు - అవనికి మాదిరి నీవే"
      ],
      "english": [
        "Nee jeevitha vaakkulanni - Sajeevamu janulandariki",
        "Paavanudaa maa Prabhu Yesu - Avaniki maadiri neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మరణము గెల్చిన మా ప్రభువా - పరమ దేవుడవు నీవే",
        "సాతానున్ ఓడించి - నీతిగా మము తీర్చితివి"
      ],
      "english": [
        "Maranamu gelchina maa Prabhuva - Parama Devudavu neeve",
        "Saathaanun odinchi - Neethigaa mamu theerchithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపశాపముల బాపితివే - చూపితివే పరమదారి",
        "శక్తిగల ఓ ప్రభువా - నీకే మా స్తోత్రములు"
      ],
      "english": [
        "Paapashaapamula baapithive - Choopithive paramadhaari",
        "Shakthigala O Prabhuva - Neeke maa sthothramulu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "విశ్వమంతట ఓ దేవా - శాశ్వతమైనది నీ ప్రేమ",
        "జ్ఞానమునకు మించినది - ఉన్నతమైన ప్రేమ"
      ],
      "english": [
        "Vishwamantata O Deva - Shaashwathamainadi nee prema",
        "Gnaanamunaku minchinadhi - Unnathamaina prema"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సంఘమునకు శిరస్సు నీవే - అంగములుగ మము జేసితివి",
        "సర్వ సంపూర్ణుండా - సర్వ మహిమ నీకే"
      ],
      "english": [
        "Sanghamunaku shirassu neeve - Angamuluga mamu jesithivi",
        "Sarva sampoornundaa - Sarva mahima neeke"
      ]
    }
  ]
}
