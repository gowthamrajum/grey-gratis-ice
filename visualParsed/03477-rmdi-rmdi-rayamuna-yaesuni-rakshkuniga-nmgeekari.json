{
  "song_name": "Randi randi rayamuna Yesuni - Rakshakuniga nangeekarinchudi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రండి రండి రయమున యేసుని - రక్షకునిగ నంగీకరించుడి",
      "ప్రీతితో - ప్రభుని చేరుడి ప్రభుల ప్రభువే",
      "రాజుల రాజువే - రాబోవునాతడే"
    ],
    "english": [
      "Randi randi rayamuna Yesuni - Rakshakuniga nangeekarinchudi",
      "Preethitho - Prabhuni cherudi prabhula prabhuve",
      "Raajula raajuve - Raabovunaathade"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రయాసపడి భారము మోయువారల - అతి ప్రేమతో నాహ్వానించెను",
        "భారమంత పార ద్రోలును, విశ్రాంతినిచ్చును",
        "వేగమే రారమ్ము ఈ మాట నిక్కము"
      ],
      "english": [
        "Prayaasapadi bhaaramu moyuvaarala - Athi prematho naahwaaninchenu",
        "Bhaaramantha paara drolunu, vishraanthinichchunu",
        "Vegame raarammu ee maata nikkamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపపు జీతము నిత్యనరకము, ఓ పాపి నీకిక దిక్కెవరు",
        "నిత్యజీవ మియ్యవచ్చెను, నీ కొరకువచ్చెను",
        "తన ప్రాణమిచ్చెను, నిన్నురక్షింపను"
      ],
      "english": [
        "Paapapu jeethamu nithyanarakamu, o paapi neekika dikkevaru",
        "Nithyajeeva miyyavachchenu, nee korakuvachchenu",
        "Thana praanamichchenu, ninnurakshimpanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మాయలోకం మోసముజేసెను - మరణసమయము సమీపించెను",
        "తన్నుచేరువారి నెవ్వరిన్, తృణీకరించడు",
        "నిను త్రోసివేయడు ఈ మాట నమ్ముము"
      ],
      "english": [
        "Maayalokam mosamujesenu - Maranasamayamu sameepinchenu",
        "Thannucheruvaari nevvarin, thruneekarinchadu",
        "Ninu throsiveyadu ee maata nammumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తుయేసు నిను ప్రేమించి నీ కొరకై తానే వచ్చెన్",
        "నీదు దోషమంతటికై, రక్తము కార్చెను",
        "శిక్షను పొందెను, శ్రీ యేసున్ చేరుము"
      ],
      "english": [
        "Kreesthuyesu ninu preminchi nee korakai thaane vachchen",
        "Needu dhoshamanthatikai, rakthamu kaarchenu",
        "Shikshanu pondenu, Sree Yesun cherumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపులారా పరుగిడిరండి పాపుల మిత్రుడేసుని చేరుడి",
        "శక్తితో నిన్ను రక్షించును సంతోషమిచ్చును",
        "సందేహపడకు, సువార్తన్ నమ్ముము"
      ],
      "english": [
        "Paapulaaraa parugidirandi paapula mithrudhesuni cherudi",
        "Shakthitho ninnu rakshinchunu santhoshamichchunu",
        "Sandhehapadaku, suvaarthan nammumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీదు పాపము నంతటిని నీవు నిక్కముగ నొప్పుకొనిన",
        "ఆయనే తనరక్తముతో, కడుగు ప్రేమతో",
        "కాపాడు నేర్పుతో, కరుణ శక్తితో"
      ],
      "english": [
        "Needu paapamu nanthatini neevu nikkamuga noppukonina",
        "Aayane thanarakthamutho, kadugu prematho",
        "Kaapaadu nerputho, karuna shakthitho"
      ]
    }
  ]
}
