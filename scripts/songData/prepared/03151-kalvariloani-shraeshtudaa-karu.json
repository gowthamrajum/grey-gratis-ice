{
  "song_name": "Kalvariloani ShraeShtudaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కల్వరిలోని శ్రేష్టుడా కరుణభరిత సింహమా",
      "కన్ను భ్రమించు ప్రభువా సిలువలోని మిత్రుడా"
    ],
    "english": [
      "Kalvariloani ShraeShtudaa KaruNabharitha SiMhamaa",
      "Kannu BhramiMchu Prabhuvaa Siluvaloani Mithrudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతికి పాత్రుండగువాడా దూతలతో వేంచేయువాడా",
        "సుదతి మరియ పుత్రుడా సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Sthuthiki PaathruMdaguvaadaa Dhoothalathoa VaeMchaeyuvaadaa",
        "Sudhathi Mariya Puthrudaa Siluvaloani Mithrudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపులకై వచ్చినవాడా ప్రేమగల్గిన రక్షకుడా",
        "పాదములపై బడితిమి సిలువలోనిమిత్రుడా"
      ],
      "english": [
        "Paapulakai Vachchinavaadaa Praemagalgina RakShkudaa",
        "Paadhamulapai Badithimi Siluvaloanimithrudaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దీవెనలు నిచ్చువాడా వసుధ కేతెంచినవాడా",
        "నీవే సుంకరలాప్తుడవు సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Dheevenalu Nichchuvaadaa VasuDha KaetheMchinavaadaa",
        "Neevae SuMkaralaapthudavu Siluvaloani Mithrudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఐదు రొట్టెలు మరి రెండు చేపలతో",
        "నైదువేల జనుల పోషించిన తండ్రి సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Aidhu Rottelu Mari ReMdu Chaepalathoa",
        "Naidhuvaela Janula PoaShiMchina ThMdri Siluvaloani Mithrudaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీళ్ళను రసముగ మార్చితివి నీళ్ళమీద నడచితివి",
        "మేళ్ళనొసగు మాదాతా సిలువలోని మిత్రుడా"
      ],
      "english": [
        "NeeLLanu Rasamuga Maarchithivi NeeLLameedha Nadachithivi",
        "MaeLLanosagu Maadhaathaa Siluvaloani Mithrudaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "రోగులను బాగుచేయువాడా గ్రుడ్డికి నేత్రములిచ్చితివి",
        "అనాధుల నాయకుడా సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Roagulanu Baaguchaeyuvaadaa Gruddiki Naethramulichchithivi",
        "AnaaDhula Naayakudaa Siluvaloani Mithrudaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ కర్హుడా యెల్లరు కొనియాడువాడా",
        "బలముతో వచ్చు రాజా సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Hallelooya Karhudaa Yellaru Koniyaaduvaadaa",
        "Balamuthoa Vachchu Raajaa Siluvaloani Mithrudaa"
      ]
