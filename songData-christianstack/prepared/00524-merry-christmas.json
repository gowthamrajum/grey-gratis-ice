  "main_stanza": {
    "telugu": [
      "ఎదురుచూసిన కాలం – ప్రత్యక్ష పరిచెను దైవం",
      "ప్రవక్తల ప్రవచన సారం – నెరవేరిన వైనం"
    ],
    "english": [
      "Yeduru choosing koala – pratyaksha parichenu divam",
      "pravaktala pravachana saran – neraverina vainam"
    ]
  },
