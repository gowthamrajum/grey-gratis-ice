{
  "song_name": "Karunaathmude kadhilochchaade",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కరుణాత్ముడే కదిలొచ్చాడే",
      "అరుణోదయుడై అరుదెంచాడే 2సార్లు",
      "ఆశీర్వాదాలు మొదలాయెనే",
      "చీకటి బ్రతుకులకు వెలుగాయెనే. 2సార్లు",
      "పుడమే పులకింపగా - జగమే తరియింపగా",
      "నేను పాడెదా - కొనియాడేదా",
      "నేను ఆడేదా - చిందాడేదా 2సార్లు"
    ],
    "english": [
      "Karunaathmude kadhilochchaade",
      "Arunodhayudai arudhenchaade 2saarlu",
      "Aasheervaadhaalu modhalaayene",
      "Cheekati brathukulaku velugaayene. 2saarlu",
      "Pudame pulakimpagaa - Jagame thariyimpagaa",
      "Nenu paadedaa - Koniyaadedaa",
      "Nenu aadedhaa - Chindhaadedhaa 2saarlu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోక రక్షకుడే పరమును విడిచి వచ్చాడే",
        "ఓ చిన్ని పాకలో పావనుడై పవలించాడే. 2సార్లు",
        "ఆశ్చర్యమే, తన మహిమను విడిచి వచ్ఛాడే",
        "ఇంకా కంఫర్మే నిత్య రాజ్యపు వారసులవ్వటమే",
        "బంగారు సాంబ్రాణితో నా స్తుతి గానాలతో  ||కరుణాత్ముడే||"
      ],
      "english": [
        "Loka rakshakude paramunu vidichi vachchaade",
        "O chinni paakalo paavanudai pavalinchaade. 2saarlu",
        "Aashcharyame, thana mahimanu vidichi vachchaade",
        "Inkaa kampharme nithya raajyapu vaarasulavvatame",
        "Bangaaru saambraanitho naa sthuthi gaanaalatho  ||Karunaathmude||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కారణమే ఉంది కారణజన్ముని రాకకు",
        "భూనివాసులందరిని పరమునకు చేర్చుటకు 2సార్లు",
        "ఇంకా సంబరమే, ఊరువాడంతా ఏకమై ఆడాలే",
        "ఆర్భాటమే, చేయి చేయి కలిపి సువార్త చాటాలే",
        "లోకమే ద్వేషించినా, బాధకు గురి చేసినా  ||కరుణాత్ముడే||"
      ],
      "english": [
        "Kaaraname undi kaaranajanmuni raakaku",
        "Bhoonivaasulandharini paramunaku cherchutaku 2saarlu",
        "Inkaa sambarame, ooruvaadanthaa ekamai aadaale",
        "Aarbhaatame, cheyi cheyi kalipi suvaartha chaataale",
        "Lokame dhveshinchinaa, baadhaku guri chesinaa  ||Karunaathmude||"
      ]
    }
  ]
}
