      ],
      "english": [
        "Naa pitharulendharo ninnu ghanaparachi",
        "Dhahanabalulu neeku arpinchagaa (2)",
        "Impaina suvaasanagaa angeekarinchi",
        "Deevena varshamu kuripinchithive (2) ||Aaraadhanaa||"
      ]
