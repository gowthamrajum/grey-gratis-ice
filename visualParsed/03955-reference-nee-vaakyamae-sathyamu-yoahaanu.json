{
  "song_name": "Mangalamuga paadudee - Krupa sathyambunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నీ వాక్యమే సత్యము యోహాను జాన్ 17:17"
    ],
    "english": [
      "Nee vaakyame sathyamu Yohaanu John 17:17"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మంగళముగ పాడుడీ - కృప సత్యంబును",
        "రంగుగ జ్ఞానమిచ్చెడు దివ్యవాక్యము",
        "విజయ సత్యవేదము - మంగళ నిత్యదీపము",
        "అమృతము అద్భుతము దివ్యసత్యము"
      ],
      "english": [
        "Mangalamuga paadudee - Krupa sathyambunu",
        "Ranguga gnaanamichchedu dhivyavaakyamu",
        "Vijaya sathyavedhamu - Mangala nithyadheepamu",
        "Amruthamu adbhuthamu dhivyasathyamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సువి శేషమును ప్రకటింపు - కృప సత్యంబును",
        "పాప ఘోరంబు తెల్పును - దివ్యవాక్యము",
        "పరలోక వర్షము - జ్ఞాన నింపుదలయును"
      ],
      "english": [
        "Suvisheshamunu prakatimpu - Krupa sathyambunu",
        "Paapa ghorambu thelpunu - Dhivyavaakyamu",
        "Paraloka varshamu - Gnaana nimpudhalayunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవుడేసు హర్షించెడు - కృపసత్యంబును",
        "జీవ మంగళ వాక్యముల్ - దివ్యవాక్యముల్",
        "యేసు నన్నుచూడు - నిత్యము శుద్ధీకరించు"
      ],
      "english": [
        "Dhevudesu harshinchedu - Krupasathyambunu",
        "Jeeva mangala vaakyamul - Dhivyavaakyamul",
        "Yesu nannuchoodu - Nithyamu shuddheekarinchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రెండుయంచుల ఖడ్గము - కృప సత్యంబును",
        "ఉల్లముల్ కరిగించెడు దివ్యవాక్యము",
        "యోచనల్ చూపుదర్పణము - కలితిలేని జ్ఞానము"
      ],
      "english": [
        "Renduyanchula khadgamu - Krupa sathyambunu",
        "Ullamul kariginchedu dhivyavaakyamu",
        "Yochanal choopudharpanamu - Kalithileni gnaanamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఆత్మకాహారమిదియే - కృప సత్యంబును",
        "పాపికి జీవపానము - దివ్యవాక్యము",
        "పాదములకు దీపము - కాళ్ళకు మంచి వెల్గును"
      ],
      "english": [
        "Aathmakaahaaramidhiye - Krupa sathyambunu",
        "Paapiki jeevapaanamu - Dhivyavaakyamu",
        "Paadamulaku deepamu - Kaallaku manchi velgunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "విశ్వాసుల సువార్తయే - కృప సత్యంబును",
        "నిశ్చయమైన పునాదియే - దివ్యవాక్యము",
        "విడుదలనిచ్చు సత్యము - ఉన్నతలోక సత్యము"
      ],
      "english": [
        "Vishwaasula suvaarthaye - Krupa sathyambunu",
        "Nishchayamaina punaadhiye - Dhivyavaakyamu",
        "Vidudhalanichchu sathyamu - Unnathaloka sathyamu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాడెద - కృప సత్యంబును",
        "అపవిత్రతను పోగొట్టున్ దివ్యవాక్యము",
        "ప్రభువు నామమిదియే - నాదు ఆస్తియునిదే"
      ],
      "english": [
        "Hallelooya paadeda - Krupa sathyambunu",
        "Apavithrathanu pogottun dhivyavaakyamu",
        "Prabhuvu naamamidhiye - Naadu aasthiyunidhe"
      ]
    }
  ]
}
