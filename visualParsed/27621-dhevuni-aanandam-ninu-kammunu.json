{
  "song_name": "Devuni aanandam ninu kammunu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Ps John Jebaraj",
      "Dr Paul Dhinakaran"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవుని ఆనందం నిను కమ్మును",
      "ఉన్నతమైన స్థలములు నిను ఆహ్వానించున్(2)",
      "పరలోక స్వాస్థ్యముతో పోషించును నిన్ను",
      "ఆకాశపు వాకిళ్లు తెరుచును నీకు (2)",
      "నీవు పైకి లేచెదవు పై పైన ఎగిరెదవు",
      "నీవు వేచియున్న దినముల యొక్క ఫలమును పొందెదవు (2)",
      "కోల్పోయినవన్ని రెండింతలుగా మరలా పొందెదవు (2)"
    ],
    "english": [
      "Devuni aanandam ninu kammunu",
      "Unnathamaina sthalamulu ninu aahvaaninchun(2)",
      "Paraloka svaasthyamutho poshinchunu ninnu",
      "Aakaashapu vaakillu theruchunu neeku (2)",
      "Neevu paiki lechedavu pai paina egiredavu",
      "Neevu vechiyunna dinamula yokka phalamunu pondedavu (2)",
      "Kolpoyinavanni rendinthalugaa maralaa pondedavu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బాధించు బంధకములు ఈ దినమే విప్పబడున్",
        "నీ ముందు అడ్డుగా నిలిచే సంకెళ్లు తెగిపడున్ (2)",
        "నీకున్న దర్శనం నెరవేర త్వరపడున్",
        "అనుకూల ద్వారములు నీ కొరకు తెరవబడున్ (2)  ||దేవుని||"
      ],
      "english": [
        "Baadhinchu bandhakamulu ee diname vippabadun",
        "Nee mundu addugaa niliche sankellu thegipadun (2)",
        "Neekunna darshanam neravera thvarapadun",
        "Anukoola dwaaramulu nee koraku theravabadun (2)  ||Devuni||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీతి సూర్యుడు నీ పైన ఉదయించును",
        "యేసుని రెక్కల క్రింద ఆరోగ్యమొందెదవు (2)",
        "నీ కాలి క్రింద దుష్టుడు ధూళిగా మారును నింగిలో మెరుపు వలె శత్రువు కూలును (2)  ||దేవుని||"
      ],
      "english": [
        "Neethi sooryudu nee paina udayinchunu",
        "Yesuni rekkala krinda aarogyamondhedavu (2)",
        "Nee kaali krinda dushtudu dhooligaa maarunu ningilo merupu vale shathruvu koolunu (2)  ||Devuni||"
      ]
    }
  ]
}
