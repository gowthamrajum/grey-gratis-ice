        "గుప్పిలి విప్పి నా కోరిక తీర్చుమా"
      ],
      "english": [
        "Nee Korakai Aashakaligi Nattivaaru Dhanyulu",
        "Guppili Vippi Naa Korika Theerchumaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వెలుగు నిచ్చు జ్యోతినై యుండాలని",
        "లోకానికి ఉప్పునై బ్రతకాలని",
        "రోగులకే ఔషదం అవ్వాలని",
        "జీవ జలపు నదిగా నేను ప్రవహించాలని"
      ],
      "english": [
        "Velugu Nichchu Jyothinai Yundaalani",
        "Lokaaniki Uppunai Brathakaalani",
        "Rogulake Aushadam Avvaalani",
        "Jeeva Jalapu Nadigaa Nenu Pravahinchaalani"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మండుచున్న సంఘములను ప్రభుకొరకై కట్టెద",
        "కోట్లాది ఆత్మలను సిలువ చెంత చేర్చెద",
        "దిక్కులేని వారికి ఆదరణగ నుండెద",
        "కడవరకు నీ ప్రేమ లోకమంత చాటెద"
      ],
      "english": [
        "Manduchunna Sanghamulanu Prabhukorakai Katteda",
