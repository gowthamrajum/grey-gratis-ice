  "main_stanza": {
    "telugu": [
      "కల్వరి రక్తమే నా పాపము కడిగెనుగా",
      "కల్వరి రక్తమే నా శాపము విరిచెనుగా",
      "కల్వరి రక్తమే నను శుద్ధుని చేసెనుగా",
      "కల్వరి రక్తమే యేసు రక్తమే"
    ],
    "english": [
      "Kalvari rakthame naa paapamu kadigenugaa",
      "kalvari rakthame naa shaapamu virichenugaa",
      "kalvari rakthame nanu shuddhuni chesenugaa",
      "kalvari rakthame yesu rakthame"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎటువంటి వ్యాధియైనా",
        "ఆత్మీయ రోగమైనా",
        "తుఫానువంటి శోధనైన",
        "అంధకారా శక్తులైనా",
        "జయమిచ్చును యేసు రక్తము",
        "జయమిచ్చును యేసు నామము"
      ],
      "english": [
        "Etuvanti vyaadhiyainaa",
        "aathmeeya rogamainaa",
        "thuphaanuvanti shodhanaina",
        "andhakaaraa shakthulainaa",
        "jayamichunu yesu rakthamu",
        "jayamichchunu yesu naamamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జయం జయం జయం"
      ],
