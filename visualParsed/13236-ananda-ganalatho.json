{
  "song_name": "Aananda gaanaalatho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆనంద గానాలతో ఆరాధించెద ఐశ్వర్యవంతుడా యేసయ్య",
      "అనురాగాలు కురిపించి అనువైన దీవెనలు ఇచ్చావని",
      "ఆనంద నగరములో స్వాస్థ్యము నాకై దాచవని"
    ],
    "english": [
      "Aananda gaanaalatho aaraadhincheda aishvaryavanthudaa Yesayya",
      "Anuraagaalu kuripinchi anuvaina deevenalu ichchaavani",
      "Aananda nagaramulo swaasthyamu naakai daachavani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అరణ్య ప్రదేశములో నను కనుగొన్నావు",
        "భీకర ధ్వని గల ఎడారిలో నా తోడున్నావు",
        "నన్నావరించి పరామర్శించి కనుపాప వలె కాపాడినావు",
        "నా శైలము నీవై నా దుర్గము నీవై",
        "ఉన్నత స్థలములపై నను నిలిపావు"
      ],
      "english": [
        "Aranya pradheshamulo nanu kanugonnaavu",
        "Bheekara dhvani gala edaarilo naa thodunnaavu",
        "Nannaavarinchi paraamarshinchi kanupaapa vale kaapaadinaavu",
        "Naa shailamu neevai naa durgamu neevai",
        "Unnatha sthalamulapai nanu nilipaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా మనో నేత్రములు వెలిగించియున్నావు",
        "నీ శక్తి యొక్క మహాత్యములు తెలియజేసావు",
        "ఆత్మాభిషేకముతో అభిషేకించి వాక్యోపదేశముతో బలపరిచావు",
        "నా ధ్యానము నీవై నా ఆరాధనా నీవై",
        "నీ పోలికగా నను మలుచుచున్నావు"
      ],
      "english": [
        "Naa mano nethramulu veliginchiyunnaavu",
        "Nee shakthi yokka mahaathmyamulu theliyajesaavu",
        "Aathmaabhishekamutho abhishekinchi vaakyopadheshamutho balaparichaavu",
        "Naa dhyaanamu neevai naa aaraadhanaa neevai",
        "Nee polikagaa nanu maluchuchunnaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ జీవ గ్రంధములో నా పేరు రాసావు",
        "నీ పరిశుద్ధలంకారముతో అలంకరించావు",
        "నీ బూర శబ్దమును నే వినగానే నా శరీరము మార్పుచెందును",
        "నా నిరీక్షణ నీవై నా మహిమా నీవై",
        "తేజో వాసులతో నను చేర్చెదవు"
      ],
      "english": [
        "Nee jeeva grandhamulo naa peru raasaavu",
        "Nee parishuddhalankaaramutho alankarinchaavu",
        "Nee boora shabdhamunu ne vinagaane naa shareeramu maarpuchendhunu",
        "Naa nireekshana neevai naa mahimaa neevai",
        "Thejo vaasulatho nanu cherchedavu"
      ]
    }
  ]
}
