{
  "song_name": "Kanneeru vidiche o sodaraa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కన్నీరు విడిచే ఓ సోదరా",
      "కళ్ళు విప్పి చూడు నీ ముందరా",
      "నీ ముందు నిలిచెను నజరేయుడు చూడు",
      "నీ ముందు నిలిచెను ప్రియ యేసుడు",
      "కళ్ళు తుడుచుకో నీ ముందు చూసుకో ॥2॥"
    ],
    "english": [
      "Kanneeru vidiche o sodaraa",
      "Kallu vippi choodu nee mundharaa",
      "Nee mundu nilichenu Najareyudu choodu",
      "Nee mundu nilichenu priya Yesudu",
      "Kallu thuduchuko nee mundu choosuko ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒంటరి వానిగ చేసారా నీ ఆకలి ఎగతాళి చేసారా",
        "లేని మాటలెన్నో చెప్పారా",
        "నీ హృదయమంతా గాయం చేసారా",
        "నీ తోడు ఉండువాడు విడువని వాడు",
        "నీ తోడు ఉండువాడు మరువని వాడు ॥2॥",
        "కళ్ళు తుడుచుకో నీ ముందు చూసుకో ॥2॥  ||కన్నీరు||"
      ],
      "english": [
        "Ontari vaaniga chesaaraa nee aakali egathaali chesaaraa",
        "Leni maatalenno cheppaaraa",
        "Nee hrudhayamanthaa gaayam chesaaraa",
        "Nee thodu unduvaadu viduvani vaadu",
        "Nee thodu unduvaadu maruvani vaadu ॥2॥",
        "Kallu thuduchuko nee mundu choosuko ॥2॥  ||Kanneeru||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దైవమే లేదని తలచు చుంటివా",
        "దేవుని మేళ్ళను మరచి యుంటివా",
        "ఏమి చేయనీకు తోచకున్నదా ॥2॥"
      ],
      "english": [
        "Daivame ledani thalachu chuntivaa",
        "Devuni mellanu marachi yuntivaa",
        "Emi cheyaneeku thochakunnadhaa ॥2॥"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దిగులుగా దినములు గడుపు చుంటివా",
        "ఆయన ఎదపై హాయిగా నిదురపో ॥2॥"
      ],
      "english": [
        "Dhigulugaa dinamulu gadupu chuntivaa",
        "Aayana edhapai haayigaa nidhurapo ॥2॥"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆయన కృపయే నీకు బలం",
        "ఆయన శక్తి నిన్ను కమ్ముకొనున్",
        "కళ్ళు తుడుచుకో నీ ముందు చూసుకో కళ్ళు ॥2॥  ||కన్నీరు||"
      ],
      "english": [
        "Aayana krupaye neeku balam",
        "Aayana shakthi ninnu kammukonun",
        "Kallu thuduchuko nee mundu choosuko kallu ॥2॥  ||Kanneeru||"
      ]
    }
  ]
}
