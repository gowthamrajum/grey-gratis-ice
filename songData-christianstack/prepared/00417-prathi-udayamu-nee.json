{
  "song_name": "Prathi Udayamu Nee",
  "author": {
    "Authored by": "Pastor Paul Praveen",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రతి ఉదయము – నీ కృపపొంది",
      "దినమంతయు – నీ ముఖకాంతిలో",
      "వర్ధిల్లెదను నిన్నే స్తుతించుచు",
      "సాగిపోయెదను నిన్నే పాడుచు"
    ],
    "english": [
      "Pathi udhayamu – nee krupapondhi",
      "dhinamanthayu – nee mukhakaanthiloo",
      "vardhilledhanu nenne sthuthinchuchu",
      "saagipooyedhanu ninne paaduchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నావారు అనుకున్నవారందరు",
        "దూరాన నిలిచిన సమయములో",
        "నీ ప్రేమే కదా చేరదీసినది",
        "నన్నీస్థితిలో నిలిపినది కృపయేకదా",
        "నీతోనే ఇక నా సహవాసము",
        "నీకొరకు జీవించుట నేర్పుము",
        "ఇక నాజీవితం నీకే అంకితం",
        "నాధైర్యము నాబలము నీవేకదా",
        "కరుణించి నను చేరదీసితివి",
        "నీ సన్నిధిని విడువ నెన్నటికి",
        "సర్వసంపదలకు నిధి నీవేకదా",
        "అవసరములన్ని తీర్చే నాతండ్రివి"
      ],
      "english": [
        "Naa vaaru anukunnavaarandharu",
        "dhooraa nilichina samayamuloo",
        "nee preme kadhaa cheradheesinadhi",
        "nanneesthithiloo nilipinadhi krupayekadaa",
        "Neethoone ika naa sahavaasamu",
        "neekoraku jeevinchuta nerpumu",
        "ika naajeevitham neeke ankitham",
        "naa dhairyamu naa balamu neevekadhaa",
        "Karunninchi nannu cheradheesithivi",
        "nee sannidhine viduva nennatiki",
        "sarwasampadhalaku nidhi neevekadhaa",
        "avasaramulanni theerche naa thandrivi"
      ]
    }
  ]
}
