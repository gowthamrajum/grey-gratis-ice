{
  "song_name": "Nindu Manasutho",
  "author": {
    "Authored by": "Joel Kodali",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిండు మనసుతో నిన్ను ప్రేమింతును",
      "నా పూర్ణ శక్తితో నిన్ను సేవింతును",
      "నా సమస్తము నీకే అర్పింతును",
      "సంపూర్ణ భక్తితో నిన్ను పూజింతును",
      "నీతిమంతుడా ఓ నిర్మలాత్ముడా",
      "లోక రక్షకా యేసు"
    ],
    "english": [
      "Nindu manasutho ninnu preminthunu",
      "naa poorna shakthitho ninnu sevinthunu",
      "naa samastamu neeke arpinthunu",
      "sampoorna bhakthitho ninnu poojinthunu",
      "neethimanthudaa oo nirmalaathmudaa",
      "loka rakshakaa yesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ నీడలో నన్ను నిలువనీయుము",
        "నీ బాటలో నేను నడిచెద",
        "నీ ఆత్మతో నన్ను నింపు ప్రభు",
        "నీ సాక్షిగ నేను నిలిచెద",
        "సజీవ యాగముగ నా దేహము అర్పింతును",
        "నా బలము నా ఘనము నీకై సమర్పింతును",
        "ఫలియింపచేయుము నన్ను",
        "నీ నామము నేను మహిమపరచెద",
        "నవ్య గీతిక నీకై పాడెద",
        "సర్వసృష్టికి ఆదారబూతుడా",
        "గంబీర ద్వనులతో ఆరాదించెద",
        "నీ నామ మాదుర్యం లోకానికి చాటి చెప్పెదా",
        "నీ ప్రేమ వాత్సల్యం అందరికి చూపించెద",
        "మనసార ప్రేమింతు నిన్ను"
      ],
      "english": [
        "Nee needalo nannu niluvaneeyumu",
        "nee baatalo nenu nadicheda",
        "nee aathmato nannu nimpu prabhu",
        "nee saakshiga nenu nilicheda",
        "sajeeva yaagamuga naa dhehamu arpinthunu",
        "naa balamu naa ghanamu neekai samarpinthunu",
        "phaliyinpacheyumu nannu",
        "Nee naamamu nenu mahimaparacheda",
        "navya geetika neekai paadeda",
        "sarvasrushtiki aadaaraboothudaa",
        "gambeera dwanulato aaraadincheda",
        "nee naama maaduryam loakaaniki chaati cheppedaa",
        "nee prema vaathsalyam andariki choopincheda",
        "manasaara preminthu ninnu"
      ]
    }
  ]
}
