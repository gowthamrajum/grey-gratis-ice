        "శపిత సిల్వపై క్రీస్తు సహించెను",
        "తండ్రి చిత్తము నూ నెరవేర్చెను"
      ],
      "english": [
        "Koniyaadedan needu Kalvari premanu",
        "Varninchalenu nee apaara premanu",
        "Ghoravedhana - Sankata shramalan",
        "Shapitha silvapai Kreesthu sahinchenu",
        "Thandri chiththamunoo neraverchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కీర్తించెదా నీదు అపారకరుణకై",
        "పరమ పుత్రుండు వేదన నోర్చెను",
        "అవమాన నిందలు - మోముపై ఉమ్మియూ",
        "ప్రేమతో అన్నియూ సహించె మౌనమున్",
        "అమూల్య ప్రాణమిచ్చె మానవాళికే (మనకొరకే)"
      ],
      "english": [
        "Keerthinchedhaa needu apaarakarunakai",
        "Parama puthrundu vedhana norchenu",
        "Avamaana nindalu - Momupai ummiyoo",
        "Prematho anniyoo sahinche maunamun",
        "Amoolya praanamichche maanavaalike (manakorake)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కృతజ్ఞత చెల్లించెద నీ బలిదానమునకై",
        "అంతులేని నీ గొప్ప ప్రేమకై",
        "అనంత జీవము మహిమ నిరీక్షణ",
        "నా జీవితమునకే ఆధారమాయె",
        "క్రీస్తుకే పాడెదన్ హల్లెలూయ"
