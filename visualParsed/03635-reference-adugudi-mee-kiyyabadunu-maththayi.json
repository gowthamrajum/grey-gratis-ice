    "english": [
      "Adugudi meeru mana prabhuvichchun - Thappaka ichchun",
      "Adigedi prathivaadu pondhun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భక్తులుభక్తులు విశ్వాసముతో - ప్రార్థించి పొందిరి",
