      ],
      "english": [
        "Aathmeeya geethaalatho - Thanuvanthaa pulakinchanee",
        "Sangeethame bodhayai - Kanuvippu kaliginchanee = 2",
        "Kaalakshepam kosame - Parimithamu kaakundagaa",
        "Hrudhayaallo nivasinchuchoo - Kaaryaalu jariginchanee  ||Nee||"
