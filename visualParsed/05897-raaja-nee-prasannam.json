{
  "song_name": "Raajaa nee prasannam",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రాజా నీ ప్రసన్నం చాలునయ్యా",
      "ఎప్పుడు నాకు చాలునయ్యా",
      "ప్రసన్నం - ప్రసన్నం - దైవ ప్రసన్నం (2)"
    ],
    "english": [
      "Raajaa nee prasannam chaalunayya",
      "Eppudu naaku chaalunayya",
      "Prasannam - Prasannam - Daiva prasannam (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వేకువనే వెదకితిని - సంతోషముతో చేరితిని (2) \"ప్రసన్నం\""
      ],
      "english": [
        "Vekuvane vedhakithini - Santhoshamutho cherithini (2) \"Prasannam\""
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చేయి పట్టి నడుపుదువే - విడనాడని పరిశుద్ధుడవే (2) \"ప్రసన్నం\""
      ],
      "english": [
        "Cheyi patti nadupudhuve - Vidanaadani parishuddhudave (2) \"Prasannam\""
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరిపాలించు అతిశయమా - ఓదార్పు ఆశ్రయమా (2) \"ప్రసన్నం\""
      ],
      "english": [
        "Paripaalinchu athishayamaa - Odaarpu aashrayamaa (2) \"Prasannam\""
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "స్తుతులయందు వసించెదవే - తోడైయుండు నా ప్రియుడా (2) \"ప్రసన్నం\""
      ],
      "english": [
        "Sthuthulayandhu vasinchedhave - Thodaiyundu naa priyudaa (2) \"Prasannam\""
      ]
    }
  ]
}
