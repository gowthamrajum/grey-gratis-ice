  "main_stanza": {
    "telugu": [
      "ఓ నేస్తమా ఈ శుభవార్త తెలియునా (2)",
      "నిను ప్రేమించే వారొకరున్నారని వాస్తవం తెలియునా (2)",
      "నిను రక్షించువాడు యేసయ్యేనని సత్యం తెలియునా (2)"
    ],
    "english": [
      "O nesthamaa ee shubhavaartha theliyunaa (2)",
      "Ninu preminche vaarokarunnaarani vaasthavam theliyunaa (2)",
      "Ninu rakshinchuvaadu Yesayyenani sathyam theliyunaa (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు నమ్మిన వారే మోసంతో నీ గుండెనే చీల్చినా",
        "నీ సొంతం జనులే నీ ఆశల మేడలు అన్నియు కూల్చిన (2)",
        "ఊహించనివి జరిగినా అవమానం మిగిలినా (2)",
        "నిను ఓదార్చేవాడొకడున్నాడని వాస్తవం తెలియునా",
        "నీ స్థితిమార్చువాడు యేసయ్యానని సత్యం తెలియునా"
      ],
      "english": [
        "Neevu nammina vaare mosantho nee gundene cheelchinaa",
        "Nee sontham janule nee aashala medalu anniyu koolchina (2)",
        "Oohinchanivi jariginaa avamaanam migilinaa (2)",
        "Ninu odhaarchevaadokadunnaadani vaasthavam theliyunaa",
        "Nee sthithimaarchuvaadu Yesayyaanani sathyam theliyunaa"
      ]
    },
    {
      "stanza_number": 2,
