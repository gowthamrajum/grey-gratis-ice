    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దిగులు పడకు సేవకా దిగులు పడకుమయా",
      "నమ్మదగిన దేవుడు నిన్ను పిలిచె గదా",
      "కష్టాలు తీర్చి కన్నీటిని తుడిచి ఆదరించునుగా",
      "నీతోనే నడచి నీలోనే నిలచి నిన్ను నడుపునుగా",
      "ఓ సేవకా భయపడకిక జయము నీదె గదా"
    ],
    "english": [
      "Digulu padaku sevakaa digulu padakumayaa",
      "Nammadagina Devudu ninnu piliche gadaa",
      "Kashtaalu theerchi kanneetini thudichi aadarinchunugaa",
      "Neethone nadachi neelone nilachi ninnu nadupunugaa",
      "O sevakaa bhayapadakika jayamu neede gadaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అగ్నివంటి శోధనలకు భయపడకుమయా",
        "అగ్నిలోను క్రీస్తు అండ తోడుండగా",
        "అగ్ని గుండమే నిన్ను హెచ్చించి ఘనపరచునుగా",
        "షద్రకు మేషకబెద్నెగోలను మరచిపోకుమా",
        "ఓ సేవకా భయపడకికా అగ్ని మేలెగదా"
      ],
      "english": [
        "Agnivanti shodhanalaku bhayapadakumayaa",
        "Agnilonu Kreesthu anda thodundagaa",
        "Agni gundame ninnu hechchinchi ghanaparachunugaa",
        "Shadraku Meshaku Abednegolanu marachipokumaa",
        "O sevakaa bhayapadakikaa agni melegadaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏమి తిందునో ఎక్కడ ఉందునో చింతించకుమా",
        "నీకున్న అవసరతలు తండ్రికి తెలియునుగా",
        "ఆకాశము నుండి మన్నాను పంపి పోషించె గదా",
        "ఐదు రొట్టెలు రెండు చేపలు సంగతి మరువకుమా",
        "ఓ సేవకా భయపడకిక గంపలు మిగిలెగదా"
      ],
      "english": [
        "Emi thindhuno ekkada undhuno chinthinchakumaa",
        "Neekunna avasarathalu thandriki theliyunugaa",
        "Aakaashamu nundi mannaanu pampi poshinche gadaa",
        "Aidu rottelu rendu chepalu sangathi maruvakumaa",
        "O sevakaa bhayapadakika gampalu migilegadaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు కలిగిన దర్శనమును విడిచిపెట్టకుమా",
        "లోకాశలకు ధన సంపదకు లొంగిపోకుమా",
        "స్త్రీ వ్యామోహం ఈ లోక స్నేహం నీకు తగదు గదా",
        "ఆత్మల రక్షణ సంఘ పోషణ నీపై నుండె గదా",
        "ఓ సేవకా వెనుదిరుగక ముందుకు సాగుమయా"
      ],
      "english": [
        "Neevu kaligina dharshanamunu vidichipettakumaa",
        "Lokaashalaku dhana sampadaku longipokumaa",
        "Sthree vyaamoham ee loka sneham neeku thagadhu gadaa",
        "Aathmala rakshana sangha poshana neepai nunde gadaa",
        "O sevakaa venudhirugaka munduku saagumayaa"
      ]
    }
  ]
