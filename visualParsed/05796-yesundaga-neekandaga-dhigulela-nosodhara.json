  "main_stanza": {
    "telugu": [
      "యేసుండగా నీకండగా దిగులేల నోసోదరా",
      "యేసుండగా నీకండగా దిగులేల నోసోదరీ ॥2॥",
      "నిను కాపాడి నిను రక్షించుటకు ॥2॥",
      "తన ప్రాణాన్నే అర్పించినాడు ॥యేసుండగా॥"
    ],
    "english": [
      "Yesundagaa neekandagaa digulela nosodharaa",
      "Yesundagaa neekandagaa digulela nosodharee ||2||",
      "Ninu kaapaadi ninu rakshinchutaku ||2||",
      "Thana praanaanne arpinchinaadu ||Yesundagaa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
