  "main_stanza": {
    "telugu": [
      "అదృష్య దేవుడు కనిపించెగా – అనాది సంకల్పం నెరవేరేగా",
      "తేజోమయుడు ఉదయించేగా – తరాల శాపం తొలగిపోయేగా"
    ],
    "english": [
      "Adrushya dhevudu – kanipinchega",
      "Anaadhi sankalpam – neraveregaa…",
      "Thejomayudu udhayinchega – tharaala shaapamu tholagipoyega"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరిశుద్ధ తనయుడా నరరూప ధారుడా",
        "నరులను రక్షించు కరుణా సముద్ర",
        "నరులను రక్షించు",
        "కరుణా సముద్ర …."
      ],
      "english": [
        "Parishuddha thanayuda",
        "nararoopa dharuda…",
        "narulanu raakshinchu",
        "karunaa samudra..",
        "narulanu rakshinchu",
        "karuna samudra….."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తోడుండు వాడు – కాపాడు వాడు",
        "విడువని వాడు – విజయమిచ్చు వాడు"
      ],
      "english": [
        "Thodunduvaadu",
        "Kaapaaduvaadu",
        "Viduvanivaadu",
        "Vijayamicchuvaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఏతెంచే – లోకరక్షకుడు యేసయ్య",
        "అరుధించే – తృణముగా సౌభాగ్యమును విడిచి"
      ],
      "english": [
        "Yethenchey – lokarakshakudu yesayya",
        "Arudhenchey – thrunamuga sowbhaagyamuney vidichi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "1. స్వాస్థ్యమే నిత్య స్వాస్థ్యమై దొరికే ఈ రోజున",
        "రక్షణ గొప్ప రక్షణ – సొంతమాయే ఈ క్షణాణ",
        "వరపుత్రుడే రాయబారీగా వచ్చెనే",
        "వారసత్వమే వరియించి ఇలా వచ్చేనె",
        "పాపం పోయి శాపం తొలగి సంబరాలు మొదలాయెగా …"
      ],
      "english": [
        "Swaasthyamey Nithya swaasthyamai dorikey ee rojuna",
        "Rakshana goppa rakshana swanthamaye ee kshanaana",
        "Varaputhrudey raayabaariga vacheney",
        "Vaarasathwamey variyinchi ila vacchene",
        "paapam poyi,shaapam tholagi, sambaraalu modalaayegaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఏతెంచే లోకరక్షకుడు యేసయ్య",
        "అరుధించే – తృణముగా సౌభాగ్యమును విడిచి"
      ],
      "english": [
        "Yethenchey – lokarakshakudu yesayya",
        "Arudhinchey – trunamuga sowbhaagayumney vidichi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "రాజ్యమే నిత్య రాజ్యమే – ఇచ్చెనే బహుసుళువుగా",
        "జీవమే నిత్య జీవమే – దొరికెనే బహుఘనముగా",
        "ప్రేమయే పరిపూర్ణమాయేగా – యేసయ్య నువ్విలరాగా",
        "ఆనందమే నిత్యమాయేగా – నీవేమాకు సొంతమవ్వగా",
        "సర్వాదికారి శరీరధారిగా – మన మధ్య నివసించుటకు"
      ],
      "english": [
        "Raajyame nithya raajyame icchene bahusuluvuga",
        "Jeevamey Nithya jeevamey dorikeney bahu ghanamuga",
        "Premaye paripoornamayegaa yesayya nuvvilaraaga..",
        "Aanadhame nithyamayegaa neevey maaku sonthamavvaga..",
        "Sarvadhikaari shareeradhaariga mana madhya nivasinchutaku"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఏతెంచే లోకరక్షకుడు యేసయ్య",
