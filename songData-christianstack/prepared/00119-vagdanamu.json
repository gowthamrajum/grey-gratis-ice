{
  "song_name": "Vagdanamu",
  "author": {
    "Authored by": "Samasthamu Melukai by Olivia Jentzen & Swathi Abburi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నన్ను విడువవు మాట తప్పవు",
      "సమస్తము మేలుకై జరుగింతువు"
    ],
    "english": [
      "Nannu viduvavu maata thappavu",
      "Samasthamu melukai jariginthuvu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "“రాజుల రాజా ప్రభువుల ప్రభువా నాతో ఉన్నవాడా”",
        "ఇచ్చిన మాట తప్పని వాడా స్థిరపరచువాడా"
      ],
      "english": [
        "“Raajula raajaa prabhuvula prabhuvaa Natho unnavaada”",
        "Icchina maata thappani vada sthiraparachuvada"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "భయపడను, నిలిచేదను,",
        "నీ వాగ్దానము దృఢపరచును నిరంతరము"
      ],
      "english": [
        "Bhayapadanu, nilichedhanu,",
        "nee vaghdhanamu dhrudaparachunu nirantharamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ చిత్తమే జరుగును",
        "నీ సన్నిధే జయమిచ్చును",
        "అను దినము నీ వాగ్దానములో నేనడిచేదను"
      ],
      "english": [
        "Nee chithame jarugunu",
        "Nee sannidhe jayamichunu",
        "Anu dhinamu nee vaghdhanamulo nenadichedhanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భయపడను, నిలిచేదను,",
        "నీ వాగ్దానము దృఢపరచును నిరంతరము"
      ],
      "english": [
        "Bhayapadanu, nilichedhanu,",
        "nee vaghdhanamu dhrudaparachunu nirantharamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నన్ను విడువవు మాట తప్పవు",
        "సమస్తము మేలుకై జరుగింతువు"
      ],
      "english": [
        "Nannu viduvavu maata thappavu",
        "Samasthamu melukai jariginthuvu"
      ]
    }
  ]
}
