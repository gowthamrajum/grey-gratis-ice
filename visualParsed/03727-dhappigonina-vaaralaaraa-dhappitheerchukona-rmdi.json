  },
  "main_stanza": {
    "telugu": [
      "దప్పిగొనిన వారలారా దప్పితీర్చుకొన రండి రండి",
      "కాసు రూకలు లేకున్నను త్రాగను రండి"
    ],
    "english": [
      "Dhappigonina vaaralaaraa dhappitheerchukona randi randi",
      "Kaasu rookalu lekunnanu thraaganu randi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెషయా యిరువదియైదు ఆరవ వచనము చదివి",
        "త్రాగుచు తృప్తి పొందను రండి రండి"
      ],
      "english": [
        "Eshayaa iruvadhiyaidhu aarava vachanamu chadhivi",
        "Thraaguchu thrupthi pondhanu randi randi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రొవ్విన పదార్థమును పాత ద్రాక్షారసమును",
        "క్రొవ్వు మెదడు గలవాటిని తినుటకు రండి"
      ],
      "english": [
        "Krovvina padhaarthamunu paata dhraakshaarasamunu",
        "Krovvu medhadu galavaatini thinutaku randi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేనే జీవపానమును - నేనే పరమాహారమును",
        "రూకలను వ్యర్థము చేయక - రండి రండి"
      ],
      "english": [
        "Nene jeevapaanamunu - Nene paramaahaaramunu",
        "Rookalanu vyarthamu cheyaka - Randi randi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా మాంసమే పరమాహారం - నే చిందించిన రక్తమేపానం",
        "తిని త్రాగిన వారికి కల్గును నిత్యజీవం"
      ],
      "english": [
        "Naa maamsame paramaahaaram - Ne chindhinchina rakthamepaanam",
        "Thini thraagina vaariki kalgunu nithyajeevam"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ద్రాక్షారసము ఓదార్చున్ - జల్దరు తృప్తిపరచున్",
        "నీకు నూనె ఉజ్జీవమునిచ్చున్నిచ్చున్"
      ],
      "english": [
        "Dhraakshaarasamu odhaarchun - Jaldaru thrupthiparachun",
        "Neeku noone ujjeevamunichchunnichchun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "గొఱ్ఱెపిల్లలు దూడలును - తినువారికి చంపబడెను",
        "వ్యర్థసాకులను చెప్పక రండి రండి"
      ],
      "english": [
        "Gorrepillalu dhoodalunu - Thinuvaariki champabadenu",
        "Vyarthasaakulanu cheppaka randi randi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సర్వసమృద్ధిలోన దేవుడున్నాడు రండి",
        "హల్లెలూయ పాటలుండును రండి రండి"
      ],
      "english": [
        "Sarvasamruddhilona Dhevudunnaadu randi",
        "Hallelooya paatalundunu randi randi"
      ]
    }
  ]
