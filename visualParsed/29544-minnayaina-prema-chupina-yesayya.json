  "main_stanza": {
    "telugu": [
      "మిన్నయైన ప్రేమ చూపిన యేసయ్యా",
      "ఎన్నడైన భూమి చూడని మనసయ్యా",
      "ఎంతగానో ఓర్చితివే వింతగా క్షమించితివే",
      "మిన్నకుండలేము యేసయ్యా కనుగొని నీ ప్రేమను",
      "ఎన్న తరమే కాదయ్యా లోతైన ఆ ప్రేమను"
    ],
    "english": [
      "Minnayaina prema choopina Yesayyaa",
      "Ennadaina bhoomi choodani manasayyaa",
      "Enthagaano orchithive vinthagaa kshaminchithive",
      "Minnakundalemu Yesayyaa kanugoni nee premanu",
      "Enna tharame kaadayyaa lothaina aa premanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ద్రోహము చేసి దోషము మోపిరి",
        "కేకలు వేసి సిలువకు నెట్టిరి",
        "పండ్లు కొరికి చెంపలు పెరికిరి",
        "ముండ్లను గుచ్చి మోమున ఉమ్మిరి",
        "శ్రమ పెట్టిన కొలది క్షమ పుట్టుట సాధ్యమా"
      ],
      "english": [
        "Dhrohamu chesi doshamu mopiri",
        "Kekalu vesi siluvaku nettiri",
        "Pandlu koriki chempalu perikiri",
        "Mundlanu guchchi momuna ummiri",
        "Shrama pettina koladi kshama puttuta saadhyamaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నరుడని ఎంచి హేళన చేసిరి",
        "శక్తిని ప్రశ్నించి నిను శంకించిరి",
        "సవాలు విసిరి అవమానించిరి",
        "ఛీత్కరించి వెకిలిగ నవ్విరి",
        "సామర్థ్యము కలిగీ సహియించుట సాధ్యమా"
      ],
      "english": [
        "Narudani enchi helana chesiri",
        "Shakthini prashninchi ninu shankinchiri",
        "Savaalu visiri avamaaninchiri",
        "Cheethkarinchi vekiliga navviri",
        "Saamarthyamu kaligee sahiyinchuta saadhyamaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అలసిన నిన్ను బహు విసిగించినా",
        "ఓటమి పాలై నిరాశ పరచినా",
        "ఫలములు లేని తీగెగా మిగిలినా",
        "మరలా మరలా నిను సిలువేసినా",
        "వేధించిన కొలది ప్రేమించుట సాధ్యమా"
      ],
      "english": [
        "Alasina ninnu bahu visiginchinaa",
        "Otami paalai niraasha parachinaa",
        "Phalamulu leni theegegaa migilinaa",
        "Maralaa maralaa ninu siluvesinaa",
        "Vedhinchina koladi preminchuta saadhyamaa"
      ]
    }
  ]
