{
  "song_name": "Shree Yesu divya naamasmarana",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "వంతగాని పరదేశి"
    ]
  },
  "main_stanza": {
    "telugu": [
      "శ్రీ యేసు దివ్య నామస్మరణ చేయవే మనసా",
      "పాయక స్మరియించి పరము పొందువే మనసా ||శ్రీ||"
    ],
    "english": [
      "Shree Yesu divya naamasmarana cheyave manasaa",
      "Paayaka smariyinchi paramu pondhuve manasaa ||Shree||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నరుల పాప హరణమునకై నరుడయ్యె మనసా",
        "పరమ పుర ద్వారంబు మనకు తెరచెనే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Narula paapa haranamunakai narudayye manasaa",
        "Parama pura dhvaarambu manaku therachene manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నరుల పాప శాప ఫలము నరకమే మనసా",
        "ఆ మరణమును తొలంచప్రభువే నుడిసె నేమనసా  ||శ్రీ||"
      ],
      "english": [
        "Narula paapa shaapa phalamu narakame manasaa",
        "Aa maranamunu tholancha Prabhuve nudise nemanasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపమునకు ప్రాయశ్చిత్తం భవ్యమే గదా",
        "ప్రభువే ప్రాయశ్చిత్త బలియై పరగెనే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Paapamunaku praayashchittham bhavyame gadaa",
        "Prabhuve praayashchittha baliyai paragene manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సిలువవేసి ప్రభుని ప్రజలు చంపిరే మనసా",
        "ఆ బలుడు తిరిగి లేచి మృతిని గెలిచేనే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Siluvavesi Prabhuni prajalu champire manasaa",
        "Aa baludu thirigi lechi mruthini gelichene manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "గెలిచి యేసు హితులమధ్య నిలిచెనే మనసా",
        "నిలిచి సమాధాన మంచు పలికెనే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Gelichi Yesu hithulamadhya nilichene manasaa ||Shree||",
        "Nilichi samaadhaana manchu palikene manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పునరుత్థాన మేసు దేవ పుత్రుడని మహా",
        "ఘనముగా ప్రకటించుచుండ కాననే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Punarutthaana mesu Deva puthrudani mahaa",
        "Ghanamugaa prakatinchuchunda kaanane manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "తానె మార్గం తానెసత్యం తానెజీవము",
        "ఈ ఘన సత్యంబు నమ్మునరులు ధన్యులే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Thaane maargam thaane sathyam thaane jeevamu",
        "Ee ghana sathyambu nammunarulu dhanyule manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నిన్ను నీ వెరింగి ప్రభుని నెరుగ వే మనసా",
