{
  "song_name": "Viluvainadi ee jeevitham anni velala",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "విలువైనది ఈ జీవితం",
      "అన్ని వేళల ఆనందించెదం",
      "సంపూర్ణ సంతోషమిచ్చువాడు",
      "సకల సమృద్ధుడేసు బహు సంపన్నుడు",
      "మనలను పిలచే వారసులుగా",
      "నాట్యముతోను సంగీత సబ్దములతో",
      "పండుగ చేద్దాం రండీ నేడు"
    ],
    "english": [
      "Viluvainadi ee jeevitham",
      "Anni velala aanandinchedam",
      "Sampoorna santhoshamichchuvaadu",
      "Sakala samruddhudesu bahu sampannudu",
      "Manalanu pilache vaarasulugaa",
      "Naatyamuthonu sangeetha shabdhamulatho",
      "Panduga cheddaam randee nedu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు ఒక్కడే మనకు మాదిరి",
        "మన జీవిత సారధి",
        "లేరు లోకంలో యేసుకు సాటి",
        "ఆయనే మన ఊపిరి",
        "మదిలోని ఆశలు యెరిగిన దేవుడు",
        "అడుగక ముందుగ బదులిచ్చుచుండగా",
        "మనకేమి లేమి లేదు"
      ],
      "english": [
        "Yesu okkade manaku maadiri",
        "Mana jeevitha saaradhi",
        "Leru lokamlo Yesuku saati",
        "Aayane mana oopiri",
        "Madhiloni aashalu erigina Devudu",
        "Adugaka mundhuga badhulichchuchundagaa",
        "Manakemi lemi ledu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేసు మరువడు మనలనెన్నడు",
        "గమ్యము వరకు చేర్చును",
        "కనిన కలలన్ని నెరవేర్చునాయనే",
        "మనకింకేమి కలవరము",
        "నిన్న ఇకరాదు రేపటి దిగులొద్దు",
        "ఈనాడే మనకున్న అనుకూల సమయము",
        "జీవితాన్ని ఒక వేడుక చేద్దాం"
      ],
      "english": [
        "Yesu maruvadu manalanennadu",
        "Gamyamu varaku cherchunu",
        "Kanina kalalanni neraverchunaayane",
        "Manakinkemi kalavaramu",
        "Ninna ikaraadhu repati dhiguloddhu",
        "Eenaade manakunna anukoola samayamu",
        "Jeevithaanni oka veduka cheddaam"
      ]
