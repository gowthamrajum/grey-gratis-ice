{
  "song_name": "SthuthiMchudi Meeru SthuthiMchudi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతించుడి మీరు స్తుతించుడి యెహోవా దేవుని స్తుతించుడి - స్తుతించుడి"
    ],
    "english": [
      "SthuthiMchudi Meeru SthuthiMchudi Yehoavaa Dhaevuni SthuthiMchudi - SthuthiMchudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓ దూతలారా పరమ సైన్యమా",
        "సూర్యచంద్రులారా తారాగణమా ప్రభునే స్తుతించుడి"
      ],
      "english": [
        "Oa Dhoothalaaraa Parama Sainyamaa",
        "SooryachaMdhrulaaraa ThaaraagaNamaa Prabhunae SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరమాకాశమా పైనున్న జలమా",
        "సృష్టికర్తను స్తుతించుడి నాథుని స్తుతించుడి"
      ],
      "english": [
        "Paramaakaashamaa Painunna Jalamaa",
        "SruShtikarthanu SthuthiMchudi NaaThuni SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మకరములారా అగాధ జలమా",
        "అగ్ని వడగండ్లు ఆవిరి హిమమా కర్తను స్తుతించుడి"
      ],
      "english": [
        "Makaramulaaraa AgaaDha Jalamaa",
        "Agni VadagaMdlu Aaviri Himamaa Karthanu SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పర్వత శిఖర వృక్షములారా",
        "మృగ పక్షి ప్రాకు పురుగులారా కాపరిని స్తుతించుడి"
      ],
      "english": [
        "Parvatha Shikhara VrukShamulaaraa",
        "Mruga PakShi Praaku Purugulaaraa Kaaparini SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "భూరాజులారా సర్వ ప్రజలారా",
        "అధిపతులు యౌవనులు కన్యకలు రారాజుని స్తుతించుడి"
      ],
      "english": [
        "Bhooraajulaaraa Sarva Prajalaaraa",
        "ADhipathulu Yauvanulu Kanyakalu Raaraajuni SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మహోన్నతుండు ఇహ పరములలో",
        "ఐశ్వర్యవంతుని స్తుతించుడి దేవుని స్తుతించుడి"
      ],
      "english": [
        "MahoannathuMdu Iha Paramulaloa",
        "AishvaryavaMthuni SthuthiMchudi Dhaevuni SthuthiMchudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ప్రజలెల్లరికి రక్షణ శృంగము",
        "ఇశ్రాయేలీయులకు భక్తులకును తండ్రిని స్తుతించుడి"
      ],
      "english": [
        "Prajalellariki RakShaNa ShruMgamu",
        "Ishraayaeleeyulaku Bhakthulakunu ThaMdrini SthuthiMchudi"
      ]
    }
  ]
}
