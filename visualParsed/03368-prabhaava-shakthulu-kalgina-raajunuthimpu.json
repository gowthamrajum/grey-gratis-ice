  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభావ శక్తులు కల్గిన రాజునుతింపు",
        "దీని ప్రయాత్మ! కోరుదు రేని స్మరింపు",
        "కూడుడిదో! కన్నెర వీణలతో గానము చేయనులెండి"
      ],
      "english": [
        "Prabhaava shakthulu kalgina raajunuthimpu",
        "Dheeni priyaathma! korudhu reni smarimpu",
        "Kooduditho! kinnera veenalatho gaanamu cheyanulendi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సర్వము వింతగ పాలన చేసెడివాడు",
        "రెక్కలతో నిను మోసెను గావున బాడు",
        "నీకు సదా కావలి యుండుగదా - దాని గ్రహింపవదేల"
      ],
      "english": [
        "Sarvamu vinthaga paalana chesedivaadu",
        "Rekkalatho ninu mosenu gaavuna baadu",
        "Neeku sadaa kaavali yundugadhaa - Daani grahimpavadhela"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మను! మిక్కిలి వింతగా నిన్ను సృజించి",
        "సౌఖ్యము నిచ్చుచు స్నేహముతో నడిపించి",
        "కష్టములో కప్పుచు రెక్కలతో గాచిన నాథునుతించు"
      ],
      "english": [
        "Aathmanu! mikkili vinthagaa ninnu srujinchi",
        "Saukhyamu nichchuchu snehamutho nadipinchi",
        "Kashtamulo kappuchu rekkalatho gaachina naathunuthinchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "స్నేహపు వర్షము - నీపై తా గురియించి",
        "అందరు చూచుచు ఉండగానే కరుణించి",
        "దీవెనలు నీకు నిరంతరము నిచ్చిన నాథునుతించు"
      ],
      "english": [
        "Snehapu varshamu - Neepai thaa guriyinchi",
        "Andaru choochuchu undagaane karuninchi",
        "Deevenalu neeku nirantharamu nichchina naathunuthinchu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నాథుని నామము - నాత్మ స్మరించి నుతింపు",
        "ఊపిర గల్గిన స్వరమా నీవు నుతింపు",
        "సంఘములో నాబ్రాహం సంతతిలో - నాథునుతింపుము"
      ],
      "english": [
        "Naathuni naamamu - Naathma smarinchi nuthimpu",
        "Oopira galgina swaramaa neevu nuthimpu",
        "Sanghamulo Naabraaham santhathilo - Naathunuthimpumu"
      ]
    }
  ]
}
