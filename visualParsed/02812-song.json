    "english": [
      "Paapamu valana chedinavaani",
      "prematho vethaki rakshinchudu",
      "Thappinavaanini drohini meeru",
      "Yesuni yoddaku rammanudu.",
      "||Padinavaariki joopudu throva",
      "Yesu paapaathmulan rakshim",
      "chunu||"
