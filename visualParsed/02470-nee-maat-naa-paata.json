    "english": [
      "Nee maata naa paatagaa - Anukshanam paadanee",
      "Lokaana ninu chaatagaa - Naa swaram vaadanee",
      "Naa geetham.. aathmalanu - Neevaipe aakarshinchanee",
      "Aadarana.. kaliginchi - Neelone praharshinchanee.."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏ చోట గళమెత్తినా - నీ ప్రేమ ధ్వనియించనీ",
