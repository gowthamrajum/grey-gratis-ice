{
  "song_name": "Yesu Puttenu",
  "author": {
    "Authored by": "Philip gariki",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు పుట్టెను రక్షనొచ్చెను",
      "నిత్య జీవమే మనకు ఇచ్చెను",
      "పాపలు పోగొట్టగా – మనకు మార్గమే చూపించగా",
      "దివినుండి భువికేగెను"
    ],
    "english": [
      "Yesu puttenu rakshanochenu",
      "nithya jeevame manaku ichenu",
      "paapaalu pogottaga manaku margame chupinchaga",
      "dhivi nundi bhuvikegenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జన్మించినాడయ్యా – మహా మహిమగల యేసయ్యా",
        "అందరికీ రక్షకుడయ్యా – స్తుతి ఆరాధన చేద్దామయ్యా"
      ],
      "english": [
        "Janminchinaadayaa maha mahimagala yesayya",
        "andhariki rakshakudayya sthuthi aradhana cheddhamayya"
      ]
    }
  ]
}
