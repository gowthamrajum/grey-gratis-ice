  "main_stanza": {
    "telugu": [
      "నాలో నిన్ను చూడనీ నీతో బ్రతుకు సాగని",
      "నీ వాక్యపు వెలుగులో అందరు నన్ను చూడని"
    ],
    "english": [
      "Naalo ninnu choodanee neetho brathuku saaganee",
      "Nee vaakyapu velugulo andaru nannu choodanee"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
