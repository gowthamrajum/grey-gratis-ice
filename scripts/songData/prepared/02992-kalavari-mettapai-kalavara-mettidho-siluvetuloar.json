{
  "song_name": "Kalavari Mettapai Kalavara Mettidho",
  "author": {
    "Authored by": "",
    "రచన": "చెట్టి భానుమూర్తి"
  },
  "main_stanza": {
    "telugu": [
      "కలవరి మెట్టపై కలవర మెట్టిదొ సిలువెటులోర్చితివో",
      "పలుశ్రమ లొందినీ ప్రాణము బెట్టితి"
    ],
    "english": [
      "Kalavari Mettapai Kalavara Mettidho Siluvetuloarchithivoa",
      "Palushrama Londhinee Praanamu Bettithi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తులువలుజేరినిన్ తలపడి మొత్తిరో",
        "అలసితి సొలసితి నాత్మను గుందితి"
      ],
      "english": [
        "Thuluvalujaerinin Thalapadi Moththiroa",
        "Alasithi Solasithi Naathmanu Gundhithi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపులకొరకై ప్రాణముబెట్టితి",
        "ప్రేమ ది యెట్టిదో నామదికందదు"
      ],
      "english": [
        "Paapulakorakai Praanamubettithi",
        "Praema Dhi Yettidhoa Naamadhikandhadhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దారుణ పాప భారము మోసితి",
        "దీనుల రక్షణ దానమైతివి గద"
      ],
      "english": [
        "Dhaaruna Paapa Bhaaramu Moasithi",
        "Dheenula Rakshana Dhaanamaithivi Gadha"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జనకున భీష్టమున్ జక్కగ దీర్చితి",
        "జనముల బ్రోవనీ జీవము నిచ్చితి"
      ],
      "english": [
        "Janakuna Bheeshtamun Jakkaga Dheerchithi",
        "Janamula Broavanee Jeevamu Nichchithi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శాంతిని గోరి ది శాంతముల్దిరిగిన",
        "భ్రాంతియె గాని వి శ్రాంతెవరిత్తురు?"
      ],
      "english": [
        "Shaanthini Goari Dhi Shaanthamuldhirigina",
        "Bhraanthiye Gaani Vi Shraanthevariththuru?"
      ]
    }
  ]
}
