{
  "song_name": "Vinathi Vinathi Vinathi Thriyekuniki",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వినతి వినతి వినతి త్రియేకునికి",
      "మనసునందు సద్గతి నిడును"
    ],
    "english": [
      "Vinathi vinathi vinathi thriyekuniki",
      "Manasunandhu sadgathi nidunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కోపదినమును తప్పించుకొనుటకు - ఏ పని చేసితివి",
        "బాధలు నిన్ను చేరక యుండును - నాథుని కనుగొనిన"
      ],
      "english": [
        "Kopadhinamunu thappinchukonutaku - E pani chesithivi",
        "Baadhalu ninnu cheraka yundunu - Naathuni kanugonina"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఇచ్ఛల నెల్లను ఇలలో విడచి - నెచ్చెలు డేసును నమ్ము",
        "మేదినిసకలము మాయమైపోవును - సదయుడేసు నిలచున్"
      ],
      "english": [
        "Ichchhala nellanu ilalo vidachi - Nechchelu Desunu nammu",
        "Medhinisakalamu maayamaipovunu - Sadhayudesu nilachun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కాయమస్థిరము కాలము నిల్వదు మాయక్షితి మాయమగున్",
        "దాసుడాకాలము వ్యర్థము చేయక - యేసునంగీకరింపుము"
      ],
      "english": [
        "Kaayamasthiramu kaalamu nilvadhu maayakshithi maayamagun",
        "Dhaasudaakaalamu vyarthamu cheyaka - Yesunangeekarimpumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రక్షకుడేసును సిలువలో గనుము - రక్షింప బడియెదవు",
        "జీవము సత్యము మార్గము చూతువు - దైవసుతునియందు"
      ],
      "english": [
        "Rakshakudesunu siluvalo ganumu - Rakshimpa badiyedhavu",
        "Jeevamu sathyamu maargamu choothuvu - Dhaivasuthuniyandhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షకు డాశ్రయదుర్గము వైద్యుడు - రక్షణ శృంగము కోట",
        "మింటను దేవుడు బండయు కేడెము - జుంటితేనెయు నాయనే"
      ],
      "english": [
        "Rakshaku daashrayadhurgamu vaidhyudu - Rakshana shrungamu kota",
        "Mintanu Devudu bandayu kedemu - Juntitheneyu naayane"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మంచికాపరి నిరతము కాచు - నంచితముగ నడుపున్",
        "జయము నిచ్చున్ త్రోసివేయక - ప్రియముతో పరుగిడరా"
      ],
      "english": [
        "Manchikaapari nirathamu kaachu - Nanchithamuga nadupun",
        "Jayamu nichchun throsiveyaka - Priyamutho parugidaraa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాట నార్భాటముతో - నెల్లరకు చాటుము",
        "త్వరగా రాజువచ్చును భువికి - దుష్టుల నణచుటకై"
      ],
      "english": [
        "Hallelooya paata naarbhaatamutho - Nellaraku chaatumu",
        "Thvaragaa raajuvachchunu bhuviki - Dushtula nanachutakai"
      ]
    }
  ]
}
