  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రీస్తుని చూచుచు సాగివెళ్ళెదను - సీయోను యాత్రలో",
        "లోకమున్ విడిచి చేరుకొందును మహిమ దేశమున్",
        "క్రీస్తుని అనుగ్రహములో సురక్షిత హస్తములలో",
        "మహానందముతో స్తుతించుచు చేరుదు నాదేశమున్",
        "ఎంతో సుందర జీవితము - మహిమతో నిండినది",
        "సదా సర్వదా క్రీస్తుతో నుండి",
        "మహిమ పరచెదను - మహిమలో నుండెదను"
      ],
      "english": [
        "Kreesthuni choochuchu saagivelledhanu - Seeyonu yaathralo",
        "Lokamun vidichi cherukondhunu mahima dheshamun",
        "Kreesthuni anugrahamulo surakshitha hasthamulalo",
        "Mahaanandhamutho sthuthinchuchu cherudhu naadheshamun",
        "Entho sundara jeevithamu - Mahimatho nindinadhi",
        "Sadaa sarvadaa Kreesthutho nundi",
        "Mahima parachedhanu - Mahimalo nundedhanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దుఃఖ శ్రమలలో నన్ను రక్షించు దాగుచోటు ఆయనే",
        "సంకటక్లేశ పరీక్షలలో జయము పొందెదను",
        "ప్రభునికై జీవించెదను ఆయన అడుగు జాడలలో",
        "ఆత్మ ప్రాణ శరీరము లర్పించి ఆయనను సేవింతును"
      ],
      "english": [
        "Duhkha shramalalo nannu rakshinchu dhaaguchotu aayane",
        "Sankataklesha pareekshalalo jayamu pondedanu",
        "Prabhunikai jeevinchedanu aayana adugu jaadalalo",
        "Aathma praana shareeramu larpinchi aayananu sevinthunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యాత్రికుడను ఈ జగమందు - పరవాసినైతి నేను",
        "స్వల్పజీవితము భువియందు గడిపి - చేరుదున్ ఆ దేశమున్",
        "నాకై విజ్ఞాపనము చేయు - మహాయాజకుడు యేసునితో",
        "తోడి వారసుడనై ఆయనతో - నిత్యము ఏలెదను"
      ],
      "english": [
        "Yaathrikudanu ee jagamandhu - Paravaasinaithi nenu",
        "Swalpajeevithamu bhuviyandu gadipi - Cherudhun aa dheshamun",
        "Naakai vignyaapanamu cheyu - Mahaayaajakudu Yesunitho",
        "Thodi vaarasudanai aayanatho - Nithyamu eledhanu"
      ]
    }
  ]
}
