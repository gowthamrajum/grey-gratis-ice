{
  "song_name": "Daaveedu vamsha Yesu Kreesthuku sthuthi chellinchudi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మత్తయి 21:9"
    ],
    "english": [
      "Matthew 21:9"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు వంశ యేసు క్రీస్తుకు - స్తుతి చెల్లించుడి",
        "స్వర్గస్తులమగుటకు మనలను విడిపించిన ప్రభువునకు",
        "హోసన్నా హోసన్నా - భువిలో సంతొషం"
      ],
      "english": [
        "Daaveedu vamsha Yesu Kreesthuku - Sthuthi chellinchudi",
        "Svargasthulamagutaku manalanu vidipinchina prabhuvunaku",
        "Hosannaa hosannaa - Bhuvilo santhosham"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మానుజావతారమున భువికి వచ్చి",
        "తన స్వంత జీవమును బలిగా యిచ్చి",
        "హోసన్నా యేసుని పేరట పరమును మనకొసగెన్"
      ],
      "english": [
        "Maanujaavathaaramuna bhuviki vachchi",
        "Thana swantha jeevamunu baligaa ichchi",
        "Hosannaa Yesuni perata paramunu manakosagen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రియ తండ్రీ ఈ భువిలో సకల మహిమయు నీకే",
        "సూర్య చంద్ర సృష్టియావత్తు స్తుతియించి మహిమపరచున్",
        "హోసన్నా హోసన్నా క్రొత్త యెరూషలేములో"
      ],
      "english": [
        "Priya thandree ee bhuvilo sakala mahimayu neeke",
        "Soorya chandhra srushtiyaavatthu sthuthiyinchi mahimaparachun",
        "Hosannaa hosannaa krottha Yerooshalemulo"
      ]
    }
  ]
}
