  "main_stanza": {
    "telugu": [
      "అబ్రహము దేవుడవు నీవే యేసయ్య",
      "దేవ కుమారుడవు నీవే మెస్సయ్య",
      "ధావన పావన బావా నిరంతర",
      "చింత తీర్చి శాంతి నిచ్చు ప్రేమ పావనుడా",
      "నీవే మాకు తోడుగా, నీవే మాకు నీడగా",
      "మాతో ఉండగా భయమేల"
    ],
    "english": [
      "Abrahamu devudavu neeve Yesayya",
      "Deva kumaarudavu neeve Messayya",
      "Dhaavana paavana baavaa nirantara",
      "Chintha theerchi shaanthi nichchu prema paavanudaa",
      "Neeve maaku thodugaa, neeve maaku needagaa",
      "Maatho undagaa bhayamela"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సింహాల బోనులో పడిన వేళలో",
        "ప్రార్ధన చేయగా కాపాడినావు",
        "మండే మంటలలో పడిన వేళలో",
        "నీవే తోడుగా మాతో ఉన్నావు"
      ],
      "english": [
        "Simhaala bonulo padina velalo",
        "Praardhana cheyagaa kaapaadinaavu",
        "Mande mantalalo padina velalo",
        "Neeve thodugaa maatho unnaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కూలిన బ్రతుకులు కట్టే వాడవు",
        "ఎతైన కోటగా నాకై ఉన్నావు",
        "కట్టిన కట్లను తెంపే వాడవు",
        "ఉన్నవాడా నీవే మాతో ఉన్నావు"
      ],
      "english": [
        "Koolina brathukulu katte vaadavu",
        "Etthaina kotagaa naakai unnaavu",
        "Kattina katlanu thempe vaadavu",
        "Unnavaadaa neeve maatho unnaavu"
      ]
    }
  ]
}
