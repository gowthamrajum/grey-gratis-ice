  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తిండికోసము జ్యేష్టత్వమును అమ్ముకున్నాడు ఏశావు",
        "వెండికోసము శిష్యత్వమును అమ్ముకున్నాడు ఆ యూదా",
        "ఎవరికోసం క్రైస్తవ్యమును అమ్ముకుంటాము మనము",
        "ఏశావులా భ్రష్టులౌతాము యూదాల పడి చస్తాము  ||తెలియక||"
      ],
      "english": [
        "Thindikosamu jyeshtathvamunu ammukunnaadu Eshaavu",
        "Vendikosamu shishyathvamunu ammukunnaadu aa Yoodaa",
        "Evarikosam kraisthavyamunu ammukuntaamu manamu",
        "Eshaavulaa bhrashtulauthaamu Yoodhaala padi chasthaamu  ||Theliyaka||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పదవి కోసము ప్రభువు యేసును",
        "అమ్ముకొంటారా ఓటు నోటుకు ?",
        "ఆస్తులకోసం ప్రభువు క్రీస్తును అమ్ముకొంటారా పార్టీ కోర్టుకు ?",
        "దేవుని పాలన మనిషి పాలనగా మారితే మనము చీలిపోతాము",
        "దేవుని ఇల్లు మనిషి ఇల్లుగా మారితే కూలి కాలిపోతాము",
        "తెలిసీ తెలిసీ సిలువను వేస్తే",
        "క్షమించేదెవరు? ప్రార్థించేది ఎవరు ?"
      ],
      "english": [
        "Padhavi kosamu Prabhuvu Yesunu",
        "Ammukontaaraa otu notuku ?",
        "Aasthulakosam Prabhuvu Kreesthunu ammukontaaraa paartee kortuku ?",
        "Devuni paalana manishi paalanagaa maarithe manamu cheelipothaamu",
        "Devuni illu manishi illugaa maarithe kooli kaalipothaamu",
        "Thelisee thelisee siluvanu vesthe",
        "Kshaminchedhevaru? praarthinchedhi evaru ?"
