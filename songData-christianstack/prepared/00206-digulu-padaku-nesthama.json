{
  "song_name": "Digulu Padaku Nesthama",
  "author": {
    "Authored by": "Sister Lakshmi Kumari",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దిగులు పడకు నేస్తమా",
      "యేసు నీతో ఉన్నాడు",
      "సందేహం పడకు ప్రాణమా",
      "నీకు తోడు ఉంటాడు"
    ],
    "english": [
      "Dhigulu padaku nesthamaa",
      "Yesu neetho unnaadu",
      "sandheham padaku praanamaa",
      "neeku thodu untaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏదైనా ఏ క్షణమైనా యేసునాథుని తలంచుమా!",
        "ఏదైనా ఏ స్థితియైనా ఆదరించును గ్రహించుమా!"
      ],
      "english": [
        "Edainaa ey kshanamainaa Yesunaadhuni thalanchumaa!",
        "Edainaa ey sthithiyainaa aadharinchunu grahinchumaa!"
      ]
    },
    {
      "stanza_number": 2,
