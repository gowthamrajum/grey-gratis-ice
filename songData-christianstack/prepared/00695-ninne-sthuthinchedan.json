{
  "song_name": "Ninne Sthuthinchedan",
  "author": {
    "Authored by": "Merlyn Salvadi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నేను ఓడిపోయినా నిన్నే స్తుతించెదన్",
      "నేను లోయలోనున్నా నిన్నే స్తుతించెదన్",
      "నేను నిలబడలేకున్నా నిన్నే స్తుతించెదన్",
      "నేను గాయముతోనున్నా నిన్నే స్తుతించెదన్"
    ],
    "english": [
      "Nenu odipoyinaa ninne sthuthinchedan",
      "nenu loyalonunnaa ninne sthuthinchedan",
      "nenu nilabadalekunnaa ninne sthuthinchedhan",
      "nenu gaayamuthonunnaa ninne sthuthinchedhan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా యేసయ్యా నీకై మొరపెట్టుచు",
        "నా భారము నీపై వేయుచు",
        "నా జీవితం నీవు సరిచేయుచు",
        "ప్రతి బాధను తొలగించుచు"
      ],
      "english": [
        "Naa yesayyaa neekai morapettuchu",
        "naa bhaaramu neepai veyuchu",
        "naa jeevitham neevu saricheyuchu",
        "prathi baadhanu tholaginchuchu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా నీరీక్షణ నీవే",
        "నా అండయు నీవే",
        "నా ఆశ్రయము నీవే",
        "నా సర్వము నీవే"
      ],
      "english": [
        "Naa nireekshana neeve",
        "naa andayu neeve",
        "naa aashrayamu neeve",
        "naa sarvamu neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేను కరువులోనున్నా నిన్నే స్తుతించెదన్",
        "నేను వ్యాధితోనున్నా నిన్నే స్తుతించెదన్",
        "సహాయము లేకున్న నిన్నే స్తుతించెదన్",
        "నన్ను నువ్వు వెలివేసినా నిన్నే స్తుతించెదన్"
      ],
      "english": [
        "Nenu karuvulonunnaa ninne sthuthinchedhan",
        "nenu vyaadhithonunnaa ninne sthuthinchedhan",
        "sahaayamu lekunna ninne sthuthinchedhan",
        "nannu nuvvu velivesinaa ninne sthuthinchedhan"
      ]
    }
  ]
}
