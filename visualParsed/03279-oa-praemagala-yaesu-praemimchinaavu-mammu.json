    "english": [
      "O premagala Yesu - Preminchinaavu mammu",
      "Smarinchuchu sthuthinthun - Rakshana nichchinaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అద్భుత యాగమందు - అందరికై బలియై",
        "అందరి పాపములకు - ప్రాయశ్చిత్తమైతివి"
      ],
      "english": [
        "Adbhutha yaagamandhu - Andarikai baliyai",
        "Andari paapamulaku - Praayashchitthamaithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దాసులమై మేముండ - మోషేను పంపితివి",
        "చేసితివి స్వతంత్రులుగా - నీ బాహుబలము తోడ"
