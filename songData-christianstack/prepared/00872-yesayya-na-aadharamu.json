{
  "song_name": "Yesayya Na Aadharamu",
  "author": {
    "Authored by": "Suresh Garugula",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసయ్య నీవే నాకు ఆధారము",
      "నీవు లేక నేను శూన్యమే"
    ],
    "english": [
      "Yesayya neeve naaku aadhaaramu",
      "neevu leka nenu soonyame"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపమును తొలగించి శాపమును తొలగించి",
        "నీ వాక్యపు వెలుగులో నడిపించితివి",
        "కలువరి సిలువలో వ్రేలాడితివి",
        "నా పాపమునకై మరణించితివి",
        "నా కన్నీటిని తుడిచి నా మొర నాలాకించి",
        "నీ రెక్కల చాటున నను దాచితివి",
        "పరిశుధాత్మను నాకిచ్చితివి",
        "నీ చిత్తముకై నను పిలిచితివి"
      ],
      "english": [
        "Paapamunu tholaginchi shaapamunu tholaginchi",
        "nee vaakyapu velugulo nadipinchithivi",
        "kaluvari siluvalo vrelaadithivi",
        "naa paapamunakai maraninchithivi",
        "Naa kanneetini thudichi na mora naalakinchi",
        "nee rekkala chaatuna nanu dhaachithivi",
        "parishuddhathmanu naakichithivi",
        "nee chitthamukai nanu pilichithivi"
      ]
    }
  ]
}
