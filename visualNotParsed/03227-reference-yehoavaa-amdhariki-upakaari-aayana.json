  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవయే దయాదాక్షిణ్యములు కలిగినవాడు",
        "దీర్ఘశాంతము కృపాతిశయము కలిగినవాడు",
        "యెహోవా అందరికిని మహోపకారుండు",
        "ఆయన కనికరమాయన పనులపై నున్నది"
      ],
      "english": [
        "Yehovaye dhayaadhaakshinyamulu kaliginavaadu",
        "Dheerghashaanthamu krupaathishayamu kaliginavaadu",
        "Yehova andharikini mahopakaarundu",
        "Aayana kanikaramaayana panulapai nunnadhi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కృతజ్ఞతాస్తుతులు చెల్లించుచున్నవి నీ క్రియలు",
        "నీ భక్తులందరు నిన్ను స్తుతించెదరు గాక"
      ],
      "english": [
        "Kruthagnathaasthuthulu chellinchuchunnavi nee kriyalu",
        "Nee bhakthulandharu ninnu sthuthinchedharu gaaka"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ భక్తులు నీ ప్రభావమును మానవులకు దెల్పెదరు",
        "నీ శౌర్యమునుగూర్చి నీ భక్తులు పల్కెదరు"
      ],
      "english": [
        "Nee bhakthulu nee prabhaavamunu maanavulaku dhelpedharu",
        "Nee shauryamunugoorchi nee bhakthulu palkedharu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీ రాజ్యము శాశ్వత రాజ్యమని తెల్పెదరు",
        "నీ రాజ్య పరిపాలన తరతరములు నిలుచును"
      ],
      "english": [
        "Nee raajyamu shaashwatha raajyamani thelpedharu",
        "Nee raajya paripaalana tharatharamulu niluchunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యెహోవా పడినవారినెల్ల నుద్ధరించును",
        "కృంగిపోయిన వారినెల్లర లేవనెత్తును"
      ],
      "english": [
        "Yehova padinavaarinella nudhdharinchunu",
        "Krungipoyina vaarinellara levanetthunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సర్వజీవుల కన్నులు నీవైపు చూచుచున్నవి",
        "తగినట్టి వేళ నీవు వారికి ఆహారమిత్తువు"
      ],
      "english": [
        "Sarvajeevula kannulu neevaipu choochuchunnavi",
        "Thaginatti vela neevu vaariki aahaaramitthuvu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యెహోవా దేవా నీ గుప్పిలిని నిత్యము విప్పి",
        "ప్రతి జీవి కోరిక నెల్లను తృప్తిపరచుచున్నావు"
      ],
      "english": [
        "Yehova Deva nee guppilini nithyamu vippi",
        "Prathi jeevi korika nellanu thrupthiparachuchunnaavu"
      ]
    }
  ]
}
