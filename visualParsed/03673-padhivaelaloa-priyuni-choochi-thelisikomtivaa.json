  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పదివేలలో ప్రియుని - చూచి తెలిసికొంటివా?",
        "నీ హృదయము పట్టుకొన్న - వాని కోరుకొనుము"
      ],
      "english": [
        "Padivelalo priyuni - Choochi thelisikontivaa?",
        "Nee hrudayamu pattukonna - Vaani korukonumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విగ్రహము లాకర్షంచెన్ - లోక యాశలు నిను",
        "పాప క్రియలు మెరయుచు - నిన్ను విడనాడవు"
      ],
      "english": [
        "Vigrahamul aakarshinchen - Loka yaashalu ninu",
        "Paapa kriyalu merayuchu - Ninnu vidanaadavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విగ్రహములకు దృష్టి - లేక లేదు అందము",
        "మంచి చెడ్డ తెలియదు - అందుచేత వ్యర్థము"
      ],
      "english": [
        "Vigrahamulaku drushti - Leka ledu andhamu",
        "Manchi chedda theliyadu - Andhuchetha vyarthamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వాని పగుల గొట్టుటచే - వాని నుండి తొల్గదు",
        "యేసు అందము కిరణ - మాయన హృదయమే"
      ],
      "english": [
        "Vaani pagula gottutache - Vaani nundi tholgadhu",
        "Yesu andhamu kirana - Maayana hrudayame"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వాని వత్తినార్పువాడు - ఎవరో తెలియునా?",
        "చలికాలమును వేస-విగ మార్చు ప్రభువే"
      ],
      "english": [
        "Vaani vatthinaarpuvaadu - Evaro theliyunaa?",
        "Chalikaalamunu vesa-viga maarchu Prabhuve"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పేతురును మార్చిన చూపు - స్తెఫన్ చూచిన ముఖము",
        "మరియతో నేడ్చిన హృదయం - మాత్రం ఆకర్షించెన్"
      ],
      "english": [
        "Pethurunu maarchina choopu - Sthephan choochina mukhamu",
        "Mariyatho nedchina hrudayam - Maathram aakarshinchen"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆకర్షించి నిండ చేయున్ - గిన్నెనిండ పొర్లగ",
        "విగ్రహములు మాకు వద్దు - యేసుతో మేముందుము"
      ],
      "english": [
        "Aakarshinchi ninda cheyun - Ginneninda porlaga",
        "Vigrahamulu maaku vaddu - Yesutho memundhumu"
      ]
    }
  ]
}
