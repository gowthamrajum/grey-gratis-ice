      "english": [
        "Prabhu yudhdhamu cheyu naayakudu",
        "Prabhu pakshamandhu cherumu eenaade",
        "Neevu pondedavu Beraakaalo - nijamugaa - jayamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పలువిధ శ్రమలందు చేరుమా",
