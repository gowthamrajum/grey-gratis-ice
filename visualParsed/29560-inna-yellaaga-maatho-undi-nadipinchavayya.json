{
  "song_name": "Innellugaa Maatho Undi Nadipinchavayyaa",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Sister Nissy Paul"
    ],
    "రచన": [
      "సిస్టర్ నిస్సీ పాల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఇన్నేళ్ళుగా మాతో ఉండి నడిపించవయ్యా..",
      "నీ బాహువు మాకు తోడుగా ఉంచి రక్షించావయ్యా",
      "నీ కృప చేత కీడుల నుండి తప్పించవయ్యా..",
      "ఎడబాయని నీ కృప మా యెడల చూపావేసయ్యా",
      "నీకే ఆరాధన చెల్లించెద యేసయ్య",
      "నీకే స్తోత్రార్పణ అర్పించెద యేసయ్య"
    ],
    "english": [
      "Innellugaa maatho undi nadipinchavayyaa..",
      "Nee baahuvu maaku thodugaa unchi rakshinchaavayyaa",
      "Nee krupa chetha keedula nundi thappinchavayyaa..",
      "Edabaayani nee krupa maa edala choopaavesayyaa",
      "Neeke aaraadhana chellinchedha Yesayya",
      "Neeke sthothraarpana arpinchedha Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ వాత్సల్యము చేత మమ్మును నడిపించావు..",
        "దినదినము నీ కృప చూపి నీలో భద్రపరిచావు",
        "ఏ తెగులైనా తాకనీయక సంరక్షించావు",
        "మా కన్నీటిని తుడిచి ఆదరణగ నిలిచావు",
        "నీకే ఆరాధన చెల్లించేద యేసయ్య",
        "నీకే స్తోత్రార్పణ అర్పించెద యేసయ్య"
      ],
      "english": [
        "Nee vaathsalyamu chetha mammunu nadipinchaavu..",
        "Dinadinamu nee krupa choopi neelo bhadraparichaavu",
        "E thegulainaa thaakaneeyaka samrakshinchaavu",
        "Maa kanneetini thudichi aadharanaga nilichaavu",
        "Neeke aaraadhana chellinchedha Yesayya",
        "Neeke sthothraarpana arpinchedha Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎన్ని యుగాలకైనా నీవే మా దైవము",
        "మా ఆయుష్కాలము వరకు నిన్నే పూజింతుము",
        "పరిశుద్ధుడా.. అతి పరిశుద్ధుడా.. మా ప్రభు యేసయ్య",
        "ఈ విశ్వములోనా నీకు సాటి లేనే లేదయ్యా",
        "నీకే ఆరాధన చెల్లించేద యేసయ్య",
        "నీకే స్తోత్రార్పణ అర్పించెద యేసయ్య"
      ],
      "english": [
        "Enni yugaalakainaa neeve maa daivamu",
        "Maa aayushkaalamu varaku ninne poojinthumu",
        "Parishuddhudaa.. athi parishuddhudaa.. maa Prabhu Yesayya",
        "Ee vishwamulonaa neeku saati lene ledayyaa",
        "Neeke aaraadhana chellinchedha Yesayya",
        "Neeke sthothraarpana arpinchedha Yesayya"
      ]
    }
  ]
}
