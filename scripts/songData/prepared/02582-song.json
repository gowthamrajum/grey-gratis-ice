{
  "song_name": "Dhaevuni Seeyoan Puramaa",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ న్యూటన్"
  },
  "main_stanza": {
    "telugu": [
      "దేవుని సీయోన్ పురమా! శ్రేష్టమౌ పట్టణమా!",
      "స్థావరంబైన పురమా! దేవుని నివాసమా!",
      "యుగముల శిలయైన దేవుడే నీ పునాదీ!",
      "శత్రువు జయించలేని రక్షణ నీ దుర్గము."
    ],
    "english": [
      "Dhaevuni Seeyoan Puramaa! Shraeshtamau Pattanamaa!",
      "Sthaavarambaina Puramaa! Dhaevuni Nivaasamaa!",
      "Yugamula Shilayaina Dhaevudae Nee Punaadhee!",
      "Shathruvu Jayinchalaeni Rakshana Nee Dhurgamu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కాంచుమా సజీవధారల్ శాశ్వత ప్రేమధారల్",
        "నీదు పుత్రికా పుత్రులన్ తృప్తిపర్చు ధారలన్",
        "అలసి సొలయకుండ దాహమున్ దీర్చుధార",
        "దాతయౌ దేవుని కృప సర్వకాలంబు పారున్"
      ],
      "english": [
        "Kaanchumaa Sajeevadhaaral Shaashvatha Praemadhaaral",
        "Needhu Puthrikaa Puthrulan Thrupthiparchu Dhaaralan",
        "Alasi Solayakunda Dhaahamun Dheerchudhaara",
        "Dhaathayau Dhaevuni Krupa Sarvakaalambu Paarun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కాంచుమా నీ యిండ్లమీద అగ్ని మేఘంబుల్దిగె",
        "ప్రభుని రాక సమయం బని మహిమ దెల్ప!",
        "ప్రార్థన ఫలంబులిచ్చి మన్నా నిచ్చిన ప్రభు",
        "సింహాసనాసీనుడై సు నాదుస్తోత్రంబుల్ వినెన్"
      ],
      "english": [
        "Kaanchumaa Nee Yindlameedha Agni Maeghambuldhige",
        "Prabhuni Raaka Samayam Bani Mahima Dhelpa!",
        "Praarthana Phalambulichchi Mannaa Nichchina Prabhu",
        "Simhaasanaaseenudai Su Naadhusthoathrambul Vinen"
      ]
    }
  ]
}
