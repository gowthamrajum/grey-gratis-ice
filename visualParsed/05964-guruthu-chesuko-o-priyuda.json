{
  "song_name": "Guruthu chesuko o priyudaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "గురుతు చేసుకో ఓ ప్రియుడా",
      "గుడిలో చేసిన ప్రమాణ సూత్రము",
      "మరిచిపోకుమా ఓ ప్రియతమా",
      "మెడలో కట్టిన ఆ మంగళసూత్రం",
      "తిరగబడితే క్రీస్తు కొరడా చెళ్ళమంటుందీ శుద్ధీకరణ"
    ],
    "english": [
      "Guruthu chesuko o priyudaa",
      "Gudilo chesina pramaana soothramu",
      "Marichipokumaa o priyathamaa",
      "Medalo kattina aa mangalasoothram",
      "Thiragabadithe Kreesthu koradaa chellamantundee shuddheekarana"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్వదేశీ సంసృతి మరిచి విదేశీ సంసృతి మరిగి",
        "ఆత్మీయతను అణచి అనురాగాన్ని విడచి",
        "పబ్ క్లబ్ల తైతక్కలాడి కాముకత్వము తలకెక్కి",
        "భార్యాభర్తల మార్పిడి చూడు",
        "కుటుంబ వ్యవస్థ దోపిడి నేడు"
      ],
      "english": [
        "Svadeshee samskruthi marichi videshee samskruthi marigi",
        "Aathmeeyathanu anachi anuraagaanni vidachi",
        "Pab klabla thaithakkalaadi kaamukathvamu thalakekki",
        "Bhaaryaabharthala maarpidi choodu",
        "Kutumba vyavastha dopidi nedu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సాటి సహాయము మరిచి సూటిపోటీగా పొడిచి",
        "భర్తను అనుమానించి పిల్లల భవితను విడిచి",
        "ఇంటి గుట్టును రట్టుగ చేసి భార్యనెదిరించి గడప దాటితే",
        "పెళ్ళి కాస్త పెటాకులై కొంప కొల్లేరౌతుంది"
      ],
      "english": [
        "Saati sahaayamu marichi sootipoteegaa podichi",
        "Bharthanu anumaaninchi pillala bhavithanu vidichi",
        "Inti guttunu rattuga chesi bhaaryanedirinchi gadapa daatithe",
        "Pelli kaastha petaakulai kompa kollerauthundi"
      ]
    }
  ]
}
