  },
  "main_stanza": {
    "telugu": [
      "మనము యేసు ప్రభుని మహిమ కనుగొంటిమి"
    ],
    "english": [
      "Manamu Yesu Prabhuni mahima kanugontimi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తండ్రినుండి కలిగిన ఏకైక పుత్రుని మహిమ",
        "వలె ఆయన మహిమను - కనుగొంటిమి"
      ],
      "english": [
        "Thandrinundi kaligina ekaika puthruni mahima",
        "Vale aayana mahimanu - Kanugontimi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీవు నమ్మిన యెడల - దేవుని మహిమ చూతువు",
        "జీవ పునరుత్థానము యేసు"
      ],
      "english": [
        "Neevu nammina edala - Devuni mahima choothuvu",
        "Jeeva punarutthaanamu Yesu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రత్యక్షగుడారమును - మేఘము కమ్మగానే",
        "యెహోవా తేజస్సు నిండెను"
      ],
      "english": [
        "Prathyakshagudaaramunu - Meghamu kammagaane",
        "Yehova thejassu nindenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దేవుని నివాసము - మనుజులతో నున్నది",
        "నివసించు - దేవుడే వారిలో"
      ],
      "english": [
        "Devuni nivaasamu - Manujulatho nunnadhi",
        "Nivasinchu - Devude vaarilo"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మహిమా ప్రభావముతో - మకుటము ధరించిన క్రీస్తు",
        "తనయులను తెచ్చె మహిమకు"
      ],
      "english": [
        "Mahimaa prabhaavamutho - Makutamu dharinchina Kreesthu",
        "Thanayulanu thechche mahimaku"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మన రక్షణ కర్తను శ్రమతో - సంపూర్ణుని జేయ",
        "మన తండ్రికే తగియున్నది"
      ],
      "english": [
        "Mana rakshana karthanu shramatho - Sampoornuni jeya",
        "Mana thandrike thagiyunnadhi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మన చులకని శ్రమలు - రాబోవు మహిమ యెదుట",
        "ఎన్నతగినవి కావు"
      ],
      "english": [
        "Mana chulakani shramalu - Raabovu mahima eduta",
        "Ennathaginavi kaavu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "పరిశుద్ధ పట్టణములో - దేవునికే మహిమ",
        "ప్రభువునకే మహిమ హల్లెలూయ"
      ],
      "english": [
        "Parishuddha pattanamulo - Devunike mahima",
        "Prabhuvunake mahima hallelooya"
      ]
    }
  ]
}
