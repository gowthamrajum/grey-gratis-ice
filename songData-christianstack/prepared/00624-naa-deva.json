{
  "song_name": "Naa Deva",
  "author": {
    "Authored by": "Sammy Thangiah, Derick Samuel, Samuel Joseph, Christy Zebulon, Hema Prasanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "[VERSE 1]",
      "ప్రార్ధనలు ఆలకించు దేవా",
      "మొరలన్ని వినువాడా",
      "నా పక్షమున పోరాడే దేవా",
      "జయమిచ్చి నడుపువాడా"
    ],
    "english": [
      "[VERSE 1]",
      "Praardhanalu aalakinchu deva",
      "moraalanni vinuvaada",
      "naa pakshamuna poraade deva",
      "jayamichi nadupuvaada"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "[CHORUS]",
        "నా దేవా నా దేవా",
        "ధ్వజమై నడుపువాడా",
        "నా దేవా నా దేవా",
        "విడుదల నొసగువాడా"
      ],
      "english": [
        "[CHORUS]",
        "Naa deva naa deva",
        "dhwajamai nadupuvaada",
        "naa deva naa deva",
        "vidudhala nosaguvaada"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "[VERSE 2]",
        "అలల్లెన్నో లేచినను",
        "అగ్నిలో నడచినను",
        "నీ కృపలో నను కాచితివి",
        "అద్భుతముగ మార్చితివి"
      ],
      "english": [
        "[VERSE 2]",
        "Alalenno lechinanu",
        "aagni lo nadachinanu",
        "nee krupalo nanu kaachithivi",
        "adbuthamuuga maarchithivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "[BRIDGE]",
        "మంచివాడా ఓ… మహోన్నతుడా",
        "మహిమాన్వితుడా మంచి చేయువాడా",
        "సర్వోన్నతుడా సర్వశక్తిమంతుడా",
        "నా దేవా నా దేవా"
      ],
      "english": [
        "[BRIDGE]",
        "Manchivada O… mahonnathudaa",
        "mahimanvithuda manchi cheyuvaada",
        "sarvonathuda sarva shakthimanthudaa",
        "naa deva naa deva"
      ]
    }
  ]
}
