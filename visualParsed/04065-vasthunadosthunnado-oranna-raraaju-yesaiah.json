{
  "song_name": "Vasthunnaadosthunnaado orannaa raaraaju Yesayyaa",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Rev G Samuel"
    ],
    "రచన": [
      "రెవరెండ్ జి శామ్యూల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "~: వస్తున్నాడొస్తున్నాడో ఓరన్నా రారాజు యేసయ్యా",
      "వస్తున్నాడూ, మన రక్శకుడేసయ్య వస్తున్నాడు"
    ],
    "english": [
      "~: Vasthunnaadosthunnaado orannaa raaraaju Yesayyaa",
      "Vasthunnaadoo, mana rakshakudesayya vasthunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గర్జించు సింహముల గగనాన్ని చీల్చుకొని",
        "కడభూర శబ్దముతో కదిలేను భువిపైకి",
        "ఇహలోక రాజ్యాలను ఎదిరంచ ప్రభుయేసు || వస్తున్నాడు ||"
      ],
      "english": [
        "Garjinchu simhamula gaganaanni cheelchukoni",
        "Kadaboora shabdamutho kadilenu bhuvipaiki",
        "Ihaloka raajyaalanu edirincha Prabhuyesu || Vasthunnaadu ||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కాలము సంపూర్ణమాయె ప్రభురాకడ సమయమాయె",
        "వ్యాధులన్నీ భాధలన్నీ వేదనకి సూచనాయె",
        "కరువులు భూకంపాలు ప్రభురాకడ గురుతులాయె || వస్తున్నాడు ||"
      ],
      "english": [
        "Kaalamu sampoornamaaye Prabhuraakada samayamaaye",
        "Vyaadhulannee baadhalannee vedhanaki soochanaaye",
        "Karuvulu bhookampaalu Prabhuraakada guruthulaaye || Vasthunnaadu ||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అన్యాయము పెరిగిపోయె అక్రమాలు విస్తరించె",
        "దొంగతనము దోపిడీలు దేశములో వాడుకాయే",
        "ప్రతివాడు పాపానికి భానిసై ప్రభునెరుగని కాలమాయె || వస్తున్నాడు ||"
      ],
      "english": [
        "Anyaayamu perigipoye akramaalu vistharinche",
        "Dongathanamu dopideelu deshamulo vaadukaaye",
        "Prathivaadu paapaaniki baanisai Prabhunerugani kaalamaaye || Vasthunnaadu ||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కంప్యుటరు కాలమాయె కరువులెరుగని రోజులాయె",
        "సెల్ ఫొను మోజులో చెడిపోయెను సోదరా",
        "బ్రతుకంత భారమాయె భాగుచేయు వాడు యెసు || వస్తున్నాడు ||"
      ],
      "english": [
        "Kampyutaru kaalamaaye karuvulerugani rojulaaye",
        "Sel phonu mojulo chedipoyenu sodaraa",
        "Brathukantha bhaaramaaye baagucheyu vaadu Yesu || Vasthunnaadu ||"
      ]
    }
  ]
}
