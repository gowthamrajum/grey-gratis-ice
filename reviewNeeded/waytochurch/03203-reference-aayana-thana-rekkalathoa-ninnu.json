{
  "song_name": "Aayana Thana Rekkalathoa Ninnu Kappunu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తన రెక్కల క్రింద ఆశ్రయము - తన రెక్కలతో కప్పును"
    ],
    "english": [
      "Thana Rekkala Krindha Aashrayamu - Thana Rekkalathoa Kappunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వోన్నతుని చాటున నివసించెడి వాడే",
        "సర్వశక్తుని నీడను విశ్రమించును పరమ ధన్యత యిదియే"
      ],
      "english": [
        "Sarvoannathuni Chaatuna Nivasinchedi Vaadae",
        "Sarvashakthuni Needanu Vishraminchunu Parama Dhanyatha Yidhiyae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆయనే నా ఆశ్రయము - నా కోటయు దుర్గమును",
        "ఆయన సత్యము నా కేడెమును నేనమ్ముకొను దేవుడు"
      ],
      "english": [
        "Aayanae Naa Aashrayamu - Naa Koatayu Dhurgamunu",
        "Aayana Sathyamu Naa Kaedemunu Naenammukonu Dhaevudu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పగటి బాణమున కైనా రాత్రి భయమున కైనా",
        "చీకటిలో తిరిగు తెగులుకైనా నేనేమి భయపడను"
      ],
      "english": [
        "Pagati Baanamuna Kainaa Raathri Bhayamuna Kainaa",
        "Cheekatiloa Thirigu Thegulukainaa Naenaemi Bhayapadanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేయి పదివేలు కుడిప్రక్కను కూలినను",
        "దయచూపు దేవుడు నీకుండ అపాయము రాదు"
      ],
      "english": [
        "Vaeyi Padhivaelu Kudiprakkanu Koolinanu",
        "Dhayachoopu Dhaevudu Neekunda Apaayamu Raadhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ ప్రభువాశ్రయమే యెహోవా నివాసం",
        "అపాయము తెగులు - నీ గుడారము సమీపించవు"
      ],
      "english": [
        "Nee Prabhuvaashrayamae Yehoavaa Nivaasam",
        "Apaayamu Thegulu - Nee Gudaaramu Sameepinchavu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీదు మార్గంబులలో - నిన్ను దూతలు కాయున్",
        "పాదములకు రాయి తగులకుండ నిన్నెత్తికొందురు"
      ],
      "english": [
        "Needhu Maargambulaloa - Ninnu Dhoothalu Kaayun",
        "Paadhamulaku Raayi Thagulakunda Ninneththikondhuru"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "కొదమ సింహముల నాగుపాముల నణచెదవు",
        "అతడు నా నామము నెరిగెను అతని తప్పించెదను"
      ],
      "english": [
        "Kodhama Simhamula Naagupaamula Nanachedhavu",
        "Athadu Naa Naamamu Nerigenu Athani Thappinchedhanu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "అతడు నను ప్రేమించెన్ - నామమున మొఱ్ఱపెట్టెన్",
        "అతని విడిపించి ఘనపరతున్ అతని కుత్తరమిత్తున్"
      ],
      "english": [
        "Athadu Nanu Praeminchen - Naamamuna Morrapetten",
        "Athani Vidipinchi Ghanaparathun Athani Kuththaramiththun"
      ]
    }
  ]
}
