{
  "song_name": "Aradhinchedhanu Athmatho",
  "author": {
    "Authored by": "Pastor Raj Prakash Paul",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆరాధించెదను ఆత్మతో నిరతము",
      "ఆరాధ్య దైవమా ప్రభుయేసుని",
      "ఆనంద గానమే మనసారా పాడుచు",
      "అనుదినము స్తోత్రింతు నా యేసుని"
    ],
    "english": [
      "Aaraadhinchedanu aatmathoa nirathamu",
      "aaraadhya daivamaa prabhu yesuni",
      "aananda gaanamey manasaaraa paaduchu",
      "anudhinamu stothrinthu naa yesuni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నరరూపధారుడు పాపరహితుడు",
        "మరణపు ముల్లును విరచిన విభుని",
        "భజియించు స్తోత్రించి ఆరాధించెదను",
        "అల్ఫా ఒమేగా నా యేసుడు",
        "హల్లెలూయా అనుచు అర్పింతును నా హృదిని",
        "భజియించి స్తోత్రించి మహిమపరచెదను",
        "ఆరాధించెద ప్రభుని ఆత్మ సత్యములన్",
        "అందరి ప్రభుడాయనే నా యేసుడు",
        "పరలోక రాజ్యమును ధరయందు స్థాపింప",
        "మహిమతో శ్రీ యేసు రాజ్యపాలన చేయగా",
        "వరదూత ఘనములతో సమకూడి మనమంతా",
        "స్తోత్రగీతములు పాడెదం మన రాజుకు"
      ],
      "english": [
        "Nararoopadhaarudu paaparahithudu",
        "maranapu mullunu virachina vibhuni",
        "bhajiyinchu stothrinchi aaraadhinchedanu",
        "alphaa omeagaa naa yesudu",
        "Halleluyaa anuchu arpinthunu naa hrudhini",
        "bhajiyinchi sthothrinchi mahima parachedanu",
        "aaraadhincheda prabhuni aathma sathyamulan",
        "andhari prabhudaayaney naa yesudu",
        "Paraloka raajyamunu dharayandhu sthaapimpa",
        "mahimatho sri yesu raajyapaalana cheyagaa",
        "varadhootha ganamulatho samakoodi manamanthaa",
        "sthothrageethamulu paadedham mana raajuku"
      ]
    }
  ]
}
