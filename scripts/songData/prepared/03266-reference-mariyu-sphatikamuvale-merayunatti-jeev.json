  "main_stanza": {
    "telugu": [
      "సర్వోన్నత స్థలంబులో - దేవునికే మహిమ",
      "సర్వాధికారి యేసుని సిలువచే కలిగెను",
      "సర్వోన్నతుండగు దేవుని - సేవకులై యుండియు",
      "సర్వోన్నతుని చిత్తంబున - సర్వదా స్తుతియించెదము"
    ],
    "english": [
      "Sarvoannatha SThalMbuloa - Dhaevunikae Mahim",
      "SarvaaDhikaari Yaesuni Siluvachae Kaligenu",
      "SarvoannathuMdagu Dhaevuni - Saevakulai YuMdiyu",
      "Sarvoannathuni ChiththMbuna - Sarvadhaa SthuthiyiMchedhamu"
    ]
  },
  "stanzas": [
    {
