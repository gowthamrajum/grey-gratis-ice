{
  "song_name": "Shatha koti raagaalu vallinchina",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "శత కోటి రాగాలు వల్లించిన",
      "నా యేసుకే నేను స్తుతి పాడనా",
      "దినమెల్ల ప్రభు సాక్ష్యమే చాటగా",
      "ఈ నూతన వత్సరాన అడుగు పెట్టిన – ఆనందించనా",
      "హ్యాపీ న్యూ ఇయర్ (2)",
      "మై విషెస్ టు ఆల్ హియర్ (2)",
      "నా కంటి పాపై నా ఇంటి వెలుగై",
      "నన్నాదరించాడు నా యేసుడే",
      "నా మంచి కోరి నా మేలు కోరి",
      "నను పెంచుతున్నాడు నా యేసుడే",
      "నా వల్ల ప్రభుకేమి ఒరిగేది లేదు (2)",
      "అయినా నను ప్రేమిస్తాడు",
      "కన్న తల్లిలా నను లాలిస్తాడు ||హ్యాపీ||"
    ],
    "english": [
      "Shatha koti raagaalu vallinchina",
      "Naa Yesuke nenu sthuthi paadanaa",
      "Dinamella Prabhu saakshyame chaatagaa",
      "Ee noothana vathsaraana adugu pettina – Aanandhinchanaa",
      "Hyaapee nyoo iyar (2)",
      "Mai vishes tu aal hiyar (2)",
      "Naa kanti paapai naa inti velugai",
      "Nannaadharinchaadu naa Yesude",
      "Naa manchi kori naa melu kori",
      "Nanu penchuthunnaadu naa Yesude",
      "Naa valla Prabhukemi origedhi ledu (2)",
      "Ayinaa nanu premisthaadu",
      "Kanna thallilaa nanu laalisthaadu ||Hyaapee||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ఆశ తానై – నా శ్వాస తానై",
        "నన్ను నడుపుతున్నాడు నా యేసుడే",
        "నాలోన యుక్తయి – నాలోన బలమై",
        "నను దరికి చేర్చాడు నా యేసుడే",
        "ఏమైనా నేనేమి ప్రభుకివ్వగలను (2)",
        "వరదలా దీవిస్తాడు",
        "కన్న తండ్రిలా నను మెప్పిస్తాడు ||హ్యాపీ||"
      ],
      "english": [
        "Naa aasha thaanai – Naa shwaasa thaanai",
        "Nannu naduputhunnaadu naa Yesude",
        "Naalona yukthiyai – Naalona balamai",
        "Nanu dariki cherchaadu naa Yesude",
        "Emainaa nenemi Prabhukivvagalanu (2)",
        "Varadhalaa dheevisthaadu",
        "Kanna thandrilaa nanu meppisthaadu ||Hyaapee||"
      ]
    }
  ]
}
