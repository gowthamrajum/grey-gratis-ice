{
  "song_name": "Reference: Nee dhevudaina Yehova neeku",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభు క్రీస్తేసు నీకే మా స్తుతులు",
      "విభుడా మాదు స్తుతులే - నీ హారములు"
    ],
    "english": [
      "Prabhu Kreesthesu neeke maa sthuthulu",
      "Vibhudaa maadu sthuthule - Nee haaramulu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ దేవుండైనట్టి నేను - నీకు నిత్యం - తోడై యున్నాను",
        "నీకేమియు తక్కువకా - దన్న ప్రియుడా"
      ],
      "english": [
        "Nee dhevundainatti nenu - Neeku nithyam - Thodai yunnaanu",
        "Neekemiyu thakkuvakaa - Dhanna priyudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మునుపటికంటె - అధికంబైన - మేలును మీకు - కలుగ జేసెదను",
        "అని ప్రోత్సాహించిన మా - క్రీస్తు ప్రభువా"
      ],
      "english": [
        "Munupatikante - Adhikambaina - Melunu meeku - Kaluga jesedanu",
        "Ani prothsaahinchina maa - Kreesthu prabhuvaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విస్తార వెండి బంగారం - ఎంతో ఉన్నది - పని ప్రారంభించి",
        "మందిరమును కట్టించు - మనిన ప్రభువా"
      ],
      "english": [
        "Visthaara vendi bangaaram - Entho unnadi - Pani praarambhinchi",
        "Mandhiramunu kattinchu - Manina prabhuvaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా సంఘమును - నే కట్టెదను - నాతో మీరు - జత పనివారనిన",
        "వింతైన మా ప్రధాన - శిల్పి క్రీస్తు"
      ],
      "english": [
        "Naa sanghamunu - Ne kattedhanu - Naatho meeru - Jatha panivaaranina",
        "Vinthaina maa pradhaana - Shilpi Kreesthu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పర్వతముల - నెక్కి మీరు - మ్రానులందెచ్చి - నా మందిరమును",
        "నిర్మించిన సంతోషింతుననిన"
      ],
      "english": [
        "Parvathamula - Nekki meeru - Mraanulandhechchi - Naa mandhiramunu",
        "Nirminchina santhoshinthunanina"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సంధ్యారాగ - చంద్రబింబం - సూర్యకాంతి - కళలన్ మెరిసేటి",
        "సంఘముగా మమ్ముల రూ-పించెదనన్న"
      ],
      "english": [
        "Sandhyaaraaga - Chandhrabimbam - Sooryakaanthi - Kalalan meriseti",
        "Sanghamugaa mammula roo-pinchedhananna"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆ దివ్య భాగ్యమా - కెపుడో - వింతైన నీ రాకడ నాశించి",
        "వేచి యున్నామిలలో - ప్రాణ ప్రియుడా"
      ],
      "english": [
        "Aa divya bhaagyamaa - Kepudo - Vinthaina nee raakada naashinchi",
        "Vechi yunnaamilalo - Praana priyudaa"
      ]
    }
  ]
}
