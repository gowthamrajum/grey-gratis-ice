{
  "song_name": "Dorakunu Samasthamu",
  "author": {
    "Authored by": "Ch Solmon Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దొరకును సమస్తము యేసు పాదాల చెంత",
      "వెదకిన దొరుకును యేసు పాదాల చెంత",
      "యేసయ్యా.. యేసయ్యా… నీకసాధ్యమైనది లేనే లేదయ్యా",
      "యేసయ్యా… యేసయ్యా… నీకు సమస్తము సాధ్యమేనయ్యా"
    ],
    "english": [
      "Dorakunu samasthamu yesu paadhaala chentha",
      "vedhakina dorukunu yesu paadhala chentha",
      "yesayya.. yesayya.. neekasaadhyamainadhi lene ledhayya",
      "yesayya.. yesayya.. neeku samasthamu saadhyamenayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మగ్దలేనే మరియ యేసు పాదాలను చేరి",
        "కన్నీళ్లతో కడిగి తల వెంట్రుకలతో తుడిచి",
        "పాదాలను ముద్దు పెట్టుకొని – పూసెను విలువైన అత్తరు",
        "చేసెను శ్రేష్టారాధన – దొరికెను పాప క్షమాపణ",
        "యాయీరు అను అధికారి యేసు పాదాలను చేరి",
        "బ్రతిమాలుకొనెను తన పన్నెండేళ్ల కుమార్తెకి",
        "చిన్నదాన లెమ్మని చెప్పి – బ్రతికించెను యేసు దేవుడు",
        "కలిగెను మహదానందం – దొరికెను రక్షణ భాగ్యము",
        "పత్మాసు ద్వీపమున యోహాను యేసుని చూచి",
        "పాదాలపై పడెను పరవశుడై యుండెను",
        "పరలోక దర్శనం – చూచెను తానే స్వయముగా",
        "దొరికెను ప్రభు ముఖ దర్శనం – దొరికెను ఇల మహా భాగ్యం"
      ],
      "english": [
        "Magdalene mariyu yesu paadhaalanu cheri",
        "kanneellatho kadigi thala ventrukalatho thudichi",
        "paadhaalanu muddhu pettukoni – poosenu viluvaina atharu",
        "chesenu sreshtaaradhana – dorikenu paapa kshamaapana",
        "Yaayeeru anu adhikaari yesu paadhaalanu cheri",
        "brathimaalukonenu thana pannendela kumaartheki",
        "chinnadhaana lemmani cheppi – brathikinchenu yesu dhevudu",
        "kaligenu mahaadhaanandham – dhorikenu rakshana bhaagyam",
        "Pathmaasu dweepamuna Yohanu yesuni choochi",
        "paadhaalapai padenu paravasudai yundenu",
        "paraloka dharsanam – choochenu thaane swayamugaa",
        "dhorikenu prabhu mukha dharsanam – dhorikenu ila mahaa bhaagyam"
      ]
    }
  ]
}
