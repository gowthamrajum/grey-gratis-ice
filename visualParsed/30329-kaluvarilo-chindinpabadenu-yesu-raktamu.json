  "main_stanza": {
    "telugu": [
      "కోరస్:-",
      "కలువరిలో చిందింపబడెను - యేసు రక్తము ప్రభు యేసు రక్తము",
      "మనకోసమే చిందింపబడెను - యేసు రక్తము ప్రభు యేసు రక్తము",
      "రక్తమే యేసు రక్తమే - రక్తమే యేసు రక్తమే",
      "యేసు రక్తము ప్రభు యేసు రక్తము (2) ||కలువరిలో ||"
    ],
    "english": [
      "Chorus:-",
      "Kaluvarilo chindhimpabadenu - Yesu rakthamu prabhu Yesu rakthamu",
      "Manakosame chindhimpabadenu - Yesu rakthamu prabhu Yesu rakthamu",
      "Rakthame Yesu rakthame - Rakthame Yesu rakthame",
      "Yesu rakthamu prabhu Yesu rakthamu (2) ||Kaluvarilo ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
