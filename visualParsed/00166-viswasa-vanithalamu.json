  "main_stanza": {
    "telugu": [
      "విశ్వాస వనితలము - ప్రభు యేసు ముద్రికలం (2)",
      "ప్రకటించెదం, ప్రార్ధించెదం, స్తుతియించెదం - ప్రభుకై నిలిచెదము",
      "హోసన్నా మహిమ నీకే - యేసన్నా ఘనత నీకే",
      "(2)"
    ],
    "english": [
      "Viswaasa vanithalamu - Prabhu Yesu mudhrikalam (2)",
      "Prakatinchedham, praardhinchedam, sthuthiyinchedham - Prabhukai nilichedhamu",
      "Hosannaa mahima neeke - Yesannaa ghanatha neeke",
      "(2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సాటియైన సహాయముగా - మము సృస్టించాడు",
        "మేటియైన ప్రభు కార్యముకై - మము నిలిపాడు",
        "చురుకుదనం మా ప్రత్యేకత - ఆతిద్యమే మా నైజం",
        "అమ్మగా, ఆలిగా, బలశాలిగా - మము దీవించాడు",
        "హోసన్నా మహిమ నీకే - యేసన్నా ఘనత నీకే (2)  ||విశ్వాస||"
      ],
      "english": [
        "Saatiyaina sahaayamugaa - Mamu srushtinchaadu",
        "Metiyaina Prabhu kaaryamukai - Mamu nilipaadu",
        "Churukudhanam maa prathyekatha - Aathithyame maa naijam",
        "Ammagaa, aaligaa, balashaaligaa - Mamu dheevinchaadu",
        "Hosannaa mahima neeke - Yesannaa ghanatha neeke (2)  ||Viswaasa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభుయేసు పునఃరుర్థానం - ప్రకటించింది మేమే (2)",
        "అత్తరు తైలముతో - అభిశేకించింది మేమే",
        "ప్రేమ గుణం, త్యాగ గుణం, సుగుణ సుగంధం - మాలో నింపాడు",
        "జాలిగా, ప్రేమగా, మేలుగా - మము దీవించాడు",
        "హోసన్నా మహిమ నీకే - యేసన్నా ఘనత నీకే (2)  ||విశ్వాస||"
      ],
      "english": [
        "Prabhu Yesu punarutthaanam - Prakatinchindhi meme (2)",
        "Attharu thailamutho - Abhishekinchindhi meme",
        "Prema gunam, thyaaga gunam, suguna sugandham - Maalo nimpaadu",
        "Jaaligaa, premagaa, melugaa - Mamu dheevinchaadu",
        "Hosannaa mahima neeke - Yesannaa ghanatha neeke (2)  ||Viswaasa||"
      ]
    }
  ]
