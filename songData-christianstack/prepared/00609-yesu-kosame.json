{
  "song_name": "Yesu Kosame",
  "author": {
    "Authored by": "Joel Kodali",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు కోసమే జీవిద్దాం యేసుతోనే పయనిద్దాం",
      "యేసుని పోలి నడిచే సాక్షులం",
      "యేసు విలువలు కలిగుందాం యేసు పిలుపునకు లోబడదాం",
      "లోకములో యేసుని ప్రతినిధులం",
      "శోధనలెదురైనా అవరోధములెన్నున్న",
      "విశ్వాసములో నిలకడగా నిలిచుందాం కడవరకు",
      "ఈ జీవిత యాత్రలో లోతులు కనబడినా",
      "లోబడకుందుము లోకముకు ఏ సమయములోనైనా"
    ],
    "english": [
      "Yesu kosame jeeviddham yesuthone payaniddham",
      "yesuni poli nadiche saakshulam",
      "yesu viluvalu kaligundhaam yesu pilipunaku lobadadhaam",
      "lokamulo yesuni prathinidhulam",
      "shodhanaledhurainaa avarodhamulennunna",
      "viswaasamulo nilakadagaa nilichundhaam kadavaraku",
      "ee jeevitha yaatralo lothulu kanabadinaa",
      "lobadakundhumu lokamuku ey samayamulonainaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిందారహితులుగా జీవించుట మన పిలుపు",
        "నీతియు పరిశుద్ధతయు ప్రభు కోరే అర్పణలు",
        "యదార్ధవంతులుగా ఒక మంచి సాక్ష్యము",
        "లోకమునకు కనపరచుటయు దేవుని పరిచర్యే",
        "ప్రేమయు సహనము యేసుని హృదయము",
        "కలిగుండుటకు పోరాడెదం ఆశతో అనుదినము",
        "యేసు స్వభామును ధరించిన వారలము",
        "మరణం గెలిచిన క్రీస్తుని ప్రకటించే శిష్యులము",
        "సంకటములు ఎదురైనా అవి అడ్డుగా నిలిచినను",
        "రోశముగల విశ్వాసముతో ఆగకనే సాగెదము",
        "రాజులు జనములు యేసుని చూచెదరు",
        "విశ్వాసులు విశ్వాసములో స్థిరముగా ఉన్నపుడు"
      ],
      "english": [
        "Nidhaarahithulugaa jeevinchuta mana pilupu",
        "neethiyu parishuddhathayu prabhu kore arpanalu",
        "yadhaardhavanthulugaa oka manchi saakshyamu",
        "lokamunaku kanaparachutayu dhevuni paricharye",
        "premayu sahanamu yesuni hrudhayamu",
        "kaligundutaku poraadedham aasatho anudhinamu",
        "Yesu swabaavamunu dharinchina vaaralamu",
        "maranam gelichina kreesthuni prakatinche sishyulamu",
        "sankatamulu edhurainaa avi addugaa nilichinanu",
        "roshamugala viswaasamutho aagakane saagedhamu",
        "raajulu janamulu yesuni choochedharu",
        "viswaasulu viswaasamulo sthiramugaa unnappudu"
      ]
    }
  ]
}
