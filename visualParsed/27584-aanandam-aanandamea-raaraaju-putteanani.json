      ],
      "english": [
        "Doothalu vachchiri – Vaarthanu thechchiri",
        "Gollalu vachchiri – Naatyamaadiree",
        "Gnaanulu vachchiri – Aaraadhinchiri",
        "Yese rakshakudani – Chaati cheppiri  ||Aanandam||"
