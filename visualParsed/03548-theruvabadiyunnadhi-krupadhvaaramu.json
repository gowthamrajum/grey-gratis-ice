  },
  "main_stanza": {
    "telugu": [
      "తెరువబడియున్నది కృపద్వారము",
      "త్వరపడి రమ్మని పిలిచె నేసు"
    ],
    "english": [
      "Theruvabadiyunnadhi krupadhwaaramu",
      "Thvarapadi rammani piliche nesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎవరును నశియింప వలదని",
        "ఓరిమి ప్రభువు వహియించును",
        "మారు మనస్సును పొందు సమయమిదే",
        "మక్కువతో ప్రభువు పిలుచుచున్నాడు"
      ],
      "english": [
        "Evarunu nashiyimpa valadani",
        "Orimi prabhuvu vahiyinchunu",
        "Maaru manassunu pondu samayamide",
        "Makkuvatho prabhuvu piluchuchunnaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ద్వారము తెరువబడియుండగా",
        "దయచూపి నిన్ను రమ్మనె ప్రభువు",
        "దీనిని నీవు అంగీకరించిన",
        "దేవుని దీవెనలు పొందెదవు"
      ],
      "english": [
        "Dwaaramu theruvabadiyundagaa",
        "Dhayachoopi ninnu rammane prabhuvu",
        "Dheenini neevu angeekarinchina",
        "Devuni deevenalu pondedavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రాత్రి గడచిపోయి పగలాయెను",
        "అతిక్రమములను వీడుమనె ప్రభు",
        "నీతి సూర్యుండు ఉదయించును",
        "భీతిని విడచి సిద్ధపడుము"
      ],
      "english": [
        "Raathri gadachipoyi pagalaayenu",
        "Athikramamulanu veedumane prabhu",
        "Neethi sooryundu udhayinchunu",
        "Bheethini vidachi sidhdhapadumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అర్థ రాత్రి వేళ గొప్ప సందడాయెను",
        "అదిగో పెండ్లి కుమారుండు వచ్చెననియు",
        "సిద్ధముగా నున్నవారే వెళ్ళెదరుగా",
        "ఆ ద్వారము మూయబడు త్వరపడుమా"
      ],
      "english": [
        "Ardha raathri vela goppa sandadaayenu",
        "Adigo pendli kumaarundu vachchenaniyu",
        "Sidhdhamugaa nunnavaare velledharugaa",
        "Aa dwaaramu mooyabadu thwarapadumaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వెళ్ళగోరియున్న సిద్ధపడవలెను",
        "యెసు రక్తమందు శుద్ధకావలెను",
        "ఘనముగ మీరు ప్రవేశింపవలెను",
        "మన తండ్రి యొక్క పూర్ణ సంకల్పమిదే"
      ],
      "english": [
        "Vellagoriyunna sidhdhapadavalenu",
        "Yesu rakthamandu shudhdhakaavalenu",
        "Ghanamuga meeru praveshimpavalenu",
        "Mana thandri yokka poorna sankalpamidhe"
      ]
    }
  ]
}
