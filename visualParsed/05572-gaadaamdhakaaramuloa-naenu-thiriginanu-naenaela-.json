  "main_stanza": {
    "telugu": [
      "గాఢాంధకారములో నేను తిరిగినను",
      "నేనేల భయపడదూ - నా యేసు",
      "నాతోడుండగా ||గాడాం||"
    ],
    "english": [
      "Gaadaandhakaaramulo nenu thiriginanu",
      "Nenela bhayapadadhoo - Naa Yesu",
      "Naathodundagaa ||Gaadaam||"
