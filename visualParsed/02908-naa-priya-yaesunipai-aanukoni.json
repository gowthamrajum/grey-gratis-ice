{
  "song_name": "Naa priya Yesunipai aanukoni",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రియ యేసునిపై ఆనుకొని అరణ్య మార్గమున",
      "నడుచుటయే ఆనంద జీవితము ||నా||"
    ],
    "english": [
      "Naa priya Yesunipai aanukoni aranya maargamuna",
      "Naduchutaye aananda jeevithamu ||Naa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లిల్లిపుష్పం షారోనురోజ పరిశుద్ధమైన మాదు తండ్రి",
        "పూర్ణరూప సౌందర్యుడే కీర్తింపతగిన దేవ  ||నా||"
      ],
      "english": [
        "Lillipushpam shaaronuroja parishuddhamaina maadu thandri",
        "Poornaroopa saundharyude keerthiMpathagina Deva  ||Naa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కన్యకలు ప్రేమించుదేవ నా ప్రభునామము పరిమళమే",
        "యేసుని వెనుక వచ్చితిమి నన్ను ఆకర్షించెను  ||నా||"
      ],
      "english": [
        "Kanyakalu premiMchudheva naa Prabhunaamamu parimalame",
        "Yesuni venuka vachchithimi nannu aakarshiMchenu  ||Naa||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమధ్వజ మెగురుచుండగ ప్రియునిసముఖము కలుగుటచే",
        "జల్దరు వృక్షము క్రింద కలిగెను ప్రియుని ఆదరణ  ||నా||"
      ],
      "english": [
        "Premadhvaja meguruchuNdaga priyunisamukhamu kaluguthache",
        "Jaldaru vrukshamu kriMdha kaligenu priyuni aadarana  ||Naa||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నిద్రించు రాత్రిసమయమునందు నిత్యం నా ఆత్మ మేలుకొని",
        "నా తలుపు నొద్ద నిలచిన యేసుని ప్రేమించెదన్  ||నా||"
      ],
      "english": [
        "NidhriMchu raathrisamayamunaMdhu nithyam naa aathma melukoni",
        "Naa thalupu nodda nilachina Yesuni premiMchedhan  ||Naa||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అగ్నిజ్వాల యేసుని ప్రేమ మరణమువలె బలవంతమైనది",
        "నీటి ప్రవాహమువలన ఆప్రేమ చల్లారదు  ||నా||"
      ],
      "english": [
        "Agnijvaala Yesuni prema maranamuvale balavanthamainadhi",
        "Neethi pravaahamuvalana aaprema challaaradhu  ||Naa||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దీనస్థంభము వలె దిగివచ్చును దేవకుమారుడు మహిమతో",
        "ఘనులైన వారి రథమువలె పై కెగిరిపోదును  ||నా||"
      ],
      "english": [
        "Dheenasthambhamu vale dhigivachchunu Dhevakumaarudu mahimatho",
        "Ghanulaina vaari rathamuvale pai kegiripodhunu  ||Naa||"
      ]
    }
  ]
}
