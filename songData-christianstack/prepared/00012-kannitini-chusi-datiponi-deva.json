{
  "song_name": "Kannitini Chusi Datiponi Deva",
  "author": {
    "Authored by": "Paul Alexander",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కన్నీటిని చూచి దాటిపోని దేవా",
      "నా ఎదుటే నిలిచితివే నలిగిన సమయాన",
      "నీ హస్తముతో నన్ను తాకుదువు రావా",
      "ప్రార్థనలో నీకొరకు ఎదురుచూస్తూ ఉన్నా"
    ],
    "english": [
      "Kanneetini joochi daatiponi Devaa",
      "Naa edute nilichitive naligina samayaana",
      "Nee hastamuto nannu taakuduvu raavaa",
      "Praarthanalo neekoraku eduruchoostoo unnaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు కుమారుడా నన్ను కరుణించవా",
        "ఎనెనో మార్లు నేను త్రోవ తప్పిపోయితిని",
        "తప్పిపోయిన నన్ను నీ వాక్యముతో పిలిచి",
        "నా కన్నీటిని నీవు నాట్యముగా మార్చితివి"
      ],
      "english": [
        "Daaveedu kumaarudaa nannu karuninchavaa",
        "Enno maarlu nenu trova tappipoyitini",
        "Tappipoyina nannu nee vaakyamuto pilichi",
        "Naa kanneetini neevu naatyamugaa maarchitivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యాకోబు బావి కాడ ఎవరూ లేని సమయములో",
        "నీరు త్రాగెదనని వచ్చిన ఆ తరుణములో",
        "నీవే నా జీవజలపు ఊటగా మారినావు",
        "ఎండిన నా జీవితము సెలయేరుగా మార్చావు"
      ],
      "english": [
        "Yaakobu baavi kaada evaroo leni samayamulo",
        "Neeru traagedanani vacchina aa tarunamulo",
        "Neeve naa jeevajalapu ootagaa maarinaavu",
        "Endina naa jeevitamu selayerugaa maarchaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా పైన ఎందరో రాళ్లు రువువరున్న",
        "నీ దయలో నన్ను దాచి ఉంచావు",
        "నీవే రాకుండి ఉంటే",
        "ఇప్పటికి నా బ్రతుకు",
        "ఏమై ఉండునో ఊహించలేను"
      ],
      "english": [
        "Naa paina endaro raallu ruvvuvAru nna",
        "Nee dayalo nannu daachi unchaavu",
        "Neeve raakundi unte",
        "Ippatiki naa bratuku",
        "Emai unduno oohinchalenu"
      ]
    }
  ]
}
