{
  "song_name": "Maaku jnaanahrudhayamu kalugunatlugaa cheyumu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవా తరతరములకు మాని-వాస స్థలము నీవే"
    ],
    "english": [
      "Deva tharatharamulaku maani-vaasa sthalamu neeve"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా దోషములను నీవు నీ యెదుట - నుంచుకొని యున్నావు",
        "నీ ముఖకాంతిలో మా రహస్య పా-పములు కనబడుచున్నవి"
      ],
      "english": [
        "Maa doshamulanu neevu nee eduta - Nunchukoni yunnaavu",
        "Nee mukhakaanthilo maa rahasya paa-pamulu kanabaduchunnavi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మా దినములన్ని గడిపితిమి - నీ యుగ్రత భరించుచు",
        "నిట్టూర్పులు విడచినట్లు మా జీ-వితము జరుపుకొందుము"
      ],
      "english": [
        "Maa dinamulanni gadipithimi - Nee yugratha bharinchuchu",
        "Nittoorpulu vidachinatlu maa jee-vithamu jarupukondhumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "డెబ్బది సంవత్సరములేగా - మాదు ఆయుష్కాలము",
        "అధిక బలమున్న యెడల యెనుబది - సంవత్సరములగును"
      ],
      "english": [
        "Debbadhi samvathsaramulegaa - Maadu aayushkaalamu",
        "Adhika balamunna edala enubadhi - Samvathsaramulagunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అయినను వాటి వైభవమంత - ఆయాసమే దుఃఖమే",
        "అది త్వరగా గతించును మే-మెగిరి పోయెదము"
      ],
      "english": [
        "Ayinanu vaati vaibhavamantha - Aayaasame dhuhkhame",
        "Adhi thvaragaa gathinchunu me-megiri poyedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీకే జెందవలసినట్టి భయము - కొలది పుట్టినట్టి",
        "నీదు ఆగ్రహ క్రోధ బలము - ఎవ్వరికి తెలియున్"
      ],
      "english": [
        "Neeke jendhavalasinatti bhayamu - Koladi puttinatti",
        "Needu aagraha krodha balamu - Evvariki theliyun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మాకు నీ జ్ఞాన హృదయమును - కలుగునట్లు చేయుము",
        "మాదినములు లెక్కించుటకు - మాకు నీవే నేర్పుము"
      ],
      "english": [
        "Maaku nee jnaana hrudayamunu - Kalugunatlu cheyumu",
        "Maadinamulu lekkinchutaku - Maaku neeve nerpumu"
      ]
    }
  ]
}
