{
  "song_name": "Kalvariloni shreshtudaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కల్వరిలోని శ్రేష్టుడా - కరుణా భరిత సింహమా",
      "కన్ను భ్రమించు ప్రభువా - నిలువలోని మిత్రుడా"
    ],
    "english": [
      "Kalvariloni shreshtudaa - Karunaa bharitha simhamaa",
      "Kannu bhraminchu prabhuvaa - Siluvaloni mithrudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతుకి పాత్రుండగువాడా - దూతలతో వెంచేయువాడా",
        "సుదతి మరియ పుత్రుడా - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Sthuthiki paathrundaguvaadaa - Doothalatho vencheyuvaadaa",
        "Sudhathi Mariya puthrudaa - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపులకై వచ్చినవాడా - ప్రేమ గల్గిన రక్షకుడా",
        "పాదములపై బడితిమి - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Paapulakai vachchinavaadaa - Prema galgina rakshakudaa",
        "Paadhamulapai badithimi - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దీవెనల నిచ్చుటకై - వసుధ కేతించినవాడా",
        "నీవే సుంకరు లాప్తుడవు - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Dheevenala nichchutakai - Vasudha kethinchinavaadaa",
        "Neeve sunkaru laapthudavu - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అయిదు రొట్టెలు మరి రెండు - చేపలతో నైదు వేల",
        "జనుల పోషించిన తండ్రి - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Ayidhu rottelu mari rendu - Chepalatho naidhu vela",
        "Janula poshinchina thandri - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీళ్ళను రసముగ మార్చితివి - నీళ్ళ మీద నడిచితివి",
        "మేళ్ళ నొసగు మా దాతా - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Neellanu rasamuga maarchithivi - Neella meeda nadichithivi",
        "Mella nosagu maa dhaathaa - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "రోగుల బాగుచేయువాడా - గ్రుడ్డికి నేత్రము లిచ్చితివి",
        "అనాధుల నాయకుడా - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Rogula baagucheyuvaadaa - Gruddiki nethramu lichchithivi",
        "Anaadhula naayakudaa - Siluvaloni mithrudaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయా కర్హుడా - యెల్లరు కొనియాడు వాడా",
        "బలముతో వచ్చువాడా - సిలువలోని మిత్రుడా"
      ],
      "english": [
        "Hallelooyaa arhudaa - Ellaru koniyaadu vaadaa",
        "Balamutho vachchuvaadaa - Siluvaloni mithrudaa"
      ]
    }
  ]
}
