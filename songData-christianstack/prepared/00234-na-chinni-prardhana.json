{
  "song_name": "Na Chinni Prardhana",
  "author": {
    "Authored by": "Samy Pachigalla",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా చిన్ని ప్రార్థనలు – నా చిన్ని కోరికలు",
      "ఆలకించి ఒక్కొకటి తీర్చావు",
      "అడిగిన వాటికంటే – ఊహించిన దానికంటే"
    ],
    "english": [
      "Naa chinni praarthanalu – naa chinni korikalu",
      "Aalakinchi okkokati theerchaavu…",
      "Adigina vaatikaante – oohinchina daanikaante…"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అధికముగా నన్ను దీవించవయ్యా…",
        "వర్ణింపలేని సంతోషాన్ని చావయ్యా…"
      ],
      "english": [
        "Adhikamuga nannu deevinchavayya…",
        "Varnimpaleni santhoshannichaavayya…"
      ]
    }
  ]
}
