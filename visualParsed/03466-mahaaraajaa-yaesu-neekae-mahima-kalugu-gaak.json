  "main_stanza": {
    "telugu": [
      "మహారాజా యేసు నీకే మహిమ కలుగు గాక",
      "ఘనత ప్రభావము నీదే నిత్యరాజ్యము నీదే"
    ],
    "english": [
      "Mahaaraajaa Yesu neeke mahima kalugu gaaka",
      "Ghanatha prabhaavamu neede nithyaraajyamu neede"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కన్యగర్భమున జన్మించ సంకల్పించుకొన్నావే",
        "పాపమెల్ల నాశము చేయ పాపి రూపము దాల్చితివే"
      ],
      "english": [
        "Kanyagarbhamuna janmincha sankalpinchukonnaave",
        "Paapamella naashamu cheya paapi roopamu dhaalchithive"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సిలువశ్రమలను సహించి మరణము రుచించితివే",
        "ప్రాణము పెట్టి మము రక్షించి తండ్రిని తృప్తిపరచితివే"
      ],
      "english": [
        "Siluvashramalanu sahinchi maranamu ruchinchithive",
        "Praanamu petti mamu rakshinchi thandrini thrupthiparachithive"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాప మరణ నరకమునుండి రక్షింప సంకల్పించి",
        "త్రియేక దేవునితో జేర్చ చెడుగు తీసి వేసితివే"
      ],
      "english": [
        "Paapa marana narakamunundi rakshimpa sankalpinchi",
        "Thriyeka Devunitho jercha chedugu theesi vesithive"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపీ దేవునిచే మారు మనస్సును పొందుమా",
        "ఆత్మానుగ్రహ కాలమున వచ్చి రక్షణ పొందుమా"
      ],
      "english": [
        "Paapee Dhevuniche maaru manassunu pondumaa",
        "Aathmaanugraha kaalamuna vachchi rakshana pondumaa"
      ]
    }
  ]
