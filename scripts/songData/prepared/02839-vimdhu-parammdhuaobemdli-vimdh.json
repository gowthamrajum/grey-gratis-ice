  },
  "main_stanza": {
    "telugu": [
      "విందు పరమందుఁబెండ్లి విందు",
      "పరమందుఁ బొందు జనుల డెందములా నందము నొందు"
    ],
    "english": [
      "Vindhu Paramandhubendli Vindhu",
      "Paramandhu Bondhu Janula Dendhamulaa Nandhamu Nondhu"
