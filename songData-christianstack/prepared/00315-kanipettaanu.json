{
  "song_name": "Kanipettaanu",
  "author": {
    "Authored by": "John Erry & Noah Gibson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ కొరకే మొరపెట్టాను",
      "నా ప్రార్ధన వినవా",
      "నీవైపే కనులెత్తాను",
      "సహాయకుడా",
      "కావలివారు ఉదయమును కనిపెట్టు నట్టు",
      "నే కనిపెట్టు చున్నాను"
    ],
    "english": [
      "Nee korake morapettaanu",
      "naa praardhana vinavaa",
      "neevaipey kanulethaanu",
      "sahaayakudaa",
      "kaavalivaaru udhayamunu kanipettu nattu",
      "ne kanipettu chunnaanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కొరకే కనిపెట్టాను",
        "నా ప్రియుడా యేసయ్యా",
        "నీ మాటే ఆధారము ఆశించెదను",
        "నీ కృపయే దొరకును",
        "విమోచన పొందెదను",
        "నివసించెదను యేసయ్యా"
      ],
      "english": [
        "Nee korake kanipettaanu",
        "naa priyudaa yesayyaa",
        "nee maatey aadhaaramu aasinchedhanu",
        "nee krpaye dhorakunu",
        "vimochana pondhedhanu",
        "nivasinchedhanu yesayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కృతజ్ఞత స్తుతులు చెల్లించుడి",
        "కృప నిరంతరం నాపై ఉండును"
      ],
      "english": [
        "Kruthagnatha sthuthulu chellinchudi",
        "krupa nirantaram naapai undunu"
      ]
    }
  ]
}
