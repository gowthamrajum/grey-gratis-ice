        "కృపాసత్య సంపూర్ణుడవై మమ్ము వెదకి వచ్చితివి",
        "దేవత్వమునకు నీవే పరిపూర్ణ రూపము",
        "నీలోనే మాకు కనబడెను నిత్య మహిమము"
      ],
      "english": [
        "Sarva sampoornatha neelone nivasinchenu",
        "Krupaasathya sampoornudavai mammu vedaki vachchithivi",
        "Dhevathvamunaku neeve paripoorna roopamu",
        "Neelone maaku kanabadenu nithya mahimamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఒక్క అర్పణతో మమ్ము సంపూర్ణులుగా చేసితివి",
        "నీ రక్తముతో మా హృదయములను శుద్ధి చేసితివి",
        "శ్రేష్ఠమైన వరములన్నియు నీ నుండి కలుగును",
        "నీ కృపా ప్రవాహములో మేము జీవించుచున్నాము"
      ],
      "english": [
        "Okka arpanatho mammu sampoornulugaa chesithivi",
        "Nee rakthamutho maa hrudhayamulanu shuddhi chesithivi",
        "Shreshtamaina varamulanniyu nee nundi kalugunu",
        "Nee krupaa pravaahamulo memu jeevinchuchunnaamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విశ్వాసమందు సంపూర్ణ నిశ్చయముతో సాగుదుము",
        "నీవు చూపిన మార్గములో నిలిచియుండుదుము",
        "ముగింపు వరకు మమ్ము నిందారహితులుగా కాపాడుము",
        "నీ మహిమలో యేసయ్యా సంపూర్ణులముగా నిలుపుము",
        "​[బ్రిడ్జ్ - అనుబంధం]"
