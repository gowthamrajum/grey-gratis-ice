  "main_stanza": {
    "telugu": [
      "నా తండ్రీ నిను నేను మరువలేను",
      "యేసయ్య నా చేయి పట్టి నడుపయ్య",
      "నాకెవ్వరు లేరు ఇలలో నీవే నా ఆశ్రయం"
    ],
    "english": [
      "Naa thandree ninu nenu maruvalenu",
      "Yesayya naa cheyi patti nadupayya",
      "Naakevvaru leru ilalo neeve naa aashrayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
