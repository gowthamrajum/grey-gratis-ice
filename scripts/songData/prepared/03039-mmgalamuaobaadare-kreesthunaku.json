{
  "song_name": "Mangalamu Baadare Kreesthunaku",
  "author": {
    "Authored by": "",
    "రచన": "పురుషోత్తము చౌధరి"
  },
  "main_stanza": {
    "telugu": [
      "మంగళముఁబాడరె క్రీస్తునకు జయ మంగళముఁబాడరె",
      "యో ప్రియులారా మంగళముఁ బాడరెర్",
      "మంగళముఁ బాడి దు స్సంగతిని వీడి",
      "ప్రభు సంగులను గూడి మదిఁ బొంగుచుఁ జెలంగుచును"
    ],
    "english": [
      "Mangalamubaadare Kreesthunaku Jaya Mangalamubaadare",
      "Yoa Priyulaaraa Mangalamu Baadarer",
      "Mangalamu Baadi Dhu Ssangathini Veedi",
      "Prabhu Sangulanu Goodi Madhi Bonguchu Jelanguchunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజులకు రాజని దూతలచేత పూజఁగొనువాఁడని",
        "తేజమున సూర్యునికి దీప్తి నిడు సద్గుణ వి రాజితుని",
        "సాధుజన రక్షకుని పక్షముగ"
      ],
      "english": [
        "Raajulaku Raajani Dhoothalachaetha Poojagonuvaadani",
        "Thaejamuna Sooryuniki Dheepthi Nidu Sadhguna Vi Raajithuni",
        "Saadhujana Rakshakuni Pakshamuga"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కరుణ గల వాఁడని పాపులఁబ్రోచు బిరుదుగొనినాఁడని",
        "మరణమును దానిఁ బరి మార్చు ఘన శక్తిగల",
        "పరమ గురుఁడితఁదె మన పాలి వాఁడని శుభ"
      ],
      "english": [
        "Karuna Gala Vaadani Paapulabroachu Birudhugoninaadani",
        "Maranamunu Dhaani Bari Maarchu Ghana Shakthigala",
        "Parama Gurudithadhe Mana Paali Vaadani Shubha"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సంగీతము పాడుచు సువార్త ప్ర సంగములఁ గూడుచు",
        "నింగికిని భూమికిని నిత్యముగ నేలఁ దగు",
        "శృంగారపు రాజునకు క్షేమ మగు ఆమేనిని"
      ],
      "english": [
        "Sangeethamu Paaduchu Suvaartha Pra Sangamula Gooduchu",
        "Ningikini Bhoomikini Nithyamuga Naela Dhagu",
        "Shrungaarapu Raajunaku Kshaema Magu Aamaenini"
      ]
    }
  ]
}
