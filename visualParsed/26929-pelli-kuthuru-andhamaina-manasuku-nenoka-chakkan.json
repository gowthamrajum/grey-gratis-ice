{
  "song_name": "Pelli kuthuru - Andamayina manasuku nenoka chakkani roopam",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Sayaram Gattu"
    ],
    "రచన": [
      "బ్రదర్ సాయారం గట్టు"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అందమయిన మనసుకు - నేనొక చక్కని రూపం",
      "బుద్ధిమంతురాలు ఎస్తేరుకు - నిలువెత్తున ప్రతిరూపం || 2 ||"
    ],
    "english": [
      "Andamayina manasuku - Nenoka chakkani roopam",
      "Buddhimanthuraalu Estheruku - Niluvetthuna prathiroopam || 2 ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హద్దులెవి దాటి ఎరుగవు నా ఊహలు",
        "దేవుని పలుకులే నింపెను నా ఆశలు || 2  ||అందమయిన||"
      ],
      "english": [
        "Haddhulevi daati erugavu naa oohalu",
        "Devuni palukule nimpenu naa aashalu || 2  ||Andamayina||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఇస్సాకు వంటి వానితో నా మనువు సేయ వెదికేరు",
        "రిబ్కాను పోలిన నను చూసి సంబరాలు చేసేరు || 2 ||"
      ],
      "english": [
        "Issaaku vanti vaanitho naa manuvu seya vedikeru",
        "Ribkaanu polina nanu choosi sambaraalu cheseru || 2 ||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మెరుపులాగా సాగేటి పనితనమే నా ధనం",
        "రుతులాగా కలిసిపోవడం నాకున్న గుణం || 2  ||అందమయిన||"
      ],
      "english": [
        "Merupulaagaa saageti panithaname naa dhanam",
        "Roothulaagaa kalisipovadam naakunna gunam || 2  ||Andamayina||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శుద్ధమయిన మరియామ్మ లాగ బుద్దిగా పెరిగాను",
        "నీతిమంతుడయినా యోసేపు కై కాచుకొని ఉన్నాను || 2 ||"
      ],
      "english": [
        "Shuddhamayina Mariyaamma laaga buddhigaa perigaanu",
        "Neethimanthudayinaa Yosepu kai kaachukoni unnaanu || 2 ||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తండ్రి చిత్తమేదయినా పాటించుటకై సిద్దము",
        "పొందుకున్న మారు మనసే, నా అందము || 2  ||అందమయిన||"
      ],
      "english": [
        "Thandri chitthamedhayinaa paatinchutakai siddhamu",
        "Pondhukunna maaru manase, naa andamu || 2  ||Andamayina||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అమ్మ నాన్నల నుండి నేను, ప్రార్థన పలుకులు నేర్చాను",
        "నా తొడబుట్టిన వారి తోని, అనుబంధాలే ఎరిగాను || 2 ||"
      ],
      "english": [
        "Amma naannala nundi nenu, praarthana palukulu nerchaanu",
        "Naa thodabuttina vaari thoni, anubandhaale erigaanu || 2 ||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "క్రీస్తు సంఘమంత మాతో ఉన్న బంధు ఘనం",
        "కనాను పెండ్లిలో అద్భుతమే మాకున్న ధైర్యం || 2  ||అందమయిన||"
      ],
      "english": [
        "Kreesthu sanghamantha maatho unna bandhu ghanam",
        "Kanaanu pendlilo adbhuthame maakunna dhairyam || 2  ||Andamayina||"
      ]
    }
  ]
}
