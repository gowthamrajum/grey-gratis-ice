{
  "song_name": "Naalo Unna Yesayya",
  "author": {
    "Authored by": "Lawrence",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నాలో ఉన్నా యేసయ్యా",
      "నాతో ఉన్న స్నేహమా",
      "విడువని బంధమా మరువని స్నేహమా"
    ],
    "english": [
      "Naalo unna Yesayya",
      "Naatho unna snehama",
      "Viduvaani bandhama, maruvani snehama"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేషూవ"
      ],
      "english": [
        "Yeshuva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రుంగియున్న వేళ తోడైయున్నావు",
        "ఒంటరైనా వేళా నన్ను బలపరిచావు",
        "ఎవరు లేరు ఎవరు రారు",
        "నాతో ఉన్నావు ఎప్పటికి ఉంటావు"
      ],
      "english": [
        "Krungiyunna vela thodaiyunnaavu",
        "Ontaraina vela nannu balaparichaavu",
        "Evaru leru, evaru raaru",
        "Naatho unnaavu, eppatiki untaavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దారితొలగిన వేల సరిచేసియున్నవు",
        "నీ వాక్కుతో నన్ను బలపరాచియున్నావు",
        "కాలాలు మారిన ప్రేమలు మారిన",
        "ప్రభు ప్రేమ మారునా ఎన్నటికీ వీడునా"
      ],
      "english": [
        "Dhaaritholagina vela sarichesiyunnavu",
        "Nee vaakkutho nannu balaparachiyunnavu",
        "Kaalalu maarina, premalu maarina",
        "Prabhu prema maarunaa, ennatiki veedunaa"
      ]
    }
  ]
}
