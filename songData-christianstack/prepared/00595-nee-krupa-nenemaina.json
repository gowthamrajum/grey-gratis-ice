    "english": [
      "Nee krupa nenemainaa",
      "nee krupa naakemainaa",
      "nee krupa neetho unnaa",
      "nee krupa nenilaa unnaa",
      "aadharinchu dhaivam neevu immaanuyelu devaa",
      "aathmaabhisheka thailam naapai kuripinchavaa"
    ]
  },
  "stanzas": [
