    {
      "stanza_number": 3,
      "telugu": [
        "నీ కొరకే తెంచెనిల - ముక్తినిచ్చే యేసుప్రభు",
        "ఒప్పుకొను తప్పిదములన్"
      ],
      "english": [
        "Nee korake thenchenila - Mukthinichche Yesuprabhu",
        "Oppukonu thappidhamulan"
