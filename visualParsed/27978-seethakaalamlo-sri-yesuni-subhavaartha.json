  "main_stanza": {
    "telugu": [
      "శీతకాలంలో శ్రీ యేసుని శుభవార్త",
      "మహిమ స్వరూపుడు మానవ రూపిగా",
      "మరియకు సుతుడయ్యే నేడు",
      "లోకానికి రక్షకుడుదయించే",
      "ఓ ఓ ఓ ఓ",
      "ప్రతి గొంతు జో లాలి పాడే",
      "మనసులే ఉరకలేసిన వేళ",
      "మధుర తలపు సుధలే"
    ],
    "english": [
      "Sheethakaalamlo shree Yesuni shubhavaartha",
      "Mahima swaroopudu maanava roopigaa",
      "Mariyaku suthudayye nedu",
      "Lokaaniki rakshakududayinche",
      "O o o o",
      "Prathi gonthu jo laali paade",
      "Manasule urakalesina vela",
      "Madhura thalapu sudhale"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరము నుండి వచ్చినాడు మనలను రక్షించుటకు",
        "వేగిరపడుదామా ఓ సర్వ జనాంగమా",
        "నిజ రక్షకుని ఆరాధిస్తూ దీవెనలే పొందుదాం",
        "మదిలో యేసుని జన్మను తలచిన మనమే ధన్యులము",
        "లోకానికి రక్షకుడుదయించే",
        "ఓ ఓ ఓ ఓ",
        "శోకాలను తీర్చును ఈనాడే",
        "మనసులే ఉరకలేసిన వేళ",
        "మధుర తలపు సుధలే",
        "సంఘ సహవాసము కలిసి సువార్తకెల్లొద్దాం",
        "బంధు మిత్రులంతా కలిసి ఆలయానికెల్లొద్దాం",
        "కానుకలు అర్పిద్దాం మనసార ప్రార్ధిద్దాం",
        "మదిలో యేసుని స్మరనే నిత్యం",
        "అదియే ఆశీర్వాదం",
        "నీతి సూర్యుడుదయించేనండి",
        "ఓ ఓ ఓ ఓ",
        "నిజ క్రిస్మస్ పండుగ సందడి",
        "మనసులే ఉరకలేసిన వేళ",
        "మధుర తలపు సుధలే"
      ],
      "english": [
        "Paramu nundi vachchinaadu manalanu rakshinchutaku",
        "Vegirapadudaamaa o sarva janaangamaa",
        "Nija rakshakuni aaraadhisthoo dheevenale pondhudaam",
        "Madilo Yesuni janmanu thalachina maname dhanyulamu",
        "Lokaaniki rakshakududayinche",
        "O o o o",
        "Shokaalanu theerchunu eenaade",
        "Manasule urakalesina vela",
        "Madhura thalapu sudhale",
        "Sangha sahavaasamu kalisi suvaarthakellodhdhaam",
        "Bandhu mithrulanthaa kalisi aalayaanikellodhdhaam",
        "Kaanukalu arpidhdhaam manasaara praardhidhdhaam",
        "Madilo Yesuni smarane nithyam",
        "Adiye aasheervaadam",
        "Neethi sooryududayinchenandi",
        "O o o o",
        "Nija Krismas panduga sandadi",
        "Manasule urakalesina vela",
        "Madhura thalapu sudhale"
      ]
    }
  ]
