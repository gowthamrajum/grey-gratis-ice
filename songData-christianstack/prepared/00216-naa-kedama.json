{
  "song_name": "Naa Kedama",
  "author": {
    "Authored by": "Ps. Vijay Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా కేడెమా నా దుర్గమా",
      "నా యేసయ్యా నా రక్షకా",
      "నిన్నె ఘనపరతును నిన్నె ఆరాధింతును"
    ],
    "english": [
      "Naa kedema, naa dhurgama",
      "Naa Yesayya, naa rakshaka",
      "Ninne ghanaparathunu, ninne aaradhinthunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తల్లి గర్భమునుండి కాచిన దేవా",
        "నా తండ్రి నీవై బలపరచినావా",
        "నీ కార్యములు గంభీరములు",
        "నా కనులకే ఆశ్చర్యములు"
      ],
      "english": [
        "Talli garbhamunundi kaachina Dhevaa",
        "Naa thandri neevai balaparachinaavaa",
        "Nee kaaryamulu gambheeramulu",
        "Naa kanulake aascharyamulu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా శత్రువులు నను చుట్టగను",
        "నా నోరు నిన్నె స్తుతియింపగను",
        "యెరికో గోడలు కూలిపోయెగా",
        "శత్రు సైన్యము పారిపోయెగా"
      ],
      "english": [
        "Naa shathruvulu nanu chuttaganu",
        "Naa noru ninne sthuthiyimpaganu",
        "Yeriko godalu koolipoyega",
        "Shathru sainyamu paaripoyega"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరలోక మార్గము చూపిన దేవా",
        "నా నీతి రక్షణ నీవైనావా",
        "ఏ హృదయమైతే నీ వైపు తిరుగునో",
        "నూతన సృష్టిగా మార్చగలవు"
      ],
      "english": [
        "Paraloka maargamu choopina Devaa",
        "Naa neethi rakshana neevainaavaa",
        "Ye hrudayamaithe nee vaipu thiruguno",
        "Noothana srushtiga maarchagalavu"
      ]
    }
  ]
}
