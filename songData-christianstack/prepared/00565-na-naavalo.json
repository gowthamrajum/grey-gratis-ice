{
  "song_name": "Na Naavalo",
  "author": {
    "Authored by": "Pastor P Caleb",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా నావలో యేసు ఉండగా",
      "నాకు ఎందుకు భయము",
      "నాకు తోడుగా నా ప్రభువు ఉండగా",
      "నాకు ఎందుకు దిగులు",
      "హైలెస్సా హైలో హైలెస్సా",
      "హైలెస్సా హైలో హైలెస్సా"
    ],
    "english": [
      "Naa naavaloo yesu undagaa",
      "naaku enduku bhayamu",
      "naaku thoodugaa naa prabhuvu undagaa",
      "naaku enduku digulu",
      "hilessaa hilo hilessaa",
      "hilessaa hilo hilessaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అలలెన్నో లేచినను – భయపెట్టే తుఫానైనా",
        "అద్దరికి చేర్చును – నెమ్మది కలిగించును",
        "సమస్తము చేయగల సమర్థుడు నా ప్రభువు",
        "విడువను ఎడబాయనని వాగ్దానం చేసినాడు"
      ],
      "english": [
        "Alalennoo lechinanu bhayapette thuphaanina",
        "addariki cherchunu nemmadi kaliginchunu",
        "Samasthamu cheyaga samardhudu naa prabhuvu",
        "viduvanu edabaayanani vaagdaanam chesinaadu"
      ]
    }
  ]
}
