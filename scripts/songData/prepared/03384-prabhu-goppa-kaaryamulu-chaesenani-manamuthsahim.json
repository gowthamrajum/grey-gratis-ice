{
  "song_name": "Prabhu Goppa Kaaryamulu Chaesenani Manamuthsahimchedhamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రభు గొప్ప కార్యములు చేసెనని మనముత్సహించెదము",
      "ప్రభు గొప్ప మేలుల వర్షము మనపై కురిపించె నహా",
      "ఆహా స్తోత్రము స్తోత్రములు - ఇంతవరకు కాచె పాత్రులముగా సేవింతుము"
    ],
    "english": [
      "Prabhu Goppa Kaaryamulu Chaesenani Manamuthsahimchedhamu",
      "Prabhu Goppa Maelula Varshamu Manapai Kuripimche Nahaa",
      "Aahaa Sthoathramu Sthoathramulu - Imthavaraku Kaache Paathrulamugaa Saevimthumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవ కార్యములు జనముల మధ్య - ప్రసిద్ధి చేయుదము",
        "దేవుని ఆశ్చర్య కార్యము మనలో - ధ్యానించి పాదెదము"
      ],
      "english": [
        "Dhaiva Kaaryamulu Janamula Madhya - Prasidhdhi Chaeyudhamu",
        "Dhaevuni Aashcharya Kaaryamu Manaloa - Dhyaanimchi Paadhedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంగీత గానములతోను - సన్నుతించుచు ప్రభుని",
        "సితార స్వరమండలములతో - మన మార్భాటించెదము"
      ],
      "english": [
        "Samgeetha Gaanamulathoanu - Sannuthimchuchu Prabhuni",
        "Sithaara Svaramamdalamulathoa - Mana Maarbhaatimchedhamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన భారములన్నియు తొలగించె - ఘనకార్యములను జేసె",
        "దినమెల్ల పాడుచు ఘనపరచెదము - చాటించెద మిలలో"
      ],
      "english": [
        "Mana Bhaaramulanniyu Tholagimche - Ghanakaaryamulanu Jaese",
        "Dhinamella Paaduchu Ghanaparachedhamu - Chaatimchedha Milaloa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నూతన కార్యములు చేయువాడు - ప్రభు వాశ్చర్యకరుడు",
        "బలమగు కార్యములు చేయువాడాయనే ధైర్యముగా పాడెదం"
      ],
      "english": [
        "Noothana Kaaryamulu Chaeyuvaadu - Prabhu Vaashcharyakarudu",
        "Balamagu Kaaryamulu Chaeyuvaadaayanae Dhairyamugaa Paadedham"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమా సౌందర్యములు గలవాడు - క్షేమము నిచ్చువాడు",
        "మహిమైశ్వర్యములు గలవాడాయనే మహిని బొగడెదము"
      ],
      "english": [
        "Praemaa Saumdharyamulu Galavaadu - Kshaemamu Nichchuvaadu",
        "Mahimaishvaryamulu Galavaadaayanae Mahini Bogadedhamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మనకెన్నో వాగ్దానము లిచ్చె మన మనుభవించితిమి",
        "ఘనతా మహిమ ప్రభావము ప్రభునకే హల్లెలూయా ఆమెన్"
      ],
      "english": [
        "Manakennoa Vaagdhaanamu Lichche Mana Manubhavimchithimi",
        "Ghanathaa Mahima Prabhaavamu Prabhunakae Hallelooyaa Aamen"
      ]
    }
  ]
}
