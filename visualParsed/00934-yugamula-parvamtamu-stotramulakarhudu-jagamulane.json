  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆప్తుడు దేదీప్యుడు ఆపదలో సహాయుడు",
        "నుత్యుడు సత్యుడు సృష్టికి ఆధారుడు నా యేసుడు"
      ],
      "english": [
        "Aapthudu dhedheepyudu aapadalo sahaayudu",
        "Nuthyudu sathyudu srushtiki aadhaarudu naa Yesudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిరతము నా దుర్గము నాదు రక్షణ కేడెము",
        "కునుకడు నిద్రించడు ఎన్నడు ఎడబాయడు నా యేసుడు"
      ],
      "english": [
        "Nirathamu naa durgamu naadu rakshana kedemu",
        "Kunukadu nidhrinchadu ennadu edabaayadu naa Yesudu"
