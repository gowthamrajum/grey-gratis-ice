  "main_stanza": {
    "telugu": [
      "మేఘము మీద యేసురాజు వేగ మిలకువచ్చున్",
      "అను సిద్ధముగా నుండువారల జేర్చును శీఘ్రముగా దిగును"
    ],
    "english": [
      "Maeghamu Meedha Yaesuraaju Vaega Milakuvachchun",
      "Anu SidhDhamugaa NuMduvaarala Jaerchunu Sheeghramugaa Dhigunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభువు తానే ఆర్భాటముతో ఈ భువికి వచ్చున్",
        "ఇక్కడ నమ్మినవారలు ఎగురుచు ఈ భువి విడచెదరు"
