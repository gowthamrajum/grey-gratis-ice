{
  "song_name": "Pradhaana Yaajakaa",
  "author": {
    "Authored by": "Anne Deborah K Mohanty",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా యాజకా (2)"
    ],
    "english": [
      "Naa Yaajakaa (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రధాన యాజకా నా ప్రధాన యాజకా",
        "మార్పు లేని యాజకా నిత్య యాజకా",
        "అన్నిటికి సరిపోయిన గొప్ప యాజకా",
        "ప్రధాన యాజకా నా యేసు రాజా"
      ],
      "english": [
        "Pradhaana yaajakaa naa pradhaana yaajakaa",
        "maarpu leni yaajakaa nitya yaajakaa",
        "annitiki saripoyina goppa yaajakaa",
        "pradhaana yaajakaa naa yesu raajaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవునిచే పిల్వబడి సంపూర్ణ సిద్దిని పొంది",
        "షాలేము రాజా నా నీతి సమాదానమా",
        "విమోచన కర్తా నా పవిత్ర యాజకా",
        "ప్రధాన యాజకా నా యేసు రాజా"
      ],
      "english": [
        "Devuniche pilvabadi sampurna siddini pondi",
        "shalemu raaja na neethi samaadanama",
        "vimochana kartha na pavitra yaajakaa",
        "pradhaana yaajakaa naa yesu raajaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శరీరదారియై వచ్చి సజీవ యగమై నిలచి",
        "కన్నీటి ప్రార్దనలతో యాగములర్పించి",
        "అంగీకరింపబడిన ప్రధాన యాజకా",
        "నా విజ్ఞాపన కర్తా నా యేసునాధా"
      ],
      "english": [
        "Sariradariyai vacchi sajiva yagamai nilachi",
        "kanniti prardanalato yaagamularpinchi",
        "angikarimpabadina pradhaana yaajakaa",
        "naa vignaapana karta naa yesu naadhaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఒక్క బలి అర్పణచే పరిశుద్ద పరచి",
        "నీ రాజ్య వారసులుగా మమ్మును చేసితివే",
        "పరిపూర్ణ విశ్వాసముతో మమ్మును నింపితివే",
        "నా రక్షణ కర్తా నా యేసునాధా"
      ],
      "english": [
        "Okka bali arpanache parishuddaaparachi",
        "nee raajya vaarasuluga mammunu chesithive",
        "paripurna viswasamuto mammunu nimpitivey",
        "naa rakshana karta naa yesu naadhaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రధాన యాజకా నా ప్రధాన యాజకా",
        "మార్పు లేని యాజకా నిత్య యాజకా",
        "అన్నిటికి సరిపోయిన గొప్ప యాజకా",
        "ప్రధాన యాజకా నా యేసు రాజా"
      ],
      "english": [
        "Pradhaana yaajakaa naa pradhaana yaajakaa",
        "maarpu leni yaajakaa nithya yaajakaa",
        "annitiki saripoyina goppa yaajakaa",
        "pradhaana yaajakaa naa yesu raajaa"
      ]
    }
  ]
}
