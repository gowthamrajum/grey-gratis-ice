  "main_stanza": {
    "telugu": [
      "నాలో ఉన్నవాడు నాకై నిలచువాడు",
      "పరిశుద్ధుడు పరమాత్ముడు ప్రభుయేసు",
      "నాకై ఉన్నవాడు నను ప్రేమించువాడు",
      "అతిశ్రేష్టుడు బలవంతుడు నా యేసు"
    ],
    "english": [
      "Naalo unnavaadu naakai nilachuvaadu",
      "parishuddhudu paramaathmudu prabhuyesu",
      "naakai unnavaadu nanu preminchuvaadu",
      "athisreshtudu balavanthudu naa yesu"
    ]
  },
