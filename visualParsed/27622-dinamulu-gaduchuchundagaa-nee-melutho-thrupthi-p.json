{
  "song_name": "Dinamulu gaduchuchundagaa nee melutho thrupthi parachithivi",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Tony Bandela"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దినములు గడుచుచుండగా నీ మేలుతో తృప్తిపరచితివి",
      "జనములు చూచుచుండగా నీ వాగ్దానము నెరవేర్చితివి",
      "ఎల్షద్దాయ్ దేవుడా స్వరమెత్తి నిన్ను పాడెదన్",
      "ఎల్షద్దాయ్ దేవుడా స్వరమెత్తి నిన్ను పొగడెదను",
      "ఆరాధనా నీకై అలాపన",
      "స్తుతి అర్పణ నీకై నీరీక్షణ \\దినములు\\"
    ],
    "english": [
      "Dinamulu gaduchuchundagaa nee melutho thrupthiparachithivi",
      "Janamulu choochuchundagaa nee vaagdhaanamu neraverchithivi",
      "Elshaddaay Devudaa swarametthi ninnu paadedan",
      "Elshaddaay Devudaa swarametthi ninnu pogadedanu",
      "Aaraadhanaa neekai alaapana",
      "Sthuthi arpana neekai neereekshana \\Dinamulu\\"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యోగ్యత అర్హత లేని నన్ను ఎన్నుకొంటివి",
        "నీ సువార్తను చాటగా జీవవాక్కుతొ నింపితివి \\2\\",
        "నా కన్నీటిని నీదు బుడ్డిలో దాచుకొంటివి ప్రియ ప్రభువా",
        "చాటెదన్ నీ నామము నాలో ప్రాణమున్నంత వరకు \\అరాధనా\\"
      ],
      "english": [
        "Yogyatha arhatha leni nannu ennukontivi",
        "Nee suvaarthanu chaatagaa jeevavaakkutho nimpithivi \\2\\",
        "Naa kanneetini needu buddilo daachukontivi priya Prabhuvaa",
        "Chaatedan nee naamamu naalo praanamunnantha varaku \\Aaraadhanaa\\"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శాంతినీ సమృద్ధినీ క్షేమమును నొసగితివి",
        "దుష్టుని జయింప ఆత్మ శక్తితొ నింపితివి \\2\\",
        "బలహీనతలో బలమునిచ్చి ఆదుకొంటివి ప్రియ ప్రభువా",
        "అంతయు నీ దయా నీ కృపా దానమే \\అరాధనా\\"
      ],
      "english": [
        "Shaanthinee samruddhinee kshemamunu nosagithivi",
        "Dushtuni jayimpa aathma shakthitho nimpithivi \\2\\",
        "Balaheenathalo balamunichchi aadukontivi priya Prabhuvaa",
        "Anthayu nee dayaa nee krupaa dhaaname \\Aaraadhanaa\\"
      ]
    }
  ]
