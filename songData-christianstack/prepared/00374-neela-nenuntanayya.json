{
  "song_name": "Neela Nenuntanayya",
  "author": {
    "Authored by": "Pastor J Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీలా నేనుంటానయ్యా నాలో నీ వుంటేనయ్యా",
      "నిన్నే కలిగి నన్నే మరచిపోవాలి",
      "నా మరణం వరకు నీతోనే నడవాలి",
      "నీ నిత్యమహిమలో నీతో నిలచిపోవాలి"
    ],
    "english": [
      "Neelaa nenuntaanayyaa naalo nee vuntenayyaa",
      "ninne kaligi nanne marachipovaali",
      "naa marannam varaku neethone nadavaali",
      "nee nithyamahimalo neetho nilachipovaali"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అ.ప: యేసయ్యా యేసయ్యా ఇదే నాకున్న ధ్యాసయ్య",
        "యేసయ్యా యేసయ్యా ఇదే నాచివరి ఆశయ్య"
      ],
      "english": [
        "Yesayyaa yesayyaa idhe naakunna dhyaasayya",
        "yesayyaa yesayyaa ide naachivari aasayya"
      ]
    }
  ]
}
