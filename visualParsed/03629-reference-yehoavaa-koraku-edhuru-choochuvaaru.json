  "main_stanza": {
    "telugu": [
      "పరమతండ్రి కరములెత్తి - స్తుతుల నర్పింతుము",
      "శిరములెత్తి స్వామి నీకై చూచుచుంటిమి",
      "ఉజ్జీవ నాత్మ నొసగు నిలువ సజీవ సాక్షిగ"
    ],
    "english": [
      "Paramathandri karamuletthi - Sthuthula narpinthumu",
      "Shiramuleththi swaami neekai choochuchuntimi",
      "Ujjeeva naathma nosagu niluva sajeeva saakshiga"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాప శాపములందు మేము - పడి చెడి యుండగా",
        "దేవ మాదు దరికి జేరి - లేవ నెత్తితివి",
        "ఎంత జాలి ఎంత ప్రేమ - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Paapa shaapamulandhu memu - Padi chedi yundagaa",
        "Deva maadu dariki jeri - Leva neththithivi",
        "Entha jaali entha prema - Sthuthula narpinthumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దినదినము నిను శోధించి - దుఃఖ పెట్టితిమి",
        "కేవలము శరీరులమని - కనికరించితివి",
        "క్షమించి మమ్ము కడిగితివి - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Dinadinamu ninu shodhinchi - Dhuhkha pettithimi",
        "Kevalamu shareerulamani - Kanikarinchithivi",
        "Kshaminchi mammu kadigithivi - Sthuthula narpinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నింద వేదన శ్రమలు బహు - నిట్టూర్పులయందు",
        "విసుగకుండ సేవచేయ - నొసగు నోర్పును",
        "నింపు నీ శుద్ధాత్మతోను - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Ninda vedhana shramalu bahu - Nittoorpulayandhu",
        "Visugakunda sevacheya - Nosagu norpunu",
        "Nimpu nee shuddhaathmathonu - Sthuthula narpinthumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సూర్యచంద్ర తారలందు - వింత సూచనలు",
        "జరుగ జనులు ధైర్యము చెడి - కూలి చూచెదరు",
        "అయితే నీకై చూచు మేము - బలము నొందెదము"
