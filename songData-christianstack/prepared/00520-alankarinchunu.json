{
  "song_name": "Alankarinchunu",
  "author": {
    "Authored by": "John Jebaraj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతింపజేయునే నిన్ను అలంకరించునే",
      "కోల్పోయినదంతా పునరుద్ధరించునే"
    ],
    "english": [
      "Sthuthimpajeyune ninnu alankarinchune",
      "kolpoyinadhanthaa punaruddharinchune"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "F, 4/4"
      ],
      "english": [
        "Na manassaa aayana marachunaa",
        "devudu ninnu marachi povunaa",
        "aayane nee baadhalanni kanumarugu cheyune",
        "aanandha thailamu neepai kummarinchune"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా మనస్సా ఆయన మరచునా",
        "దేవుడు నిన్ను మరచి పోవునా",
        "ఆయనే నీ బాధలన్నీ కనుమరుగు చేయునే",
        "ఆనంద తైలము నీపై కుమ్మరించునే"
      ],
      "english": [
        "Nittoorpu shabdhamu vinna nee haddhulannitilo",
        "samruddhi gaanaalenno idhi modhalu vinabadune",
        "tharagiponu nenu anagaarchabadanu nenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
