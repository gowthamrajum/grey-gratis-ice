{
  "song_name": "Gowravimpajeyunu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గొప్ప జనముగా నిను చేయున్",
      "ఘనమగు పేరు నీకిచ్చున్",
      "తగిన కాలమున శీఘ్రముగా",
      "ఆయనే ఇది జరిగించున్"
    ],
    "english": [
      "Goppa janamugaa ninu cheyun",
      "ghanamagu peru neekicchun",
      "thagina kaalamuna sheeghramugaa",
      "aayane idhi jariginchun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసుని రూపం నీలో తెలియును",
        "క్రీస్తుని జీవం నిన్ను నిలుపును",
        "నా ప్రాణమా నీకు కలతెందుకే",
        "నీ శ్రమను ప్రభు చూచుచుండెనే"
      ],
      "english": [
        "Yesuni roopam neelo theliyunu",
        "kreesthuni jeevam ninnu nilupunu",
        "naa praanamaa neeku kalathendhuke",
        "nee shramanu prabhu choochuchundene"
      ]
    }
  ]
}
