  "main_stanza": {
    "telugu": [
      "సర్వోన్నత స్థలములలో సమాధానము",
      "ప్రాప్తించే ప్రజకొరకు ప్రభు జన్మముతోను"
    ],
    "english": [
      "Sarvonnatha sthalamulalo samadhanamu",
      "praapthinche prajakoraku prabhu janmamuthonu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హల్లెలూయ అర్పణలు ఉల్లముతో చెలింతుమ్",
        "రాజాధి రాజునకు హోసన్నా ప్రభువునకు"
      ],
      "english": [
        "Hallelujah arpanalu ullamutho chellinthum",
        "raajaadhi raajunaku hosanna prabhuvunaku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
