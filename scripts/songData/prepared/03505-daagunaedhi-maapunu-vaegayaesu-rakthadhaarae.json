{
  "song_name": "Daagunaedhi Maapunu Vaegayaesu Rakthadhaarae",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "హా దివ్య రక్తము - ఎంతో యమూల్యము",
      "నన్ శుద్ధిచేయును - యేసుయొక్క రక్తధారే"
    ],
    "english": [
      "Haa Dhivya Rakthamu - Emthoa Yamoolyamu",
      "Nan Shudhdhichaeyunu - Yaesuyokka Rakthadhaarae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "డాగునేది మాపును - వేగయేసు రక్తధారే",
        "రోగికే యౌషధము - బాగుగా నా రక్తధారే"
      ],
      "english": [
        "Daagunaedhi Maapunu - Vaegayaesu Rakthadhaarae",
        "Roagikae Yaushdhamu - Baagugaa Naa Rakthadhaarae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాప పరిహారము - ప్రాపు యేసురక్తధారే",
        "శాపపు సంహారము - స్వామి యేసు రక్తధారే"
      ],
      "english": [
        "Paapa Parihaaramu - Praapu Yaesurakthadhaarae",
        "Shaapapu Smhaaramu - Svaami Yaesu Rakthadhaarae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇదే నా సుపానము - యేసుయొక్క రక్తధారే",
        "నాదు క్షమాపణము - యేసుయొక్క రక్తధారే"
      ],
      "english": [
        "Idhae Naa Supaanamu - Yaesuyokka Rakthadhaarae",
        "Naadhu Kshmaapanamu - Yaesuyokka Rakthadhaarae"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాకు సమాధానము - యేసుయొక్క రక్తధారే",
        "నాకు జయగానము - యేసుయొక్క రక్తధారే"
      ],
      "english": [
        "Naaku Samaadhaanamu - Yaesuyokka Rakthadhaarae",
        "Naaku Jayagaanamu - Yaesuyokka Rakthadhaarae"
      ]
    }
  ]
}
