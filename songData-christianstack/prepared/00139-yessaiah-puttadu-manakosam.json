    {
      "stanza_number": 2,
      "telugu": [
        "పరమును విడిచి వచ్చాడయ్యా",
        "ఇహమందు యేసు రారాజుగా",
        "సంతోషం సమాధానము",
        "ఈ మహిలో మనకు ఇవ్వాలని"
      ],
      "english": [
        "Paramunu vidichi vacchaadayyaa",
        "Ihamandu Yesu raarajugaa",
        "Santhosham samaadhaanamu",
        "Ee mahilo manaku ivvaalani"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాప దోషములు తొలగించుటకు",
