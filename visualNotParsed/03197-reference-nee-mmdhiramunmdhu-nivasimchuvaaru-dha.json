  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సైన్యముల కధిపతివగు యెహోవా",
        "నీ నివాసములు ఎంతో రమ్యములు",
        "సైన్యముల యెహోవా"
      ],
      "english": [
        "Sainyamula kadhipathivagu Yehova",
        "Nee nivaasamulu entho ramyamulu",
        "Sainyamula Yehova"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవా మందిరము చూడవలెనని",
        "నా ప్రాణమెంతో ఆశతో సొమ్మసిల్లెను"
      ],
      "english": [
        "Yehova mandiramu choodavalenani",
        "Naa praanamentho aashatho sommasillenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవముగల దేవుని దర్శించ నా హృదయము",
        "నా శరీర మానంద కేక వేయుచున్నది"
      ],
      "english": [
        "Jeevamugala Devuni dharshincha naa hrudayamu",
        "Naa shareera maanandha keka veyuchunnadhi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సైన్యముల యెహోవా నా రాజా నీ బలి",
        "పీఠమునొద్దనే పిచ్చుకలకు గూళ్ళు దొరికెను"
      ],
      "english": [
        "Sainyamula Yehova naa raajaa nee bali",
        "Peethamunodhdhane pichchukalaku goollu dorikenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పిల్లలు పెట్టుటకు వానకోవెలకు",
        "గూటి స్థలము దొరికెను నా దేవా"
      ],
      "english": [
        "Pillalu pettutaku vaanakovelaku",
        "Gooti sthalamu dorikenu naa Deva"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ మందిరములో నుండువారు ధన్యులు",
        "వారు నిత్యము నిన్ను సన్నుతించెదరు"
      ],
      "english": [
        "Nee mandiramulo nunduvaaru dhanyulu",
        "Vaaru nithyamu ninnu sannuthinchedharu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీవలన బలము నొందు వారు ధన్యులు",
        "యాత్ర మార్గము లతి ప్రియములు వారికి"
      ],
      "english": [
        "Neevalana balamu nondhu vaaru dhanyulu",
        "Yaathra maargamu lathi priyamulu vaariki"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "వారు బాకా లోయలోబడి వెళ్లుచు",
        "దానిని జలమయముగా చేయుదురు"
      ],
      "english": [
        "Vaaru baakaa loyalobadi velluchu",
        "Dhaanini jalamayamugaa cheyudhuru"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "తొలకరి వాన దాని దీవెనలతో కప్పును",
        "వారు బలాభివృద్ధి నొందుచు వెళ్ళుదురు"
      ],
      "english": [
        "Tholakari vaana daani deevenalatho kappunu",
        "Vaaru balaabhivruddhi nondhuchu velludhuru"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "వారిలో ప్రతివాడు సీయోనులోని",
        "దేవుని సన్నిధిలో కనబడును"
      ],
      "english": [
        "Vaarilo prathivaadu Seeyonuloni",
        "Devuni sannidhilo kanabadunu"
      ]
    }
  ]
}
