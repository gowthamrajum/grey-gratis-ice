{
  "song_name": "Nee Sannidhilo",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ సన్నిధిలో ఆనందమే – నీ సేవలోనే సంతోషమే"
    ],
    "english": [
      "Nee sannidhilo aanandhamey – nee sevaloney santhoshamey"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతులందుకో స్తోత్రార్హుడా – పదివేలలో అతి సుందరుడా",
        "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
      ],
      "english": [
        "Sthuthulandhuko sthothraahudaa – padhivelalo athi sundharudaa",
        "karuninchumaa karunaamayaa – mahima ghanatha neekey devaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మా హృదయాలను నీ ఆలయముగా",
        "నీ ఆలయమే మా దాగు చోటుగా"
      ],
      "english": [
        "Maa hrudhayaalanu nee aalayamugaa",
        "nee aalayamey maa dhaagu chotugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ చిత్తము మాలో నెరవేరగా",
        "పరిపూర్ణమైన నీ ప్రేమ పొందగా"
      ],
      "english": [
        "nee chitthamu maalo neraveragaa",
        "paripoornamaina nee prema pondhagaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కృప చూపుము దేవా – దీవించు ప్రభువా",
        "నీ ఆత్మ శక్తితో నింపుము దేవా",
        "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
      ],
      "english": [
        "krupa choopumu deva – dheevinchu prabhuvaa",
        "nee aathma shakthitho nimpumu devaa",
        "karuninchumaa karunaamayaa – mahima ghanatha neekey devaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ మహిమార్థమే మా క్రియలన్నియు",
        "నీ కనికరములే మేలులన్నియు"
      ],
      "english": [
        "Nee mahimaardhamey maa kriyalanniyu",
        "nee kanikaramuley melulanniyu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "విశ్వాసముతో ప్రార్ధింప నేర్పుమా",
        "నీ వాక్య వెలుగులో దర్శించుమా"
      ],
      "english": [
        "viswaasamutho praardhimpa nerpumaa",
        "nee vaakya velugulo dharshinchumaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దరి చేర్చు ప్రభువా – పరలోక దేవా",
        "కడ వరకు మమ్ము నడిపించుమా",
        "కరుణించుమా కరుణామయా – మహిమ ఘనత నీకే దేవా"
      ],
      "english": [
        "dhari cherchu prabhuvaa – paraloka deva",
        "kada varaku mammu nadipinchumaa",
        "karuninchumaa karunaamayaa – mahima ghanatha neekey devaa"
      ]
    }
  ]
}
