{
  "song_name": "Na Pranam Neevenayya",
  "author": {
    "Authored by": "Bro.Philliph Prakash",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రాణం నీవేనయ్యా నా సర్వం నీవేనయ్యా",
      "నా దైవమా నా ధైర్యమా నా బంధూబలగం నీవెగా",
      "నా జీవమా నా మార్గమా నా త్రోవకు దీపం నీవెగా"
    ],
    "english": [
      "Pranam Neevenayya, Naa Sarvam Neevenayya",
      "Naa Dhaivama, Naa Dhairyama, Naa Bandhu Balagam Neevega",
      "Naa Jeevama, Naa Maargama, Naa Throvaku Dheepam Neevega"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నువు మాత్రం లేకుంటే మన్నుకుమన్నై పోదునూ",
        "నిన్నైనా నేడైనా రేపైనా ఎపుడైనా",
        "నీ కృపవలనే జీవిస్తున్నానయ్యా",
        "నీ స్నేహము పొందానూ",
        "నిన్నే స్మరియించానూ",
        "నే విన్నా నేనున్నా నీమనసే నే కన్నా",
        "అని పేరుపెట్టి పిలిచావయా"
      ],
      "english": [
        "Nuvu maathrame lekunte, manushulu mannai podhunu",
        "Ninnaina, nedaina, repaina, epudaina",
        "Nee krupavalane jeevisthunnanayya",
        "Nee snehamu pondhaanu",
        "Ninne smarinchaanu",
        "Ne vinna, nenunna, nee manase ne kannaa",
        "Ani peru petti pilichaavayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రతి నిమిషం నీవెంటే అడుగులో అడుగై నడిచెదనూ",
        "ఏమున్నా లేకున్నా కలిమైనా కరువైనా",
        "నివు వుంటే భయమేలేదయ్యా",
        "నా సర్వము విడిచానూ",
        "నిన్నే నమ్ముకున్నానూ",
        "చావైనా బ్రతుకైనా నీతోనే అనుకున్నా",
        "నను చేయిపట్టి నడిపించయ్యా"
      ],
      "english": [
        "Prathi nimisham nevente, adugulo adugai nadichedanu",
        "Emunna lekunna, kalimaina, karuvaina",
        "Neevu unte bhayame ledu ayyah",
        "Naa sarvamu vidichanu",
        "Ninne nammakunnanu",
        "Chaavaina bratukaina neetone anukunnanu",
        "Nanu cheyi patti nadipinchayya"
      ]
    }
  ]
}
