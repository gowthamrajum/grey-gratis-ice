      "ఈ బంధాన్ని నిత్యత్వము కొరకై పెనవేసుకున్న",
      "ఈ బంధాన్ని అనుబంధాన్ని"
    ],
    "english": [
      "Veru cheyajaalunaa dhoora paracha jaalunaa",
      "Nannu ninnu ninnu nannu",
      "Nithyamu korakai penavesukunna",
      "Ee bandhaanni nithyathvamu korakai penavesukunna",
      "Ee bandhaanni anubandhaanni"
    ]
  },
  "stanzas": [
    {
