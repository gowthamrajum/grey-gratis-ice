  "main_stanza": {
    "telugu": [
      "బెత్లహేములో వింత - రాజు పుట్టుక వార్త",
      "పరమును విడి వచ్చెను - పుడమికి వెలుగు తెచ్చెను",
      "ఆరంభం ఆరంభం - ఆనందం ఆనందం",
      "మనస్సు నిండెనే - సంతోషం పొంగేనే",
      "రజులరాజని యుదులరాజని ఉరువాడ వార్తని చాటిరి. ll బెత్ల ll"
    ],
    "english": [
      "Bethlahemulo vintha - Raaju puttuka vaartha",
      "Paramunu vidi vachchenu - Pudamiki velugu thechchenu",
      "Aarambham aarambham - Aanandam aanandam",
      "Manassu nindene - Santhosham pongene",
      "Raajularaajani yoodhularaajani ooruvaada vaarthani chaatiri. ||Bethla||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
