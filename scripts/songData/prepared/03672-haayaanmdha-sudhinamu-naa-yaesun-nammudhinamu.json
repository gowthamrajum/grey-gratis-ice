{
  "song_name": "Haayaanandha Sudhinamu Naa Yaesun Nammudhinamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "భాగ్యమౌ దినము - ప్రభున్ గైకొన్న దినము",
      "భక్తి ప్రార్థన లేసుడు - ప్రఖ్యాతి నాకు నేర్పిన",
      "భాగ్యమౌ దినము - ప్రభున్ గైకొన్న దినము"
    ],
    "english": [
      "Bhaagyamau Dhinamu - Prabhun Gaikonna Dhinamu",
      "Bhakthi Praarthana Laesudu - Prakhyaathi Naaku Naerpina",
      "Bhaagyamau Dhinamu - Prabhun Gaikonna Dhinamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హాయానంద సుదినము - నా యేసున్ నమ్ముదినము",
        "ప్రయాసమెల్ల బోయిన - దయారక్షణ్యదినము"
      ],
      "english": [
        "Haayaanandha Sudhinamu - Naa Yaesun Nammudhinamu",
        "Prayaasamella Boayina - Dhayaarakshanyadhinamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభునితో నిరంతరమౌ - నిబంధన జేసికొంటి",
        "నేబట్టితి నింపొందగ - విభుని పాదపద్మము"
      ],
      "english": [
        "Prabhunithoa Nirantharamau - Nibandhana Jaesikonti",
        "Naebattithi Nimpondhaga - Vibhuni Paadhapadhmamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాయాత్మ శాంత మొందుము - నీ యేసే నీ యాధారము",
        "భయంబులేక రక్షణన్ - పాలిభాగంబు పొందుము"
      ],
      "english": [
        "Naayaathma Shaantha Mondhumu - Nee Yaesae Nee Yaadhaaramu",
        "Bhayambulaeka Rakshanan - Paalibhaagambu Pondhumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నే నేసువాడ నేసుడు - నిత్యంబు నా వాడయ్యెను",
        "నా దెంత గొప్ప భాగ్యము - నే నేసుయొక్క మిత్రుడన్"
      ],
      "english": [
        "Nae Naesuvaada Naesudu - Nithyambu Naa Vaadayyenu",
        "Naa Dhentha Goppa Bhaagyamu - Nae Naesuyokka Mithrudan"
      ]
    }
  ]
}
