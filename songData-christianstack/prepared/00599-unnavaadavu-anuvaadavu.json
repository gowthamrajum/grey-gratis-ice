{
  "song_name": "Unnavaadavu Anuvaadavu",
  "author": {
    "Authored by": "Smt. Kiranmai Paul",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఉన్నవాడవు అనువాడవు నీవు",
      "నిన్న నేడు నిరతము మారని మా యేసయ్యా",
      "అల్ఫయు ఓమేగాయు నీవే కదా",
      "ఆద్యంతా రహితుడవు నీవే కదా",
      "హల్లెలూయా స్తోత్రార్హుడా",
      "యుగయుగములకు స్తుతిపాత్రుడా"
    ],
    "english": [
      "Unnavaadavu anuvaadavu neevu",
      "ninna nedu nirathamu maarani maa yesayya",
      "alphayu omegayu neeve kadhaa",
      "aadhyantha rahithudavu neeve kadhaa",
      "hallelujah sthothraarhudaa",
      "yugayugamulaku sthuthipaatrudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పలుకబడిన వాక్కుతో",
        "ప్రపంచములు నిర్మించితివి",
        "మంటితో మము చేసి",
        "జీవాత్మను ఊదితివి",
        "మమ్మునెంతో ప్రేమించి",
        "మహిమతో నింపితివి",
        "పరము నుండి దిగివచ్చి",
        "మాతో నడచితివి",
        "పాపమంటియున్న మాకై",
        "మా పరమ వైద్యునిగా",
        "నీ రుధిరం నాకై కార్చి",
        "ప్రాయశ్చిత్తం చేయగా",
        "మొదటివాడా కడపటివాడా",
        "జీవింపచేసితివే",
        "నీదు ఆత్మతో నింపితివే",
        "మమ్ము సరిచేసితివే",
        "ప్రతివాని మోకాలు",
        "వంగును నీ నామమున",
        "ప్రతివాని నాలుక",
        "చాటును నీ మహిమను",
        "తరతరములకు మమ్మేలువాడా",
        "భూపతుల రాజువే",
        "మేఘారూడుడై దిగివచ్చి",
        "మహినేలు మహారాజువే"
      ],
      "english": [
        "Palukabadina vaakkutho",
        "prapanchamulu nirminchithivi",
        "mantitho mamu chesi",
        "jeevathmanu oodhithivi",
        "mammunentho preminchi",
        "mahimatho nimpithivi",
        "paramu nundi dhigivachi",
        "maatho nadachithivi",
        "Paapamantiyunna maakai",
        "maa parama vaidhyunigaa",
        "nee rudhiram naakai kaarchi",
        "praaschittam cheyagaa",
        "modhativaadaa kadapativaadaa",
        "jeevimpachesithive",
        "needhu aathmatho nimpithive",
        "mammu sarichesithive",
        "Prathivaani mokaalu",
        "vangunu nee naamamuna",
        "prathivaani naaluka",
        "chaatunu nee mahimanu",
        "tharatharamulaku mammeluvaadaa",
        "bhoopathula raajuve",
        "meghaaroodudai dhigivachi",
        "mahinelu maharaajuve"
      ]
    }
  ]
