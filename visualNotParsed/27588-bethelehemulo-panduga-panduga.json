  "main_stanza": {
    "telugu": [
      "బేత్లహేములో పండుగ పండుగ",
      "పశులపాకలో పండుగ పండుగ",
      "ఆనందం ఆశ్చర్యం ఈ గొప్ప వార్త",
      "రాజు పుట్టడాని రారాజు పుట్టడాని",
      "లోకమంత సందడి చేద్దాం",
      "ఈ లోకమంత సందడి చేద్దాం",
      "తూర్పు దేశ జ్ఞానులు పూజింప వచ్చిరి",
      "ఆనందభరితులై ఆర్బటం చేసిరి ఓహొ",
      "బంగారం సాంబ్రాణి బోళములను అర్పించిరి",
      "రాత్రివేళ కనబడేను ప్రభుదూత గొల్లలకు",
      "చాటింప చెప్పిరి శుభవార్తమానము",
      "పరుగు పరుగున వెళ్ళిరి",
      "బేత్లేహేముకు గొల్లలందరు"
    ],
