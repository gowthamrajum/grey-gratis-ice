      "సర్వమెత్తి పాడి నీ మహిమ కార్యములను",
      "ప్రతి స్దలమునందు ప్రకటించెదా"
    ],
    "english": [
      "Sarva srushtiloni jeevaraashi yantha",
      "Needu mahimane prasthuthinchagaa",
      "Sarvametthi paadi nee mahima kaaryamulanu",
      "Prathi sthalamunandu prakatinchedaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవే మార్గం నీవే సత్యాం నీవే జీవం",
