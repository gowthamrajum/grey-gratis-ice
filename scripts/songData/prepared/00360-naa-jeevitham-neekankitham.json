{
  "song_name": "Naa Jeevitham Neekankitham",
  "author": {
    "Authored by": "Bro  Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా జీవితం - నీకంకితం",
      "కడవరకు సాక్షిగా - నన్ను నిలుపుమా - ప్రభూ"
    ],
    "english": [
      "Naa Jeevitham - Neekankitham",
      "Kadavaraku Saakshigaa - Nannu Nilupumaa - Prabhoo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బీడుబారినా - నా జీవితం",
        "నీ సిలువ జీవ ఊటలు - నన్ను చిగురింపజేసెనే"
      ],
      "english": [
        "Beedubaarinaa - Naa Jeevitham",
        "Nee Siluva Jeeva Ootalu - Nannu Chigurimpajesene"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పచ్చని ఒలీవనై - నీ మందిరావరణములో",
        "నీ తోనే ఫలించెదా - బ్రతుకు దినములన్నిట"
      ],
      "english": [
        "Pachchani Oleevanai - Nee Mandiraavaranamulo",
        "Nee Thone Phalinchedhaa - Brathuku Dinamulannita"
      ]
    }
  ]
}
