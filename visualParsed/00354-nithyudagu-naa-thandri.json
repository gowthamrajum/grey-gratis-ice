      "Aathmatho sathyamutho aaraadhinthunu",
      "Nithyudagu naa thandri"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భూమి ఆకాశములు గతించినా",
