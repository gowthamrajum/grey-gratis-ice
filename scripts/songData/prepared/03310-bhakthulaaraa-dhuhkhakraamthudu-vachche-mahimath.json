{
  "song_name": "Bhakthulaaraa Duhkhakraanthudu Vachche Mahimathoda",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "భక్తులారా దుఃఖక్రాంతుడు - వచ్చె మహిమతోడ",
      "విజయుడగాన మోక - రించుటకు పూజ్యుడు",
      "మకుటము తలనుంచి - అభిషిక్తున్ జేయుడు - మకుటము"
    ],
    "english": [
      "Bhakthulaaraa Duhkhakraanthudu - Vachche Mahimathoda",
      "Vijayudagaana Moka - Rinchutaku Poojyudu",
      "Makutamu Thalanunchi - Abhishikthun Jeyudu - Makutamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "పరలోక మార్భటింప - దూతలారా కొల్వుడి",
        "సింహాసనమునందు రాజు - నభిషక్తున్ చేయుడి",
        "మకుటము తలనుంచి - రాజరికమీయుడి - మకుటము"
      ],
      "english": [
        "Paraloka Maarbhatimpa - Dhoothalaaraa Kolvudi",
        "Simhaasanamunandhu Raaju - Nabhishakthun Cheyudi",
        "Makutamu Thalanunchi - Raajarikameeyudi - Makutamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపుల్ ముండ్ల మకుట మీయ - గరక్షితు లెల్లరు",
        "చుట్టు నిల్చి స్తుతిపాడి - యేసు పేరుపొందుడి",
        "మకుటము తలనుంచి - జయము ప్రకటించుడి - మకుటము"
      ],
      "english": [
        "Paapul Mundla Makuta Meeya - Garakshithu Lellaru",
        "Chuttu Nilchi Sthuthipaadi - Yesu Perupondhudi",
        "Makutamu Thalanunchi - Jayamu Prakatinchudi - Makutamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసు మహోన్నతు డాయెన్ - హా! మహాసంతోషము",
        "ఆర్భటించు పాట న్విని - గొప్పగా స్తుతించుడి",
        "మకుటము తలనుంచి - డీ రాజాధిరాజుకు - మకుటము"
      ],
      "english": [
        "Yesu Mahonnathu Daayen - Haa! Mahaasanthoshamu",
        "Aarbhatinchu Paata Nvini - Goppagaa Sthuthinchudi",
        "Makutamu Thalanunchi - Dee Raajaadhiraajuku - Makutamu"
      ]
    }
  ]
}
