{
  "song_name": "Naa Praanahithudaa",
  "author": {
    "Authored by": "Barzillai Lanka Samuel",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిను పాడి కీర్తించే కృప నిచ్చినావయా",
      "గతకాలమంత కాచినావయా",
      "కను పాపలా బ్రోచినావయా",
      "గతకాలమంత కాచినావయా",
      "పసి బిడ్డలా సాకినావయా"
    ],
    "english": [
      "Ninu paadi keerthinche krupa nichinaavayaa",
      "gathakaalamantha kaachinaavayaa",
      "kanu paapalaa brochinaavayaa",
      "gatha kaalamantha kaachinaavayaa",
      "pasi biddalaa saakinaavayaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎన్నెన్నో ఆపదలు నన్ను చుట్టి ముట్టిన",
        "సాతాను దాడులు నాపైన చేసినా",
        "విడువలేదయ్యా నన్ను మరువలేదయ్యా",
        "నీ కృపతో నన్ను నడిపినావయా",
        "లోకమంత ఏకమై నా పైన లేచినా",
        "నా ప్రాణ స్నేహితులు నన్ను మరచిపోయినా",
        "మరువలేదయ్యా నన్ను విడువలేదయ్యా",
        "నా ప్రాణహితుడవై దరినిలచినావయా",
        "చీకటులే నా బ్రతుకును కలవర పరచగా",
        "బంధుమిత్రులే నన్ను అపహాస్యం చేయగా",
        "మరువలేదయ్యా నన్ను విడువలేదయ్యా",
        "నా బంధువుగా దరి నిలిచినావయా"
      ],
      "english": [
        "Ennenno aapadhalu nannu chutti muttina",
        "saathaanu dhaadulu naapaina chesinaa",
        "viduvaledhayya nannu maruvaledhayya",
        "nee krupatho nannu nadipinaavayaa",
        "Lokamantha ekamai naa paina lechinaa",
        "naa praana snehithulu nannu marachipoyinaa",
        "maruvaledhayya nannu viduvaledhayya",
        "naa praana hithudavai dhari nilachinaavayaa",
        "Cheekatule naa brathukunu kalavara parachagaa",
        "bandhu mithrule nannu apahaasyam cheyagaa",
        "maruvaledhayya nannu viduvaledhayya",
        "naa bandhuvugaa dhari nilichinaavayaa"
      ]
    }
  ]
}
