  "main_stanza": {
    "telugu": [
      "మార్గమై ఉన్న యేసు",
      "నీ మార్గములో నను నడుపు",
      "జీవమై ఉన్న క్రీస్తు",
      "నీ జీవముతో నను నింపు",
      "సత్య మానలో వసియించుమా",
      "నీ రూపముకు మార్చుమా"
    ],
    "english": [
      "Maargamai unna Yesu",
      "nee maargamulo nanu nadupu",
      "jeevamai unna kreesthu",
      "nee jeevamutho nanu nimpu",
      "sathya maanalo vasiyinchumaa",
      "nee roopamuku maarchumaa"
    ]
  },
