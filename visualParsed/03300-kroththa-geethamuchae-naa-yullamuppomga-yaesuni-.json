  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రొత్త గీతముచే నా యుల్లము ప్పొంగ",
        "యేసుని కీర్తింతును",
        "పరిమళ తైలమును పోలిన",
        "నీ నామమునే ప్రేమింతును",
        "హల్లెలూయా స్తుతి హల్లెలూయా",
        "నా ప్రభు యేసుని గూర్చి పాడెదను",
        "ఇట్టి కృపను నాకు నిత్యము నిచ్చిన",
        "ప్రభుని కీర్తింతును"
      ],
      "english": [
        "Kroththa geethamuche naa yullamu upponga",
        "Yesuni keerthinthunu",
        "Parimala thailamunu polina",
        "Nee naamamune preminthunu",
        "Halleluya sthuthi halleluya",
        "Naa Prabhu Yesuni goorchi paadedanu",
        "Itti krupanu naaku nithyamu nichchina",
        "Prabhuni keerthinthunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గత కాలమంతయు కాపాడెన్",
        "కష్టబాధలు కలుగకుండ",
        "తన ఆశీర్వాదంబులు నాకొసగి",
        "సుఖభద్రతనిచ్చెన్"
      ],
      "english": [
        "Gatha kaalamanthayu kaapaaden",
        "Kashtabaadhalu kalugakunda",
        "Thana aasheervaadhambulu naakosagi",
        "Sukhabhadhrathanichchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కొన్ని వేళలు క్షణకాలము",
        "తన ముఖమును కప్పుకొనెను ప్రభువే",
        "తన కోపము మాని తిరిగి నా యెడల",
        "కుమ్మరించును కృపను"
      ],
      "english": [
        "Konni velalu kshanakaalamu",
        "Thana mukhamunu kappukonenu Prabhuve",
        "Thana kopamu maani thirigi naa edala",
        "Kummarinchunu krupanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కరువు లధికంబగు చుండినను",
        "ప్రభు ఆశ్రయముగనుండు",
        "పలు స్థలములలో వ్యాధులు వ్యాపింపగ",
        "ప్రభు మమ్ము కాపాడెన్"
      ],
      "english": [
        "Karuvu ladhikambagu chundinanu",
        "Prabhu aashrayamuganundu",
        "Palu sthalamulalo vyaadhulu vyaapimpaga",
        "Prabhu mammu kaapaaden"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రభు త్వరగా వచ్చును సంతసముగ",
        "మమ్ము జేర్చును పరమందు",
        "కనిపెట్టెద మనిశం నింగిని జూచుచు",
        "ఆశతో గాంచెదము"
      ],
      "english": [
        "Prabhu thvaragaa vachchunu santhasamuga",
        "Mammu jerchunu paramandu",
        "Kanipetteda manisham ningini joochuchu",
        "Aashatho gaanchedhamu"
      ]
    }
  ]
