{
  "song_name": "Keerthinthunu Ninne",
  "author": {
    "Authored by": "Bobby, Sunith",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కీర్తింతును నిన్నే బహుకీర్తనీయుడా",
      "స్తోత్రింతును నిన్నే సర్వోన్నతుడా",
      "కృతజ్ఞత హృదయముతో నీ సన్నిధిని చేరి",
      "నే చేసెద స్తుతి యాగము",
      "కృపలన్నీ తలపోయుచు",
      "మనసారా నిన్నే నే ఆరాధించెదను",
      "ఆరాధించెదను… ఆరాధించెదను…"
    ],
    "english": [
      "keerthinthunu ninne bahukeerthaneeyuda",
      "stothrinthunu ninne sarvonnathuda",
      "kruthagnatha hrudayamutho nee sannidhini cheri",
      "ne cheseda sthuthi yaagamu",
      "krupalannyi thalapoyuchu manasaara ninne ne aaraadhinchedhanu",
      "aaraadhinchedhanu… aaraadhinchedhanu…"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా యేసయ్య యేసయ్య నా యేసయ్య",
        "నిన్ను స్తుతించక ఉండలేనయ్యా",
        "నా యేసయ్య యేసయ్య నా యేసయ్య",
        "ఒక క్షణమైనా ఉండలేనయ్యా"
      ],
      "english": [
        "Naa yesayya yesayya naa yesayya",
        "ninnu sthuthinchaka undalenayya",
        "naa yesayya yesayya naa yesayya",
        "oka kshanamaina undalenayya"
      ]
    }
  ]
}
