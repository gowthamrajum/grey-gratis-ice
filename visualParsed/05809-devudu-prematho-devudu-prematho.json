  "main_stanza": {
    "telugu": [
      "దేవుడు ప్రేమతో దేవుడు ప్రేమతో",
      "చేసాడు సృష్టినీ సృష్టంత నీకని",
      "తన మదిలో ప్రేమ ఎంత ఉన్నదని",
      "చూపెను ప్రేమతో ॥2॥"
    ],
    "english": [
      "Devudu prematho Devudu prematho",
      "Chesaadu srushtinee srushtantha neekani",
      "Thana madilo prema entha unnadhani",
      "Choopenu prematho ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గర్భంలో ఉన్నావనీ ఉమ్మనీరె త్రాగేస్తావనీ",
        "నవ మాసాలు నీటిలో బ్రతికించెను ప్రేమతో",
        "గర్భంలో ఉన్నావనీ ఉమ్మనీరె త్రాగేస్తావనీ",
        "నవ మాసాలు కాపాడెను నిను  ||దేవుడు||",
        "నువ్వు గర్బములో ఉండగా ఆహారమే అందించెను",
        "తల్లిదండ్రుల ప్రతి మాటను గర్భములో వినిపించెను",
        "చీకటిలోనే ఉన్నావని నీ కంటికి వెలుగిచ్చెను  ||దేవుడు||"
      ],
      "english": [
        "Garbhamlo unnaavanee ummaneere thraagesthaavanee",
        "Nava maasaalu neetilo brathikinchenu prematho",
        "Garbhamlo unnaavanee ummaneere thraagesthaavanee",
        "Nava maasaalu kaapaadenu ninu ||Devudu||",
        "Nuvvu garbhamulo undagaa aahaarame andinchenu",
        "Thallidandrula prathi maatanu garbhamulo vinipinchenu",
        "Cheekatilone unnaavani nee kantiki velugichchenu ||Devudu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గర్భంలో ఉన్నావనీ విశ్రాంతి ఇవ్వాలనీ",
        "ఏదని నీకు లేకుండ మరణమిచ్చెను ప్రేమతో",
        "మరణమే ఇవ్వాలనీ విశ్రాంతిని ఇవ్వాలనీ",
        "దేవుని పనే లేకుండా మరణమిచ్చెను ప్రేమతో",
        "ఏ కష్టము లేకుండగా అదృష్టము కొందరికే",
        "ఏ పాపము లేకుండగా స్వర్గం నీకొక్కరికే",
        "పుట్టిన వారికి పని ఉందని మరణిస్తేనే మేలని  ||దేవుడు||"
      ],
      "english": [
        "Garbhamlo unnaavanee vishraanthi ivvaalanee",
        "Edhani neeku lekunda maranamichchenu prematho",
        "Maraname ivvaalanee vishraanthini ivvaalanee",
        "Devuni pane lekundaa maranamichchenu prematho",
        "E kashtamu lekundagaa adhrushtamu kondarike",
        "E paapamu lekundagaa swargam neekokkarike",
        "Puttina vaariki pani undani maranisthene melani ||Devudu||"
      ]
    }
  ]
}
