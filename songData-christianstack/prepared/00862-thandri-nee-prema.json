{
  "song_name": "Thandri Nee Prema",
  "author": {
    "Authored by": "Kripal Mohan",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తండ్రి నీ ప్రేమా",
      "తనయుని బలియాగం",
      "శుద్ధత్ముని సహవాసం",
      "ఎంతో ఉన్నతము",
      "త్రియేకుని స్వరూపం"
    ],
    "english": [
      "Thandri nee premaa",
      "thanayuni baliyaagam",
      "suddhathmuni sahavaasam",
      "entho unnathamu",
      "threeyekuni swaroopam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూతలతో పొగడబడే సర్వోనతుడా",
        "సర్వాధికారము కలిగిన సుతుడా",
        "ఆధరణకర్తవు ఆధరించుచున్నావు",
        "సర్వశక్తిమంతుడవు నడిపించుచున్నావు"
      ],
      "english": [
        "Dhoothalatho pogadabade sarvonathudaa",
        "sarvaadhikaaramu kaligina suthudaa",
        "aadharanakarthavu aadharinchuchunnaavu",
        "sarvasakthimanthudavu nadipinchuchunnaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆరాధనా ఆరాధనా ఆరాధనా నీకే",
        "హల్లేలూయా హల్లేలూయా హల్లేలూయా నీకే"
      ],
      "english": [
        "Aaraadhanaa aaraadhanaa aaraadhanaa neeke",
        "Hallelujah Hallelujah Hallelujah neeke"
      ]
    }
  ]
}
