{
  "song_name": "Kanipinche Bandalanni",
  "author": {
    "Authored by": "King Srinu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కనిపించే బంధాలన్నీ దేవునివే కనిపించని దేవుని ప్రేమను తెలుపుటకే",
      "లాలించి ఆడించే ప్రేమ తనదేనే అదృశ్య దేవుని ఆప్యాయతకు రూపమే",
      "కుటుంబమంతా దేవునిగా ఆప్యాయతతో నిండిపోవాలిగా",
      "కలిసుండమంటే కలహాలతో విడిపోయారుగా",
      "కుటుంబమంతా సువార్త పనిలో కలిసిపోవాలిగా"
    ],
    "english": [
      "Kanipinche bandhalanni Devunive kanipinchani Devuni premanu teluputake",
      "Laalinchi aadinche prema thanadhene adrushya Devuni aapyaayathaku rupame",
      "Kudumbamantha Devuniga aapyaayathatho nindipovaaliga",
      "Kalisundamante kalahaalatho vidipoyaaruga",
      "Kudumbamantha suvaartha panilo kalisipovaaliga"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అన్నం పెట్టాడు అమ్మగా పోషించాడు నాన్నగా",
        "చెలిమి చేసాడు చెల్లిగా అన్నీ నేనే అన్నాడు అన్నగా",
        "అమ్మ ప్రేమ నాన్న ప్రేమ అందరి ప్రేమలు తనవే",
        "అందరిలోనూ వ్యాపించాడు అందరిలో ఉన్నాడుగా",
        "కుటుంబమంతా క్రీస్తు సంఘంలో చేరిపోవాలిగా",
        "రక్తబంధాన్ని ఆత్మబంధంగా మార్చుకోవాలిగా",
        "కుటుంబమంటే మోషేగా అందరూ సేవకులుగా మారిపోయారుగా"
      ],
      "english": [
        "Annam pettaadu ammagaa poshunchaadu nannagaa",
        "Chelimi chesaadu chelligaa anni nene annaadu annagaa",
        "Amma prema nanna prema andhari premalu thanave",
        "Andharilonu vyaapunchaadu andharilo unnaaduga",
        "Kudumbamantha Kreesthu sanghamlo cheripovaaliga",
        "Rakthabandhaanni aathmabandhamgaa maarchukovaaliga"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంఘం కట్టాడు కుటుంబంగా నేర్పించాడు ప్రేమేగా",
        "సోదరులను ఇచ్చాడు అండగా వారే ఆత్మ బంధువులు అన్నాడుగా",
        "ఇద్దరు కాదు ముగ్గురు కాదు పెద్ద కుటుంబమే ఇచ్చాడు",
        "అందరిలోనూ ఆత్మను ఉంచి అందరూ ఒకటన్నాడుగా",
        "రక్తబంధమే తెగిపోతుంది ఆత్మబంధమే శాశ్వతము",
        "శరీర బంధాన్ని సహించావు ఆత్మబంధం భరించావు",
        "కుటుంబమంటే సంఘమేగా లోపాలు ఎన్నున్నా క్షమించుకోవాలిగా"
      ],
      "english": [
        "Sangham kattaadu kudumbamgaa nerpinchaadu premegaa",
        "Sodharulanu icchaadu andagaa vaare aathma bandhuvulu annaaduga",
        "Iddharu kaadu mugguru kaadu pedda kudumbame icchaadu",
        "Andharilonu aathmanu unchi andharu okatannaaduga",
        "Rakthabandhame tegipothundhi aathmabandhame shaashvathamu",
        "Sharira bandhaanni sahinchaavu aathmabandham bharinchaavu",
        "Kudumbamante sanghamegaa lopalu ennunnaa kshaminchukovaaliga"
      ]
    }
  ]
}
