{
  "song_name": "Aasraya Dhurgama Naa Yesayya",
  "author": {
    "Authored by": "Bro. Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆశ్రయదుర్గమా – నా యేసయ్యా",
      "నవజీవన మార్గమునా – నన్ను నడిపించుమా",
      "ఊహించలేనే నీ కృపలేని క్షణమును",
      "కోపించుచునే వాత్సల్యము నాపై చూపినావే"
    ],
    "english": [
      "Aashraya durgamaa – naa yesayyaa",
      "nava jeevana maargamunaa – nannu nadipinchumaa",
      "oohinchalene nee krupaleni kshanamunu",
      "kopinchuchune vaathsalyamu naapai choopinaave"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోక మర్యాదలు మమకారాలు గతించి పోవునే",
        "ఆత్మీయులతో అక్షయ అనుబంధం అనుగ్రహించితివే (2)",
        "అందుకే ఈ స్తుతి ఘన మహిమల స్తోత్రాంజలి",
        "నాతో నీవు చేసిన నిబంధనలన్నియు నెరవేర్చుచుంటివే",
        "నీతో చేసిన తీర్మానములు స్థిరపరచితివే (2)",
        "అందుకే ఈ స్తుతి ఘన మహిమల స్తోత్రాంజలి",
        "పరవాసినైతిని వాగ్ధానములకు వారసత్వమున్నను",
        "నీ శిక్షణలో అనుకవతోనే నీకృ పొందెద (2)",
        "అందుకే ఈ స్తుతి ఘన మహిమల స్తోత్రాంజలి",
        "నిత్య నివాసినై నీ ముఖము చూచుచు పరవశించెదనే",
        "ఈ నిరీక్షణయే ఉత్తేజము నాలో కలిగించుచున్నది (2)",
        "స్తుతి ఘన మహిమలు నీకే చెల్లును నా యేసయ్యా",
        "హల్లేలూయా – హల్లేలూయా – హల్లెలూయా"
      ],
      "english": [
        "Loka maryaadhalu mamakaaraalu gathinchi povune",
        "aathmeeyulatho akshaya anubandham anugrahinchithive",
        "andhuke ee sthuthi ghana mahimala sthothraanjali",
        "Naatho neevu chesina nibandhanalanniyu neraverchu chuntivey",
        "neetho chesina theermaanamulu sthiraparachithive",
        "andhuke ee sthuthi ghana mahimala sthothraanjali",
        "Paravaasinaithini vaagdhaanamulaku vaarasathvamunnanu",
        "nee sikshanalo anukuvathoney nee krupa pondhedha",
        "andhuke ee sthuthi ghana mahimala sthothraanjali",
        "Nithya nivaasinai nee mukhamu choochuchu paravashinchedhaney",
        "ee nireekshanaye utthejamu naalo kaliginchuchunnadhi",
        "sthuthi ghana mahimalu neeke chellunu naa yesayyaa",
        "hallelujah hallelujah hallelujah"
      ]
    }
  ]
}
