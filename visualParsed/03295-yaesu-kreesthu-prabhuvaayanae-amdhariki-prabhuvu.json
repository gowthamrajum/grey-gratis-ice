    {
      "stanza_number": 3,
      "telugu": [
        "భీతిన్ గొలుపు అలలు పైకి లేచినంతనే",
        "భీతిన్ విడచి యేసు వైపు చూడు నిమ్మళించును"
      ],
      "english": [
        "Bheethin golupu alalu paiki lechinanthane",
        "Bheethin vidachi Yesu vaipu choodu nimmalinchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మరణమేలు లోయలందు సంచరించెడు",
        "తరుణములు కలిగినను క్రీస్తు మీ చెంతనుండున్"
      ],
      "english": [
        "Maranamelu loyalandhu sancharinchedu",
        "Tharunamulu kaliginanu Kreesthu mee chenthanundun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మన జీవము క్రీస్తే గదా క్రీస్తున్ తేరి చూచి",
        "తనయులమై యుద్ధమందు జయము నొందెదము"
      ],
      "english": [
        "Mana jeevamu Kreesthe gadaa Kreesthun theri choochi",
        "Thanayulamai yudhdhamandhu jayamu nondhedhamu"
      ]
