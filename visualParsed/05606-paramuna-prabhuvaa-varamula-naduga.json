      ],
      "english": [
        "Dhanadhaanyamulu sarvasampadhalu",
        "Sarva sukhamulu ninu koraledhu",
        "Nee prema nee karuna nee krupaye chaalu",
        "Ninu gaaka nenedhi mari koraledhu (2)  ||Paramuna||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఇలలోన నా యాత్రను ముగిసి",
        "పరలోకమును నే చేరువేళ",
        "వేవేల దూతలు గీతాలు పాడ",
