  },
  "main_stanza": {
    "telugu": [
      "రండి యెహోవానుగూర్చి - సంతోష గానము చేయుదము"
    ],
    "english": [
      "Randi Yehovaanugoorchi - Santhosha gaanamu cheyudamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మన రక్షణ దుర్గము బట్టి ఉత్సాహ ధ్వని చేయుదము",
        "కృతజ్ఞతాస్తుతుల తోడ"
      ],
      "english": [
        "Mana rakshana durgamu batti uthsaaha dhvani cheyudamu",
        "Kruthagnathaasthuthula thoda"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మహా దేవుడు యెహోవా - దేవతలందరి పైన",
        "మహాత్మ్యము గల మహారాజు"
      ],
      "english": [
        "Mahaa Devudu Yehova - Dhevathalandhari paina",
        "Mahaathmyamu gala mahaaraaju"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భూమ్యగాధ స్థలములు ఆయన చేతిలో నున్నవి",
        "పర్వత శిఖరము లాయనవే"
      ],
      "english": [
        "Bhoomyagaadha sthalamulu aayana chethilo nunnavi",
        "Parvatha shikharamu laayanave"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సముద్రమును భూమిని - తనదు చేతులు చేసెను",
        "తన ప్రజలము గొఱ్ఱెలము మనము"
      ],
      "english": [
        "Samudhramunu bhoomini - Thanadu chethulu chesenu",
        "Thana prajalamu gorrelamu manamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యెహోవా సన్నిధియందు మనము సాగిలపడుదము",
        "మనల సృజించిన దేవునికి"
      ],
      "english": [
        "Yehova sannidhiyandhu manamu saagilapadudhamu",
        "Manala srujinchina Devuniki"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నేడు మీరు ఆయన మాట అంగీకరించిన యెడల",
        "ఎంత మేలు మనోహరము"
      ],
      "english": [
        "Nedu meeru aayana maata angeekarinchina edala",
        "Entha melu manoharamu"
      ]
    }
  ]
}
