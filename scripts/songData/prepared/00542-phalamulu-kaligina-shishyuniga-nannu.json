{
  "song_name": "Phalamulu Kaligina Shishyuniga Nannu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఫలములు కలిగిన శిష్యునిగా నన్ను మార్చితివా",
      "నీ రూపానికి మార్చుటకు నన్ను పిలిచితివా",
      "జీవమా దైవమా స్తుతులకు కారణ భుతుడా"
    ],
    "english": [
      "Phalamulu Kaligina Shishyunigaa Nannu Maarchithivaa",
      "Nee Roopaaniki Maarchutaku Nannu Pilichithivaa",
      "Jeevamaa Daivamaa Sthuthulaku Kaarana Bhoothudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మధ్యాహ్నకాల తేజస్సుగా నన్ను మార్చితివా",
        "చీకటి పోయెనే వెలుగు కలిగినే"
      ],
      "english": [
        "Madhyaahnakaala Thejassugaa Nannu Maarchithivaa",
        "Cheekati Poyene Velugu Kaligine"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశోధించి శుద్ధ సువర్ణము చేసితివా",
        "శోధన పరీక్షలో నాకు విజయము నిచ్చితివా"
      ],
      "english": [
        "Parishodhinchi Shuddha Suvarnamu Chesithivaa",
        "Shodhana Pareekshalo Naaku Vijayamu Nichchithivaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా శ్రమలలో ఉపద్రవములలో కన్నీళ్ళలో",
        "సంతోషించుచూ నేను సిలువను మోసెదను"
      ],
      "english": [
        "Naa Shramalalo Upadravamulalo Kanneellalo",
        "Santhoshinchuchoo Nenu Siluvanu Mosedanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా గమ్య స్థానం సీయోనేనని సిద్దమైతిని",
        "పరిశుద్ద రెక్కలు ధరించి నీతో ఆరోహనమయ్యేద"
      ],
      "english": [
        "Naa Gamya Sthaanam Seeyonenani Siddhamaithini",
        "Parishuddha Rekkalu Dharinchi Neetho Aarohanamayyeda"
      ]
    }
  ]
}
