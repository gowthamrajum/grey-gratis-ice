      ],
      "english": [
        "Paapini karuninchi praanadhaanamichchaavu",
        "Parama jeevamichchi paralokaraajyamichchi",
        "Pandrendu gummamula pattaname naaku kattabettinaavaa"
      ]
    },
    {
      "stanza_number": 2,
