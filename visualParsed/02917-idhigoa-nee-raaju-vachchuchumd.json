    {
      "stanza_number": 7,
      "telugu": [
        "యేసుని ప్రేమించుచు హోసన్న పాడెదము",
        "యేసుడిల వచ్చుచుండె హల్లెలూయ వచ్చుచుండె  ||ఇదిగో||"
      ],
      "english": [
        "Yesuni preminchuchu hosanna paadedamu",
