    {
      "stanza_number": 4,
      "telugu": [
        "నాథా నాదు గతియు నీవే - పాదారవింద శరణమిమ్ము",
        "ఆధారమీవే దీనోపకారా"
      ],
      "english": [
        "Naathaa naadu gathiyu neeve - Paadhaaravindha sharanamimmu",
        "aadhaarameeve dheenopakaaraa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కృపాసముద్ర దయామయుండా - తలను ముండ్ల మకుటధారివై",
        "సిలువయందు మరణించితివి"
      ],
      "english": [
        "Krupaasamudhra dhayaamayundaa - Thalanu mundla makutadhaarivai",
        "siluvayandhu maraninchithivi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీదు రాజ్యము వచ్చునుగాక - సాధుగ మోక్షసౌఖ్యము చేర",
        "నీదు దాసుల నాశీర్వదించుము"
      ],
      "english": [
        "Needu raajyamu vachchunugaaka - Saadhuga mokshasaukhyamu chera",
