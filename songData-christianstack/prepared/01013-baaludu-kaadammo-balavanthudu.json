{
  "song_name": "Baaludu Kaadammo Balavanthudu",
  "author": {
    "Authored by": "Bishop Daniel Kalyanapu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "బాలుడు కాదమ్మో బలవంతుడు యేసు",
      "పసివాడు కాదమ్మో పరమాత్ముడు క్రీస్తు (2)",
      "పరమును విడచి పాకలో పుట్టిన",
      "పాపుల రక్షకుడు మన యేసయ్యా (2)"
    ],
    "english": [
      "Baaludu kaadhammo balavanthudu yesu",
      "pasivaadukadhammo paramathmudu kristhu",
      "paramunu vidichi paakalo puttina",
      "papula rakshakudu mana yesayya (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కన్య మరియ గర్భమందు",
        "బెత్లహేము పురమునందు",
        "ఆ పశుశాలలోన పుట్టినాడమ్మా",
        "ఆ వార్త తెలియగానే గొర్రెలను విడచి",
        "పరుగు పరుగున పాకను చేరామే(2)",
        "మనసారా మ్రొక్కినాము",
        "మది నిండా కొలచినాము (2)",
        "మా మంచి కాపరని సంతోషించామే!",
        "సందడి సందడి సందడి సందడి సందడి చేసామే (4)",
        "చుక్కను చూసి వచ్చినాము",
        "పాకలో మేము చేరినాము",
        "పరిశుద్ధుని చూసి పరవశించామే",
        "రాజుల రాజని యూదుల రాజని",
        "ఇతడే మా రాజని మ్రొక్కినామమ్మా ( 2)",
        "బంగారము సాంబ్రాణి బోళం కానుకగా ఇచ్చినాము (2)",
        "ఇమ్మానుయేలని పూజించామమ్మో",
        "సందడి సందడి సందడి సందడి సందడి చేసామే (4)"
      ],
      "english": [
        "Kanya mariya garbamandhu",
        "bethlehemu puramunandhu",
        "aa pasusaala lona puttinadamma",
        "ah vaartha theliyagaane gorrelanu vidichi",
        "parugu paruguna pakalo cheramey (2)",
        "manasaara mrokkinaamu madhininda kolichinamu",
        "maa manchi kaaparani santhoshinchamey",
        "sandhadi sandhadi sandhadi sandhadi sandhadi chesame (4)",
        "chukkanu chusi vacchinamu",
        "paakalo memu cherinaamu",
        "parishuddhuni chusi paravasinchame!",
        "raajula rajani yuudhula raajani",
        "ithade ma raajani mrokkinamamma",
        "bangaaram saambrani bolam kaanukaga icchinamu (2)",
        "emmanuelani puujinchamammo",
        "sandhadi sandhadi sandhadi sandhadi sandhadi chesame (4)"
      ]
    }
  ]
}
