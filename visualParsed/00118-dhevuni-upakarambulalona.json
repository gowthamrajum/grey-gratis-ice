{
  "song_name": "Devuni upakaarambulalona",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవుని ఉపకారంబులలోన - దేనిని మరువకుము",
      "ఆయన చేసిన మేలులన్నియు - అనుదినమును ధ్యానించుము"
    ],
    "english": [
      "Devuni upakaarambulalona - Denini maruvakumu",
      "Aayana chesina melulanniyu - Anudinamunu dhyaaninchumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిరాశతో మనమున్నప్పుడు - నిరసించిపడియున్నప్పుడు (2)",
        "మరణ చాయలో నున్నప్పుడు - మరువకుండ కాపాడెనుగా  ||దేవుని||"
      ],
      "english": [
        "Niraashatho manamunnappudu - Nirasinchipadiyunnappudu (2)",
        "Marana chaayalo nunnappudu - Maruvakunda kaapaadenugaa  ||Devuni||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యాధులలో మనమున్నప్పుడు - బాధలలో మనమున్నప్పుడు (2)",
        "వ్యాధుల బాధల తొలగించి - ఆదరించి కాపాడెనుగా  ||దేవుని||"
      ],
      "english": [
        "Vyaadhulalo manamunnappudu - Baadhalalo manamunnappudu (2)",
        "Vyaadhula baadhala tholaginchi - Aadarinchi kaapaadenugaa  ||Devuni||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మహోపకారములన్నియును -యెహోవ దేవుడె చేసెనుగా (2)",
        "అహోరాత్రులు ధ్యానించి - మహోన్నతుని స్తుతియించుము"
      ],
      "english": [
        "Mahopakaaramulanniyunu - Yehova Devude chesenugaa (2)",
        "Ahoraathrulu dhyaaninchi - Mahonnathuni sthuthiyinchumu"
      ]
    }
  ]
}
