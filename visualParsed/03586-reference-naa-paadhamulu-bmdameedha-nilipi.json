{
  "song_name": "Naayaathma langaruveya - Susthira bhoomi chikkenu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాయాత్మ లంగరువేయ - సుస్థిర భూమి చిక్కెను",
        "నా పాపము హరించెడు - నిత్యుండౌ యేసుగాయముల్",
        "కల్పాంతకాలమైనను - సదా యీ ప్రేమనిల్చును"
      ],
      "english": [
        "Naayaathma langaruveya - Susthira bhoomi chikkenu",
        "Naa paapamu harinchedu - Nithyundau Yesugaayamul",
        "Kalpaanthakaalamainanu - Sadaa ee premanilchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తండ్రీ! నీ ప్రేమ నిత్యమై - మాయల్ప బుద్ధిని మించు",
        "నీ యుల్లమందు సర్వదా - కారుణ్యముండినందున",
        "మరలివచ్చు పాపులన్ - జేర్చి జీవింప జేతువు"
      ],
      "english": [
        "Thandree! Nee prema nithyamai - Maayalpa budhdhini minchu",
        "Nee yullamandhu sarvadaa - Kaarunyamundinandhuna",
        "Maralivachchu paapulan - Jerchi jeevimpa jethuvu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ ప్రేమ లోతుతేలదు - మేమెన్న శక్యముగాదు",
        "నా పాపమంత దాచితి నిర్దోషిగా నన్నెంచితి",
        "శ్రీయేసు పుణ్యముండగా - ధారాళ కృపనిత్తువు"
      ],
      "english": [
        "Nee prema lothutheladhu - Memenna shakyamugaadhu",
        "Naa paapamantha dhaachithi nirdhoshigaa nannenchithi",
        "Shreeyesu punyamundagaa - Dhaaraala krupanitthuvu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా కష్టముల్ తుఫానుగా - నా తలపైన క్రమ్మిన",
        "లోకేచ్ఛలన్ని భంగమై - యసౌఖ్యముల్ ప్రాప్తించిన",
        "నీ ప్రేమ నిత్యము కాగా - నదే నాయాత్మలంగరు"
      ],
      "english": [
        "Naa kashtamul thuphaanugaa - Naa thalapaina krammina",
        "Lokechchhalanni bhangamai - Yasaukhyamul praapthinchina",
        "Nee prema nithyamu kaagaa - Nadhe naayaathmalangaru"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "హృదయ భీతియుండిన - ప్రపంచము లయించిన",
        "నీ వన్ని కదిలింపుము - నాలంగర్ స్థిరమై యుండి",
        "ననంత ప్రేమ శక్తిని అనుభవింతు"
      ],
      "english": [
        "Hrudaya bheethiyundina - Prapanchamu layinchina",
        "Nee vanni kadhilimpumu - Naalangar sthiramai yundi",
        "Nanantha prema shakthini anubhavinthu"
      ]
    }
  ]
}
