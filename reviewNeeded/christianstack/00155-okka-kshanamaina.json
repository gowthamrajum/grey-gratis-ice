      "english": [
        "Naayedala nee nammakaani vommucheyyanayya",
        "Nee chittame naaku ksheemamu ilalo Yesayya",
        "Neeraakakai naa praanamu vechi unnadayya",
        "Nee raajyame naa gamyamu nirathamu Yesayya",
        "Naa oohalakandhadu nee prema ennadu Yesayya",
        "Naa varnanakandhani neethyaagam chesaavesayya"
      ]
