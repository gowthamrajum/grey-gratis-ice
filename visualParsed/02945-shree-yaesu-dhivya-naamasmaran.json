      ],
      "english": [
        "Ninnu nee veringi Prabhuni neruga ve manasaa",
        "Sannuthu dandhula kosange sathyavedhamu ||Shree||"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "పాపములకు పరితపించి ప్రభుని జేరవే",
        "దాపునకు రమ్మంచు కరము చాపేనే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Paapamulaku parithapinchi Prabhuni jerave",
        "Dhaapunaku rammanchu karamu chaapene manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "ఎంత ఘోరపాపమైన నెంచడే మనసా",
        "ఎంత మొత్తమైనను క్షమి యించునే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Entha ghorapaapamaina nenchade manasaa",
        "Entha motthamainanu kshami inchune manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "బ్రతుకు శాశ్వతంబు కాదు పరికించు మనసా",
        "ఈ బతుక్నందె ప్రభుని పదము పట్టుకో మనసా  ||శ్రీ||"
      ],
      "english": [
        "Brathuku shaashvathambu kaadu parikinchu manasaa",
        "Ee bathukunandhe Prabhuni padhamu pattuko manasaa ||Shree||"
      ]
    },
    {
      "stanza_number": 12,
      "telugu": [
        "జనక కుమారాత్మ దేవున్ జపియించు మనసా",
        "అనయమును స్మరించు స్వర్గ మద్దియే మనసా  ||శ్రీ||"
      ],
      "english": [
        "Janaka kumaaraathma Dhevun japiyinchu manasaa",
        "Anayamunu smarinchu swarga maddhiye manasaa ||Shree||"
      ]
    }
  ]
