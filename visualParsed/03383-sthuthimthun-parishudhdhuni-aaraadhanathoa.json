{
  "song_name": "Sthuthinthun parishuddhuni aaraadhanatho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "స్తుతింతున్ పరిశుద్దుని ఆరాధనతో - ఇంతవరకు కాచె దేవుడే"
    ],
    "english": [
      "Sthuthinthun parishuddhuni aaraadhanatho - Inthavaraku kaache Devude"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇరువదై దేండ్లు గాచెన్ - కొరతలేని మేళ్ళనిచ్చె",
        "చేర్చె ప్రజల నెందరినో - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Iruvadhai dhendlu gaachen - Korathaleni mellanichche",
        "Cherche prajala nendharino - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సువార్త సైన్యము నిచ్చి - భువిపై శత్రుని పనినాపే",
        "వినిన వారిని ప్రత్యేకించే - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Suvaartha sainyamu nichchi - Bhuvipai shathruni paninaape",
        "Vinina vaarini prathyekinche - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరిశుద్ధ సంఘము కూర్చె - నేర్పె సత్య మర్మములు",
        "సరిగ సాక్ష్యము స్థాపించె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Parishuddha sanghamu koorche - Nerpe sathya marmamulu",
        "Sariga saakshyamu sthaapinche - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సేవకులనిచ్చెను బహుగా - కావలి యుంచెను ప్రభువే",
        "సహపని వారి నొసగె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Sevakulanichchenu bahugaa - Kaavali yunchenu Prabhuve",
        "Sahapani vaari nosage - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇండియాలో ఈ నగరు - అంతియొకయ వలె జేసె",
        "స్వంతముగను జేసికొనెన్ - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Indiyaalo ee nagaru - Anthiyokaya vale jese",
        "Svanthamuganu jesikonen - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పరమ దర్శనము నిచ్చె - సరిగా లోబరచె మనల",
        "కరము నిచ్చె నడిపించె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Parama darshanamu nichche - Sarigaa lobarache manala",
        "Karamu nichche nadipinche - Cheripaadi sthuthinchedamu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సంఘ మర్మనును దెల్పి - శీఘ్రముగ నంపెను వార్త",
        "పార్చె పాపుల నెందరినో - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Sangha marmamunu dhelpi - Sheeghramuga nampenu vaartha",
        "Paarche paapula nendharino - Cheripaadi sthuthinchedamu"
      ]
    }
  ]
}
