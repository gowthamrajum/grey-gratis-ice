{
  "song_name": "Oka Aasa Undayyaa",
  "author": {
    "Authored by": "Pastor Anand Babu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఒక ఆశ ఉందయ్యా నా కోరిక తీర్చయ్యా",
      "నా మనవిను యేసయ్యా ప్రత్యుత్తరమిమ్మయ్య",
      "యవనకాలమందు నీ కాడి మోయగా",
      "బలమైన విల్లుగా నన్ను మార్చవా"
    ],
    "english": [
      "Oka aasa undayyaa naa koorika theerchayyaa",
      "Naa manavinu yeasayyaa prathyuttharamimmayya",
      "Yesayya naa aasa theerchayya",
      "Yavanakaalamandu nii kaadi mooyagaa",
      "Balamaina villugaa nannu maarchavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యూదుల రక్షణకై రాజు శాసనము మార్చి-",
        "ఎస్తేరు ఆశను తీర్చిన దేవా",
        "ఈ తరములో మా మనవులను ఆలకించవా –",
        "మా దేశములో మహా రక్షణ కలుగజేయవా"
      ],
      "english": [
        "Yuudula rakshannakai raaju saasanamu maarchi",
        "Esteru aasanu theerchina deava",
        "Ee tharamuloo maa manavulanu aalakinchavaa",
        "Maa deasamuloo mahaa rakshanna kalugajeayavaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నత్తివాడైనను ఫరో ఎదుట నిలబెట్టి-",
        "మోషే ఆశను తీర్చిన దేవా",
        "ఈ తరములో నీ చిత్తముకై ఎదురు చూడగా",
        "అగ్ని చేత నను దర్శించి నీ చిత్తము తెలుపవా"
      ],
      "english": [
        "Natthivaadainanu pharaoh eduta nilabetti",
        "Moshea aasanu theerchina deava",
        "Ee tharamuloo nii chitthamukai eduru chuudagaa",
        "Agni cheatha nanu darsinchi nii chitthamu telupavaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మేడ గదిలో అగ్నివoటి ఆత్మతో నింపి-",
        "అపోస్తులల ఆశను తీర్చిన దేవా",
        "ఈ తరములో నీ సేవకై మేము నిలువగా",
        "అగ్ని వంటి ఏడంతల ఆత్మతో ఆశ తీర్చవా"
      ],
      "english": [
        "Meada gadiloo agnivanti aathmathoo nimpi",
        "Apostulala aasanu theerchina deavaa",
        "Ee tharamuloo nii seavakai meamu niluvagaa",
        "Agni vanti eadanthala aathmathoo aasa theerchavaa"
      ]
    }
  ]
}
