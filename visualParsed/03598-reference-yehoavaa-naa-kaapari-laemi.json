  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రేమరాజు కాపరి - నన్నెంతో ప్రేమించును",
        "ఈ రాజు వాడనైనచో - నా కెట్టి లేమిలేదు"
      ],
      "english": [
        "Naa premaraaju kaapari - Nannentho preminchunu",
        "Ee raaju vaadanainacho - Naa ketti lemiledhu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పోషించి నాదు నాత్మకు - జీవంపు నీటినిచ్చున్",
        "పోషించు దాని నిత్యమున్ - జీవాహారంబుతోను"
      ],
      "english": [
        "Poshinchi naadu naathmaku - Jeevampu neetinichchun",
        "Poshinchu daani nithyamun - Jeevaahaarambuthonu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నే త్రప్పుత్రోవనుండగా - రక్షింప వెదకె నన్ను",
        "మోదంబుతో కనుగొనెన్ - నన్ మందలోన జేర్చెన్"
      ],
      "english": [
        "Ne thapputhrovanundagaa - Rakshimpa vedhake nannu",
        "Modhambutho kanugonen - Nan mandhalona jerchen"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాతాళం యొక్క చీకటి - నన్ భీతిపర్చబోదు",
        "నా దాపునుండ క్రీస్తేసు - నా ముందు నిల్చున్ సిల్వ"
      ],
      "english": [
        "Paathaalam yokka cheekati - Nan bheethiparchabodhu",
        "Naa daapununda Kreesthesu - Naa mundu nilchun silva"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా దృష్టిలో నాహారము - సిద్ధంబు జేతు వీవు",
        "నీ శుద్ధ ప్రేమానందముల్ - పారెన్ రక్షింప నన్ను"
      ],
      "english": [
        "Naa drushtilo naahaaramu - Siddhambu jethu veevu",
        "Nee shuddha premaanandhamul - Paaren rakshimpa nannu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ మంచి నైజంబో ప్రభూ - నిరంతరంబు నిల్చున్",
        "స్తోత్రింతు నిన్ను నీయింటన్ - ఓ కాపరి నా యేసు"
      ],
      "english": [
        "Nee manchi naijambo Prabhoo - Nirantharambu nilchun",
        "Sthothrinthu ninnu nee intan - O kaapari naa Yesu"
      ]
    }
  ]
}
