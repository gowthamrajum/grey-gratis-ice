{
  "song_name": "Nuthana Vatsaramu",
  "author": {
    "Authored by": "Bishop Pammi Daniel",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నూతన వత్సరము – శుభముల తోరణము",
      "ప్రార్ధన ప్రతిఫలము – ప్రభు యేసు బహుమానము"
    ],
    "english": [
      "Nuuthana vathsaramu – subhamula thoorannmu",
      "praarthanana prathiphalamu – prabhu yeasu bahumaanamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇది మహోదయం – మహిమ తేజోదయం",
        "దేవ కరుణోదయం – నీతి సూర్యోదయం"
      ],
      "english": [
        "Idi mahoodhayam – mahima theajoodhayam",
        "deava karunoodhayam – niithi suuryoodhayam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆశల పందిరి కూలిన – మోసపు ఊబిలో చిక్కిన",
        "దోషమె రాశిగ నిలచిన – యేసుని హస్తము కాచెను"
      ],
      "english": [
        "Aasala padhiri kuulina – mosapu uubiloo chikkina",
        "dhooshame raasiga nilachina – yeasuni hastamu kaachenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాతవి గతియించెను చూడు – క్రొత్తవాయెనునేడు",
        "నూతన ఆత్మతో పాడుము – నిత్యము క్రీస్తుని వేడుము"
      ],
      "english": [
        "Paathavi gathiyichenu chuudu – krotthavaayenuneadu",
        "nuuthana aathmathoo paadumu – nithyamu kriisthuni veadumu"
      ]
    }
  ]
}
