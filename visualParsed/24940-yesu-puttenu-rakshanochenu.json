{
  "song_name": "Yesu puttenu rakshanochchenu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Philip"
    ],
    "రచన": [
      "ఫిలిప్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "యేసు పుట్టెను రక్షనొచ్చెను",
      "నిత్య జీవమే మనకు ఇచ్చెను",
      "పాపలు పోగొట్టగా – మనకు మార్గమే చూపించగా",
      "దివినుండి భువికేగెను",
      "జన్మించినాడయ్యా – మహా మహిమగల యేసయ్యా",
      "అందరికీ రక్షకుడయ్యా – స్తుతి ఆరాధన చేద్దామయ్యా"
    ],
    "english": [
      "Yesu puttenu rakshanochchenu",
      "Nithya jeevame manaku ichchenu",
      "Paapalu pogottagaa – Manaku maargame choopinchagaa",
      "Divinundi bhuvikegenu",
      "Janminchinaadayyaa – Mahaa mahimagala Yesayyaa",
      "Andarikee rakshakudayyaa – Sthuthi aaraadhana cheddhaamayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీకున్న కష్టాలన్నీ నీకున్న బాధలన్నీ",
        "తీర్చగలడు యేసయ్య శక్తిగల వాడయ్యా",
        "యేసు రాజులకే రాజయ్యా",
        "యేసు ప్రభువులకే ప్రభువయ్యా"
      ],
      "english": [
        "Neekunna kashtaalannee neekunna baadhalannee",
        "Theerchagaladu Yesayya shakthigala vaadayyaa",
        "Yesu raajulake raajayyaa",
        "Yesu prabhuvulake prabhuvayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరలోకం చేరాలంటే యేసుతో ఉండాలంటే",
        "నమ్మాలి హృదయంలో సంపూర్ణ విశ్వాసంతో",
        "యేసు రాజులకే రాజయ్యా",
        "యేసు ప్రభువులకే ప్రభువయ్యా"
      ],
      "english": [
        "Paralokam cheraalante Yesutho undaalante",
        "Nammaali hrudayamlo sampoorna vishwaasamtho",
        "Yesu raajulake raajayyaa",
        "Yesu prabhuvulake prabhuvayyaa"
      ]
    }
  ]
}
