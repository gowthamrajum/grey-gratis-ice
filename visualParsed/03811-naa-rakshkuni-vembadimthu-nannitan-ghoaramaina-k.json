  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా రక్షకుని వెంబడింతు నన్నిటన్",
        "ఘోరమైన కొండలైన జంకొందను",
        "సురక్షితంబుగా నేను వెళ్ళెదన్",
        "పరమ కిరీట మొందువరకు",
        "యేసున్ నేను ఎన్నడెన్నడును",
        "ఆశతో నన్నిటన్ వెంబడింతును",
        "భాసురంబౌ ప్రభు వెంట కన్నుల్",
        "మూసికొని యెక్కడేని వెళ్ళుదున్"
      ],
      "english": [
        "Naa rakshakuni vembadinthu nannitan",
        "Ghoramaina kondalaina jankondhanu",
        "Surakshithambugaa nenu velledhan",
        "Parama kireeta mondhuvaraku",
        "Yesun nenu ennadennadunu",
        "Aashatho nannitan vembadinthunu",
        "Bhaasurambau Prabhu venta kannul",
        "Moosikoni ekkadeni velludhun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా యేసు తోడ వెళ్ళుచుందు నెల్లడన్",
        "బ్రయాసమైన లోయలైన భయపడన్",
        "దయజూపు యేసు నన్ను వెంబడించుచో",
        "భయమేల భువనంబులో దగన్"
      ],
      "english": [
        "Naa Yesu thoda velluchundhu nelladan",
        "Prayaasamaina loyalaina bhayapadan",
        "Dhayajoopu Yesu nannu vembadinchucho",
        "Bhayamela bhuvanambulo dhagan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా కాలమెల్ల యేసునందు నమ్ముదున్",
        "భీకరంపు వార్థియైన నే దాటుదున్",
        "నా కర్తతోడ నెందునైన నేగుదున్",
        "నాక మెక్కి తండ్రి జూచు వరకున్."
      ],
      "english": [
        "Naa kaalamella Yesunandu nammudhun",
        "Bheekarampu vaarthiyaina ne dhaatudhun",
        "Naa karthathoda nendhunaina negudhun",
        "Naaka mekki thandri joochu varakun."
      ]
    }
  ]
}
