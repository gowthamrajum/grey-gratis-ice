  },
  "main_stanza": {
    "telugu": [
      "ఇదిగో నీ రాజు వచ్చుచుండె",
      "సీయోను కుమారి సంతోషించు",
      "యేరూషలేం కుమారి ఉల్లసించు"
    ],
    "english": [
      "Idhigoa Nee Raaju Vachchuchunde",
      "Seeyoanu Kumaari Santhoashinchu",
      "Yaerooshalaem Kumaari Ullasinchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీదు రాజు నీతితో - దోషమేమియు లేకయే",
        "పాపరహితుడు ప్రభు - వచ్చుచుండె"
      ],
      "english": [
        "Needhu Raaju Neethithoa - Dhoashamaemiyu Laekayae",
        "Paaparahithudu Prabhu - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రక్షణ గలవాడుగా - అక్షయుండగు యేసుడు",
        "దీక్షతోడ యెరూషలోం - వచ్చుచుండె"
      ],
      "english": [
        "Rakshana Galavaadugaa - Akshayundagu Yaesudu",
        "Dheekshathoada Yerooshaloam - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సాత్వీకుండు యీ భువిన్ - అత్యంతమగు ప్రేమతో",
        "నిత్యరాజు నరులకై - వచ్చుచుండె"
      ],
      "english": [
        "Saathveekundu Yee Bhuvin - Athyanthamagu Praemathoa",
        "Nithyaraaju Narulakai - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దీనపరుడు నీ ప్రభు - ఘనత కలిగిన దేవుడు",
        "ప్రాణమీయ పాపులకై - వచ్చుచుండె"
      ],
      "english": [
        "Dheenaparudu Nee Prabhu - Ghanatha Kaligina Dhaevudu",
        "Praanameeya Paapulakai - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇలను గాడిద నెక్కియే - బాలుర స్తోత్రములతో",
        "బలుడగు నీ ప్రభు - వచ్చుచుండె"
      ],
      "english": [
        "Ilanu Gaadidha Nekkiyae - Baalura Sthoathramulathoa",
        "Baludagu Nee Prabhu - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దావీదు కుమారుడు - దేవుడు పాపులకు",
        "జయ గీతములతో - వచ్చుచుండె"
      ],
      "english": [
        "Dhaaveedhu Kumaarudu - Dhaevudu Paapulaku",
        "Jaya Geethamulathoa - Vachchuchunde"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసుని ప్రేమించుచు - హోసన్నా పాడెదము",
        "యేసుడిల వచ్చుచుండె - హల్లెలూయా"
      ],
      "english": [
        "Yaesuni Praeminchuchu - Hoasannaa Paadedhamu",
        "Yaesudila Vachchuchunde - Hallelooyaa"
      ]
    }
  ]
}
