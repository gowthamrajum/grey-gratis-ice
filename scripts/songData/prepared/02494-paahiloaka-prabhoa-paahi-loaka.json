{
  "song_name": "Paahiloaka Prabhoa Paahi Loaka Prabhoa",
  "author": {
    "Authored by": "",
    "రచన": "బన్యన్ జోసఫ్"
  },
  "main_stanza": {
    "telugu": [
      "పాహిలోక ప్రభో పాహి లోక ప్రభో",
      "పాహి యని వేఁడు మాం పాహిలోక ప్రభో"
    ],
    "english": [
      "Paahiloaka Prabhoa Paahi Loaka Prabhoa",
      "Paahi Yani Vaedu Maam Paahiloaka Prabhoa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్ను స్తుతియించుచు నీవు ప్రభుఁడ వని",
        "చెన్నుమీరఁగ నమ్మియున్నాము సత్ర్పభో"
      ],
      "english": [
        "Ninnu Sthuthiyinchuchu Neevu Prabhuda Vani",
        "Chennumeeraga Nammiyunnaamu Sathrpabhoa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్య మా తండ్రి భూలోకం బంతయు నిన్ను",
        "భక్తితో నారాధించుచున్నది మా ప్రభో"
      ],
      "english": [
        "Nithya Maa Thandri Bhooloakam Banthayu Ninnu",
        "Bhakthithoa Naaraadhinchuchunnadhi Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవ లోకాధిపతులు దూతల సమూహము",
        "దేవాయని కొల్చుచున్నారు నిన్నుఁ బ్రభో"
      ],
      "english": [
        "Dhaeva Loakaadhipathulu Dhoothala Samoohamu",
        "Dhaevaayani Kolchuchunnaaru Ninnu Brabhoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధ పరిశుద్ధ పరిశుద్ధ ప్రభువా",
        "పరలోక సేనాధిపతివైన మా ప్రభో"
      ],
      "english": [
        "Parishudhdha Parishudhdha Parishudhdha Prabhuvaa",
        "Paraloaka Saenaadhipathivaina Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇహలోకం బంతయుఁ బరలోకం బంతయు",
        "నీ మహి మహాత్మ్యముతో నున్నవని ప్రభో"
      ],
      "english": [
        "Ihaloakam Banthayu Baraloakam Banthayu",
        "Nee Mahi Mahaathmyamuthoa Nunnavani Prabhoa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కెరూబులను దూతలు సెరూపులను దూతలు",
        "తిరముగా నిన్ గొనియాడుచున్నారు మా ప్రభో"
      ],
      "english": [
        "Keroobulanu Dhoothalu Seroopulanu Dhoothalu",
        "Thiramugaa Nin Goniyaaduchunnaaru Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీ దపొస్తలుల మహిమగల సంఘము",
        "ప్రోదిగా నిన్నుతించుచున్నది మా ప్రభో"
      ],
      "english": [
        "Nee Dhaposthalula Mahimagala Sanghamu",
        "Proadhigaa Ninnuthinchuchunnadhi Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నిత్యము ప్రవక్తల యుత్తమ సంఘము",
        "సత్యముగ నిన్నుతించుచున్నది మా ప్రభో"
      ],
      "english": [
        "Nithyamu Pravakthala Yuththama Sanghamu",
        "Sathyamuga Ninnuthinchuchunnadhi Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "ధీర హత సాక్షుల వీర సైన్య మంతయు",
        "సారెకు నిన్నుతించుచున్నది మా ప్రభో"
      ],
      "english": [
        "Dheera Hatha Saakshula Veera Sainya Manthayu",
        "Saareku Ninnuthinchuchunnadhi Maa Prabhoa"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "నిత్య మహాత్మ్యముగల తండ్రి వైన నిన్నును",
        "నీదు పూజ్యుఁడగు నిజ అద్వితీయ సుతినిన్"
      ],
      "english": [
        "Nithya Mahaathmyamugala Thandri Vaina Ninnunu",
        "Needhu Poojyudagu Nija Adhvitheeya Suthinin"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "ఆదరణ కర్తయైనట్టి శుద్ధాత్ముని నంతట",
        "నుండు సభ యొప్పుకొనునునిన్ బ్రభో"
      ],
      "english": [
        "Aadharana Karthayainatti Shudhdhaathmuni Nanthata",
        "Nundu Sabha Yoppukonununin Brabhoa"
      ]
    }
  ]
