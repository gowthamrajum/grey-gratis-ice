  "main_stanza": {
    "telugu": [
      "సైన్యములకు అధిపతియగు దేవా నీకే స్తోత్రమయ్యా",
      "శౌర్యముగల బలమైన యెహెూవా నీకే ఘనతయ్యా",
      "స్తోత్రాలతో స్తుతి గానాలతో నిన్నే కొలిచెదను",
      "స్వరాలతో స్వరమండలాలతో నిన్నే పొగడెదను",
      "నీకే మహిమ. నీకే ఘనత. యుగయుగముల వరకు...."
    ],
    "english": [
      "Sainyamulaku adhipathiyagu Deva neeke sthothramayya",
      "Shauryamugala balamaina Yehova neeke ghanathayya",
      "Sthothraalatho sthuthi gaanaalatho ninne kolichedanu",
      "Swaraalatho swaramandalaalatho ninne pogadedhanu",
      "Neeke mahima. Neeke ghanatha. Yugayugamula varaku...."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శత్రువులే నన్ను చుట్టుముట్టగా",
        "వేటగాడు నాపై గురిపెట్టగా",
        "నీవే నీవే నా పక్షముగా పోరాడితివే",
        "నన్నే నన్నే నీ ఖడ్గముగా వాడుకొంటివే.",
        "నా బలము నాకేడెము నీవే యేసయ్యా",
        "నా శైలము నా శృంగము నీవే యేసయ్యా"
      ],
      "english": [
        "Shathruvule nannu chuttumuttagaa",
        "Vetagaadu naapai guripettagaa",
        "Neeve neeve naa pakshamugaa poraadithive",
        "Nanne nanne nee khadgamugaa vaadukontive.",
        "Naa balamu naakedemu neeve Yesayya",
        "Naa shailamu naa shrungamu neeve Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ప్రక్కన వేయిమంది పడియున్నను",
        "పదివేలమంది పొంచియున్నను",
        "పరాక్రమశాలిగ నా పక్షమే పోరాడితివే",
        "ప్రధాన కాపరిగా నిలిచి నన్నే విడిపించితివే",
        "నా దుర్గము నా గానము నీవే యేసయ్యా",
        "నా రక్షణ నా విమోచన నీవే యేసయ్యా"
      ],
      "english": [
        "Naa prakkana veyimandi padiyunnanu",
        "Padhivelamandhi ponchiyunnanu",
        "Paraakramashaaliga naa pakshame poraadithive",
        "Pradhaana kaaparigaa nilichi nanne vidipinchithive",
        "Naa durgamu naa gaanamu neeve Yesayya",
        "Naa rakshana naa vimochana neeve Yesayya"
      ]
    }
  ]
}
