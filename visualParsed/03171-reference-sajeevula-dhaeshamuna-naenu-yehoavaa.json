{
  "song_name": "Sajeevula dheshamuna nenu Yehova",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవా నీ ముఖమును నాకు - దాచకుము నా ప్రభువా",
      "నీ సేవకుని కోపముచే - త్రోసివేయకు యెహోవా"
    ],
    "english": [
      "Deva nee mukhamunu naaku - Dhaachakumu naa Prabhuvaa",
      "Nee sevakuni kopamuche - Throsiveyaku Yehova"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవా నా రక్షణకర్త - నీవే నాసహాయుడవు",
        "నన్ను దగనాడవలదు - నన్ను విడువకుము"
      ],
      "english": [
        "Deva naa rakshanakartha - Neeve naasahaayudavu",
        "Nannu dhiganaadavaladhu - Nannu viduvakumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాదు తలిదండ్రులు - నన్ను విడచినను",
        "నా దేవుండగు యెహోవా - నన్ను చేరదీయును"
      ],
      "english": [
        "Naadu thalidhandrulu - Nannu vidachinanu",
        "Naa dhevundagu Yehova - Nannu cheradheeyunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాకై పొంచియున్నట్టి - వారిని చూచి నన్ను",
        "సరళ దారిని నడుపు - మంచి మార్గము భోధించు"
      ],
      "english": [
        "Naakai ponchiyunnatti - Vaarini choochi nannu",
        "Sarala daarini nadupu - Manchi maargamu bodhinchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాపై లేచియున్నారు - అబద్ధ సాక్షులు క్రూరుల్",
        "నన్నప్పగించకు దేవా - నాదు విరోధులకు"
      ],
      "english": [
        "Naapai lechiyunnaaru - Abadhdha saakshulu kroorul",
        "Nannappaginchaku Deva - Naadu virodhulaku"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యెహోవా దయ పొందెదను  ||సజీవుల||",
        "ఇట్టి నమ్మకము లేని - యెడల నే నేమగుదును"
      ],
      "english": [
        "Yehova daya pondedanu ||Sajeevula||",
        "Itti nammakamu leni - Edala ne nemagudhunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ధైర్యము తెచ్చుకొని - నిబ్బర హృదయము గల్గి",
        "యెహోవా దేవుని కొరకు - కనిపెట్టుకొని యుండుము"
      ],
      "english": [
        "Dhairyamu thechchukoni - Nibbara hrudayamu galgi",
        "Yehova devuni koraku - Kanipettukoni yundumu"
      ]
    }
  ]
}
