    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రీస్తు నేడు లేచెను - మర్త్య దూత సంఘమా",
        "భూమి నాకాసంబులో - బాడు విందుచేతను"
      ],
      "english": [
        "Kreesthu Naedu Laechenu - Marthya Dhootha Sanghamaa",
        "Bhoomi Naakaasambuloa - Baadu Vindhuchaethanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మోక్ష మియ్య నాథుదు - యుద్ధమాడి గెల్చెను",
        "సూర్యుడుద్భవింపగ - జీకటుల్ గతించెను"
      ],
      "english": [
        "Moaksha Miyya Naathudhu - Yuddhamaadi Gelchenu",
        "Sooryududhbhavimpaga - Jeekatul Gathinchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బండ, ముద్ర, కావలి - అన్ని వ్యర్థమైనవి",
        "యేసు నరకంబును - గెల్చి ముక్తి దెచ్చెను"
      ],
      "english": [
        "Banda, Mudhra, Kaavali - Anni Vyarthamainavi",
        "Yaesu Narakambunu - Gelchi Mukthi Dhechchenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తు లేచినప్పుడు - చావు ముల్లు త్రుంచెను",
        "ఎల్లవారి బ్రోచును - మృత్యు వింక గెల్వదు"
      ],
      "english": [
        "Kreesthu Laechinappudu - Chaavu Mullu Thrunchenu",
        "Ellavaari Broachunu - Mruthyu Vinka Gelvadhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసు మృతి గెల్చెను - మేము కూడ గెల్తుము",
        "యేసుడుండు చోటుకు - మేము కీడబోదుము"
      ],
      "english": [
        "Yaesu Mruthi Gelchenu - Maemu Kooda Gelthumu",
        "Yaesudundu Choatuku - Maemu Keedaboadhumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "భూమి నాకాసంబులో - యేసు, నీకు స్తోత్రము",
        "మృత్యు సంహారకుండ - నీకేను విజయము"
      ],
      "english": [
        "Bhoomi Naakaasambuloa - Yaesu, Neeku Sthoathramu",
        "Mruthyu Samhaarakunda - Neekaenu Vijayamu"
      ]
    }
  ]
}
