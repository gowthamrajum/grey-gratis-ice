{
  "song_name": "Nee Mandhiraana",
  "author": {
    "Authored by": "Dr. K Wilson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ మందిరానా నేనుండిపోనా",
      "పగలు రేయి ప్రణుతించనా"
    ],
    "english": [
      "Nee mandhiraanaa nenundiponaa",
      "pagalu reyi pranuthinchanaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కోటి స్వరాలతో కొనియాడినను",
        "నీ కృప వర్ణించగలనా",
        "ఆకాశములు పట్టనివాడా",
        "ఆత్మను అలరించ రావా",
        "వేకువతోనే వేచియున్నాను",
        "వేదన తొలగించ రావా"
      ],
      "english": [
        "Koti swaraalatho koniyaadinanu",
        "nee krupa varninchagalanaa",
        "Aakaasamulu pattanivaadaa",
        "aathmanu alarincha raavaa",
        "Vekuvathone vechiyunnaanu",
        "vedhana tholagincha raavaa"
      ]
    }
  ]
}
