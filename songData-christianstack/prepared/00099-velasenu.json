  },
  "main_stanza": {
    "telugu": [
      "దేవుడే శరీరధారి ఆయెనా",
      "మహా ఘనుడే దీనుడై ఆ తొట్టిలో ఒదిగేనా",
      "ఎంతో సుందరుడు",
      "అతి పరిశుద్ధుడు",
      "దూత సైన్యముతో కొనియాడు దేవుడు.."
    ],
    "english": [
      "Dhevude shareeradhaari ayenaa",
      "Maha ghanude dheenudai aa thottilo odhige naa",
      "Entho sundharudu",
      "Athi parishuddhudu",
      "Dhootha sainyamutho koniyaadu dhevudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వెలిసెను రక్షకుడు",
        "మన శాపమంతా తొలగింప వొచ్చెను",
        "స్తుతులతో రారాజును",
        "కొనియాడి పాడి కీర్తించెదము"
      ],
      "english": [
        "Velisenu rakshakudu",
        "Mana saapamantha tholaginpa vochchenu",
        "Sthuthulatho raaraajunu",
        "Koniyaadi paadi keerthinchedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "హల్లెలూయా హల్లెలూయా",
        "ఆరాధనా ఆరాధనా"
      ],
      "english": [
        "Halleluya halleluya",
        "Aaraadhana aaraadhana"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రక్షణ వొచ్చెనే",
        "శ్రీ యేసుని ఆగమనం",
        "లోక పాప పరిహారం",
        "విడుదల కలిగెనే",
        "చిందిన పరిశుద్ధుని రక్తం",
        "ద్వారా మోక్షానికి మార్గం"
      ],
      "english": [
        "Rakshana vochchene",
        "Sri Yesuni aagamanam",
        "Loka paapa pariharam",
        "Vidudhala kaligene",
        "Chindhina parishuddhuni raktham",
        "Dhvaara mokshaanki maargam"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసుని విశ్వసించు ప్రతి వానికి",
        "నిత్య జీవమును ఇచ్చుటకై",
        "ఆ దేవుడే తన ప్రియ కుమారుని పంపెను",
        "ప్రతి బంధకమునుండి విడిపించి",
        "శాపమునంత తొలగించి",
        "ఆ దైవమె కుమారుడై మోక్షానికి మార్గం ఆయెను."
      ],
      "english": [
        "Yesuni vishvasinchu prathi vaaniki",
        "Nithya jeevamunu icchutakai",
        "Aa dhevude thana priya kumaaruni pampenu",
        "Prathi bandhakamunundi vidipinchi",
        "Shaapamunantha tholaginchi",
        "Aa dhaivame kumaarudai mokshaanki maargam ayenu"
      ]
    }
  ]
}
