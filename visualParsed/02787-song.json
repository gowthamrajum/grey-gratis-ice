{
  "song_name": "Daiva prema pruthviloni yannitini",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "చార్లెస్ వెస్లీ"
    ]
  },
  "main_stanza": {
    "telugu": [
      "దైవ ప్రేమ పృథ్విలోని",
      "యన్నిటిని మించును",
      "యేసు మాలో నివసించు",
      "యది మా విముక్తియే",
      "నీ కమూల్య ప్రేమ యుండు",
      "నీవు దాసుల మైన మమ్ముఁ",
      "గృపతో రక్షించుము."
    ],
    "english": [
      "Daiva prema pruthviloni",
      "Yannitini minchunu",
      "Yesu maalo nivasinchu",
      "Yadhi maa vimukthiye",
      "Nee kamoolya prema yundu",
      "Neevu daasula maina mammu",
      "Krupatho rakshinchumu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "మమ్ము సంరక్షించు శక్తి",
        "నీకుండు, మా ప్రభువా",
        "ఎన్నఁ డెనఁ డేని నీదు",
        "సన్నిధిని బాయుము",
        "నిన్ స్తుతించుచుండి మేము",
        "సర్వదా సేవింతుము.",
        "నిన్ బ్రార్థించి పూర్ణప్రేమ",
        "మే మతిశయింతుము"
      ],
      "english": [
        "Mammu samrakshinchu shakthi",
        "Neekundu, maa Prabhuvaa",
        "Enna denadeni needu",
        "Sannidhini baayumu",
        "Nin sthuthinchuchundi memu",
        "Sarvadaa sevinthumu.",
        "Nin braarthinchi poornaprema",
        "Me mathishayinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రొత్తగా మమ్ము సృజించి",
        "పాప మెల్లఁ బాపుము",
        "మాకు స్వస్థత నొసంగి",
        "గొప్ప రక్షఁ జూపుము",
        "భక్తి యభివృద్ది పొంది",
        "స్వర్గమందుఁ జేరగా",
        "వింత నొంది ప్రేమ స్తుతి",
        "నీకర్పింతు మెప్పుడు."
      ],
      "english": [
        "Krotthagaa mammu srujinchi",
        "Paapa mella baapumu",
        "Maaku swasthatha nosangi",
        "Goppa raksha joopumu",
        "Bhakthi yabhivruddhi pondi",
        "Swargamandhu jeragaa",
        "Vintha nondi prema sthuthi",
        "Neekarpinthu meppudu."
      ]
    }
  ]
}
