  "main_stanza": {
    "telugu": [
      "నీ ప్రేమే అద్బుతం నీ ప్రేమే మధురం",
      "నీ ప్రేమే కదా.. మమ్మును కాచేన్"
    ],
    "english": [
      "Nee preme adbhutham nee preme madhuram",
      "nee preme kadaa.. mammunu kaachen"
    ]
  },
