  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసూ, ఆత్మ ప్రియుడా - నిన్ను నాశ్రయించితి",
        "లేవగా దరంగముల్ - గాలివాన కొట్టగా",
        "జీవ బాధలన్నిటన్ - నన్ను దాచు రక్షకా",
        "నన్ను నడ్పి రేవునన్ - ఆత్మ జేర్చుమీ తుదన్"
      ],
      "english": [
        "Yesoo, aathma priyudaa - Ninnu naashrayinchithi",
        "Levagaa tharangamul - Gaalivaana kottagaa",
        "Jeeva baadhalannitan - Nannu daachu rakshakaa",
        "Nannu nadpi revunan - Aathma jerchumee thudan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దిక్కులేని యాత్మకు - వేరే ప్రాపు లేదిక",
        "నొంటిగాను విడ్వక - నన్ను యాదరించుమీ",
        "నిన్నే నమ్మియుంటిని - నీవే నా సహాయము",
        "కాపులేని నా తలన్ - నీదు రెక్క క్రమ్మనీ"
      ],
      "english": [
        "Dikkuleni yaathmaku - Vere praapu ledika",
        "Nontigaanu vidvaka - Nannu yaadharinchumee",
        "Ninne nammiyuntini - Neeve naa sahaayamu",
        "Kaapuleni naa thalan - Needu rekka krammanee"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తు నిన్ను గోరుదున్ - దొర్కునన్ని నీకడన్",
        "పడ్డహీను నెత్తుమీ - స్వస్థపర్చు రోగులన్",
        "న్యాయ శుద్ధ నామము - నీదే నేను పాపిని",
        "నేను పాపపూర్ణుడన్ - నీవు ప్రేమరూపివి"
      ],
      "english": [
        "Kreesthu ninnu gorudhun - Dhorkunanni neekadan",
        "Paddaheenu netthumee - Svasthaparchu rogulan",
        "Nyaaya shuddha naamamu - Neede nenu paapini",
        "Nenu paapapoornudan - Neevu premaroopivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపమెల్ల మాంపగా - నీదు ప్రేమ చాలును",
        "మాంపు నీళ్ళు నా యెదన్ - శుద్ధిచేయగా నిమ్ము",
        "నీవు జీవపూటవు - త్రాగనిమ్ము నీదరిన్",
        "పుట్టి నాదు నాత్మలో - నెల్ల వేళ పారుమీ"
      ],
      "english": [
        "Paapamella maanpagaa - Needu prema chaalunu",
        "Maanpu neellu naa edhan - Shuddhicheyagaa nimmu",
        "Neevu jeevapootavu - Thraaganimmu needharin",
        "Putti naadu naathmalo - Nella vela paarumee"
      ]
    }
  ]
}
