{
  "song_name": "Inti Peru",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తల్లితండ్రులెవరైనా ఇంటి పేరేది నీకున్నా",
      "పుట్టింది తోలినరుడే దేవునికి కుమారుడిగా",
      "మనమంతా పిల్లలుగా ఉండాలి కుటుంబముగా"
    ],
    "english": [
      "Thallidhandrulevarainaa inti peredhi neekunnaa",
      "puttindhi tholonarude dhevuniki kumaarudigaa",
      "manamanthaa pillalugaa undaali kutumbamugaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదామునైనా, ఆ హవ్వనైనా ఆ దేవుడే చేసాడుగా",
        "ఆ ఒకని నుండే ఎ జాతియైన నరులందరు వచ్చారుగా",
        "తల్లితండ్రి పెరుముందు ఇంటి పెరుంటే",
        "ప్రతి తండ్రి పెరుముందు ఇంటి పేరుంటే",
        "మన ఇంటికి పెరూ ఉంటె – ఆదాము ఇల్లే ఆ దేవుడే",
        "తన ఇంటి పెరె ఆ దేవుడే",
        "ఆదాము దేవునికి కుమారుడు",
        "ఆదాము హవ్వ తన తరము వారికి దేవుని సంతానమని చెప్పారుగా",
        "తమ పిల్లలంతా దేవుని కుమారులని ఆనాడు అందరికి చెప్పారుగా",
        "నేడున్న ఇంటిపెరు ఎలా వచ్చిందనీయంటే",
        "మన తండ్రి ఇంటి పేరే మనకొచ్చిదనియంటే",
        "మన ఇంటికి పెరు ఉంటె",
        "ఆదాము తండ్రే ఆ దేవుడే",
        "ఆ ఇంటి పేరే మనకుండాలిలే.."
      ],
      "english": [
        "Aadhaamunainaa, aa havvanainaa aa dhevude chesaadugaa",
        "aa okani nunde ey jaathiyaina narulandharu vacchaarugaa",
        "thallithandri perumundhu inti perunte",
        "prathi thandri perumundhu inti perunte",
        "mana intiki peru unte – aadhaamu ille aa dhevude",
        "aadhaamu dhevuniki kumaarudu",
        "Aadhaamu havva thana tharmau vaariki dhevuni santhanamani cheppaarugaa",
        "thama pillalanthaa dhevuni kumaarulani aanaadu andhariki cheppaarugaa",
        "nedunna intiperu elaa vachindhaneeyante",
        "mana thandri inti pere manakocchindiyante",
        "mana intiki peru unte",
        "aadhaamu thandre aa dhevude",
        "aa inti pere manakundaalile"
      ]
    }
  ]
}
