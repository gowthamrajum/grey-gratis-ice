      "english": [
        "Kruthagnatha chellinchedha nee balidhaanamunakai",
        "Anthuleni nee goppa premakai",
        "Anantha jeevamu mahima nireekshana",
        "Naa jeevithamunake aadhaaramaaye",
        "Kreesthuke paadedan halleluya"
