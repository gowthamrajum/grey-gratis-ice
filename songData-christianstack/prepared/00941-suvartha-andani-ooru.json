{
  "song_name": "Suvartha Andani Ooru",
  "author": {
    "Authored by": "Dr. K John Mangacharyulu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సువార్త అందని ఊరు ఉండనే కూడదు",
      "సంఘము లేని గ్రామం అసలుండకూడదు",
      "ఇదే ఇదే ఇదే మా లక్ష్యం",
      "ఇదే ఇదే ఇదే మా ఆశయం"
    ],
    "english": [
      "Suvaartha andhani ooru undaney koodadu",
      "sangamu leni graamam asalundakoodadhu",
      "idey idey idey maa lakshyam",
      "idey idey idey maa aaSayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లక్ష్యసాధనలో నే లక్ష్యపెట్టను నా ప్రాణం",
        "సిలువను మోయుచు శ్రమలు సహించుచు",
        "సాగెదను మునుముందుకు చాటెదను సువార్తను",
        "పస్తులైన ఉంటాగాని ప్రభువు సేవను విడువను నేను",
        "నిందలైన మోస్తాగాని నీతినెపుడు విడువను నేను",
        "సాగెదను మునుముందుకు చాటెదను సువార్తను",
        "యేసురాజు ముందుగా సాగిపోవుచుండగా",
        "నిండుగా మనకండగా కొండగా తానుండగా",
        "సాగెదను మునుముందుకు చాటెదను సువార్తను"
      ],
      "english": [
        "Ee lakshya saadhanalo ne lakshyapettanu naa praanam",
        "siluvanu moyuchu sramalu sahinchuchu",
        "saagedhanu munumundhuku chaatedhanu suvaarthanu",
        "Pasthulaina untaagaani prabhuvu sevanu viduvanu nenu",
        "nindhalaina moasthaagaani neethinepudu viduvanu nenu",
        "saagedhanu munumundhuku chaatedhanu suvaarthanu",
        "Yesuraaju mundugaa saagipovuchundagaa",
        "ninduga manakandaga kondaga thaanundaga",
        "saagedhanu munumundhuku chaatedhanu suvaarthanu"
      ]
    }
  ]
}
