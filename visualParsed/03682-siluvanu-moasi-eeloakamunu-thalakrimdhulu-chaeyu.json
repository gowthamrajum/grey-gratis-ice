      "english": [
        "Paathaalamunaku konipoyedi nee",
        "Paapa nidhranu vidanaadu mika",
        "Siluva marmamu nerugu mipude",
        "Kunikedu samayamu kaadidi priyudaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షింపబడుట కాశించినతో",
