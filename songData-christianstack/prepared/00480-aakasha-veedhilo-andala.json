{
  "song_name": "Aakasha Veedhilo Andala",
  "author": {
    "Authored by": "Suresh babu panthagani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆకాశ వీధిలో – అందాల తార వెలసి",
      "అవనికి అంతా – అందాలు తెచ్చేనంటా",
      "బెత్లెహేము పురములో – రారాజు పుట్టాడని",
      "ప్రవచనాలు నెరవేర్చి – ప్రభువు ఇలకు వచ్చాడని"
    ],
    "english": [
      "Aakasha veedhilo – andhala thaara velasi",
      "avaniki anthaa – andhaalu thechenantaa",
      "bethlehemu puramulo – raaraju puttaadani",
      "pravachanaalu neraverchi – prabhuvu ilaku vachaadani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హ్యాపీ హ్యాపీ క్రిస్మస్ – మెర్రీ మెర్రీ క్రిస్మస్"
      ],
      "english": [
        "Happy happy christmas – merry merrry christmas"
      ]
    }
  ]
}
