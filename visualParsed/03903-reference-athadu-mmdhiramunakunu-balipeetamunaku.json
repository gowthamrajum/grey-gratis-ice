{
  "song_name": "Athadu mandhiramunakunu, balipeethamunakunu chuttu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యేసు ప్రభుని సంకల్పములు మారవు ఎన్నటికి",
      "మహాప్రభావము ఆయనకే యుగయుగముల వరకు"
    ],
    "english": [
      "Yesu prabhuni sankalpamulu maaravu ennatiki",
      "Mahaaprabhaavamu aayanake yugayugamula varaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మోషేను ఏర్పరచుకొనె తన ప్రజలను విడిపింప",
        "చేసెనుగా ఘన కార్యములు వారి మార్గములో",
        "త్రోసినను నడిపించెను వారిని విసుగక తనత్రోవ"
      ],
      "english": [
        "Moshenu erparachukone thana prajalanu vidipimpa",
        "Chesenugaa ghana kaaryamulu vaari maargamulo",
        "Throsinanu nadipinchenu vaarini visugaka thanathrova"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కొండపై చూపిన విధముననే మందిరమును నిలిపె",
        "ఆవరణము నేర్పరచెను నిండుగ తెరవేసె",
        "దేవుని కార్యములను మోషే సంపూర్ణము చేసె"
      ],
      "english": [
        "Kondapai choopina vidhamunane mandhiramunu nilipe",
        "Aavaranamu nerparachenu ninduga theravese",
        "Devuni kaaryamulanu Moshe sampoornamu chese"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మందిరపని అంతయును సంపూర్ణము చేయగనే",
        "సుందరముగ నొక మేఘము గుడారమును కమ్మె",
        "మందిర మంతయు యెహోవా తేజస్సుతో నిండెన్"
      ],
      "english": [
        "Mandhirapani anthayunu sampoornamu cheyagane",
        "Sundharamuga noka meghamu gudaaramunu kamme",
        "Mandira manthayu Yehova thejassutho ninden"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నావన్నియును నీవెగదా అమరుడవగు దేవా",
        "నీవన్నియు నాకిచ్చితివి నీకృపను బట్టి",
        "మహిమ పరతును ఎల్లప్పుడు ఇహపరములయందు"
      ],
      "english": [
        "Naavanniyunu neevegadhaa amarudavagu Deva",
        "Neevanniyu naakichchithivi neekrupanu batti",
        "Mahima parathunu ellappudu ihaparamulayandhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరిశుద్ధ జనమా క్రీస్తు ప్రభుని బట్టి",
        "పరిశుద్ధ దేవుని చిత్తమును నెరవేర్చుచు ఇలలో",
        "నిరతము మహిమ స్తుతిఘనత చెల్లించెద మెపుడు"
      ],
      "english": [
        "Parishuddha janamaa Kreesthu prabhuni batti",
        "Parishuddha Devuni chitthamunu neraverchuchu ilalo",
        "Nirathamu mahima sthuthighanatha chellincheda mepudu"
      ]
    }
  ]
}
