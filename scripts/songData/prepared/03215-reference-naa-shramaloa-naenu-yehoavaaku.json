{
  "song_name": "Naa Shramaloa Naenu Yehoavaaku MoRalidithini",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా శ్రమలో నేను యెహోవాకు మొఱలిడితిని"
    ],
    "english": [
      "Naa Shramaloa Naenu Yehoavaaku MoRalidithini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాకాయన ఉత్తరమిచ్చెన్ - అబద్ధమాడు వారి నుండి",
        "యెహోవా నా ప్రాణమును విడిపించుము"
      ],
      "english": [
        "Naakaayana Uththaramichchen - AbadhDhamaadu Vaari NuMdi",
        "Yehoavaa Naa PraaNamunu VidipiMchumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మోసకరమగు నాలుకా - ఆయన నీకేమి చేయును?",
        "తంగేడు నిప్పుల బాణముల నీపై వేయును"
      ],
      "english": [
        "Moasakaramagu Naalukaa - Aayana Neekaemi Chaeyunu?",
        "ThMgaedu Nippula BaaNamula Neepai Vaeyunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అయ్యో నేను మెషెకులో - పరదేశినై యున్నాను",
        "కేదారు గుడారముల యొద్ద కాపురమున్నాను"
      ],
      "english": [
        "Ayyoa Naenu MeShekuloa - Paradhaeshinai Yunnaanu",
        "Kaedhaaru Gudaaramula Yodhdha Kaapuramunnaanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కలహప్రియుని యొద్ద - చిరకాలము నివసించితిని",
        "నేను కోరునది సమాధానమే"
      ],
      "english": [
        "Kalahapriyuni Yodhdha - Chirakaalamu NivasiMchithini",
        "Naenu Koarunadhi SamaaDhaanamae"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అయినను మాట నా నోట వచ్చిన తోడనే వారు",
        "యుద్ధమునకు సిద్ధము అయ్యెదరు"
      ],
      "english": [
        "Ayinanu Maata Naa Noata Vachchina Thoadanae Vaaru",
        "YudhDhamunaku SidhDhamu Ayyedharu"
      ]
    }
  ]
}
