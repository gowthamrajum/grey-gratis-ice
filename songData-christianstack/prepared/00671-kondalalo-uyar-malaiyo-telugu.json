{
  "song_name": "Kondalalo (Uyar Malaiyo Telugu)",
  "author": {
    "Authored by": "John Jebaraj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గాఢాంధ కారములో నీవే నా గుడారము నీవే ఆశ్రయము",
      "పచ్చికగల చోట్ల పరుండజేయును నీవే నా బలము",
      "నను విడువని ఎడబాయని వాడవు",
      "ప్రతి స్థలములో నను కాచే వాడవు"
    ],
    "english": [
      "Ghaadaandha kaaramulo neeve naa gudaaramu neeve aasrayamu",
      "pachikagala chotla parundajeyunu neeve naa balamu",
      "nanu viduvani edabaayani vaadavu",
      "prathi sthalamulo nanu kaachevaadavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కొండలలో లోయలలో",
        "ఎక్కడైనా నీవే నా దేవుడవు",
        "నిన్ను నేను ఆరాధించెదను నా యేసుదేవ",
        "నీ నామము కొనియాడేదను"
      ],
      "english": [
        "Kondalalo loyalalo",
        "ekkadaina neeve naa devudavu",
        "ninnu nenu aaraadhinchedhanu naa yesu deva",
        "nee naamamu koniyaadedhanu"
      ]
    }
  ]
}
