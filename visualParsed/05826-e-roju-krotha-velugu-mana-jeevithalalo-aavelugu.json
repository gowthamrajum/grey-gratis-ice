      ],
      "english": [
        "Balaheenulaku balamaina",
        "Anugrahame Immaanuyelu ||Eeroju||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ జననం మానవాళికి",
        "సంతోషం కలుగజేసెను ॥2॥"
      ],
      "english": [
        "Nee jananam maanavaaliki",
        "Santhosham kalugajesenu ॥2॥"
      ]
