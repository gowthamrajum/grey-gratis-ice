{
  "song_name": "Ninu Matrame Ne Nammanaya",
  "author": {
    "Authored by": "John J",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిను మాత్రమే నే నమ్మానయా",
      "నీవు మాత్రమే నా ధైర్యం యేసయ్యా",
      "నీ బాహుబలమే నడిపించును",
      "నా స్థితులన్నిటిని సరిచేయును",
      "కృప చూపువాడవయా నీ పిల్లలకు"
    ],
    "english": [
      "Ninu maatrame ne nammaanayyaa",
      "Neevu maatrame naa dhairyam Yesayyaa",
      "Nee baahubalame nadipinchunu",
      "Naa sthithulannitini saricheyunu",
      "Krupa choopuvaadavayyaa nee pillalaku krupa choopuvaadavayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు సెలవియ్యగా కలుగనిదేముంది",
        "వాక్కును పంపగా జరుగనిదేముంది",
        "సకలము నీదెనయా శ్రీమంతుడా",
        "స్తుతి నీకు పాడెదనయా",
        "సమకూర్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Neevu selaviyyaga kaluganidhemundhi",
        "Vaakkunu pampaga jaruganidhemundhi",
        "Sakalamu needhenayyaa shreemanthudaa",
        "Sthuthi neeku paadedhanayyaa",
        "Samakoorchuvaadavayyaa nee pillalaku samakoorchuvaadavayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ముందు నీవుండగా ఎదురొచ్చువాడెవడు",
        "కార్యము చేయగా అడ్డుపడువాడెవడు",
        "యుద్ధము నీదెనయా ఓ శూరుడా",
        "ముందుకు సాగెదనయా",
        "జయమిచ్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Naa mundhu neevundaga edhurochhuvaadevedu",
        "Kaaryamu cheyaga addupaduvaadevedu",
        "Yuddhamu needhenayyaa oh shoorudaa",
        "Mundhuku saagedhanayyaa",
        "Jayamichhuvaadavayyaa nee pillalaku jayamichhuvaadavayyaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు కరుణించగా కాదనువాడెవడు",
        "శక్తితో నింపగా ఓడించువాడెవడు",
        "సాయము నీదెనయా సహాయకుడా",
        "నీలో దాగెదనయా",
        "బలమిచ్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Neevu karuninchaga kaadhanuvaadevedu",
        "Shakthitho nimpaga odinchuvaadevedu",
        "Sahaayamu needhenayyaa sahaayakudaa",
        "Neelo dhaagedhanayyaa",
        "Balamichhuvaadavayyaa nee pillalaku balamichhuvaadavayyaa"
      ]
    }
  ]
}
