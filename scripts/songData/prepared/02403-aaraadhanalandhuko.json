        "Lokambu Naadantu Aasinchithini",
        "Ayinaa Neevu Rakshana Nivva",
        "Preminchi Pampithivi Yesuprabhuni"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తెలిసికొంటిని నా యేసు నిన్ను",
