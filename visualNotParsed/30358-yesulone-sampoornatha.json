  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసయ్యా నీలోనే ఉన్నది మాకు సంపూర్ణత",
        "నీ సన్నిధిలోనే దొరికెను మాకు పరిపూర్ణత",
        "క్రీస్తులోనే కలిగెను మాకు నూతన జీవము",
        "నీ కృపలోనే దొరికెను పాప విమోచనము",
        "యేసయ్యా… నీలోనే సంపూర్ణత"
      ],
      "english": [
        "Yesayyaa neelone unnadi maaku sampoornatha",
        "Nee sannidhilone dorikenu maaku paripoornatha",
        "Kreesthulone kaligenu maaku noothana jeevamu",
        "Nee krupalone dorikenu paapa vimochanamu",
        "Yesayyaa… neelone sampoornatha"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
