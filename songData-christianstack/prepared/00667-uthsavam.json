    "english": [
      "Pasibaalude raajugaa janminchenu",
      "lokamunaku velugai dhigivachenu",
      "aakaasamulo dhevadhoothalu aaraadhinchenu",
      "bhulokamulo santhoshamutho pongipoyenu",
      "cheekati jeevithaalanu veliginchenu"
    ]
  },
