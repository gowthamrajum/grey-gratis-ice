      ],
      "english": [
        "Ilalona naa yaathranu mugisi",
        "Paralokamunu ne cheruvela",
        "Vevela doothalu geethaalu paada",
        "Neepaadha kamalaala nanu odhigiponi (2)  ||Paramuna||"
      ]
    }
  ]
