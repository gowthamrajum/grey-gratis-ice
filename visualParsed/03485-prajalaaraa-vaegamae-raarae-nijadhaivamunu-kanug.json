  },
  "main_stanza": {
    "telugu": [
      "ప్రజలారా వేగమే రారే - నిజదైవమును కనుగొనరే",
      "ప్రతివాడు మోక్షము జేర - ప్రభుయేసు వార్తను వినరే"
    ],
    "english": [
      "Prajalaaraa vegame raare - Nijadhaivamunu kanugonare",
      "Prathivaadu mokshamu jera - Prabhuyesu vaarthanu vinare"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపాత్ములనబడువారి - భారంబుదీయనుగోరి",
        "ప్రభు యేసు జూపినదారి - పరమందు సుఖమిడుదారి"
      ],
      "english": [
        "Paapaathmulanabaduvaari - Bhaarambudheeyanugori",
        "Prabhu Yesu joopinadhaari - Paramandu sukhamidudhaari"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేజాతి వారలనైనన్ - యే దేశవాసులనైనన్",
        "యేమైన భేదములేక - యేసయ్య బ్రోచును వేగ"
      ],
      "english": [
        "Ejaathi vaaralanainan - E dheshavaasulanainan",
        "Emaina bhedhamuleka - Yesayya brochunu vega"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపాత్ములే తనసుతులు - ప్రభు యేసునికి స్నేహితులు",
        "నీ పాపమెల్ల బోయెన్ - నీకింక మోక్షము కలుగున్"
      ],
      "english": [
        "Paapaathmule thanasuthulu - Prabhu Yesuniki snehithulu",
        "Nee paapamella boyen - Neekinka mokshamu kalugun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రయాసపడి భారమును - మోసెడి ఓ ప్రజలారా",
        "ప్రభు యేసు క్రీస్తే మీకు - ప్రశాంతినిచ్చును రండి"
      ],
      "english": [
        "Prayaasapadi bhaaramunu - Mosedi o prajalaaraa",
        "Prabhu Yesu Kreesthe meeku - Prashaanthinichchunu randi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసయ్యగాకను వేరే - యెవరైన లేరిక రారే",
        "దోషంబులెల్లను బాపి - ఆశీర్వదించును గాచి"
      ],
      "english": [
        "Yesayyagaakanu vere - Evaraina lerika raare",
        "Dhoshambulellanu baapi - Aasheervadhinchunu gaachi"
      ]
    }
  ]
