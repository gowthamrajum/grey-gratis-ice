{
  "song_name": "Athi thvaralo",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Raj prakash paul"
    ],
    "రచన": [
      "బ్రదర్ రాజ్ ప్రకాష్ పాల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అతి త్వరలో వచ్చుచున్నాడు యేసయ్య మేఘాసీనుడిగా",
      "ఆర్భాటముతో బూరధ్వనితో",
      "మహా మహిమ ప్రభావముతోను దూతల సమూహముతోను"
    ],
    "english": [
      "Athi thvaralo vachchuchunnaadu Yesayya meghaaseenudigaa",
      "Aarbhaatamutho booradhvanitho",
      "Mahaa mahima prabhaavamuthonu doothala samoohamuthonu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోక కార్యాలందు ఎంత కాలం సంతసిస్తావు",
        "ఆ యేసు పిలుపుకు నీవు పలుకవా",
        "ఈనాడే ఆయన వైపు తిరుగుము నీ బ్రతుకునే ఆయన కర్పంచుము"
      ],
      "english": [
        "Ee loka kaaryaalandhu entha kaalam santhasisthaavu",
        "Aa Yesu pilupuku neevu palukavaa",
        "Eenaade aayana vaipu thirugumu nee brathukune aayana karpinchumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవుని ఉగ్రత త్వరలో రానైయున్నది",
        "కాల్చివేయును అంధకార సంబంధులను",
        "నీతిమంతులు పరలోకం స్వతంత్రించుకొందురు"
      ],
      "english": [
        "Devuni ugratha thvaralo raanaiyunnadhi",
        "Kaalchiveyunu andhakaara sambandhulanu",
        "Neethimanthulu paralokam svathanthrinchukondhuru"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిత్య జీవము కలిగి ఆనందింతురు",
        "ఇక కొంతకాలమే ఈ లోక కష్టాలు",
        "ఈ జీవితాంతము వరకు యేసుకై నిలిచెదము"
      ],
      "english": [
        "Nithya jeevamu kaligi aanandhinthuru",
        "Ika konthakaalame ee loka kashtaalu",
        "Ee jeevithaanthamu varaku Yesukai nilichedhamu"
      ]
    }
  ]
}
