  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శ్రీ యేసు స్వామి తిరిగి - మోక్షంబు జేరగా",
        "ఒక్కాదరణ కర్తను - వొసంగెను"
      ],
      "english": [
        "Shree Yesu swaami thirigi - Mokshambu jeragaa",
        "Okkaadharana karthanu - Vosangenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆ దేవునాత్మ ప్రీతిగా - మదిన్ వసించును",
        "విధేయులైన మనలన్ - బాలించును"
      ],
      "english": [
        "Aa Dhevunaathma preethigaa - Madhin vasinchunu",
        "Vidheyulaina manalan - Baalinchunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సద్గుణమున్న మనకు - ఆ యాత్మ దానము",
        "శోధించు దుష్టుని సహా - జయించును"
      ],
      "english": [
        "Sadgunamunna manaku - Aa yaathma daanamu",
        "Shodhinchu dushtuni sahaa - Jayinchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఓ దేవునాత్మ మమ్మును - విశుద్ధి పర్చుము",
        "మా కృదయంబులో సదా – వసించుము"
      ],
      "english": [
        "O Dhevunaathma mammunu - Vishuddhi parchumu",
        "Maa hrudhayambulo sadaa – Vasinchumu"
      ]
    }
  ]
