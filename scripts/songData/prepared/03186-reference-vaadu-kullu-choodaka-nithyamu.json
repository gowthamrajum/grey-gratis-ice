{
  "song_name": "Vaadu Kullu Choodaka Nithyamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సర్వజనులారా వినుడి - మీరేకంబుగా వినుడి"
    ],
    "english": [
      "Sarvajanulaaraa Vinudi - Meeraekambugaa Vinudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోక నివాసులారా సామాన్యులు ఘనులేమి",
        "దరిద్రులు ధనికులేమి - సర్వజనులారా వినుడి"
      ],
      "english": [
        "Loaka Nivaasulaaraa Saamaanyulu Ghanulaemi",
        "Dharidhrulu Dhanikulaemi - Sarvajanulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా హృదయ ధ్యానము పూర్ణ - వివేకమును గూర్చినది",
        "నే పల్కెద జ్ఞానాంశముల - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Naa Hrudhaya Dhyaanamu Poorna - Vivaekamunu Goorchinadhi",
        "Nae Palkedha Jnaanaamshamula - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గూడార్థాంశము వినెద - చేతబట్టి సితార",
        "మర్మము దెల్పెద నేను - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Goodaarthaamshamu Vinedha - Chaethabatti Sithaara",
        "Marmamu Dhelpedha Naenu - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాకై పొంచిన దోషుల - క్రియలు నన్ను చుట్టన్",
        "ఆపదలో భయపడనేల - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Naakai Ponchina Dhoashula - Kriyalu Nannu Chuttan",
        "Aapadhaloa Bhayapadanaela - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తమ ధన సంపదనుబట్టి - పొగడుకొనెడు వారికి",
        "నేనేల భయపడవలెను - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Thama Dhana Sampadhanubatti - Pogadukonedu Vaariki",
        "Naenaela Bhayapadavalenu - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఎవడేరీతినైన నిత్యము బ్రతుకునట్లు",
        "సోదరుని రక్షించలేడు - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Evadaereethinaina Nithyamu Brathukunatlu",
        "Soadharuni Rakshinchalaedu - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "వాని నిమిత్తము దైవ - సన్నిధి ప్రాయశ్చిత్తము",
        "చేయువాడెవ్వడు లేడు - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Vaani Nimiththamu Dhaiva - Sannidhi Praayashchiththamu",
        "Chaeyuvaadevvadu Laedu - Sarva Janulaaraa Vinudi"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ప్రాణ విమోచన ధనము - బహు గొప్ప దెన్నటికిని",
        "తీరక యుండవలసినదే - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Praana Vimoachana Dhanamu - Bahu Goppa Dhennatikini",
        "Theeraka Yundavalasinadhae - Sarva Janulaaraa Vinudi"
      ]
    }
  ]
}
