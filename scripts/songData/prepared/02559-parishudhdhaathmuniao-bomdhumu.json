{
  "song_name": "Parishudhdhaathmuniao Bomdhumu",
  "author": {
    "Authored by": "",
    "రచన": "మండపాక కేశవరాయశర్మ"
  },
  "main_stanza": {
    "telugu": [
      "పరిశుద్ధాత్మునిఁ బొందుము ప్రభువిచ్చెడు వరసహాయునిఁ బొం దుము",
      "పరిశుద్ధవర్తనకు పరమసాహాయ్యంబుఁ",
      "పరముఁజేరువఱకు పరి పూర్తిగా దొరకు"
    ],
    "english": [
      "Parishudhdhaathmuniao Bomdhumu Prabhuvichchedu Varasahaayuniao Bom Dhumu",
      "Parishudhdhavarthanaku Paramasaahaayymbuao",
      "Paramuaojaeruvaraku Pari Poorthigaa Dhoraku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరిశుద్ధాత్మునిఁ గల్గిన మన రక్షణ పరిపూర్ణమై యుండును",
        "పరమ రక్షకుఁడిచ్చు పరిపూర్ణ రక్షణను",
        "పరమానందముతోడఁ పరగఁగైకొను మిపుడే"
      ],
      "english": [
        "Parishudhdhaathmuniao Galgina Mana Rakshna Paripoornamai Yumdunu",
        "Parama Rakshkuaodichchu Paripoorna Rakshnanu",
        "Paramaanmdhamuthoadao Paragaogaikonu Mipudae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధాత్మునిఁ గల్గిన బైబిలువాక్య పరమసారము తేటగుఁన్",
        "పర మండలపుఁ తండ్రి పరిశుద్ధచిత్తంబు",
        "పొరపాటులేకుండ విరివిరిగాఁ దెలియును"
      ],
      "english": [
        "Parishudhdhaathmuniao Galgina Baibiluvaakya Paramasaaramu Thaetaguaon",
        "Para Mmdalapuao Thmdri Parishudhdhachiththmbu",
        "Porapaatulaekumda Virivirigaao Dheliyunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరిశుద్ధాత్మునిఁ గల్గినఁ బ్రార్థనలందుఁ పరమ పాటవ మబ్బును",
        "సరిగాఁ బ్రార్థించెడు సరణియుఁ దెలియును",
        "వరములను బొందుటకు తెరువులభియించును"
      ],
      "english": [
        "Parishudhdhaathmuniao Galginao Braarthanalmdhuao Parama Paatava Mabbunu",
        "Sarigaao Braarthimchedu Saraniyuao Dheliyunu",
        "Varamulanu Bomdhutaku Theruvulabhiyimchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధాత్మునిఁ గల్గిన శోధనములఁ పరమ విజయము గల్గును",
        "దురితంపు శోధనలఁ దొలగింప నా ప్రభువు",
        "పరమశక్తినొసంగి కరుణతో జయమిచ్చు"
      ],
      "english": [
        "Parishudhdhaathmuniao Galgina Shoadhanamulao Parama Vijayamu Galgunu",
        "Dhurithmpu Shoadhanalao Dholagimpa Naa Prabhuvu",
        "Paramashakthinosmgi Karunathoa Jayamichchu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరిశుద్ధాత్మునిఁ గల్గిన జీవితమెల్లఁ పరిశుద్ధముగ నుండును",
        "పరిశుద్ధ జీవితము కరము సాధ్యంబగును",
        "పరిశుద్ధాత్ముని శక్తిన్ వర్తింపఁగలమట్లు"
      ],
      "english": [
        "Parishudhdhaathmuniao Galgina Jeevithamellao Parishudhdhamuga Numdunu",
        "Parishudhdha Jeevithamu Karamu Saadhymbagunu",
        "Parishudhdhaathmuni Shakthin Varthimpaogalamatlu"
      ]
    }
  ]
