{
  "song_name": "Sthuthulu neekarpinthumu sathathamu maa Prabhuvaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "స్తుతులు నీకర్పింతుము - సతతము మా ప్రభువా",
      "సన్నుతించెదము"
    ],
    "english": [
      "Sthuthulu neekarpinthumu - Sathathamu maa Prabhuvaa",
      "Sannuthinchedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గడచినట్టి కాలము - కరుణతో నన్ గాచితివి",
        "వెల లేనట్టి నే కృప - చూపినట్టి మా ప్రభు"
      ],
      "english": [
        "Gadachinatti kaalamu - Karunatho nan gaachithivi",
        "Vela lenatti nee krupa - Choopinatti maa Prabhu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాదు దినము లన్నిటన్ - నీదు క్షేమ మేలును",
        "నీదుజాడలన్నియున్ - సారంబు నిచ్చును"
      ],
      "english": [
        "Naadu dinamu lannitan - Needu kshema melunu",
        "Needu jaadalanniyun - Saarambu nichchunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీదు మందిరంబులో - మేలుచెత మమ్మును",
        "తృప్తిపరచిన ప్రభు - స్తుతులు నీకే చెల్లును"
      ],
      "english": [
        "Needu mandhirambulo - Meluchetha mammunu",
        "Thrupthiparachina Prabhu - Sthuthulu neeke chellunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీదు నామ ఘనతను - నీదు ప్రేమ పనులను",
        "నాథుడా నే పాడెద - నాదు ప్రియ ప్రభువా"
      ],
      "english": [
        "Needu naama ghanathanu - Needu prema panulanu",
        "Naathudaa ne paadeda - Naadu priya Prabhuvaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సత్య రూపి నీవెగా - సకల సృష్టి కర్తవు",
        "సతతము మమ్మేలుము - హల్లెలూయ పాడెదం"
      ],
      "english": [
        "Sathya roopi neevegaa - Sakala srushti karthavu",
        "Sathathamu mammelumu - Hallelooya paadedam"
      ]
    }
  ]
}
