{
  "song_name": "Mahaganudaa Yehova",
  "author": {
    "Authored by": "Pastor John Wesley",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మహాఘనుడా యెహోవా",
      "మనోహరుడా యేసయ్యా",
      "ప్రభుప్రేమ నాలో నింపుటకే",
      "దిగివచ్చినావు మహిమాత్ముడా",
      "త్రిత్వమై జీవించువాడవు",
      "కీర్తించి మహిమపరతును",
      "స్తుతించి ఆరాధింతును",
      "నీకే నా ఆరాధన- హల్లేలూయా",
      "ఏల్ ఎలోహీం నీవే – ఎల్షద్దాయ్ దేవుడవు",
      "ఎబినేజరువు నీవే స్తుతి ఘనత మహిమ నీకే"
    ],
    "english": [
      "Mahaghanuda Yehova",
      "Manoharuda Yesayya",
      "Prabhu prema naalo nimputake",
      "Dhigivachchinaavu Mahimaathmuda",
      "Trithvamai jeevinchuvaadavuu",
      "Keerthinchi mahimaparathunu",
      "Sthuthinchi aaradhinthunu",
      "Neeke naa aaradhana – Hallelujah",
      "El Elohim neeve – El Shaddai dhevudavu",
      "Ebenezeruvu neeve sthuthi ghanatha mahima neeke"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నవనూతనమైన కార్యాలు చేసేది నీవేగా –",
        "నీవేగా అత్యున్నతమైన స్థలములపై నడిపేది నీవేగా – నీవేగా",
        "విధినే చేధించి నీవు – భువినే వెలిగించగా",
        "స్తుతినే నానోట పలికించి బహుగా దీవించగా",
        "గళమెత్తి కీర్తింతును"
      ],
      "english": [
        "Navanoothanamaina kaaryaalu chesedhi neevega – neevega",
        "Athyunnathamaina sthalamulapai nadipedhi neevega – neevega",
        "Vidhine chedhinchi neevu – bhuvine veliginchaga",
        "Sthuthine naa nota palikinchi bahuga dheevinchaga",
        "Galametthi keerthinthunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కొండైనా లోయైనా సమభూమి చేసేది నీవేగా –",
        "నీవేగా ఇబ్బంది కొలిమిలో నిర్మలము చేసినది నీవేగా – నీ వాక్కేగా",
        "శ్రమలే నను వేధించిననూ కలతలే బాధించినా",
        "కృపయే క్షణమైనా విడువక మహిమకే చేర్పించునని",
        "నిరీక్షించి కీర్తింతును"
      ],
      "english": [
        "Kondaina loyaina samabhoomi chesedhi neevega – neevega",
        "Ibbandhi kolimilo nirmalamu chesinadhi neevega – nee vaakkeyga",
        "Sramale nanu vedhinchinanu kalathale baadhinchinaa",
        "Krupaye kshanamainaa viduvaka mahimake cherpinchunani",
        "Nireekshinchi keerthinthunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఐశ్వర్య ఘనతలు దయచేయువాడవు నీవేగా –",
        "నీవేగా నీ మందిరములోని మేలులతో నింపేది నీవేగా – నా దేవా",
        "నీవే భూమ్యాకాశములు పట్టజాలని దేవుడవు",
        "నీవే సమాధానప్రభువై ఏలే మహరాజువు",
        "నీ కీర్తి కీర్తింతును"
      ],
      "english": [
        "Aishwarya ghanathalu dhayacheyuvadavuu neevega – neevega",
        "Nee mandhiramuloni melulatho nimpedhi neevega – naa dhevaa",
        "Neeve bhoomyaakaashamulu pattajaalani dhevudavu",
        "Neeve samaadhaana prabhuvai ele Maharaajuvu",
        "Nee keerthi keerthinthunu"
      ]
    }
  ]
}
