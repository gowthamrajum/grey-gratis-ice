{
  "song_name": "Emundi Naalo Yesayya",
  "author": {
    "Authored by": "Ebinazar Sastry",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రేమించే తండ్రి ఏముంది నాలో",
      "నీ నిత్య ప్రేమకు అర్హతేలేదు నాలో",
      "నేను మరిచిన నన్ను మరవలేదు",
      "నేను విడిచిన నన్ను విడవలేదు"
    ],
    "english": [
      "Preminche thandri emundhi naalo",
      "Nee nithya premaku arhathe ledhu naalo",
      "Nenu marachinaa nannu maruvaledhu",
      "Nenu vidichinaa nannu viduvaledhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏముంది నాలో యేసయ్య",
        "ఎందుకని నేనంటే ఇంత ప్రేమయ్య"
      ],
      "english": [
        "Emundhi naalo Yesayya",
        "Endhukani nenante intha premayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రతిదినము నిన్ను ఎదిరించినాను",
        "క్షణమైన మోకరించలేదు",
        "అవకాశమున్నా ప్రార్ధించలేదు",
        "ఆత్మ హెచ్చరించినా మాట వినలేదు"
      ],
      "english": [
        "Prathidhinamu ninnu edhirinchinaanu",
        "Kshanamainaa mokarinchaledhu",
        "Avakashamunnaa praarthinchaledhu",
        "Aathma hecharinchinaa maata vinaledhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పలుమార్లు నేను పడిపోయినాను",
        "తండ్రి ప్రేమను మరిచినాను",
        "వాక్యము విన్నా మారకున్నాను",
        "భక్తినే నటనగా మార్చుకున్నాను"
      ],
      "english": [
        "Emundhi naalo Yesayya",
        "Endhukani nenante intha premayya"
      ]
    },
    {
      "stanza_number": 4,
