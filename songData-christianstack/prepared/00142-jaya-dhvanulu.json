    ],
    "english": [
      "Jayadhvanulatho jayageetham paadedham",
      "Mana raajuke sthuthi geetham paadedham",
      "Jeevam ichchina mana dhevuniki aaradhana",
      "Jayam ichchina yesayyaake sthothraarpanaa"
    ]
  },
  "stanzas": [
