{
  "song_name": "Sanghamunu Koolchake",
  "author": {
    "Authored by": "Music Pr D.Isaac Gnana Raj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సంఘమును కూల్చకే గొడవలు నీవు రేపకే",
      "మనుషుల దూరం చేసేడి కొండెములను నీవు చాటకే"
    ],
    "english": [
      "Sanghamunu koolchake godavalu neevu repake",
      "Manushula dooram chesedi kondemulanu neevu chaatake"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్షమాపణ లేకుండా దేవుని రాజ్యము చేరవుగా",
        "పగతో నింపబడక నీవు దేవుని ప్రేమతో నింపబడు"
      ],
      "english": [
        "Kshamaapana lekunda devuni raajyamu cheravuga",
        "Pagatho nimpabadaka neevu devuni prematho nimpabadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తగ్గింపు లేనివాడు వాక్యమును గైకొనడు",
        "ఐక్యముగా నుండలేడు ఎగిరిపడి చెడుతాడు"
      ],
      "english": [
        "Tagghimpu lenivaadu vaakyamuunu gaikonadu",
        "Ikyamugaa undaledu egiripadi cheduthaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవుని ప్రేమించువాడు నష్టమునైనా ఓర్చును",
        "సిలువను రోజు మోయును సంఘమును హత్తుకొనును"
      ],
      "english": [
        "Devuni preminchuvaadu nashtamunainaa orchunu",
        "Siluvanu roju moyunu sanghamunu hatthukonunu"
      ]
    }
  ]
}
