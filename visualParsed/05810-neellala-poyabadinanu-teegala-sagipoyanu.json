      "శత్రు మిత్రుల చేతుల్లోను",
      "నలిగి పోయాను నేను విరిగిపోయాను ॥2॥",
      "॥నీళ్ళలా॥"
    ],
    "english": [
      "Neellalaa poyabadinaanu theegalaa saagipoyaanu",
      "Dhummulaa dhoolilaa praanam povunanthalaa",
      "Thanuvulonu manasulonoo",
      "Shathru mithrula chethullonu",
      "Naligi poyaanu nenu virigipoyaanu ||2||",
      "||Neellalaa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పోయిందని అనుకున్న ప్రాణం తిరిగి దక్కేలా",
        "దక్కిన ప్రాణం క్రొత్త బతుకును ప్రారంభించేలా",
        "దేవునికి మానవునికి ఉపకరించేలా",
        "నలిగి పోయాను నేను విరిగిపోయాను ॥2॥",
        "॥నీళ్ళలా॥"
      ],
      "english": [
        "Poyindhani anukunna praanam thirigi dhakkelaa",
        "Dhakkina praanam kroththa bathukunu praarambhinchelaa",
        "Devuniki maanavuniki upakarinchelaa",
        "Naligi poyaanu nenu virigipoyaanu ||2||",
        "||Neellalaa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకులు చూపె ప్రేమలోని స్వార్ధం ఎరిగేలా",
        "క్రీస్తులోని నిస్వార్ధ ప్రేమకు అర్ధం తెలిసేలా",
        "అదృశ్యమైనవి నిత్యములంటు గ్రహింపు పొందేలా",
        "నలిగి పోయాను నేను విరిగిపోయాను ॥2॥",
        "॥ నీళ్ళలా॥"
