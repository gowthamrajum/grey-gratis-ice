{
  "song_name": "Nedaina Nijamaina",
  "author": {
    "Authored by": "A.R.Stevenson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నేడైనా నిజమైన రక్షకుని చేరుమా",
      "పాడైన నీ స్థితిలో స్వస్థతను కోరుమా",
      "నా దేశమా – నా భారతదేశమా",
      "నువ్వొస్తే మనసిస్తే మార్చబడతావు",
      "నా క్రీస్తే సెలవిస్తే బాగుపడతావు",
      "నా దేశమా – నా భారతదేశమా"
    ],
    "english": [
      "Nedaina nijamaina rakshakuni cherumaa",
      "paadaina nee sthithilo swasthathanu korumaa",
      "naa desamaa – naa bhaarathadesamaa",
      "nuvvosthe manasisthe maarchabadathaavu",
      "naa kreesthe selavisthe baagupadathaavu",
      "naa desamaa – naa bhaaratha desamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సృష్టికర్తను ఎరుగక",
        "పాపిగ జీవించినా",
        "దృష్టి తండ్రిపై నిలుపక",
        "భ్రష్టతలో ఉండినా",
        "జాలి కలిగి తన ఉగ్రతనింకా",
        "పంపుటలేదు సుమా",
        "సత్యవాక్యము నమ్మక",
        "దేవుని దూషించినా",
        "నిత్యజీవము పొందక",
        "చీకటిలో ఉండినా",
        "ప్రేమకలిగి నిను ఆహ్వానించుట",
        "మానుట లేదు సుమా"
      ],
      "english": [
        "Srushtikarthanu erugaka",
        "paapiga jeevinchinaa",
        "drushti thandripai nilupaka",
        "bhrashtathalo undinaa",
        "jaali kaligi thana ugrathaninkaa",
        "pamputaledu sumaa",
        "Sathyavaakyamu nammaka",
        "devuni dooshinchinaa",
        "nithyajeevamu pondhaka",
        "cheekatilo undinaa",
        "premakaligi ninu aahvaaninchuta",
        "maanuta ledu sumaa"
      ]
    }
  ]
}
