{
  "song_name": "Andari Chevulu Gingurumanelaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "అందరి చెవులు గింగురుమనేలా అంతట చాటి చెప్పాలా",
      "యేసు రాకడకు సమయం అయ్యుందని",
      "సిద్ధం కాకపోతే ఎంతో ఘోరమని",
      "అ.ప: వాయుదా వెయ్యకుండా - కారణాలు చెప్పకుండా",
      "రక్షణ పొందుకోమని"
    ],
    "english": [
      "Andari chevulu gingurumanelaa anthata chaati cheppaalaa",
      "Yesu raakadaku samayam ayyundhani",
      "Siddham kaakapothe entho ghoramani",
      "A.pa: vaayidhaa veyyakundaa - Kaaranaalu cheppakundaa",
      "Rakshana pondhukomani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసయ్యను స్వంత రక్షకునిగా స్వీకరించినవారందరూ",
        "ఆకాశానికెత్తబడి",
        "ఎల్లప్పుడూ ఆయనతో పరమున ఉంటారని"
      ],
      "english": [
        "Yesayyanu swantha rakshakunigaa sweekarinchinavaarandharoo",
        "Aakaashaaniketthabadi",
        "Ellappudoo aayanatho paramuna untaarani"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేసయ్యను అంగీకరించక త్రోసివేసినవారందరూ",
        "భూమి పై విడువబడి",
        "ఎల్లప్పుడూ నరకములో కాలుతూ ఉంటారని"
      ],
      "english": [
        "Yesayyanu angeekarinchaka throsivesinavaarandharoo",
        "Bhoomi pai viduvabadi",
        "Ellappudoo narakamulo kaaluthoo untaarani"
      ]
    }
  ]
}
