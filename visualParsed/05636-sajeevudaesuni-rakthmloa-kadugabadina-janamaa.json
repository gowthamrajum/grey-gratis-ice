  "main_stanza": {
    "telugu": [
      "సజీవుడేసుని రక్తంలో కడుగబడిన జనమా",
      "సమాధి గెలచిన దేవునిచే నాటబడిన వనమా",
      "యువజనమా - యేసులో బలపడుమా",
      "జడియకుమా - యేసుకే పరుగెడుమా"
    ],
    "english": [
      "Sajeevudesuni rakthamlo kadugabadina janamaa",
      "Samaadhi gelachina Dhevuniche naatabadina vanamaa",
      "Yuvajanamaa - Yesulo balapadumaa",
      "Jadiyakumaa - Yesuke parugedumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జీవిత కాలం స్వల్పం- యవ్వనమెంతో శ్రేష్టం",
        "నీ యవ్వన బలం యేసుకే వాడినా",
        "జీవితమే ఫలవంతం ||యువ||"
      ],
      "english": [
        "Jeevitha kaalam svalpam- Yavvanamentho shreshtam",
        "Nee yavvana balam Yesuke vaadinaa",
        "Jeevithame phalavantham ||Yuva||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆకర్షించే లోకం ఆశల నాశన కూపం",
        "లోకాశలను జయించి సాగిన",
        "చేరదవు పరలోకం ||యువ||"
      ],
      "english": [
        "Aakarshinche lokam aashala naashana koopam",
        "Lokaashalanu jayinchi saagina",
        "Cheradhavu paralokam ||Yuva||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవునితోటయే సంగం",
        "పనిచేయుట నీ ధర్మం",
        "నీ వరములను రెట్టింపు చేసిన",
        "పొందెదవు బహుమానం ||యువ||"
      ],
      "english": [
        "Dhevunithotaye sangham",
        "Panicheyuta nee dharmam",
        "Nee varamulanu rettimpu chesina",
        "Pondedavu bahumaanam ||Yuva||"
      ]
    }
  ]
