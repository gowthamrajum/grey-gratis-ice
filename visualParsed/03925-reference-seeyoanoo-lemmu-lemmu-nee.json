  "main_stanza": {
    "telugu": [
      "లేలెమ్ము సీయోను - ధరియించుము నీ బలము",
      "సుందర వస్త్రముల ధరించు - పరిశుద్ధ పట్టణమా"
    ],
    "english": [
      "Lelemmu Seeyonu - Dhariyinchumu nee balamu",
      "Sundara vasthramula dharinchu - Parishuddha pattanamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిష్కళంక యెరూషలేమా - ఇంకెన్నటికి నీ మధ్యకు",
        "సున్నతి పొందని అపవిత్రులును - లోనికి రారెన్నడు"
      ],
      "english": [
        "Nishkalanka Yerooshalemaa - Inkennatiki nee madhyaku",
        "Sunnathi pondani apavithrulunu - Loniki raarennadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లెమ్ము నీవు తేజరిల్లుము - వెలుగు నీకు వచ్చియున్నది",
        "యెహోవా మహిమ నీ మీద - ఉదయించెను లేలెమ్ము"
      ],
      "english": [
        "Lemmu neevu thejarillumu - Velugu neeku vachchiyunnadhi",
        "Yehova mahima nee meeda - Udayinchenu lelemmu"
      ]
