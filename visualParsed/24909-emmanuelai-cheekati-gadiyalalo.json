  "main_stanza": {
    "telugu": [
      "చీకటి గడియలలో - ఒంటరి సమయములో",
      "నే వేసిన ప్రతి అడుగులో",
      "నలిగిన హృదయముతో కన్నీటి లోయలో",
      "నే చేసిన ప్రతి పయణములో"
    ],
    "english": [
      "Cheekati ghadiyalalo - Ontari samayamulo",
      "Ne vesina prathi adugulo",
      "Naligina hrudayamutho kanneeti loyalo",
      "Ne chesina prathi payanamulo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇమ్మానియే లై నా తోడై వున్నావు..",
        "నే నడచిన మార్గములో నీడై నిలిచావు",
        "నా భయము దిగులును తీసివేసావూ",
        "ఆ క్రిస్మస్ దినమున నను తిరిగి రాసావు \"2\""
      ],
      "english": [
        "Immaanuyelai naa thodai vunnaavu..",
        "Ne nadachina maargamulo needai nilichaavu",
        "Naa bhayamu dhigulunu theesivesaavoo",
        "Aa Christmas dinamuna nanu thirigi raasaavu \"2\""
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బెత్లహేములో చిన్నీ బాలుడై...",
