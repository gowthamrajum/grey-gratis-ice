{
  "song_name": "Yugamula Parvamtamu Stotramulakarhudu Jagamulaneluchunna Janataika",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యుగముల పర్వంతము స్తొత్రములకర్హుడు",
      "జగములనేలుచున్న జనతైక కుమారుడు"
    ],
    "english": [
      "Yugamula Parvamtamu Stotramulakarhudu",
      "Jagamulaneluchunna Janataika Kumarudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆప్తుడు దేదీప్యుడు ఆపదలో సహాయుడు",
        "నుత్యుడు సత్యుడు సృష్టికి ఆధారుడు నా యేసుడు"
      ],
      "english": [
        "Aptudu Dedipyudu Apadalo Sahayudu",
        "Nutyudu Satyudu Srushtiki Adharudu Na Yesudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిరతము నా దుర్గము నాదు రక్షణ కేడెము",
        "కునుకడు నిద్రించడు ఎన్నడు ఎడబాయడు నా యేసుడు"
      ],
      "english": [
        "Niratamu Na Durgamu Nadu Rakshana Kedemu",
        "Kunukadu Nidrimchadu Ennadu Edabayadu Na Yesudu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అల్ఫయు ఓమేగయు అద్యంత రహితుడు",
        "కరుణామయుడు కమనీయుడు కలువరినాధుడు నా యేసుడు"
      ],
      "english": [
        "Alpayu Omegayu Adyamta Rahitudu",
        "Karunamayudu Kamaniyudu Kaluvarinadhudu Na Yesudu"
      ]
    }
  ]
}
