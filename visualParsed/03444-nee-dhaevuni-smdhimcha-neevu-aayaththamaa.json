{
  "song_name": "Nee Devuni sandhincha neevu aayaththamaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నీ దేవుని సంధించ నీవు ఆయత్తమా"
    ],
    "english": [
      "Nee Devuni sandhincha neevu aayaththamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భువికి యేసు వచ్చునప్పుడు దుష్టులణిగెదరు",
        "ఆ విధమున నీవుండిన ఏమి చేతువు?"
      ],
      "english": [
        "Bhuviki Yesu vachchunappudu dhushtulanigedharu",
        "Aa vidhamuna neevundina emi chethuvu?"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మేఘముతో వత్తునని చెప్పినవాడు",
        "మేఘముపై వచ్చుకాలము సమీపించెను"
      ],
      "english": [
        "Meghamutho vaththunani cheppinavaadu",
        "Meghamupai vachchukaalamu sameepinchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దూత గణములతో బూరధ్వనితో",
        "ఆ భక్తగణముల గలియు కాలమాయెను"
      ],
      "english": [
        "Dootha ganamulatho booradhvanitho",
        "Aa bhakthaganamula galiyu kaalamaayenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భక్తి హేనులెల్ల నపుడు అంగలార్తురు",
        "రక్షణను పొందలేరు వారలప్పుడు"
      ],
      "english": [
        "Bhakthi henulella napudu angalaarthuru",
        "Rakshananu pondhaleru vaaralappudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాప జీవులెల్ల నాడు దాగుకొందురు",
        "శుద్ధ పరచబడినవారు ఎగిరిపోదురు"
      ],
      "english": [
        "Paapa jeevulella naadu dhaagukondhuru",
        "Shuddha parachabadinavaaru egiripodhuru"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కృపకాలమందే పశ్చాత్తాప మొందుము",
        "ఇప్పుడే అంగీకరించి మన్నింపు నొందు"
      ],
      "english": [
        "Krupakaalamandhe pashchaaththaapa mondhumu",
        "Ippude angeekarinchi manninpu nondhu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీకై మృతి బొంది యేసు కాచియున్నాడు",
        "నిన్ను అంగీకరించును కరుణతోడను"
      ],
      "english": [
        "Neekai mruthi bondhi Yesu kaachiyunnaadu",
        "Ninnu angeekarinchunu karunathodhanu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "దేవుని అంగీకరించని వారు ఆ నాడు",
        "దాగుకొని నిరతము పరితపింతురు"
      ],
      "english": [
        "Devuni angeekarinchani vaaru aa naadu",
        "Dhaagukoni nirathamu parithapinthuru"
      ]
    }
  ]
}
