{
  "song_name": "Sameepimparaani",
  "author": {
    "Authored by": "Anil Vemula",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సమీపింపరాని తేజస్సులో",
      "నివసించెడి అమరుండ దేవా",
      "సమరుపులేని సర్వవ్యాపివైన",
      "అద్వితీయ సత్యవంతుడా"
    ],
    "english": [
      "Sarvamu neeve – samasthamu neede",
      "samarpinthunnayya – sthothramu neeke",
      "sarvamu neeve – samasthamu neede",
      "samarpinthunnayya – sthothramu neeke",
      "samarpinthunnayya – sthothramu neeke",
      "samarpinthunnayya – sthothramu neeke"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అప:",
        "సర్వము నీవే – సమస్తము నీదే",
        "సమర్పింతునయ్యా – స్తోత్రము నీకే",
        "సర్వము నీవే – సమస్తము నీదే",
        "సమర్పింతునయ్యా – స్తోత్రము నీకే",
        "సమర్పింతునయ్యా – స్తోత్రము నీకే",
        "సమర్పింతునయ్యా – స్తోత్రము నీకే"
      ],
      "english": [
        "Sameepimparaani thejasulo",
        "nivasinchedi amarunda devaa",
        "samarupuleni sarvavyaapivaina",
        "advitheeya sathyavanthudaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏ మాట వివరింతు నీ జ్ఞానము",
        "ఏ నోట వర్ణింతు నీ ఘనతను",
        "సమస్తము చేసితివి నీ మాటతో",
        "సకలము కలిగెను క్రీస్తుయేసులో"
      ],
      "english": [
        "Ye maata vivarinthu nee jnaanamun",
        "ye nota varninṭhu nee ghanathanu",
        "samasthamu chesithivi nee maatatho",
        "sakalamu kaligenu kreesthuyesulo"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఏమివ్వగలనయ్య నీ ప్రేమకు",
        "బదులివ్వాలేనయ్య త్యాగానికి",
        "ఇదిగోనయ్యా నా చిన్న జీవితం",
        "గైకొనుమయ్యా నీకే అంకితం"
      ],
      "english": [
        "Emivvagalanayya nee preemaku",
        "badulivvaalenayya thyaagaaniki",
        "idigonayya naa chinna jeevitham",
        "gaikonumayya neeke ankitham"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఎంతటి భాగ్యమో ఈ పాపికి",
        "నేనెపుడు చేరెదనో అచ్చోటికి",
        "నీ ముఖదర్శనమే ఆనందమయము",
        "ఆ ఉహాయే నాకు మధురం మధురం"
      ],
      "english": [
        "Enthati bhaagyamo ee paapiki",
        "neneppudu cheredano achchotiki",
        "nee mukhadarshaname aanandamayamu",
        "aa uhaaye naaku madhuram madhuram"
      ]
    }
  ]
}
