{
  "song_name": "Sthuthimthun Parishudhdhuni Aaraadhanathoa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతింతున్ పరిశుద్దుని ఆరాధనతో - ఇంతవరకు కాచె దేవుడే"
    ],
    "english": [
      "Sthuthimthun Parishudhdhuni Aaraadhanathoa - Imthavaraku Kaache Dhaevudae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇరువదై దేండ్లు గాచెన్ - కొరతలేని మేళ్ళనిచ్చె",
        "చేర్చె ప్రజల నెందరినో - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Iruvadhai Dhaemdlu Gaachen - Korathalaeni Maellanichche",
        "Chaerche Prajala Nemdharinoa - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సువార్త సైన్యము నిచ్చి - భువిపై శత్రుని పనినాపే",
        "వినిన వారిని ప్రత్యేకించే - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Suvaartha Sainyamu Nichchi - Bhuvipai Shathruni Paninaapae",
        "Vinina Vaarini Prathyaekimchae - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పరిశుద్ధ సంఘము కూర్చె - నేర్పె సత్య మర్మములు",
        "సరిగ సాక్ష్యము స్థాపించె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Parishudhdha Samghamu Koorche - Naerpe Sathya Marmamulu",
        "Sariga Saakshyamu Sthaapimche - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సేవకులనిచ్చెను బహుగా - కావలి యుంచెను ప్రభువే",
        "సహపని వారి నొసగె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Saevakulanichchenu Bahugaa - Kaavali Yumchenu Prabhuvae",
        "Sahapani Vaari Nosage - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఇండియాలో ఈ నగరు - అంతియొకయ వలె జేసె",
        "స్వంతముగను జేసికొనెన్ - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Imdiyaaloa Ee Nagaru - Amthiyokaya Vale Jaese",
        "Svamthamuganu Jaesikonen - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పరమ దర్శనము నిచ్చె - సరిగా లోబరచె మనల",
        "కరము నిచ్చె నడిపించె - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Parama Dharshanamu Nichche - Sarigaa Loabarache Manala",
        "Karamu Nichche Nadipimche - Chaeripaadi Sthuthimchedhamu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సంఘ మర్మనును దెల్పి - శీఘ్రముగ నంపెను వార్త",
        "పార్చె పాపుల నెందరినో - చేరిపాడి స్తుతించెదము"
      ],
      "english": [
        "Samgha Marmanunu Dhelpi - Sheeghramuga Nampenu Vaartha",
        "Paarche Paapula Nemdharinoa - Chaeripaadi Sthuthimchedhamu"
      ]
    }
  ]
}
