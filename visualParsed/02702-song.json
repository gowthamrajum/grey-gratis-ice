    ],
    "english": [
      "Jeevithambu ghora kashtanashtambul",
      "Aavarinchi ninnu duhkhaparchina",
      "Dhevudichchinatti eevulenchumu",
      "Nee vaashcharya mondhedhavu. vaanikai.",
      "||Enchumu lekkinchu meevulan",
      "Enchuchoodu mesudheevenal",
      "Enchu menchu menchu meevulan",
      "Vintha nondhedhavu neevu vaanikai ||"
    ]
