  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపభారము దుష్టగుణ సమేతుండనై",
        "దుఃఖనష్ట దౌర్జన్యముతో నుండ",
        "చిన్న స్వరము వినబడె నన్ను పిలుచునట్లుగా",
        "రమ్ము పొందు నాదుసిల్వ విశ్రాంతి",
        "సిల్వలో సిల్వలో - పాపమెల్ల బోయె సిల్వయందున",
        "భారమెల్ల వీడెను - రాత్రి పగలాయెను",
        "కనుగొంటి సిల్వలో రక్షణ"
      ],
      "english": [
        "Paapabhaaramu dhushtaguna samethundanai",
        "Duhkhanashta dhaurjanyamutho nunda",
        "Chinna swaramu vinabade nannu piluchunatlugaa",
        "Rammu pondu naadhusilva vishraanthi",
        "Silvalo silvalo - Paapamella boye silvayandhuna",
        "Bhaaramella veedenu - Raathri pagalaayenu",
        "Kanugonti silvalo rakshana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏగుచుందు నిత్యము జీవమును బొందను",
        "సిల్వలో కృపశక్తి పొందుదున్",
        "శోధనలు వచ్చిన జయ మొందుచుందును",
        "మోకరించి ప్రార్థింతు సిల్వచెంత"
      ],
      "english": [
        "Eguchundhu nithyamu jeevamunu bondhanu",
        "Silvalo krupashakthi pondhudhun",
        "Shodhanalu vachchina jaya mondhuchundhunu",
        "Mokarinchi praarthinthu silvachentha"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "జీవితమందు ఏడ్పు బాధ శోధన్లలెల్ల",
        "ఆత్మసాయముచే సిల్వజూతును",
        "యేసు పాపికొరకుపడ్డపాట్లు చూడగా",
        "భారముల మోయుశక్తి పొందుదున్"
      ],
      "english": [
        "Jeevithamandhu edpu baadha shodhanalalella",
        "Aathmasaayamuche silvajoothunu",
        "Yesu paapikorakupaddapaatlu choodagaa",
        "Bhaaramula moyushakthi pondhudhun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భారముచే క్రుంగిన పాపీ నేడే రారమ్ము",
        "యేసు రక్తమందు నిన్ను కడుగును",
        "నిత్యజీవ మిచ్చును నిన్ను సమర్పించుకో",
        "క్రీస్తు యేసు క్రొత్త శక్తి నిచ్చును"
      ],
      "english": [
        "Bhaaramuche krungina paapee nede raarammu",
        "Yesu rakthamandu ninnu kadugunu",
        "Nithyajeeva michchunu ninnu samarpinchuko",
        "Kreesthu Yesu krottha shakthi nichchunu"
      ]
    }
  ]
}
