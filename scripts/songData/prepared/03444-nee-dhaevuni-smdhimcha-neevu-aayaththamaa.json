{
  "song_name": "Nee Dhaevuni Samdhimcha Neevu Aayaththamaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ దేవుని సంధించ నీవు ఆయత్తమా"
    ],
    "english": [
      "Nee Dhaevuni Samdhimcha Neevu Aayaththamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భువికి యేసు వచ్చునప్పుడు దుష్టులణిగెదరు",
        "ఆ విధమున నీవుండిన ఏమి చేతువు?"
      ],
      "english": [
        "Bhuviki Yaesu Vachchunappudu Dhushtulanigedharu",
        "Aa Vidhamuna Neevumdina Aemi Chaethuvu?"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మేఘముతో వత్తునని చెప్పినవాడు",
        "మేఘముపై వచ్చుకాలము సమీపించెను"
      ],
      "english": [
        "Maeghamuthoa Vaththunani Cheppinavaadu",
        "Maeghamupai Vachchukaalamu Sameepimchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దూత గణములతో బూరధ్వనితో",
        "ఆ భక్తగణముల గలియు కాలమాయెను"
      ],
      "english": [
        "Dhootha Ganamulathoa Booradhvanithoa",
        "Aa Bhakthaganamula Galiyu Kaalamaayenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "భక్తి హేనులెల్ల నపుడు అంగలార్తురు",
        "రక్షణను పొందలేరు వారలప్పుడు"
      ],
      "english": [
        "Bhakthi Haenulella Napudu Amgalaarthuru",
        "Rakshananu Pomdhalaeru Vaaralappudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాప జీవులెల్ల నాడు దాగుకొందురు",
        "శుద్ధ పరచబడినవారు ఎగిరిపోదురు"
      ],
      "english": [
        "Paapa Jeevulella Naadu Dhaagukomdhuru",
        "Shudhdha Parachabadinavaaru Egiripoadhuru"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కృపకాలమందే పశ్చాత్తాప మొందుము",
        "ఇప్పుడే అంగీకరించి మన్నింపు నొందు"
      ],
      "english": [
        "Krupakaalamamdhae Pashchaaththaapa Momdhumu",
        "Ippudae Amgeekarimchi Mannimpu Nomdhu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నీకై మృతి బొంది యేసు కాచియున్నాడు",
        "నిన్ను అంగీకరించును కరుణతోడను"
      ],
      "english": [
        "Neekai Mruthi Bomdhi Yaesu Kaachiyunnaadu",
        "Ninnu Amgeekarimchunu Karunathoadanu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "దేవుని అంగీకరించని వారు ఆ నాడు",
        "దాగుకొని నిరతము పరితపింతురు"
      ],
      "english": [
        "Dhaevuni Amgeekarimchani Vaaru Aa Naadu",
        "Dhaagukoni Nirathamu Parithapimthuru"
      ]
    }
  ]
}
