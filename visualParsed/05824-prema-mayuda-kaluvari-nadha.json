      ],
      "english": [
        "Keerthana Daaveedu keerthana",
        "Nenu paadedan raajaa",
        "Praardhana daiva praardhana ||2||",
        "Ebbezu praardhana nerpumaa ||Aaha||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సాక్షిగా యేసు సాక్షిగా",
