    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆయన మహిమగల నామము",
        "నిత్యమును స్తుతింపబడును గాక"
      ],
      "english": [
        "Aayana mahimagala naamamu",
        "Nithyamunu sthuthimpabadunu gaaka"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సర్వభూమి ఆయన మహిమచే",
        "నిండియుండును గాక ఆమెన్‌ ఆమెన్‌"
      ],
      "english": [
        "Sarvabhoomi aayana mahimache",
        "Nindiyundunu gaaka aamen aamen"
      ]
    }
  ]
