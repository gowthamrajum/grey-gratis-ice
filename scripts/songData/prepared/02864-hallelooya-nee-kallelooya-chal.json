{
  "song_name": "Hallelooya Nee Kallelooya Challagaa Rammippu Daesu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "హల్లెలూయ నీ కల్లెలూయ చల్లఁగా రమ్మిప్పు డేసు"
    ],
    "english": [
      "Hallelooya Nee Kallelooya Challagaa Rammippu Daesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒప్పుకొందుము మాదు తప్పిదంబులన్",
        "ముప్పులో నుండి మమ్ముఁ దప్పించు మయ్యా"
      ],
      "english": [
        "Oppukondhumu Maadhu Thappidhambulan",
        "Muppuloa Nundi Mammu Dhappinchu Mayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పిల్లల మయ్యా బీద పిల్లల మయ్యా",
        "చల్లని నీ నామమును సన్నుతింతుము"
      ],
      "english": [
        "Pillala Mayyaa Beedha Pillala Mayyaa",
        "Challani Nee Naamamunu Sannuthinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వందనమయ్యా నీకు వందన మయ్యా",
        "యందముగ మమ్మును నీ యందు నిల్పుమా"
      ],
      "english": [
        "Vandhanamayyaa Neeku Vandhana Mayyaa",
        "Yandhamuga Mammunu Nee Yandhu Nilpumaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆడుచుందుము మేము పాడుచుందుము",
        "వేడుకతోఁ గూడి నిను వే డుకొందుము"
      ],
      "english": [
        "Aaduchundhumu Maemu Paaduchundhumu",
        "Vaedukathoa Goodi Ninu Vae Dukondhumu"
      ]
    }
  ]
}
