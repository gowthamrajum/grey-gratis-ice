  },
  "main_stanza": {
    "telugu": [
      "ఎంత కాలమో ఈ లోక ఆశలపై ధ్యాస",
      "ఇంకెంత కాలమో ఈ లోక భోగాల వేట",
      "కాలం పరిపూర్ణమాయెను దుర్దినములు మొదలాయెను",
      "ఇకనైనా కనులు తెరచుకో ఓ నేస్తమా"
    ],
    "english": [
      "Entha kaalamo ee loka aasalapai dhyaasa",
      "inkentha kaalamo ee loka bhogaala veta",
      "kaalam paripoornamaayenu dhurdhinamulu modhalaayenu",
      "ikanainaa kanulu therachuko oo nesthamaa"
    ]
  },
  "stanzas": [
