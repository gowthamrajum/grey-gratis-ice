{
  "song_name": "Dikkulanni Nanu Vekkairinchina",
  "author": {
    "Authored by": "Paul Jacob",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దిక్కులన్ని నను వెక్కిరించిన నా దిక్కె నీవై ఉంటివే",
      "బంధాలన్నీ బహు దూరమైనా నా బంధం నీవై ఉంటివే ..",
      "నా సొంతమా.. నా బంధమా ఆరాధన నీకే",
      "అనురాగమా నా ఏసయ్యా ఆరాధనా నీకే"
    ],
    "english": [
      "Dhikkulanni nanu vekkirinchinaa naa dhikke neevai untive",
      "Bandhaalanni bahu dhooramainaa naa bandham neevai untive",
      "Naa sonthamaa… naa bandhammaa aaradhana neeke",
      "Anuraagamaa naa Yesayya aaradhana neeke"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తెలియని కలతలే నన్ను తరుముచుండగా",
        "ఎరుగని పోరాటమే- నను వెంటాడగా",
        "నీ రెక్కల నీడలో నను దాచినావయా",
        "ఏ కీడు రాకుండా నను కాచినవయ్య",
        "ఊగిసలాడే ఊపిరికి ఊరటనిచ్చితివే",
        "సాహసమైన కార్యాలెన్నో నాకై చేసితివే"
      ],
      "english": [
        "Theliyani kalathale nannu tharumuchundagaa",
        "Erugani poraatame nanu ventaadaga",
        "Nee rekkala needalo nanu dhaachinaavayaa",
        "Ee keedu raakunda nanu kaachinaavayya",
        "Oogisalaade oopiriki ooratanichchithive",
        "Saahasamaina kaaryaalenno naakai chesithive"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆరడి మాటలే నను దోషిగా చేయగా",
        "ఆగని నిందలే నను క్రుంగజేయగా",
        "హేతువే లేని గాయాలే నను హేళన చేయగా",
        "ఎదుటే నిలిచినా నీవే నా దరికే చేరగ",
        "గడిచిన కాలము – నడచిన మార్గము నీవే చూచినది",
        "తగిలిన గాయము -పగిలిన హృదయం నీవే మార్చినది"
      ],
      "english": [
        "Aaradi maatalea nanu dhoshigaa cheyagaa",
        "Aagani nindale nanu krungajeyagaa",
        "Hethuve leni gaayaale nanu helana cheyagaa",
        "Edute nilichinaa neeve naa dharike cheraga",
        "Gadichina kaalamu – nadachina maargamu neeve choochinadhea",
        "Tagilina gaayamu – pagilina hrudayamu neeve maarchinadea"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎడబాటులే అలవాటుగా మారిపోయెనే",
        "తడబాటులే నను విడువక తల్లడిల్ల చేయగా",
        "నున్న నీతో నంటూ – నా వెంటే నడిచిటివి",
        "నా రక్షణ శృంగం నీవే -నన్ను రక్షించావే",
        "అర్హతలేని అల్పునికి అధికారం మిచితివే",
        "అంతము వరకు ఆరాధించే భాగ్యము నిచితివే"
      ],
      "english": [
        "Edabaatule alavaatugaa maaripoyene",
        "Thadabaatule nanu viduvaka thalladilla cheyagaa",
        "Nunna neetho nantu naa vente nadichithivi",
        "Naa rakshana shrungam neeve – nannu rakshinchave",
        "Arhathaleni alpuniki adhikaaram ichchithive",
        "Anthamu varaku aaradhinche bhaagyamu nichchithive"
      ]
    }
  ]
}
