{
  "song_name": "Deva Ninu Aaradhincheydhamu",
  "author": {
    "Authored by": "Stanley Jones YJ",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవా నిను ఆరాధించెదము",
      "తండ్రి స్తుతులతో ఆర్భాటించెదము",
      "కీర్తించెదము కొనియాడెదము",
      "ఆత్మతో సత్యముతో"
    ],
    "english": [
      "Deva ninu aaraadhincheydamu",
      "thandri sthuthulatho aarbhatinchedamu",
      "keerthinchedamu koniyaadedhamu",
      "aathmatho sathyamutho"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సిలువలో రక్తము చిందించెను",
        "పాపపు భారము తొలగించెను",
        "పరిపూర్ణమైన ప్రేమతో",
        "క్షమియించి రక్షించి దాపు చేర్చెను",
        "ఓ దేవ మా తండ్రి",
        "మీకే స్తోత్రం హల్లేలుయా",
        "శోధనలు ఎన్నో ఎదురేగిన",
        "వేదనలే చెలరేగిన",
        "మమ్మును కాచి బలపరచి",
        "ఆశ్రయమిచ్చి కాపాడును యేసు దేవుడు",
        "ఓ దేవ మా తండ్రి",
        "మీకే స్తోత్రం హల్లేలుయా",
        "నిన్న నేడు నిరంతరం",
        "ఏక రీతిలో ఉన్న ప్రభువా",
        "అల్ఫయు నీవే ఒమేగయు నీవే",
        "ఉన్నతుడా మహోన్నతుడా మీకే స్తోత్రం",
        "ఓ దేవ మా తండ్రి",
        "మీకే స్తోత్రం హల్లేలుయా"
      ],
      "english": [
        "Siluvalo rakthamu chindhinchenu",
        "paapapu bhaaramu tholaginchenu",
        "paripoornamaina prematho",
        "kshamiyinchi rakshinchi dhaapu cherchenu",
        "O deva maa thandri",
        "meeke sthothram hallelujah",
        "Shodhanalu enno edhuregina",
        "vedhanale chelaregina",
        "mammunu kaachi balaparachi",
        "aasrayamichi kaapaadunu yesu devudu",
        "O deva maa thandri",
        "meeke sthothram hallelujah",
        "Ninna nedu nirantharam",
        "eka reethilo unna prabhuvaa",
        "alphayu neeve omegayu neeve",
        "unnathudaa mahonnathudaa meeke sthothram",
        "O deva maa thandri",
        "meeke sthothram hallelujah"
      ]
    }
  ]
}
