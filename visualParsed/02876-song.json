        "నే తాలి ప్రేమ స్తోత్రము",
        "లర్పించుచుండఁగలను."
      ],
      "english": [
        "Ne nentha chinna pillanu",
        "Naa kundu chinna baadhaku",
        "Ne thaali prema sthothramu",
        "Larpinchuchundagalanu."
      ]
    }
  ]
