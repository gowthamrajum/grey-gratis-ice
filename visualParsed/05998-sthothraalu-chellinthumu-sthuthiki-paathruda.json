{
  "song_name": "Sthothraalu chellinthumu sthuthiki paathrudaa",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Rev G Samuel"
    ],
    "రచన": [
      "రెవరెండ్ జి శామ్యూల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "స్తొత్రాలు చెల్లింతుము స్తుతికి పాత్రుడా",
      "నా జీవితాంతము అర్పింతును యేసు నాధుడా",
      "నీవు చూపిన ప్రేమను నీవు చేసిన మెళ్ళను",
      "ఎలుగెత్తి చటన ఈ విస్వమందున"
    ],
    "english": [
      "Sthothraalu chellinthumu sthuthiki paathrudaa",
      "Naa jeevithaanthamu arpinthunu Yesu naadhudaa",
      "Neevu choopina premanu neevu chesina mellanu",
      "Elugetthi chaatana ee vishwamandhuna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా పట్ల నీకున్న తలంపులు వేరయ్య",
        "నీవు చేసిన కార్యములు వర్ణింపలెనయ్య",
        "కంటికి కనబడవు చెవికి వినబడవు",
        "హ్రుదయానికి గోచరము కానెరవయ్య"
      ],
      "english": [
        "Maa patla neekunna thalampulu verayya",
        "Neevu chesina kaaryamulu varnimpalenayya",
        "Kantiki kanabadavu cheviki vinabadavu",
        "Hrudhayaaniki gocharamu kaaneravayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆత్మియులే అవమానపరచిరే",
        "అర్హతలేదని మము తోసివేసిరే",
        "నా ప్రభువా ప్రేమిచ్చావే- నీ క్రుపతో బలపరచావే",
        "సంఘాన్ని స్థిరపరచి మము ఆదరించావే",
        "నా జీవిత యాత్రలో నాతోడు నీవెనయ్య"
      ],
      "english": [
        "Aathmeeyule avamaanaparachire",
        "Arhathaledhani mamu thosivesire",
        "Naa Prabhuvaa preminchaave- Nee krupatho balaparachaave",
        "Sanghaanni sthiraparachi mamu aadharinchaave",
        "Naa jeevitha yaathralo naathodu neevenayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎవరున్న లేకున్న నీ ప్రేముంటె చాలయ్య",
        "బ్రతుకుట నీ కొరకే-చావైన లాభము",
        "నీ పాద సేవయే- నా రక్శణ భాగ్యం"
      ],
      "english": [
        "Evarunna lekunna nee premunte chaalayya",
        "Brathukuta nee korake-Chaavaina laabhamu",
        "Nee paada sevaye- Naa rakshana bhaagyam"
      ]
    }
  ]
}
