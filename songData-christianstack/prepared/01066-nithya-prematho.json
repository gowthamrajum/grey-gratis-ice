  "main_stanza": {
    "telugu": [
      "నిత్య ప్రేమతో నన్ను ప్రేమెంచెన్",
      "తల్లి ప్రేమను మించినదే",
      "లోక ప్రేమను మించినదే",
      "నిన్ను నేను ఎన్నడు విడువను",
      "నిత్యము నీతోనే జీవింతున్",
      "సత్య సాక్షిగ జీవింతున్",
      "నిత్య రక్షణతో నన్ను రక్షించెన్",
      "ఏక రక్షకుడు యేసే",
      "లోక రక్షకుడు యేసే",
      "నీ చిత్తమును చేయుటకై",
      "నీ పోలికగా ఉండుటకై",
      "నా సర్వము నీకే అర్పింతున్",
      "పూర్ణానందముతో నీకే అర్పింతున్",
      "నిత్య రాజ్యములో నన్ను చేర్పించెన్",
      "మేఘ రథములపై రానైయున్నాడు",
      "యేసు రాజుగా రానైయున్నాడు",
      "ఆరాధింతును సాష్టాంగపడి",
      "స్వర్గ రాజ్యములో యేసున్",
      "సత్య దైవం యేసున్"
    ],
    "english": [
      "Nithya prematho nannu preminchen",
      "talli premanu minchinadey",
      "loka premanu minchinadey",
      "ninnu nenu ennadu viduvanu",
      "nityamu neethoney jeevintun",
      "satya sakshiga jeevintun",
      "Nithya rakshanato nannu rakshinchen",
      "Eka rakshakudu yesey",
      "loka rakshakudu yesey",
      "nee chitthamunu cheyutakey",
      "nee polikagaa undutakey",
      "naa sarvamu neekey arpinthun",
      "poornanandamuto neekey arpintun",
      "Nithya raajyamulo nannu cherpinchen",
      "megha rathamulapai raanaiyunnaadu",
      "yesu raajuga raanaiyunnaadu",
      "aaraadhinthunu saashtaangapadi",
      "swarga raajyamulo yesun",
      "sathya daivam yesun"
    ]
  },
