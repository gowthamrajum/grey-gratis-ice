{
  "song_name": "Oohinchalenu",
  "author": {
    "Authored by": "Sampath Kareti",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఊహించలేను నీ ప్రేమను నా ఊహ చాలదయ",
      "వర్ణించలేను నీ మేలులు వర్ణనకందవయా"
    ],
    "english": [
      "Oohinchalenu nee premanu naa ooha chaaladhaya",
      "varnninchalenu nee mealulu varnnanakandhavayaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా తల్లిలా నా యెడల",
        "ప్రేమను చూపితివే",
        "నాతండ్రిలా నాపక్షమై విజయమునిచ్చితివే",
        "ఎన్నడైనా ఎడబాయక నను నడిపించితివే"
      ],
      "english": [
        "Naa thallilaa naa yedala",
        "premanu choopithive",
        "naathandrilaa naapakshamai vijayamunicchithive",
        "ennadainaa edabaayaka nanu nadipinchithive"
      ]
    }
  ]
}
