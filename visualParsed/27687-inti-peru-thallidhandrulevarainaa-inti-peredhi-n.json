{
  "song_name": "Thallithandrulevarainaa inti peredhi neekunnaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "తల్లితండ్రులెవరైనా ఇంటి పేరేది నీకున్నా",
      "పుట్టింది తోలినరుడే దేవునికి కుమారుడిగా",
      "మనమంతా పిల్లలుగా ఉండాలి కుటుంబముగా",
      "\"తల్లితండ్రు\""
    ],
    "english": [
      "Thallithandrulevarainaa inti peredhi neekunnaa",
      "Puttindi tholi narude Devuniki kumaarudigaa",
      "Manamanthaa pillalugaa undaali kutumbamugaa",
      "\"Thallithandru\""
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదామునైనా, ఆ హవ్వనైనా ఆ దేవుడే చేసాడుగా",
        "ఆ ఒకని నుండే ఎ జాతియైన నరులందరు వచ్చారుగా",
        "తల్లితండ్రి పెరుముందు ఇంటి పెరుంటే",
        "ప్రతి తండ్రి పెరుముందు ఇంటి పేరుంటే",
        "మన ఇంటికి పెరూ ఉంటె - ఆదాము ఇల్లే ఆ దేవుడే",
        "తన ఇంటి పెరె ఆ దేవుడే",
        "ఆదాము దేవునికి కుమారుడు  ||తల్లితండ్రులెవరైనా||"
      ],
      "english": [
        "Aadhaamunainaa, aa Havvanainaa aa Devude chesaadugaa",
        "Aa okani nunde e jaathiyaina narulandharu vachchaarugaa",
        "Thallithandri perumundhu inti perunte",
        "Prathi thandri perumundhu inti perunte",
        "Mana intiki peroo unte - Aadaamu ille aa Devude",
        "Thana inti pere aa Devude",
        "Aadaamu Devuniki kumaarudu ||Thallithandrulevarainaa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆదాము హవ్వ తన తరము వారికి దేవుని సంతానమణి చెప్పారుగా",
        "తమ పిల్లలంతా దేవుని కుమారులని ఆనాడు అందరికి చెప్పారుగా",
        "నేడున్న ఇంటిపెరు ఎలా వచ్చిందనీయంటే",
        "మన తండ్రి ఇంటి పేరే మనకొచ్చిదనియాంటే",
        "మన ఇంటికి పెరు ఉంటె",
        "ఆదాము తాండ్రే ఆ దేవుడే",
        "ఆ ఇంటి పేరే మనకుండలీలే..  ||తల్లితండ్రులెవరైనా||"
      ],
      "english": [
        "Aadaamu Havva thana tharamu vaariki Devuni santhaanamani cheppaarugaa",
        "Thama pillalanthaa Devuni kumaarulani aanaadu andariki cheppaarugaa",
        "Nedunna intiperu elaa vachchindhaniyante",
        "Mana thandri inti pere manakochchindhaniyante",
        "Mana intiki peru unte",
        "Aadaamu thandre aa Devude",
        "Aa inti pere manakundaleele.. ||Thallithandrulevarainaa||"
      ]
    }
  ]
}
