{
  "song_name": "Yela Padanu",
  "author": {
    "Authored by": "Pastor. Prabhu Bhushan Prathipati",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఎలాపాడనూ ఏమిచెప్పనూ",
      "యేసుని ప్రేమ మంచితణమును",
      "ఎన్నోరీతులా వివరించినా",
      "మాటలు చాలవు ఆప్రేమకు",
      "ఎందువెదకినా యేసునామమే",
      "ఎటువెళ్లినా గానమే",
      "ఎనలేని ఆనందం నా యేసుతో స్నేహం"
    ],
    "english": [
      "Ela paadanu emi cheppanu",
      "yesuni prema manchitanamunu",
      "enno reethulaa vivarinchina",
      "maatalu chaavalu a premaaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆకాశమంతా సిరాతో రాసినా",
        "వర్ణించలేను యేసు ప్రేమనూ",
        "విశ్వాంతరాలలో అన్వేషించినా",
        "యేసయ్యకు సాటిలేరేవ్వరూ",
        "ఊహకు అందనిది వర్ణించలేనిది",
        "శాశ్వతమైనది నా యేసు ప్రేమ",
        "ఎందువెదకినా యేసు నామమే",
        "ఎటువెళ్లినా యేసు గానమే",
        "ఎనలేని ఆనందం నా యేసుతో స్నేహం"
      ],
      "english": [
        "Endu vedakinaa yesunamame",
        "etuvellinaa ganame",
        "enaleni aanandam naa yesutho snehm"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మనుషులూ చేసినా దేవుళ్ళు ఎందరో",
        "నా యేసువలెనె ప్రాణము ఇవ్వలేరయ్యా",
        "మరణపునీడలో పిలిచినా మనిషికి",
        "విడుదల ఎవ్వరూ ఇవ్వలేరయ్యా",
        "ప్రాణమిచ్చినా ప్రాణదాత యేసయ్య",
        "జీవమిచ్చినా జీవదాత యేసయ్యా",
        "ఎందువెదకినా యేసు నామమే",
        "ఎటువెళ్లినా యేసు గానమే",
        "ఎనలేని ఆనందం నా యేసుతో స్నేహం"
      ],
      "english": [
        "Aakaashamantaa siratho raasinaa",
        "varninchalenu yesu premanu",
        "vishvantaraalalo anveshinchina",
        "yesayyaaku saatileleru evaroo",
        "oohaku andanidi varninchalenidi",
        "saaswathamainadi naa yesu prema"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [],
      "english": [
