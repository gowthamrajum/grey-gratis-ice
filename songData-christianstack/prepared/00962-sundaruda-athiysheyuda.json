{
  "song_name": "Sundaruda Athiysheyuda",
  "author": {
    "Authored by": "Prathap Darshi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సుందరుడా అతిశయుడా",
      "మహోన్నతుడా నా ప్రియుడా"
    ],
    "english": [
      "Sundarudaa athiysheyuda",
      "mahonnathudaa naa priyudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "Pre-Chorus:",
        "పదివేలలో నీవు అతిసుందరుడవు",
        "నా ప్రాణ ప్రియుడవు నీవే",
        "శారోను పుష్పమా లోయలోని పద్మమా",
        "నిను నేను కనుగొంటినే"
      ],
      "english": [
        "Pre-Chorus:",
        "Padhivelalo neevu athi sundarudavu",
        "naa praana priyudavu neeve",
        "Shaaronu pushpama loyaloni padmamaa",
        "ninu nenu kanugontine"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిను చూడాలని, నీ ప్రేమలో ఉండాలని",
        "నేనాశించుచున్నాను"
      ],
      "english": [
        "Ninu choodaalani, nee premalo undaalani",
        "nenaasinchuchunnaanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "Bridge:",
        "యేసయ్య నా యేసయ్యా",
        "నీవంటి వారెవ్వరూ",
        "యేసయ్య నా యేసయ్యా",
        "నీలాగా లేరెవ్వరు"
      ],
      "english": [
        "Bridge:",
        "Yesayya naa yesayya",
        "neevanti vaarevvaru",
        "yesayya naa yesayya",
        "neelaagaa lerevvaru"
      ]
    }
  ]
}
