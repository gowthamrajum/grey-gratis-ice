{
  "song_name": "Bhayapadaku",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Akumarthi Daniel"
    ],
    "రచన": [
      "బ్రదర్ ఆకుమర్తి డేనియల్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "భయపడకు భయపడకు నీ పయనం సాగించు",
      "నీతోడు యేసు నడచును ఇది నిజము (2)"
    ],
    "english": [
      "Bhayapadaku bhayapadaku nee payanam saaginchu",
      "Neethodu Yesu nadachunu idi nijamu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కోడి తన పిల్లలను రెక్కలతో కాచు రీతి",
        "యేసయ్య తన బాహువులో నిన్నునూ దాచును",
        "నీ ఎండ వేళలో మేఘమై నిలుచును యేసు (2)",
        "నీవు చలికి వణకు నపుడు అగ్నిగా కాపాడున్"
      ],
      "english": [
        "Kodi thana pillalanu rekkalatho kaachu reethi",
        "Yesayya thana baahuvulo ninnunoo daachunu",
        "Nee enda velalo meghamai niluchunu Yesu (2)",
        "Neevu chaliki vanakunapudu agnigaa kaapaadun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గర్జించు సింహములా సాతాను పొంచివున్నను",
        "యూదా గోత్రపు సింహమై ప్రభు నిన్ను కాచును",
        "అగ్నిలోబడి వెళ్ళినను జ్వాల నిను కాల్చదు (2)",
        "వాగ్ధానమిచ్చిన యేసు నెరవేర్చుదేవుడు"
      ],
      "english": [
        "Garjinchu simhamulaa Saathaanu ponchivunnanu",
        "Yoodaa gothrapu simhamai Prabhu ninnu kaachunu",
        "Agnilobadi vellinanu jwaala ninu kaalchadu (2)",
        "Vaagdhaanamichchina Yesu neraverchudhevudu"
      ]
    }
  ]
