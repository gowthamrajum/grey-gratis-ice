{
  "song_name": "Navanni Amgikarimchumi Deva Nannepudu Nivu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నావన్ని అంగీకరించుమీ దేవా నన్నెపుడు నీవు కరుణించుమీ",
      "నావన్ని కృపచేత నీవలన నొందిన భావంబునను నేను బహుదైర్యమొందెద"
    ],
    "english": [
      "Navanni Amgikarimchumi Deva Nannepudu Nivu Karunimchumi",
      "Navanni Krupacheta Nivalana Nomdina Bavambunanu Nenu Bahudairyamomdeda"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీకు నా ప్రాణము నిజముగ నర్పించి",
        "నీకు మీదుగట్టి నీ కొరకు నిల్పెద"
      ],
      "english": [
        "Niku Na Pranamu Nijamuga Narpimchi",
        "Niku Midugatti Ni Koraku Nilpeda"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సత్యంబు నీ ప్రేమ చక్కగా మధి బూని",
        "నిత్యంబు గరముల నీ సేవ జేసెద"
      ],
      "english": [
        "Satyambu Ni Prema Chakkaga Madhi Buni",
        "Nityambu Garamula Ni Seva Jeseda"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ సేవ జరిగెడు నీ ఆలయమునకు",
        "ఆశచే నడిపించు మరల నా పదములు"
      ],
      "english": [
        "Ni Seva Jarigedu Ni Alayamunaku",
        "Asache Nadipimchu Marala Na Padamulu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పెదవులతో నేను బెంపుగ నీ వార్త",
        "గదలక ప్రకటింప గలిగించు దృడభక్తి"
      ],
      "english": [
        "Pedavulato Nenu Bempuga Ni Varta",
        "Gadalaka Prakatimpa Galigimchu Drudabakti"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా వెండి కనకంబు నా తండ్రి గైకొనిమీ",
        "యావంత యైనను నాశించ మదిలోన"
      ],
      "english": [
        "Na Vemdi Kanakambu Na Tamdri Gaikonimi",
        "Yavamta Yainanu Nasimcha Madilona"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీవు నా కొసగిన నిర్మల బుద్దిచే",
        "సేవ జేయగ నిమ్ము స్థిరభక్తితో నీకు"
      ],
      "english": [
        "Nivu Na Kosagina Nirmala Buddiche",
        "Seva Jeyaga Nimmu Sthirabaktito Niku"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "చిత్తము నీ కృపా యత్తంబు గావించి",
        "మత్తిల్ల కుండగ మార్గంబు దెలుపుము"
      ],
      "english": [
        "Chittamu Ni Krupa Yattambu Gavimchi",
        "Mattilla Kumdaga Margambu Delupumu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "హృదయంబు నీకిత్తు సదనంబు గావించి",
        "పదిలంబుగా దాని బట్టి కాపాడుము"
      ],
      "english": [
        "Hrudayambu Nikittu Sadanambu Gavimchi",
        "Padilambuga Dani Batti Kapadumu"
      ]
    }
  ]
}
