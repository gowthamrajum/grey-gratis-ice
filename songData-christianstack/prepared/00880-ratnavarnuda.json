{
  "song_name": "Ratnavarnuda",
  "author": {
    "Authored by": "Pastor Praveen",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రత్నవర్ణుడా కరుణా సంపన్నుడా",
      "నీతిసూర్యుడా నా రక్షణ శృంగమా",
      "ప్రేమించినావు ప్రాణమిచ్చినావు",
      "రక్షించినావు హెచ్చించినావు",
      "నీ కృపనే ధ్యానింతును యేసయ్య",
      "నీ ప్రేమనే ప్రకటింతును"
    ],
    "english": [
      "Ratnavarnudaa karunaa sampannudaa",
      "neethi suryudaa naa rakshana srungamaa",
      "preminchinaavu praanamichinaavu",
      "rakshinchinaavu hechinchinaavu",
      "nee krupane dhyaaninthunu yesayya",
      "nee premane prakatinthunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అందరు ఉన్నారని అందరు నావారని",
        "నమ్మితిని మోసపోతిని",
        "ఒంటరిగా నిలిచితిని యేసయ్య",
        "నీవైపే చూచితిని",
        "గాడాంధకారములో నేను సంచరించిన",
        "అలసితిని సొలసితిని",
        "నడవలేక ఆగిపోతిని యేసయ్య",
        "నిను వెంబడించితిని",
        "నీలాగే ఉండాలని నీలోనే నడవాలని",
        "నీ సాక్షిగా బ్రతకాలని నీ సేవలో సాగాలని",
        "నీ మహిమలో నిలవాలని యేసయ్య",
        "నీ కృపనే కోరితిని"
      ],
      "english": [
        "Andaru unnaarani andaru naavaarani",
        "nammithini mosapothini",
        "ontarigaa nilichithini yesayya",
        "neevaipe choochithini",
        "Gaadaandhakaaramulo nenu sancharinchina",
        "alasithini solasithini",
        "nadavaleka aagipothini yesayya",
        "ninu vembadinchithini",
        "Neelaage undaalani neelone nadavaalani",
        "nee saakshigaa brathakaalani",
        "nee sevalo saagaalani",
        "nee mahimalo nilavaalani yesayya",
        "nee krupane korithini"
      ]
    }
  ]
}
