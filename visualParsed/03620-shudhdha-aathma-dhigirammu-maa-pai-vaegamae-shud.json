  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శుద్ధ ఆత్మ దిగిరమ్ము - మా పై వేగమే",
        "శుద్ధి యేసు నీ ఈవుల మాకీయుమా"
      ],
      "english": [
        "Shuddha aathma dhigirammu - Maa pai vegame",
        "Shuddhi Yesu nee eevula maakeeyumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పెంతెకోస్తను నాట దిగివచ్చిన",
        "ప్రియ ఆత్మ దిగిరమ్ము ఈ వేళయందు"
      ],
      "english": [
        "Penthekosthanu naatha dhigivachchina",
        "Priya aathma dhigirammu ee velayandhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దప్పిగొన్న ఆత్మలను దప్పి తీర్చును",
        "తప్పక ఒక్కొక్కరిని సంధించు వేగ"
      ],
      "english": [
        "Dhappigonna aathmalanu dhappi theerchunu",
        "Thappaka okkokkarini sandhinchu vega"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రేమతోడనే శుద్ధ పావురమా రా",
        "డాసి మమ్ము యుద్ధమునకు సిద్ధపర్చుమా"
      ],
      "english": [
        "Prematodane shuddha paavuramaa raa",
        "Daasi mammu yuddhamunaku siddhaparchumaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నిద్ర కష్టముల సోమరత్వమున్ వీడి",
        "స్తోత్రింప నుత్సాహమును మా పై పోయుమా"
      ],
      "english": [
        "Nidra kashtamula somarathvamun veedi",
        "Sthothrimpa nuthsaahamunu maa pai poyumaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "గత కాలమందు జయమిచ్చిన యట్టి",
        "నూతన ప్రార్థన వాంఛ మాలో పోయుమా"
      ],
      "english": [
        "Gatha kaalamandu jayamichchina yatti",
        "Noothana praarthana vaancha maalo poyumaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "అనుదిన మాత్మలను సంపాదించను",
        "గిన్నెనిండి పొర్లిపార నాత్మనీయుము"
      ],
      "english": [
        "Anudina maathmalanu sampaadhinchanu",
        "Ginnenindi porlipaara naathmaneeyumu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ప్రేమ దీనత్వము శాంత సమాధానముల్",
        "సంతోషము మాలో వృద్ధి పొందజేయుమా"
      ],
      "english": [
        "Prema dheenathvamu shaantha samaadhaanamul",
        "Santhoshamu maalo vruddhi pondhajeyumaa"
      ]
    }
  ]
}
