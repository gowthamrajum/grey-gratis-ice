{
  "song_name": "Yesayya manaku sahaayam",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యేసయ్య మనకు సహాయం",
      "మెస్సెయ్యగలడు మన భారం",
      "ఏ భాదలు ఏమున్ననను",
      "తొలగించి ఇచ్చున భయం"
    ],
    "english": [
      "Yesayya manaku sahaayam",
      "Moseyyagaladu mana bhaaram",
      "E baadhalu emunnananu",
      "Tholaginchi ichchuna bhayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదాము నాడు పాపము చేసి హవ్వను నిందించే",
        "ఆహవ్వ నడుగ తాను కాదని పాపమును చూపించే",
        "ఆవాడుకే ఈనాడు వచ్చింది మనకు చూడు ||యే||"
      ],
      "english": [
        "Aadaamu naadu paapamu chesi Havvanu nindhinche",
        "Aa Havva nadhuga thaanu kaadani paapamunu choopinche",
        "Aavaaduke eenaadu vachchindi manaku choodu ||Ye||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సాతాను మనకు మత్తుజల్లి మాయ జేసెను",
        "పాపాలు చేయ నేర్చితానే పొంగిపోయెను యేసే కదా శరణ్యం",
        "సాతాను పూనే అసహ్యం ఏనాడును నిను వీడడు",
        "యేసయ్య మనకు తోడు ||యే||"
      ],
      "english": [
        "Saathaanu manaku matthujalli maaya jesenu",
        "Paapaalu cheya nerchithaane pongipoyenu Yese kadaa sharanyam",
        "Saathaanu poone asahyam enaadunu ninu veedadu",
        "Yesayya manaku thodu ||Ye||"
      ]
    }
  ]
}
