        "Kshemamu kalugunani nenandhunu"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "దేవుడైన యెహోవా మందిరమును బట్టి",
        "నీకు మేలుచేయ ప్రయత్నించెదను"
      ],
      "english": [
        "Dhevudaina Yehova mandhiramunu batti",
        "Neeku melucheya prayathninchedhanu"
      ]
    }
  ]
