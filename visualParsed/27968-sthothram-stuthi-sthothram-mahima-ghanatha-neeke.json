  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భాద కలుగు సమయములో నాకు తోడై నిలచి",
        "కష్ట నష్టాలలో నాకు నీడై నిలచి",
        "నను దైర్యపరచితివి నా వెంట నిలచితివి",
        "నే చేసిన పాపముకై శిక్ష నీవు పొందితివి",
        "నే చేసిన దోషముకై సిలువలో మరణించితివి",
        "మృత్యుంజయుడై నిలచి మరణాన్నే గెలచితివి  ||స్తోత్రం||"
      ],
      "english": [
        "Baadha kalugu samayamulo naaku thodai nilachi",
        "Kashta nashtaalalo naaku needai nilachi",
        "Nanu dhairyaparachithivi naa venta nilachithivi",
        "Ne chesina paapamukai shiksha neevu pondhithivi",
        "Ne chesina dhoshamukai siluvalo maraninchithivi",
        "Mruthyunjayudai nilachi maranaanne gelachithivi  ||Sthothram||"
      ]
    }
  ]
