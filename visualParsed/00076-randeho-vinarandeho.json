  "main_stanza": {
    "telugu": [
      "రండహో వినరండహో శుభ వార్త ఒకటి వినిపించెదం",
      "సంతోషముతో దరి చేరండి సంభ్రాలతో యిక స్తుతి కలపండి (2)",
      ".. రండహో"
    ],
    "english": [
      "Randaho vinarandaho shubha vaartha okati vinipinchedam",
      "Santhoshamutho dari cherandi sambhraalatho ika sthuthi kalapandi (2)",
      ".. Randaho"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అలనాడు బెత్లేహేము పశుల పాకలో",
