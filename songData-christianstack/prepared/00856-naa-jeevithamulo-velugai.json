{
  "song_name": "Naa Jeevithamulo Velugai",
  "author": {
    "Authored by": "Kripal Mohan",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా జీవితములో వెలుగై నిలిచినా",
      "జోతిర్మయుడైన నా యేసురాజును",
      "ఆత్మతో సత్యముతో ఆరాధించెదా"
    ],
    "english": [
      "Naa jeevithamulo velugai nilichinaa",
      "joathirmayudaina naa yesuraajunu",
      "aathmatho satyamutho aaraadhinchedaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తండ్రి తనయునిపై జాలి పడినట్టుగా",
        "తండ్రిగా నాపై జాలి చూపిస్తివే",
        "కరుణమయుడైన నా యేసురాజుని",
        "ఆత్మతో సత్యముతో ఆరాధించెదా",
        "తల్లి మరచినా మరువనంటివే",
        "శాశ్వత ప్రేమతో నను ప్రేమిస్తివే",
        "ప్రేమామయుడైనా ఆ యేసునాధుని",
        "ఆత్మతో సత్యముతో ఆరాధించెదా"
      ],
      "english": [
        "Thandri thanayunipai jaali padinattugaa",
        "thandrigaa naapai jaali choopisthive",
        "karunamayudaina naa yesuraajuni",
        "aathmatho sathyamutho aaraadhinchedaa",
        "Thalli marachinaa maruvanantive",
        "saasvatha prematho nanu premisthive",
        "premaamayudainaa aa yesunaadhuni",
        "aathmatho sathyamutho aaraadhinchedaa"
      ]
    }
  ]
}
