  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవ సంద్రము మీఁద భుమి పునాది వేసె",
        "మహాజలమూల మీఁద మనదేవుఁడది స్థిరపర్చె"
