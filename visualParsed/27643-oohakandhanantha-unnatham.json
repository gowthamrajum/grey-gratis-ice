{
  "song_name": "Oohakandhanantha unnatham",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఊహకందనంత ఉన్నతం నాపట్ల",
      "నీవు చూపుచున్న ప్రేమ యేసయ్యా",
      "స్థితిని పరిగణించక గతము చూడక",
      "నన్ను కోరుకున్న రీతి ఎంత అద్భుతం",
      "ప్రాణమిచ్చునంతటి గాఢమైన ప్రేమది",
      "నాకు అనుగ్రహించబడినది"
    ],
    "english": [
      "Oohakandhanantha unnatham naapatla",
      "Neevu choopuchunna prema Yesayyaa",
      "Sthithini pariganinchaka gathamu choodaka",
      "Nannu korukunna reethi entha adbhutham",
      "Praanamichchunanthati gaadhamaina premadi",
      "Naaku anugrahinchabadinadhi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జారిపడ్డ చోటునే వదిలివేయక",
        "వెదకి పలకరించి నిలువబెట్టుకున్నది",
        "గాయము మాన్పిన స్వస్థత కూర్చిన",
        "దివ్య ప్రేమది యేసూ నాకు వరమది"
      ],
      "english": [
        "Jaaripadda chotune vadhiliveyaka",
        "Vedaki palakarinchi niluvabettukunnadhi",
        "Gaayamu maanpina swasthatha koorchina",
        "Divya premadi Yesoo naaku varamadhi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దూరమైన వేళలో తడవు చేయక",
        "పిలిచి కనికరించి తిరిగి చేర్చుకున్నది",
        "రూపము మార్చిన క్షేమమునిచ్చిన",
        "గొప్ప ప్రేమది యేసూ నాకు వరమది"
      ],
      "english": [
        "Dooramaina velalo thadavu cheyaka",
        "Pilichi kanikarinchi thirigi cherchukunnadhi",
        "Roopamu maarchina kshemamunichchina",
        "Goppa premadi Yesoo naaku varamadhi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కృంగదీయు బాధలో ముఖము దాచక",
        "మనవి అనుగ్రహించి కృపను చూపుచున్నది",
        "అక్కర తీర్చిన ధైర్యము నింపిన",
        "వింత ప్రేమది యేసూ నాకు వరమది"
      ],
      "english": [
        "Krungadheeyu baadhalo mukhamu dhaachaka",
        "Manavi anugrahinchi krupanu choopuchunnadhi",
        "Akkara theerchina dhairyamu nimpina",
        "Vintha premadi Yesoo naaku varamadhi"
      ]
    }
  ]
}
