{
  "song_name": "Kannititho Padaalane Kadigina Naa Hrudhayamunu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కన్నీటితో పాదలనె కడగన నా హృదయమునె నీకై ఆర్పించన",
      "వెలకట్టలెనిది నీ ప్రేమ నాపై (2)",
      "నా ప్రాణమా నా అంతరంగమా నాలో సమస్తమా సన్నుతించుమా",
      "ఆ వేదనతో భాదతో విసిగి వెసారినావా (2)"
    ],
    "english": [
      "Kannititho Padaalane Kadigina Naa Hrudhayamunu Nekai Aarpinchina",
      "Velakaattalenidhe Nee Prema Napai (2)",
      "Naa Pranama Naa Antharangama Naalo Samasthama Sannuthinchuma",
      "Aavedhanatho Bhadhatho Visigi Veysarinava (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కనులనుండి రాలె నా ప్రతి బాషపభిందువు",
        "నీ ఆరచేతిలో బద్రమంటివె (2)"
      ],
      "english": [
        "Kanulanundi Raalye Naa Prathi Bhashpabindhuvu",
        "Nee Aarachethilo Badhramantive (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శిలువ నుండి కార్చె నీ ప్రతి రక్త బిందువు",
        "నా పాప దోషము నుండి విడిపించెనె (2)"
      ],
      "english": [
        "Siluva Nundi Karche Nee Prathi Raktha Bhinduvu",
        "Na Papa Doshamu Nundi Vidipinchene (2)"
      ]
    }
  ]
