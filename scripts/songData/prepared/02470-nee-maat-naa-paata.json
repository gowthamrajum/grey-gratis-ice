{
  "song_name": "Nee Maata Naa Paatagaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ మాట నా పాటగా - అనుక్షణం పాడనీ",
      "లోకాన నిను చాటగా - నా స్వరం వాడనీ",
      "నా గీతం కలిగించి - నీలోనే ప్రహర్షించనీ"
    ],
    "english": [
      "Nee Maata Naa Paatagaa - Anukshanam Paadanee",
      "Lokaana Ninu Chaatagaa - Naa Swaram Vaadanee",
      "Naa Geetham Kaliginchi - Neelone Praharshinchanee"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏ చోట గళమెత్తినా - నీ ప్రేమ ధ్వనియించనీ",
        "పాడేటి ప్రతి పాటలో - నీ రూపు కనిపించనీ = 2",
        "వినిపించుచున్నప్పుడే - ఉద్రేకమును రేపక",
        "స్థిరమైన ఉజ్జీవము - లోలోన రగిలించనీ",
        "నా గీతం కలిగించి - నీలోనే ప్రహర్షించనీ"
      ],
      "english": [
        "E Chota Galamethinaa - Nee Prema Dhwaniyinchanee",
        "Paadeti Prathi Paatalo - Nee Roopu Kanipinchanee = 2",
        "Vinipinchuchunnappude - Udrekamunu Repaka",
        "Sthiramaina Ujjeevamu - Lolona Ragilinchanee",
        "Naa Geetham Kaliginchi - Neelone Praharshinchanee"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దివ్య గానామృతం - జలధారలుగా పొంగనీ",
        "తాకేటి ప్రతి వారినీ - ఫలవంతముగా మార్చనీ = 2",
        "శృతిలయలు లోపించక - విసిగింపు కలిగించక",
        "నిజమైన ఉల్లాసమై - నిలువెల్లా కదిలించనీ",
        "నా గీతం కలిగించి - నీలోనే ప్రహర్షించనీ"
      ],
      "english": [
        "Nee Dhivya Gaanaamrutham - Jaladhaaralugaa Ponganee",
        "Thaaketi Prathi Vaarinee - Phalavanthamugaa Maarchanee = 2",
        "Shruthilayalu Lopinchaka - Visiginpu Kaliginchaka",
        "Nijamaina Ullaasamai - Niluvellaa Kadilinchanee",
        "Naa Geetham Kaliginchi - Neelone Praharshinchanee"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మీయ గీతాలతో - తనువంతా పులకించనీ",
        "సంగీతమే భోధయై - కనువిప్పు కలిగించనీ = 2",
        "కాలక్షేపం కోసమే - పరిమితము కాకుండగా",
        "హృదయాల్లో నివసించుచూ - కార్యాలు జరిగించనీ",
        "నా గీతం కలిగించి - నీలోనే ప్రహర్షించనీ"
      ],
      "english": [
        "Aathmeeya Geethaalatho - Thanuvanthaa Pulakinchanee",
        "Sangeethame Bhodhayai - Kanuvippu Kaliginchanee = 2",
        "Kaalakshepam Kosame - Parimithamu Kaakundagaa",
        "Hrudhayaallo Nivasinchuchoo - Kaaryaalu Jariginchanee",
        "Naa Geetham Kaliginchi - Neelone Praharshinchanee"
      ]
    }
  ]
}
