{
  "song_name": "Chitramaina Puttuka Needhi",
  "author": {
    "Authored by": "Sunith & Bobby jeevan",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "చిత్రమైన పుట్టుక నీది",
      "మేము సంతసించు వెళాయేయిది",
      "నీ ఒక్క జన్మము ఓ గొప్ప మర్మము",
      "పవిత్ర ప్రేమకు నిజమైన సాదృశ్యం"
    ],
    "english": [
      "Chitramaina puttuka needi",
      "Meamu santasinchu vellayea edi",
      "Nii okka janmamu oo goppa marmamu",
      "Pavita preamaku nijamaina saadrusyam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సృష్టికర్తవై శరీరధారిగా",
        "పుడమిపై వెలసిన పూజ్యనీయుడా",
        "పరమతండ్రివై పాపరహితునిగా",
        "ప్రేమ తోడ వచ్చిన యేసునాథుడా",
        "ఊహకు అందదే నీ ప్రేమ మాదుర్యము",
        "వర్ణన కందదే నీ యొక్క వాత్సల్యము",
        "చిత్రమే విచిత్రమే యేసయ్య నీ జననము"
      ],
      "english": [
        "Srushttikarthavai sariiradhaarigaa",
        "Pudamipaina velasina puujyaneeyudaa",
        "Paramathandrivai paaparahithunigaa",
        "Preama thooda vacchina yeasunaadhudaa",
        "Oohaku andadea nii preama maaduryamu",
        "Varnana kandadea nii yokka vaathsalyamu",
        "Chitramea vichitramea yesayya nii jananamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సర్వ జనుల పాపపరిహార్థమై",
        "కన్య మరియా గర్భమందు ఉద్భవించావు",
        "సర్వ ప్రజల రక్షణార్థమై",
        "పరిశుద్దుని గా ఇలలో పుట్టియున్నావు",
        "చీకటిలోనా జీవనజ్యోతిగా",
        "మరణఛాయలో… జీవ ప్రధాతగా..",
        "దివి నుండి భువి కొచ్చిన",
        "ఇమ్మానుయేలువే"
      ],
      "english": [
        "Sarva janula paapaparihaardhamai",
        "Kanya mariyaa garbhamandu udbhavinchaavu",
        "Sarva prajala rakshannardhamai",
        "Parisudhunigaa ilaloo puttiyunnaavu",
        "Chiikatiloonaa jeevanajyoothigaa",
        "Marannachaayaloo jiiva pradhaathagaa",
        "Dhivi nundi bhuvikocchina immaanuyealuvea"
      ]
    }
  ]
}
