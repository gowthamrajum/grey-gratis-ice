        "Rakshakudavugaa nundi Prabhuvaa",
        "Sukhashaanthitho gaachithivi",
        "Dhanya dhanya dhanya Prabhuku",
        "Thaane rakshana mana kosage",
        "Nee sannidhiki nadipi Prabhuvaa",
        "Raathrimbavallu gaachithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
