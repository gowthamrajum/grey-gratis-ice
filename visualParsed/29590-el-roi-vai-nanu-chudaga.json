    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ ముఖ కాంతియే నా ధైర్యము",
        "నీ ముఖ కాంతియే నా బలము"
      ],
      "english": [
        "Nee mukha kaanthiye naa dhairyamu",
        "Nee mukha kaanthiye naa balamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మరణమే నన్నావరించగా",
