{
  "song_name": "DivyaSakhudaa",
  "author": {
    "Authored by": "Pastor Ramesh",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సఖుడా – దివ్య సఖుడా",
      "ప్రియుడా – ప్రాణ ప్రియుడా",
      "నీతో అనుబంధము కాదే ఈ నాటిది",
      "ఏనాటికీ వీడిపోదు – విభుడా యేసయ్యా",
      "ఇన్నినాళ్ల తీపి జ్ఞాపిక – పలికే గీతిక"
    ],
    "english": [
      "Sakhudaa – dhivya sakhudaa",
      "Priyudaa – praana priyudaa",
      "Neetho anubandhamu kaadhe ee naatidhi",
      "Enaatiki veedipodhu – vibhudaa Yesayya",
      "Inninalla theepi gnaapika – palike geethika"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మౌనరాగమే – మధురగానమై",
        "మరుపురానిదై – మదిలో నిలిచెగా",
        "ఊహించని శోధనలే – శృతిలయలు నేర్పినాయి పలుశ్రమలు నడిపినాయి నీ ప్రేమ శిఖరానికి",
        "ఏకాంత వేళలో – ఏ కాంతి లేకున్ననూ",
        "నా పాదములు జ్ఞారక – కాపాడే యేసయ్యా"
      ],
      "english": [
        "Mouna raagame – madhura gaanamai",
        "Marupuraanidhai – madhilo nilichegaa",
        "Oohinchani shodhanale – shruthilayalu nerpinayi",
        "Palu sramalu nadipinayi nee prema shikharaniki",
        "Ekaantha velalo – ee kaanthi lekunnanu",
        "Naa paadamulu jaaraka kaapaade Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సద్గుణ రాశివి నీవేనని",
        "స్తుతి మహిమలు చెల్లించెదను",
        "నిత్యము నిను కీర్తించెదను"
      ],
      "english": [
        "Sadhguna raasivi neevenani",
        "Sthuthi mahimalu chellinchedhanu",
        "Nithyamu ninu keerthinchedhanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిండు మనస్సులో – ప్రేమ దీపమై",
        "మారుమనస్సుకై – సత్యమార్గమై",
        "పలికే ప్రేమనీవై – నీవు నాతో నున్నావు",
        "నా హృదయసీమ నేలే – మహరాజుగా నిలిచావు",
        "నీవు నా ముందుగా – నడిచే కాపరిగా",
        "నా చేయి వీడకా – నడిపించే యేసయ్యా"
      ],
      "english": [
        "Nindu manassulo – prema dheepamai",
        "Maaru manassukai – sathya maargamai",
        "Palike prema neevai – neevu naatho unnaavu",
        "Naa hrudhaya seema nele – Maharaajuga nilichaavu",
        "Neevu naa mundhuga – nadiche kaaparigaa",
        "Naa cheyi veedhakaa – nadipinche Yesayya"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సద్గుణ రాశివి నీవేనని",
        "స్తుతి మహిమలు చెల్లించెదను",
        "నిత్యము నిను కీర్తించెదను"
      ],
      "english": [
        "Sadguna raasivi neevenani",
        "Sthuthi mahimalu chellinchedhanu",
        "Nithyamu ninu keerthinchedhanu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రమ్యమైనది – భాగ్యమైనది",
        "నిత్యమైనది – సరిపోల్చలేనిది",
        "నీ మహిమ రాజ్యమందు – సీయోను శిఖరమందు",
        "నే పరవశించి పాడే – గొప్ప భాగ్యమిచ్చినావు నూతనమైనది – ఎవరూ పాడలేని",
        "శ్రేష్ఠమైన గీతం – నే పాడెద యేసయ్యా"
      ],
      "english": [
        "Ramyamainadhi – bhaagyamainadhi",
        "Nithyamainadhi – saripolchalenidhi",
        "Nee mahima raajyamandhu – Seeyonu shikharamandhu",
        "Ne paravashinchi paade – goppa bhaagyam ichchinaavu",
        "Noothanamainadhi – evaroo paadaleni",
        "Shreshtamainaa geetham – ne paadedhaa Yesayya"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సద్గుణ రాశివి నీవేనని",
        "స్తుతి మహిమలు చెల్లించెదను",
        "నిత్యము నిను కీర్తించెదను"
      ],
      "english": [
        "Sadhguna raasivi neevenani",
        "Sthuthi mahimalu chellinchedhanu",
        "Nithyamu ninu keerthinchedhanu"
      ]
    }
  ]
}
