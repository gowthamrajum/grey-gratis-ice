{
  "song_name": "Yesu sheeghramugaa vachchun aashatho kanipettudi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యేసు శీఘ్రముగా వచ్చున్ ఆశతో కనిపెట్టుడి"
    ],
    "english": [
      "Yesu sheeghramugaa vachchun aashatho kanipettudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గురుతులెల్ల లోకమంతా - సరిగజూడ కాననగున్",
        "పరిశుద్ధమైన ప్రవర్తనతో - ప్రభుకై కనిపెట్టుడి"
      ],
      "english": [
        "Guruthulella lokamanthaa - Sarigajooda kaananagun",
        "Parishudhdhamaina pravarthanatho - Prabhukai kanipettudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రొద్దు గ్రుంకి వచ్చునేమో - అర్ధరాత్రి యందేమో",
        "ఉదయంపు కోడికూతలప్పుడు - వచ్చునేమో కనిపెట్టుడి"
      ],
      "english": [
        "Proddhu grunki vachchunemo - Ardharaathri yandhemo",
        "Udhayampu kodikoothalappudu - Vachchunemo kanipettudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సిద్ధపడుడి మీరిలలో - మీరు దేవుని సంధింప",
        "సిద్ధపడుడి తీర్పునకై - ప్రభువుకై కనిపెట్టుడి"
      ],
      "english": [
        "Sidhdhapadudi meerilalo - Meeru Devuni sandhinpa",
        "Sidhdhapadudi theerpunakai - Prabhuvukai kanipettudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధులై జీవించుడి - ప్రభుని చిత్తము చేయుడి",
        "మరణమేసు నందె సుమ్మా - మేలుకొని కనిపెట్టుడి"
      ],
      "english": [
        "Parishudhdhulai jeevinchudi - Prabhuni chitthamu cheyudi",
        "Maranamesu nande summaa - Melukoni kanipettudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసువలె జీవించుడి - తీసి వేయుడి మలినములన్",
        "మోసంపుటాశల నన్ని విడచి - ఆశతో కనిపెట్టుడి"
      ],
      "english": [
        "Yesuvale jeevinchudi - Theesi veyudi malinamulan",
        "Mosamputaashala nanni vidachi - Aashatho kanipettudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వేషధారణ విడచి - యేసు ముద్రల ధరించి",
        "పెండ్లి కుమారుని సంధింప - అందరు కనిపెట్టుడి"
      ],
      "english": [
        "Veshadhaarana vidachi - Yesu mudhrala dharinchi",
        "Pendli kumaaruni sandhinpa - Andaru kanipettudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మేఘములపై వెళ్ళిన ప్రభు - వేగముగ వచ్చునిల",
        "సకల శ్రమలను భరించి - హల్లెలూయ పాడుడి"
      ],
      "english": [
        "Meghamulapai vellina prabhu - Vegamuga vachchunila",
        "Sakala shramalanu bharinchi - Hallelooya paadudi"
      ]
    }
  ]
}
