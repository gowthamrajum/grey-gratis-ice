    "english": [
      "Saahasakaaryaalu cheyagalige Devuni hasthamu",
      "Chaachabadi yunnadi - Saayapaduchunnadhi",
      "Saadhyamu cheyuchunnadhi",
      "A.pa: Cheyipatti nadupunadhi - Vennutatti nilupunadhi",
      "Neethigala Yehova hasthamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
