{
  "song_name": "Yaesuni Shramalathoada Aashathoa Paalu Pomdhedhanu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసుని శ్రమలతోడ - ఆశతో పాలు పొందెదను",
      "అను ఇతని ఓదార్పు నిజము - ఇతర ఓదార్పు వృథయే"
    ],
    "english": [
      "Yaesuni Shramalathoada - Aashathoa Paalu PoMdhedhanu",
      "Anu Ithani Oadhaarpu Nijamu - Ithara Oadhaarpu VruThayae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిందలెల్ల ఏకముగా - మహామహునిమీద బడగా",
        "వింతగానే యోర్చుకొనెను - తండ్రి మాట నేరవేర్చెన్"
      ],
      "english": [
        "NiMdhalella Aekamugaa - Mahaamahunimeedha Badagaa",
        "ViMthagaanae Yoarchukonenu - ThMdri Maata Naeravaerchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దుఃఖముతో నిండియుండెన్ - ప్రక్కలోన గ్రుచ్చబడెను",
        "రక్తితోడ యోర్చుకొని వి - రక్తి మాట పల్కకుండెన్"
      ],
      "english": [
        "DhuHkhamuthoa NiMdiyuMden - Prakkaloana Gruchchabadenu",
        "Rakthithoada Yoarchukoni Vi - Rakthi Maata PalkakuMden"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శోకంబు చెత నేను - నాకంబు కదిలింతును",
        "రక్తంబు ధార పోసెన్ - రిక్తులమైన మనకు"
      ],
      "english": [
        "ShoakMbu Chetha Naenu - NaakMbu KadhiliMthunu",
        "RakthMbu Dhaara Poasen - Rikthulamaina Manaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సదయుని రక్తముచే - హృదయాలంకారముచే",
        "కలుగు నాహారమిదే - ఎల్లరకు శ్రేష్టాహారం"
      ],
      "english": [
        "Sadhayuni Rakthamuchae - HrudhayaalMkaaramuchae",
        "Kalugu Naahaaramidhae - Ellaraku ShraeShtaahaarM"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తల్లి ప్రేమకన్న మిగుల - తన ప్రేమ చూపె మనకై",
        "నోటి మాటతోడ శత్రున్ - కోటల నశింపజేసెన్"
      ],
      "english": [
        "Thalli Praemakanna Migula - Thana Praema Choope Manakai",
        "Noati Maatathoada Shathrun - Koatala NashiMpajaesen"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నా యేసు రక్తచెమట - నాయప్పు యంతయున్ తీర్చెన్",
        "ఎల్లరికి నగీకారమిదే - ఎల్లప్పుడు నా ధ్యానమున్"
      ],
      "english": [
        "Naa Yaesu Rakthachemata - Naayappu YMthayun Theerchen",
        "Ellariki Nageekaaramidhae - Ellappudu Naa Dhyaanamun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయా గీతమును - ఎల్లపుడు చాటుచుందున్",
        "ఎల్లరియందు తానే - ఎల్లప్పుడు వసించున్"
      ],
      "english": [
        "Hallelooyaa Geethamunu - Ellapudu ChaatuchuMdhun",
        "EllariyMdhu Thaanae - Ellappudu VasiMchun"
      ]
    }
  ]
}
