{
  "song_name": "Nee Chithame",
  "author": {
    "Authored by": "Pastor Ravinder Vottepu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ చిత్తమే జరగాలి నాలో యేసయ్య",
      "నీ రాజ్యమే రావాలి నాలో యేసయ్య"
    ],
    "english": [
      "Nee chittame jaragaali naalo yesayya",
      "nee raajyame raavaali naalo yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అను పల్లవి:",
        "ఆత్మతో నింపుము నీవలే బ్రతికెదా",
        "మార్గము చూపుము నీవలే నడిచెదా"
      ],
      "english": [
        "Anu Pallavi:",
        "Aathmatho nimpumu neevale brathikedhaa",
        "maargamu choopumu neevale nadichedhaa"
      ]
    }
  ]
}
