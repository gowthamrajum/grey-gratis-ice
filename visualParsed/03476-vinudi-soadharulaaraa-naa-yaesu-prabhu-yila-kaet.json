{
  "song_name": "Vinudi sodharulaaraa - Naa Yesu Prabhu - Ila kethenchen",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వినుడి సోదరులారా - నా యేసు ప్రభు - యిల కేతెంచెన్"
    ],
    "english": [
      "Vinudi sodharulaaraa - Naa Yesu Prabhu - Ila kethenchen"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇలకేతెంచెన్ - ముక్తిని దెచ్చెన్",
        "పాపుల విడిపించెన్ - విడిపించ నేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Ilakethenchen - Mukthini dhechchen",
        "Paapula vidipinchen - Vidipincha nesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్వర్గీయ తండ్రికి - ఏక కుమారుడు",
        "మనుష్య పుత్రుండాయెన్ - పుత్రుండుగా యిలకేతెంచెన్"
      ],
      "english": [
        "Swargeeya thandriki - Eka kumaarudu",
        "Manushya puthrundaayen - Puthrundugaa ilakethenchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గ్రుడ్డికి కన్నులు - మూగకి మాటలు",
        "చెవిటికి చెవుల నిచ్చెన్ - యిచ్చుటకేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Gruddiki kannulu - Moogaki maatalu",
        "Chevitiki chevula nichchen - Ichchutakesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కుష్టు రోగుల - శుద్ధులజేసెను",
        "చచ్చినవారిని లేపెన్ - లేపుటకేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Kushtu rogula - Shuddhulajesenu",
        "Chachchinavaarini lepen - Leputakesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపములో నీవు - పడియుండగా",
        "పవిత్ర ప్రేమను జూపెన్ - జూపించనేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Paapamulo neevu - Padiyundagaa",
        "Pavithra premanu joopen - Joopinchanesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పాపిల కొరకై - సిలువను మోసెన్",
        "రక్తము చిందించెన్ - చిందించ నేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Paapila korakai - Siluvanu mosen",
        "Rakthamu chindhinchen - Chindhincha nesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యేసు నామమున - విశ్వాసముంచుము",
        "నిశ్చయముగ రక్షించున్ - రక్షించనేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Yesu naamamuna - Vishwaasamunchumu",
        "Nishchayamuga rakshinchun - Rakshinchanesu ilakethenchen"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "మహిమ ఘనత - మాయేసు ప్రభునకే",
        "మమ్ముల తండ్రితో జేర్చెన్ - జేర్చుటకేసు యిలకేతెంచెన్"
      ],
      "english": [
        "Mahima ghanatha - Maayesu Prabhunake",
        "Mammula thandritho jerchen - Jerchutakesu ilakethenchen"
      ]
    }
  ]
}
