      ],
      "english": [
        "Ninnu nenu preminchakamundhe",
        "Nannu neevu preminchithive",
        "Nee mahimananthaa vidachi",
        "Naakorakai dhigivachchithive"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిన్ను నేను ప్రేమించకముందే",
        "నన్ను నీవు ప్రేమించితివే",
