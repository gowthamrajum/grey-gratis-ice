{
  "song_name": "Mahima Neekey",
  "author": {
    "Authored by": "Ravinder Vottepu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మహిమ నీకే ఘనత నీకే నీతి సూర్యుడా",
      "న్యాయధిపతియైన నా యేసయ్య నీకే ఆరాధన",
      "ధనవంతులను అణచేవాడవు",
      "జ్ఞానులను సిగ్గుపరచువాడవు",
      "దరిద్రులను లేవనెత్తువాడవు నీవే రాజువు",
      "యుద్ధవీరుడా శూరుడ",
      "లోకాన్ని గెలిచిన నా యేసయ్య"
    ],
    "english": [
      "Mahima neekey ghanatha neekey neethi suryudaa",
      "nyaayadhipathiyaina naa yesayya neekey aaraadhana",
      "dhanavanthulanu anachevaadavu",
      "gnaanulanu sigguparachuvaadavu",
      "daridrulanu levanethuvaadavu neevey raajuvu",
      "yuddhaveerudaa sooruda",
      "lokaanni gelichina naa yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మార్గమే తెలియని అబ్రహామును",
        "అనేకులకు తండ్రిగా చేసినావు",
        "నెట్టివేయబడిన యోసేపుచే",
        "అనేకులను కాపాడినావు",
        "గొర్రెల కాపరైన దావీదును",
        "అనేకులకు రాజుగా చేసినావు",
        "నోటి మాంద్యమున్నట్టి మోషేచే",
        "అనేకులను విడిపించినావు"
      ],
      "english": [
        "Maargamey theliyani abrahaamunu",
        "aneykulaku thandrigaa chesinaavu",
        "nettiveyabadina yosepuche",
        "aneykulanu kaapaadinaavu",
        "Gorrela kaaparaina dhaaveedunu",
        "aneyakulaku raajugaa chesinaavu",
        "noti maandyamunnatti moshey che",
        "anekulanu vidipinchinaavu"
      ]
    }
  ]
}
