{
  "song_name": "Naenae Unnavaadananina Adhvitheeya Prabhu Aaraadhimthu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నేనే ఉన్నవాడననిన అద్వితీయ ప్రభు ఆరాధింతు"
    ],
    "english": [
      "Naenae Unnavaadananina Adhvitheeya Prabhu Aaraadhimthu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆర్ఫాయు ఓమేగ వర్తమాన - భూత భవిష్యత్తులో నున్నవాడా",
        "నా సర్వము నిర్వహించువాడా - సర్వాధికారి నిన్నే స్తుతించి",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Aarphaayu Oamaega Varthamaana - Bhootha Bhavishyaththuloa Nunnavaadaa",
        "Naa Sarvamu Nirvahimchuvaadaa - Sarvaadhikaari Ninnae Sthuthimchi",
        "Arpimthu Neekae Naa Aaraadhana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏడు సువర్ణ దీపస్తంభముల - మధ్య సంచరించుచున్నవాడా",
        "శుద్దీకరించితివి నన్ను - మేలిమిగ మార్చి సంఘమున",
        "చేర్చితివి నిన్నే ఆరాధింతు"
      ],
      "english": [
        "Aedu Suvarna Dheepasthambhamula - Madhya Samcharimchuchunnavaadaa",
        "Shuddheekarimchithivi Nannu - Maelimiga Maarchi Samghamuna",
        "Chaerchithivi Ninnae Aaraadhimthu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తెల్లని ఉన్నిని పోలియున్న - వెంట్రుకలు కలిగి యున్నవాడా",
        "ఆలోచనకర్త నీవే నాకు - జ్ఞానమైతివి అసమానుండ",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Thellani Unnini Poaliyunna - Vemtrukalu Kaligi Yunnavaadaa",
        "Aaloachanakartha Neevae Naaku - Jnyaanamaithivi Asamaanumda",
        "Arpimthu Neekae Naa Aaraadhana"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సూర్యుని వంటి ముఖము కలిగి - అగ్నిజ్వాలల నేత్రముల్ కలిగి",
        "దృష్టించితివి నా హౄదయమున్ - దహించితివి దుష్టత్వము",
        "ప్రేమగల ప్రభూ నిన్నారాధింతు"
      ],
      "english": [
        "Sooryuni Vamti Mukhamu Kaligi - Agnijvaalala Naethramul Kaligi",
        "Dhrushtimchithivi Naa Hroadhayamun - Dhahimchithivi Dhushtathvamu",
        "Praemagala Prabhoo Ninnaaraadhimthu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అపరంజిని పోలిన పాదములు - కలవాడా తీర్పు తీర్చితివి",
        "పాపము లోకములనిల - దుష్ట సాతానున్ సిలువలొ గెలిచి",
        "విజయ మిచ్చినందుల కారాధింతున్"
      ],
      "english": [
        "Aparamjini Poalina Paadhamulu - Kalavaadaa Theerpu Theerchithivi",
        "Paapamu Loakamulanila - Dhushta Saathaanun Siluvalo Gelichi",
        "Vijaya Michchinamdhula Kaaraadhimthun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ నోటినుండి బయలువెడలె - రెండంచులు గల వాడి ఖడ్గము",
        "అదియే పాత ఆదామును చంపె - నశింప చేసె నా శత్రుబలమున్",
        "అర్పింతు నీకే నా ఆరాధన"
      ],
      "english": [
        "Nee Noatinumdi Bayaluvedale - Remdamchulu Gala Vaadi Khadgamu",
        "Adhiyae Paatha Aadhaamunu Champe - Nashimpa Chaese Naa Shathrubalamun",
        "Arpimthu Neekae Naa Aaraadhana"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఏడు నక్షత్రములు పట్టుకొనిన - మొదటివాడా కడపటివాడా",
        "సర్వ సంపూర్ణత నాకిచ్చితివి - అపాయములలో ఆదుకొనుచున్న",
        "ఆమేన్ అనువాడా హల్లెలూయ"
      ],
      "english": [
        "Aedu Nakshathramulu Pattukonina - Modhativaadaa Kadapativaadaa",
        "Sarva Sampoornatha Naakichchithivi - Apaayamulaloa Aadhukonuchunna",
        "Aamaen Anuvaadaa Hallelooya"
      ]
    }
  ]
}
