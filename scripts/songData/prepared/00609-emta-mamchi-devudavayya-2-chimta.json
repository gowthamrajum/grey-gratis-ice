  "main_stanza": {
    "telugu": [
      "ఎంత మంచి దేవుడవయ్యా (2) చింత లన్ని తీరేనయ్యా",
      "నిన్ను చేరగా. . ఎంత మంచి దేవుడవేసయ్యా"
    ],
    "english": [
      "Emta Mamchi Devudavayya (2) Chimta Lanni Tirenayya",
      "Ninnu Cheraga. . Emta Mamchi Devudavesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గోర పాపినై నేను దూరంగా పారిపోగా",
        "నీ ప్రేమతో నను క్షమియించి",
        "నను హత్తుకున్నావయ్యా (2)"
      ],
      "english": [
        "Gora Papinai Nenu Duramga Paripoga",
        "Ni Premato Nanu Kshamiyimchi",
        "Nanu Hattukunnavayya (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా కున్న వారందరూ నను విడచి పోయినను",
        "నన్నెన్నో ఇబ్బందులకు గురిచేసినను",
        "నను నీవు విడువలేదయ్యా (2)"
      ],
      "english": [
        "Na Kunna Varamdaru Nanu Vidachi Poyinanu",
        "Nannenno Ibbamdulaku Gurichesinanu",
        "Nanu Nivu Viduvaledayya (2)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు లేకుండా నేను ఈ లోకలో బ్రతుకులేనయ్యా",
        "నీతో కూడ ఈలోకలో నుండి",
        "పరలోకంలో చేరెదనేసయ్యా (2)"
      ],
      "english": [
        "Nivu Lekumda Nenu E Lokalo Bratukulenayya",
        "Nito Kuda Ilokalo Numdi",
        "Paralokamlo Cheredanesayya (2)"
      ]
    }
  ]
