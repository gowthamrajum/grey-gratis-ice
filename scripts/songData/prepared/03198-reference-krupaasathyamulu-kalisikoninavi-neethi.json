    {
      "stanza_number": 7,
      "telugu": [
        "ఆయన ముందు నీతి నడచు చుండునట్లుగా",
        "ఆయన అడుగు జాడలలో మేము నడతుము"
      ],
      "english": [
        "Aayana Mundhu Neethi Nadachu Chundunatlugaa",
