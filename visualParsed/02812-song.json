    {
      "stanza_number": 4,
      "telugu": [
        "చెడినవారిని రక్షింపఁ బొండి",
        "యేసుఁడు శక్తిని మీ కీయఁగా",
        "మోక్ష మార్గంబునడిపించుండి",
