{
  "song_name": "Margamu Nene Annadu Yesu",
  "author": {
    "Authored by": "Paul Jayakumar Chinnababu Garu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మార్గం నేనే – అన్నాడు యేసు",
      "సత్యం నేనే – అన్నాడు యేసు",
      "జీవం నేనే – అన్నాడు యేసు",
      "నాకై మరణించి లేచాడు"
    ],
    "english": [
      "Maargam nene – annaaru Yesu",
      "Satyam nene – annaru Yesu",
      "Jeevam nene – annaru Yesu",
      "Naakai maraninchi lechaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాలో పాపాన్ని తొలగించి",
        "శాపాన్ని విడిపించి జీవం ఇచ్చాడే",
        "నాలో పరిశుద్ధాత్మ నింపి",
        "శక్తితో నను నడిపి గమ్యం చేరుస్తాడే"
      ],
      "english": [
        "Naalo paapaanni tolaginchi",
        "Shaapaanni vidipinchi jeevam ichchade",
        "Naalo Parishuddhaatma nimpi",
        "Shakthitho nanu nadipi gamyam cherusthade"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రానున్న రారాజు నా యేసు మహా రాజు"
      ],
      "english": [
        "Raanunna Raraaju Naa Yeshu maha raaju"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "స్వస్థపరచే – నా మంచి యేసు స్వేచ్ఛనిచ్చే – నా మంచి యేసు",
        "శ్వాసతో నింపే – నా మంచి యేసు హృదిలో చోటిస్తే నివసిస్తాడే"
      ],
      "english": [
        "Swasthaparache – naa manchi Yeshu",
        "Svechchanicche – naa manchi Yeshu",
        "Shwaasatho nimpe – naa manchi Yeshu",
        "Hrudilo chotiste nivasistade"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విడుదల నిచ్చే – నా మంచి యేసు",
        "విజయము నిచ్చే – నా మంచి యేసు",
        "విరోధిని జయించే – నా మంచి యేసు",
        "విశ్వాస వీరునిగా మలిచాడే"
      ],
      "english": [
        "Vidudala nicche – naa manchi Yeshu",
        "Vijayam icche – naa manchi Yeshu",
        "Virodhini jayinche – naa manchi Yeshu",
        "Vishwasa veeruniga malichadu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్తము కార్చిన – నా మంచి యేసు",
        "రక్షణ ఇచ్చిన – నా మంచి యేసు",
        "రమ్మని పిలచిన – నా మంచి యేసు",
        "చిరకాలం ఆయనతో ఉండాలని"
      ],
      "english": [
        "Raktamu karchina – naa manchi Yeshu",
        "Rakshana ichina – naa manchi Yesu",
        "Rammani pilachina – naa manchi Yeshu",
        "Chirakaalam Ayanatho undaalani"
      ]
    }
  ]
}
