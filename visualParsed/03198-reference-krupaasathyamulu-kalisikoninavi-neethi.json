{
  "song_name": "Krupaasathyamulu kalisikoninavi neethi samaadhaanamulu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "సామ్ 85:8(13)"
    ],
    "english": [
      "Psalm 85:8(13)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభువు సెలవిచ్చుదాని నాలకింతును",
        "విభుని ప్రజలు శుద్ధులకు సమాధానము"
      ],
      "english": [
        "Prabhuvu selavichchudhaani naalakinthunu",
        "Vibhuni prajalu shudhdhulaku samaadhaanamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వారు మరల బుద్ధిహీనులు గాక యుందురు",
        "గురునికి వారలు జనులుగా నుండెదరు"
      ],
      "english": [
        "Vaaru marala budhdhiheenulu gaaka yunduru",
        "Guruniki vaaralu janulugaa nundedharu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన దేశమందు దైవ మహిమ వసించునట్లుగా",
        "తన భక్తులకు రక్షణ సమీప మాయెను"
      ],
      "english": [
        "Mana deshamandu daiva mahima vasinchunatlugaa",
        "Thana bhakthulaku rakshana sameepa maayenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కృపాసత్యములు ఒకటి నొకటి కలిసికొనినవి",
        "నీతి సమాధానములు ముద్దు పెట్టుకొనినవి"
      ],
      "english": [
        "Krupaasathyamulu okati nokati kalisikoninavi",
        "Neethi samaadhaanamulu muddu pettukoninavi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "భూలోకము లోనుండి సత్యము మొలుచు",
        "నాకాశములోనుండి నీతి పారజూచును"
      ],
      "english": [
        "Bhoolokamu lonundi sathyamu moluchu",
        "Naakaashamulonundi neethi paarajoochunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దేవుడుత్తమమైనదాని ననుగ్రహించును",
        "ఈ వసుధర దాని ఫలము లధికమిచ్చును"
      ],
      "english": [
        "Dhevudhuththamamainadhaani nanugrahinchunu",
        "Ee vasudhara daani phalamu ladhikamichchunu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఆయన ముందు నీతి నడచు చుండునట్లుగా",
        "ఆయన అడుగు జాడలలో మేము నడతుము"
      ],
      "english": [
        "Aayana mundu neethi nadachu chundunatlugaa",
        "Aayana adugu jaadalalo memu nadathumu"
      ]
    }
  ]
}
