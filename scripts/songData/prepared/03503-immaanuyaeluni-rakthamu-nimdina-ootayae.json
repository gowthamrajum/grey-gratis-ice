{
  "song_name": "Immaanuyaeluni Rakthamu Nimdina Ootayae",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "హల్లెలూయా యేసువా కల్వరిపైన మృతుడా",
      "హల్లెలూయా హల్లెలూయా హల్లెలూయా ఆమెన్"
    ],
    "english": [
      "Hallelooyaa Yaesuvaa Kalvaripaina Mruthudaa",
      "Hallelooyaa Hallelooyaa Hallelooyaa Aamen"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇమ్మానుయేలుని రక్తము - నిండిన ఊటయే",
        "ఇమ్ముగ దోషములెల్ల - నివృత్తి చేయును"
      ],
      "english": [
        "Immaanuyaeluni Rakthamu - Nimdina Ootayae",
        "Immuga Dhoashmulella - Nivruththi Chaeyunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపాత్ముడైన దొంగయు - ఆ ఊటలోముంగి",
        "మన్నింపు, మోక్షానందము - నొందియానందించెన్"
      ],
      "english": [
        "Paapaathmudaina Dhomgayu - Aa Ootaloamumgi",
        "Mannimpu, Moakshaanmdhamu - Nomdhiyaanmdhimchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆలాగే నేను యేసుచే - విముక్తి పొందుదు",
        "విలువైన మన్నింపునొంది - పాడుదును సదా"
      ],
      "english": [
        "Aalaagae Naenu Yaesuchae - Vimukthi Pomdhudhu",
        "Viluvaina Mannimpunomdhi - Paadudhunu Sadhaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "గాయంపు రక్తమును నే - విశ్వసించి చూచి",
        "ప్రియంపు యేసు ప్రేమను - ప్రకటింతు నెల్లడన్"
      ],
      "english": [
        "Gaaympu Rakthamunu Nae - Vishvasimchi Choochi",
        "Priympu Yaesu Praemanu - Prakatimthu Nelladan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మోక్షంబునందు రక్షకున్ - చూచి ప్రహర్షింతున్",
        "రక్షించునట్టి ప్రేమను - రక్తితో పాడుదున్"
      ],
      "english": [
        "Moakshmbunmdhu Rakshkun - Choochi Praharshimthun",
        "Rakshimchunatti Praemanu - Rakthithoa Paadudhun"
      ]
    }
  ]
}
