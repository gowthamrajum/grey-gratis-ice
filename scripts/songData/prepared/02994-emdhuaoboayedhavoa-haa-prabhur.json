  "main_stanza": {
    "telugu": [
      "ఎందుఁబోయెదవో హా ప్రభురాయ ఎందుఁబోయెదవో",
      "ఎందుఁ బోయెదవయ్య యీ దుర్మానవశ్రేణి",
      "బొందఁదగిన భరంబుఁ బూని రక్షక నీవు"
    ],
    "english": [
      "Endhuboayedhavoa Haa Prabhuraaya Endhuboayedhavoa",
      "Endhu Boayedhavayya Yee Dhurmaanavashraeni",
      "Bondhadhagina Bharambu Booni Rakshaka Neevu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వడగాలిలోను నీ నెమ్మోము వాడికందఁగను",
        "నొడలఁ జెమటయు నీరు నొడిసివర దయై పార",
