{
  "song_name": "Endukintha Prema Naapai",
  "author": {
    "Authored by": "Asher Andrew",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇశ్రాయేలును కాపాడువాడు కునుకడు నిద్రపోడు",
      "మమ్ము కాపాడిన మా దేవా – ఇదియే మా జిహ్వార్పణ"
    ],
    "english": [
      "Israyelunu kaapaaduvaadu kunukadu nidhrapodu",
      "mammu kaapaadina maa dhevaa – idiyey maa jihwaarpana"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎందుకింత ప్రేమ నాపై చూపావు యేసయ్య",
        "ఆయువున్నంత వరకు నీ స్తుతినే పాడెదా"
      ],
      "english": [
        "Endhukintha prema naapai chupaavu yesayya",
        "aayuvunnantha varaku nee stuthiney paadedhaa"
      ]
    }
  ]
}
