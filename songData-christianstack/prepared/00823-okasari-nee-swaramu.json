{
  "song_name": "Okasari Nee Swaramu",
  "author": {
    "Authored by": "Dr. John Wesly",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఒకసారి నీ స్వరము వినగానే",
      "ఓ దేవా నా మనసు నిండింది",
      "ఒకసారి నీ ముఖము చూడగానే",
      "యేసయ్య నా మనసు పొంగింది"
    ],
    "english": [
      "Okasaari nee swaramu vinagaane",
      "Oh deva naa manasu nindindhi",
      "okasaari nee mukhamu choodagaane",
      "yesayya naa manasu pongindhi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రతి శ్వాసలో నువ్వే",
        "ప్రతి ధ్యాసలో నువ్వే",
        "ప్రతి మాటలో నువ్వే",
        "నా ప్రతి బాటలో నువ్వే"
      ],
      "english": [
        "Na prathi swaasalo nuvve",
        "prathi dhyaasalo nuvve",
        "prathi maatalo nuvve",
        "na prathi baatalo nuvve"
      ]
    }
  ]
}
