  "main_stanza": {
    "telugu": [
      "ఆరాధనాలందుకో ఆరాధనాలందుకో",
      "పాప క్షమాపణ జీవము నిచ్చిన కరుణామయా అందుకో"
    ],
    "english": [
      "Aaraadhanaalanduko Aaraadhanaalanduko",
      "Paapa Kshamaapana Jeevamu Nicchina Karunaamayaa Anduko"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అబ్రాహాము ఇస్సాకు యాకోబుల దేవా",
        "మోషేతో అన్నావు ఉన్నానని (2)",
