{
  "song_name": "Anaadhilo niyaminchabadina",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Yesanna"
    ],
    "రచన": [
      "బ్రదర్ యేసన్న"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అనాదిలో నియమించబడిన గొర్రెపిల్ల",
      "ఆదిలో వధియించబడిన గొర్రెపిల్ల",
      "ఇస్సాకుకు ప్రతిగా బలియైన ఆ గొర్రెపిల్ల",
      "గొల్గతాలో యేసు రూపమైన వధియించబడిన గొర్రెపిల్ల"
    ],
    "english": [
      "Anaadhilo niyaminchabadina gorrepilla",
      "Aadhilo vadhiyinchabadina gorrepilla",
      "Issaakuku prathigaa baliyaina aa gorrepilla",
      "Golgathaalo Yesu roopamaina vadhiyinchabadina gorrepilla"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వధకు తేబడిన గొర్రెపిల్ల వోలె",
        "మౌని యాయెను బలియాగమాయెను",
        "తన రుధిరముతో నన్ను కొనెను",
        "అదియే అనాది సంకల్పమాయెను  ||అనాదిలో||"
      ],
      "english": [
        "Vadhaku thebadina gorrepilla vole",
        "Mauni yaayenu baliyaagamaayenu",
        "Thana rudhiramutho nannu konenu",
        "Adiye anaadi sankalpamaayenu  ||Anaadhilo||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తండ్రి చిత్తమును నెరవేర్చుట కొరకై",
        "శరీరధారి యాయెను సజీవయాగమాయెను",
        "మరణమును గెలిచి లేచెను",
        "అదియే అనాది సంకల్పమాయెను  ||అనాదిలో||"
      ],
      "english": [
        "Thandri chiththamunu neraverchuta korakai",
        "Shareeradhaari yaayenu sajeevayaagamaayenu",
        "Maranamunu gelichi lechenu",
        "Adiye anaadi sankalpamaayenu  ||Anaadhilo||"
      ]
    }
  ]
}
