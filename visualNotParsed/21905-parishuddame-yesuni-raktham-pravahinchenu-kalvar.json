{
  "song_name": "Parishuddame Yesuni Raktham Pravahinchenu Kalvarilo",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Late Bishop shantha vardhan garu",
      "Guntur"
    ],
    "రచన": []
