  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జీవితంబు ఘోర కష్టనష్టముల్",
        "ఆవరించి నిన్ను దుఃఖపర్చిన",
        "దేవుడిచ్చినట్టి యీవులెంచుము",
        "నీవాశ్చర్యమందెదవు వాటికై",
        "ఎంచుము లెక్కించు మీవులన్",
        "ఎంచి, చూడు మేసు దీవెనల్",
        "ఎంచు, మెంచు - మెంచు మీవులన్",
        "వింత నొందెదవు నీవు వాటికై"
      ],
      "english": [
        "Jeevithambu ghora kashtanashtamul",
        "Aavarinchi ninnu duhkhaparchina",
        "Dhevudichchinatti eevulenchumu",
        "Neevaashcharyamandhedhavu vaatikai",
        "Enchumu lekkinchu meevulan",
        "Enchi, choodu mesu dheevenal",
        "Enchu, menchu - Menchu meevulan",
        "Vintha nondhedhavu neevu vaatikai"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చిమ మానసంబు నీకు కల్గినన్",
        "వంతచే భారంబు గల్గు నీయెదన్",
        "సంతసంబుతోడ నెంచు మీవులన్",
        "వింతతో స్మరించు మేసు నామమున్"
      ],
      "english": [
        "Chintha maanasambu neeku kalginan",
        "Vanthache bhaarambu galgu neeyedhan",
        "Santhasambuthoda nenchu meevulan",
        "Vinthatho smarinchu mesu naamamun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాశనంబు జెందు నాస్తి జూచినన్",
        "వాసిగా శ్రీయేసు నా కొసంగిన",
        "భాసురంపు భాగ్యము దలంపుమా",
        "యీ సుభాగ్యమే కదా సదాయుండు"
      ],
      "english": [
        "Naashanambu jendhu naasthi joochinan",
        "Vaasigaa Shreeyesu naa kosangina",
        "Bhaasurampu bhaagyamu dhalampumaa",
        "Ee subhaagyame kadaa sadhaayundu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జీవితాదియందు ధైర్య మొందుము",
        "దేవుడుండు తన వార్కి తోడుగ",
        "జీవయాత్రయందు సాయమియ్యగన్",
        "దేవదూతల్ నీకు తోడుగా నుండు"
      ],
      "english": [
        "Jeevithaadhiyandhu dhairya mondhumu",
        "Dhevudundu thana vaarki thoduga",
        "Jeevayaathrayandhu saayamiyyagan",
        "Dhevadhoothal neeku thodugaa nundu"
      ]
    }
  ]
