      ],
      "english": [
        "Naranaramulo neeve - Naa sarvam neeve",
        "Hrudayamlo neeve - Yesayyaa neeve",
        "Naa pedavulapai - Prathi gaanam neevegaa",
        "Naa prathi shwaasalo - Neeke aaraadhanaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కరుణించే దేవుడవూ - ప్రేమించే దేవుడవు",
        "నీ ప్రేమ విడువనిదీ - నీ ప్రేమ మరువనిది",
        "నా పెదవులపై - ప్రతి గానం నీవెగా",
        "నా ప్రతి శ్వాసలో - నీకే ఆరాధనా"
      ],
      "english": [
        "Karuninche dhevudavoo - Preminche devudavu",
        "Nee prema viduvanidhee - Nee prema maruvanidi",
        "Naa pedavulapai - Prathi gaanam neevegaa",
        "Naa prathi shwaasalo - Neeke aaraadhanaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవే నా గీతము - నీవే సంగీతము",
        "నాదు జీవితము - నీకే అర్పింతును",
        "నా పెదవులపై - ప్రతి గానం నీవెగా",
        "నా ప్రతి శ్వాసలో - నీకే ఆరాధనా"
      ],
      "english": [
        "Neeve naa geethamu - Neeve sangeethamu",
        "Naadu jeevithamu - Neeke arpinthunu",
        "Naa pedavulapai - Prathi gaanam neevegaa",
        "Naa prathi shwaasalo - Neeke aaraadhanaa"
      ]
    }
  ]
