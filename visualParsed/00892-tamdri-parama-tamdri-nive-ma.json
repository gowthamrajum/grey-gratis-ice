      "నీవే సమస్తం రక్షణ కేడెం",
      "ఆశ్రయ స్ధానం రక్షణ శృంగం"
    ],
    "english": [
      "Thandri parama thandri neeve maa priya thandri",
      "Neeve samastham rakshana kedem",
      "Aashraya sthaanam rakshana shrungam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కష్ట కాలములో అదరించు నాధ",
