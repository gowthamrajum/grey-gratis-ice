{
  "song_name": "Anchulanundi jaarela",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అంచులనుండి జారేల – గిన్నెలు నిండి పోర్లేలా",
      "ఆశీర్వదిస్తాడు యేసయ్యా /2/",
      "విశ్వాసంతో ప్రార్ధన చేసిన – ఇచ్చేదాక ఓపిక పట్టిన /2/",
      "మితిలేని తన సంపద నీదే – స్తుతియిస్తే పొందనిది లేదే /2/అంచుల/"
    ],
    "english": [
      "Anchulanundi jaarela - Ginnelu nindi porlelaa",
      "Aasheervadhisthaadu Yesayya /2/",
      "Vishwaasamtho praardhana chesina - Ichchedhaaka opika pattina /2/",
      "Mithileni thana sampada neede - Sthuthiyisthe pondhanidhi lede /2/Anchula/"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లెక్కకు మించి కురియుచున్న – అద్భుతమైన దీవేనలకై /2/",
        "స్తోత్ర గానము చేయు చున్నావా /2/",
        "కృతజ్ఞత కలిగున్నావా /2/మితి/"
      ],
      "english": [
        "Lekkaku minchi kuriyuchunna - Adbhuthamaina dheevenalakai /2/",
        "Sthothra gaanamu cheyu chunnaavaa /2/",
        "Kruthagnatha kaligunnaavaa /2/Mithi/"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శ్రమల నుండి అమరుచున్న – అబ్బురపరచే మేళ్ళ కొఱకై /2/",
        "స్తోత్ర గానము చేయు చున్నావా /2/",
        "కృతజ్ఞత కలిగున్నావా /2/మితి/"
      ],
      "english": [
        "Shramala nundi amaruchunna - Abburaparache mella korakai /2/",
        "Sthothra gaanamu cheyu chunnaavaa /2/",
        "Kruthagnatha kaligunnaavaa /2/Mithi/"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అపాయములను తప్పిస్తున్న – అదృశ్య దేవుని కాపుదాలకై /2/",
        "స్తోత్ర గానము చేయు చున్నావా /2/",
        "కృతజ్ఞత కలిగున్నావా /2/మితి/"
      ],
      "english": [
        "Apaayamulanu thappisthunna - Adrushya Devuni kaapudhaalakai /2/",
        "Sthothra gaanamu cheyu chunnaavaa /2/",
        "Kruthagnatha kaligunnaavaa /2/Mithi/"
      ]
    }
  ]
}
