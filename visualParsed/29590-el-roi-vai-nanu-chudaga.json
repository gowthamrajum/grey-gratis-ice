      ],
      "english": [
        "Maraname nannaavarinchagaa",
        "Nee vaakyame naatho nilichenu  ||El||",
        "Shatruve siggu nondenu ” Nee mukha “"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విశ్వాసమే శోధింపబడగా",
