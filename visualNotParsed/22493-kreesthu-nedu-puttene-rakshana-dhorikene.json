  "main_stanza": {
    "telugu": [
      "క్రీస్తు నేడు పుట్టెనె రక్షణ దొరికెనే",
      "వేదాలు ఘోషించే కన్యక పుత్రుడే",
      "చీకటి తెరలు తొలగిపోయి వెలుగు కలిగెనె",
      "మా మంచి రాజు మనసున్న యేసు",
      "మాకై నేడు పుట్టెను చూడు",
      "ఆహా ఆనందం ఓహో క్రిస్మస్ సంబరం",
      "ఆహా ఆ . . చల్లని చలిలో ఓహో ఆ గొల్లల చెవిలో",
      "ఆహా ఆ . . ఇమ్మానుయేలు ఓహో ఆ దేవుడే తోడు",
      "క్రీస్తు నేడు పుట్టెనని దూత వార్త తెలిపెను",
      "ఆహా ఆ . . ఆకాశాన ఓహో ఆ తూర్పున తారా",
      "ఆహా ఆ . . ఆయనే యేసుని ఓహో ఆయనే రక్షని",
      "తార వార్త తెలిపెను జ్జానులారాధించెను"
    ],
