  "main_stanza": {
    "telugu": [
      "మంచి దేవుడు భలే మంచి దేవుడు",
      "నిజ దైవం యేసు - అద్వితీయ దేవుడు"
    ],
    "english": [
      "Manchi Devudu bhale manchi Devudu",
      "Nija daivam Yesu - Advitheeya Devudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మ్రొక్కులను కోరడు - మనసిస్తే చాలును",
        "కొండలెక్కి రమ్మనడు - మనలో కొలువుంటాడు",
        "వెదికితే ప్రతి వారికి - దొరికేను యేసు",
        "పిలిచే ప్రతి వారికి - పలికేను యేసు",
        "బొమ్మ కాదయ్యో - జీవమున్న దేవుడు \"మంచి\""
      ],
      "english": [
        "Mrokkulanu koradu - Manasisthe chaalunu",
        "Kondalekki rammanadu - Manalo koluvuntaadu",
        "Vedhikithe prathi vaariki - Dorikenu Yesu",
        "Piliche prathi vaariki - Palikenu Yesu",
        "Bomma kaadhayyo - Jeevamunna Devudu \"Manchi\""
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కుంటివాడు గంతులేయ - కాళ్ళ నొసగినాడు",
        "మూగవారు స్తుతిచేయ - నోటినిచ్చినాడు",
        "బధిరులు తన స్వరము విన - చెవులిచ్చినాడు",
        "ప్రేమా మయుడు - ఆశ్చర్య దేవుడు \"మంచి\""
      ],
      "english": [
        "Kuntivaadu ganthuleya - Kaalla nosaginaadu",
        "Moogavaaru sthuthicheya - Notinichchinaadu",
        "Badhirulu thana swaramu vina - Chevulichchinaadu",
        "Premaa mayudu - Aascharya Devudu \"Manchi\""
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "చెప్పింది చేసెను - మాదిరుంచి వెళ్ళెను",
        "అడుగు జాడాలుంచెను - అనుసరించ కోరెను",
        "మరణాన్ని జీవాన్ని - మన ఎదుటే వుంచెను",
        "ఎంచుకొనే స్వేచ్చను - మన చేతికిచ్చెను",
        "ఏమి చేతువో - సృష్టికర్త యేసుని \"మంచి\""
      ],
      "english": [
        "Cheppindhi chesenu - Maadhirunchi vellenu",
        "Adugu jaadaalunchenu - Anusarincha korenu",
        "Maranaanni jeevaanni - Mana edute vunchenu",
        "Enchukone swechchanu - Mana chethikichchenu",
        "Emi chethuvo - Srushtikartha Yesuni \"Manchi\""
