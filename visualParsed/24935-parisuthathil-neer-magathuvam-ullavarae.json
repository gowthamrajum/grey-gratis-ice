{
  "song_name": "Ningilona thaaraka cheya vachchindi veduka",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Sayaram Gattu"
    ],
    "రచన": [
      "సాయారం గట్టు"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నింగిలోన తారక",
      "చేయ వచ్చింది వేడుక",
      "దారి చూపేందుకు తోడుగా",
      "తానే నడిచింది ముందుగా",
      "బెత్లహేములో పండుగ",
      "వెలుగే వచ్చింది నిండుగా",
      "రక్షకుడు మన కొరకే ఉదయించెనుగా"
    ],
    "english": [
      "Ningilona thaaraka",
      "Cheya vachchindi veduka",
      "Daari choopendhuku thodugaa",
      "Thaane nadichindhi mundugaa",
      "Bethlahemulo panduga",
      "Veluge vachchindi nindugaa",
      "Rakshakudu mana korake udhayinchenugaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూత వార్త వినగానే గొల్లలు",
        "అందరికి చాటారు శుభములు",
        "సువార్త మతికి రాగానే జ్ఞానులు",
        "మోకరించి ఇచ్చారు కానుకలు",
        "కదలిరా సువార్త చాటగా",
        "ప్రభువిచ్చెను మన భాద్యతగా",
        "(ఆ) రక్షకుడు మన కొరకే ఉదయించెనుగా"
      ],
      "english": [
        "Dootha vaartha vinagaane gollalu",
        "Andariki chaataaru shubhamulu",
        "Suvaartha mathiki raagaane gnaanulu",
        "Mokarinchi ichchaaru kaanukalu",
        "Kadhaliraa suvaartha chaatagaa",
        "Prabhuvichchenu mana baadhyathagaa",
        "(Aa) rakshakudu mana korake udhayinchenugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకమునే రక్షించిన ఈ దినము",
        "నీ హృదయములో రావాలి నిత్యము",
        "ప్రభు యేసే దేవుడనే సత్యము",
        "నమ్మి మోకరించాలి ఈ క్షణము",
        "తన రక్తమే శుద్ధి చేయును",
        "మన పాపములు రద్దు చేయును",
        "(ఆ) రక్షకుడు మన కొరకే ఉదయించెనుగా"
      ],
      "english": [
        "Lokamune rakshinchina ee dinamu",
        "Nee hrudayamulo raavaali nithyamu",
        "Prabhu Yese Dhevudane sathyamu",
        "Nammi mokarinchaali ee kshanamu",
        "Thana rakthame shuddhi cheyunu",
        "Mana paapamulu raddu cheyunu",
        "(Aa) rakshakudu mana korake udhayinchenugaa"
      ]
    }
  ]
}
