{
  "song_name": "Prabhuvaa Nee Goppathanamu Sthuthiki Yoagyamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నీ గొప్పతనము - స్తుతికి యోగ్యము",
      "అశక్యమైనది - వర్ణించలేమిల"
    ],
    "english": [
      "Prabhuvaa Nee Goppathanamu - Sthuthiki Yoagyamu",
      "Ashakyamainadhi - Varninchalaemila"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సృష్టి గొప్పది అద్భుతమేగా - సంకల్పమెంతో వుత్తమము",
        "మానవజాతి కొరకై ప్రభూ - సిద్దపరచె సమస్తము",
        "నీదు పనులు నీ సామర్ధ్యము వర్ణించలేమిల"
      ],
      "english": [
        "Srushti Goppadhi Adhbhuthamaegaa - Sankalpamenthoa Vuththamamu",
        "Maanavajaathi Korakai Prabhoo - Sidhdhaparache Samasthamu",
        "Needhu Panulu Nee Saamardhyamu Varninchalaemila"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ రూపమున నరుని సృజించి - అధికారము నిచ్చితివి",
        "క్రీస్తునందు నిర్దోషినిగా - నిలువబెట్ట గోరితివి",
        "నీదు దయ నీ మంచితనము వర్ణించలేమిల"
      ],
      "english": [
        "Nee Roopamuna Naruni Srujinchi - Adhikaaramu Nichchithivi",
        "Kreesthunandhu Nirdhoashinigaa - Niluvabetta Goarithivi",
        "Needhu Dhaya Nee Manchithanamu Varninchalaemila"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సృష్టిని చేసిన శక్తికంటె - పాపికి రక్షణ గొప్పది",
        "నీ యొద్ద నున్న సర్వమిచ్చి - విలువగు ముత్యము కొన్నావు",
        "నీ ఐశ్వర్యము నీ మహిమను వర్ణించలేమిల"
      ],
      "english": [
        "Srushtini Chaesina Shakthikante - Paapiki Rakshana Goppadhi",
        "Nee Yodhdha Nunna Sarvamichchi - Viluvagu Muthyamu Konnaavu",
        "Nee Aishvaryamu Nee Mahimanu Varninchalaemila"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీకు మానవుడమూల్యము - నీవు ప్రేమించుచున్నావు",
        "అందుకే నీ ప్రాణమర్పించి - రక్తము కార్చి రక్షించితివి",
        "నీ అద్భుత ప్రేమ నీ కృప వర్ణించలేమిల"
      ],
      "english": [
        "Neeku Maanavudamoolyamu - Neevu Praeminchuchunnaavu",
        "Andhukae Nee Praanamarpinchi - Rakthamu Kaarchi Rakshinchithivi",
        "Nee Adhbhutha Praema Nee Krupa Varninchalaemila"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అద్భుతమైన నూతన సృష్టి - మానవునికి నిచ్చితివి",
        "రాజులనుగ యాజకులుగ వారసులుగను చేసితివి",
        "నీ రాజ్యము నీ ప్రభావము వర్ణించలేమిల"
      ],
      "english": [
        "Adhbhuthamaina Noothana Srushti - Maanavuniki Nichchithivi",
        "Raajulanuga Yaajakuluga Vaarasuluganu Chaesithivi",
        "Nee Raajyamu Nee Prabhaavamu Varninchalaemila"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఉల్లాసముతో సృష్టి మైమరచే - అద్భుత కార్యములను చూచి",
        "సంతోషించి ఆరాధించిరి - నీవే సర్వమని చెప్పిరి",
        "నీ ప్రభుత్వము నీదు సత్యము వర్ణించలేమిల"
      ],
      "english": [
        "Ullaasamuthoa Srushti Maimarachae - Adhbhutha Kaaryamulanu Choochi",
        "Santhoashinchi Aaraadhinchiri - Neevae Sarvamani Cheppiri",
        "Nee Prabhuthvamu Needhu Sathyamu Varninchalaemila"
      ]
    }
  ]
}
