{
  "song_name": "Narakamanunadhi niranthamundunayo",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నరకమనునది నిరంతముండునయో",
      "ఆ ఘోరనరకము నందు పాపులు బాథపడుదురయో",
      "మరియు నగ్ని పురుగులందున కొరుకు చుండును తరుగులేకను",
      "ధరణికాదిది దరియుకాదు మరణమెదకిన దొరకదందున ||న||"
    ],
    "english": [
      "Narakamanunadhi niranthamundunayo",
      "Aa ghoranarakamu nandu paapulu baadhapadudhurayo",
      "Mariyu nagni purugulandhuna koruku chundunu tharugulekanu",
      "Dharanikaadhidhi dhariyukaadhu maranamedhakina dhorakadhandhuna ||Na||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "గప్పు గప్పున రగులుచుండునయ్యో ఆ ఘోరనరకము",
        "నిప్పులెగయుచు పొంగుచుండునయ్యో మబ్బువలె పొగ",
        "పైకిలేచును అబ్బా! అబ్బాని యేడ్చుచుందురు బొబ్బలిడు",
        "దురు అడ్డమొచ్చెడి అబ్బలెవరు కానరందున ||న||"
      ],
      "english": [
        "Gappu gappuna raguluchundunayyo aa ghoranarakamu",
        "Nippulegayuchu ponguchundunayyo mabbuvale poga",
        "Paikilechunu abbaa! abbaani yedchuchundhuru bobbalidu",
        "Dhuru addamochchedi abbalevaru kaanarandhuna ||Na||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నోరులెత్తి కొట్టుకొందురయ్యో ప్రభు యేసు క్రీస్తును",
        "నమ్మనందుకు నొచ్చుకొందురయ్యో పురుగు చావదు",
        "అగ్ని ఆరదు కొరుకుచుందురు పండ్లు పట పట తిరిగితిరిగి",
        "చూచుచుందురు పరుగులెత్తక యేడ్చు చుందురు ||న||"
      ],
      "english": [
        "Noruletthi kottukondhurayyo Prabhu Yesu Kreesthunu",
        "Nammanandhuku nochchukondhurayyo purugu chaavadu",
        "Agni aaradu korukuchundhuru pandlu pata pata thirigithirigi",
        "Choochuchundhuru paruguletthaka yedchu chundhuru ||Na||"
      ]
    }
  ]
}
