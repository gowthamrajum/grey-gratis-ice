{
  "song_name": "Nee Pilupu",
  "author": {
    "Authored by": "Benny Joshua",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ పిలుపు వలన నేను నశించి పోలేదు",
      "నీ ప్రేమ ఎన్నడు నన్ను విడువలేదు"
    ],
    "english": [
      "Nee pilupu valana nenu nasinchipoledhu",
      "nee prema ennadu nannu viduvaledhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కృప కాచుట వలన జీవిస్తున్నాను",
        "నీ ప్రేమకు సాటి లేదు"
      ],
      "english": [
        "Nee krupa kaachuta valana jeevisthunnannu",
        "nee premaku saati ledhu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నశించుటకు ఎందరో వేచియున్నను",
        "నశింపని నీ పిలుపు నన్ను కాపాడెను",
        "ద్రోహము నిందల మధ్యలో నే నడచినను",
        "నీ నిర్మల హస్తము నన్ను భరియించెను"
      ],
      "english": [
        "Nasinchutaku endharo vechiyunnanu",
        "nasimpani nee pilupu nannu kaapaadenu",
        "dhrohamu nindhala madyalo ne nadachinanu",
        "nee nirmala hasthamu nannu bariyinchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యజమానుడా నా యజమానుడా…",
        "నన్ను పిలచిన యజమానుడా",
        "యజమానుడా నా యజమానుడా…",
        "నన్ను నడిపించే యజమానుడా"
      ],
      "english": [
        "Yajamaanudaa naa yajamaanudaa",
        "nannu pilichina yajamaanudaa",
        "Yajamaanudaa naa yajamaanudaa",
        "nannu nadipinche yajamaanudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనుషులు మూసిన తలుపులు కొన్నైనను",
        "నాకై నీవు తెరచినవి అనేకములు",
        "మనోవేదనతో నిన్ను విడిచి పరుగెత్తినను",
        "నన్ను వెంటాడి నీ సేవను చేసితివి"
      ],
      "english": [
        "Manushulu moosina thalupulu konnainanu",
        "naakai neevu therachinavi anekamulu",
        "manovedhanatho ninnu vidichi parugettinanu",
        "nannu ventaadi nee sevanu chesithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా ఆధారమా నా దైవమా",
        "పిలిచిన ఈ పిలుపునకు కారణమా"
      ],
      "english": [
        "Naa aadhaaramaa naa dhaivamaa",
        "pilichina ee pilupunaku kaaranamaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పిలిచిన నీవు నిజమైన వాడవు",
        "నన్ను హెచ్చించే ఆలోచన గలవాడవు",
        "ఏదేమైనను కొనసాగించితివి",
        "నీపై ఆధారపడుటకు అర్హుడవు"
      ],
      "english": [
        "Pilichina neevu nijamaina vaadavu",
        "nannu hecchinche aalochana galavaadavu",
        "eydaimainanu konasaaginchithivi",
        "neepai aadhaarapadutaku arhudavu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నిన్ను నమ్మెదను, వెంబడింతును",
        "చిరకాలము నిన్నే సేవింతును"
      ],
      "english": [
        "Ninnu nammedhanu, vembadinthunu",
        "chirakaalamu ninne sevinthunu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నీ పిలుపు వలన నేను నశించి పోలేదు",
        "నీ ప్రేమ ఎన్నడు నన్ను విడువలేదు"
      ],
      "english": [
        "nee pilupu valana nenu nisinchi poledhu",
        "nee prema ennadu nannu viduvaledhu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "నీ కృప కాచుట వలన జీవిస్తున్నాను",
        "నీ ప్రేమకు సాటి లేదు"
      ],
      "english": [
        "nee krupa kaachuta valana jeevisthunnanu",
        "nee premaku saati ledhu"
      ]
    }
  ]
}
