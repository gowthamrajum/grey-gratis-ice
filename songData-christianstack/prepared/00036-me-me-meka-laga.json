  "main_stanza": {
    "telugu": [
      "మే మే మేకలా గా",
      "బౌ బౌ కుక్కలా గా",
      "మ్యావ్ మ్యావ్ పిల్లి లాగా",
      "నీవు చేయబడలేదు"
    ],
    "english": [
      "Me me meka laga",
      "Bow bow kukka laaga",
      "Meow Meow pilli laaga",
      "Neevu cheyabadaledu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు రూపులోనే – యేసు బిడ్డ లాగా",
        "యేసు చేతిలోనే – నీవు చేయబడావు",
        "ఎంతో ఎంతో స్పెషల్ నీవు",
        "చింతలన్నీ ఇప్పుడే విడువు",
        "అంతా జీసస్ లవ్ ఇది గెలువు",
        "అంతే చాలు ప్రభువుతో నడువు"
      ],
      "english": [
        "Yesu roopu lone – Yesu bidda laaga",
        "Yesu chethilone- Neevu cheyyabaddavu",
        "Entho entho special neevu",
        "Chinthalanni ippudee viduvu",
        "Antha Jesus love idi geluvu",
        "Anthee chaalu prabhuvuthoo naduvu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కోకో రోకో కోడిలాగా",
        "కావ్ కావ్ కాకిలాగా",
        "క్వాక్ క్వాక్ బాతు లాగా",
        "నీవు చేయబడలేదు"
      ],
      "english": [
        "Koko roko kodilaaga",
        "Caw caw kaaki laaga",
        "Quack quack baathu laaga",
        "Neevu cheyyabadaledu"
      ]
    },
    {
      "stanza_number": 3,
