{
  "song_name": "Kantini Goppa Muthyamu Pondhithi Harshamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కంటిని గొప్ప ముత్యము - పొందితి హర్షము",
      "తింటిని జీవాహారము - గ్రోలితి స్నేహము"
    ],
    "english": [
      "Kantini Goppa Muthyamu - Pondhithi Harshamu",
      "Thintini Jeevaahaaramu - Grolithi Snehamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "మాత పితృడు యేసుడ - ద్భుత రాజాయనే",
        "గుడ్డలు చుట్టబడెను - మందల కాపరి"
      ],
      "english": [
        "Maatha Pithrudu Yesuda - Dbhutha Raajaayane",
        "Guddalu Chuttabadenu - Mandala Kaapari"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆదియంత రహితుడు - జ్యోతిర్మయ ప్రభునా",
        "ర్తులకు నాయకుడు - జాతిగోత్రరహితుడు"
      ],
      "english": [
        "Aadhiyantha Rahithudu - Jyothirmaya Prabhunaa",
        "Rthulaku Naayakudu - Jaathigothrarahithudu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యూదా గోత్రంపు సింహమా - పితృల దైవమా",
        "నాథా నా హేమ మకుటమా - పాదముల బడితిమి"
      ],
      "english": [
        "Yoodhaa Gothrampu Simhamaa - Pithrula Dhaivamaa",
        "Naathaa Naa Hema Makutamaa - Paadhamula Badithimi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కర్తాదికర్త యేసువా - రాజాధిరాజవు",
        "షారోను రోజా పుష్పమా - మరలవత్తువు"
      ],
      "english": [
        "Karthaadhikartha Yesuvaa - Raajaadhiraajavu",
        "Shaaronu Rojaa Pushpamaa - Maralavaththuvu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మార్గం సత్యం జీవమా - రోషంపు దేవుడా",
        "కుంకని యాజకుండవు - ప్రకాశమయుడా"
      ],
      "english": [
        "Maargam Sathyam Jeevamaa - Roshampu Dhevudaa",
        "Kunkani Yaajakundavu - Prakaashamayudaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయాకు పాత్రుడా - ఎల్లరి రక్షకా",
        "రాతి గుండె కరిగింతువు - నీవే సమస్తము"
      ],
      "english": [
        "Hallelooyaaku Paathrudaa - Ellari Rakshakaa",
        "Raathi Gunde Kariginthuvu - Neeve Samasthamu"
      ]
    }
  ]
}
