{
  "song_name": "Kallu theriste velugu raa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "కళ్లు తెరిస్తే వెలుగురా",
      "కళ్ళు మూస్తే చీకటిరా",
      "నోరు తెరిస్తే శబ్దమురా",
      "నోరు ముస్తే నిశ్శబ్దమురా",
      "ఏ క్షణమో తెలియదు జీవిత ఆంతం",
      "ఈ క్షణమే చేసుకో యేసుని సొంతం |కళ్లు|"
    ],
    "english": [
      "Kallu theriste veluguraa",
      "Kallu moosthe cheekatiraa",
      "Noru theriste shabdamuraa",
      "Noru moosthe nishshabdamuraa",
      "E kshanamo theliyadu jeevitha aantham",
      "Ee kshaname chesuko Yesuni sontham |Kallu|"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఊయల ఊగితే జోల పాటరా",
        "ఊయల ఆగితే ఎడుపు పాటరా ||2||",
        "ఊపిరి ఆడితే ఉగిసలాటరా",
        "ఊపిరి ఆగితే సమాధి తోటరా|ఏక్షణమో|"
      ],
      "english": [
        "Ooyala oogithe jola paataraa",
        "Ooyala aagithe edupu paataraa ||2||",
        "Oopiri aadithe ugisalaataraa",
        "Oopiri aagithe samaadhi thotaraa |Ekshanamo|"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బంగారు ఊయల ఊగిననీవు",
        "భూజములపై నిన్ను మోయక తప్పదురా",
        "పట్టు పరపుపైన పోర్లిన నీవు",
        "మట్టి పరుపులో నిన్ను పెట్టక తప్పదురా |ఏక్షణమో|"
      ],
      "english": [
        "Bangaaru ooyala oogina neevu",
        "Bhujamulapai ninnu moyaka thappaduraa",
        "Pattu parapupaina porlina neevu",
        "Matti parupulo ninnu pettaka thappaduraa |Ekshanamo|"
      ]
    }
  ]
}
