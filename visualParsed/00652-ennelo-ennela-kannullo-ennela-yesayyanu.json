  "main_stanza": {
    "telugu": [
      "ఎన్నెలో ఎన్నెలా కన్నుల్లో ఎన్నెలా",
      "యేసయ్యను నమ్ముకుంటే ఎన్నెలో ఎన్నెలా",
      "ఆ సామిని కొలుసుకుంటే బతుకంతా ఎన్నెలా"
    ],
    "english": [
      "Ennelo ennelaa kannullo ennelaa",
      "Yesayyanu nammukunte ennelo ennelaa",
      "Aa saamini kolusukunte bathukanthaa ennelaa"
