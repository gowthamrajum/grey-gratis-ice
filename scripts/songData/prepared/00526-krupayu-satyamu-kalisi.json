{
  "song_name": "Krupayu Satyamu Kalisi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మహిమ రూపము మనిషి ఆయెను బాలయేసునిగా హల్లెలూయ"
    ],
    "english": [
      "Mahima Roopamu Manishi Aayenu Baalayesunigaa Halleluyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రవచనం పరిపూర్ణమై - కాలము సంపూర్ణమై",
        "సకల ప్రజలకు రక్షణై - సంతస వార్తయై"
      ],
      "english": [
        "Pravachanam Paripoornamai - Kaalamu Sampoornamai",
        "Sakala Prajalaku Rakshanai - Santhasa Vaarthayai"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గ్రుడ్డివారికి దృష్టియై - బాధితులకు విమోచనై",
        "బీదలకు సువార్తయై - రక్షణ మార్గమై"
      ],
      "english": [
        "Gruddivaariki Drushtiyai - Baadhithulaku Vimochanai",
        "Beedalaku Suvaarthayai - Rakshana Maargamai"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిత్యుడైన తండ్రియై - సత్యమున కాధారుడై",
        "శాంతికే నిలయమై - నిత్యజీవమై"
      ],
      "english": [
        "Nityudaina Thandriyai - Sathyamuna Kaadhaarudai",
        "Shaanthike Nilayamai - Nityajeevamai"
      ]
    }
  ]
}
