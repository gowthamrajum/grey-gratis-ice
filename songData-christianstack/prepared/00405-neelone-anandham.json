{
  "song_name": "Neelone Anandham",
  "author": {
    "Authored by": "Bharat Mandru",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీలోనే ఆనందం నా దేవా నీలోనే నాకు జీవం",
      "నిన్న నేడు నిరంతరం మారని దేవా",
      "ఈ లోకమంతా నేను వెతదకినా నాకు లేదయ్యా ఎక్కడా ఆనందం",
      "నీ సన్నిధిలో ఒక్క క్షణం గడిపిన నా హృదయం పొంగెను"
    ],
    "english": [
      "Neelone anandham naa deva..",
      "neelone naaku jeevam.",
      "nina nedu nirantharam maarani deva..",
      "ee lokhamantha nenu vedakina",
      "ledaya ekkada anandham",
      "ne sannidhilo oka kshanam gadipina",
      "na hrudayam pongenu",
      "neelone anandham naa deva",
      "neelone naaku jeevam."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోకం ఒక మాయని తెలుసుకున్నాను ఏది నా సొంతం కాదు అనుకున్నాను",
        "తప్పిపోయిన కుమారుని నేనయితే నా కొరకే నిరీక్షించే తండ్రి నా యేసు",
        "ఏ ప్రేమ నీ ప్రేమకు సాటి రాదయ్య ఎన్ని ఉన్నా నీతో సరి ఏది కాదయ్యా",
        "నన్ను మరువని ప్రేమ నీ దయ్యా నన్ను మార్చుకున్న ప్రేమ నీదే యేసయ్"
      ],
      "english": [
        "Ee lokham oka maayani telusukunnanu",
        "yedhi na sontham kaadanukunnanu",
        "thapipoyina kumaruni neenayithe",
        "na korakai neerekshinche thandri naa yesu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [],
      "english": [
        "Ee lokhamantha nenu vedakina",
