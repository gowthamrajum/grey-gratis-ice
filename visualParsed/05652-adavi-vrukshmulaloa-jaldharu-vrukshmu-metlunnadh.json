{
  "song_name": "Adavi vrukshamulalo jaldaru vrukshamu etlunnadho",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "అడవి వృక్షములలో - జల్ధరు వృక్షము మెట్లున్నదో",
      "పరిశుద్ధుల మధ్యలో - అతి శ్రేష్టుడైన నా ప్రభువు",
      "పొడెద నా ప్రియుని జీవకాలమెల్ల అరణ్య యాత్రలో",
      "కృతజ్ఞతతో పాడెదను||2||"
    ],
    "english": [
      "Adavi vrukshamulalo - Jaldaru vrukshamu etlunnadho",
      "Parishudhdhula madhyalo - Athi shreshtudaina naa Prabhuvu",
      "Paadeda naa priyuni jeevakaalamella aranya yaathralo",
      "Kruthagnathatho paadedanu||2||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూషణ ఇరుకులలో - నన్ను సుగంధముగా - మార్చెను ||2||",
        "నీ కృపలో నన్ను నడిపి - నీ వెలుగుతో నింపితివి||పొడెద||"
      ],
      "english": [
        "Dhooshana irukulalo - Nannu sugandhamugaa - Maarchenu ||2||",
        "Nee krupalo nannu nadipi - Nee velugutho nimpithivi||Paadeda||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా కష్టతరంగములో - దు:ఖ సాగరములోనుండగా",
        "నీకుడి హస్తము చాపి - భయపడకని పలికితివే ||పొడెద||"
      ],
      "english": [
        "Naa kashtatharangamulo - Dhu:kha saagaramulonundagaa",
        "Nee kudi hasthamu chaapi - Bhayapadakani palikithive ||Paadeda||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆనంద భరితుడనై - నీ ప్రేమలో నుండుటకు",
        "నీ సర్వము - నా కతి మధురం -",
        "నీ ముఖము మనోహరము|| పొడెద||"
      ],
      "english": [
        "Aananda bharithudanai - Nee premalo nundutaku",
        "Nee sarvamu - Naa kathi madhuram -",
        "Nee mukhamu manoharamu|| Paadeda||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీ చిత్తము - చేయుటకు",
        "నన్ను నీకు సమర్పించెదన్‌",
        "నా పరుగును తుద ముట్టించి",
        "నీ సన్నిధిలో - నిలిచెదన్‌||పొడెద||"
      ],
      "english": [
        "Nee chitthamu - Cheyutaku",
        "Nannu neeku samarpinchedhan",
        "Naa parugunu thudha muttinchi",
        "Nee sannidhilo - Nilichedhan||Paadeda||"
      ]
    }
  ]
}
