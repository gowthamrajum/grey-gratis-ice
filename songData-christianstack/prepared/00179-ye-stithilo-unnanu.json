{
  "song_name": "Ye Stithilo Unnanu",
  "author": {
    "Authored by": "S.Ratna Babu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఏ స్థితిలోవున్నను",
      "ఎలాగువున్నను"
    ],
    "english": [
      "Ee sthithilovunnanu",
      "Elagu vunnanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాకున్న ఆధారమా",
        "నను నడిపించు దైవమా"
      ],
      "english": [
        "Na kunna aadharamaa",
        "Nanu nadipinchu dhaivamaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ఒంటరి పయనములో తోడెవ్వరు లేరని",
        "నేనడిచే మార్గములో",
        "ఎవ్వరూ రారని",
        "నా కన్నుల ఎదుటే",
        "శూన్యమే ఉందని",
        "నను దర్శించినావయ్యా",
        "నా స్థితినే మార్చినావయ్యా"
      ],
      "english": [
        "Naa ontari payanamulo thodevvaru lerani",
        "Nenadiche maargamulo evvaru raarani",
        "Naa kannula edhutey shoonyamay undhani",
        "Nanu dharshinchinavayya",
        "Naa sthithine maarchinavayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా దీనస్థితిలో నాకెవ్వరు లేరని",
        "నే పడిన శ్రమలలో",
        "ఆదరించలేదని",
        "నా హృదయమంతా",
        "వేదనతో ఉందని",
        "నన్ను హత్తుకునావయ్యా",
        "నా స్థితినే మార్చినావయ్యా"
      ],
      "english": [
        "Naa dheenasthithilo naakevvaru lerani",
        "Nenu padina shramalalo aadharincalerani",
        "Naa hrudhayamanthaa vedhanatho undhani",
        "Nannu hatthukunnaavayya",
        "Naa sthithine maarchinavayya"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నే అలసిన సమయములో నాకెవ్వరు లేరని",
        "నే పడే బాధలలో ఎవ్వరూ రారని",
        "నా మనసంతా గాయమై ఉందని",
        "నను ప్రేమించినావయా",
        "నా స్థితినే మార్చినావయ్యా"
      ],
      "english": [
        "Nenu alasina samayamulo naakevvaru lerani",
        "Nenu pade baadhalo evvaru raarani",
        "Naa manasanthaa gaayamai undhani",
        "Nanu preminchinaavayya",
        "Naa sthithine maarchinavayya"
      ]
    }
  ]
}
