{
  "song_name": "Naa Nimiththamaayana Mahini Shramalu PoMdhenu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా నిమిత్తమాయన మహిని శ్రమలు పొందెను",
      "ఘనధనముల రోసెను అనుమతించె చావుకు",
      "నా నిమిత్తమె (3) మరణ మాయెను",
      "తన జీవమును నాకు బలిగా ధారపోసెను"
    ],
    "english": [
      "Naa Nimiththamaayana Mahini Shramalu PoMdhenu",
      "GhanaDhanamula Roasenu AnumathiMche Chaavuku",
      "Naa Nimiththame (3) MaraNa Maayenu",
      "Thana Jeevamunu Naaku Baligaa Dhaarapoasenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గొఱ్ఱెపిల్ల రీతిగా గొప్ప శాంతి జూపెను",
        "ఉర్వినంత మోపినన్ యోర్చె మౌనవృత్తిని"
      ],
      "english": [
        "GoRRepilla Reethigaa Goppa ShaaMthi Joopenu",
        "UrvinMtha Moapinan Yoarche Maunavruththini"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అతడు దోషమెరుగడు అతడు కపటమెరుగడు",
        "అయినను దేవుడు అతని నలుగగొట్టెను"
      ],
      "english": [
        "Athadu DhoaShmerugadu Athadu Kapatamerugadu",
        "Ayinanu Dhaevudu Athani Nalugagottenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అతడు యిలను పొందిన అధిక దెబ్బలవలన్",
        "క్షితిని నాకు కలిగెను స్వస్థత మది రూఢీగా"
      ],
      "english": [
        "Athadu Yilanu PoMdhina ADhika Dhebbalavalan",
        "KShithini Naaku Kaligenu SvasThatha Madhi RooDeegaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రోగముల్ భరించెను వ్యసనములు వహించెను",
        "బాగుగా నొత్తిడిన్ బాధలన్ సహించెను"
      ],
      "english": [
        "Roagamul BhariMchenu Vyasanamulu VahiMchenu",
        "Baagugaa Noththidin BaaDhalan SahiMchenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "గాయములను పొందెను కాయమంత నొచ్చెను",
        "హేయమైన నిందలన్ ఎలమిలో సహించెను"
      ],
      "english": [
        "Gaayamulanu PoMdhenu KaayamMtha Nochchenu",
        "Haeyamaina NiMdhalan Elamiloa SahiMchenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఎదిగె నాయన మన యెడల దీన వృత్తిని",
        "సదనులమగు ప్రీతితో సరకు చేయమైతిమి"
      ],
      "english": [
        "Edhige Naayana Mana Yedala Dheena Vruththini",
        "Sadhanulamagu Preethithoa Saraku Chaeyamaithimi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "తన యనుభవమున్ మనల దోషరహితులన్",
        "చేయ నుద్దేశించెన్ ప్రాణమర్పించెను"
      ],
      "english": [
        "Thana Yanubhavamun Manala DhoaShrahithulan",
        "Chaeya NudhdhaeshiMchen PraaNamarpiMchenu"
      ]
    }
  ]
}
