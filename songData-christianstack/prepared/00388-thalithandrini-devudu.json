{
  "song_name": "Thalithandrini Devudu",
  "author": {
    "Authored by": "King Johnson Victor",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తల్లితండ్రిని దేవుడు చేసాడెందుకు",
      "ఆ ప్రేమేతనలో ఉంది అందుకు",
      "నీ కోసమే నేనిచ్చాను.. పసిబిడ్డవు నీవని యిచ్చాను",
      "నీ కోసమని నేను చేసెనని",
      "మీరూ పిల్లలని నేనే తండ్రినని"
    ],
    "english": [
      "Thallithandrini devudu chesaadendhuku",
      "aa premethanalo undhi andhuku",
      "nee kosame nenicchaanu..pasibiddavuneevani yucchaanu",
      "nee kosamani nenu chesenani",
      "meeru pillalani nene thandrinani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తండ్రి అంటేనే అన్నీ ఇచ్చేవాడు- పిల్లందరిని పోషించేవాడు",
        "నీకు ఎం కావాలో ముందే తెలిసినవాడు",
        "నువ్వు అడగకముందె సిద్దం చేసేవాడు",
        "ఇన్ని ఇచ్చాడంటే తండ్రే అవుతాడు",
        "సృష్టిని చేసాడంటే దేవుడు అవుతాడు",
        "అన్నీ ఇచ్చిన దేవునిని తండ్రనీ గుర్తించవా",
        "తల్లి తండ్రిని ఇచ్చింది దేవుడని నీవెaరుగవా",
        "ఆలోచించి నీవెవరో తెలుసుకో",
        "ఆ దేవుడే తండ్రనీ అందరికి తెలుపుకో",
        "ఎవరికి తెలుసు నువ్వు కావాలనే దేవుని మనస్సు",
        "అన్నీ ఇచ్చినా నువ్వు నమ్మను అంటే బాధే తనకు",
        "ఈ సృష్టంతా మనుష్యులు చేసారా",
        "మనుష్యలందరిని దేవుడు చేసాడా",
        "చేసిన దేవునినే లేడంటారా",
        "పాపం చేస్తావని ముందే తెలుసు- అయినా కావాలనే ఆశే తనకు",
        "నువ్వు ఎం చేస్తావో ముందే తెలుసు – అయినా రక్షించాలనే ఆశే తనకు",
        "ఇన్ని అర్హతలున్నవి దేవుడొక్కడికే సృష్టిని ఇచ్చింది నీకొక్కడికే",
        "అన్నీ ఇచ్చిన దేవునిని తండ్రనీ గుర్తించవా",
        "అన్నిటికంటే శ్రేష్ఠుడుగా పుట్టించినా నీవెరుగవా",
        "ఎ జీవికీ లెని జ్ఞానం నీకే తెలుసుకో",
        "ఈ భూమిని ఉయ్యాలగ ఊపాడు చూసుకో",
        "ఎవరు రారా…ఆ దేవుని చూడాలని ఎవరికీ లేధా",
        "మరణిస్తే నీవారే తీసుకుపొమ్మంటారా",
        "గమనించావా గ్రహియించావా నీవారెవరో గుర్తించావా",
        "ఆ దేవుడు తండ్రి కాధని పొమ్మంటావా…."
      ],
      "english": [
        "Thandri antene annee icchevaadu – pillalandharini poshinchevaadu",
        "neeku emkaavaalo mundhethelisinavaadu",
        "nuvvu adagakamundhe siddham chesevaadu",
        "inne icchaadante thandre avuthaadu",
        "srushtini chesaadante devudu avuthaadu",
        "annee icchina devunini thandranee gurthinchavaa",
        "thalli thandrini icchindhi dhevudani neeverugavaa",
        "aalochinchi neevevaro thelusuko",
        "aadevude thandrani andariki thelupuko",
        "evariki thelusu nuvvu kaavaalane dhevuni manassu",
        "annee icchinaa nuvvu nammanu ante baadhe thanaku",
        "ee srushtanthaa munushyulu chesaaraa",
        "manushyulandarini dhevudu chesaadaa",
        "chesina dhevunine ledhantaaraa",
        "Paapam chesthaavani mundhe thelusu – ayinaa kaavaalane aase thanaku",
        "nuvvu em chesthaavo mundhe thelusu – ayinaa rakshinchaalane aase thanaku",
        "inne arhathalunnavi dhevudokkadike srushtini icchindhi neekokkadike",
        "annee icchina dhevunini thandranee gurthinchavaa",
        "annitikante sreshtudugaa puttinchinaa neeverugavaa",
        "e jeevikee leni gnyaanam neeke thelusuko",
        "ee bhoomini uyyaalaga oopaadu choosuko",
        "evaru raaraa…aa dhevuni choodaalani evarikee ledhaa",
        "marannisthe neevaare theesukupommantaaraa",
        "gamaninchaavaa grahiyinchaavaa neevaarevaro gurthinchaavaa",
        "aa dhevudu thandri kaadhani pommantaavaa.."
      ]
    }
  ]
}
