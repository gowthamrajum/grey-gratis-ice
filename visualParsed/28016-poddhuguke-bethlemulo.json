{
  "song_name": "Poddhugooke Bethlemulo",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Kiran Kumar",
      "Priya Arif"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పొద్దుగూకె బెత్లేములో",
      "ఊరు వాడా తార వెలుగులో",
      "గొల్లాలేమో పాటల సందడిలో",
      "గాబ్రీయేలు దూత వచ్చెరో",
      "లోకమంతా రక్షణ వార్తరో",
      "కన్నె మరియ శిశువును కన్నదిరో"
    ],
    "english": [
      "Poddhugooke Bethlemulo",
      "Ooru vaadaa thaara velugulo",
      "Gollaalemo paatala sandadilo",
      "Gaabreeyelu dootha vachchero",
      "Lokamanthaa rakshana vaartharo",
      "Kanne Mariya shishuvunu kannadhiro"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆ శిశువేగా నీకు నాకు రక్షకుడు",
        "ఆ యేసేగా మన అందరికి రక్షకుడు"
      ],
      "english": [
        "Aa shishuvegaa neeku naaku rakshakudu",
        "Aa Yesegaa mana andariki rakshakudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పశువుల పాకలో నిద్దురపోయె – జ్ఞానులకు మిక్కిలి పూజితుడాయె",
        "బంగారు సాంబ్రాణి బోళముతో – సాగిలపడి నమస్కరించిరాయె",
        "సర్వ దూతలు స్తోత్రము పాడిరి – మనసారా గొల్లలు ఆడిరి",
        "లోకమంతా సంబరమాయె ఈ వేళ",
        "ఇక జగమంతా చీకటి కానరాదంట",
        "మన బ్రతుకుల్లో సంతోషం నిండెనంట",
        "మదిలోన క్రీస్తుకు నీవు చోటిస్తే – ఆయనకు నీ హృదయం అర్పిస్తే",
        "మనసున నీ ప్రతిపాపం వదిలేస్తే – ప్రభువునకు ఇష్టునిగా నీవుంటే",
        "నీ జీవితాన యేసు పుట్టునులే",
        "నీ బ్రతుకు నూతనమవ్వునులే",
        "పరలోక భాగ్యము దొరుకును ఈ వేళ",
        "ఇక ప్రతి రోజు క్రిస్మస్ పండుగేనంట",
        "నీ బ్రతుకంతా సంతోషం నిండెనంట",
        "ఆ శిశువేగా నీకు నాకు రక్షకుడు",
        "ఆ యేసేగా మన అందరికి రక్షకుడు",
        "ఇక జగమంతా చీకటి కానరాదంట",
        "మన బ్రతుకుల్లో సంతోషం నిండెనంట",
        "ఇక ప్రతి రోజు క్రిస్మస్ పండుగేనంట",
        "నీ బ్రతుకంతా సంతోషం నిండెనంట  ||పొద్దుగూకె||"
      ],
      "english": [
        "Pashuvula paakalo nidhdhurapoye – Gnaanulaku mikkili poojithudaaye",
        "Bangaaru saambraani bolamutho – Saagilapadi namaskarinchiraaye",
        "Sarva doothalu sthothramu paadiri – Manasaaraa gollalu aadiri",
        "Lokamanthaa sambaramaaye ee vela",
        "Ika jagamanthaa cheekati kaanaraadhanta",
        "Mana brathukullo santhosham nindenanta",
        "Madilona Kreesthuku neevu chotisthe – Aayanaku nee hrudayam arpisthe",
        "Manasuna nee prathipaapam vadhileste – Prabhuvunaku ishtunigaa neevunte",
        "Nee jeevithaana Yesu puttunule",
        "Nee brathuku noothanamavvunule",
        "Paraloka bhaagyamu dorukunu ee vela",
        "Ika prathi roju Krismas pandugenanta",
        "Nee brathukanthaa santhosham nindenanta",
        "Aa shishuvegaa neeku naaku rakshakudu",
        "Aa Yesegaa mana andariki rakshakudu",
        "Ika jagamanthaa cheekati kaanaraadhanta",
        "Mana brathukullo santhosham nindenanta",
        "Ika prathi roju Krismas pandugenanta",
        "Nee brathukanthaa santhosham nindenanta  ||Poddhugooke||"
      ]
    }
  ]
}
