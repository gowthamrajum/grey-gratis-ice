{
  "song_name": "Sarveshvaruni dharshanamukai",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor Nithin Parvathaneni"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "సర్వేశ్వరుని దర్శనముకై",
      "ఉదయమునే మ్రొక్కి వేచిఉంటిని",
      "ప్రాణేశ్వర నా ప్రాణ ప్రియుడా",
      "నీ మహిమతో నన్ను దర్శించుమా",
      "సర్వేశ్వరా నా ఆత్మ రక్షకా",
      "నీ దివ్య స్వరముతో మట్లాడుమా"
    ],
    "english": [
      "Sarveshvaruni dharshanamukai",
      "Udhayamune mrokki vechiuntini",
      "Praaneshwara naa praana priyudaa",
      "Nee mahimatho nannu dharshinchumaa",
      "Sarveshvaraa naa aathma rakshakaa",
      "Nee divya swaramutho maatlaadumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమాత్ముడా లోక పరిపాలకా",
        "ఘన మహిమ గలవాడా, గణనీయుడా",
        "సర్వాంతర్యామివి నీవే యెహోవా",
        "సర్వాధికారివి జనయత దైవమా"
      ],
      "english": [
        "Paramaathmudaa loka paripaalakaa",
        "Ghana mahima galavaadaa, gananeeyudaa",
        "Sarvaantharyaamivi neeve Yehova",
        "Sarvaadhikaarivi janayitha daivamaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రాజాధి రాజా మా రక్షణ శృంగమా",
        "రమణీయ సామ్రాజ్య పరిపాలకా",
        "ప్రేమించే క్షమదాత నీవేనయ్యా",
        "ప్రార్ధనలు ఆలించే మా యేసుయ్య"
      ],
      "english": [
        "Raajaadhi raajaa maa rakshana shrungamaa",
        "Ramaneeya saamraajya paripaalakaa",
        "Preminche kshamadhaatha neevenayyaa",
        "Praardhanalu aalinche maa Yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆల్ఫా ఒమేగా ఆది అనంతుడా",
        "ఆదరణ కర్త అదృశ్యదైవమా",
        "సత్యస్వరూపివి నీవేనయ్యా",
        "ఆత్మాభిషేకముతో నింపుమా"
      ],
      "english": [
        "Aalphaa omegaa aadi ananthudaa",
        "Aadarana kartha adhrushyadhaivamaa",
        "Sathyasvaroopivi neevenayyaa",
        "Aathmaabhishekamutho nimpumaa"
      ]
    }
  ]
}
