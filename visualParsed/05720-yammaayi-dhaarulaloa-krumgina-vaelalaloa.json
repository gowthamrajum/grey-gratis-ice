      ],
      "english": [
        "Shodhana vedhanalona gaali thuphaanulalona",
        "Naa Yesu naa naavalona nidhurinchina chaalunu",
        "Saagara keratalaina Saathaanu poraatamaina",
        "Naa Yesuni aanukoni haayiga payaninchedhanu||Yese||"
      ]
