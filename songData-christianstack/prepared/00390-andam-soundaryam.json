{
  "song_name": "Andam Soundaryam",
  "author": {
    "Authored by": "Ch.Shiva",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అందం సౌందర్యం సిరిసంపదలు",
      "ఆ దేవుడే ఇచ్చాడు నీకోసం",
      "నీకున్న అందం చూసి మురిసిపోతున్నావు నీవు",
      "నీ అవయవాలలో దేనిని చేయనేలేదు నీవు"
    ],
    "english": [
      "Andam soundaryam sirisampadhalu",
      "aa dhevude icchaadu neekosam",
      "neekunna andam choosi murisipothunnaavu neevu",
      "nee avayavaalalo dhenini cheyaneledhu neevu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు అందగాడవని అందగత్తెవని",
        "మురిసిపోకుమా మోసపోకుమా",
        "బలంచూసుకొని గర్వపడకుమా",
        "నీ శరీరం మీద ఆశ పెట్టుకోకుమా",
        "నీ శరీరాన్ని పురుగులు తినే ఒక రోజు ఉందనీ…",
        "ఆ రోజు ఏదోకాదు నీ మరణ దినమని",
        "నీ అందచందాలు నీతో రావులే…"
      ],
      "english": [
        "Neevu andhagaadavani andhagatthevani",
        "murisipokumaa mosapokumaa",
        "balamchoosukoni garvapadkumaa",
        "nee sareeram meedha aasa pettukokumaa",
        "nee sareeraanni purugulu thini oka roju undhanee",
        "aa roju eydokaadhu nee maranna dhinamani",
        "nee andhachadaalu neetho raavule"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీకు అస్తి ఉందని సిరిసంపద ఉందని",
        "గర్వపడకుమా పైన చూడమాకుమా",
        "నీ తనవుపైన ఆశ పెట్టుకోకుమా",
        "నీ సంపదను అంత విడచి వెళ్ళాలిగా",
        "నీవు చచ్చినప్పుడే నీతో ఏమి పట్టుకొని పొలేవులే..",
        "ప్రభువైన యేసుని నీవు చేరుమా",
        "నీ మనస్సు మార్చుకొని రక్షణ పొందుమా…"
      ],
      "english": [
        "Neeku asthi undhani sirisampadha undhani",
        "garvapadakumaa paina choodamaakumaa",
        "nee thanavupaina aasa pettukokumaa",
        "nee sampadhanu antha vidachi vellaaligaa",
        "neevu chacchinappude neetho eymi pattukoni polevule",
        "prabhuvaina yesuni neevu cherumaa",
        "nee manassu maarchukoni rakshanna pondhumaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు విత్తె విత్తనం చచ్చి బ్రతుకుతుందిగా",
        "మొక్కయే వృక్షముగా కళ్ళ ముందుదిగా",
        "దేవుడిచ్చిన ఆత్మ నీలో ఉందిగా",
        "మరణించగానే ఆత్మ బయటకే వచ్చుగా",
        "ఆత్మకు ఉన్న అందం అప్పుడే చూస్తావులే…",
        "అంతరించని ఆత్మ అందం నీదేలే",
        "నీ ఆత్మకు మరణమే లేదులే.."
      ],
      "english": [
        "Neevu vitthe vitthanam chacchi brathukuthundhigaa",
        "mokkaye vrukshamugaa kalla mundhudhigaa",
        "maranninchagaane aathma bayatake vacchugaa",
        "aathmaku unna andham appude choosthaavule",
        "antharinchani aathma andham needhele",
        "nee aathmaku maranname ledhule"
      ]
    }
  ]
}
