{
  "song_name": "Koniyaada Dharame Ninnu Koamala Hrudhaya",
  "author": {
    "Authored by": "",
    "రచన": "వంతగాని పరదేశి"
  },
  "main_stanza": {
    "telugu": [
      "కొనియాడఁ దరమె నిన్ను కోమల హృదయ కొనియాడఁ దరమె నిన్ను",
      "తనరారు దినకరుఁ బెనుతారలను మించు",
      "ఘనతేజమున నొప్పు కాంతిమంతుఁడ వీవు"
    ],
    "english": [
      "Koniyaada Dharame Ninnu Koamala Hrudhaya Koniyaada Dharame Ninnu",
      "Thanaraaru Dhinakaru Benuthaaralanu Minchu",
      "Ghanathaejamuna Noppu Kaanthimanthuda Veevu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఖెరుబులు సెరుపులు మరి దూతగణములు",
        "నురుతరంబుగఁ గొలువ నొప్పు శ్రేష్ఠుఁడ వీవు"
      ],
      "english": [
        "Kherubulu Serupulu Mari Dhoothaganamulu",
        "Nurutharambuga Goluva Noppu Shraeshtuda Veevu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సర్వలోకంబులఁ బర్వు దేవుఁడ వయ్యు",
        "నుర్వి స్త్రీ గర్భాన నుద్భవించితి వీవు"
      ],
      "english": [
        "Sarvaloakambula Barvu Dhaevuda Vayyu",
        "Nurvi Sthree Garbhaana Nudhbhavinchithi Veevu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విశ్వమంతయు నేలు వీరాసనుఁడ వయ్యుఁ",
        "పశ్వాళితోఁ దొట్టిఁ పండియుంటివి నీవు"
      ],
      "english": [
        "Vishvamanthayu Naelu Veeraasanuda Vayyu",
        "Pashvaalithoa Dhotti Pandiyuntivi Neevu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దోసంబులను మడియు దాసాళిఁ గరుణించి",
        "యేసు పేరున జగతి కేగుదెంచితి నీవు"
      ],
      "english": [
        "Dhoasambulanu Madiyu Dhaasaali Garuninchi",
        "Yaesu Paeruna Jagathi Kaegudhenchithi Neevu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నరులయందునఁ గరుణ ధర సమాధానంబు",
        "చీకాలమును మహిమ పరఁగఁ జేయుదు వీవు"
      ],
      "english": [
        "Narulayandhuna Garuna Dhara Samaadhaanambu",
        "Cheekaalamunu Mahima Paraga Jaeyudhu Veevu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఓ యేసు పాన్పుగ నా యాత్మఁ జేకొని",
        "శ్రేయముగ బవళించు శ్రీకర వరసుత"
      ],
      "english": [
        "Oa Yaesu Paanpuga Naa Yaathma Jaekoni",
        "Shraeyamuga Bavalinchu Shreekara Varasutha"
      ]
    }
  ]
}
