      "english": [
        "Lokulu choope premaloni swaardham erigelaa",
        "Kreesthuloni niswaardha premaku ardham theliselaa",
        "Adhrushyamainavi nithyamulantu grahimpu pondhelaa",
        "Naligi poyaanu nenu virigipoyaanu ||2||",
        "||Neellalaa||"
