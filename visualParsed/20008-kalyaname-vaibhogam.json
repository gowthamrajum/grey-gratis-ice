{
  "song_name": "Kalyaname Vaibhogam",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "కళ్యాణమే వైభోగం – కమనీయ కాంతుల దీపం /2/",
      "శ్రుతిలయల సుమధుర గీతం /2/",
      "దైవ రచిత సుందర కావ్యం /కళ్యాణమే/"
    ],
    "english": [
      "Kalyaaname vaibhogam – Kamaneeya kaanthula deepam /2/",
      "Shruthilayala sumadhura geetham /2/",
      "Daiva rachitha sundara kaavyam /Kalyaaname/"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమ దైవమె ప్ర్రారంభించిన పరిశుద్ధమైన కార్యం /2/",
        "నరుని మంచికై తన చేతులతో",
        "ప్రభు రాసిచ్చిన పత్రం /కళ్యాణమే/"
      ],
      "english": [
        "Parama daivame praarambhinchina parishuddhamaina kaaryam /2/",
        "Naruni manchikai thana chethulatho",
        "Prabhu raasichchina pathram /Kalyaaname/"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కీడు తొలగించి మేలుతో నింపు ఆశీర్వాదాల వర్షం",
        "మోడుగానున్న జీవితాలు /2/",
        "చిగురింపజేసే వసంతం /కళ్యాణమే/"
      ],
      "english": [
        "Keedu tholaginchi melutho nimpu aasheervaadhaala varsham",
        "Modugaanunna jeevithaalu /2/",
        "Chigurimpajese vasantham /Kalyaaname/"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవదూతలే తొంగిచూసేటి దృశ్యం",
        "భావమధురిమలు పొంగజేసేటి /2/",
        "కమనీయమైన చిత్రం /కళ్యాణమే/"
      ],
      "english": [
        "Dhevadhoothale thongichooseti drushyam",
        "Bhaavamadhurimalu pongajeseti /2/",
        "Kamaneeyamaina chithram /Kalyaaname/"
      ]
    }
  ]
}
