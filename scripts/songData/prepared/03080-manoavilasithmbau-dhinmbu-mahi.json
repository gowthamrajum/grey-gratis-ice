{
  "song_name": "Manoavilasithambau Dhinambu Mahimaanvithambu",
  "author": {
    "Authored by": "",
    "రచన": "ఇ జి ఆనందము"
  },
  "main_stanza": {
    "telugu": [
      "మనోవిలసితంబౌ దినంబు మహిమాన్వితంబు",
      "అనంతజగతీమనోహ రంబు ఘనాదిప్రభుయశః ప్రకాశంబు"
    ],
    "english": [
      "Manoavilasithambau Dhinambu Mahimaanvithambu",
      "Ananthajagatheemanoaha Rambu Ghanaadhiprabhuyashah Prakaashambu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మందమారుతములందము నొసగగ డెందములకు నానందము నిడగా",
        "సుందర పక్షుల సుమధురగానము సుఖావహంబై శోభించెనుగా"
      ],
      "english": [
        "Mandhamaaruthamulandhamu Nosagaga Dendhamulaku Naanandhamu Nidagaa",
        "Sundhara Pakshula Sumadhuragaanamu Sukhaavahambai Shoabhinchenugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అరుణభాస్కరుని కిరణాకరము ధరదిక్తటముల దరిజేరెనుగా",
        "ధరా వలయమాఖర భానునిచే ధగద్ధగీయంబై వెల్గెనుగా"
      ],
      "english": [
        "Arunabhaaskaruni Kiranaakaramu Dharadhikthatamula Dharijaerenugaa",
        "Dharaa Valayamaakhara Bhaanunichae Dhagaddhageeyambai Velgenugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పులుగిల కిలకిల కలరవములతో పొందుగ గలసిన భూరి రవంబు",
        "లలితమనోహరశ్రావ్యమ వినుమా తలపన్ దానికి కారణమేమో"
      ],
      "english": [
        "Pulugila Kilakila Kalaravamulathoa Pondhuga Galasina Bhoori Ravambu",
        "Lalithamanoaharashraavyama Vinumaa Thalapan Dhaaniki Kaaranamaemoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రయమున నొలీవ నగంబుగనుమా రభసయుక్తమగు జనమును గనుమా",
        "జయంజయంబను జయ ధ్యానంబులు వియదంతము జనమ్రోగుట వినుమా"
      ],
      "english": [
        "Rayamuna Noleeva Nagambuganumaa Rabhasayukthamagu Janamunu Ganumaa",
        "Jayamjayambanu Jaya Dhyaanambulu Viyadhanthamu Janamroaguta Vinumaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రసన్నవదనుడు భానుతేజుడు అసంఖ్యజనగణ పరివృతబలుడు",
        "ప్రసితరాసభాసీనుడు యేసుడు అసమ శాంతితో నరుదెంచెనహో"
      ],
      "english": [
        "Prasannavadhanudu Bhaanuthaejudu Asankhyajanagana Parivruthabaludu",
        "Prasitharaasabhaaseenudu Yaesudu Asama Shaanthithoa Narudhenchenahoa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "జయములు బాడెడు బాల చయముతో సాత్వికుడై రాసభంబు నెక్కి",
        "జయోత్సవంబుతో సర్వేశ్వరుడు చనిహృదయము సమర్పించె దము"
      ],
      "english": [
        "Jayamulu Baadedu Baala Chayamuthoa Saathvikudai Raasabhambu Nekki",
        "Jayoathsavambuthoa Sarvaeshvarudu Chanihrudhayamu Samarpinche Dhamu"
      ]
    }
  ]
}
