  "main_stanza": {
    "telugu": [
      "మన హృదయం లో ఇంకా",
      "క్రీస్తు ప్రేమ మ్రోగుచునే",
      "సిలువ మార్గం చూపుచుండ",
      "సీయోను వైపు నడుచుచుండ"
    ],
    "english": [
      "Mana hrudhayamlo inka kreesthu prema mroguchune",
      "Siluva maargam choopuchunda Seeyonu vaipu naduchuchunda"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇంకా మారలేదు మా ఆశ",
        "క్రీస్తులో నిత్య ఆకాంక్ష",
        "మా ప్రభువులో స్వతంత్రులమై",
        "సీయోను దేశం యెరూషలేము"
      ],
      "english": [
        "Inka maaraledhu maa aasha kreesthulo nithya aakaanksha",
        "Maa prabhuvulo swathanthrulamai Seeyonu dhesham Yerushalemu",
        "Maa prabhuvulo swathanthrulamai Seeyonu dhesham Yerushalemu"
