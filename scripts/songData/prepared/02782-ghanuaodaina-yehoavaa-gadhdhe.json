{
  "song_name": "Ghanudaina Yehoavaa Gadhdhe Mundhata",
  "author": {
    "Authored by": "",
    "రచన": "విలియం డాసన్"
  },
  "main_stanza": {
    "telugu": [
      "ఘనుఁడైన యెహోవా గద్దె ముందట మీరు",
      "వినతు లిప్పుడు చేయుడి యోజనులార వినయంబుగా",
      "నిర్మలానంద రసలహరి మన మనం బొప్పుచుండనో జనులార"
    ],
    "english": [
      "Ghanudaina Yehoavaa Gadhdhe Mundhata Meeru",
      "Vinathu Lippudu Chaeyudi Yoajanulaara Vinayambugaa",
      "Nirmalaanandha Rasalahari Mana Manam Boppuchundanoa Janulaara"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒక్కఁడే మన కర్తయుండు దేవుడని యున్",
        "జక్కగాను సృజియించు సంహరించు ననియున్",
        "నిక్కముగఁ దెలిసికొండీ మన సహాయమే",
        "మక్కరలేకుండ మనల మిక్కుటపు పరిపాలనపు",
        "బలముచేఁ జేసె మృత్తుచే మానవులఁగ",
        "దిక్కు గానక తిరుగు గొర్రెల వలె మనము",
        "చెదరఁ దిరుగఁదన దొడ్డిఁబెట్టెనో జనులారా"
      ],
      "english": [
        "Okkadae Mana Karthayundu Dhaevudani Yun",
        "Jakkagaanu Srujiyinchu Samharinchu Naniyun",
        "Nikkamuga Dhelisikondee Mana Sahaayamae",
        "Makkaralaekunda Manala Mikkutapu Paripaalanapu",
        "Balamuchae Jaese Mruththuchae Maanavulaga",
        "Dhikku Gaanaka Thirugu Gorrela Vale Manamu",
        "Chedhara Dhirugadhana Dhoddibettenoa Janulaaraa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మే మందరము వందనపు పాటతో మూగి",
        "మించు నీ గుమ్మములలో మామా స్వరము లెత్తుదుము",
        "నభము పొడవుగా మధురలయ సహితముగను",
        "భూమియున్ దనదు పదివేల జిహ్వల వలఁ బొందైన",
        "నీ నగరి కా ధామంబులను గాన సన్నుతి",
        "వితతిపూరి తమ్ములుగఁ జేయు దేవా యో జనులారా"
      ],
      "english": [
        "Mae Mandharamu Vandhanapu Paatathoa Moogi",
        "Minchu Nee Gummamulaloa Maamaa Svaramu Leththudhumu",
        "Nabhamu Podavugaa Madhuralaya Sahithamuganu",
        "Bhoomiyun Dhanadhu Padhivaela Jihvala Vala Bondhaina",
        "Nee Nagari Kaa Dhaamambulanu Gaana Sannuthi",
        "Vithathipoori Thammuluga Jaeyu Dhaevaa Yoa Janulaaraa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ధరయంత విస్తారమైయున్నది నీ యాజ్ఞ తగ",
        "విరహితాద్యంతమై స్థిరమైన కాలంబువలెనె యున్న దయదయ",
        "పొరలిపోవుచు నున్నవత్సరముల్ నిలిచిపోయి నప్పటికిని",
        "నీదు సత్యంబు నిలిచియుండున్ వర శిలా ఖండ",
        "పర్వతము తోడను సాటి వన్నె కెక్కుచు నెంతయున్ ఓ జనులారా"
      ],
      "english": [
        "Dharayantha Visthaaramaiyunnadhi Nee Yaajna Thaga",
        "Virahithaadhyanthamai Sthiramaina Kaalambuvalene Yunna Dhayadhaya",
        "Poralipoavuchu Nunnavathsaramul Nilichipoayi Nappatikini",
        "Needhu Sathyambu Nilichiyundun Vara Shilaa Khanda",
        "Parvathamu Thoadanu Saati Vanne Kekkuchu Nenthayun Oa Janulaaraa"
      ]
    }
  ]
}
