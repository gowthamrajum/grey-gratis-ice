{
  "song_name": "Ninu Poli Nenu",
  "author": {
    "Authored by": "Annie Margaret",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నన్ను నీవు రక్షించితివయ్య",
      "నీ కృప చేత నే బ్రతికితినయ్య",
      "నన్ను నీవు కాపాడితివయ్య",
      "నీ దయాతో నన్ను దీవించితివయ్య"
    ],
    "english": [
      "Nannu neevu rakshinchithivayya",
      "Ne krupa chetha ne brathikithinayya",
      "Nannu neevu Kapadithivayya",
      "Ne dhayatho nannu dheevinchithivayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకటిలో నుండి వెలుగునకు",
        "నన్ను నడిపిన దేవా",
        "నా జీవితానిని వెలిగించిన",
        "నా బ్రతుకును తేటపరిచిన"
      ],
      "english": [
        "Cheekati lo nundi velugunaku",
        "nannu nadipina dheva",
        "Na jeevithaanini veliginchina",
        "Na brathukunu thetaparachina"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేసయ్యా నా యేసయ్యా",
        "నీవే నా బలము యేసయ్యా",
        "యేసయ్యా నా యేసయ్యా",
        "నీవే నా సర్వము యేసయ్యా"
      ],
      "english": [
        "Yesayya Na Yesayya",
        "Neeve na balamu yesayya",
        "Yesayya Na Yesayya",
        "Neeve na Sarvamu yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిను పోలి నేను జీవింతునయ్య",
        "నీ ఆత్మ దయాచేయుమా",
        "నిను పోలి నేను నడతునయ్య",
        "నీ కాపుదల నియ్యుమా"
      ],
      "english": [
        "Ninupoli nenu Jeevinthunayya",
        "Ne athma dhayacheyuma",
        "Ninu poli nenu nadathunaya",
        "Ne kapudhala neyyuma"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కనికరమే లేని ఈ లోకములో",
        "కన్నీటితో నేనుంటినయ్య",
        "నీ ప్రేమతో నను ఆదరించిన",
        "నా హృదయము తృప్తి పరిచిన"
      ],
      "english": [
        "Kanikarame leni e lokam lo,",
