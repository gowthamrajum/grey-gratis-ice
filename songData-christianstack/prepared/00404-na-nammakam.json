  "main_stanza": {
    "telugu": [
      "నే నమ్మే నమ్మకము – ఎప్పటికి నీవే",
      "దీవెనలు కలిగిన నిను నమ్మెదన్",
      "దీవెనలు లేకున్న నిను నమ్మెదన్"
    ],
    "english": [
      "Ne namme nammakamu – eppatiki neeve",
      "dheevenalu kaligina ninu nammedhan",
      "dheevenalu lekunna ninu nammedhan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీకే నా ఆరాధన – నిన్నే నే ఘనపరచెదన్",
        "నీకే నా ఆరాధన – నీకే"
      ],
      "english": [
        "Neeke naa aaraadhanaa – ninne ne ghanaparachedhan",
        "neeke naa aaraadhanaa – neeke"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీకే నా ఆరాధన – నిన్నే నే ఘనపరచెదన్",
        "నీకే నా ఆరాధన – నీకే",
        "యేసయ్యా…"
      ],
      "english": [
        "Neeke naa aaraadhanaa – ninne ne ghanaparachedhan",
        "neeke naa aaraadhanaa – neeke",
        "yesayyaa…"
      ]
    }
  ]
}
