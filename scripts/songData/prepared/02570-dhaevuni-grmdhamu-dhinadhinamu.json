{
  "song_name": "Dhaevuni Grandhamu Dhinadhinamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవుని గ్రంధము దినదినము చదువుము",
      "పావనమార్గము జీవము సత్యము"
    ],
    "english": [
      "Dhaevuni Grandhamu Dhinadhinamu Chadhuvumu",
      "Paavanamaargamu Jeevamu Sathyamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎంచి తలంచుము మించిన గ్రంథము",
        "అంచితముగను రెం డంచుల ఖడ్గము"
      ],
      "english": [
        "Enchi Thalanchumu Minchina Granthamu",
        "Anchithamuganu Ren Danchula Khadgamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తేనియమధురము తినుము ప్రతిదినము",
        "ధ్యానముసేయుము దానన బ్రదుకుము"
      ],
      "english": [
        "Thaeniyamadhuramu Thinumu Prathidhinamu",
        "Dhyaanamusaeyumu Dhaanana Bradhukumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాధుని వాక్యము అరయుము భాగ్యము",
        "పాదపు దీపము భక్తుల కవచము"
      ],
      "english": [
        "Naadhuni Vaakyamu Arayumu Bhaagyamu",
        "Paadhapu Dheepamu Bhakthula Kavachamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆత్మల శాంతము అభయము శ్రేయము",
        "ఆత్మలకు బలము అనయము సౌఖ్యము"
      ],
      "english": [
        "Aathmala Shaanthamu Abhayamu Shraeyamu",
        "Aathmalaku Balamu Anayamu Saukhyamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాపము శాపము పలువిధతాపము",
        "పాపును వేగము దాపున జేరుము"
      ],
      "english": [
        "Paapamu Shaapamu Paluvidhathaapamu",
        "Paapunu Vaegamu Dhaapuna Jaerumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మదినిది నిరతము పదిలము చేయుము",
        "సదమల జ్ఞానము సవిధము మోక్షము"
      ],
      "english": [
        "Madhinidhi Nirathamu Padhilamu Chaeyumu",
        "Sadhamala Jnyaanamu Savidhamu Moakshamu"
      ]
    }
  ]
}
