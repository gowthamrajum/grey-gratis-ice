{
  "song_name": "Madhyapaana Priyulu Gaakundi",
  "author": {
    "Authored by": "",
    "రచన": "నేలటూరి లూకర్"
  },
  "main_stanza": {
    "telugu": [
      "మద్యపాన ప్రియులు గాకుండి ప్రియులార మీరా",
      "మత్తులోనే మునిఁగి పోకుండి",
      "మద్యపానము చేయువారికిఁ దథ్యముగఁ బ్రాప్తించుఁ గీడులు",
      "కొద్దియైనన్ రుచిని జూడఁగఁ గోరఁ దగ దని తలఁచుకొనుఁడి"
    ],
    "english": [
      "Madhyapaana Priyulu Gaakundi Priyulaara Meeraa",
      "Maththuloanae Munigi Poakundi",
      "Madhyapaanamu Chaeyuvaariki Dhathyamuga Braapthinchu Geedulu",
      "Kodhdhiyainan Ruchini Joodaga Goara Dhaga Dhani Thalachukonudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్త మంతయుఁ జెడును సుమ్మండి ప్రియులారా మీరు",
        "శక్తిహీనులగుదు రిల నుండి",
        "శక్యిహీనులె గాక మఱి మీ భక్తి దొలఁగి పోవునండి",
        "ముక్తిమార్గము దెలియదండి ముందు గతికి హీనమండి"
      ],
      "english": [
        "Raktha Manthayu Jedunu Summandi Priyulaaraa Meeru",
        "Shakthiheenulagudhu Rila Nundi",
        "Shakyiheenule Gaaka Mari Mee Bhakthi Dholagi Poavunandi",
        "Mukthimaargamu Dheliyadhandi Mundhu Gathiki Heenamandi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బుద్ధిబలములు కొద్ది వౌనండి ప్రియులారా మీరు",
        "మొద్దు లగుదురనియు నమ్ముండి",
        "హద్దు మిరుచుఁ ద్రాగువారికిఁ గొద్దికాలమె జీవమండి",
        "శ్రద్ధగల్గి మద్యపానము రద్దు చేయుట తగినదండి"
      ],
      "english": [
        "Budhdhibalamulu Kodhdhi Vaunandi Priyulaaraa Meeru",
        "Modhdhu Lagudhuraniyu Nammundi",
        "Hadhdhu Miruchu Dhraaguvaariki Godhdhikaalame Jeevamandi",
        "Shradhdhagalgi Madhyapaanamu Radhdhu Chaeyuta Thaginadhandi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మచ్చునకును త్రాగఁబోకుండి ప్రియులార మీరీ",
        "తుచ్ఛమైన పనులు వీడుండీ",
        "హెచ్చుగాఁ దిని త్రాగువారికి వచ్చు రోగము కుదురదండి",
        "చచ్చుటకు నిది హేతువని మదిఁ గచ్చితముగను దెలిసికొనుఁడి"
      ],
      "english": [
        "Machchunakunu Thraagaboakundi Priyulaara Meeree",
        "Thuchchamaina Panulu Veedundee",
        "Hechchugaa Dhini Thraaguvaariki Vachchu Roagamu Kudhuradhandi",
        "Chachchutaku Nidhi Haethuvani Madhi Gachchithamuganu Dhelisikonudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆలుబిడ్డల మేలుఁగోరుండి ప్రియులారా వారి",
        "మేలుఁ గోరినఁ ద్రాగంఁ బోకుండి",
        "మేలు లెఱింగి పిలుచు క్రీస్తుని జాలిచూపులు దెలిసికొనుఁడి",
        "కాలయాపనఁ జేయకుండి కర్త యేసని నమ్ముకొనఁడి"
      ],
      "english": [
        "Aalubiddala Maelugoarundi Priyulaaraa Vaari",
        "Maelu Goarina Dhraaga Boakundi",
        "Maelu Leringi Piluchu Kreesthuni Jaalichoopulu Dhelisikonudi",
        "Kaalayaapana Jaeyakundi Kartha Yaesani Nammukonadi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఘన ధనములు నిలువఁబోవండి ప్రియులార నీచ",
        "తనము మీకు మూల మౌనండి",
        "తనవిఁదీర్చుదు మద్యమండి ఘనుల కొంపలు గూల్చు నండి",
        "ఘనముగాఁ బ్రభువాక్యసారము వినయమతితో ఁ గ్రోలరండి"
      ],
      "english": [
        "Ghana Dhanamulu Niluvaboavandi Priyulaara Neecha",
        "Thanamu Meeku Moola Maunandi",
        "Thanavidheerchudhu Madhyamandi Ghanula Kompalu Goolchu Nandi",
        "Ghanamugaa Brabhuvaakyasaaramu Vinayamathithoa Groalarandi"
      ]
    }
  ]
}
