    {
      "stanza_number": 4,
      "telugu": [
        "సమాధి సంకెళ్ళయినా మరణపు మళ్ళైన జయించితివా నా యేసయ్యా ॥2॥"
      ],
      "english": [
        "Samaadhi sankellayinaa maranapu mullaina jayinchithivaa naa Yesayyaa ॥2॥"
