{
  "song_name": "Ninu Matrame Ne Nammanaya",
  "author": {
    "Authored by": "Bro John J",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిను మాత్రమే నే నమ్మానయా",
      "నీవు మాత్రమే నా ధైర్యం యేసయ్యా",
      "నీ బాహుబలమే నడిపించును",
      "నా స్థితులన్నిటిని సరిచేయును",
      "కృప చూపువాడవయా నీ పిల్లలకు"
    ],
    "english": [
      "Ninu matrame ne nammanayya",
      "Neevu matrame na dhairyam Yesayya",
      "Nee bahubalame nadipinchunu",
      "Na sthithulannitini saricheyunu",
      "Krupa choopuvadavayya nee pillalaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు సెలవియ్యగా కలుగనిదేముంది",
        "వాక్కును పంపగా జరుగనిదేముంది",
        "సకలము నీదెనయా శ్రీమంతుడా",
        "స్తుతి నీకు పాడెదనయా",
        "సమకూర్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Neevu selaviyyaga kaluganidhemundhi",
        "Vakkunu pampaga jaruganidhemundhi",
        "Sakalamu needhenayya sreemanthuda",
        "Sthuthi neeku padedhanayya",
        "Samakoorchuvadavayya nee pillalaku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ముందు నీవుండగా ఎదురొచ్చువాడెవడు",
        "కార్యము చేయగా అడ్డుపడువాడెవడు",
        "యుద్ధము నీదెనయా ఓ శూరుడా",
        "ముందుకు సాగెదనయా",
        "జయమిచ్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Na mundu neevu undaga edurochuvadevadhu",
        "Karyamu cheyaga addupaduvadevadhu",
        "Yuddhamu needhenayya oh shooruda",
        "Munduku sagedhanayya",
        "Jayamichuvadavayya nee pillalaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు కరుణించగా కాదనువాడెవడు",
        "శక్తితో నింపగా ఓడించువాడెవడు",
        "సాయము నీదెనయా సహాయకుడా",
        "నీలో దాగెదనయా",
        "బలమిచ్చువాడవయా నీ పిల్లలకు"
      ],
      "english": [
        "Neevu karuninchaga kadhanu vadevadu",
        "Shakthitho nimpaga odinchuvadevadhu",
        "Sayamu needhenayya sahayakuda",
        "Neelo dagedhanayya",
        "Balamichuvadavayya nee pillalaku"
      ]
    }
  ]
}
