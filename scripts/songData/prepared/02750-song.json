{
  "song_name": "Yaesoo Naa Prabhuvaa Nee Praema Laekunna",
  "author": {
    "Authored by": "",
    "రచన": "ఏనీ షెర్పుడ్ హాక్స్"
  },
  "main_stanza": {
    "telugu": [
      "యేసూ, నా ప్రభువా, నీ ప్రేమ లేకున్న",
      "నా యాత్మ కేదియు విశ్రాంతి నియ్యదు.",
      "ఒక్కొక్క గంట నేను నిన్నాశించుకొందు",
      "నీ యాశీర్వాద మిమ్ము నా రక్షకుఁడా"
    ],
    "english": [
      "Yaesoo, Naa Prabhuvaa, Nee Praema Laekunna",
      "Naa Yaathma Kaedhiyu Vishraanthi Niyyadhu.",
      "Okkokka Ganta Naenu Ninnaashinchukondhu",
      "Nee Yaasheervaadha Mimmu Naa Rakshakudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసూ, రేబగుళ్లు నా యొద్ద నుండుము",
        "నాతో నీవుండిన నే భయ ముండదు."
      ],
      "english": [
        "Yaesoo, Raebagullu Naa Yodhdha Nundumu",
        "Naathoa Neevundina Nae Bhaya Mundadhu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సుఖంబుఁ బొందఁగా నిన్నే యాశింతును",
        "దుఃఖంబు నొదఁగా నీవే శరణ్యము."
      ],
      "english": [
        "Sukhambu Bondhagaa Ninnae Yaashinthunu",
        "Duhkhambu Nodhagaa Neevae Sharanyamu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ మార్గమందున నే నడ్వ నేర్పుము",
        "నీ మాట చొప్పున నన్నున్ దీవించుము."
      ],
      "english": [
        "Nee Maargamandhuna Nae Nadva Naerpumu",
        "Nee Maata Choppuna Nannun Dheevinchumu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నిన్నే యాశింతును యేసూ, నా ప్రభువా",
        "నీవంటివాఁడనై నన్నుండఁ జేయుము."
      ],
      "english": [
        "Ninnae Yaashinthunu Yaesoo, Naa Prabhuvaa",
        "Neevantivaadanai Nannunda Jaeyumu."
      ]
    }
  ]
}
