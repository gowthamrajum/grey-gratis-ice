        "పూజ్యనీయుడా"
      ],
      "english": [
        "Israayelu devudaa maa kaapari yesayyaa",
        "nithyamu sthuthiyinchi ghanaparachedam",
        "sthuthi chellinthumu sthuthi arpinthumu",
        "poojyaneeyudaa"
      ]
    }
  ]
