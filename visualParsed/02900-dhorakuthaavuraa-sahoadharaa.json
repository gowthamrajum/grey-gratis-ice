  "main_stanza": {
    "telugu": [
      "దొరకుతావురా సహోదరా! దొరుకుతావురా, నీవు",
      "తరిమి తరిమి కీడుచేయ పరుగులెత్తినగాని తుదకు ||దొ||"
    ],
    "english": [
      "Dhorakuthaavuraa sahodharaa! dhorukuthaavuraa, neevu",
      "Tharimi tharimi keeducheya paruguletthinagaani thudaku ||Dho||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చిన్న చూపు చూచి తమ్ముని కన్నెఱుంగక చంపినగాని",
        "అన్న కయీను దేవుని హస్తమునకు దొరికిన రీతిగా ||దొ||"
      ],
      "english": [
        "Chinna choopu choochi thammuni kannerungaka champinagaani",
        "Anna Kayeenu Devuni hasthamunaku dhorikina reethigaa ||Dho||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వరములొందిన తమ్ముని జంప వలయునని పంతముగబట్టి",
        "నరకవచ్చిలోబడి యేడ్చిన దురిత చరితుని యేశావువలె ||దొ||"
      ],
      "english": [
        "Varamulondhina thammuni jampa valayunani panthamugabatti",
        "Narakavachchilobadi yedchina duritha charithuni Yeshaavuvale ||Dho||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భక్త దావీదును బట్టి ప్రాణము దీయగ దలచిన తన",
        "శక్తితో తరిమిన రాజగు సౌలు దొరికినరీతిగాను ||దొ||"
      ],
      "english": [
        "Bhaktha Dhaaveedhunu batti praanamu dheeyaga dhalachina thana",
        "Shakthitho tharimina raajagu Saulu dhorikinareethigaanu ||Dho||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విగ్రహమునకు మ్రొక్కని దైవ పిల్లల నగ్నిలోపడవైచి",
        "ఆగ్రహించిన నెబుకద్నెజరు గడ్డిమోసి దొరికిన విధముగ ||దొ||"
      ],
      "english": [
        "Vigrahamunaku mrokkani daiva pillala nagnilopadavaichi",
        "Aagrahinchina Nebukadnejaru gaddimosi dhorikina vidhamuga ||Dho||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "క్రైస్తవులను బట్టి కొట్టి ఖైదులో వేయదలచినను",
        "వాస్తవమగు వెలుగును జూచి ప్రభుని చాటిని పౌలుబోలి ||దొ||"
      ],
      "english": [
        "Kraisthavulanu batti kotti khaidhulo veyadhalachinanu",
        "Vaasthavamagu velugunu joochi Prabhuni chaatini Pauluboli ||Dho||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
