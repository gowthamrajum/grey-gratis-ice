{
  "song_name": "Maa mora naalakinchumu mahaaraaja Yesu prabhuvaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వారు నీకు మొర్రపెట్టి విడుదల నొందిరి కీర్తన సామ్ 22:5",
      "మా మొర నాలకించుము - మహారాజ యేసు ప్రభువా",
      "కోపముతో నను జూడకుము - కనికరమున పలుకుము"
    ],
    "english": [
      "Vaaru neeku morrapetti vidudala nondhiri keerthana Psalm 22:5",
      "Maa mora naalakinchumu - Mahaaraaja Yesu prabhuvaa",
      "Kopamutho nanu joodakumu - Kanikaramuna palukumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్నెట్లు విడనాడెదను - ప్రాణప్రియుడా నా యేసు",
        "సిలువకు జడియలేదు - శ్రమలకు బెదురలేదు",
        "నీ నోట దూషణమాట - ఒకటైనను రాలేదు"
      ],
      "english": [
        "Ninnetlu vidanaadedanu - Praanapriyudaa naa Yesu",
        "Siluvaku jadiyaledu - Shramalaku bedhuraledu",
        "Nee nota dhooshanamaata - Okatainanu raaledu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరలోకమును విడచితివి - పాపులకై ఏతెంచితివి",
        "సర్వలోక రక్షణకై సిలువపై శ్రమనొందితివి",
        "ఇట్టి నీ ప్రేమకు నేను - ఎట్టి ధనమియ్యగలను"
      ],
      "english": [
        "Paralokamunu vidachithivi - Paapulakai ethenchithivi",
        "Sarvaloka rakshanakai siluvapai shramanondhithivi",
        "Itti nee premaku nenu - Etti dhanamiyyagalanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సమస్త లోకమునకు - నీ రక్తము నిచ్చితివి",
        "మూయబడిన యీ తలుపు - తీయబడెను నీ వలన",
        "నే నేల నీ సంస్తుతిని - నిరతంబు చేయకపోతి"
      ],
      "english": [
        "Samastha lokamunaku - Nee rakthamu nichchithivi",
        "Mooyabadina ee thalupu - Theeyabadenu nee valana",
        "Ne nela nee samsthuthini - Nirathambu cheyakapothi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జగమంత నీ రాకడను - నిరీక్షించుచుండెను",
        "నీ నీతిని నెరవేర్చుటకు - ఖ్యాతిగ నరుదెంచితివి",
        "నిబంధన ననుసరించి - విముక్తిని మా కొసగితివి"
      ],
      "english": [
        "Jagamantha nee raakadanu - Nireekshinchuchundenu",
        "Nee neethini neraverchutaku - Khyaathiga narudhenchithivi",
        "Nibandhana nanusarinchi - Vimukthini maa kosagithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షకుండా పాపులను - శిక్షించక రక్షించు",
        "నిత్యజీవము నిమ్ము - ఆత్మయందు దీనులకు",
        "దైవ కుమారా యేసు - సార్వత్రిక నివాసీ"
      ],
      "english": [
        "Rakshakundaa paapulanu - Shikshinchaka rakshinchu",
        "Nithyajeevamu nimmu - Aathmayandhu dheenulaku",
        "Daiva kumaaraa Yesu - Saarvathrika nivaasee"
      ]
