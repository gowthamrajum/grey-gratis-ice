{
  "song_name": "Aadharinchaga Raava",
  "author": {
    "Authored by": "Joshua Shaik, Passion For Christ Ministries",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆగని పరుగులో ఎండిన ఎడారులు",
      "కృంగిన బ్రతుకులో నిండిన కొరతలు",
      "ఉన్నపాటునా నలిగె నా వైపునా",
      "కదలిరాలేవా ఆదరించగ రావా"
    ],
    "english": [
      "Aagani parugulo endina edaarulu",
      "krungina brathukulo nindina korathalu",
      "unnaapaatunaa naligi naa vaipunaa",
      "kadhiliraalevaa aadharinchaga raavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కన్నీరే నా మజిలీ, దరి చేరే నీ జాలి",
        "లాలించే నీ ప్రేమ, నా ప్రాణమై",
        "కరుణించే నీ చూపు, మన్నించే నా మనవి",
        "అందించే నీ చేయి, నా స్నేహమై"
      ],
      "english": [
        "kanneere naa majili, dhari chere nee jaali",
        "laalinche nee prema, naa praanamai",
        "karuninche nee choopu, manninche naa manavi",
        "andhinche nee cheyi, naa snehamai"
      ]
    }
  ]
}
