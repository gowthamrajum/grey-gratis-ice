    {
      "stanza_number": 7,
      "telugu": [
        "దేవుని జీవగ్రంథము దేవుడు తెరచును",
        "ఎవ్యాని పేరందుండదో వాడగ్నిలో బడును  ||ఆహాఆఅంత్యతీర్పు||"
      ],
      "english": [
        "Devuni jeevagranthamu Devudu therachunu",
        "Evvaani perandhundadho vaadagnilo badunu ||Aahaa aa anthyatheerpu||"
