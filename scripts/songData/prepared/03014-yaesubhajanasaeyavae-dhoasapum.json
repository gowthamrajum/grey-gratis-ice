{
  "song_name": "Yaesubhajanasaeyavae Dhoasapumanasaa",
  "author": {
    "Authored by": "",
    "రచన": "ఓగిరాల గాబ్రియేలు"
  },
  "main_stanza": {
    "telugu": [
      "యేసుభజనసేయవే దోసపుమనసా!",
      "వాసిగ నేనే, వరరక్షకుఁడు",
      "వేసారి వసుధ నెవ్వారినిఁ గానము"
    ],
    "english": [
      "Yaesubhajanasaeyavae Dhoasapumanasaa!",
      "Vaasiga Naenae, Vararakshakudu",
      "Vaesaari Vasudha Nevvaarini Gaanamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ధారుణపాప భరణా! హరణా!",
        "కారుణ్యకరయని కోరిభజింపవె"
      ],
      "english": [
        "Dhaarunapaapa Bharanaa! Haranaa!",
        "Kaarunyakarayani Koaribhajimpave"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శాంతిసునీతి సదములభక్తిన్",
        "వింతగనిడు మన శ్శాంతిసుధాకరుఁ డేసు"
      ],
      "english": [
        "Shaanthisuneethi Sadhamulabhakthin",
        "Vinthaganidu Mana Shshaanthisudhaakaru Daesu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అనఘా! నీవే అవనితలంబున",
        "ననుఁగనుఁగొంటివి నా ధనమంటివి"
      ],
      "english": [
        "Anaghaa! Neevae Avanithalambuna",
        "Nanuganugontivi Naa Dhanamantivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనసా! నీదు మలినంబును తా",
        "మనుగడ, సిల్వపై మాపెమహాత్ముఁ డు"
      ],
      "english": [
        "Manasaa! Needhu Malinambunu Thaa",
        "Manugada, Silvapai Maapemahaathmu Du"
      ]
    }
  ]
}
