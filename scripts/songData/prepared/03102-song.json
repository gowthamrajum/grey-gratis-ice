{
  "song_name": "Haayi Loakamaa Prabhuvachchen",
  "author": {
    "Authored by": "",
    "రచన": "ఐజక్ వాట్స్"
  },
  "main_stanza": {
    "telugu": [
      "హాయి, లోకమా! ప్రభువచ్చెన్ అంగీకరించుమీ",
      "పాపాత్ములెల్ల రేసునున్ కీర్తించి పాడుఁడీ."
    ],
    "english": [
      "Haayi, Loakamaa! Prabhuvachchen Angeekarinchumee",
      "Paapaathmulella Raesunun Keerthinchi Paadudee."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హాయి రక్షకుండు ఏలును సాతాను రాజ్యమున్",
        "నశింపఁజేసి మా యేసే జయంబు నొందును."
      ],
      "english": [
        "Haayi Rakshakundu Aelunu Saathaanu Raajyamun",
        "Nashimpajaesi Maa Yaesae Jayambu Nondhunu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాప దుఃఖంబులెల్లను నివృత్తిఁ జేయును",
        "రక్షణ్య సుఖక్షేమముల్ సదా వ్యాపించును."
      ],
      "english": [
        "Paapa Duhkhambulellanu Nivruththi Jaeyunu",
        "Rakshanya Sukhakshaemamul Sadhaa Vyaapinchunu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సునీతి సత్యకృపలన్ రాజ్యంబు నేలును",
        "భూజనులార మ్రొక్కు(డీ స్తోత్రార్హుఁడాయెనే."
      ],
      "english": [
        "Suneethi Sathyakrupalan Raajyambu Naelunu",
        "Bhoojanulaara Mrokku(dee Sthoathraarhudaayenae."
      ]
    }
  ]
}
