{
  "song_name": "Prabhuvugan Prathishtimparae Gruhamuna",
  "author": {
    "Authored by": "",
    "రచన": "సి విజయ చార్లెస్"
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువుగన్ ప్రతిష్టింపరే గృహమున క్రీస్తున్",
      "ప్రభువుగా ప్రతిష్టింపరె విభవమొందగ",
      "నతని శుభమౌ నామము ధర సౌ రభమును వెదజల్లగ",
      "ప్రబలమౌ ప్రేమన్ ప్రభుని యెడ గనపర్చరె"
    ],
    "english": [
      "Prabhuvugan Prathishtimparae Gruhamuna Kreesthun",
      "Prabhuvugaa Prathishtimpare Vibhavamondhaga",
      "Nathani Shubhamau Naamamu Dhara Sau Rabhamunu Vedhajallaga",
      "Prabalamau Praeman Prabhuni Yeda Ganaparchare"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పూర్ణ ప్రేమను జూపరే గృహమున క్రీస్తును",
        "పూర్ణ ప్రేమను జూపరే పూర్ణ హృదయముతోను",
        "పూర్ణయాత్మతో మరి ప్ర పూర్ణ శక్తితో జూపరే",
        "క్రీస్తునిలో సం పూర్ణులగుటకు సాగరె"
      ],
      "english": [
        "Poorna Praemanu Jooparae Gruhamuna Kreesthunu",
        "Poorna Praemanu Jooparae Poorna Hrudhayamuthoanu",
        "Poornayaathmathoa Mari Pra Poorna Shakthithoa Jooparae",
        "Kreesthuniloa Sam Poornulagutaku Saagare"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "భక్తితోడను గొల్వరే గృహమున క్రీస్తున్",
        "భక్తితోడను గొల్వరే ముక్తినాధుడు",
        "తన స్వ రక్తమీయను మనకై రిక్తుడాయెను జూడరే",
        "ముక్తిదాతను నా సక్తితో గొనియాడరే"
      ],
      "english": [
        "Bhakthithoadanu Golvarae Gruhamuna Kreesthun",
        "Bhakthithoadanu Golvarae Mukthinaadhudu",
        "Thana Sva Rakthameeyanu Manakai Rikthudaayenu Joodarae",
        "Mukthidhaathanu Naa Sakthithoa Goniyaadarae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నమ్మకస్థులై యుండరే గృహమున క్రీస్తుకు",
        "నమ్మకస్థులై యుండరే అమ్మహాత్ముని",
        "నామ మిమ్మహిన్ దగజాటన్ నమ్మె మిమ్మును జూడరె",
        "సమ్మతిన్ గ్రీస్తున్ నమ్మకంబుగ జాటరె"
      ],
      "english": [
        "Nammakasthulai Yundarae Gruhamuna Kreesthuku",
        "Nammakasthulai Yundarae Ammahaathmuni",
        "Naama Mimmahin Dhagajaatan Namme Mimmunu Joodare",
        "Sammathin Greesthun Nammakambuga Jaatare"
      ]
    }
  ]
}
