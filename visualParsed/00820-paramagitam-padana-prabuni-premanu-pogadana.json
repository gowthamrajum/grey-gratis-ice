  "main_stanza": {
    "telugu": [
      "పరమగీతం పాడనా",
      "ప్రభుని ప్రేమను పొగడనా",
      "నా ప్రియుని విశేషం లోకానికి తెలుపనా"
    ],
    "english": [
      "Paramageetham paadanaa",
      "Prabhuni premanu pogadanaa",
      "Naa priyuni vishesham lokaaniki thelupanaa"
