{
  "song_name": "Oke Okka Korika",
  "author": {
    "Authored by": "Shadrak",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఒకే ఒక్క కోరిక మన్నించు యేసయ్యా",
      "అడిగి అడిగి నేను అలసిపోతినయ్యా",
      "నీ సన్నిధికొచ్చామయ్యా త్రోసివేయకు",
      "ఎన్నేండ్ల నుంచో మేము ఎదురు చూచితి",
      "ఈసారి అయినా మాపై జాలి చూపవా",
      "ఈసారి అయినా మాపై కరుణ చూపవా"
    ],
    "english": [
      "Oke okka korika manninchu Yesayyaa",
      "Adigi adigi nenu alasipothinayyaa",
      "Nee sannidhikocchaamayyaa throshiveyaku",
      "Ennendla nuncho memu edhuru chuchithi",
      "Eesaari ayina maapai jaali chupavaa",
      "Eesaari ayina maapai karuna chupavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "విరోధుల చేతిలో నలిగిపోతిని",
        "శ్రమలనే కొలిమిలో కాల్చబడితిని",
        "భరియించుటకు నేను వెండిని కానయ్యా",
        "ఓర్చుకొనుటకు నేను మట్టినేనయ్యా",
        "ఇక చాలయ్యా",
        "శ్రమలనే కొలిమి నుండి నన్ను పైకి లాగవా"
      ],
      "english": [
        "Virodhula chethilo naligipothini",
        "Shramalane kolimilo kaalchabadithini",
        "Bhariyinchutaku nenu vendini kaanayyaa",
        "Orchukonutaku nenu mattinenayyaa",
        "Ika chaalayyaa",
        "Shramalane kolimi nundi nannu paiki laagavaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కన్నీరు విడుచుచు విత్తుచుండగా",
        "సంతోష గానముతో పంట కోసెదా",
        "నీ కొరకై సిద్ధము చేసిన బలము కోసమే",
        "ఉపవాస ప్రార్థనలో కనిపెట్టెదా",
        "ఇక చాలయ్యా",
        "కన్నీటి లోయ నుండి పైకి లాగవా"
      ],
      "english": [
        "Kanneeru viduchuchu vitthuchundagaa",
        "Santhosha gaanamutho panta kosedhaa",
        "Nee korakai siddhamu chesina balamu kosame",
        "Upavaasa praarthanalo kanipettedhaa",
        "Ika chaalayyaa",
        "Kanneeriti loya nundi paiki laagavaa"
      ]
    }
  ]
}
