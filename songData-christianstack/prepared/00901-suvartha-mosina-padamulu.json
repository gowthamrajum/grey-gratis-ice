{
  "song_name": "Suvartha Mosina Padamulu",
  "author": {
    "Authored by": "Bro. Sayaram Gattu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సుందరములు అతి సుందరములు",
      "సువార్త మోసిన పాదములు",
      "అతి శ్రేష్ఠులు, ఎంతటి ధన్యులు",
      "ప్రభు ప్రేమను చాటిన పెదవులు"
    ],
    "english": [
      "Sundarumulu athi sundaramulu",
      "suvartha mosina paadamulu",
      "athi srestulu, enthati dhanyulu",
      "prabhu premanu chaatina pedhavulu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏ లేమికి కలత చెందరు, ఏ నలతకు తలలు వంచరు",
        "ప్రభు సేవలో ధీరులు వీరు, తన చిత్తము ఎరిగిన వారు"
      ],
      "english": [
        "Ey lemiki kalatha chendharu, ey nalathaku thalalu vancharu",
        "prabhu sevalo dheerulu veeru, thana chittham erigina vaaru"
      ]
    }
  ]
}
