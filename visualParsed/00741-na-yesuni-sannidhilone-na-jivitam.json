    "english": [
      "Naa Yesuni sannidhilone naa jeevitham arpinchedanu",
      "Kaalamu maarinaa kashtaalu kaliginaa",
      "Viduvaka nenu saagi podhunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
