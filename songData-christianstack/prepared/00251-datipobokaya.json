  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా వేదనకు మితిలేదు",
        "నా శోఖానికి తుదిలేదు",
        "నీవుగాక జీవితాన ఆశయే లేదు",
        "నాకోసం నువ్వు వస్తావని",
        "నా ఆర్తధ్వని వింటావని",
        "ఎదురుచూస్తున్నాను నిదురకాస్తున్నాను",
        "అవమానాల నా బ్రతుకే",
        "ఆవేదనలో నిను వెతికే",
        "నీవు రాక దిక్కు లేక దీనమైపోయే",
        "నాకోసం నువ్వు వస్తావని",
        "నా ఆర్తధ్వని వింటావని",
        "ఎదురుచూస్తున్నాను నిదురకాస్తున్నాను"
      ],
      "english": [
        "Naa vedanaku mithiledhu",
        "naa shokaaniki thudiledhu",
        "neevugaaka jeevithaan aashaye ledhu",
        "naakosam nuvvu vastaavani",
        "naa aarthadhwani vintaavani",
        "eduruchustunnaanu nidura kaastunnaanu",
        "Avamaanala naa brathuke",
        "aavedanalo ninu vethike",
        "neevu raaka dikku leka deenamaipooye",
        "naakosam nuvvu vastaavani",
        "naa aarthadhwani vintaavani",
        "eduruchustunnaanu nidura kaastunnaanu"
      ]
    }
  ]
