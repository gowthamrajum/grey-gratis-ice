{
  "song_name": "O Prabhuvaa idhi nee krupaye - Goppa krayamu dwaaraa kalige",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఓ ప్రభువా యిది నీ కృపయే - గొప్ప క్రయము ద్వారా కలిగె"
    ],
    "english": [
      "O Prabhuvaa idhi nee krupaye - Goppa krayamu dwaaraa kalige"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృపద్వారానే పాపక్షమాపణ - రక్తము ద్వారానే కలిగె",
        "అపరాధముల నుండి విమోచన - యేసులో మనకు ప్రాప్తించె"
      ],
      "english": [
        "Krupadhvaaraane paapakshamaapana - Rakthamu dwaaraane kalige",
        "Aparaadhamula nundi vimochana - Yesulo manaku praapthinche"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కృపద్వారానే కలిగిన రక్షణ - మానవులొసగ జాలరిల",
        "క్రియలద్వారా కలుగలేదు - యేసు ప్రభుని వరమిదియే"
      ],
      "english": [
        "Krupadhvaaraane kaligina rakshana - Maanavulosaga jaalarila",
        "Kriyaladhvaaraa kalugaledhu - Yesu prabhuni varamidhiye"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కృపతో మనల పిలిచెను ప్రభువు - పరిశుద్ద పిలుపుద్వారా",
        "అపరిమిత సంకల్పమువలన - మనమెరిగితిమి ఈ ధరలో"
      ],
      "english": [
        "Krupatho manala pilichenu prabhuvu - Parishuddha pilupudhvaaraa",
        "Aparimitha sankalpamuvalana - Manamerigithimi ee dharalo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కృపద్వారానే నీతి మంతులుగా - తీర్చెను మనల ఉచితముగ",
        "అపాత్రులమైయున్న మనకు - ప్రాయశ్చిత్తము కలిగెనుగ"
      ],
      "english": [
        "Krupadhvaaraane neethi manthulugaa - Theerchenu manala uchithamuga",
        "Apaathrulamaiyunna manaku - Praayashchitthamu kaligenuga"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కృపయే మనకు బయలు పడెను - సమస్తమును భోధించును",
        "అపవిత్ర క్రియలన్నియు విడచి - భయభక్తులతో బ్రతికెదము"
      ],
      "english": [
        "Krupaye manaku bayalu padenu - Samasthamunu bhodhinchunu",
        "Apavithra kriyalanniyu vidachi - Bhayabhakthulatho brathikedhamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "కృపద్వారానే బలవంతులమై - ఎదురుకొనెదము యుద్ధమును",
        "ప్రభువునందు అంత మువరకు - స్థిరముగ ముందుకుసాగెదము"
      ],
      "english": [
        "Krupadhvaaraane balavanthulamai - Edhurukonedhamu yuddhamunu",
        "Prabhuvunandhu antha muvaraku - Sthiramuga mundhukusaagedhamu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "కృపద్వారానే సమీపించితిమి - దానియందే నిలిచితిమి",
        "క్రీస్తు మహిమ నిరీక్షణకై - ఆయనకే స్తుతి పాడెదము"
      ],
      "english": [
        "Krupadhvaaraane sameepinchithimi - Dhaaniyandhe nilichithimi",
        "Kreesthu mahima nireekshanakai - Aayanake sthuthi paadedamu"
      ]
    }
  ]
}
