  },
  "main_stanza": {
    "telugu": [
      "శ్రేష్టగీతము వినబడుచున్నది యేసు లేచెను",
      "ఈ కష్టలోకమందు మనకు మిత్రు - డాయనే"
    ],
    "english": [
      "Shraeshtageethamu Vinabaduchunnadhi Yaesu Laechenu",
      "Ee Kashtaloakamandhu Manaku Mithru - Daayanae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మాయక్షితిని రక్షింప వచ్చిన పరమ నాయకుడు",
        "ఈభయంకర చీకటి పోగొట్ట వచ్చిన ప్రభువు"
      ],
      "english": [
