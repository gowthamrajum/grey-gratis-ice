{
  "song_name": "Dhyaanimpa Nae Chiththamaa",
  "author": {
    "Authored by": "",
    "రచన": "పులిపాక జగన్నాధము"
  },
  "main_stanza": {
    "telugu": [
      "ధ్యానింప నే చిత్తమా వర్షాంతమున ధ్యానింపనే చిత్తమా",
      "ధ్యానించ వాసక్తి జ్ఞానంబుఁ గలిగించు",
      "జ్ఞాన స్వరూపుఁడు జ్ఞానాత్మచే నీకు"
    ],
    "english": [
      "Dhyaanimpa Nae Chiththamaa Varshaanthamuna Dhyaanimpanae Chiththamaa",
      "Dhyaanincha Vaasakthi Jnyaanambu Galiginchu",
      "Jnyaana Svaroopudu Jnyaanaathmachae Neeku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అరయ నీ తలఁపుల నఘము లగుపడు నీకుఁ",
        "పరిశుద్ధుఁ డీక్షింప బహుగా గనుపడుచుండు"
      ],
      "english": [
        "Araya Nee Thalapula Naghamu Lagupadu Neeku",
        "Parishudhdhu Deekshimpa Bahugaa Ganupaduchundu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరికింపఁ బలుకులఁ పాప మగుపడు నీకు",
        "పరిశుద్ధుఁ డరయుఁ గ న్పడకుండు నే యది"
      ],
      "english": [
        "Parikimpa Balukula Paapa Magupadu Neeku",
        "Parishudhdhu Darayu Ga Npadakundu Nae Yadhi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రియలను జింతింప మయిల గనపడు గాన",
        "భయ మొంది నమ్మికను బదవే క్రీస్తుని దరికి"
      ],
      "english": [
        "Kriyalanu Jinthimpa Mayila Ganapadu Gaana",
        "Bhaya Mondhi Nammikanu Badhavae Kreesthuni Dhariki"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దేవుని ఘన ప్రేమ దినదినముఁ దలపోయ",
        "నీవు పొందఁగ వచ్చు నిక్కమైన శుద్ధి"
      ],
      "english": [
        "Dhaevuni Ghana Praema Dhinadhinamu Dhalapoaya",
        "Neevu Pondaga Vachchu Nikkamaina Shudhdhi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "స్మరియింప నీలోన వర రక్షకుని పాట్లు",
        "భరియింప నోపుదువె పాప మొక నిమిషంబు"
      ],
      "english": [
        "Smariyimpa Neeloana Vara Rakshakuni Paatlu",
        "Bhariyimpa Noapudhuve Paapa Moka Nimishambu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "హృదయంబు విమలాత్మ సదనంబుఁ గావింపఁ",
        "పదవే శ్రీఘ్రంబుగఁ పరమ జనకుని కడకు"
      ],
      "english": [
        "Hrudhayambu Vimalaathma Sadhanambu Gaavimpa",
        "Padhavae Shreeghrambuga Parama Janakuni Kadaku"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దేవుని సేవింపఁ దిరముగ నాశించి",
        "దేవాత్మ కొర కీవు దినము దేవుని వేఁడ"
      ],
      "english": [
        "Dhaevuni Saevimpa Dhiramuga Naashinchi",
        "Dhaevaathma Kora Keevu Dhinamu Dhaevuni Vaeda"
      ]
    }
  ]
}
