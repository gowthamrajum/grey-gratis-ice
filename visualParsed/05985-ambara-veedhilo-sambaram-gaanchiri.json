{
  "song_name": "Ambara veedhilo sambaram gaanchiri",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "అంబర వీధిలో – సంబరం గాంచిరి",
      "కొందరు గొల్లలు – తొందరగ వెళ్లిరి//2//"
    ],
    "english": [
      "Ambara veedhilo – Sambaram gaanchiri",
      "Kondaru gollalu – Thondharaga velliri//2//"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బెత్లెమను యూరిలో – సత్రమున శాలలో",
        "పశువుల తొట్టిలో – ప్రభు యేసుడు పుట్టెను//2//"
      ],
      "english": [
        "Bethlemanu oorilo – Sathramuna shaalalo",
        "Pashuvula thottilo – Prabhu Yesudu puttenu//2//"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తూర్పుతారను గాంచిరి – మరిజ్ఞానులు వచ్చిరి",
        "తమ కానుకల్ తెచ్చిరి – మన యేసు కర్పించిరి//2//"
      ],
      "english": [
        "Thoorputhaaranu gaanchiri – Mari jnaanulu vachchiri",
        "Thama kaanukal thechchiri – Mana Yesuku arpinchiri//2//"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇక చింతను వీడుము – గురి యొద్దకు చూడుము",
        "మరి అంతము రానగున్ – యేసు చెంతకు చేరుము//2//"
      ],
      "english": [
        "Ika chinthanu veedumu – Guri yoddaku choodumu",
        "Mari anthamu raanagun – Yesu chenthaku cherumu//2//"
      ]
    }
  ]
}
