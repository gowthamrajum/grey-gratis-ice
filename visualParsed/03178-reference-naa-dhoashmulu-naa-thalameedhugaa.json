{
  "song_name": "Naa doshamulu naa thalameedhugaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవా నీ కోపము చేత - గద్దింపకుము - ఆ",
        "నీదు యుగ్రతచే నన్ను - శిక్షింపకుము"
      ],
      "english": [
        "Yehovaa nee kopamu chetha - Gaddhimpakumu - Aa",
        "Needu yugrathache nannu - Shikshimpakumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాలో గట్టిగా నీ బాణములు - నాటి యున్నవి - ఆ",
        "నా మీద నీ చెయ్యి భార - ముగా నున్నది"
      ],
      "english": [
        "Naalo gattigaa nee baanamulu - Naati yunnavi - Aa",
        "Naa meeda nee cheyyi bhaara - Mugaa nunnadhi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ కోపముచే నా యారోగ్యము - విడిచిపోయెను - ఆ",
        "పాపముచే నా యెముకలలో - స్వస్థత లేదు"
      ],
      "english": [
        "Nee kopamuche naa yaarogyamu - Vidichipoyenu - Aa",
        "Paapamuche naa emukalalo - Swasthatha ledu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా దోషములు నా తలమీద - పొర్లిపోయినవి - ఆ",
        "నాపై మోయలేని బరువు - వలె నున్నవి"
      ],
      "english": [
        "Naa doshamulu naa thalameedha - Porlipoyinavi - Aa",
        "Naapai moyaleni baruvu - Vale nunnavi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మనోవేదన బట్టి కేకలు - వేయుచున్నాను - ఆ",
        "కనబడుచున్నది నీకు నా యభి - లాషయంతయు"
      ],
      "english": [
        "Manovedhana batti kekalu - Veyuchunnaanu - Aa",
        "Kanabaduchunnadhi neeku naa yabhi - Laashayanthayu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నా నిట్టూర్పులు నీకు దాచ - బడియుండలేదు - ఆ",
        "నా గుండె కొట్టుకొని బలము - విడచిపోయెను"
      ],
      "english": [
        "Naa nittoorpulu neeku dhaacha - Badiyundaledhu - Aa",
        "Naa gunde kottukoni balamu - Vidachipoyenu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నా దోషమును నేను ఒప్పుకొనుచున్నాను - ఆ",
        "నా పాపమును గూర్చి విచారపడుచున్నాను"
      ],
      "english": [
        "Naa dhoshamunu nenu oppukonuchunnaanu - Aa",
        "Naa paapamunu goorchi vichaarapaduchunnaanu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నా శత్రువులు చురుకై బలము - కలిగిన వారు - ఆ",
        "నన్నుచితముగా ద్వేషించు వారు అనేకులు"
      ],
      "english": [
        "Naa shathruvulu churukai balamu - Kaligina vaaru - Aa",
        "Nannuchithamugaa dhveshinchu vaaru anekulu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "మేలుకు ప్రతిగా వారు - కీడు - చేయుచున్నారు - ఆ",
        "మేలు చేసినందుకు వారు - విరోధులైరి"
      ],
      "english": [
        "Meluku prathigaa vaaru - Keedu - Cheyuchunnaaru - Aa",
        "Melu chesinandhuku vaaru - Virodhulairi"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "దేవా నాకు దూరముగా - నుండకుము ప్రభో - ఆ",
        "రక్షకా నా సహాయమునకు - వేగమే రమ్ము"
      ],
      "english": [
        "Devaa naaku dooramugaa - Nundakumu Prabho - Aa",
        "Rakshakaa naa sahaayamunaku - Vegame rammu"
      ]
    }
  ]
}
