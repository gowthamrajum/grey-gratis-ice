{
  "song_name": "Uthsaha Gaanam",
  "author": {
    "Authored by": "Merlyn Salvadi, Kenny Salvadi & Blessy Simon",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతించుడి యెహోవా నామమును",
      "కీర్తించుడి యెహోవా నామమును",
      "ఘనపరచుడి యెహోవా నామమును",
      "ఉత్సాహగానముతో"
    ],
    "english": [
      "Sthuthinchudi Yehovah naamamunu",
      "keerthinchudi Yehovah naamamunu",
      "ghanaparachudi Yehovah naamaamunu",
      "uthsaahagaanamutho"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సంతోష గానముతో యెహోవాను సేవించుడి",
        "ఉత్సాహ ధ్వనితో యెహోవాను సేవించుడి",
        "కీర్తనలు పాడుచు యెహోవాను సేవించుడి",
        "వాయిద్యాలు వాయించుచు యెహోవాను సేవించుడి"
      ],
      "english": [
        "Santhosha gaanamutho Yehovaanu sevinchudi",
        "uthsaaha dhwanitho Yehovaanu sevinchudi",
        "keerthanalu paaduchu Yehovaanu sevinchudi",
        "vaayidhyaalu vaayinchuchu Yehovaanu sevinchudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నూతన గానముతో యెహోవాను సేవించుడి",
        "ఆనంద స్వరములతో యెహోవాను సేవించుడి",
        "కృతజ్ఞత అర్పణలతో యెహోవాను సేవించుడి",
        "పూర్ణ హృదయాలతో యెహోవాను సేవించుడి"
      ],
      "english": [
        "Noothana gaanamutho Yehovaanu sevinchudi",
        "ananda svaramulatho Yehovaanu sevinchudi",
        "kruthagnyatha arpanalatho Yehovaanu sevinchudi",
        "poorna hrudayaalatho Yehovaanu sevinchudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "Bridge:",
        "చాటించుడి యెహోవా నామమును",
        "ధ్యానించుడి యెహోవా నామమును",
        "స్తోత్రించుడి యెహోవా నామమును",
        "ఆరాధించుడి యెహోవా నామమును"
      ],
      "english": [
        "Bridge:",
        "Chaatinchudi Yehovah naamamunu",
        "dhyaaninchudi Yehovah naamamunu",
        "sthothrinchudi Yehovah naamamunu",
        "aaradhinchudi Yehovah naamamunu"
      ]
    }
  ]
}
