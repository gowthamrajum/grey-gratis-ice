  "main_stanza": {
    "telugu": [
      "నీకు నీవుగా నన్ను చూడగా",
      "పరమునుండి దిగివచ్చినావయ్యా",
      "నాపై ఇంతగా ప్రేమ చూపగ",
      "నేనెంతటివాడను యేసయ్యా",
      "పండుగ ఇది క్రిస్మస్ పండుగ",
      "గుండెల నిండుగ ఆనందం పండెగా",
      "శాపదోషమును పరిహరించగ",
      "దీనుడై దిగివచ్చినావయ్యా",
      "పాడైపోయిన నా స్థితి మార్చగ",
      "శరీరాన్ని దాల్చుకున్న యేసయ్యా",
      "నిత్యజీవమును అనుగ్రహించగ",
      "దాసుడై దిగివచ్చినావయ్యా",
      "తండ్రి ఇంటికి దారిని చూపగ",
      "ప్రభావాన్ని వదులుకున్న యేసయ్యా",
      "పాపలోకమును కనికరించగ",
      "బాలుడై దిగివచ్చినావయ్యా",
      "మంటివానితో స్నేహము చేయగ",
      "స్వరూపాన్ని మార్చుకున్న యేసయ్యా"
    ],
