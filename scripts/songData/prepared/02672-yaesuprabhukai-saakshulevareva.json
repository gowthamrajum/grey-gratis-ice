{
  "song_name": "Yaesuprabhukai Saakshulevarevaroa",
  "author": {
    "Authored by": "",
    "రచన": "చెట్టి భానుమూర్తి"
  },
  "main_stanza": {
    "telugu": [
      "యేసుప్రభుకై సాక్షులెవరెవరో ఎవ్వరెవ్వరో యని యాశతో",
      "ప్రభు వడుగుచున్నాడు యేసు కొరకై నిల్చి",
      "క్రైస్తవ యువకులెల్లరు సాక్ష్యమిచ్చుచు భాసురంబుగ",
      "క్రీస్తు నెంతో భారతీయులు ప్రస్తుతించరో"
    ],
    "english": [
      "Yaesuprabhukai Saakshulevarevaroa Evvarevvaroa Yani Yaashathoa",
      "Prabhu Vaduguchunnaadu Yaesu Korakai Nilchi",
      "Kraisthava Yuvakulellaru Saakshyamichchuchu Bhaasurambuga",
      "Kreesthu Nenthoa Bhaaratheeyulu Prasthuthincharoa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవదర్శన మొంది లేలెండి ధనజనులకెల్లను",
        "దైవ ప్రేమను గూర్చి దెలుపండీ",
        "పావనుండగు ప్రభుని బోధలు పాడి రక్షణ మార్గమెల్లను",
        "సావధానముతోడ దెల్పరే సౌలు మారి పౌలెటాయెనో"
      ],
      "english": [
        "Dhaevadharshana Mondhi Laelendi Dhanajanulakellanu",
        "Dhaiva Praemanu Goorchi Dhelupandee",
        "Paavanundagu Prabhuni Boadhalu Paadi Rakshana Maargamellanu",
        "Saavadhaanamuthoada Dhelparae Saulu Maari Pauletaayenoa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రాయబారుల మంచు నమ్మండి రారాజు వార్తలు",
        "రేయిబవలును దెలుప లేలెండీ పాయకుండగ",
        "యేసు తన విమ లాత్మ నెప్పుడు తోడ నుంచును",
        "పాపులెల్లరు యేసు ప్రభుని పాదములు సేవించి బ్రతుకగ"
      ],
      "english": [
        "Raayabaarula Manchu Nammandi Raaraaju Vaarthalu",
        "Raeyibavalunu Dhelupa Laelendee Paayakundaga",
        "Yaesu Thana Vima Laathma Neppudu Thoada Nunchunu",
        "Paapulellaru Yaesu Prabhuni Paadhamulu Saevinchi Brathukaga"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "థీరులై శుభవార్త జాటండీ దినదినము",
        "వాక్య ప్రచారమెల్లను చేయ లేలెండీ",
        "చేయవలసిన దెల్ల ప్రభువే చేయు మీతో నాత్మరూపున",
        "జయము మీదను జయమునిచ్చి జగతిని దగ వెలుగ జేయగ"
      ],
      "english": [
        "Theerulai Shubhavaartha Jaatandee Dhinadhinamu",
        "Vaakya Prachaaramellanu Chaeya Laelendee",
        "Chaeyavalasina Dhella Prabhuvae Chaeyu Meethoa Naathmaroopuna",
        "Jayamu Meedhanu Jayamunichchi Jagathini Dhaga Veluga Jaeyaga"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పౌలు మాదిరి బోలి లేలెండీ",
        "పరలోక రాజ్య ప్రచారమెల్లను జేయలేలెండీ",
        "పలువిధంబుల శ్రమలకోర్చి ప్రభువు శత్రుల నెల్ల మాడ్చి",
        "సిలువ ధ్వజమును చేతబట్టి సుస్థిరంబగు సేవ జేయగ"
      ],
      "english": [
        "Paulu Maadhiri Boali Laelendee",
        "Paraloaka Raajya Prachaaramellanu Jaeyalaelendee",
        "Paluvidhambula Shramalakoarchi Prabhuvu Shathrula Nella Maadchi",
        "Siluva Dhvajamunu Chaethabatti Susthirambagu Saeva Jaeyaga"
      ]
    }
  ]
}
