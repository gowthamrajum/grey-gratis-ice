  "main_stanza": {
    "telugu": [
      "నాకై యేసు కట్టెను సుందరము బంగారిల్లు",
      "కన్నీరును కలతలు లేవు – యుగయుగముల పరమానందం"
    ],
    "english": [
      "Naakai Yesu kattenu sundharamu bangaarillu",
      "Kanneerunu kalathalu levu – Yugayugamula paramaanandham"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సుర్యచంద్రులుండరు – రాత్రింపగలందుండవు  ||నాకై||",
        "ప్రభు యేసే ప్రకాశించున్ – ఆ వెలుగులో నేను నడచెదను"
      ],
      "english": [
        "Sooryachandhrulundaru – Raathrimpagalandundavu  ||Naakai||",
        "Prabhu Yese prakaashinchun – Aa velugulo nenu nadachedhanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జీవ వృక్షమందుండు – జీవ మకుటమందుండు",
        "ఆకలి లేదు దాహము లేదు – తిని త్రాగుట అందుండదు  ||నాకై||"
      ],
      "english": [
        "Jeeva vrukshamandundu – Jeeva makutamandundu",
        "Aakali ledu daahamu ledu – Thini thraaguta andundadhu  ||Naakai||"
      ]
    }
  ]
