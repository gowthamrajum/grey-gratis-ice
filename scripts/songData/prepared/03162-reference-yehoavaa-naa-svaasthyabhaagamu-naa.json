  "main_stanza": {
    "telugu": [
      "Reference: యెహోవా నా స్వాస్థ్యభాగము నా పానీయ భాగము నీవే.",
      "కీర్తన Psalm 16:3-11",
      "స్తుతింతున్ స్తుతింతున్ - నాకాలోచన కర్తయగు దేవుని",
      "రాత్రివేలలో నా - అంతరింద్రియములు నాకు నేర్పున్"
    ],
    "english": [
      "Reference: Yehoavaa Naa Svaasthyabhaagamu Naa Paaneeya Bhaagamu Neevae.",
      "Keerthana Psalm 16:3-11",
      "Sthuthinthun Sthuthinthun - Naakaaloachana Karthayagu Dhaevuni",
      "Raathrivaelaloa Naa - Antharindhriyamulu Naaku Naerpun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాదు స్వాస్థ్య పానీయ భాగము - నా యెహోవా నీవే కాపాడెదవు",
        "మనోహర స్థలములలో పాలుకల్గెను"
      ],
      "english": [
        "Naadhu Svaasthya Paaneeya Bhaagamu - Naa Yehoavaa Neevae Kaapaadedhavu",
        "Manoahara Sthalamulaloa Paalukalgenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శ్రేష్టమైన స్వాస్థ్యము నాకు కల్గెను - సదాకాలము",
        "యెహోవాయందు నాగురిని నిల్పుచున్నాను గాన నేను"
      ],
      "english": [
        "Shraeshtamaina Svaasthyamu Naaku Kalgenu - Sadhaakaalamu",
        "Yehoavaayandhu Naagurini Nilpuchunnaanu Gaana Naenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా కుడి పార్శ్వమందాయన యున్నాడు - గాన కదల్చబడలేను ఎన్నడు",
        "అందుచేత నా హృదయ మానిందించును"
      ],
      "english": [
        "Naa Kudi Paarshvamandhaayana Yunnaadu - Gaana Kadhalchabadalaenu Ennadu",
        "Andhuchaetha Naa Hrudhaya Maanindhinchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా శరీరము సురక్షితంబుగా - నివసించుచున్నది ఏలననగా",
        "నీ పరిశుద్ధుని కుళ్ళు పట్టనియ్యవు"
      ],
      "english": [
        "Naa Shareeramu Surakshithambugaa - Nivasinchuchunnadhi Aelananagaa",
        "Nee Parishudhdhuni Kullu Pattaniyyavu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జీవముగల నీ మార్గమును - నీవు నాకిల తెలియ జేసెదవు",
        "నీవే నా క్షేమాధారమని నిన్ను"
      ],
      "english": [
        "Jeevamugala Nee Maargamunu - Neevu Naakila Theliya Jaesedhavu",
        "Neevae Naa Kshaemaadhaaramani Ninnu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సర్వోన్నతుడా నీ సన్నిధిలో - సంపూర్ణ సంతోష మెంతో గలదు",
        "నీ కుడిచేతిలో నిత్యసుఖములు గలవు"
      ],
      "english": [
        "Sarvoannathudaa Nee Sannidhiloa - Sampoorna Santhoasha Menthoa Galadhu",
        "Nee Kudichaethiloa Nithyasukhamulu Galavu"
      ]
    }
  ]
