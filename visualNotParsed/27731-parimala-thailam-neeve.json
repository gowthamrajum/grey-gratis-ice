  "main_stanza": {
    "telugu": [
      "పరిమళతైలం నీవే",
      "తరగని సంతోషం నీలో",
      "జీవన మకరందం నీవే",
      "తియ్యని సంగీతం నీవే",
      "అ. ప:",
      "తరతరములలో నీవే",
      "నిత్యసంకల్ప సారధి నీవే",
      "జగములనేలే రాజా",
      "నా ప్రేమకు హేతువు నీవే",
      "ఉరుముతున్న మెరుపులవంటి",
      "తరుముచున్న శోధనలో",
      "నేనున్నా నీతో అంటూ నీవే",
      "నాతో నిలిచినావు",
      "క్షణమైనా విడువక ఔదార్యమును",
      "నాపై చూపినావు",
      "నీ మనసే అతి మధురం",
      "అది నా సొంతమే..",
      "చీల్చబడిన బండనుండి నా",
      "కొదువ తీర్చి నడిపితివి",
      "నిలువరమగు ఆత్మ శక్తితో",
      "కొరతలేని ఫలములతో",
      "నను నీ రాజ్యమునకు పాత్రుని",
      "చేయ ఏర్పరచుకొంటివి",
      "నీ స్వాస్థ్యములోనే చేరుటకై",
      "అభిషేకించినావు",
      "నీ మహిమార్ధం వాడబడే",
      "నీ పాత్రను నేను..",
      "వేచియున్న కనులకు నీవు",
      "కనువిందే చేస్తావని",
      "సిద్ధపడిన రాజుగా నీవు",
      "నాకోసం వస్తావని",
      "నిను చూచిన వేళ నాలో ప్రాణం",
      "ఉద్వేగభరితమై",
      "నీ కౌగిట ఒదిగి ఆనందముతో",
      "నీలో మమేకమై",
      "యుగయుగములలో నీతో",
      "నేను నిలిచిపోదును"
