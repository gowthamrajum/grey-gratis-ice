{
  "song_name": "Varudu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రియుడా నా వరుడా",
      "ప్రేమికుడా పెండ్లి కుమారుడా"
    ],
    "english": [
      "priyuda naa varudaa",
      "premikuda pendli kumaaruda"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రియుడా ప్రాణ నాదుడా",
        "పది కోట్లలో అతి సుందరుడా",
        "దవళ వర్ణుడా రత్న వర్ణుడా",
        "కోటి సుర్యుల కన్న తేజోమయుడా"
      ],
      "english": [
        "naa priyuda praana naadhuda",
        "padhi kotlalo athi sundaruda",
        "davala varnuda rathna varnuda",
        "koti suryula kanna thejomayuda"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ వాక్యముతో నన్ను కడుగుము",
        "నిర్దోషముగా నిలబెట్టుము",
        "పరిశుద్దముగా మహిమ గలిగిన",
        "నీ వదువుగా సిద్దపరచుము"
      ],
      "english": [
        "nee vaakyamutho nannu kadugumu",
        "nirdoshamuga nilabettumu",
        "parisuddamuga mahima galigina",
        "nee vaduvugaa siddaparachumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "Bridge:",
        "నీవు నాకయ్య నేను నీకయ్య",
        "నీ సన్నిదియే నాకు శ్వాసయ్య"
      ],
      "english": [
        "Bridge:",
        "neevu naakayya nenu neekayya",
        "nee sannidiye naaku swaasayya"
      ]
    }
  ]
}
