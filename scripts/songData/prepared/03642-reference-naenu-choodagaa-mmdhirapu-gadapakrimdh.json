{
  "song_name": "JeevaMpu Jalanadhulu Uchitha Jeevanadhi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జీవంపు జలనదులు - ఉచిత జీవనది",
      "రక్షకా నీ నుండి పారున్ - నాద్వారా పారనిమ్ము"
    ],
    "english": [
      "JeevaMpu Jalanadhulu - Uchitha Jeevanadhi",
      "RakShakaa Nee NuMdi Paarun - Naadhvaaraa Paaranimmu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గద్దియలో నుండి పారు - జీవపు నదినీరు",
        "ఆశీర్వాదముతో నిండి - యేసు నుండి వచ్చును"
      ],
      "english": [
        "Gadhdhiyaloa NuMdi Paaru - Jeevapu Nadhineeru",
        "Aasheervaadhamuthoa NiMdi - Yaesu NuMdi Vachchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రక్షకా నన్ను శుద్ధీకరింపుము - కాల్వగా మార్చునన్ను",
        "ఖాళీగా చేసి నన్ నింపి - లోబడుటకు నేర్పుము"
      ],
      "english": [
        "RakShakaa Nannu ShudhDheekariMpumu - Kaalvagaa Maarchunannu",
        "KhaaLeegaa Chaesi Nan NiMpi - Loabadutaku Naerpumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అప్పుడే యేసు ప్రభువా - నాలో నదుల్ పారును",
        "అట్టుల నితరులు నీ - పూర్ణత నెరుగుదురు"
      ],
      "english": [
        "Appudae Yaesu Prabhuvaa - Naaloa Nadhul Paarunu",
        "Attula Nitharulu Nee - PoorNatha Nerugudhuru"
      ]
    }
  ]
}
