{
  "song_name": "Entha Praeminchenoa Dhaevudu Manapai",
  "author": {
    "Authored by": "",
    "రచన": "చదలవాడ జకర్యా"
  },
  "main_stanza": {
    "telugu": [
      "ఎంత ప్రేమించెనో దేవుఁడు మనపై నెంతదయఁజూపెనో",
      "వింతగల యీ దైవప్రేమను సాంతమున ధ్యానింపరే"
    ],
    "english": [
      "Entha Praeminchenoa Dhaevudu Manapai Nenthadhayajoopenoa",
      "Vinthagala Yee Dhaivapraemanu Saanthamuna Dhyaanimparae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పనికిమాలిన పాపాత్ములమైన మనము ఆ ఘనదేవునికి",
        "పిల్లలమనబడుటకై తన కుమారుని మరణ బలిరక్తమున",
        "మన లను స్వీకరించుకొనెను దీనిని జూడరే"
      ],
      "english": [
        "Panikimaalina Paapaathmulamaina Manamu Aa Ghanadhaevuniki",
        "Pillalamanabadutakai Thana Kumaaruni Marana Balirakthamuna",
        "Mana Lanu Sveekarinchukonenu Dheenini Joodarae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పెంటకుప్పమీఁద పడియున్న యీ నీచ మంటి పురుగులను",
        "లేవనేత్తి మింటిపై ఘనులతోఁ గూర్చుండఁజేయ",
        "నీ మంటి కేతెంచె మన వంటి దేహము దాల్చి"
      ],
      "english": [
        "Pentakuppameedha Padiyunna Yee Neecha Manti Purugulanu",
        "Laevanaeththi Mintipai Ghanulathoa Goorchundajaeya",
        "Nee Manti Kaethenche Mana Vanti Dhaehamu Dhaalchi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ద్రాక్షారసపు మధురమును మించి యీ ప్రేమ",
        "సాక్షాత్తుగా మనపయినుండగా ఈ క్షితినా ప్రేమ",
        "ద్రాక్షారసముకంటె దీక్షగవేడి యపేక్షింపతగునాహా"
      ],
      "english": [
        "Dhraakshaarasapu Madhuramunu Minchi Yee Praema",
        "Saakshaaththugaa Manapayinundagaa Ee Kshithinaa Praema",
        "Dhraakshaarasamukante Dheekshagavaedi Yapaekshimpathagunaahaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనలను ప్రేమించి తన ప్రాణమిచ్చిన ఘనుఁడా",
        "కాశమునుండి మరలి వచ్చి మన దైన్యదేహమును",
        "తనరూపమును మార్చి కొనిపోయి తన రాజ్యమును మనకీయును"
      ],
      "english": [
        "Manalanu Praeminchi Thana Praanamichchina Ghanudaa",
        "Kaashamunundi Marali Vachchi Mana Dhainyadhaehamunu",
        "Thanaroopamunu Maarchi Konipoayi Thana Raajyamunu Manakeeyunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "గట్టిగ మనమునం దిట్టి నిరీక్షణ పెట్టియున్న",
        "సత్ క్రైస్తవులూ ప్రభు డెట్టివాఁడొ మనమునట్టి వారుగ",
        "ప్రభుని కట్టడలను మదిని బెట్టియుందము వేడ్క"
      ],
      "english": [
        "Gattiga Manamunam Dhitti Nireekshana Pettiyunna",
        "Sath Kraisthavuloo Prabhu Dettivaado Manamunatti Vaaruga",
        "Prabhuni Kattadalanu Madhini Bettiyundhamu Vaedka"
      ]
    }
  ]
}
