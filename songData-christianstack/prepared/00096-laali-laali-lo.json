  "main_stanza": {
    "telugu": [
      "హల్లెలూయా అని పాడుచు",
      "యేసు రాజునకు స్తుతులు అర్పించెదం",
      "దావీదు కుమారునికి జయము",
      "సర్వోన్నత స్థలములో జయము"
    ],
    "english": [
      "Halleluyaa ani paaduchu",
      "yesu raajunaku sthutulu arpinchedham",
      "dhaaveedhu kumaaruniki jayamu",
      "sarvonnatha sthalamulo jayamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
