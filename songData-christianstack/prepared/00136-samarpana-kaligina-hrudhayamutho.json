  "main_stanza": {
    "telugu": [
      "సమర్పణ కలిగిన హృదయముతో",
      "దేవా నిన్ను సేవించెదను",
      "లోకము లోక ఆశలు విడచి",
      "నేను నిన్ను వెంబడించెదను"
    ],
    "english": [
      "Samarpana kaligina hrudayamuto",
      "Devaa ninnu sevinchedanu",
      "Lokamu loka aashalu vidachi",
      "Nenu ninnu vembadinchedanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసయ్య నా యేసయ్య",
        "యేసయ్య నా యేసయ్య"
      ],
      "english": [
        "Yesayya naa Yesayya",
        "Yesayya naa Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా శ్రమలలో నేను నీకు మొరపెట్టగా",
        "నను ఆదరించితివి",
        "కన్నీటి దుఃఖములో నిన్ను ఆశ్రయించగా",
        "నా తోడు నిలచితివి",
        "నను ప్రేమించి క్షమించి",
        "నను హత్తుకుంటివి"
      ],
      "english": [
        "Naa shramalalo nenu neeku morapettaga",
        "Nannu aadharinchitivi",
        "Kanneeti duhkhamulo ninnu aashrayinchaga",
        "Naa thodu nilachhitivi",
        "Nannu preminchi kshaminchi",
        "Nannu hattukuntivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నను హత్తుకుంటివి…"
      ],
      "english": [
        "Nannu hattukuntivi…"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
