{
  "song_name": "Phaliyinchuta Nerpayya",
  "author": {
    "Authored by": "Pas. Daniel Raj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఫలియించుట నేర్పయ్య నా యేసయ్యా",
      "నీ నది తీరమున ఫలియించుట నేర్పయ్యా",
      "నీ మందిరమున నివసించుట నేర్పయ్యా",
      "నీ సన్నిధానమున వసియించుట నేర్పయ్యా",
      "నీతో కలకాలం ఉండే భాగ్యం నాకు ఇవ్వయ్యా"
    ],
    "english": [
      "Yoosepu vale paapamu vaddhani",
      "dhushkaaryamulu naaku chendhavani",
      "neethivanthamaina jeevithamu naaku ivvayyaa",
      "parishuddhamaina jeevitham naaku ivvayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యోసేపు వలె పాపము వద్దని",
        "దుష్కార్యములు నాకు చెందవని",
        "నీతివంతమైన జీవితము నాకు ఇవ్వయ్యా",
        "పరిశుద్ధమైన జీవితం నాకు ఇవ్వయ్యా"
      ],
      "english": [
        "Preminchuta nerpayya naa yesayyaa",
        "sathruvunainaa preminchut nerpayyaa",
        "bandhuvulandharini preminchuta nerpayyaa",
        "raktha sambandhulunu preminchuta nerpayyaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రేమించుట నేర్పయ్య నా యేసయ్యా",
        "శత్రువునైనా ప్రేమించుట నేర్పయ్యా",
        "బంధువులందరిని ప్రేమించుట నేర్పయ్యా",
        "రక్త సంబంధులును ప్రేమించుట నేర్పయ్యా",
        "అందరి కన్నా నిను ప్రేమించే మనసు ఇవ్వయ్యా"
      ],
      "english": [
        "Yoosepu vale bhaadhimpabadina kshamiyinche manasu naaku ivvayyaa",
        "dhaiva premathoo hatthukune manasu ivvayyaa",
        "hrudhyaanni aadhrinche maatalu naaku nerpayyaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యోసేపు వలె భాధింపబడిన క్షమియించే మనసు నాకు ఇవ్వయ్యా",
        "దైవ ప్రేమతో హత్తుకునే మనసు ఇవ్వయ్యా",
        "హృదయాన్ని ఆదరించే మాటలు నాకు నేర్పయ్యా"
      ],
      "english": []
    }
  ]
}
