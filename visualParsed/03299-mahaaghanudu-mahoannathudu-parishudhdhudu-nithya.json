        "అయినను - సత్యము జీవము",
        "సంతోషమును ఐశ్వర్యముల్ పొందితిమి"
      ],
      "english": [
        "Mosamu shikshayu duhkhamunu",
        "Dharidratha kaligiyunnaamu",
        "Ayinanu - Sathyamu jeevamu",
        "Santhoshamunu aishwaryamul pondithimi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పడిపోయి మేముంటిమి",
        "అంధకారమందుంటిమిగా",
        "అయినను - తిరిగి లేతుము",
        "యెహోవాయే మా వెలుగు మా రక్షణ"
      ],
      "english": [
        "Padipoyi memuntimi",
        "Andhakaaramandhuntimigaa",
        "Ayinanu - Thirigi lethumu",
        "Yehovaaye maa velugu maa rakshana"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మన క్రీస్తును బట్టి యెల్లప్పుడు",
        "నిందకు పాత్రులమైతిమి",
        "అయినను - ఎల్లప్పుడు వూరేగించును",
        "మమ్ము విజయముతో స్తోత్రములు"
      ],
      "english": [
        "Mana Kreesthunu batti ellappudu",
        "Nindhaku paathrulamaithimi",
        "Ayinanu - Ellappudu vooreginchunu",
        "Mammu vijayamutho sthothramulu"
      ]
