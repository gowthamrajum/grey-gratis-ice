{
  "song_name": "Unnathamaina Rajyapu Vasi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఉన్నతమైన రాజ్యపువాసీ యేసయ్యా ఆ మహిమను విడిచావా",
      "ఎన్నికలేని పాపిని నాకై యేసయ్యా ఈ ధరణికి వచ్చావా",
      "నీ జన్మ మనుజాలిపంట - సాతనుకే చితిమంట",
      "నా జీవితమంతా నీ ప్రేమగీతి పాడుకుంటా"
    ],
    "english": [
      "Unnathamaina Raajyapuvaasee Yesayyaa Aa Mahimanu Vidichaavaa",
      "Ennikaleni Paapini Naakai Yesayyaa Ee Dharaniki Vachchaavaa",
      "Nee Janma Manujaalipanta - Saathanuke Chithimanta",
      "Naa Jeevithamanthaa Nee Premageethi Paadukuntaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మంచివారినే ప్రేమించుట మాకిలలో సాధ్యము కాదే",
        "మంచికార్యములు చేయు స్వభావము మాలోపల కానరాదే",
        "మంచితనమన్నదే లేని వంచకుని కరుణించావా",
        "మహిమను విడిచావా - ధరణికి వచ్చావా"
      ],
      "english": [
        "Manchivaarine Preminchuta Maakilalo Saadhyamu Kaadhe",
        "Manchikaaryamulu Cheyu Swabhaavamu Maalopala Kaanaraadhe",
        "Manchithanamannadhe Leni Vanchakuni Karuninchaavaa",
        "Mahimanu Vidichaavaa - Dharaniki Vachchaavaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రాణప్రదముగా ప్రేమించిన తన మిత్రుని కొరకైనా",
        "ప్రాణము నిచ్చెడు వారిని ఇలలో ఎచటా కనుగొనలేమే",
        "గుణహీనుడైన మానవుని ఋణము చెల్లింపదలిచావా",
        "మహిమను విడిచావా - ధరణికి వచ్చావా"
      ],
      "english": [
        "Praanapradhamugaa Preminchina Thana Mithruni Korakainaa",
        "Praanamu Nichchedu Vaarini Ilalo Echataa Kanugonaleme",
        "Gunaheenudaina Maanavuni Runamu Chellimpadhalichaavaa",
        "Mahimanu Vidichaavaa - Dharaniki Vachchaavaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పొరుగువాడు కలిగున్నదానినే ఆశించుటయే తప్ప",
        "ఇరుగుపొరుగులకు అక్కరలో సహాయము చేయగలేమే",
        "పురుగువంటి నరమాత్రునికి కరుణతో సర్వమిచ్చావా",
        "మహిమను విడిచావా - ధరణికి వచ్చావా"
      ],
      "english": [
        "Poruguvaadu Kaligunnadhaanine Aashinchutaye Thappa",
        "Iruguporugulaku Akkaralo Sahaayamu Cheyagaleme",
        "Puruguvanti Naramaathruniki Karunatho Sarvamichchaavaa",
        "Mahimanu Vidichaavaa - Dharaniki Vachchaavaa"
      ]
    }
  ]
}
