{
  "song_name": "Premaamrutha dhaarala chindina mana - Yesuku samamevaru?",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమామృత ధారల చిందిన మన - యేసుకు సమమెవరు?",
        "ప్రేమయె తానై నిలచి - ప్రేమోక్తులనె పల్కి",
        "ప్రేమతో ప్రాణముబెట్టి - ప్రేమగరికి చనియె"
      ],
      "english": [
        "Premaamrutha dhaarala chindina mana - Yesuku samamevaru?",
        "Premaye thaanai nilachi - Premokthulane palki",
        "Prematho praanamubetti - Premagariki chaniye"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిశ్చలమైన ప్రేమ జీవికి - ఇలలో తావేది",
        "ప్రేమద్రోహులేగాని - ప్రియమున జేరరు వాని",
        "చేరిన చెలికాడగురా - సమయమిదే పరుగిడిరా"
      ],
      "english": [
        "Nishchalamaina prema jeeviki - Ilalo thaavedhi",
        "Premadhrohulegaani - Priyamuna jeraru vaani",
        "Cherina chelikaadaguraa - Samayamide parugidiraa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎంత ఘోరపాపాత్ములనైన - ప్రేమించును రారా",
        "పాపభారముతో రారా - పాదములపై బడరా",
        "పాపుల రక్షకుడేసు - తప్పక నిను రక్షించు"
      ],
      "english": [
        "Entha ghorapaapaathmulanaina - Preminchunu raaraa",
        "Paapabhaaramutho raaraa - Paadhamulapai badaraa",
        "Paapula rakshakudesu - Thappaka ninu rakshinchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇంత గొప్ప రక్షణను - నిర్లక్ష్యము చేసెద వేల",
        "రక్షణ దిన మిదియేరా - తక్షణమే కనుగొనరా",
        "ఇదియే దేవుని వరము - ముదమారగ చేకొనుము"
      ],
      "english": [
        "Intha goppa rakshananu - Nirlakshyamu cheseda vela",
        "Rakshana dina midhiyeraa - Thakshaname kanugonaraa",
        "Idiye Devuni varamu - Mudhamaaraga chekonumu"
      ]
    }
  ]
}
