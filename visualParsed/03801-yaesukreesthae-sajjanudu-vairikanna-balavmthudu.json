  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసుక్రీస్తే సజ్జనుడు - వైరికన్న బలవంతుడు",
        "ఆయన శక్రిచే జయించెదం (జయించెదం ... 5 సార్లు)",
        "వైరికి మేము లొంగము జయించెదం"
      ],
      "english": [
        "Yesukreesthe sajjanudu - Vairikanna balavanthudu",
        "Aayana shakthiche jayinchedham (jayinchedham ... 5 saarlu)",
        "Vairiki memu longamu jayinchedham"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రైస్తవ సైన్యము స్వల్పము - క్రీస్తు ద్వారభయ మొందము",
        "ఆయన శక్రిచే జయించెదం (జయించెదం ... 5 సార్లు)"
      ],
      "english": [
        "Kraisthava sainyamu swalpamu - Kreesthu dhwaara bhaya mondhamu",
        "Aayana shakthiche jayinchedham (jayinchedham ... 5 saarlu)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మ ఖడ్గముతో నరికి - ఆశతో మేము పనిచేతుము",
        "ఆత్మలవైరిని ఎదిరింతుము (ఎదిరింతుము ... 5 సార్లు)"
      ],
      "english": [
        "Aathma khadgamutho nariki - Aashatho memu panichethumu",
        "Aathmalavairini edhirinthumu (edhirinthumu ... 5 saarlu)"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సర్వాయుధ వర్గమును ధరించి - సర్వశక్తి చే నింపబడి",
        "ధైర్యముతో పోరాడెదం (పోరాడెదం ... 5 సార్లు)",
        "గర్విపిశాచితో పోరాడెదం జయించెదం"
      ],
      "english": [
        "Sarvaayudha vargamunu dharinchi - Sarvashakthi che nimpabadi",
        "Dhairyamutho poraadedham (poraadedham ... 5 saarlu)",
        "Garvipishaachitho poraadedham jayinchedham"
      ]
    }
  ]
}
