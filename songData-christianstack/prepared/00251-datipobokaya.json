    "english": [
      "Daatipobokaayya – daatipobokaayya",
      "daatipobokaayya – daatipobokaayya",
      "yesayya naa devaa – yesayya naa prabhuvaa",
      "daatipobokaayya – daatipobokaayya",
      "daatipobokaayya – daatipobokaayya"
