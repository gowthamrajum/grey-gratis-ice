{
  "song_name": "Adhikamugaa Cheyagaladu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అడిగే వాటికంటే ఊహించే వాటికంటే",
      "అధికముగా చేయగలవు యేసయ్యా",
      "నన్ను నడిపే సారధివి నీవేనయ్యా",
      "(నాకు చాలిన దేవుడవు నీవేనయ్యా )"
    ],
    "english": [
      "Adige vaatikante oohinche vaatikante",
      "Adhikamugaa cheyagalavu Yesayyaa",
      "Nannu nadipe saaradhivi neevenayyaa",
      "(Naaku chaalina Dhevudavu neevenayyaa)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చేసి ఉన్న ప్రార్ధన నేను మరచిపోయినా",
        "నువ్వు మరచిపోవుగా నా మంచి నాయనా",
        "అవసరాన్ని తీర్చమనే నా దీన యాచన",
        "పట్టజాలపోతినిగా నీవిచ్చిన దీవెన"
      ],
      "english": [
        "Chesi unna praardhana nenu marachipoyinaa",
        "Nuvvu marachipovugaa naa manchi naayanaa",
        "Avasaraanni theerchamane naa dheena yaachana",
        "Pattajaalapothinigaa neevichchina dheevena"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అల్పమైన వాటిని ఆశించును నా హృదయం",
        "అధికమైన మేళ్ళనూ దాచును నీ మంచితనం",
        "ఏది నిన్ను కోరాలో ఎరుగదు నా వెర్రితనం",
        "ఏది నాకు కావాలో ఎంచి యిచ్చు నీ జ్ఞానం"
      ],
      "english": [
        "Alpamaina vaatini aashinuchunu naa hrudayam",
        "Adhikamaina meallanu dhaachunu nee manchithanam",
        "Edi ninnu koraalo erugadu naa verrithanam",
        "Edi naaku kaavaalo enchi yichchu nee gnaanam"
      ]
    }
  ]
}
