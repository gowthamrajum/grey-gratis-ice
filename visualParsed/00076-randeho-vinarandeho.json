        "గొల్లలు జ్ఞానులు కానుకలతో స్తుతులర్పించిరి (2)  ||రండహో||"
      ],
      "english": [
        "Alanaadu Bethlehemu pashula paakalo",
        "Kanniya Mariyaku shishuvu puttenu (2)",
        "Gollalu gnaanulu kaanukalatho sthuthularpinchiri (2)  ||Randaho||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
