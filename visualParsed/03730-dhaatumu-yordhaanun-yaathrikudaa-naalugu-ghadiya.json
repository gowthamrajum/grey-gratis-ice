{
  "song_name": "Dhaatumu Yordhaanun yaathrikudaa naalugu ghadiyalake athithivi neevichata",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దాటుము యొర్దానున్ యాత్రికుడా",
      "నాలుగు ఘడియలకే అతిథివి నీవిచట"
    ],
    "english": [
      "Dhaatumu Yordhaanun yaathrikudaa",
      "Naalugu ghadiyalake athithivi neevichata"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇహలోకములో సుఖమే లేదు గడ్డిని బోలినదే",
        "జీవిత మంతయును"
      ],
      "english": [
        "Ihalokamulo sukhame ledu gaddini bolinadhe",
        "Jeevitha manthayunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీడలు క్షణములో మారినరీతిన్ జీవితముండు గదా",
        "ఆవిరి సమమే గదా"
      ],
      "english": [
        "Needalu kshanamulo maarinareethin jeevithamundu gadaa",
        "Aaviri samame gadaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వ్యర్థము వ్యర్థము మాయలోకములోని సర్వమును",
        "చెత్తను బోలినదే"
      ],
      "english": [
        "Vyarthamu vyarthamu maayalokamuloni sarvamunu",
        "Chetthanu bolinadhe"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కన్నులెత్తి చూడుము క్రీస్తున్ ఆయనే సర్వములో",
        "మహోన్నతుండు"
      ],
      "english": [
        "Kannuletthi choodumu Kreesthun aayane sarvamulo",
        "Mahonnathundu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సిలువను మోసి సాగుము ప్రియుడా చేరుదువు నీవు",
        "కానాను దేశమున"
      ],
      "english": [
        "Siluvanu mosi saagumu priyudaa cherudhuvu neevu",
        "Kaanaanu dheshamuna"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వాక్యము మార్గము జూపును నీకు క్రీస్తునే గురిగా",
        "నుంచుకొనుము సదా"
      ],
      "english": [
        "Vaakyamu maargamu joopunu neeku Kreesthune gurigaa",
        "Nunchukonumu sadaa"
      ]
    }
  ]
