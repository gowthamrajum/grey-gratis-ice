      "english": [
        "Prema prema naa yesuni prema",
        "prema prema naa raajuni prema",
        "daari tolagina naa koraku",
        "entho vedanatho vechithivi",
        "dooraana nanu choodagaane",
        "parugedutu dari cherithivi",
        "aparaadhigaa nundagaane",
        "nanu mutti muddaadithivi"
