{
  "song_name": "Yesu naa sonthamai",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యేసు నా సొంతమై - నేను ప్రభు సొంతమై",
      "ఈ అనుబంధం నిలవాలయ్య - నీ రాకకై సాగాలిలా",
      "అ.ప. యేసయ్య నా యేసయ్య"
    ],
    "english": [
      "Yesu naa sonthamai - Nenu Prabhu sonthamai",
      "Ee anubandham nilavaalayya - Nee raakakai saagaalilaa",
      "A.pa. Yesayya naa Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దివారాత్రులు నాకై నీవు - వేచి చూచితివే",
        "చెదరిన నాపై బాహువు చాపి - చేరదీసితివే",
        "నిన్ను విడిచి ఉండలేను - నీవు లేక నేనే లేను"
      ],
      "english": [
        "Dhivaaraathrulu naakai neevu - Vechi choochithive",
        "Chedarina naapai baahuvu chaapi - Cheradheesithive",
        "Ninnu vidichi undalenu - Neevu leka nene lenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాకు కలిగిన బాధలన్నిట - తోడు నిలిచితివే",
        "కృంగియున్న నన్ను లేపి - కృపలో దాచితివే",
        "నీకు దూరమై ఉండలేను - నీవు లేక నేనే లేను"
      ],
      "english": [
        "Naaku kaligina baadhalannita - Thodu nilichithive",
        "Krungiyunna nannu lepi - Krupalo daachithive",
        "Neeku dooramai undalenu - Neevu leka nene lenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేను నీపై ఆనుకొనగా - ఆదరించితివే",
        "భారమైన నాదు కాడిని - నీవే మోసితివే",
        "నిన్ను మరచి ఉండలేను - నీవు లేక నేనే లేను"
      ],
      "english": [
        "Nenu neepai aanukonagaa - Aadarinchithive",
        "Bhaaramaina naadu kaadini - Neeve mosithive",
        "Ninnu marachi undalenu - Neevu leka nene lenu"
      ]
    }
  ]
}
