{
  "song_name": "Parama Thandri Ninnu Mae Mee Parasa",
  "author": {
    "Authored by": "",
    "రచన": "యెషయా వీరమార్టిన్"
  },
  "main_stanza": {
    "telugu": [
      "పరమ తండ్రి నిన్ను మే మీ పరస కాలము",
      "స్వరము లెత్తి యింపు గాను స్మరణఁ జేతుము"
    ],
    "english": [
      "Parama Thandri Ninnu Mae Mee Parasa Kaalamu",
      "Svaramu Leththi Yimpu Gaanu Smarana Jaethumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిరుపమాన దేవ నిన్ను నిరత ప్రేమతో",
        "హరువుగా నుతింతు మేము హర్స రవముతోఁ"
      ],
      "english": [
        "Nirupamaana Dhaeva Ninnu Niratha Praemathoa",
        "Haruvugaa Nuthinthu Maemu Harsa Ravamuthoa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అవని సంభ్రమములలోన నవఘళించము",
        "అవసరముగ నీదు పలుకు నవధరింతుము"
      ],
      "english": [
        "Avani Sambhramamulaloana Navaghalinchamu",
        "Avasaramuga Needhu Paluku Navadharinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వేయి నాళ్లు లోకమునను వెలయుకంటెను",
        "శ్రేయ మొక్కనాఁడు నిన్ను సేవ జేయుట"
      ],
      "english": [
        "Vaeyi Naallu Loakamunanu Velayukantenu",
        "Shraeya Mokkanaadu Ninnu Saeva Jaeyuta"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఉచితమైన నీ గృహమున నచల భక్తితో",
        "రుచిరమైన నీదు ప్రేమ రుచినిజూతుము"
      ],
      "english": [
        "Uchithamaina Nee Gruhamuna Nachala Bhakthithoa",
        "Ruchiramaina Needhu Praema Ruchinijoothumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మనసునందు సత్యబోధ మనస్కరించుచు",
        "మనెడు తరిని విడము నీదు ఉనికిపట్టును"
      ],
      "english": [
        "Manasunandhu Sathyaboadha Manaskarinchuchu",
        "Manedu Tharini Vidamu Needhu Unikipattunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "గొరియ పిల్ల యొక్క ప్రేమ గూర్చి భక్తితోఁ",
        "గొరత లేక చేతు మెపుడు గొనబు గానము"
      ],
      "english": [
        "Goriya Pilla Yokka Praema Goorchi Bhakthithoa",
        "Goratha Laeka Chaethu Mepudu Gonabu Gaanamu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "శాంతజలము నొద్ద మమ్ము శాంతి పరచుము",
        "సంతతమును నీవు మమ్ము సంతరించుము"
      ],
      "english": [
        "Shaanthajalamu Nodhdha Mammu Shaanthi Parachumu",
        "Santhathamunu Neevu Mammu Santharinchumu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "దినము లన్ని మేము నిన్ను దీన మనసుతో",
        "వనరు మాని సంతసమున వినతి చేతుము"
      ],
      "english": [
        "Dhinamu Lanni Maemu Ninnu Dheena Manasuthoa",
        "Vanaru Maani Santhasamuna Vinathi Chaethumu"
      ]
    }
  ]
}
