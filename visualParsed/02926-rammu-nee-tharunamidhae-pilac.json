{
  "song_name": "Rammu! Nee tharunamidhe pilachuchunnaadu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రమ్ము! నీ తరుణమిదే పిలచుచున్నాడు",
      "నీ ప్రభువైన యేసు నొద్దకు"
    ],
    "english": [
      "Rammu! Nee tharunamidhe pilachuchunnaadu",
      "Nee prabhuvaina Yesu noddaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జీవితమంతయు వ్యర్థముగను దుఃఖముతోను",
        "గడుపుటయేల వచ్చి ఆయన శరణు జొచ్చినచో",
        "వాంఛతో నిన్ను స్వీకరించున్  ||రమ్ము||"
      ],
      "english": [
        "Jeevithamanthayu vyarthamuganu dhuhkhamuthonu",
        "gaduputayela vachchi aayana sharanu jochchinacho",
        "vaanchatho ninnu sweekarinchun  ||Rammu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కట్టిన యిల్లు ధనధాన్యములు కనబడు బంధుమిత్రులును",
        "గూడు విడిచి నీవు పోయినచో వెంటనీతో రారెవరు  ||రమ్ము||"
      ],
      "english": [
        "Kattina illu dhanadhaanyamulu kanabadu bandhumithrulunu",
        "goodu vidichi neevu poyinacho ventaneetho raarevaru  ||Rammu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అందము మాయ అస్థిరమే దాని నమ్మకుము మోసగించును",
        "మరణము ఒకనాడు వచ్చును మరువకు నీ ప్రభువును  ||రమ్ము||"
      ],
      "english": [
        "Andhamu maaya asthirame daani nammakumu mosaginchunu",
        "maranamu okanaadu vachchunu maruvaku nee prabhuvunu  ||Rammu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మిన్ను క్రిందన్ భూమి మీదన్ మిత్రుడేసు నామముగాక",
        "రక్షణ పొందు దారిలేదు రక్షకుడేసే మార్గము  ||రమ్ము||"
      ],
      "english": [
        "Minnu krindhan bhoomi meedhan mithrudesu naamamugaaka",
        "rakshana pondu dhaariledhu rakshakudese maargamu  ||Rammu||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తీరని పాపవ్యాధులను మారని నీదు బలహీనతల్ ఘోర",
        "సిలువలో మోసితీర్చెన్ గాయములచే బాగుపడన్  ||రమ్ము||"
      ],
      "english": [
        "Theerani paapavyaadhulanu maarani needu balaheenathal ghora",
        "siluvalo mositheerchen gaayamulache baagupadan  ||Rammu||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సత్యవాక్కును నమ్మి రమ్ము నిత్యజీవమును నీకిచ్చున్",
        "నీ పేరు జీవపుస్తకమునందు నిజముగ ఈనాడే వ్రాయున్  ||రమ్ము||"
      ],
      "english": [
        "Sathyavaakkunu nammi rammu nithyajeevamunu neekichchun",
        "nee peru jeevapusthakamunandhu nijamuga eenaade vraayun  ||Rammu||"
      ]
    }
  ]
}
