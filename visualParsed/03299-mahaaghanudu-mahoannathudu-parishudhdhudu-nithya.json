  },
  "main_stanza": {
    "telugu": [
      "మహాఘనుడు మహోన్నతుడు పరిశుద్ధుడు నిత్యనివాసి",
      "మా సాఅమర్థ్యము పునరుత్థానము మా జీవము మా రక్షణనిధి"
    ],
    "english": [
      "Mahaaghanudu mahonnathudu parishuddhudu nithyanivaasi",
      "Maa saamarthyamu punarutthaanamu maa jeevamu maa rakshananidhi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఉన్నత పరిశుద్ధ స్థలములలో",
        "నివసించువాడు పరిశుద్ధుడు",
        "అయినను - నలిగిన వినయంపు",
        "దీనమనస్సులో నివసించును జీవించును"
      ],
      "english": [
        "Unnatha parishuddha sthalamulalo",
        "Nivasinchuvaadu parishuddhudu",
        "Ayinanu - Naligina vinayampu",
        "Dheenamanassulo nivasinchunu jeevinchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దినమెల్ల ప్రభుకై వధియింప",
