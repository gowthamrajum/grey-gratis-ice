  "main_stanza": {
    "telugu": [
      "ఓ ప్రియ నావిక నా జీవితం నీ కంకితం",
      "నా మార్గము చూపుము నా నావను నడుపుము (2)"
    ],
    "english": [
      "O Priya Navika Na Jivitam Ni Kamkitam",
      "Na Margamu Chupumu Na Navanu Nadupumu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పెను గాలి వీచగ సుడిగాలి చుట్టగ",
        "నీవే నాతో నుండగ (2)",
        "నాకింక భయమేల నా దేవా",
