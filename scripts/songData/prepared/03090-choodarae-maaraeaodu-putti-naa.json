{
  "song_name": "Choodarae Maaraedu Putti Naadu",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ చౌధరి"
  },
  "main_stanza": {
    "telugu": [
      "చూడరే మాఱేఁడు పుట్టి నాఁడు బెత్లెహేములో",
      "నేఁడీ భూమి వాసులకు నిండు రక్షణబ్బెను"
    ],
    "english": [
      "Choodarae Maaraedu Putti Naadu Bethlehaemuloa",
      "Naedee Bhoomi Vaasulaku Nindu Rakshanabbenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎన్నరాని దేవ దీప్తి మున్ను మిన్ను గ్రమ్మెను",
        "పన్నుగా రేయెండ కాంతి కన్ననది మించెను"
      ],
      "english": [
        "Ennaraani Dhaeva Dheepthi Munnu Minnu Grammenu",
        "Pannugaa Raeyenda Kaanthi Kannanadhi Minchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దూత తెల్పె వ్రేల కొక ప్రీతియగు ముచ్చటన్",
        "ఖ్యాతిగ దావీదు పురిని కర్తయేసు పుట్టుటన్"
      ],
      "english": [
        "Dhootha Thelpe Vraela Koka Preethiyagu Muchchatan",
        "Khyaathiga Dhaaveedhu Purini Karthayaesu Puttutan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తూరుపున జ్ఞానులొక్క తార దివిని గాంచిరి",
        "వారు వీరు వచ్చి సేవ వరుసగాను జేసిరి"
      ],
      "english": [
        "Thoorupuna Jnaanulokka Thaara Dhivini Gaanchiri",
        "Vaaru Veeru Vachchi Saeva Varusagaanu Jaesiri"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మక్కువతో మనమెల్ల మ్రొక్కి సేవఁ జేతుము",
        "మిక్కుటముగ మనకు శాంతిఁ గ్రక్కున నొసంగును"
      ],
      "english": [
        "Makkuvathoa Manamella Mrokki Saeva Jaethumu",
        "Mikkutamuga Manaku Shaanthi Grakkuna Nosangunu"
      ]
    }
  ]
}
