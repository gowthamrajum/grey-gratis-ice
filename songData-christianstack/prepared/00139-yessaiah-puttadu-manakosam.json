      ],
      "english": [
        "Paapa doshamulu tholaginchutaku",
        "Noothana jeevam manaku icchutaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జ్ఞానులు కనుగొన్నారు",
        "యూదుల రాజు పుట్టాడని",
        "దేవదూతలు ప్రకటించారు",
        "లోకరక్షకుడు ఉదయించాడని"
      ],
      "english": [
        "Jnaanulu kanugonnaaru",
        "Yoodula Raaju puttaadani",
        "Dhevadhoothalu prakatincharu",
        "Loka rakshakudu udhayinchaadani"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "గొర్రెకాపర్లు వార్త విన్నారు",
        "ఆటపాటలతో స్తుతించారు"
      ],
      "english": [
        "Gorrekaparlu vaartha vinnaru",
        "Aatapaatalatho sthuthincharu"
      ]
