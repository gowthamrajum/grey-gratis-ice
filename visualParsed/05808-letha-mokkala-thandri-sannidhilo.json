      "1॰",
      "సొగసైననూ లేక సురూపమూ లేక",
      "బలియైతివా నా యేసయ్యా ॥2॥"
    ],
    "english": [
      "Letha mokkalaa thandri sannidhilo",
      "Nithya mahimalo edigaavu",
      "Loka paapamule nee bujamupai",
      "Kalvari siluvalo odigaavu",
      "1॰",
      "Sogasainanoo leka suroopamoo leka",
      "Baliyaithivaa naa Yesayyaa ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
