{
  "song_name": "Vandhanamo vandhana Mesayya",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వందనమో వందన మేసయ్య - అందుకొనుము మా దేవా",
      "మాదు - వందన మందుకొనుమయా"
    ],
    "english": [
      "Vandhanamo vandhana Mesayya - Andhukonumu maa Deva",
      "Maadu - Vandhana mandhukonumayaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ధరకేతించి ధరియించితివా - నరరూపమును నరలోకములో",
        "మరణము నొంది మరిలేచిన మా మారని మహిమ రాజా",
        "నీకిదే వందన మందుకొనుమయా"
      ],
      "english": [
        "Dharakethinchi dhariyinchithivaa - Nararoopamunu naralokamulo",
        "Maranamu nondi marilechina maa maarani mahima raajaa",
        "Neekidhe vandhana mandhukonumayaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపిని జూచి ప్రేమను జూపి - కరుణా కరముచే కల్వరి కడకు",
        "నడిపించి కడు ప్రేమతో కడిగి కన్నీటిని తుడిచిన నీ",
        "ప్రేమకు సాటియే లేదిలలోన"
      ],
      "english": [
        "Paapini joochi premanu joopi - Karunaa karamuche Kalvari kadaku",
        "Nadipinchi kadu prematho kadigi kanneetini thudichina nee",
        "Premaku saatiye ledhilalona"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఉదయించితివా నన్నుద్ధరింప - ధరియించితివా దారుణ మరణము",
        "దయతలచి దరిద్రుని పిలిచి దారిని చూపిన దాతా",
        "దేవా హృదయార్పణ నర్పింతు"
      ],
      "english": [
        "Udhayinchithivaa nannuddharimpa - Dhariyinchithivaa daaruna maranamu",
        "Dhayathalachi dharidhruni pilichi daarini choopina dhaathaa",
        "Deva hrudhayaarpana narpinthu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అనాధుండను నా నాథుండా - అండవై నాకు బండగ నుండు",
        "అంధుడ నేను నా డెందమున నుండి నడిపించు",
        "క్రీస్తుండా స్తుతిపాత్రుండ - స్తుతించు"
      ],
      "english": [
        "Anaadhundanu naa naathundaa - Andavai naaku bandaga nundu",
        "Andhuda nenu naa dendhamuna nundi nadipinchu",
        "Kreesthundaa sthuthipaathrunda - Sthuthinchu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జగమును వీడి పరమున కరిగి - పరిశుద్ధాత్మను వరమును విరివిగ",
        "నరులపై వరదా ధరలో పోసిన దురిత దూరుడ రావా",
        "రాజా నీకిదే నా స్తుతియాగం"
      ],
      "english": [
        "Jagamunu veedi paramuna karigi - Parishuddhaathmanu varamunu viriviga",
        "Narulapai varadhaa dharalo posina duritha dhooruda raavaa",
        "Raajaa neekidhe naa sthuthiyaagam"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పరమునుండి పరిశుద్ధులతో పరిపూర్ణ ప్రభు ప్రభావముతో",
        "ప్రవిమలుడా ప్రత్యక్షంబగుదువు అక్షయ దేహము తక్షణమిచ్చు",
        "క్షితినిన్ చేరి స్తుతింతు"
      ],
      "english": [
        "Paramunundi parishuddhulatho paripoorna Prabhu prabhaavamutho",
        "Pravimaludaa prathyakshambagudhuvu akshaya dehamu thakshanamichchu",
        "Kshithinin cheri sthuthinthu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "స్తుతిస్తోత్రార్హుడా పరమ పూజ్యుడా - వర్ణనాతీతుడా ధవళవర్ణుడా",
        "రత్నవర్ణుడ రిక్తుడవైతివి ముక్తినిచ్చిన దాతా",
        "నీకిదే వందనమందుకొనుమయా"
      ],
      "english": [
        "Sthuthisthothraarhudaa parama poojyudaa - Varnanaatheethudaa davalavarnudaa",
        "Rathnavarnuda rikthudavaithivi mukthinichchina dhaathaa",
        "Neekidhe vandhanamandhukonumayaa"
      ]
    }
  ]
