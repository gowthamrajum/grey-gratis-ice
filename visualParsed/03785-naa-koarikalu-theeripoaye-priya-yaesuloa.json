  "main_stanza": {
    "telugu": [
      "నా కోరికలు తీరిపోయె ప్రియ యేసులో",
      "నా ప్రాణప్రియుని యందు అవి తీరుచున్నవి"
    ],
    "english": [
      "Naa korikalu theeripoye priya Yesulo",
      "Naa praanapriyuni yandu avi theeruchunnavi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పెంటగ కనుపించె ఈ లోకమంతయు",
