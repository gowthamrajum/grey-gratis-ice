{
  "song_name": "Sthuthi Keerthaneeyudaa",
  "author": {
    "Authored by": "Pastor Abraham",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతి కీర్తనీయుడా – ఘనమైన నీ ప్రేమ",
      "నా హృదయవీణపై శృతి చేసి పాడనా",
      "నా యేసురాజా – అనురాగ బంధమా",
      "నను విడువలేని ఆత్మానుబంధమా"
    ],
    "english": [
      "Sthuthi keerthaneeyudaa – ghanamaina nee prema",
      "Naa hrudhaya veenapai sruthi chesi paadanaa",
      "Naa Yesuraajaa – anuraaga bandhammaa",
      "Nanu viduvaleni aathma anubandhammaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రియ నేస్తమా – నా ప్రాణ బంధమా",
        "నీ ప్రేమ కౌగిలిలో నన్నాదరించుమా",
        "నీ సిలువ త్యాగం నేనెలా మరచిపోదును",
        "ఇలలోన నీకై సాక్షిగా జీవింతును"
      ],
      "english": [
        "Naa priya nesthamaa – naa praana bandhammaa",
        "Nee prema kaugililo nannaadarinchumaa",
        "Nee siluva thyaagam nenela marachipodhunu",
        "Ilalona neekai saakshigaa jeevinthunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా నీతిసూర్యుడా – తేజో ప్రకాశమా",
        "నీ వెలుగు జాడలలో నిను వెంబడించగా",
        "నీ జీవ వాక్యం నింపెనే నాలో ధైర్యము",
        "ప్రాణాత్మదేహం సర్వదా నీకే అంకితం"
      ],
      "english": [
        "Naa neethi sooryudaa – thejo prakaashamaa",
        "Nee velugu jaadalalo ninu vembadainchagaa",
        "Nee jeeva vaakyam nimpene naalo dhairyamu",
        "Praanaathma dheham sarvadhaa neeke ankithamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మహిమ సింహాసనం – నే చేరాలనే",
        "నే కన్న కలలన్నీ నిజమైన వేళలో",
        "నా జయము నీవై నిలిచినా శ్రేష్ఠ తరుణాన",
        "నీలోనే లీనమై పోదునే నే నిరతము"
      ],
      "english": [
        "Mahima simhaasanam – ne cheraalane",
        "Ne kanna kalalanni nijamaina velalo",
        "Naa jayamu neevai nilichina sreshta tharunaana",
        "Neelone leenamai podhune ne nirathamu"
      ]
    }
  ]
}
