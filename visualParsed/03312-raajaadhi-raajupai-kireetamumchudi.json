  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజాధి రాజుపై కిరీటముంచుడి",
        "పైలోకానంద సునాదంబుల నాలించుడి",
        "లే లెమ్ము డెందమా! నా కై చావొందిన",
        "రారాజుపై కిరీటముంచి రాజున్ జేయుడి"
      ],
      "english": [
        "Raajaadhi raajupai kireetamunchudi",
        "Pailokaanandha sunaadhambula naalinchudi",
        "Le lemmu dendhamaa! naa kai chaavondhina",
        "Raaraajupai kireetamunchi raajun jeyudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఈ ప్రేమ రాజుపై - కిరీటముంచుడి",
        "ప్రకాశించు ప్రక్కచేతి - గాయంబుల్ చూడుడి",
        "ఏదూత చూచును - భరింప గల్గును",
        "నా వైపు వంగి చూచుచు - న్న - రాజున్ గొల్వుడి"
      ],
      "english": [
        "Ee prema raajupai - Kireetamunchudi",
        "Prakaashinchu prakkachethi - Gaayambul choodudi",
        "Edhootha choochunu - Bharimpa galgunu",
        "Naa vaipu vangi choochuchu - Nna - Raajun golvudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఈ రాజుపై - కిరీటముంచుడి",
        "చావున్ జయించినన్ - రక్షించిన సజీవియై",
        "చావున్ జయించెను - జీవంబుదెచ్చెను",
        "హా! చావున్ గెల్చి - జీవకి - రీటంబు దెచ్చెను"
      ],
      "english": [
        "Ee raajupai - Kireetamunchudi",
        "Chaavun jayinchinan - Rakshinchina sajeeviyai",
        "Chaavun jayinchenu - Jeevambudhechchenu",
        "Haa! chaavun gelchi - Jeevaki - Reetambu dhechchenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఈ మోక్షరాజుపై - కిరీటముంచుడి",
        "నిత్యుడైన తండ్రితోన్ - శుద్ధాత్మతోడ నైక్యుడు",
        "రవంబు చేయుడి - నిరంతరంబును",
        "ఓ రాజా, నీకే నిత్యఘ - నత ఖ్యాతి గల్గును"
      ],
      "english": [
        "Ee moksharaajupai - Kireetamunchudi",
        "Nithyudaina thandrithon - Shuddhaathmathoda naikyudu",
        "Ravambu cheyudi - Nirantharambunu",
        "O raajaa, neeke nithyagha - Nata khyaathi galgunu"
      ]
    }
  ]
