        "Vachchuvaraku kaachukoMdhunu ||Aa..aanandame||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభువు వచ్చుదినమున తనచేయి చాచిప్రేమతో",
