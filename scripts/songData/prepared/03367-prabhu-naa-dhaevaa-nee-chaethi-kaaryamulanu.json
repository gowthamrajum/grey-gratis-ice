  "main_stanza": {
    "telugu": [
      "నా ప్రాణమెంతో నిన్ను పాడును గొప్ప దేవా గొప్ప దేవా",
      "నా ప్రాణమెంతో నిన్ను పాడును గొప్ప దేవా గొప్ప దేవా"
    ],
    "english": [
      "Naa Praanamemthoa Ninnu Paadunu Goppa Dhaevaa Goppa Dhaevaa",
      "Naa Praanamemthoa Ninnu Paadunu Goppa Dhaevaa Goppa Dhaevaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రభు నా దేవా నీ చేతి కార్యములను",
        "ఆశ్చర్యముతో నే నించి చూడగన్",
        "తారలజూచి గంభీర యురుములు వినగా",
        "విశ్వమంత నీ శక్తిన్ కనుపరచన్"
      ],
      "english": [
        "Prabhu Naa Dhaevaa Nee Chaethi Kaaryamulanu",
        "Aashcharyamuthoa Nae Nimchi Choodagan",
        "Thaaralajoochi Gambheera Yurumulu Vinagaa",
        "Vishvamamtha Nee Shakthin Kanuparachan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అడవులందు నే సంచరొంచగను",
        "పక్షుల మధుర సంగీతములు వినగా",
        "పర్వత శోభ నే పరికించి చూడ",
        "సెలయేరుల చల్లగాలి సోక"
      ],
      "english": [
        "Adavulamdhu Nae Samcharomchaganu",
        "Pakshula Madhura Samgeethamulu Vinagaa",
        "Parvatha Shoabha Nae Parikimchi Chooda",
        "Selayaerula Challagaali Soaka"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రియసుతుని నా కొరకై చనిపోవ",
        "పంపుట తలచి భరించ గలనా?",
        "సిలువ పైని నా భారమంత మోసి",
        "పాపము తీయ రక్తము కార్చెను"
      ],
      "english": [
        "Priyasuthuni Naa Korakai Chanipoava",
        "Pamputa Thalachi Bharimcha Galanaa?",
        "Siluva Paini Naa Bhaaramamtha Moasi",
        "Paapamu Theeya Rakthamu Kaarchenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆర్భాటముతో క్రీస్తు ఈ భువికేతెంచి",
        "పర గృహమునకు నను గొనిపోయెడు వేళ",
        "ఆనందముతో పూజించి ప్రకటింతు",
        "ఓ నా దేవా నీవే ఘనుడవంచు"
      ],
      "english": [
        "Aarbhaatamuthoa Kreesthu Ee Bhuvikaethemchi",
        "Para Gruhamunaku Nanu Gonipoayedu Vaela",
        "Aanamdhamuthoa Poojimchi Prakatimthu",
        "Oa Naa Dhaevaa Neevae Ghanudavamchu"
      ]
