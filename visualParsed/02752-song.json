{
  "song_name": "Nadpumee mahaa Yehova loka yaathra yanduna",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "విలియం విలియమ్స్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నడ్పుమీ, మహా యెహోవా",
      "లోక యాత్ర యందున",
      "నీదు శక్తి నాకు దిక్కు",
      "నన్ రక్షింపఁ జేఁపట్టు",
      "దివ్య మన్నా, దివ్య మన్నా",
      "నా కాహారమై యుండు."
    ],
    "english": [
      "Nadpumee, mahaa Yehova",
      "loka yaathra yanduna",
      "needu shakthi naaku dikku",
      "nan rakshimpa jepattu",
      "divya mannaa, divya mannaa",
      "naa kaahaaramai yundu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "ఊటగా స్వచ్ఛజలంబు",
        "బండనుండి పారనీ",
        "అగ్ని మేఘ స్తంభాలచే",
        "నడవిన్ నన్ దాఁటించుఁ",
        "గొప్ప ప్రాపూ, గొప్ప ప్రాపూ",
        "నాకు డాలవు సదా."
      ],
      "english": [
        "Ootagaa swachchajalambu",
        "bandanundi paaranee",
        "agni megha sthambhaalache",
        "nadavin nan dhaatinchu",
        "goppa praapoo, goppa praapoo",
        "naaku daalavu sadaa."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యొర్దాన్ నది దాఁటు వేళ",
        "భీతు లెల్లఁ బాపుము",
        "మృత్యు శ్రమ లన్ని నన్ను",
        "క్షేమ కానాన్ జేర్చును",
        "స్తుతి గీతి, స్తుతి గీతి",
        "నీ కర్పింతు నిత్యము"
      ],
      "english": [
        "Yordhaan nadi dhaatu vela",
        "bheethu lella baapumu",
        "mruthyu shrama lanni nannu",
        "kshema Kaanaan jerchunu",
        "sthuthi geethi, sthuthi geethi",
        "nee karpinthu nithyamu"
      ]
    }
  ]
}
