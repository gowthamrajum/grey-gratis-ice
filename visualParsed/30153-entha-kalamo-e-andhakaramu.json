  "main_stanza": {
    "telugu": [
      "ఎంత కాలమో ఈ అంధకారము",
      "ఎంత కాలమో ఈ పాప జీవితం",
      "శరణం దేవా శరణం శరణం శరణం",
      "నీ ఆజ్ఞ మీరి చేసాను పాపం",
      "నీ సన్నిధిని కోల్పోతిని",
      "దేవాది దేవా కావరరావా పాపము",
      "కడిగి పావనపరచు ||2|| (ఎంత)",
      "పాపము నన్ను కబళించే స్వామి",
      "కరుణతో నన్ను కాపాడు స్వామి ||2||"
    ],
    "english": [
      "Entha kaalamo ee andhakaaramu",
      "Entha kaalamo ee paapa jeevitham",
      "Sharanam Deva sharanam sharanam sharanam",
      "Nee aagna meeri chesaanu paapam",
      "Nee sannidhini kolpothini",
      "Dhevaadhi Deva kaavaraavaa paapamu",
      "Kadigi paavanaparachu ||2|| (Entha)",
      "Paapamu nannu kabalinche swaami",
      "Karunatho nannu kaapaadu swaami ||2||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వేసారి నిన్ను వేడితి స్వామి",
        "వేదన తీర్చి ఆదరించుమా ||ఎ||"
      ],
      "english": [
        "Vesaari ninnu vedithi swaami",
        "Vedana theerchi aadarinchumaa ||E||"
      ]
    }
