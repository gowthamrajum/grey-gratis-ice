{
  "song_name": "Prabhu goppa kaaryamulu chesenani manamuthsahinchedhamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభు గొప్ప కార్యములు చేసెనని మనముత్సహించెదము",
      "ప్రభు గొప్ప మేలుల వర్షము మనపై కురిపించె నహా",
      "ఆహా స్తోత్రము స్తోత్రములు - ఇంతవరకు కాచె",
      "పాత్రులముగా సేవింతుము"
    ],
    "english": [
      "Prabhu goppa kaaryamulu chesenani manamuthsahinchedhamu",
      "Prabhu goppa melula varshamu manapai kuripinche nahaa",
      "Aahaa sthothramu sthothramulu - Inthavaraku kaache",
      "Paathrulamugaa sevinthumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవ కార్యములు జనముల మధ్య - ప్రసిద్ధి చేయుదము",
        "దేవుని ఆశ్చర్య కార్యము మనలో - ధ్యానించి పాదెదము"
      ],
      "english": [
        "Daiva kaaryamulu janamula madhya - Prasiddhi cheyudamu",
        "Devuni aashcharya kaaryamu manalo - Dhyaaninchi paadedamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంగీత గానములతోను - సన్నుతించుచు ప్రభుని",
        "సితార స్వరమండలములతో - మన మార్భాటించెదము"
      ],
      "english": [
        "Sangeetha gaanamulathonu - Sannuthinchuchu Prabhuni",
        "Sithaara svaramandalamulatho - Mana maarbhaatinchedhamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన భారములన్నియు తొలగించె - ఘనకార్యములను జేసె",
        "దినమెల్ల పాడుచు ఘనపరచెదము - చాటించెద మిలలో"
      ],
      "english": [
        "Mana bhaaramulanniyu tholaginche - Ghanakaaryamulanu jese",
        "Dinamella paaduchu ghanaparachedhamu - Chaatincheda milalo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నూతన కార్యములు చేయువాడు - ప్రభు వాశ్చర్యకరుడు",
        "బలమగు కార్యములు చేయువాడాయనే ధైర్యముగా పాడెదం"
      ],
      "english": [
        "Noothana kaaryamulu cheyuvaadu - Prabhu vaashcharyakarudu",
        "Balamagu kaaryamulu cheyuvaadaayane dhairyamugaa paadedam"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమా సౌందర్యములు గలవాడు - క్షేమము నిచ్చువాడు",
        "మహిమైశ్వర్యములు గలవాడాయనే మహిని బొగడెదము"
      ],
      "english": [
        "Premaa saundharyamulu galavaadu - Kshemamu nichchuvaadu",
        "Mahimaishvaryamulu galavaadaayane mahini bogadedhamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మనకెన్నో వాగ్దానము లిచ్చె మన మనుభవించితిమి",
        "ఘనతా మహిమ ప్రభావము ప్రభునకే హల్లెలూయా ఆమెన్"
      ],
      "english": [
        "Manakenno vaagdhaanamu lichche mana manubhavinchithimi",
        "Ghanathaa mahima prabhaavamu Prabhunake hallelooyaa aamen"
      ]
    }
  ]
}
