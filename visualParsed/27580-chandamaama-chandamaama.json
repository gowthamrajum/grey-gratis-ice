{
  "song_name": "Chandhamaama chandhamaama",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Asha Ashirwadh Shaik"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "చందమామ చందమామ",
      "రాజు పుట్టాడంట ఓయమ్మా",
      "వెన్నెలమ్మిది నిజమా",
      "అతన్నికన్నా సుందరుడంటమ్మా",
      "నవ్వుల పసిబాలూడోయమ్మ",
      "అధ్వితీయుడే అరుదించడమ్మా",
      "నశియించే మనకోసం ప్రేమించి ఇలా వచ్చాడమ్మా",
      "రండయ్యో రండమ్మా స్వాగతీద్దాం",
      "మన హృదయంలోనే వేదికేదాం",
      "సంతోష సంబరాలు చేసేదాం",
      "మనమంతా కలిసి పండుగ చేదాం"
    ],
    "english": [
      "Chandhamaama chandhamaama",
      "Raaju puttaadanta oyammaa",
      "Vennelammidhi nijamaa",
      "Athannikannaa sundharudantammaa",
      "Navvula pasibaaludoyamma",
      "Adhvitheeyude arudhenchadammaa",
      "Nashiyinche manakosam preminchi ilaa vachchaadammaa",
      "Randayyo randammaa svaagatheeddhaam",
      "Mana hrudhayamlone vedhikedhaam",
      "Santhosha sambaraalu chesedhaam",
      "Manamanthaa kalisi panduga chedhaam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యూదయ దేశమున బేత్లేహేము గ్రామమున",
        "ఓ గొప్ప వెలుగు ప్రకాశించే",
        "ఏమిటని సూడబోతే ఓ దూత ఎదురుపడి",
        "మెస్సయా పుట్టాడని వార్త చెప్పే",
        "పరుగున పరుగున సూడ వెళ్ళామే",
        "రారాజునే దర్శించామే",
        "ఆ సుందరుని హృదిలో మేము నిండామే",
        "ఎంత భాగ్యమిదని గొల్లలు పాడారే"
      ],
      "english": [
        "Yoodhaya dheshamuna Bethlehemu graamamuna",
        "O goppa velugu prakaashinche",
        "Emitani soodaboothe o dootha edhurupadi",
        "Messayaa puttaadani vaartha cheppe",
        "Paruguna paruguna sooda vellaame",
        "Raaraajune dharshinchaame",
        "Aa sundharuni hrudilo memu nindaame",
        "Entha bhaagyamidhani gollalu paadaare"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఓరోరి సిన్నవాడా సూడరా గొప్ప తార",
        "మనరాజు పుట్టే సూచనరా",
        "ఆరా తెదామురా పండుగ చేదమురా",
        "విలువైనవన్నీ అర్పిదామురా",
        "అంటూ జ్ఞానులే చూడ వెళ్లారే",
        "ఆ గొప్ప రాజుని పూజించారే",
        "దేవధూతలే మహిమతో నిండారె",
        "ఎంత అద్భుతమిదని పరవశించారే"
      ],
      "english": [
        "Orori sinnavaadaa soodaraa goppa thaara",
        "Manaraaju putte soochanaraa",
        "Aaraa thedhaamuraa panduga chedhamuraa",
        "Viluvainavannee arpidhaamuraa",
        "Antoo gnaanule chooda vellaare",
        "Aa goppa raajuni poojinchaare",
        "Dhevadhoothale mahimatho nindaare",
        "Entha adhbhuthamidhani paravashinchaare"
      ]
    }
  ]
}
