        "మనుజాస్పలకది స్వస్ధత నిచ్చును"
      ],
      "english": [
        "Lokamu gilaadhuvantidhi",
        "Devuni vaakyamu guggilame",
        "Ilalona vaakyamunnadhi",
        "Manujaaspalakadhi swasthatha nichchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వైద్యుడు దేవుని సేవకుడు",
        "దేవుని సేవే వైద్యము",
        "ఆత్మకున్న రోగము",
        "స్వస్ధతకై నిజ సేవకుని చేరును"
      ],
      "english": [
        "Vaidhyudu Devuni sevakudu",
        "Devuni seve vaidhyamu",
