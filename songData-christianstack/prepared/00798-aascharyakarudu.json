{
  "song_name": "Aascharyakarudu",
  "author": {
    "Authored by": "Anand Barnabas D",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆశ్చర్యకరుడు ఆలోచన కర్తా",
      "బలవంతుడైన దేవుడు బేత్లెహేములో జన్మించెను",
      "మన రక్షకుడు జన్మించెను"
    ],
    "english": [
      "Aascharyakarudu aalochana karthaa",
      "balavanthudaina dhevudu bethlehemulo janminchenu",
      "mana rakshakudu janminchenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు వలెనే నాట్యమాడుచు,",
        "గంతులువేసి స్తుతించెదము",
        "శ్రీ యేసుని ఘనపరచెదం",
        "ప్రభుయేసుని కీర్తించెదం"
      ],
      "english": [
        "Daveedhu valene naatyamaaduchu,",
        "ganthulu vesi sthuthinchedhamu",
        "sri yesuni ghana parachedam",
        "prabhu yesuni keerthinchedam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దావీదు వలెనే నాట్యమాడుచు,",
        "గంతులువేసి స్తుతించెదము",
        "శ్రీ యేసుని ఘనపరచెదం",
        "ప్రభుయేసుని కీర్తించెదం"
      ],
      "english": [
        "Daveedhu valene naatyamaaduchu,",
        "ganthulu vesi sthuthinchedhamu",
        "sri yesuni ghana parachedam",
        "prabhu yesuni keerthinchedam"
      ]
    }
  ]
}
