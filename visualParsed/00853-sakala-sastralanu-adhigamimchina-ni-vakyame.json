  },
  "main_stanza": {
    "telugu": [
      "సకల శాస్త్రాలను అధిగమించిన నీ వాక్యమే",
      "జ్ఞానము శక్తియు యేసునందున్నవి"
    ],
    "english": [
      "Sakala shaastraalanu adhigaminchina nee vaakyame",
      "Gnaanamu shakthiyu Yesunandunnavi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదియందు వాక్యము వాక్యమే ఆ దైవము",
        "జీవము వెలుగును యేసు నందున్నవి"
      ],
      "english": [
        "Aadhiyandu vaakyamu vaakyame aa daivamu",
        "Jeevamu velugunu Yesu nandunnavi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కలిగియున్నది ఏదియు యేసు లేకుండ కలుగలేదు",
        "జగతిలోన జీవరాశులన్ యేసు మాటలే కలిగించెను"
      ],
      "english": [
        "Kaligiyunnadhi ediyu Yesu lekunda kalugaledhu",
        "Jagathilona jeevaraashulan Yesu maatale kaliginchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు విత్తిన గింజకు దేహమిచ్చిన దాయనే",
        "మృతులను సజీవులనుగా చేయువాడు ఆ దైవమే"
      ],
      "english": [
        "Neevu viththina ginjaku dhehamichchina dhaayane",
        "Mruthulanu sajeevulanugaa cheyuvaadu aa daivame"
      ]
    }
  ]
