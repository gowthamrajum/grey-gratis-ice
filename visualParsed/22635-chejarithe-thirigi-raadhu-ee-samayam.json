    ],
    "english": [
      "Chejaarithe thirigi raadu ee samayam",
      "Cheyaaligaa sadhviniyogam",
      "Viluvainadi samayam – Dhevunikarpinchumaa",
      "Kaalamundagaane – Prabhuvu panilo saagumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
