{
  "song_name": "Velugichchi Naaku Maargamu Choopu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "వెలుగిచ్చి నాకు మార్గము చూపు",
      "వెలిగించి నా మది ప్రియ యేసు"
    ],
    "english": [
      "Velugichchi Naaku Maargamu Choopu",
      "VeligiMchi Naa Madhi Priya Yaesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గురి చేరుటకే ఈ నా యాత్ర - సరిగా భువిలో నే చేరుటకు",
        "కోరి నీ వెలుగు నే నడచుటకు - ప్రభూ! నడిపించు"
      ],
      "english": [
        "Guri Chaerutakae Ee Naa Yaathra - Sarigaa Bhuviloa Nae Chaerutaku",
        "Koari Nee Velugu Nae Nadachutaku - Prabhoo! NadipiMchu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఘోరచీకటి నన్నావరింప - మార్గమున ఘోర తుఫాను రేగ",
        "కరమునెత్తి ప్రభూ! గద్దించుము - ప్రభూ! రక్షించుము"
      ],
      "english": [
        "Ghoaracheekati NannaavariMpa - Maargamuna Ghoara Thuphaanu Raega",
        "Karamuneththi Prabhoo! GadhdhiMchumu - Prabhoo! RakShiMchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిను చేరి నిత్యం - నీతో నుండుటకే",
        "నేనాశించితి నా హృదయములో",
        "నను బలపరచి నిలుపుము - ప్రభూ! స్థిరముగను"
      ],
      "english": [
        "Ninu Chaeri NithyM - Neethoa NuMdutakae",
        "NaenaashiMchithi Naa Hrudhayamuloa",
        "Nanu Balaparachi Nilupumu - Prabhoo! SThiramuganu"
      ]
    }
  ]
}
