{
  "song_name": "Sarvashakthuda Nirmalaathmuda",
  "author": {
    "Authored by": "",
    "రచన": "చదలవాడ జోనా"
  },
  "main_stanza": {
    "telugu": [
      "సర్వశక్తుఁడ నిర్మలాత్ముఁడ సర్వజనసంరక్షకా మా",
      "సర్వపాపముఁ బరిహరింప నీ సర్వమహిమను విడితివా"
    ],
    "english": [
      "Sarvashakthuda Nirmalaathmuda Sarvajanasamrakshakaa Maa",
      "Sarvapaapamu Bariharimpa Nee Sarvamahimanu Vidithivaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిత్యనాశనమగ్నులగుమా నిత్యశాపముఁ బాపి మరి",
        "నీ నిత్య జీవము మాకునీయను మృత్యు బాధలు పడితివా"
      ],
      "english": [
        "Nithyanaashanamagnulagumaa Nithyashaapamu Baapi Mari",
        "Nee Nithya Jeevamu Maakuneeyanu Mruthyu Baadhalu Padithivaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపమరణపు బంధకములనుఁ దెంపి మము విడిపించుటకు",
        "మా పాపమును భరించి మాకై యాపదల పాల్పడితివా"
      ],
      "english": [
        "Paapamaranapu Bandhakamulanu Dhempi Mamu Vidipinchutaku",
        "Maa Paapamunu Bharinchi Maakai Yaapadhala Paalpadithivaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మెట్టుకీబలు దుష్టులనుచే పట్టి జీవము నిచ్చితివి",
        "కా బట్టి యిఁక నీ కట్టడలలో దిట్టముగ బలపరుచుమీ"
      ],
      "english": [
        "Mettukeebalu Dhushtulanuchae Patti Jeevamu Nichchithivi",
        "Kaa Batti Yika Nee Kattadalaloa Dhittamuga Balaparuchumee"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సత్యవిధులలో నడువనే న శక్తుఁడనో రక్షకా",
        "నీ భృత్యునికి శక్తి నిత్యమిడి నడి పింపు నీ ఘనసేవలో"
      ],
      "english": [
        "Sathyavidhulaloa Naduvanae Na Shakthudanoa Rakshakaa",
        "Nee Bhruthyuniki Shakthi Nithyamidi Nadi Pimpu Nee Ghanasaevaloa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీదు నామము మహిమపరుచను నాదు జీవితకాలమున",
        "బహు సాధు నిగ ననుఁ జేసి సాయము నాధుఁడా నాకీయుమా"
      ],
      "english": [
        "Needhu Naamamu Mahimaparuchanu Naadhu Jeevithakaalamuna",
        "Bahu Saadhu Niga Nanu Jaesi Saayamu Naadhudaa Naakeeyumaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రస్తుతము పరదేశినై ప్రచురంబుఁజేతు నీ స్తోత్రముల్",
        "పర వస్తు ఘనరాజ్యంబుకొరకై వాస్తవముగ నిరీక్షింతున్"
      ],
      "english": [
        "Prasthuthamu Paradhaeshinai Prachurambujaethu Nee Sthoathramul",
        "Para Vasthu Ghanaraajyambukorakai Vaasthavamuga Nireekshinthun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ముక్తినుంచి నీవు రాగా శక్తితోఁ ప్రభు యేసువా",
        "యా సక్తితో నినుఁ గూడుకొని బహు యుక్తస్తోత్రముల్ జేతుము"
      ],
      "english": [
        "Mukthinunchi Neevu Raagaa Shakthithoa Prabhu Yaesuvaa",
        "Yaa Sakthithoa Ninu Goodukoni Bahu Yukthasthoathramul Jaethumu"
      ]
    }
  ]
}
