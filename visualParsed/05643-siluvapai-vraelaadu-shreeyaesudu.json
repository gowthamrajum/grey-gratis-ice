  "main_stanza": {
    "telugu": [
      "సిలువపై వ్రేలాడు శ్రీయేసుడు",
      "నరులకై విలపించు నజరేయుడు",
      "ఆ దేవుడు చిందించిన రుధిర దారలే",
      "ఈ జగతిని విమోచించు జీవధారలు"
    ],
    "english": [
      "Siluvapai vrelaadu Shreeyesudu",
      "Narulakai vilapinchu Najareyudu",
      "Aa Devudu chindhinchina rudhira dhaarale",
      "Ee jagathini vimochinchu jeevadhaaralu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిరపరాధి మౌనభుని దీనుడాయెను",
        "మాతృమూర్తి వేదననే ఓదార్చెను",
        "అపవాది అహంకార మణచి వేసెను",
        "పగవారి కొరకై ప్రభు ప్రార్ధించెను  ||సిలువపై||"
      ],
      "english": [
        "Niraparaadhi maunabhuni dheenudaayenu",
        "Maathrumoorthi vedhanane odaarchenu",
        "Apavaadi ahankaara manachi vesenu",
        "Pagavaari korakai Prabhu praardhinchenu  ||Siluvapai||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కలువరి గిరి కన్నీళ్ళతో కరిగిపోయెను",
        "పాప జగతి పునాదులే కదలిపోయెను",
        "లోక మంత చీకటి ఆవరించెను",
        "శ్రీయేసుడు తలవాల్చి కన్నుమూసెను  ||సిలువపై||"
      ],
      "english": [
        "Kaluvari giri kanneellatho karigipoyenu",
        "Paapa jagathi punaadhule kadhalipoyenu",
        "Loka mantha cheekati aavarinchenu",
        "Shreeyesudu thalavaalchi kannumoosenu  ||Siluvapai||"
      ]
    }
  ]
