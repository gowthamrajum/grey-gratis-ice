    ],
    "english": [
      "Sahodarulu aikyatha kalgi vasinchuta",
      "Entha melu entha manoharamugaa nundunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అది అహరోను తలపై పోయబడియు",
        "క్రిందికి గడ్డముపై కారి - నట్టులుండును"
      ],
      "english": [
        "Adhi Aharonu thalapai poyabadiyu",
        "Krindhiki gaddamupai kaari - Nattulundunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అంగీల అంచు వరకును దిగజారిన",
        "పరిమళ తైలమువలె - నదియుండును"
      ],
      "english": [
        "Angeela anchu varakunu dhigajaarina",
        "Parimala thailamuvale - Nadhiyundunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సీయోను కొండ మీదికి - దిగివచ్చునట్టి",
        "హెర్మోను మంచువలె నైక్యత యుండును"
      ],
      "english": [
        "Seeyonu konda meediki - Dhigivachchunatti",
        "Hermonu manchuvale naikyatha yundunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆశీర్వాదమును శాశ్వత జీవము నచ్చట",
        "యుండవలెనని యెహోవా సెలవిచ్చెను"
      ],
      "english": [
        "Aasheervaadhamunu shaashwatha jeevamu nachchata",
        "Yundavalenani Yehova selavichchenu"
      ]
    }
  ]
