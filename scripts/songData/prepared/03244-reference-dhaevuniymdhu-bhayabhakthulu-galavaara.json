{
  "song_name": "Naa Priya Yaesu Neevae",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రియ యేసు నీవే నా శ్రేయంపు రాజవు",
      "దయచే ప్రాయశ్చిత్తమైతివి నాదు రోజవు"
    ],
    "english": [
      "Naa Priya Yaesu Neevae Naa ShraeyMpu Raajavu",
      "Dhayachae Praayashchiththamaithivi Naadhu Roajavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "సాతానుకు నే దాసుదనై నాశమొందగా",
        "నాతాను ద్వారా తెలిపితివి నాదు ప్రియుడా"
      ],
      "english": [
        "Saathaanuku Nae Dhaasudhanai NaashamoMdhagaa",
        "Naathaanu Dhvaaraa Thelipithivi Naadhu Priyudaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వ్యాదిగ్రస్తుండనై హౄదయక్షీణ మొందితిన్",
        "బాధల నొంది తప్పియుంటి నాదు ప్రియుడా"
      ],
      "english": [
        "VyaaDhigrasthuMdanai HroadhayakSheeNa MoMdhithin",
        "BaaDhala NoMdhi ThappiyuMti Naadhu Priyudaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తప్పిన రూక, పిల్లవాడు, గొర్రెవలెనే",
        "తప్పిన నన్ను వెదకి రక్షించితివి ప్రియుడా"
      ],
      "english": [
        "Thappina Rooka, Pillavaadu, Gorrevalenae",
        "Thappina Nannu Vedhaki RakShiMchithivi Priyudaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తలిదండ్రులు విడిచినను నీవు విదువవు",
        "చల్లగ ప్రక్కజేర్చి బ్రోతువీవు ప్రియుడా"
      ],
      "english": [
        "ThalidhMdrulu Vidichinanu Neevu Vidhuvavu",
        "Challaga Prakkajaerchi Broathuveevu Priyudaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నావాదవైతివి నేను నీదు వాడను",
        "నాయాపదయందున్న ప్రభువు నాదు ప్రియుడా"
      ],
      "english": [
        "Naavaadhavaithivi Naenu Needhu Vaadanu",
        "NaayaapadhayMdhunna Prabhuvu Naadhu Priyudaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ప్రభావముతో సాక్ష్యమీయ రాజ్యమేలుచు",
        "ఆ భాగ్యమును చూడనిమ్ము నాదు ప్రియుడా"
      ],
      "english": [
        "Prabhaavamuthoa SaakShyameeya Raajyamaeluchu",
        "Aa Bhaagyamunu Choodanimmu Naadhu Priyudaa"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "రక్షించితివి హల్లెలూయ పాడునట్లుగా",
        "ఈ క్షితిలో నెల్లరకు చాట నాదు ప్రియుడా"
      ],
      "english": [
        "RakShiMchithivi Hallelooya Paadunatlugaa",
        "Ee KShithiloa Nellaraku Chaata Naadhu Priyudaa"
      ]
    }
  ]
}
