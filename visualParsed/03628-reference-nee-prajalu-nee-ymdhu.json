  "main_stanza": {
    "telugu": [
      "నీ ప్రజలు నీ యందు సంతోషించునట్లు నీవు మరల మమ్మును బ్రతికింపవా? కీర్తన సామ్ 85:6",
      "ఓ ప్రభువా ఉజ్జీవము నిమ్ము",
      "విరిగిన మనస్సుతో నే వేడెదను"
    ],
    "english": [
