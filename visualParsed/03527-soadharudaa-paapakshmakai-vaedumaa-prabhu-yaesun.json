{
  "song_name": "Sodharudaa paapakshamakai vedumaa Prabhu Yesuni",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "సోదరుడా పాపక్షమకై వేడుమా ప్రభు - యేసుని"
    ],
    "english": [
      "Sodharudaa paapakshamakai vedumaa Prabhu - Yesuni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసుని రాజ్యము - సమయము వచ్చెను",
        "రక్షణను పొందెదవు - నీవు విశ్వసించిన"
      ],
      "english": [
        "Yesuni raajyamu - Samayamu vachchenu",
        "Rakshananu pondedavu - Neevu vishwasinchina"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మనుజరూపము ధరించి - స్వర్గము దిగి వచ్చెను",
        "తనదు రక్తముద్వారానే - పాపబంధము త్రుంచెను"
      ],
      "english": [
        "Manujaroopamu dharinchi - Swargamu digi vachchenu",
        "Thanadu rakthamudhvaaraane - Paapabandhamu thrunchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కలువరిలోని సిలువలో - ప్రాణము నర్పించెను",
        "ఎల్లరి పాపములకై - తనదు రక్తము కార్చెను"
      ],
      "english": [
        "Kaluvariloni siluvalo - Praanamu narpinchenu",
        "Ellari paapamulakai - Thanadu rakthamu kaarchenu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సమయము లేదు సోదరా - త్వరపడి రమ్ము వేగమే",
        "సువార్తను విశ్వసించి - రక్షణను పొందుము"
      ],
      "english": [
        "Samayamu ledu sodaraa - Thvarapadi rammu vegame",
        "Suvaarthanu vishwasinchi - Rakshananu pondumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాప సాగరమునందు ఎంతకాలముందువు?",
        "పాపసాగరమునుండి - యేసుప్రభు విడిపించును"
      ],
      "english": [
        "Paapa saagaramunandhu enthakaalamundhuvu?",
        "Paapasaagaramunundi - Yesuprabhu vidipinchunu"
      ]
    }
  ]
}
