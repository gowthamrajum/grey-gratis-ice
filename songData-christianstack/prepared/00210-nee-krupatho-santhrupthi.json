  "main_stanza": {
    "telugu": [
      "యేసయ్యా.. యేసయ్యా..",
      "ఓ యేసయ్యా…",
      "యేసయ్యా.. యేసయ్యా..",
      "నా యేసయ్యా…"
    ],
    "english": [
      "येसय्या.. येसय्या..",
      "ओ येसय्या…",
      "येसय्या.. येसय्या..",
      "ना येसय्या…"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కృపతో",
        "సంతృప్తిపరచు దేవా…",
        "నీ దయతో",
