{
  "song_name": "Ne Nilachu Bhoomi Kampinchi Kooli Poyina Nammedhanu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor Reenukumar  Translated by Bro  Joseph D",
      "John Erry"
