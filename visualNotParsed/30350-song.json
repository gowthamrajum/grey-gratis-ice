  "main_stanza": {
    "telugu": [
      "జగముల నేలే పరిపాలక జగతికి నీవే ఆధారము",
      "మనకు మన జీవితాలకు మన కుటుంబాలకు మన",
      "సంఘమునకు మన ప్రపంచానికి ఆయనే ఆధారము",
      "కాబట్టి ఈ పాట అందరికీ వచ్చిన పాటే",
      "కాబట్టి ఆత్మతో మనసుతో ఆయనకు స్తోత్రగానమ",
      "చేద్దాం",
      "జగములలే",
      "పరిపాలక",
      "జగతికి నీవే",
      "ఆధారమా",
      "ఆత్మతో",
      "మనసుతో స్తోత్రగానం"
    ],
    "english": [
      "Jagamula nele paripaalaka jagathiki neeve aadhaaramu",
      "Manaku mana jeevithaalaku mana kutumbaalaku mana",
      "Sanghamunaku mana prapanchaaniki aayane aadhaaramu",
      "Kaabatti ee paata andharikee vachchina paate",
      "Kaabatti aathmatho manasutho aayanaku sthothragaanamu",
