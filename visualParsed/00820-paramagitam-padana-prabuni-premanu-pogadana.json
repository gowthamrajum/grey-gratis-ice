  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వేరు ప్రియుని కన్న నీ ప్రియుని విషయం ఏమని",
        "అడుగుచున్న లోకానికి నీదు విలువను తెలుపని",
        "నా ప్రియుడు దవళవర్ణుడు పదివేలలో అతిసుందరుడు",
        "పాపమేలేని పరిశుద్ధుడు"
      ],
      "english": [
        "Veru priyuni kanna nee priyuni vishayam emani",
        "Adhuguchunna lokaaniki needu viluvanu thelupani",
        "Naa priyudu davalavarnudu padivelalo athisundharudu",
        "Paapameleni parishuddhudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రేమలు చల్లారిన లోకలో",
        "మమ్ము ప్రేమించువారు ఎవరని",
        "అడుగుచున్న లోకానికి నీదు ప్రేమను తెలుపని",
        "నా ప్రియుడు రత్నవర్ణుడు పాపులను ప్రేమించినాడు",
        "ప్రేమించి ప్రాణం పెట్టినాడు"
      ],
      "english": [
        "Premalu challaarina lokalo",
        "Mammu preminchuvaaru evarani",
        "Adhuguchunna lokaaniki needu premanu thelupani",
        "Naa priyudu rathnavarnudu paapulanu preminchinaadu",
        "Preminchi praanam pettinaadu"
      ]
    }
  ]
