{
  "song_name": "Stuti Naivedyam Amduko Yesayya Stuti",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తుతి నైవేద్యం అందుకో యేసయ్యా స్తుతి యాగమునే చేసెద నిరతం",
      "స్తుతికి పాత్రుడవు స్తుతికి అర్హుడవు",
      "స్తుతికి యోగ్యుడవు స్తుతుకి అర్హుడవు",
      "నా స్తుతికి నీవే కారణ భూతుడవు"
    ],
    "english": [
      "Stuti Naivedyam Amduko Yesayya Stuti Yagamune Cheseda Niratam",
      "Stutiki Patrudavu Stutiki Arhudavu",
      "Stutiki Yogyudavu Stutuki Arhudavu",
      "Na Stutiki Nive Karana Butudavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రార్ధన ధూపమువలె చేతులేత్తెదన్ నైవేద్యముగా",
        "అంగీకరించుము యేసయ్యా నిన్నే స్తుతింతుము యేసయ్యా"
      ],
      "english": [
        "Na Prardhana Dhupamuvale Chetulettedan Naivedyamuga",
        "Amgikarimchumu Yesayya Ninne Stutimtumu Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్తోత్రము చేయుట శ్రేయస్కరమే స్తుతులు పాడుట మనోహరమే",
        "కృతజ్జతో పూజింతును కృపను నిరతము పాడెదను"
      ],
      "english": [
        "Stotramu Cheyuta Sreyaskarame Stutulu Paduta Manoharame",
        "Krutajjato Pujimtunu Krupanu Niratamu Padedanu"
      ]
    }
  ]
}
