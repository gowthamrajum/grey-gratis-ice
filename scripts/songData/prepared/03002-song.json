{
  "song_name": "Gaayambuthoa Nindaaru Oa Shudhdha Shirassaa",
  "author": {
    "Authored by": "",
    "రచన": "బెర్నార్డ్ క్లైర్ వాక్స్"
  },
  "main_stanza": {
    "telugu": [
      "గాయంబుతో నిండారు ఓ శుద్ధ శిరస్సా!",
      "హా! ముండ్ల కిరీటంబు భరించు శిరస్సా!",
      "నీకిప్పుడు డపకీర్తి హాస్యంబు గల్గెఁగా",
      "కర్తా! ఘనంబు కీర్తి ఎన్నడు గల్గుఁగా"
    ],
    "english": [
      "Gaayambuthoa Nindaaru Oa Shudhdha Shirassaa!",
      "Haa! Mundla Kireetambu Bharinchu Shirassaa!",
      "Neekippudu Dapakeerthi Haasyambu Galgegaa",
      "Karthaa! Ghanambu Keerthi Ennadu Galgugaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకంబు భీతి నొందు ప్రకాశపూర్ణుడా!",
        "ఆ యూదులైన వారు నీ మొము మీఁదను!",
        "నాఁడుమ్మి వేసినారా? నీ ముఖకాంతికి",
        "సమాన కాంతి లేదు కురూపి వైతివా."
      ],
      "english": [
        "Loakambu Bheethi Nondhu Prakaashapoornudaa!",
        "Aa Yoodhulaina Vaaru Nee Momu Meedhanu!",
        "Naadummi Vaesinaaraa? Nee Mukhakaanthiki",
        "Samaana Kaanthi Laedhu Kuroopi Vaithivaa."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీవోర్చినట్టి బాధ నా క్రూర పాపమే!",
        "నాకోస మింత బాధ వహించినావుగా!",
        "దైవోగ్ర బాధ కేను పాత్రుండ నైతిని",
        "దృష్టించి నన్నుఁ జూఁచి కటాక్ష ముంచుమీ."
      ],
      "english": [
        "Neevoarchinatti Baadha Naa Kroora Paapamae!",
        "Naakoasa Mintha Baadha Vahinchinaavugaa!",
        "Dhaivoagra Baadha Kaenu Paathrunda Naithini",
        "Dhrushtinchi Nannu Joochi Kataaksha Munchumee."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేఁ బాపి నైతి గాని నన్ నీవు చేర్చుము!",
        "నీ నిత్యయూటనుండి మేళ్లన్ని పారును!",
        "నీ నోరు మాధుర్యంపు సుబోధఁ జెప్పెను",
        "నీ పావనాత్మ మోక్ష సుఖంబు లిచ్చును."
      ],
      "english": [
        "Nae Baapi Naithi Gaani Nan Neevu Chaerchumu!",
        "Nee Nithyayootanundi Maellanni Paarunu!",
        "Nee Noaru Maadhuryampu Suboadha Jeppenu",
        "Nee Paavanaathma Moaksha Sukhambu Lichchunu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా కోస మింత బాధ వహించి నందుకు!",
        "యధార్థమైన స్తుతి నిత్యంబు నీదగున్",
        "నీ నామమందు నేను విశ్వాస ముంతును",
        "నా యంత్యకాలమందు నా యొద్దనుండుము."
      ],
      "english": [
        "Naa Koasa Mintha Baadha Vahinchi Nandhuku!",
        "Yadhaarthamaina Sthuthi Nithyambu Needhagun",
        "Nee Naamamandhu Naenu Vishvaasa Munthunu",
        "Naa Yanthyakaalamandhu Naa Yodhdhanundumu."
      ]
    }
  ]
}
