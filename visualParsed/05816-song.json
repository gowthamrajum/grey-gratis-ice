  "main_stanza": {
    "telugu": [
      "యేసు పుట్టెను నేడు",
      "పరమును విడిచెను నేడు",
      "పాపికి విడుదల నేడు",
      "ప్రతి పాపికి విడుదల నేడు",
      "*హ్యాపీ హ్యాపి క్రిస్ట్మస్ మెర్రీ మెర్రి క్రిస్ట్మస్*॥2॥"
    ],
    "english": [
      "Yesu puttenu nedu",
      "Paramunu vidichenu nedu",
      "Paapiki vidudala nedu",
      "Prathi paapiki vidudala nedu",
      "*Happy happy Christmas merry merry Christmas*॥2॥"
    ]
  },
  "stanzas": [
