{
  "song_name": "Neevanti Vaaru Naaku Evaru",
  "author": {
    "Authored by": "Mohan C Lazarus",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ వంటి వారు నాకు ఎవరు లేరయ్య",
      "నా యేసయ్య హల్లెలూయ"
    ],
    "english": [
      "Neevanti vaaru naaku evaru lerayya",
      "na yesayya hallelujah"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సుఖములలో నీవే… బాధలలో నీవే",
        "అన్ని వేళలో తోడు నీవేనయ్యా",
        "నా స్నేహము నీవే… నా ఆశయు నీవే",
        "నా సర్వము దేవా నీవేనయ్యా",
        "ఇహమందును నీవే… పరమందును నీవే",
        "ఎల్లప్పుడు నాతో నీవేనయ్యా"
      ],
      "english": [
        "Sukhamulalo neeve… baadhalalo neeve",
        "anni velalo thodu neevenayyaa",
        "Naa snehamu neeve… naa aasayu neeve",
        "naa sarvamu deva neevenayyaa",
        "Ihamandhunu neeve… paramandhunu neeve",
        "ellappudu naatho neevenayyaa"
      ]
    }
  ]
}
