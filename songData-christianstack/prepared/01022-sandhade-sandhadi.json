  "main_stanza": {
    "telugu": [
      "సందడి చేద్దామా – సంతోషిద్దామా",
      "రారాజు పుట్టేనని",
      "గంతులు వేద్దామా – గానము చేద్దామా",
      "శ్రీ యేసు పుట్టేనని (2)",
      "మనసున్న మారాజు పుట్టేనని",
      "సందడి చేద్దామా – సంతోషిద్దామా",
      "మన కొరకు మారాజు పుట్టేనని",
      "సందడి చేద్దామా…",
      "సందడే సందడి…",
      "సందడే సందడి సందడే సందడి",
      "సందడే సందడి (4)"
    ],
    "english": [
