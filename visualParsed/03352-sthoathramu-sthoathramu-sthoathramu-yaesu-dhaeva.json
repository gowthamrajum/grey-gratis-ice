  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తోత్రము స్తోత్రము స్తోత్రము యేసు దేవా",
        "పాత్రుల జేసి నేటివరకు మమ్ము కాచినదేవా"
      ],
      "english": [
        "Sthothramu sthothramu sthothramu Yesu Devaa",
        "Paathrula jesi netivaraku mammu kaachinadhevaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పొత్తిగుడ్డల చేత చుట్టబడిన తండ్రి",
        "పాపుకై జీవమిడి గొల్లలకు నిజహర్ష మిచ్చితివే"
      ],
      "english": [
        "Potthiguddala chetha chuttabadina thandri",
        "Paapikai jeevamidi gollalaku nijaharsha michchithive"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "హేమకిరీటము తెల్లంగినే నే ధరింప",
        "హీనకిరీటము ముండ్లతో పొందిరి - నన్ను రక్షింప"
      ],
      "english": [
        "Hemakireetamu tellangeene ne dharimpa",
        "Heenakireetamu mundlatho pondiri - Nannu rakshimpa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపినై చేసెడు పాపములను తీర్చను",
        "ఏపుగ కల్వరి యందున నాకై పాట్లుపడితివి"
      ],
      "english": [
        "Paapinai chesedu paapamulanu theerchanu",
        "Epuga Kalvari yanduna naakai paatlupadithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పాప నివారణ బలియగు గొఱ్ఱెపిల్ల",
        "పాపమృతులమౌ మమ్మురక్షింప ప్రాణమిచ్చితివే"
      ],
      "english": [
        "Paapa nivaarana baliyagu gorrepilla",
        "Paapamruthulamau mammurakshimpa praanamichchithive"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సైతానును జయింప శక్తినిచ్చిన దేవా",
        "బుద్ధితో పోరాడి యుద్ధమున గెల్వ జ్ఞానమీయుము"
      ],
      "english": [
        "Saithaanunu jayimpa shakthinichchina Devaa",
        "Buddhitho poraadi yuddhamuna gelva gnaanameeyumu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఈలాటి ప్రేమను ఏలాగు తెల్పుదును",
        "జీవమార్గమున చ్క్కగ నడుతు నాయన శక్తిచే"
      ],
      "english": [
        "Eelaati premanu elaagu telpudunu",
        "Jeevamaargamuna chakkaga naduthu naayana shakthiche"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "దూతలు కొనియాడు జ్ఞానుడవగు తండ్రి",
        "దానములిమ్ము దయతోడ నిత్యము దయగల మా తండ్రి"
      ],
      "english": [
        "Doothalu koniyaadu gnaanudavagu thandri",
        "Daanamulimmu dayathoda nithyamu dayagala maa thandri"
      ]
    }
  ]
}
