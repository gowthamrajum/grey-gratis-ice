{
  "song_name": "Poorna hrudaya sthothramul chellinchedha Prabhunake",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పూర్ణ హృదయ స్తోత్రముల్ - చెల్లించెద ప్రభునకే (2)"
    ],
    "english": [
      "Poorna hrudaya sthothramul - Chellinchedha Prabhunake (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏర్పరచుకోలేదు నేను - ప్రభువే నన్నేర్పరచుకొనెన్ (2)",
        "పాపినైన నాకు - ఆయనే రక్షణ నిచ్చెన్ (2)",
        "పరలోక రాజ్యములో - భాగమునిచ్చెన్ (2)"
      ],
      "english": [
        "Erparachukoledhu nenu - Prabhuve nannerparachukonen (2)",
        "Paapinaina naaku - Aayane rakshana nichchen (2)",
        "Paraloka raajyamulo - Bhaagamunichchen (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా హృదయ పాపమును - తన రక్తములో కడిగెన్",
        "మృతమైన నా ఆత్మను - జీవింపజేసె ప్రభువు",
        "ఉచితంబుగానే పొందితి - నిత్య జీవం"
      ],
      "english": [
        "Naa hrudaya paapamunu - Thana rakthamulo kadigen",
        "Mruthamaina naa aathmanu - Jeevimpajese Prabhuvu",
        "Uchithambugaane pondithi - Nithya jeevam"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నే పాప బంధములో నుండ - హృదయమశాంతితో నిండె",
        "నా పాప మొప్పుకొనగా - కడిగెను రక్తములో",
        "శాంతి ఆనందముతో - నన్ను నింపెన్"
      ],
      "english": [
        "Ne paapa bandhamulo nunda - Hrudhayamashaanthitho ninde",
        "Naa paapa moppukonagaa - Kadigenu rakthamulo",
        "Shaanthi aanandamutho - Nannu nimpen"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వర్ణింపజాలను నేను - ప్రభు యొక్క గొప్ప ప్రేమన్",
        "పాపిని నను ప్రేమించెన్ - మరువలేనా ప్రేమను",
        "ప్రశంసలను పాడెద - ప్రభుకే"
      ],
      "english": [
        "Varnimpajaalanu nenu - Prabhu yokka goppa preman",
        "Paapini nanu preminchen - Maruvalenaa premanu",
        "Prashamsalanu paadeda - Prabhuke"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నిత్య రాజ్యము నన్ను చేర్చ - నిత్య నిబంధన చేసే",
        "సుఖదుఃఖములందైన - ముగింతు నా పరుగున్",
        "స్థిరముగ నుందు పరమును చేరువరకు"
      ],
      "english": [
        "Nithya raajyamu nannu cherchа - Nithya nibandhana chese",
        "Sukhadhuhkhamulandhaina - Muginthu naa parugun",
        "Sthiramuga nundu paramunu cheruvaraku"
      ]
    }
  ]
}
