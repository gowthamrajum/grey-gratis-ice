{
  "song_name": "Immahi Meedha GrummariMchumu Dhaevaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇమ్మహి మీద గ్రుమ్మరించుము దేవా",
      "క్రమ్మర ప్రేమ వర్షంబున్ గ్రుమ్మరించుము దేవా"
    ],
    "english": [
      "Immahi Meedha GrummariMchumu Dhaevaa",
      "Krammara Praema VarShaMbun GrummariMchumu Dhaevaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆశీర్వాదంబుల్ మామీద - వర్షింపజేయు మీశ",
        "యాశతో నమ్మి యున్నాము - నీ సత్య వాగ్దత్తము"
      ],
      "english": [
        "AasheervaadhaMbul Maameedha - VarShiMpajaeyu Meesha",
        "Yaashathoa Nammi Yunnaamu - Nee Sathya Vaagdhaththamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఓ దేవా పంపింప వయ్యా - నీ దేవెన ధారలన్",
        "మా దాహ మెల్లను బాపు - మాధుర్యమౌ వర్షమున్"
      ],
      "english": [
        "Oa Dhaevaa PMpiMpa Vayyaa - Nee Dhaevena Dhaaralan",
        "Maa Dhaaha Mellanu Baapu - MaaDhuryamau VarShamun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మామీద కురిపించు మీశ - ప్రేమ ప్రవాహంబులన్",
        "సమస్త దేశంబు మీద - క్షామంబు పోవునట్లుగన్"
      ],
      "english": [
        "Maameedha KuripiMchu Meesha - Praema PravaahaMbulan",
        "Samastha DhaeshaMbu Meedha - KShaamaMbu Poavunatlugan"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఈనాడే వర్షంపు మీశ - నీ నిండు దీవెనలన్",
        "నీ నామమందున వేడి సన్నుతి బ్రార్థింతుము"
      ],
      "english": [
        "Eenaadae VarShaMpu Meesha - Nee NiMdu Dheevenalan",
        "Nee NaamamaMdhuna Vaedi Sannuthi BraarThiMthumu"
      ]
    }
  ]
}
