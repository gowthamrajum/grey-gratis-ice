{
  "song_name": "Dhaivaprema manalanepudu bandhinchugaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఎ చార్లెస్ కిన్సింగర్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "దైవప్రేమ మనలనెపుడు బంధించుగా దివిని భువిని దీన జనులను",
      "దిరముగా కాపాడుగా||"
    ],
    "english": [
      "Dhaivaprema manalanepudu bandhinchugaa divini bhuvini deena janulanu",
      "Dhiramugaa kaapaadugaa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమతండ్రి గద్దెముందట ప్రార్థనల్ మరిజేతుము పలు విధముల",
        "మార్గములలో ప్రభువే తోడైయుండుగా  ||దైవప్రేమ||"
      ],
      "english": [
        "Paramathandri gaddhemundhata praarthanal marijethumu palu vidhamula",
        "Maargamulalo Prabhuve thodaiyundugaa ||Dhaivaprema||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిత్యప్రభువు సత్యసేవను నిరతమును మదినుంతుము నిలిచియుందుము",
        "క్రీస్తుకొరకై నిత్యసేవక జనముగా  ||దైవప్రేమ||"
      ],
      "english": [
        "Nithyaprabhuvu sathyasevanu nirathamunu madhinunthumu nilichiyundhumu",
        "Kreesthukorakai nithyasevaka janamugaa ||Dhaivaprema||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మనము విడిచి వెళ్లునపుడు మదిని కల్గును వేదన మనసు హృదయము",
        "కలిసియుండగ మరల గలియుదు మెచ్చటో  ||దైవప్రేమ||"
      ],
      "english": [
        "Manamu vidichi vellunapudu madini kalgunu vedhana manasu hrudayamu",
        "Kalisiyundaga marala galiyudhu mechchato ||Dhaivaprema||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జనక తనయ పరిశుద్ధాత్మకు జయము మహిమయు ఘనతయు ఆదినుండి",
        "యిపుడు యెపుడు అవని పరమున జెల్లుగా  ||దైవప్రేమ||"
      ],
      "english": [
        "Janaka thanaya Parishuddhaathmaku jayamu mahimayu ghanathayu aadhinundi",
        "Ipudu epudu avani paramuna jellugaa ||Dhaivaprema||"
      ]
    }
  ]
}
