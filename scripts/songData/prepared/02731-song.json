{
  "song_name": "Yaesoo Yaathma Priyudaa Ninnu",
  "author": {
    "Authored by": "",
    "రచన": "చార్లెస్ వెస్లీ"
  },
  "main_stanza": {
    "telugu": [
      "యేసూ, యాత్మ ప్రియుఁడా నిన్ను నాశ్రయించితి",
      "లేవఁగా దరంగముల్ గాలివాన కొట్టఁగా",
      "లోకబాధ లన్నిఁటన్ నన్ను దాఁచు రక్షకా",
      "రేపునకు నడ్పుము నాదు యాత్మన్ బ్రోవుము"
    ],
    "english": [
      "Yaesoo, Yaathma Priyudaa Ninnu Naashrayinchithi",
      "Laevagaa Dharangamul Gaalivaana Kottagaa",
      "Loakabaadha Lannitan Nannu Dhaachu Rakshakaa",
      "Raepunaku Nadpumu Naadhu Yaathman Broavumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దిక్కు లేని యాత్మకు వేఱె ప్రాపు లేదిఁక",
        "ఒంటిగాను విడ్వక నన్ను నాదరించుమీ",
        "నిన్నె నమ్మి యుంటిని నీవె నా సహాయము",
        "కాపులేని నా తలన్ కాయుమా నీ నీడను"
      ],
      "english": [
        "Dhikku Laeni Yaathmaku Vaere Praapu Laedhika",
        "Ontigaanu Vidvaka Nannu Naadharinchumee",
        "Ninne Nammi Yuntini Neeve Naa Sahaayamu",
        "Kaapulaeni Naa Thalan Kaayumaa Nee Needanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రీస్తు నిన్నెఁ గోరుదున్ దొర్కు నన్ని నీ కడన్",
        "పడ్డ హీను నెత్తుమీ స్వస్థపర్చు రోగులన్",
        "న్యాయశుద్ధ నామము నీదె, నేను పాపిని",
        "నేను పాపపూర్ణుఁడన్ నీవు ప్రేమారూపివి"
      ],
      "english": [
        "Kreesthu Ninne Goarudhun Dhorku Nanni Nee Kadan",
        "Padda Heenu Neththumee Svasthaparchu Roagulan",
        "Nyaayashuddha Naamamu Needhe, Naenu Paapini",
        "Naenu Paapapoornudan Neevu Praemaaroopivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపమెల్ల మాన్పఁగా నీదు ప్రేమ చాలును",
        "మాన్పు నీళ్లు నాయెదన్ శుద్ధి చేయఁగా నిమ్ము",
        "నీవు బ్రత్కు టూటవు త్రాగనిమ్ము నీదరిన్",
        "పుట్టి నాదు నాత్మలో నెల్ల ప్రొద్దు పారుమీ"
      ],
      "english": [
        "Paapamella Maanpagaa Needhu Praema Chaalunu",
        "Maanpu Neellu Naayedhan Shuddhi Chaeyagaa Nimmu",
        "Neevu Brathku Tootavu Thraaganimmu Needharin",
        "Putti Naadhu Naathmaloa Nella Prodhdhu Paarumee"
      ]
    }
  ]
}
