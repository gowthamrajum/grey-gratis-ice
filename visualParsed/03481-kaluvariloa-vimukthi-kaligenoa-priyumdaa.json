  },
  "main_stanza": {
    "telugu": [
      "కలువరిలో విముక్తి - కలిగెనో ప్రియుండా"
    ],
    "english": [
      "Kaluvarilo vimukthi - Kaligeno priyundaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపమెరుగని యేసు - పాపముగ జేయబడి",
        "శాపంబు వహించి - శ్రమల సహించెను"
      ],
      "english": [
        "Paapamerugani Yesu - Paapamuga jeyabadi",
        "Shaapambu vahinchi - Shramala sahinchenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాదహస్తముల నుండి - ప్రక్క గాయము నుండి",
        "ప్రవహించెను పుణ్య - ప్రణయామృత ధార"
      ],
      "english": [
        "Paadhahasthamula nundi - Prakka gaayamu nundi",
        "Pravahinchenu punya - Pranayaamrutha dhaara"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభు యేసుని రక్తమే - ప్రేమామృత ధార",
        "ప్రియమారగ త్రాగు - ప్రభు సన్నిది జేరి"
      ],
      "english": [
        "Prabhu Yesuni rakthame - Premaamrutha dhaara",
        "Priyamaaraga thraagu - Prabhu sannidhi jeri"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఘన ప్రేమనుజూపి - తన రక్తముచేత",
        "తానే కడుగును - మన పాపము నంత"
      ],
      "english": [
        "Ghana premanujoopi - Thana rakthamuchetha",
        "Thaane kadugunu - Mana paapamu nantha"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సర్వజనులకు - సువార్త నందించి",
        "సరియైనట్టి దారి - జూపింతుము వేగ"
      ],
      "english": [
        "Sarvajanulaku - Suvaartha nandhinchi",
        "Sariyainatti daari - Joopinthumu vega"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రాపంచసాగరాన - ప్రభువా నేను దుమికి",
        "పాపులను రక్షించు - ప్రాదేహత నిమ్ము"
      ],
      "english": [
        "Praapanchasaagaraana - Prabhuvaa nenu dhumiki",
        "Paapulanu rakshinchu - Praadhehatha nimmu"
      ]
    }
  ]
}
