    "english": [
      "Yese nee aadhaaramu digulu chendaku",
      "Maralaa venudhirugaku dhairyamugaa undu",
      "Orputho vechi undu noothana balamu nondhedhavu",
      "Pakshiraaju vale paipaiki egurudhuvu"
    ]
  },
  "stanzas": [
