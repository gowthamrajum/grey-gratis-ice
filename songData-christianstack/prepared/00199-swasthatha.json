        "nee rakthamu nannu shuddhiparachunu",
        "neevu pondhina debbala chetha",
        "naku swasthatha kalugunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "[Bridge]",
        "యేసయ్యా యేసయ్యా",
        "నీకే మొర పెట్టుచున్నాన్ యేసయ్యా",
        "యేసయ్యా యేసయ్యా",
        "నీ సాక్షిగా నను నిలుపుము యేసయ్యా"
      ],
      "english": [
        "[Bridge]",
        "Yesayya yesayya",
