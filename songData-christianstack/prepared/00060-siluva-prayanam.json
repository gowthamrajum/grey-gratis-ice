{
  "song_name": "Siluva Prayanam",
  "author": {
    "Authored by": "John Sandeep",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కలువరిలో సాగిన సిలువ ప్రయాణం",
      "కరుణామయుని ప్రేమత్యాగం",
      "నీ కొరకే…. నా కొరకే…",
      "యేసు సిలువ మరణం"
    ],
    "english": [
      "Kaluvarilo saagina siluva prayaanam",
      "Karunaamayuni prema thyaagam",
      "Nee korake naa korake Yesu siluva maranam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శిష్యుడే అమ్మిన సైనికుడే ఉమ్మిన",
        "అప్పగించబడిన నీవు అవమానం పొందిన",
        "అందరి రక్షణ కోరే అన్యాయపు తీర్పు పొంది",
        "అపవాదిని బంధించితీవీ",
        "ఆ..అపవాదిని బంధించితీవీ",
        "నీ కొరకే నా కొరకే",
        "యేసు సిలువ మరణం"
      ],
      "english": [
        "Shishyude ammina sainikude ummina",
        "Appaginchabadi neevu avamaanamu pondhina",
        "Andhari rakshana kori anyaayapu theerpu pondhenu",
        "Apavaadhini bandhinchithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యూదులే సుధులై సాధువునే శోధించిన",
        "వెంబడించివాడే ఏసు ఎవరో నేనేరుగననీ",
        "పడి చెడిన గొర్రెను బాగుచేయుటకై",
        "సిలువలో వ్రేలాడితివి",
        "ఆ…సిలువలో వ్రేలాడితివి",
        "నీ కొరకే… నా కొరకే..",
        "యేసు సిలువ మరణం"
      ],
      "english": [
        "Yoodhule soodhulai saadhuvuni shodhinchina",
        "Vembadinchuvaade Yesu evaro neneruganani",
        "Padichedina gorrenu baagu cheyutakai",
        "Siluvalo vrelaadithivi"
      ]
    }
  ]
}
