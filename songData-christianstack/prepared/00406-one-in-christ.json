{
  "song_name": "One In Christ",
  "author": {
    "Authored by": "Praveen VB",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "శ్రీమంతుడా శ్రీకరుండ శ్రీ యేసు రాజా",
      "అతి శ్రేష్ఠుడా అద్వితీయుడా అతికాంక్షనీయుడా",
      "ధవళవర్ణుడా మహోన్నతుడా",
      "పరిశుద్దుడా మృత్యుoజేయుడా",
      "జయము జయము నా యేసునికే",
      "జయము జయము నా రారాజుకే"
    ],
    "english": [
      "Sreemanthudaa sreekarunda sree yesu raajaa",
      "athi sreshtudaa adhvitheeyudaa athikaankshaneeyudaa",
      "dhavalavarnnudaa mahonnathudaa",
      "parishudhudaa mruthyumjeyudaa",
      "jayamu jayamu naa yesunike",
      "jayamu jayamu naa raaraajuke"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదిలో ఉన్నవాడా ఆది సంభూతుడ",
        "విశ్వమంతా వ్యాపించిన సృష్టి కర్తా",
        "సింహాసనాసీనుడా శక్తి సంపన్నుడా",
        "మహిమ నీకే ఘనత నీకే",
        "స్తుతులు నీకే నా యేసయ్య"
      ],
      "english": [
        "Aadhilo unnavaadaa aadhi sambhoothuda",
        "visvamanthaa vyapinchina srushti karthaa",
        "simhaasanaaseenudaa sakthi sampannudaa",
        "mahima neeke ghanatha neeke",
        "sthuthulu neeke naa yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కృపాసమృద్ధిగలవాడ ప్రేమామయుడా",
        "బలవంతుడైన పరాక్రముడా శక్తిమంతుడా",
        "దీర్ఘశాంతముగలవాడా సమాధానమిచ్చువాడా",
        "జయ గీతము నీకై పాడెదము",
        "నాట్యము చేసి ఆనందించేదం"
      ],
      "english": [
        "Krupaasamrudhigalavaada premaamayudaa",
        "balavanthudaina paraakramudaa sakthimanthudaa",
        "dheerghasaanthamugalavaadaa samaadhaanamicchuvaadaa",
        "jaya geethamu neekai paadedhamu",
        "naatyamu chesi aanandhinchedham"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "లోకాధిపతి సర్వోన్నతుడా కారణ జన్ముడా",
        "లోకానికి వెలుగైనవాడా తేజోమయుడా",
        "దయాదాక్షిణ్యపూర్ణుడా మహిమాన్వితుడా",
        "ఘనతకు పాత్రుడ నీవయ్యా",
        "గళమెత్తి నిన్ను పొగడెదమయ్య"
      ],
      "english": [
        "Lokaadhipathi sarvonnathudaa kaaranna janmudaa",
        "lokaaniki velugugainavaadaa thejomayudaa",
        "dhayaadhaakshinnyapoornudaa mahimaanvithudaa",
        "ghanathaku paathuda neevayyaa",
        "gallmetthi ninnu pogadedhamayya"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "స్తుతులపై ఆశీనుడా స్తుతులకు పాత్రుడా",
        "మేఘారుడై వచ్చుచున్నవాడ మహిమ స్వరూపుడా",
        "వేవేల దూతల సమూహము నిను కీర్తించి కొనియాడుచుంటిరి",
        "పరిశుద్ధుడు పరిశుద్ధుడని మా స్వరములతో నిను కీర్తించేధం"
      ],
      "english": [
        "Sthuthulapai aaseenudaa sthuthulaku paathrudaa",
        "meghaarudai vacchuchunnavaada mahima svaroopudaa",
        "vevela dhoothala samoohamu ninnu keerthinchi koniyaaduchuntiri",
        "parishuddhudu parishuddhudani maa svaramulalo ninu keerthinchedham"
      ]
    }
  ]
}
