    "english": [
      "Nee vishwaasa naavalo Yesu unnaadaa - Aayana koorchunna naavalo neevu unnaava",
      "Thelusukonumu o manasaa thelusukonumu",
      "Idhe anukoola samayamu Yesudhvaara"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాప లోకంలో! పాప లోకంలో",
