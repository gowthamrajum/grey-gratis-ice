{
  "song_name": "Saageda Nenu Yesunilo",
  "author": {
    "Authored by": "Dr. John Wesley",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సాగెద నేను యేసునిలో శ్రమయైన కరువైనా",
      "కృంగిపోను ఏనాడు కొదువ లేదు నా యేసులో",
      "యేసు నాతో ఉంటే నాకు సంతోషమే",
      "యేసు నాలో ఉంటే నాకు సమాధానమే"
    ],
    "english": [
      "Saagedha nenu yesunilo sremaina karuvaina",
      "krungiponu ainaadu kodhuva ledu naa yesulo",
      "yesu naatho unte naaku santhoshame",
      "yesu naalo unte naaku samaadhaaname"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తన రూపములో నను చేసికొని",
        "తన రక్తముతో పరిశుద్ధ పరచి",
        "నూతన క్రియలు నాలో చేసి",
        "నా దోషములను క్షమించిన",
        "తన రాజ్యములో నను చేర్చుకొని",
        "పరిశుద్ధాత్మతో అభిషేకమిచ్చి",
        "పర్వతములు తొలగిపోయిన",
        "భయపడకు అని వాగ్ధానమిచ్చిన"
      ],
      "english": [
        "Thana roopamulo nanu chesikoni",
        "thana rakthamutho parishuddha parachi",
        "noothana kriyalu naalo chesi",
        "naa dhoshamulanu kshaminchina",
        "Thana raajyamulo nanu cherchukoni",
        "parishuddathmatho abhishekamichi",
        "parvathamulu tholagipoyina",
        "bayapadaku ani vaagdhaanamichina"
      ]
    }
  ]
}
