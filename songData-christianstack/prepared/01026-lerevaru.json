  "main_stanza": {
    "telugu": [
      "వేదన తొలగించువాడు యేసే",
      "నా కన్నీటిని తుడచివేయును",
      "క్రుంగిన హృదయపు లోతులలో",
      "ఆనందము నింపునాయనే",
      "శోదనలో జయమిచ్చువాడు యేసే",
      "నా పక్షముగా పోరాడును",
      "ప్రతికూల సమయము లెదురైన",
      "ప్రతిక్షణమున తోడు ఆయనే"
    ],
    "english": [
      "Vedhana tholaginchu vadu yese",
      "na kannitini thudichi veyunu",
      "krungina hrudhayapu lothulalo",
      "aanandhamu nimpu nayene",
      "shodhanlo jayamichu vadu yese",
      "na pakshamuga poradunu",
      "prathikula samayamu ledhuraina",
      "prathi kshanamuna thodu aayene"
    ]
  },
  "stanzas": [
