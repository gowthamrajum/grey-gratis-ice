{
  "song_name": "Yaesunaadhaa Raaraaraa Maa Jee",
  "author": {
    "Authored by": "",
    "రచన": "ఫిలిప్ బెంజమిన్"
  },
  "main_stanza": {
    "telugu": [
      "యేసునాధా రారారా మా జీవనాధా రారారా||"
    ],
    "english": [
      "yaesunaaDhaa raaraaraa maa jeevanaaDhaa raaraaraa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దోసములు బాప నీవు వాసిగ జన్మించినావు ||యేసు||"
      ],
      "english": [
        "dhoasamulu baapa neevu vaasiga janmiMchinaavu ||yaesu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీచులను బ్రేమించి నీ కరుణఁ జూపినావు ||యేసు||"
      ],
      "english": [
        "neechulanu braemiMchi nee karuNAO joopinaavu ||yaesu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీతిలేని వారి కెల్ల నిత్యజీవ మిచ్చినావు ||యేసు||"
      ],
      "english": [
        "neethilaeni vaari kella nithyajeeva michchinaavu ||yaesu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పొందరాని కష్టములను బొంది యుంటివి తండ్రి ||యేసు||"
      ],
      "english": [
        "poMdharaani kaShtamulanu boMdhi yuMtivi thMdri ||yaesu||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "లోకపాపమును జయించి లోకుల రక్షించితివి ||యేసు||"
      ],
      "english": [
        "loakapaapamunu jayiMchi loakula rakShiMchithivi ||yaesu||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వేడుకతోడ మేము వేఁడుకొందుమో తండ్రి ||యేసు||"
      ],
      "english": [
        "vaedukathoada maemu vaeAOdukoMdhumoa thMdri ||yaesu||"
      ]
    }
  ]
}
