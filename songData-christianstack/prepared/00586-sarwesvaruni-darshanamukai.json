{
  "song_name": "Sarwesvaruni Darshanamukai",
  "author": {
    "Authored by": "Pastor Nithin Parvathaneni",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సర్వేశ్వరుని దర్శనముకై",
      "ఉదయమునే మ్రొక్కి వేచిఉంటిని",
      "ప్రాణేశ్వర నా ప్రాణ ప్రియుడా",
      "నీ మహిమతో నన్ను దర్శించుమా",
      "సర్వేశ్వరా నా ఆత్మ రక్షకా",
      "నీ దివ్య స్వరముతో మట్లాడుమా"
    ],
    "english": [
      "Sarwesvaruni dharshanamukai",
      "udhayamune mrokki vechiyuntine",
      "praaneshwaraa naa praana priyudaa",
      "nee mahimatho nannu dharshinchumaa",
      "sarweshwaraa naa athma rakshakaa",
      "nee divya swaramutho maatlaadumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమాత్ముడా లోక పరిపాలకా",
        "ఘన మహిమ గలవాడా, గణనీయుడా",
        "సర్వాంతర్యామివి నీవే యెహోవా",
        "సర్వాధికారివి జనయత దైవమా",
        "రాజాధి రాజా మా రక్షణ శృంగమా",
        "రమణీయ సామ్రాజ్య పరిపాలకా",
        "ప్రేమించే క్షమదాత నీవేనయ్యా",
        "ప్రార్ధనలు ఆలించే మా యేసుయ్య",
        "ఆల్ఫా ఒమేగా ఆది అనంతుడా",
        "ఆదరణ కర్త అదృశ్యదైవమా",
        "సత్యస్వరూపివి నీవేనయ్యా",
        "ఆత్మాభిషేకముతో నింపుమా"
      ],
      "english": [
        "Paramaathmudaa loka paripaalakaa",
        "ghanamahima gala vaada gananeeyudaa",
        "sarvaantharyaamivi neeve yehovaa",
        "sarvaadhikaarivi janayatha dhaivama",
        "Raajaadhi raja ma rakshana shrungamaa",
        "ramaneeya samraajya paripaalakaa",
        "preminche kshamadhatha neevenayyaa",
        "praardhanalu aalinche maa yesayyaa",
        "Alpha omega aadhi ananthudaa",
        "aadharana kartha adhrushya daivamaa",
        "satya swaroopivi neevenayyaa",
        "aathmaabhishekamu tho nimpumaa"
      ]
    }
  ]
}
