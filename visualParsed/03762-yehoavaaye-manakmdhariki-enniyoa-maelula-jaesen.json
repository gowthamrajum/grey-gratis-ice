  "main_stanza": {
    "telugu": [
      "యెహోవాకు చేసిన వాటినన్నిటిని బట్టి ... నేను ప్రకటన చేసెదను యెషయా ఐజయా 63:7",
      "యెహోవాయె మనకందరికి - ఎన్నియో మేలుల జేసెన్",
      "తన కృప కనికరముల్ - స్మరియించి స్తుతించెదము"
    ],
    "english": [
      "Yehovaaku chesina vaatinannitini batti ... nenu prakatana chesedanu Yeshayaa Isaiah 63:7",
      "Yehovaaye manakandhariki - Enniyo melula jesen",
      "Thana krupa kanikaramul - Smariyinchi sthuthinchedamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మనమాయన జనము - ఆయన సంతతియు",
