{
  "song_name": "Kanneelle Khayamani",
  "author": {
    "Authored by": "Tinnu Thereesh",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కన్నీళ్ళే ఖాయమని – శ్రమలతో సహవాసమని",
      "ఇంకెంత కాలం ఈ బ్రతుకని – భీతితో ఉన్నావా?",
      "నీ కన్నీళ్ళన్నీ కవిలలో దాచి – శ్రమలలో నీ తోడై ఉండి",
      "ఊహకు మించిన కార్యములన్నీ – నా యేసు చేయును",
      "విశ్వసించుము – నిరీక్షణ కలిగి ఉండుము",
      "నీ జీవితమే మలుపు తిరుగునని"
    ],
    "english": [
      "Kannelle khaayamani shramalatho sahavaasamani",
      "Inkentha kaalami brathukani bheethitho unnaavaa",
      "Nee kanneellanni buddilo dhaachi shramalalone thodaiyundi",
      "Oohaku minchina kaaryamulanni naa Yesu cheyunu",
      "Vishvasinchumu… nireekshana kaligi yundumu",
      "Nee jeevithame malupu thirugunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నెమ్మదినిచ్చే నమ్మకమైన దేవుడుండగా",
        "చేయి విడువని ఇమ్మానుయేలు",
        "నీ సమీపమునుండగా",
        "భీతి చెందకుము",
        "భారము కలిగి ప్రార్ధన చేయుము",
        "సంకోచించుట మాని స్తుతి చేయుము"
      ],
      "english": [
        "Nemmadhinicche nammakamaina devudundagaa",
        "Cheyi viduvani Immaanuyelu nee sameepamu nundagaa",
        "Bheethi chendhakumu bhaaramu kaligi praarthana cheyumu",
        "Sankochinchuta maani sthuthi cheyumu",
        "Sarvamu kolpoyinaa anukunnavare dhooramainaa",
        "Yobu jeevithaanni marichithivaa.. nireekshana kaligi undumu"
      ]
    }
  ]
}
