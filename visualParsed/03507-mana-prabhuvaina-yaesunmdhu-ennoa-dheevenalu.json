{
  "song_name": "Mana prabhuvaina Yesunandu enno deevenalu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మన ప్రభువైన యేసునందు - ఎన్నో దీవెనలు"
    ],
    "english": [
      "Mana prabhuvaina Yesunandu - Enno deevenalu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ముందుగా నిర్ణయించబడి - తనచే ఏర్పరచబడిన",
        "తనయులుగాను స్వీకరించబడి - ధన్యులయ్యెదరు వారే"
      ],
      "english": [
        "Mundugaa nirnayinchabadi - Thanache erparachabadina",
        "Thanayulugaanu sweekarinchabadi - Dhanyulayyedharu vaare"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అపరాధములు క్షమించబడి - ప్రభు రక్తముచే కొనబడిన",
        "కృపద్వారా రక్షింపబడెదరు - ధన్యులయ్యెదరు వారే"
      ],
      "english": [
        "Aparaadhamulu kshaminchabadi - Prabhu rakthamuche konabadina",
        "Krupadhwaaraa rakshimpabadedharu - Dhanyulayyedharu vaare"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మనో నేత్రములు వెలిగింపబడి - ఘనముగా ప్రభుచే పిలువబడి",
        "తన భక్తులతో స్వాస్థ్యము పొంది - ధన్యులయ్యెదరు వారే"
      ],
      "english": [
        "Mano nethramulu veliginpabadi - Ghanamugaa Prabhuche piluvabadi",
        "Thana bhakthulatho swaasthyamu pondi - Dhanyulayyedharu vaare"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నిర్మలము - మరి అక్షయము - విరివిగ వాడ బారనిది",
        "పరలోకములో స్వాస్థ్యము కలిగి - ధన్యులయ్యెదరు వారే"
      ],
      "english": [
        "Nirmalamu - Mari akshayamu - Viriviga vaadabaaranidhi",
        "Paralokamulo swaasthyamu kaligi - Dhanyulayyedharu vaare"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కన్నులకు కనిపించనివి - వినిపించనివి చెవులకును",
        "మనో గోచరము కానివి పొంది - ధన్యులయ్యెదరు వారే"
      ],
      "english": [
        "Kannulaku kanipinchanivi - Vinipinchanivi chevulakunu",
        "Mano gocharamu kaanivi pondi - Dhanyulayyedharu vaare"
      ]
    }
  ]
}
