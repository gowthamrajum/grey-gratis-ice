{
  "song_name": "Mamathaanuraagaale maalalugaa",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "మమతానురాగాలే మాలలుగా",
      "సమతానుబంధాలే ఎల్లలుగా",
      "కట్టబడిన కాపురం - అనురాగ గోపురం",
      "ఈ పరిణయం - యెహోవా నిర్ణయం"
    ],
    "english": [
      "Mamathaanuraagaale maalalugaa",
      "Samathaanubandhaale ellalugaa",
      "Kattabadina kaapuram - Anuraaga gopuram",
      "Ee parinayam - Yehovaa nirnayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వరుడైన క్రీస్తు వధువైన సంఘమును",
        "ఎంతగానో ప్రేమించి ప్రాణమునే అర్పించె",
        "అటువలెనే పురుషుడు కూడా తన స్వంత దేహమువోలె",
        "భార్యను ప్రేమించ వలెనని యేసయ్య ఏర్పరచినది"
      ],
      "english": [
        "Varudaina Kreesthu vadhuvaina sanghamunu",
        "Enthagaano preminchi praanamune arpinche",
        "Atuvalene purushudu koodaa thana swantha dehamuvole",
        "Bhaaryanu preminchа valenani Yesayya erparachinadhi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కుమారుడు క్రీస్తు శిరస్సైన తండ్రికి",
        "అన్నివేళలందు విధేయత చూపె",
        "అటువలెనే స్త్రీ కూడా శిరస్సైన పురుషునికి",
        "అన్నిటిలో విధేయురాలిగ ఉండునట్లు ఏర్పరచినది"
      ],
      "english": [
        "Kumaarudu Kreesthu shirassaina thandriki",
        "Annivelalandu vidheyatha choope",
        "Atuvalene sthree koodaa shirassaina purushuniki",
        "Annitilo vidheyuraaliga undunatlu erparachinadhi"
      ]
    }
  ]
}
