{
  "song_name": "Nee Premanu Minchina",
  "author": {
    "Authored by": "James Lazarus Narukurthi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ ప్రేమను మించిన ప్రేమే లేదయ్య",
      "నీ ప్రేమకు సాటి లేనేలేదయ్యా",
      "నీ ప్రేమే‌ నాలో చిగురించెను",
      "నీ ప్రేమే నాలో ఫలియించెను",
      "యేసయ్యా యేసయ్యా యేసయ్యా ప్రేమామయ",
      "యేసయ్యా యేసయ్యా యేసయ్యా కరుణామయ"
    ],
    "english": [
      "Nee premanu minchina preme ledhayya",
      "Nee premaku saati leneladhayya",
      "Nee preme naalo chigurinchenu",
      "Nee preme naalo phaliyinchenu",
      "Yesayya Yesayya Yesayya premaamaya",
      "Yesayya Yesayya Yesayya karunaamaya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోకమే నన్ను ధ్వేషించినను",
        "నీ ప్రేమే నన్ను ఆదరించెను",
        "నా స్నేహితులే నను మోసగించినా",
        "నన్ను విడువక ఎడబాయక నా తోడే నిలిచితివి"
      ],
      "english": [
        "Ee lokame nannu dhveshinchinanu",
        "Nee preme nannu aadharinchenu",
        "Naa snehithule nanu mosaginchinaa",
        "Nannu viduvaka edabaayaka naa tode nilichithivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఈ లోకపు ఆశలలో పడిన నన్ను",
        "నీ ప్రేమతో నన్ను పిలిచినావయ్య",
        "నా పాపమాలిన్యమును కడిగివేసి",
        "నీ వారసునిగా నను చేసుకుంటివి"
      ],
      "english": [
        "Ee lokapu aashalalo padina nannu",
        "Nee prematho nannu pilichinaavayya",
        "Naa paapamaalinyamunu kadigi vesi",
        "Nee vaarasunigaa nanu chesukuntivi"
      ]
    }
  ]
}
