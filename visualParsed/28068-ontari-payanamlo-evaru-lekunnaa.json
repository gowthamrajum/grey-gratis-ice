      "ఈ పయనం ఆగనే ఆగదు యేసు",
      "నా అడుగు జారనే జారదు"
    ],
    "english": [
      "Ontari payanamlo evaru lekunnaa",
      "Andaru nanu vidichi dhoorampothunnaa",
      "Neeve thodundagaa nee sannidhi ventundagaa",
      "Ee payanam aagane aagadu Yesu",
      "Naa adugu jaarane jaaradhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
