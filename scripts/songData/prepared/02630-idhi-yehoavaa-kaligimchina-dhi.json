{
  "song_name": "Idhi Yehovaa Kaliginchina Dhinamu",
  "author": {
    "Authored by": "",
    "రచన": "పురుషోత్తమ చౌధరి"
  },
  "main_stanza": {
    "telugu": [
      "ఇది యెహోవా కలిగించిన దినము సుదివసంబునను",
      "జొప్పడు గడియలు కొదువలేని దయ గుల్కెడు వానివి"
    ],
    "english": [
      "Idhi Yehovaa Kaliginchina Dhinamu Sudhivasambunanu",
      "Joppadu Gadiyalu Kodhuvalaeni Dhaya Gulkedu Vaanivi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మోక్షము భూమియు సమ్మోద మంది నుతులక్షరు",
        "గద్దె చుట్టు నాక్రమింతురు గాక"
      ],
      "english": [
        "Mokshamu Bhoomiyu Sammodha Mandhi Nuthulaksharu",
        "Gadhdhe Chuttu Naakraminthuru Gaaka"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అతఁడీ దినమంచంత మొందు నర వితతి",
        "నుండి వే వేగ వచ్చెను"
      ],
      "english": [
        "Athadee Dhinamanchantha Mondhu Nara Vithathi",
        "Nundi Vae Vaega Vachchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆ పిశాచ రా రాజ్యంబు కూలినది",
        "ఆ పరేశు విజయము లీ దినమున"
      ],
      "english": [
        "Aa Pishaacha Raa Raajyambu Koolinadhi",
        "Aa Paraeshu Vijayamu Lee Dhinamuna"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సేవక వరులు విలసింపఁగఁ జేసి యా",
        "పావనాద్భుతములఁ బ్రచురముఁ జేయుదు"
      ],
      "english": [
        "Saevaka Varulu Vilasimpaga Jaesi Yaa",
        "Paavanaadhbhuthamula Brachuramu Jaeyudhu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "దావీదుని వర తనయుఁడై యభిషేకావృతుఁడౌ",
        "రాజా గ్రణికి హోసన్నా"
      ],
      "english": [
        "Dhaaveedhuni Vara Thanayudai Yabhishaekaavruthudau",
        "Raajaa Graniki Hosannaa"
      ]
    }
  ]
}
