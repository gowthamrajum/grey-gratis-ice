  "main_stanza": {
    "telugu": [
      "మహిమోన్నతుడు సర్వశక్తిమంతుడు",
      "నీకు అసాధ్యమంటు లేనేలేదు",
      "నీ రాజ్యం గొప్పది నీ తలంపులు ఉన్నతం",
      "నీలాంటి దేవుడు లేనే లేడు",
      "నీ కృప చేత నను హత్తుకొని",
      "నా చేయి పట్టి నన్ను నడిపించావు",
      "నీ ప్రేమ వాత్సల్యం నాపై చూపి",
      "ఎడబాయని కృపతో నను హెచ్చించావు",
      "నా యేసయ్యా నా సర్వోన్నతుడా",
      "నా యేసయ్యా స్తుతులకు పాత్రుడా",
      "బంధకాలను తెంచివేసిన శక్తిమంతుడా నీకే స్తుతులు",
      "ఈ లోక మాలిన్యం దూరపరచిన నజరేయుడా నీకే వందనం",
      "పక్షి రాజువలె నీ రెక్కలపై మోసితివే",
      "శ్రమ అయినా బాధైనా నన్ను ఓదార్చి హత్తుకుంటివే",
      "నా యేసయ్యా నా సర్వోన్నతుడా",
      "నా యేసయ్యా స్తుతులకు పాత్రుడా"
    ],
