  "main_stanza": {
    "telugu": [
      "యూదా బెత్లెహేమా – నీవెంతటి దానవే",
      "యేసు నాదుడు – ఉదయించేనే నీలో",
      "క్రిస్తు రాజు జన్మించేనే"
    ],
    "english": [
      "Lyrics:",
      "Yudah Bethlehema – neeventati danave",
      "Yesu nadhudu vudhayinchene nee lo –",
      "Kristu Raju janminchene"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోక మేతించేనే – దూతాలే పాట పాడేనే",
        "పరలోక మేతించేనే – దూతాలే పాట పాడేనే",
        "మహా ఆనందమే- గొప్ప ఆర్భాటమే",
        "యేసు రాజు జన్మించిన – ఈ దినమే"
      ],
      "english": [
