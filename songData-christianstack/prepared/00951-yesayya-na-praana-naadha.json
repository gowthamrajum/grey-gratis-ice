{
  "song_name": "Yesayya Na Praana Naadha",
  "author": {
    "Authored by": "Kranthi Chepuri",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసయ్య నా ప్రాణనాథా నిను",
      "ఆడి పాడి కీర్తించెదను",
      "నీవే నా జీవాదాత అని",
      "లోకమంతా చాటించెదను"
    ],
    "english": [
      "Yesayya naa praana naathaa ninu",
      "aadi paadi keerthinchedhanu",
      "neeve naa jeevaadaatha ani",
      "lokamantha chaatinchedhanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వశక్తిమంతుడా సర్వాధికారి",
        "సర్వలోకమును సృష్టించిన సుందరుడా",
        "స్తుతి మహిమ ఘనతా నీకే అని",
        "సంతసించి స్తోత్రించెదను",
        "పాపమే ఎరుగని నీతిమంతుడా",
        "పాపిని రక్షించిన నీతిసూర్యుడా",
        "పరిశుద్ధ పరలోక తండ్రి అని",
        "పరవశించి నే పాడెదన్",
        "ఆది అంతమైన అల్ఫా ఓమేగా",
        "మేఘముపై రానున్న మహిమోన్నతుడా",
        "ఉన్నవాడవు అనువాడవు నీవని",
        "ఉల్లసించి ఆరాధింతును"
      ],
      "english": [
        "Sarvasakthimanthuda sarvaadhikaari",
        "sarvalokamunu srustinchina sundarudaa",
        "sthuthi mahima ghanathaa neeke ani",
        "santhasinchi sthothrinchedanu",
        "Paapame erugani neethimanthudaa",
        "paapini rakshinchina neethisuryudaa",
        "parishuddha paraloka thandri ani",
        "paravasinchi ne paadedan",
        "Aadi anthamaina alphaa Omegaa",
        "meghamupai raanunna mahimonnathuda",
        "unnavaadavu anuvaadavu neevani",
        "ullasinchi aaraadhinthunu"
      ]
    }
  ]
}
