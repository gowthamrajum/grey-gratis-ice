  },
  "main_stanza": {
    "telugu": [
      "నడిపించాయా నడిపించాయా యేసు నీ సన్నిధిలోకి నడిపించాయా…",
      "నడిపించాయా నడిపించాయా చాపిన నీ హస్తముతోటి నడిపించాయా…"
    ],
    "english": [
      "Nadipinchaya nadipinchaya Yesu nee sannidhiloki",
      "Nadipinchayya nadipinchayya",
      "Nadipinchayya chaapina nee hasthamu thoti nadipinchayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ తలుపు అడుగుకే వేచివున్న",
        "కాలీ హస్తముతో",
        "నా తలవంచుతూ వస్తున్నా",
        "నీ సన్నిధానములో"
      ],
      "english": [
        "Nee thalupu aduguke veechiyunna kaali hasthamutho",
        "Naa thalavanchutho vasthunna nee sannidhanamulo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నన్ను వెదకి వచ్చితివా",
        "నన్ను కోరీ పిలచితివా",
        "యేసు పరలోకమైనా విడిచితివా",
        "గుంపులో ఉన్న నన్ను",
        "నీదానిగా నన్ను మార్చి",
        "నీ నామము యిచ్చివా యెషువా…"
      ],
      "english": [
        "Nanu vedaki vachchithiva",
        "nanu kori pilachithiva",
        "Yesu paralokamaina vidichithiva",
        "Gumpulo unna nannu",
        "nee daaniga nanu maarchi nee",
        "naamam ichchithiva Yesuva"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ పిలుపుకై నే వేచివున్న",
        "నన్ను నడిపించముయా",
        "నీ సేవకై నే కాచియున్న",
        "నా తలను అంటుమయ్య"
      ],
      "english": [
        "Nee pilupukaine ne veechiyunna nanu nadipinchumayya",
        "Nee sevakaine kaachiyunna naa thalanu antumayya"
      ]
    },
    {
