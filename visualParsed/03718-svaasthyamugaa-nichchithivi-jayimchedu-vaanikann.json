  },
  "main_stanza": {
    "telugu": [
      "స్వాస్థ్యముగా నిచ్చితివి జయించెడు వానికన్ని"
    ],
    "english": [
      "Swaasthyamugaa nichchithivi jayinchedu vaanikanni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవే మాకు దేవుడవై యున్నావు",
        "మేము నీదు పుత్రులమైతిమి",
        "నీ స్వంత రక్తము నిచ్చి",
        "కొన్నావు నీ సొత్తుగా"
      ],
      "english": [
        "Neeve maaku dhevudavai yunnaavu",
        "Memu needu puthrulamaithimi",
        "Nee swantha rakthamu nichchi",
        "Konnaavu nee sotthugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిన్నంగీకరించిన వారలందరిని",
        "నీ నామమందు నమ్మిన వారిన్",
        "నీ పిల్లలుగాను జేసి",
        "అధికారమిచ్చితివి"
      ],
      "english": [
        "Ninnangeekarinchina vaaralandharini",
        "Nee naamamandhu nammina vaarin",
        "Nee pillalugaanu jesi",
        "Adhikaaramichchithivi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీతో కూడా మహిమను పొందుటకు",
        "నీ శ్రమలలో పాలు పొందుటచే",
        "నీ తోటి వారసులముగా",
        "పరిగణింపబడితిమి"
      ],
      "english": [
        "Neetho koodaa mahimanu pondutaku",
        "Nee shramalalo paalu pondhutache",
        "Nee thoti vaarasulamugaa",
        "Pariganimpabadithimi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అక్షయమైన నిర్మలమైనదియు",
        "వాడబారని స్వాస్థ్యము కొరకై",
        "మరల జన్మింపగా జేసి",
        "స్థిరముగా నుంచితివి"
      ],
      "english": [
        "Akshayamaina nirmalamainadhiyu",
        "Vaadabaarani swaasthyamu korakai",
        "Marala janmimpagaa jesi",
        "Sthiramugaa nunchithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ శాసనములు హృదయానందములు",
        "అవి అన్నియు మాకు నిత్య స్వాస్థ్యముగా",
        "భావించి నిలిచి యున్నాము",
        "హల్లెలూయ గీతములతో"
      ],
      "english": [
        "Nee shaasanamulu hrudhayaanandhamulu",
        "Avi anniyu maaku nithya swaasthyamugaa",
