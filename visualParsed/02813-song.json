  "main_stanza": {
    "telugu": [
      "జాగ్రత జాగ్రత",
      "యేసుఁ డిట్లు పిల్చున్",
      "నేఁడు పో పనిచేయి",
      "నాదు వనములో",
      "ఆయనే ముందు వె",
      "ళ్లి మా త్రోవ చూపున్",
      "కాగ జాగ్రతతో",
      "పని చేయుదుము.",
      "||పని చేయి, పని చేయి",
      "కోరుచు కాచుచు",
      "నూయేసు వచ్చు మట్టుకు||"
    ],
    "english": [
      "Jaagratha jaagratha",
      "Yesu ditlu pilchun",
      "Nedu po panicheyi",
      "naadu vanamulo",
      "Aayane mundu ve",
      "lli maa throva choopun",
      "Kaaga jaagrathatho",
      "pani cheyudhumu.",
      "||Pani cheyi, pani cheyi",
      "koruchu kaachuchu",
      "nooYesu vachchu mattuku||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "నీతి నాశించెడు",
        "వారి నందరిని",
        "తృప్తిపర్చెదము",
        "యేసు సిలువ నె",
        "త్తి మాధ్వజముగ",
        "రక్షణ యుచితం",
        "బని చాటింతుము."
      ],
      "english": [
        "Neethi naashinchedu",
        "vaari nandharini",
        "thrupthiparchedhamu",
        "Yesu siluva ne",
        "tthi maadhvajamuga",
        "rakshana yuchitham",
        "bani chaatinthumu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వచ్చి పోరాడుడీ",
        "దుష్ట సాతాను రా",
        "జ్యంబు పాడగును",
        "యేసు నామ ప్రఖ్యా",
        "తిని శ్లాఘింపుడీ",
        "ఆయన రక్షణ",
        "యుచితంబగును."
      ],
      "english": [
        "Vachchi poraadudee",
        "dushta saathaanu raa",
        "jyambu paadagunu",
        "Yesu naama prakhyaa",
        "thini shlaaghimpudee",
        "Aayana rakshana",
        "yuchithambagunu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసు శక్తి నిచ్చున్",
        "గెల్చువారికి జీ",
        "వ కిరీటం బగున్",
        "మోక్షానందములో",
        "నివసించువారై",
        "రక్షణ యుచితం",
        "బని పాడెదము"
      ],
      "english": [
        "Yesu shakthi nichchun",
        "gelchuvaariki jee",
        "va kireetam bagun",
        "Mokshaanandhamulo",
        "nivasinchuvaarai",
        "rakshana yuchitham",
        "bani paadedamu"
      ]
    }
  ]
