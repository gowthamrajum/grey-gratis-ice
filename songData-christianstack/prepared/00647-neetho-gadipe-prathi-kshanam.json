{
  "song_name": "Neetho Gadipe Prathi Kshanam",
  "author": {
    "Authored by": "Pastor Jyothi Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీతో గడిపే ప్రతి క్షణము",
      "ఆనంద బాష్పాలు ఆగవయ్యా",
      "కృప తలంచగా మేళ్లు యోచించగా",
      "నా గలమాగదు స్తుతించక – నిను కీర్తించక",
      "యేసయ్యా యేసయ్యా – నా యేసయ్యా"
    ],
    "english": [
      "Neetho gadipe prathi kshanam",
      "aanandha baashpaalu aagavayyaa",
      "krupa thalanchagaa maillu yochinchagaa",
      "naa galamaagadhu sthuthinchaka ninu keerthinchaka",
      "Yesayya Yesayya – na Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మారా వంటి నా జీవితాన్ని",
        "మధురముగా మార్చి ఘనపరచినావు",
        "నా ప్రేమ చేత కాదు",
        "నీవే నను ప్రేమించి",
        "రక్తాన్ని చిందించి",
        "నన్ను రక్షించావు",
        "గమ్యమే లేని ఓ బాటసారిని",
        "నీతో ఉన్నాను భయము లేదన్నావు",
        "నా శక్తి చేత కాదు",
        "నీ ఆత్మ ద్వారానే",
        "వాగ్ధానము నెరవేర్చి",
        "వారసుని చేసావు"
      ],
      "english": [
        "Maaraa vanti naa jeevithaanni",
        "madhuramugaa maarchi ghanaparachinaavu",
        "na prema chetha kaadhu",
        "neeve nanu preminchi",
        "rakthaanni chindhinchi",
        "nannu rakshinchaavu",
        "Gamyame leni oh baatasaarini",
        "neetho unnaanu bhayamu ledhannaavu",
        "naa shakthi chetha kaadu",
        "nee aathma dhwaarane",
        "vaagdhaanamu neraverchi",
        "vaarasuni chesaavu"
      ]
    }
  ]
}
