  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు మమ్ము నడిపించు, నీదు కాపు కావలెన్",
        "నీవు మమ్మును బోషించు - మమ్ము జేర్చు దొడ్డిలోన్",
        "యేసునాథా! ప్రియనాథా! మమ్ము విమోచింపుమా"
      ],
      "english": [
        "Yesu mammu nadipinchu, needu kaapu kaavalen",
        "Neevu mammunu boshinchu - Mammu jerchu dhoddilon",
        "Yesunaathaa! priyanaathaa! mammu vimochimpumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మమ్ము నాదరించు యేసూ - మాకు పాలకుండవు",
        "పాప మార్గమందు నుండి - ప్రేమతో దప్పించుమీ",
        "యేసునాథా! ప్రియనాథా! మొఱనాలకించుమా"
      ],
      "english": [
        "Mammu naadharinchu Yesoo - Maaku paalakundavu",
        "Paapa maargamandu nundi - Prematho dhappinchumee",
        "Yesunaathaa! priyanaathaa! moranaalakinchumaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బీద పాపులైన మమ్ము - నీ వంగీకరింతువు",
        "మమ్మును బవిత్రపర్చి - మమ్ము విడిపించుమీ",
        "యేసునాథా! ప్రియనాథా! నిన్ను నాశ్రయింతుము"
      ],
      "english": [
        "Beeda paapulaina mammu - Nee vangeekarinthuvu",
        "Mammunu bavithraparchi - Mammu vidipinchumee",
        "Yesunaathaa! priyanaathaa! ninnu naashrayinthumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బాల్యమందు నిన్నుఁ జేరి - నిన్ను హత్తుకొందుము",
        "ప్రియ రక్షకుండ, యేసూ! నీదు ప్రేమఁజూపుమా",
        "యేసునాథా! ప్రియనాథా! మమ్మింకఁబ్రేమించుమా"
      ],
      "english": [
        "Baalyamandhu ninnu jeri - Ninnu hatthukondhumu",
        "Priya rakshakunda, Yesoo! needu premajoopumaa",
        "Yesunaathaa! priyanaathaa! mamminkabreminchumaa"
      ]
    }
  ]
}
