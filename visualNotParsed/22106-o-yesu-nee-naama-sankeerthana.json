  "main_stanza": {
    "telugu": [
      "ఓ యేసు నీ నామ సంకీర్తన",
      "అది నాదు హృదయాన ఆలాపన",
      "నీ నామ ధ్యానం",
      "నా జీవ ప్రాణం",
      "అది నాకు సర్వస్వము",
      "ఆనాటి ఏదేను పాపం",
      "నాటింది నాలోన శాపం",
      "నీ మేటి విలువైన త్యాగం",
      "తెరిచింది పరలోక ద్వారం",
      "బ్రతికించె నీ చావు నన్ను",
      "నేనేల స్తుతియింతు నిన్ను",
      "నా రక్షణ పాత్ర నెత్తి",
      "హృదయార్పణము జేతునయ్య"
    ],
    "english": []
  },
  "stanzas": []
}
