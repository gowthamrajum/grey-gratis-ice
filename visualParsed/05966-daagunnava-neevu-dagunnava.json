      "ఆ దేవుని కళ్ళను దాయలేవుగా"
    ],
    "english": [
      "Daagunnaavaa neevu daagunnaavaa sanghaanni chedipevaadaa",
      "Neevu naa kanulanu daayagalavu gaanee",
      "Aa Devuni kallanu daayalevugaa"
    ]
  },
  "stanzas": [
