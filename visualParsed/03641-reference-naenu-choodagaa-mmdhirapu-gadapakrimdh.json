  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గద్దియలో నుండి పారు - జీవపు నదినీరు",
        "ఆశీర్వాదముతో నిండి - యేసు నుండి వచ్చును",
        "జీవంపు జలనదులు - ఉచిత జీవనది",
        "రక్షకా నీ నుండి పారున్ - నాద్వారా పారనిమ్ము"
      ],
      "english": [
        "Gaddhiyalo nundi paaru - Jeevapu nadhineeru",
        "Aasheervaadhamutho nindi - Yesu nundi vachchunu",
        "Jeevampu jalanadhulu - Uchitha jeevanadhi",
        "Rakshakaa nee nundi paarun - Naadhvaaraa paaranimmu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రక్షకా నన్ను శుద్ధీకరింపుము - కాల్వగా మార్చునన్ను",
        "ఖాళీగా చేసి నన్ నింపి - లోబడుటకు నేర్పుము"
      ],
      "english": [
        "Rakshakaa nannu shuddheekarimpumu - Kaalvagaa maarchunannu",
        "Khaaleegaa chesi nan nimpi - Lobadutaku nerpumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అప్పుడే యేసు ప్రభువా - నాలో నదుల్ పారును",
        "అట్టుల నితరులు నీ - పూర్ణత నెరుగుదురు"
      ],
      "english": [
        "Appude Yesu Prabhuvaa - Naalo nadhul paarunu",
        "Attula nitharulu nee - Poornatha nerugudhuru"
      ]
    }
  ]
