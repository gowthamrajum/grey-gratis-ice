      "english": [
        "Moodava Dhinamuna Samaadhi Nundi Kartha Laechenu",
        "Thanathoadishishyulu Choochuchunda Naaroahanamaayen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జయము జయము అనుచు నీవు ప్రకటించుము",
        "నీజన్మమెల్ల యేసుని గూర్చి సాక్ష్యమీయుము"
      ],
      "english": [
        "Jayamu Jayamu Anuchu Neevu Prakatinchumu",
        "Neejanmamella Yaesuni Goorchi Saakshyameeyumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆరోహణమైనట్లు మరల వచ్చెద ననెను",
        "ఈధరణికి వేంచేయు కాలము సమీపించెను"
      ],
      "english": [
        "Aaroahanamainatlu Marala Vachchedha Nanenu",
        "Eedharaniki Vaenchaeyu Kaalamu Sameepinchenu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాడుచు నార్భాటముగ నాడు",
        "ఆవల్లభుడేసు నెదుట నిలువ నాయత్తపడుము"
      ],
      "english": [
        "Hallelooya Paaduchu Naarbhaatamuga Naadu",
