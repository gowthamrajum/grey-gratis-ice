{
  "song_name": "Premagala Thandri",
  "author": {
    "Authored by": "Anne Deborah K Mohanty",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రేమగల తండ్రి క్రుపగల ప్రభువ స్తుతిమహిమలు నీకే (2)",
      "స్తుతిమహిమలు నీకే (4)"
    ],
    "english": [
      "Prema gala thandri krupa gala prabhuva sthuti mahimalu neeke (2)",
      "sthuti mahimalu neeke (4)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గతకాలమంత మము కాచి – ప్రేమించి రక్షించి (2)",
        "నీ ప్రేమను పొగడెదను (2) (ప్రేమగల)"
      ],
      "english": [
        "Gathakaalamanta mamu kaachi preminchi rakshinchi (2)",
        "nee premanu pogadedhanu (2) (preamagala)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "Glory Honor Power (5)"
      ],
      "english": [
        "Glory Honor Power (5)"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా పేరుతో నను పిలచితివి యాజకునిగ చేసితివి (2)",
        "నీ నామము ప్రకటింతును (2) (ప్రేమగల)"
      ],
      "english": [
        "Naa pearuto nanu pilachitivi yaajakuniga chesithivi (2)",
        "nee naamamu prakatinthunu (2) (preamagala)"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీ అభిషేకం నాపై ఉంచి నీ కార్యము చూపితివి (2)",
        "నీ ప్రేమను పొగడెదను (2) (ప్రేమగల)"
      ],
      "english": [
        "Nee abhishekam naapai unchi nee kaaryamu choopithivi (2)",
        "nee premanu pogadedhanu (2) (preamagala)"
      ]
    }
  ]
}
