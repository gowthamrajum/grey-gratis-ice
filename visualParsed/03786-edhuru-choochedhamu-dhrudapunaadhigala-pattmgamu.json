{
  "song_name": "Eduru choochedhamu dhrudhapunaadhigala pattanamunakai",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఎదురు చూచెదము దృఢపునాదిగల పట్టణమునకై",
      "దేవుడే దాని శిల్పి నిర్మాణకుడు - మన ముల్లసించెదము"
    ],
    "english": [
      "Eduru choochedhamu dhrudhapunaadhigala pattanamunakai",
      "Devude daani shilpi nirmaanakudu - Mana mullasinchedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆ నగరములో ప్రభుమహానీయుడు - స్తుతులకు పాత్రుడుతానే",
        "దేవుడా పట్టణమందున గలడు - కదలడు ఎన్నటికిన్"
      ],
      "english": [
        "Aa nagaramulo Prabhumahaaneeyudu - Sthuthulaku paathruduthaane",
        "Devudaa pattanamandhuna galadu - Kadaladu ennatikin"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దృఢముగానున్న దేవుని నగరుకు - చుట్టు ప్రాకారము గలదు",
        "తన సిమ్హాసనమందున గలడు - రాజాధి రాజాయనే"
      ],
      "english": [
        "Dhrudhamugaanunna Devuni nagaruku - Chuttu praakaaramu galadu",
        "Thana simhaasanamandhuna galadu - Raajaadhi raajaayane"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభు పట్టణమున నిత్యసంతోష - శాంతి విజయములు గలవు",
        "నీతిమంతులు సదాస్తుతులు పాడెదరు - ప్రభువారితోడ నుండ"
      ],
      "english": [
        "Prabhu pattanamuna nithyasanthosha - Shaanthi vijayamulu galavu",
        "Neethimanthulu sadhaasthuthulu paadedaru - Prabhuvaarithoda nunda"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జయవంతు లందరు ఆ నగరమున - నిత్యము నివసించెదరు",
        "భూమి పునాదులు వేయకమునుపే వారికై సిద్ధపరచెన్"
      ],
      "english": [
        "Jayavanthu landharu aa nagaramuna - Nithyamu nivasinchedharu",
        "Bhoomi punaadhulu veyakamunupe vaarikai siddhaparachen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రభు పట్టణము ప్రియమైనదియు పరిశుద్ధముగా నుండు",
        "వెళ్ళగోరినచో యేసుని నమ్మి రక్షణ పొందుము"
      ],
      "english": [
        "Prabhu pattanamu priyamainadhiyu parishuddhamugaa nundu",
        "Vellagorinacho Yesuni nammi rakshana pondumu"
      ]
    }
  ]
}
