{
  "song_name": "Prabhuva Ninne Nenu",
  "author": {
    "Authored by": "Lois Raj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నిన్నే నేను",
      "మనసారా పాడుచుందున్",
      "కలిమిలో లేమిలో",
      "నాకు చాలిన దేవుడని"
    ],
    "english": [
      "Prabhuvaa ninne nenu",
      "manasaaraa paaduchundun",
      "kalimilo lemilo",
      "naaku chaalina devudani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపిని ప్రేమించి పాపము మోసి",
        "శాపమార్గము నుండి నన్ను తప్పించి",
        "జీవమార్గములో నన్ను నీవుంచి",
        "నా దేవుడవై అతిశ్రేష్టుడవై",
        "నా తండ్రిగ నీవుండి",
        "నడిపించుచున్న నీ కృపలన్నీ",
        "నే అనిశము ధ్యానింతున్",
        "తల్లి గర్భమునందు నే పడక ముందే",
        "నీదు కన్నులు నన్ను చూచి ఏర్పరచి",
        "నీదు చేతులలో నన్ను నీవుంచి",
        "నా దినములలో నీ సన్నిధిని",
        "అతి మెండుగా నాకిచ్చి",
        "నా కాపరివై కాపాడుచున్న",
        "నీ ప్రేమను స్మరియింతున్"
      ],
      "english": [
        "Paapini preminchi paapamu mosi",
        "shaapamaargamu nundi nannu tappinchi",
        "jeevamaargamulo nannu neevunchi",
        "naa dedvudavai athisreshtudavai",
        "naa thandriga neevundi",
        "nadipinchuchunna nee krupalanni",
        "ne anisamu dhyaaninthun",
        "Thalli garbamunandu ne padaka munde",
        "needhu kannulu nannu choochi erparachi",
        "needhu chethulalo nannu neevunchi",
        "naa dinamulalo nee sannidhini",
        "athi mendugaa naakichchi",
        "naa kaaparivai kaapaaduchunna",
        "nee premanu smariyinthun"
      ]
    }
  ]
}
