{
  "song_name": "Rajadhi Raju ( Sambaralu 8 )",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "వెలుగై దిగివచ్చె ప్రభు యేసు జన్మించే ఇల సూరీడు",
      "నీకోసం వచ్చాడు వెలిగించ వచ్చాడు సూరీడు"
    ],
    "english": [
      "Velugai digivachche Prabhu Yesu janmiche ila suridu",
      "Neekosam vachchaadu, veligincha vachchaadu suridu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజాధి రాజుగా లోకాన జ్యోతిగా",
        "పుట్టాడు నా యేసయ్య",
        "కనులారా చూడగా రారండి వేడగా",
        "వచ్చాడు నా మెస్సయ్య",
        "దేవాది దేవుడే ఈనాడే దీనుడై పుట్టాడు నీకోసమే",
        "ఈ గొప్ప కానుక సంతోష వేడుక చెయ్యాలి ఆర్భాటమే"
      ],
      "english": [
        "Raajaadhi raajugaa, lokaana jyothigaa",
        "Puttadu naa Yesayya",
        "Kanulaara choodagaa, raarandi vedagaa",
        "Vachchaadu naa Messayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నిన్ను కాపాడగా ప్రేమ చూపించగా",
        "మన ప్రభుయేసు ఉదయించెనే",
        "నిన్ను రక్షించగా ఇల దీవించగా",
        "ఈ పుడమందు జనియించెనే",
        "నిను కరుణించ అరుదెంచెనే"
      ],
      "english": [
        "Devaadhi Devude, eenaade deenudai",
        "Puttadu neekosame",
        "Ee goppa kaanuka, santhosha veduka",
        "Cheyyaali aarbaatame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆకాశాన – ఆనందాలే – పలికెను",
        "ఈ రేయిలో – యేసే పుట్టాడనీ",
        "ఊరు వాడ – పొంగి పోయే- నేడే ఓ సంబరం",
        "మెరిసే తార – దారే చూపీ – చేసే ఆడంబరం"
      ],
      "english": [
        "Ninnu kaapaadaga prema choopinchaga",
        "Mana Prabhu Yeshu udayinchene",
        "Ninnu rakshinchaaga ila deevinchaga",
        "Ee pudamandu janiyinchene",
        "Ninu karunincha arudhenchene"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఉరకలు వేసి యేసుని చూడ వచ్చే గొల్లలు",
        "దరువులు వేసి చాటారండి శుభవార్తను",
        "శిశువును చూసి ఆరాధించి పాడే దూతలు",
        "కానుకలిచ్చి వేడారండీ ఆ జ్ఞానులు"
      ],
      "english": [
        "Aakaashaana aanandaale palikenu",
        "Ee reyilo Yesaye puttaadani",
        "Ooru vaada pongi poye nede o sambaram",
        "Merise thaara daare choopi chese aadambaram"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పుట్టాడండీ – పూజించండీ – పసి బాలునీ",
        "మారాజు నీవేనని- మా రారాజు నీవేననీ"
      ],
      "english": [
        "Urakalu vesi Yesuni chooda vachche gollalu",
        "Daruvulu vesi chataarandi shubhavarthanu",
        "Shishuvunu choosi aaradhinchi paade doothalu",
        "Kaanukalichchi vedaarandi aa gnaanulu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "క్రీస్తే జీవం – ఆశా దీపం – వెలిసెను",
        "నీ తోడుగా – ఇమ్మానుయేలుగా",
        "మంచే లేని – ఈ లోకాన – నీకై దిగి వచ్చెనే",
        "మహిమే వీడి – మనసే కోరీ – నీలో వసియించెనే"
      ],
      "english": [
        "Puttaadandi – poojinchandi – pasi baaluni",
        "Maa raaju neevenani – maa Raaraaju neevenani"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "వెలుగును నింపే సూరీడల్లే వచ్చాడేసయ్యా",
        "మమతలు పంచె చంద్రునిమల్లే చేరాడయ్యా",
        "కలతను బాపి నెమ్మదినిచ్చి కాచే దేవుడు",
        "కపటము లేని దయ గల వాడే నా దేవుడు"
      ],
      "english": [
        "Kreesthe jeevam – aasha deepam – velisenu",
        "Nee toadugaa Immaanuyelugaa",
        "Manche leni ee lokaana neekai digivachchene",
        "Mahime veedi manase koori neelo vasiyinchene"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "పుట్టాడండీ – పూజించండీ – ప్రభు యేసునీ",
        "మారాజు నీవేనని- మా రారాజు నీవేననీ"
      ],
      "english": [
        "Velugunu nimpe suridalle vachchaadesayya",
        "Mamatale panche chandrunimalle cheradayya",
        "Kalathanu baapi nemmadinichchi kaache Devudu",
        "Kapatamuleeni daya gala vaade naa Devudu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [],
      "english": [
        "Puttaadandi – poojinchandi – Prabhu Yesuni",
        "Maa raaju neevenani – maa Raaraaju neevenani"
      ]
    }
  ]
