{
  "song_name": "Deva nee krupatho nannu karuninchumaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవా నీ కృపతో నన్ను కరుణించుమా",
      "దేవా నీ మాటతో నన్ను బలపరుచుమా"
    ],
    "english": [
      "Deva nee krupatho nannu karuninchumaa",
      "Deva nee maatatho nannu balaparuchumaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దినమెల్ల నా కొరకు నా శత్రువు పొంచియుండ",
        "భయము దిగులు నన్ను ఆవరించియుండగా",
        "నీ వాక్యమే నా ద్యానమై నీ వాక్యమే ఆదారమై",
        "నీ చేతి నీడలో నే దాగియుంటిని"
      ],
      "english": [
        "Dinamella naa koraku naa shathruvu ponchiyunda",
        "Bhayamu digulu nannu aavarinchiyundagaa",
        "Nee vaakyame naa dhyaanamai nee vaakyame aadhaaramai",
        "Nee chethi needalo ne daagiyuntini"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దినమెల్ల మరణ భయము నన్ను ఇలలో తరుముచుండగా",
        "తనువు అనువు నాలోనే తల్లడిల్లగా",
        "నీ చేతి స్పర్శకై నే కాచుకొంటి",
        "నీ స్వస్థత కొరకే నే వేచియుంటి",
        "నీ రక్తధారతో నన్ను శుద్ధిచేయుమా"
      ],
      "english": [
        "Dinamella marana bhayamu nannu ilalo tharumuchundagaa",
        "Thanuvu anuvu naalone thalladillagaa",
        "Nee chethi sparshakai ne kaachukonti",
        "Nee swasthatha korake ne vechiyunti",
        "Nee rakthadhaaratho nannu shuddhicheyumaa"
      ]
    }
  ]
