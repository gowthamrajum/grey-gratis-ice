  "main_stanza": {
    "telugu": [
      "సుసాధ్యమేగా",
      "అసాధ్యములన్నీ",
      "ఉపవాస ప్రార్థనలో",
      "ఆ…ఆ…ఉపవాస ప్రార్థనలో"
    ],
    "english": [
      "Susaadhyamegaa",
      "Asaadhyamulannee",
      "Upavaasa praarthanalo",
      "Aa…aa…upavaasa praarthanalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అందుకో నా ఉపవాస ప్రార్థన",
        "ధూపమువోలె నా యేసయ్యా",
        "అన్నపానములు విడచి నీ సన్నిధిలో",
        "చేసెద నీతో సహవాసమే"
      ],
      "english": [
        "Anduko naa upavaasa praarthana",
        "Dhoopamuvole naa Yesayyaa",
        "Annapaanamulu vidachi nee sannidhilo",
        "Cheseda neetho sahavaaname"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అతిక్రమములు జరిగించి",
        "అణచబడిరి మా పితరులు",
        "ఉపవాసముతో పోరాడగా ఊరేగింపాయెను ఆ ఉరియే",
        "అమ్మబడిన వారిని అధిపతులనుగా చేసిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Athikramamulu jariginchi",
        "Anachabadiri maa pitharulu",
        "Upavaasamutho poraadagaa ooregimpaayenu aa uriye",
        "Ammabadina vaarini adhipathulanugaa chesina",
        "Needu kriyalu aashcharyame mahadhaashcharyame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కుడి ఎడమలు ఎరుగక",
        "దోషము చేసిన ఆ జనములు",
        "పశ్చాత్తాప్తులై పసికందులతో ప్రలాపించిరే పరివర్తనతో",
        "ఉగ్రత నుండి భద్రతకు శీఘ్రముగా నడిపించిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Kudi edamalu erugaka",
        "Doshamu chesina aa janamulu",
        "Pashchaaththaapthulai pasikandhulatho pralaapinchire parivarthanatho",
        "Ugratha nundi bhadhrathaku sheeghramugaa nadipinchina",
        "Needu kriyalu aashcharyame mahadhaashcharyame"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కన్నీటి నైవేద్యము కానుకగా నీకర్పింపగా",
        "కనుమరుగాయే కన్నీటి కడలి",
        "దీవెనలాయే ఆ నిందలే",
        "మా ఉపవాసమునే చూచిన",
        "మా స్థితిగతులన్నీ మార్చిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Kanneeti naivedyamu kaanukagaa neekarpimpagaa",
        "Kanumarugaaye kanneeti kadali",
        "Dheevenalaaye aa nindhale",
        "Maa upavaasamune choochina",
        "Maa sthithigathulannee maarchina",
        "Needu kriyalu aashcharyame mahadhaashcharyame"
      ]
    }
  ]
}
