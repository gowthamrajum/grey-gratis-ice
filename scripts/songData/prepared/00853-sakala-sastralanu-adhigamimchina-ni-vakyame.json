{
  "song_name": "Sakala Sastralanu Adhigamimchina Ni Vakyame",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సకల శాస్త్రాలను అధిగమించిన నీ వాక్యమే",
      "జ్ఞానము శక్తియు యేసునందున్నవి"
    ],
    "english": [
      "Sakala Sastralanu Adhigamimchina Ni Vakyame",
      "Janamu Saktiyu Yesunamdunnavi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆదియందు వాక్యము వాక్యమే ఆ దైవము",
        "జీవము వెలుగును యేసు నందున్నవి"
      ],
      "english": [
        "Adiyamdu Vakyamu Vakyame A Daivamu",
        "Jivamu Velugunu Yesu Namdunnavi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కలిగియున్నది ఏదియు యేసు లేకుండ కలుగలేదు",
        "జగతిలోన జీవరాశులన్ యేసు మాటలే కలిగించెను"
      ],
      "english": [
        "Kaligiyunnadi Ediyu Yesu Lekumda Kalugaledu",
        "Jagatilona Jivarasulan Yesu Matale Kaligimchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు విత్తిన గింజకు దేహమిచ్చిన దాయనే",
        "మృతులను సజీవులనుగా చేయువాడు ఆ దైవమే"
      ],
      "english": [
        "Nivu Vittina Gimjaku Dehamichchina Dayane",
        "Mrutulanu Sajivulanuga Cheyuvadu A Daivame"
      ]
    }
  ]
}
