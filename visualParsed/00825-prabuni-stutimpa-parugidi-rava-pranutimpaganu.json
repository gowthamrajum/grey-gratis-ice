  "main_stanza": {
    "telugu": [
      "ప్రభుని స్తుతింప పరుగిడి రావా",
      "ప్రణుతింపగను ప్రేమతో రావా",
      "ప్రకటింపను ప్రచురింపను ప్రభు యేసుని నామమున్"
    ],
    "english": [
      "Prabhuni sthuthimpa parugidi raavaa",
      "Pranuthimpaganu prematho raavaa",
      "Prakatimpanu prachurimpanu Prabhu Yesuni naamamun"
    ]
