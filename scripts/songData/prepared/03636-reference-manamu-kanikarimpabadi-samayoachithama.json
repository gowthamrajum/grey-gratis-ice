  },
  "main_stanza": {
    "telugu": [
      "వెళ్ళెదము మరి ధైర్యముతో కృపాసనము చేరను",
      "తన కనికరము కృపలను పొంద తానె సహాయకుడు"
    ],
    "english": [
      "VeLLedhamu Mari Dhairyamuthoa Krupaasanamu Chaeranu",
      "Thana Kanikaramu Krupalanu PoMdha Thaane Sahaayakudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మన ప్రార్థన ప్రభువాలకించి - అత్యధికముగా మనకిచ్చును",
        "మేల్కొని మనము ప్రార్థించిన - ఆశీర్వదించునుగా"
      ],
      "english": [
        "Mana PraarThana PrabhuvaalakiMchi - AthyaDhikamugaa Manakichchunu",
        "Maelkoni Manamu PraarThiMchina - AasheervadhiMchunugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆత్మలనెల్ల ప్రభు రక్షించి - తన మందిరమునకు తెచ్చి",
        "తన ఆలయములో మేలుపొంద - వేడెదము మనము"
      ],
      "english": [
        "Aathmalanella Prabhu RakShiMchi - Thana MMdhiramunaku Thechchi",
        "Thana Aalayamuloa MaelupoMdha - Vaededhamu Manamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అందరికి రక్షణ కలుగ - రాజులకు అధికారులలో",
        "సర్వలోకుల ఉజ్జీవముకై - వేడెదము ప్రభునే"
      ],
      "english": [
        "AMdhariki RakShaNa Kaluga - Raajulaku ADhikaarulaloa",
        "Sarvaloakula Ujjeevamukai - Vaededhamu Prabhunae"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వాక్యము వర్ధిల్లి వ్యాపింపను - శత్రుని రాజ్యము కూలునట్లు",
        "సేవకులాత్మతో నింపబడ - వేడెదము మనము"
      ],
      "english": [
        "Vaakyamu VarDhilli VyaapiMpanu - Shathruni Raajyamu Koolunatlu",
        "Saevakulaathmathoa NiMpabada - Vaededhamu Manamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఆత్మతో ప్రభుయింటిని కట్టి - దాని యందు ప్రభు మహిమనిండి",
        "తన ఘనత వర్ధిల్లునట్లు - వేడెదమాయనను"
      ],
      "english": [
        "Aathmathoa PrabhuyiMtini Katti - Dhaani YMdhu Prabhu MahimaniMdi",
        "Thana Ghanatha VarDhillunatlu - Vaededhamaayananu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సజీవ రాళ్ళతో యిల్లుకట్టి - నీ అధికారము నిలుచునట్లు",
        "దేవా నీ హృదయానుసారులను - లేపమని వేడెదం"
      ],
      "english": [
        "Sajeeva RaaLLathoa Yillukatti - Nee ADhikaaramu Niluchunatlu",
        "Dhaevaa Nee Hrudhayaanusaarulanu - Laepamani VaededhaM"
      ]
    }
  ]
