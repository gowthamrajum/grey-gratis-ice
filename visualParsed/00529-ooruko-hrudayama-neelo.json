      ],
      "english": [
        "Dhurjanulanu choochi kalavaramela",
        "Dhushtulu vruddhichendhagaa aayaasamela",
        "Nammikatho Prabhuni chitthamukai vedu",
        "Thaginakaalamulo ninu hechchinchunu choodu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విశ్రమించు ఆయన ఒడిలో హాయుగా",
        "ధైర్యము వీడక కనిపెట్టు ఆశగా",
        "ఆయన చల్లనిచూపే ప్రసాదించు శాంతి",
        "కలిగించు సహనము తొలగించు బ్రాంతి"
      ],
      "english": [
        "Vishraminchu aayana odilo haayugaa",
        "Dhairyamu veedaka kanipettu aashagaa",
        "Aayana challanichoope prasaadhinchu shaanthi",
        "Kaliginchu sahanamu tholaginchu bhraanthi"
      ]
    }
  ]
