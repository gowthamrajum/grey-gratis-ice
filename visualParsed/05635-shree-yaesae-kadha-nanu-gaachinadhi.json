{
  "song_name": "Shree Yese kada nanu gaachinadhi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "శ్రీ యేసే కద నను గాచినది",
      "సాతాను కన్నులకు నను మరుగు చేసి",
      "మపదనిసా .... నిరిసరినీ",
      "గమపదనీ ..... నిరిసరిసా (2)"
    ],
    "english": [
      "Shree Yese kada nanu gaachinadhi",
      "Saathaanu kannulaku nanu marugu chesi",
      "Mapadhanisaa .... nirisarinee",
      "Gamapadhanee ..... nirisarisaa (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా వంటిరి రాత్రి ప్రయాణములలో",
        "నాతో నడిచి ననునగాచెనుగా",
        "దుష్టుల దుష్టముకు నను బలిచేయక",
        "ఈదినము వరకు నాకు రక్షయై  ||శ్రీ||"
      ],
      "english": [
        "Naa ontari raathri prayaanamulalo",
        "Naatho nadichi nanu gaachenugaa",
        "Dushtula dushtamuku nanu balicheyaka",
        "Eedhinamu varaku naaku rakshayai  ||Shree||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తల్లి దండ్రి తోబుట్టువులు",
        "త్రోసి వేసినను నన్ను చేరదీసి",
        "హస్తకృతములో నివసించలేదు",
        "శరీర ఆహారము భుజించగలేను  ||శ్రీ||"
      ],
      "english": [
        "Thalli dandri thobuttuvulu",
        "Throsi vesinanu nannu cheradeesi",
        "Hasthakruthamulo nivasinchaledhu",
        "Shareera aahaaramu bhujinchagalenu  ||Shree||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తేసు రెక్కలు నాకు నివాసమై",
        "నివసించుచున్నాను ఆయన నీడలో",
        "నా యేసు ప్రేమను తలంచినేను",
        "స్తుతించగ లేక వుండలేను  ||శ్రీ||"
      ],
      "english": [
        "Kreesthesu rekkalu naaku nivaasamai",
        "Nivasinchuchunnaanu aayana needalo",
        "Naa Yesu premanu thalanchi nenu",
        "Sthuthinchaga leka vundalenu  ||Shree||"
      ]
    }
  ]
}
