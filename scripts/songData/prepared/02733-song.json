{
  "song_name": "Alasatapadda Neevu Dhaevoakthi Vinu",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ మేసన్ నీ"
  },
  "main_stanza": {
    "telugu": [
      "అలసటపడ్డ నీవు దేవోక్తి విను",
      "రా, నా యొద్ద, సు విశ్రాంతి పొందుము"
    ],
    "english": [
      "Alasatapadda Neevu Dhaevoakthi Vinu",
      "Raa, Naa Yodhdha, Su Vishraanthi Pondhumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నేను చూచు గుర్తు లేవి, వాని కుండునా?",
        "'ప్రక్కఁ గాలుసేతులందు గాయముల్'"
      ],
      "english": [
        "Naenu Choochu Gurthu Laevi, Vaani Kundunaa?",
        "'Prakka Gaalusaethulandhu Gaayamul'"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రాజుఁబోలి కిరీటంబు వాని కుండునా",
        "'యుండుగాని ముండ్లచేత నల్లరి'"
      ],
      "english": [
        "Raajuboali Kireetambu Vaani Kundunaa",
        "'Yundugaani Mundlachaetha Nallari'"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నన్ను ఁ జేర్చుకొమ్మనంగఁ జేర్చుకొనునా?",
        "'ఔను లోకాంతంబు దాఁక చేర్చును'"
      ],
      "english": [
        "Nannu Jaerchukommananga Jaerchukonunaa?",
        "'Aunu Loakaanthambu Dhaaka Chaerchunu'"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వాని వెంబడింతు నేని యేమి లాభము?",
        "'పాప దుఃఖ కష్టములు వచ్చును'"
      ],
      "english": [
        "Vaani Vembadinthu Naeni Yaemi Laabhamu?",
        "'Paapa Dhuhkha Kashtamulu Vachchunu'"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "చావుమట్టు కోర్తునేని ఏమి యిచ్చును?",
        "'సంతోషంబు సౌఖ్య మింక మోక్షము'"
      ],
      "english": [
        "Chaavumattu Koarthunaeni Aemi Yichchunu?",
        "'Santhoashambu Saukhya Minka Moakshamu'"
      ]
    }
  ]
}
