{
  "song_name": "Raaraajagu Yaesuninaamm Ramymb",
  "author": {
    "Authored by": "",
    "రచన": "పి  రవివర్మ"
  },
  "main_stanza": {
    "telugu": [
      "రారాజగు యేసునినామం రమ్యంబగు దేవుని నామం ఈశుండగు యేసునినామం ఈధర నిదె పావననామం యేసునినామం దేవునినామం రమ్యంబగు దేవుని నామం ||రారాజు||"
    ],
    "english": [
      "raaraajagu yaesuninaamM ramyMbagu dhaevuni naamM eeshuMdagu yaesuninaamM eeDhara nidhe paavananaamM yaesuninaamM dhaevuninaamM ramyMbagu dhaevuni naamM ||raaraaju||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గగనమువీడిన గురునామం కలుషాత్మలబ్రోచెడు నామం ||రారాజు||"
      ],
      "english": [
        "gaganamuveedina gurunaamM kaluShaathmalabroachedu naamM ||raaraaju||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్లీవాంకముగల యినామం సుజనుల జేసెడు స్థిరనామం ||రారాజు||"
      ],
      "english": [
        "sleevaaMkamugala yinaamM sujanula jaesedu sThiranaamM ||raaraaju||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విజయం బొపగెడు నిజనామం విమలాత్ముల కిదివరనామం ||రారాజు||"
      ],
      "english": [
        "vijayM bopagedu nijanaamM vimalaathmula kidhivaranaamM ||raaraaju||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మనమున కిది యజ్జ్వలనామం జనములకిదియే ఋజునామం ||రారాజు||"
      ],
      "english": [
        "manamuna kidhi yajjvalanaamM janamulakidhiyae rujunaamM ||raaraaju||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఈధరస్తుతులను గొనునామం ఈయేసుని యమృతనామం ||రారాజు||"
      ],
      "english": [
        "eeDharasthuthulanu gonunaamM eeyaesuni yamruthanaamM ||raaraaju||"
      ]
    }
  ]
}
