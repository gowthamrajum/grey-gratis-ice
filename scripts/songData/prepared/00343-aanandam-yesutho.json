{
  "song_name": "Aanandam Yesutho",
  "author": {
    "Authored by": "Bro  Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆనందం యేసుతో ఆనందం",
      "జయగంభీర ధ్వనితో పాడెదను",
      "జయరాజాధిరాజుతో సాగెదను"
    ],
    "english": [
      "Aanandam Yesutho Aanandam",
      "Jayagambheera Dhwanitho Paadedanu",
      "Jayaraajaadhiraajutho Saagedanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా ప్రాణమునకు సేదదీర్చి తన నామము బట్టి",
        "నీటి మార్గమున నన్ను నడిపించెను",
        "ఏ అపాయమునకు నేను భయపడకుందును"
      ],
      "english": [
        "Naa Praanamunaku Sedatheerchi Thana Naamamu Batti",
        "Neeti Maargamuna Nannu Nadipinchenu",
        "Ye Apaayamunaku Nenu Bhayapadakundunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ప్రభుని కృప చూచిన నాటినుండి",
        "నన్ను నేనే మరచిపోతినే",
        "నాగటి మీద చెయ్యి పెట్టి వెనుక చూచెదనా"
      ],
      "english": [
        "Naa Prabhuni Krupa Choochina Naatinundi",
        "Nannu Nene Marachipothine",
        "Naagati Meeda Cheyyi Petti Venuka Choochedanaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సిలువను యేసు సహించెను",
        "తన యెదుట ఉంచబడిన జ్యేష్ఠుల సంఘముకై",
        "అవమానము నొందె - నాకై మరణము గెలిచె"
      ],
      "english": [
        "Siluvanu Yesu Sahinchenu",
        "Thana Yeduta Unchabadina Jyeshthula Sanghamukai",
        "Avamaanamu Nonde - Naakai Maranamu Geliche"
      ]
    }
  ]
}
