{
  "song_name": "Yaesu Sheeghramugaa Vachchun Aashathoa Kanipettudi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు శీఘ్రముగా వచ్చున్ ఆశతో కనిపెట్టుడి"
    ],
    "english": [
      "Yaesu Sheeghramugaa Vachchun Aashathoa Kanipettudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గురుతులెల్ల లోకమంతా - సరిగజూడ కాననగున్",
        "పరిశుద్ధమైన ప్రవర్తనతో - ప్రభుకై కనిపెట్టుడి"
      ],
      "english": [
        "Guruthulella Loakamamthaa - Sarigajooda Kaananagun",
        "Parishudhdhamaina Pravarthanathoa - Prabhukai Kanipettudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రొద్దు గ్రుంకి వచ్చునేమో - అర్ధరాత్రి యందేమో",
        "ఉదయంపు కోడికూతలప్పుడు - వచ్చునేమో కనిపెట్టుడి"
      ],
      "english": [
        "Prodhdhu Grumki Vachchunaemoa - Ardharaathri Yamdhaemoa",
        "Udhayampu Koadikoothalappudu - Vachchunaemoa Kanipettudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "సిద్ధపడుడి మీరిలలో - మీరు దేవుని సంధింప",
        "సిద్ధపడుడి తీర్పునకై - ప్రభువుకై కనిపెట్టుడి"
      ],
      "english": [
        "Sidhdhapadudi Meerilaloa - Meeru Dhaevuni Samdhimpa",
        "Sidhdhapadudi Theerpunakai - Prabhuvukai Kanipettudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పరిశుద్ధులై జీవించుడి - ప్రభుని చిత్తము చేయుడి",
        "మరణమేసు నందె సుమ్మా - మేలుకొని కనిపెట్టుడి"
      ],
      "english": [
        "Parishudhdhulai Jeevimchudi - Prabhuni Chiththamu Chaeyudi",
        "Maranamaesu Namde Summaa - Maelukoni Kanipettudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసువలె జీవించుడి - తీసి వేయుడి మలినములన్",
        "మోసంపుటాశల నన్ని విడచి - ఆశతో కనిపెట్టుడి"
      ],
      "english": [
        "Yaesuvale Jeevimchudi - Theesi Vaeyudi Malinamulan",
        "Moasamputaashala Nanni Vidachi - Aashathoa Kanipettudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వేషధారణ విడచి - యేసు ముద్రల ధరించి",
        "పెండ్లి కుమారుని సంధింప - అందరు కనిపెట్టుడి"
      ],
      "english": [
        "Vaeshadhaarana Vidachi - Yaesu Mudhrala Dharimchi",
        "Pemdli Kumaaruni Samdhimpa - Amdharu Kanipettudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మేఘములపై వెళ్ళిన ప్రభు - వేగముగ వచ్చునిల",
        "సకల శ్రమలను భరించి - హల్లెలూయ పాడుడి"
      ],
      "english": [
        "Maeghamulapai Vellina Prabhu - Vaegamuga Vachchunila",
        "Sakala Shramalanu Bharimchi - Hallelooya Paadudi"
      ]
    }
  ]
}
