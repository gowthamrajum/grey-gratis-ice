      ],
      "english": [
        "Kreesthuni naamamu nithyamu nilchun",
        "Sooryudunnantha kaalamu chigurchun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అతనినిబట్టి మానవులెల్లరు",
        "తథ్యముగానే దీవించబడెదరు"
      ],
      "english": [
        "Athaninibatti maanavulellaru",
        "Thathyamugaane dheevinchabadedaru"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అన్యజనులందరును అతని",
        "ధన్యుడని చెప్పుకొను చుందురు"
      ],
      "english": [
        "Anyajanulandarunu athani",
        "Dhanyudani cheppukonu chunduru"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇశ్రాయేలు దేవుడైన యెహోవా",
