  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దైవదర్శనమున యాకోబు - దివ్యముగను చూచి",
        "ఆ స్థలమునకు బేతేలనియెడి నామమును తానిడియె",
        "సుస్థిరముగ మన పరమ తండ్రి - వసియించెడి స్థలమిదియె"
      ],
      "english": [
        "Dhaivadharshanamuna Yaakobu - Dhivyamuganu choochi",
        "Aa sthalamunaku Bethelaniyedi naamamunu thaanidiye",
        "Susthiramuga mana parama thandri - Vasiyinchedi sthalamidiye"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవుని నిచ్చెనగు క్రీస్తు దివికి నిలువబడెను",
        "దేవుని దూతలు దానిపైని ఎక్కుచు దిగుచున్నారు",
        "దేవుని మందిర మిదియె కాని వేరే స్థలమిదికాదు"
      ],
      "english": [
        "Devuni nichchenagu Kreesthu dhiviki niluvabadenu",
        "Devuni doothalu dhaanipaini ekkuchu dhiguchunnaaru",
        "Devuni mandira midiye kaani vere sthalamidhikaadhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిశ్చయముగా నీ స్థలమందు - నిలిచి యుండె నెహోవా",
        "ఆశ్చర్య పరలోకపు గవిని రక్షణ బొందగ రారే",
        "విశ్రాంతి దేవునికి కలుగు - పాపికి భయంకరము"
      ],
      "english": [
        "Nishchayamugaa nee sthalamandu - Nilichi yunde Yehovaa",
        "Aashcharya paralokapu gavini rakshana bondhaga raare",
        "Vishraanthi devuniki kalugu - Paapiki bhayankaramu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఉన్నత స్థలముల నెక్కించి ఆనందింప జేసి",
        "అనుభవమునందు యాకోబు - స్వాస్థ్యము నొసంగి",
        "ఐగుప్తు యవమానమును దొరలింపజేయును"
      ],
      "english": [
        "Unnatha sthalamula nekkinchi aanandhimpa jesi",
        "Anubhavamunandhu Yaakobu - Swaasthyamu nosangi",
        "Aigupthu avamaanamunu dhoralimpajeyunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పర్వతములు తత్తరిల్లి తొలగిపోయినను",
        "సర్వదా తన కృపతోడై - నిన్ను నడిపించును",
        "పూర్వమందు పలికిన మాటల - నిర్వహించును నీలో"
      ],
      "english": [
        "Parvathamulu thattharilli tholagipoyinanu",
        "Sarvadaa thana krupathodai - Ninnu nadipinchunu",
        "Poorvamandhu palikina maatala - Nirvahinchunu neelo"
      ]
    }
  ]
}
