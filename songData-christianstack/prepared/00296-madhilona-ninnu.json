{
  "song_name": "Madhilona Ninnu",
  "author": {
    "Authored by": "Dr. Killari David Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మదిలోన నిన్ను పదిలంబుగాను",
      "హృదిలోన నీదు వాక్యంబునుండ",
      "కలిగెను శాంతి ఈ ధరణిలోన",
      "కలిగెను శాంతి నా మదిలోన"
    ],
    "english": [
      "Madhilona ninnu padhilambugaanu",
      "hrudhilona needhu vaakyambhununda",
      "kaligenu shanthi ee dharanilona",
      "kaligenu shanthi naa madhilona"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎన్నెన్నో శ్రమలు కష్టాలు కలిగినా",
        "నీ రెక్కల క్రింద నీ అండ నాకుండ",
        "కలిగెను శాంతి ఈ ధరణిలోన",
        "కలిగెను శాంతి నా మదిలోన",
        "శోధనలు ఎన్నో వెన్నంటియున్న",
        "నాకుంది క్షేమం నీ కాపుదలలో",
        "కలిగెను శాంతి ఈ ధరణిలోన",
        "కలిగెను శాంతి నా మదిలోన"
      ],
      "english": [
        "Ennenno sramalu kastaalu kaliginaa",
        "nee rekkala krindha nee anda naakunda",
        "kaligenu shanthi ee dharanilona",
        "kaligenu shanthi naa madhilona",
        "Shodhanalu enno vennantiyunna",
        "naakundhi kshemam nee kaapudhalalo",
        "kaligenu shanthi ee dharanilona",
        "kaligenu shanthi naa madhilona"
      ]
    }
  ]
}
