{
  "song_name": "Naa hrudayam neetho nindene",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "లిరిక్స్:-ఈ లోకంలో నేను వెతికినా –",
      "లేదయ్యా నీవంటి దైవం!",
      "నీ సన్నిధిలో క్షణమైనా చాలు –",
      "నా హృదయం నీతో నిండెనే!"
    ],
    "english": [
      "Lyrics:-ee lokamlo nenu vethikinaa –",
      "Ledayyaa neevanti daivam!",
      "Nee sannidhilo kshanamainaa chaalu –",
      "Naa hrudayam neetho nindene!"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోక బంధాలు క్షణికమైనవి.",
        "నీ కృపలోనే నిజమైన జీవం,",
        "నా హృదయంలో నీవే నా దేవా —",
        "నీ స్తుతి పాడనా ఎల్లవేళలా!"
      ],
      "english": [
        "Ee loka bandhaalu kshanikamainavi.",
        "Nee krupalone nijamaina jeevam,",
        "Naa hrudayamlo neeve naa Deva —",
        "Nee sthuthi paadanaa ellavelalaa!"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ ప్రేమ లోతులు లెక్కించలేనయ్యా,",
        "నిన్న నేడు ఎన్నడూ మారని దేవా",
        "నీ స్తుతి పాడనా ఎల్లవేళలా,",
        "నీవే నా తోడు ఓ నా యేసయ్యా!"
      ],
      "english": [
        "Nee prema lothulu lekkinchalenayyaa,",
        "Ninna nedu ennadoo maarani Deva",
        "Nee sthuthi paadanaa ellavelalaa,",
        "Neeve naa thodu o naa Yesayyaa!"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తుపానులు వీచినా భయపడను,",
        "నీవు నాతోఉండగా దిగులెలా",
        "చీకటి లోయలలో వెలుగైన నీవే,",
        "నిత్యజీవ మార్గంలో నడిపించావు!"
      ],
      "english": [
        "Thuphaanulu veechinaa bhayapadanu,",
        "Neevu naatho undagaa dhigulelaa",
        "Cheekati loyalalo velugaina neeve,",
        "Nithyajeeva maargamlo nadipinchaavu!"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీవుంటే చాలును నా యేసయ్యా,",
        "నా హృదయం నీతో నిండెనా!",
        "లోకమంతా మారినా – మారని దేవా,",
        "నిన్నే ఆరాధించెదా ఎల్లవేళలా!"
      ],
      "english": [
        "Neevunte chaalunu naa Yesayyaa,",
        "Naa hrudayam neetho nindenaa!",
        "Lokamanthaa maarinaa – Maarani Deva,",
        "Ninne aaraadhinchedhaa ellavelalaa!"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తుపానులు గాలులైనా – నీవుంటే నాకేమి భయము",
        "నీవే శరణు, నీవే బలం – యేసయ్యా నా జీవం!"
      ],
      "english": [
        "Thuphaanulu gaalulainaa – Neevunte naakemi bhayamu",
        "Neeve sharanu, neeve balam – Yesayyaa naa jeevam!"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "#తెలుగుక్రిస్టియన్ #అక్షయప్రవీణ్#నా_హృదయం_నీతో_నిండనే"
      ],
      "english": [
        "#teluguchristian #akshayapraveen#naa_hrudayam_neetho_nindane"
      ]
    }
  ]
}
