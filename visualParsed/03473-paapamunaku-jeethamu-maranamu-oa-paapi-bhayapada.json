    {
      "stanza_number": 1,
      "telugu": [
        "పాపమునకు జీతము మరణము (3) ఓ పాపి భయపడవా?",
        "చూచునదెల్ల నశించు నిశ్చయము (3) చూడనిదే నిత్యము",
        "యేసురాజువచ్చును ఇంక కొంతకాలమే - మోక్షమందు చేరుదుము"
      ],
      "english": [
        "Paapamunaku jeethamu maranamu (3) O paapi bhayapadavaa?",
        "Choochunadhella nashinchu nishchayamu (3) Choodanidhe nithyamu",
        "Yesuraajuvachchunu inka konthakaaleme - Mokshamandhu cherudhumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకసుఖము నమ్మకు నమ్మకు (3) ఆ యిచ్ఛలు మాయమగు",
        "నీ జీవముపోవు సమయమున (3) చిల్లిగవ్వ వెంటరాదు"
      ],
      "english": [
