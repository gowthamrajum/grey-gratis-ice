{
  "song_name": "Anukonuta Nerpayya",
  "author": {
    "Authored by": "Sunder Paidipamula",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆనుకొనుట నేర్పయ్య – ఆదుకొనే యేసయ్య",
      "ఈ అరణ్య యాత్రలో తండ్రివైన నీపైన"
    ],
    "english": [
      "Anukonuta nerpayya adhukone yesayya",
      "Ee aranya yathralo thamdrivaina nipaina"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవే చెయ్యాలయ్యా కార్యం -నీవే చూపాలయ్యా మార్గం",
        "నిన్నే నమ్ముకున్నాను- వేరే దారి లేదయ్యా"
      ],
      "english": [
        "Nive cheyyalayya karyam",
        "Nive chupalayya margam",
        "Ninne nammukunnanu",
        "Vere dhari ledhayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఈ లోక యాత్రలో – కానను బాటలో",
        "నే దాటలేని పర్వతములెన్నో ఎదురై నిలువగా",
        "పిలిచినా స్నేహమా – ఏర్పరిచిన దైవమా",
        "పర్వతములన్ని దాటించుటకు చాలిన హస్తమా"
      ],
      "english": [
        "E loka yathralo kananu batalo",
        "Ne dhataleni parvathamulenno edhurai niluvaga",
        "Pilichina snehama erparichina dhaivama",
        "Parvathamulanni dhatimchutaku chalina hasthama"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా బాల్యస్నేహమా-నా గుండె దైర్యమా",
        "గోతిలోనుండి లేవనెత్తి నను నిలిపిన దైవమా",
        "నా క్షేమ క్షే త్రమా, నా హృదయ గీతామా",
        "మనుష్యుల మాయోపాయమునుండి తప్పించు జ్ఞానమా"
      ],
      "english": [
        "Na balyasnehama na gumde dhairyama",
        "Gothilonumdi levaneththi nanu nilipina dhaivama",
        "Na kshaema kshae thrama, na hrudhaya githama",
        "Manushyula mayopayamunumdi thappimchu jnyanama"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా పాప జీవితం -చంచల వర్తనం",
        "క్రీస్తు సిలువ రక్తముతో- కడిగి ముద్ర వేసావయా",
        "నా భక్తి కాదయా కృప మాత్రమేనయా",
        "కడవరకు నమ్మకముగా సాగే కృపనిమ్ము యేసయ్య"
      ],
      "english": [
        "Na papa jivitham chamchala varthanam",
        "Kristhu siluva rakthamutho kadigi mudhra vesavaya",
        "Na bhakthi kadhaya krupa mathramenaya",
        "Kadavaraku nammakamuga sage krupanimmu yesayya"
      ]
    }
  ]
}
