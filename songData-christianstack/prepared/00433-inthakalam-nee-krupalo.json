{
  "song_name": "Inthakalam Nee Krupalo",
  "author": {
    "Authored by": "Sampath Kareti",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇంతకాలం నీ కృపలో",
      "కాచినావు మా దేవా",
      "తల్లిలాగా తండ్రిలాగా నీ కౌగిలో",
      "దాచినావు"
    ],
    "english": [
      "Inthakaalam nee krupaloo",
      "kaachinaavu maa dheavaa",
      "thallilaagaa thandrilaagaa nee kougililoo",
      "dhaachinaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా ప్రాణ ప్రియుడా మా యేసయ్య",
        "స్తుతిపాడెదం మా జీవితమంతా"
      ],
      "english": [
        "Maa praanna priyudaa maa yeasayya",
        "stuthipaadeadham maa jeevithamanthaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కష్టాలలోన నష్టాలలోన",
        "నడిపించినావు చేయివిడువక",
        "శోధనలోన క్రుంగియున్న సమయమున",
        "లేవనెత్తి మమ్ము నిలబెట్టిన దేవ",
        "మా చేతిలో నీ చేయివేసినావు",
        "చక్కనైన త్రోవలో సాగిపొమన్నావు..",
        "నేనున్నానని వాగ్దానమిచ్చావు"
      ],
      "english": [
        "Kashtalaloona nashtaalaloona",
        "nadipinchinaavu cheayividuvaka",
        "soodhanaloona krungiyunna samayamuna",
        "leavanetthi mammu nilabettina dheava",
        "maa cheathiloo nee cheayiveasinaavu",
        "chakkanainathoovaloo saagipomannaavu",
        "neanunnanani vaagdhaanamicchhavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మా స్థితి గతులన్నీ ఎరిగియున్నవాడవు",
        "క్షణమైనా ఏనాడూ యెడ బాయని దేవా",
        "మా రక్షణ కర్తవై మా చెంత నిలిచావు",
        "నీ పిల్లలమైన మమ్ము కాపాడుము దేవా",
        "పిలచిన మరు క్షణమే పలుకరించువాడవే",
        "సజీవుడవైన దేవా ఉన్నవాడవే",
        "మా స్తుతికి పాత్రుడా వందనాలయ్య"
      ],
      "english": [
        "Maa sthithi gathulannee erigiyunnavaadavu",
        "kshannamainaa eanaaduu yedabaayani dheavaa",
        "maa rakshanna karthavai maa chentha nilichaavu",
        "nee pillalamaina mammu kaapaadumu dheavaa",
        "pilachina maru kshannamea palukarinchuvaadavea",
        "sajeevudavainaa dheavaa unnavaadavea",
        "maa stuthiki paathrudaa vandhanaalayya"
      ]
    }
  ]
}
