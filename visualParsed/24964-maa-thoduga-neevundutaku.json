{
  "song_name": "Maa thoduga neevundutaku",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Johnson Nakiekanti"
    ],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మా తోడుగా నీవుండుటకు",
      "మా నీడగా నీవుండుటకు",
      "దివిని ఏలే దైవమా",
      "భువిలో వెలసిన రూపమా",
      "హ్యాపీ క్రిస్మస్ – మెర్రీ క్రిస్మస్"
    ],
    "english": [
      "Maa thoduga neevundutaku",
      "Maa needaga neevundutaku",
      "Divini ele daivamaa",
      "Bhuvilo velasina roopamaa",
      "Hyaapee Krismas – Merree Krismas"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకటితో నిండియున్న నా హృదయం",
        "అపవిత్రతను కలిగియున్న నా ఆలోచనలు",
        "దురాశతో నీ దరికిచేరని నా జీవితం",
        "పాపముతో నిను చూడలేని నా కనులకు",
        "క్రీస్తుగా ప్రభు యేసుగా భువికేతించిన దేవా",
        "బాలుడై మా భాగ్యముకై బాటలు వేసితివా"
      ],
      "english": [
        "Cheekatitho nindiyunna naa hrudayam",
        "Apavithrathanu kaligiyunna naa aalochanalu",
        "Duraashatho nee darikicherani naa jeevitham",
        "Paapamutho ninu choodaleni naa kanulaku",
        "Kreesthugaa Prabhu Yesugaa bhuvikethenchina Devaa",
        "Baaludai maa bhaagyamukai baatalu vesithivaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకముతో కలిగియున్న నీ స్నేహం",
        "పరిశుద్దతను పొందియున్న నీ ఆలోచనలు",
        "సత్యముతో నా బ్రతుకు మార్చెను నీ జీవితం",
        "రక్షణతో నను ఆదరించిన నీ కరములు",
        "రక్షకా నా విమోచకా నను కరుణించే దేవా",
        "ధరణిలో నీ పూజ్యముకై పుట్టిన యేసయ్యా"
      ],
      "english": [
        "Lokamutho kaligiyunna nee sneham",
        "Parishuddhathanu pondiyunna nee aalochanalu",
        "Sathyamutho naa brathuku maarchenu nee jeevitham",
        "Rakshanatho nanu aadarinchina nee karamulu",
        "Rakshakaa naa vimochakaa nanu karuninche Devaa",
        "Dharanilo nee poojyamukai puttina Yesayyaa"
      ]
    }
  ]
}
