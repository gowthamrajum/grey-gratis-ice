{
  "song_name": "Maanavudaa kaaranajanmudaa? Nee janmaku kaaranamundhi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మానవుడా కారణజన్ముడా? నీ జన్మకు కారణముంది",
      "అర్ధం తెలియక నీవు వ్యర్ధంగా బ్రతుకకు",
      "పరమార్ధమున్నదని ప్రభుకొరకే బ్రతకమని"
    ],
    "english": [
      "Maanavudaa kaaranajanmudaa? nee janmaku kaaranamundhi",
      "Ardham theliyaka neevu vyardhangaa brathukaku",
      "Paramaardhamunnadhani prabhukorake brathakamani"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పువ్వులెందుకు? కాయలెందుకు?",
        "ఋతువులెందుకు? కాలాలెందుకు?",
        "ఉన్నవన్ని నీ కోసమేనని నీవు దేవుని కోసమేనని",
        "గమనించి తెలుసుకో గ్రహియించి మసలుకో",
        "నీ జన్మకు కారణముందీ నీ జన్మకు కారణముందీ"
      ],
      "english": [
        "Puvvulendhuku? kaayalendhuku?",
        "Ruthuvulendhuku? kaalaalendhuku?",
        "Unnavanni nee kosamenani neevu Devuni kosamenani",
        "Gamaninchi thelusuko grahiyinchi masaluko",
        "Nee janmaku kaaranamundhee nee janmaku kaaranamundhee"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సూర్యుడెందుకు? చంద్రుడెందుకు?",
        "రాత్రులెందుకు? పగలు ఎందుకు?",
        "రాత్రి పగలు దేవుడే చేసెనని ఆ దేవుని పని నీవు చేయాలని",
        "ప్రభువును ప్రకటించి పాపిని రక్షించి",
        "పరలోకం చేర్చాలనీ పరలోకం చేర్చాలనీ"
      ],
      "english": [
        "Sooryudendhuku? chandrudendhuku?",
        "Raathrulendhuku? pagalu enduku?",
        "Raathri pagalu Devude chesenani aa Devuni pani neevu cheyaalani",
        "Prabhuvunu prakatinchi paapini rakshinchi",
        "Paralokam cherchaalanee paralokam cherchaalanee"
      ]
    }
  ]
}
