  "main_stanza": {
    "telugu": [
      "జ్యోతిర్మయుని జననం – సర్వలోకానికి",
      "సంబరమే సంబరమే జగమంతా సంబరమే",
      "ఆరాధింప రండి – ఆనందింప రండి"
    ],
    "english": [
      "Jyothirmayuni jananam – Sarvalokaaniki",
      "Sambarame sambarame jagamanthaa sambarame",
      "Aaraadhimpa randi – Aanandhimpa randi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజా నీకే స్తోత్రము",
