{
  "song_name": "Baalakaa Nee Varthanamu Gaa Paadukoni Jeevimparaa",
  "author": {
    "Authored by": "",
    "రచన": "దాసరి మోజెస్"
  },
  "main_stanza": {
    "telugu": [
      "బాలకా నీ వర్తనము గా పాడుకొని జీవింపరా",
      "మేలులుకుఁ బలు కీడు లకునదె మూలమనిగమనింపరా"
    ],
    "english": [
      "Baalakaa Nee Varthanamu Gaa Paadukoni Jeevimparaa",
      "Maeluluku Balu Keedu Lakunadhe Moolamanigamanimparaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తప్పినడువకు మెన్నడేని తల్లిదండ్రులు యానతి",
        "తప్పిపోయిన సుతుఁడు పడిన తిప్పలు నీ వెఱుఁగవా?"
      ],
      "english": [
        "Thappinaduvaku Mennadaeni Thallidhandrulu Yaanathi",
        "Thappipoayina Suthudu Padina Thippalu Nee Verugavaa?"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గోలచేయుచుఁ బెద్దలనుగని మేలమాడుట తగదురా",
        "బాలురా యెలిషాను నవ్వి ప్రాణగొడ్డమునొందరే"
      ],
      "english": [
