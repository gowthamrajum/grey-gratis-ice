{
  "song_name": "Deva Nee Yaavaranam",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవా నీ యావరణం మాకెంతో శ్రేయస్కరం",
      "ఒక ఘడియ యిచ్చట గడుపుట మేలు వేయిదినములకంటెను (2X)"
    ],
    "english": [
      "Deva Nee Yaavaranam Maakentho Shreyaskaram",
      "Oka Ghadiya Yicchata Gaduputa Melu Veyidinamulakantenu (2X)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అద్భుత కార్యములు ఆ",
        "ఘనవారసకుని మహిమలు పొగడ ఆత్మలో నిలుపుమయా",
        "ఆత్మతొ సత్యముతో ఆరాధించగ మనస్సుతో",
        "అల్ఫా ఒమేఘయు ఆత్మరూపుడవు ఆనందించగ నీ మదిలో"
      ],
      "english": [
        "Adbhutha Kaaryamulu Aa",
        "Ghanavaarasakuni Mahimalu Pogada Aathmalo Nilupumayaa",
        "Aathmatho Sathyamutho Aaraadhinchaga Manassutho",
        "Alphaa Omeghayu Aathmaroopudavu Aanandinchaga Nee Madilo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధ సన్నీధిలొ ఆ",
        "పరిపూర్ణ హృదయముతో పరివర్తనముతో ప్రభునే ప్రస్తుతించెదం",
        "మా దేహమే ఆలయం - కావాలి మీకే నిలయం",
        "ప్రాణప్రియుడవు - పదముల జేరి ప్రాణార్పణము జేతును"
      ],
      "english": [
        "Parishuddha Sanneedhilo Aa",
        "Paripoorna Hrudayamutho Parivarthanamutho Prabhune Prasthuthinchedam",
        "Maa Dehame Aalayam - Kaavaali Meeke Nilayam",
        "Praanapriyudavu - Padamula Jeri Praanaarpanamu Jethunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అత్యంత పరిశుద్ధమౌ ఆ",
        "నివసించుటకు యోగ్యత నొసగి మమ్ము హెచ్చించితివి నీ దయన్",
        "జుంటిధారల కన్నను - తేనే మధురిమలకన్నను",
        "శ్రేష్టమౌ నీదు వాక్కుల చేత - మమ్ము తృప్తీ పరచుము"
      ],
      "english": [
        "Athyantha Parishuddhamau Aa",
        "Nivasinchutaku Yogyatha Nosagi Mammu Hecchinchithivi Nee Dayan",
        "Juntidhaarala Kannanu - Thene Madhurimalakannanu",
        "Shreshtamau Needu Vaakkula Chetha - Mammu Thrupthee Parachumu"
      ]
    }
  ]
}
