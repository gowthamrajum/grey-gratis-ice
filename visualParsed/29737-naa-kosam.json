  "main_stanza": {
    "telugu": [
      "నాకోసం నీ ప్రాణం",
      "ఎందుకలా ఇచ్చావు",
      "నీవు మాట ఇచ్చావనా",
      "నీవు మనసు ఇచ్చావనా",
      "దేవా – ఎంత ప్రేమయ్యా – నా యేసయ్య",
      "అర్హత లేదయ్యా – యోగ్యుని కానయ్య"
    ],
    "english": [
      "Naakosam nee praanam",
      "Endukalaa ichchaavu",
      "Neevu maata ichchaavanaa",
      "Neevu manasu ichchaavanaa",
      "Deva – Entha premayyaa – Naa Yesayya",
      "Arhatha ledayyaa – Yogyuni kaanayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా రోగం భరియించి",
        "నా వ్యసనం సహియించి",
        "దోషమంత నాది కాగ",
        "నాకొరకై నీవు నలిగితివా",
        "నా శిక్ష నీపై పడిన",
        "నీ నోరు తెరువకున్నావు",
        "మౌనముగా ఉన్నావు"
      ],
      "english": [
        "Naa rogam bhariyinchi",
        "Naa vyasanam sahiyinchi",
        "Dhoshamantha naadi kaaga",
        "Naakorakai neevu naligithivaa",
        "Naa shiksha neepai padina",
        "Nee noru theruvakunnaavu",
        "Maunamugaa unnaavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా పాపం మోసితివి",
        "అన్యాయం పొందితివి",
        "వేదనెంతో భారమైన",
        "చూసి తృప్తి పొందితివి",
        "నీ ప్రాణము దారపోసి",
        "పరిహారము చేసినావు",
        "శుద్ధినిగా చేసావు",
        "నిర్దోషిగా మార్చావు"
      ],
      "english": [
        "Naa paapam mosithivi",
        "Anyaayam pondhithivi",
        "Vedhanentho bhaaramaina",
        "Choosi thrupthi pondhithivi",
        "Nee praanamu dhaaraposi",
        "Parihaaramu chesinaavu",
        "Shuddhinigaa chesaavu",
        "Nirdhoshigaa maarchaavu"
      ]
    }
  ]
