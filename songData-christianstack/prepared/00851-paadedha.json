{
  "song_name": "Paadedha",
  "author": {
    "Authored by": "Dr. Victor Rampogu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పాడెదా పాడెదా పాడెద యేసయ్యా",
      "నీ నామ గానము నే చేసెద యేసయ్యా",
      "నా హృదయ స్పందన తకదిమి తాళమై",
      "నా కంఠధ్వని మధురశ్రావ్యమై",
      "నా శ్వాసము సరిగమ నాదమై"
    ],
    "english": [
      "Paadedha paadedha paadedha yesayya",
      "nee naama gaanamu ne chesedha yesayya",
      "naa hrudhaya spandhana thakadhimi thaalamai",
      "naa kantadwani madhura sraavyamai",
      "naa swaasamu sarigama naadhamai"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవు చేసిన మేళుల మరువక",
        "నా దోషముల క్షమించిన వాడవని",
        "సంకటముల కుదుర్చిన వాడవని",
        "మరణము నుండి కాపాడితివని",
        "నా నేరములకు శిక్ష విధించక",
        "అతిక్రమ క్రియలకు ప్రతిఫలమివ్వక",
        "ఎన్నడు కలువని భూదిశలవలే",
        "అపరాధముల దూరపరచితివని"
      ],
      "english": [
        "Paadedhaa paadedhaa paadedhaa yesayya",
        "nee naama gaanamu ne chesedha yesayya",
        "naa hrudhaya spandhana thakadhimi thaalamai",
        "naa kantadwani madhura sraavyamai",
        "naa swaasamu sarigama naadhamai"
      ]
    }
  ]
}
