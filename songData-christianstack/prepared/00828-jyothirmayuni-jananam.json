{
  "song_name": "Jyothirmayuni Jananam",
  "author": {
    "Authored by": "Param Jyothi Gummalla",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జ్యోతిర్మయుని జననం – సర్వలోకానికి",
      "సంబరమే సంబరమే జగమంతా సంబరమే",
      "ఆరాధింప రండి – ఆనందింప రండి"
    ],
    "english": [
      "Jyothirmayuni jananam – sarvalokaaniki",
      "sambaramey sambaramey jagamanthaa sambaramey",
      "aaraadhimpa randi – aanandimpa randi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజా నీకే స్తోత్రము",
        "శ్రీ యేసు రాజా నీకే స్తుతి స్తోత్రము"
      ],
      "english": [
        "Raajaa neekey sthothramu",
        "sri yesu raajaa neekey sthuthi sthothramu"
      ]
    }
  ]
}
