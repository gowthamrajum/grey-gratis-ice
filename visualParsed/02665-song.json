  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "సంపూర్ణ భక్తితో నుండెదన్",
        "పెంపార యేసున్ ధ్యానించెదన్",
        "సొంపైన దూతల్ పాడుచుండన్",
        "ఇంపైన పాటల్ నే విందును."
      ],
      "english": [
        "Sampoorna bhakthitho nundedhan",
        "Pempaara Yesun dhyaaninchedhan",
        "Sompaina dhoothal paaduchundan",
        "Impaina paatal ne vindunu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నిండైన భక్తియే నెమ్మది",
        "గెల్చున దేమి యేసుండఁగ",
        "మెండైన దీప్తిన్ బ్రార్థించుచు",
        "దండిగ బ్రేమన్ సుఖింతును."
      ],
      "english": [
        "Nindaina bhakthiye nemmadi",
        "Gelchuna dhemi Yesundaga",
        "Mendaina dheepthin braarthinchuchu",
        "Dandiga breman sukhinthunu."
      ]
    }
  ]
