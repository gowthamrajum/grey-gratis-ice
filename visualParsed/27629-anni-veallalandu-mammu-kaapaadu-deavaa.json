{
  "song_name": "Anni velalandu mammu kaapaadu Deva",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor John Wesley"
    ],
    "రచన": [
      "పాస్టర్ జాన్ వెస్లీ"
    ]
  },
  "main_stanza": {
    "telugu": [
      "అన్ని వేళలందు మమ్ము కాపాడు దేవా",
      "నిన్ను స్తుతించకుండ ఉండగలమా",
      "అన్ని నామముల కన్న పై నామము",
      "నిన్ను కీర్తించకుండ ఉండగలమా",
      "నిన్నే నిన్నే సన్నుతించెదం – సర్వజ్ఞ్యుడవు నీవే అని",
      "నిన్నే నిన్నే ఆరాధించెదం సర్వాధికారం నీదేనని",
      "“ఆరాధన ఆరాధన ఆరాధన నీకే",
      "హల్లెలూయ హల్లెలూయ హల్లెలూయ నీకే”"
    ],
    "english": [
      "Anni velalandu mammu kaapaadu Deva",
      "Ninnu sthuthinchakunda undagalamaa",
      "Anni naamamula kanna pai naamamu",
      "Ninnu keerthinchakunda undagalamaa",
      "Ninne ninne sannuthinchedham – Sarvagnyudavu neeve ani",
      "Ninne ninne aaraadhinchedam sarvaadhikaaram needhenani",
      "“Aaraadhana aaraadhana aaraadhana neeke",
      "Hallelooya hallelooya hallelooya neeke”"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మా మంటి ఘటములలో నీ మహిమను నింపి",
        "నీ రూపులో మమ్ము స్థాపించినావయ్యా…",
        "సంగీత నాదం ఆత్మీయ గానం – మా హృదిలో నింపి నడిపించినావు…"
      ],
      "english": [
        "Maa manti ghatamulalo nee mahimanu nimpi",
        "Nee roopulo mammu sthaapinchinaavayyaa…",
        "Sangeetha naadam aathmeeya gaanam – Maa hrudilo nimpi nadipinchinaavu…"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మా ప్రతి అవసరము – నీ మహిమలో తీర్చి",
        "నీ ముఖ దర్శనము – మాకొసగితివి…",
        "ఆత్మాభిషేకం ఆశ్చర్య ప్రేమ నిండుగ నొసగి బలపరచినావు"
      ],
      "english": [
        "Maa prathi avasaramu – Nee mahimalo theerchi",
        "Nee mukha darshanamu – Maakosagithivi…",
        "Aathmaabhishekam aashcharya prema ninduga nosagi balaparachinaavu"
      ]
    }
  ]
}
