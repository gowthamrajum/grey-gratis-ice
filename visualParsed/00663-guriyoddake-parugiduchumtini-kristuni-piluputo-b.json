  "main_stanza": {
    "telugu": [
      "గురియొద్దకే పరుగిడుచుంటిని క్రీస్తుని పిలుపుతో",
      "బహుమానము పొందు రీతిని అలయిక వెనుతిరుగక",
      "యేసులో కొనసాగెదన్ యేసుతో కనసాగెదన్",
      "కొండలైన లోయలైన యేసుతో కనసాగెదన్"
    ],
    "english": [
      "Guriyoddhake parugiduchuntini Kreesthuni piluputho",
      "Bahumaanamu pondu reethini alayika venuthirugaka",
      "Yesulo konasaagedhan Yesutho konasaagedhan",
      "Kondalaina loyalaina Yesutho konasaagedhan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాగటిపైన చేయి నిలిపి వెనుక చూడక కనసాగెదన్",
        "కన్నీరు కార్చి దేవుని వాక్యం మనుష్య హృదయములో నాటెదన్",
        "ఎన్నడూ దున్నబడని భూమిని నేదున్నెదన్"
      ],
      "english": [
        "Naagatipaina cheyi nilipi venuka choodaka konasaagedhan",
        "Kanneeru kaarchi Devuni vaakyam manushya hrudayamulo naatedhan",
        "Ennadoo dhunnabadani bhoomini nedhunnedhan"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శిలువను మోయుచు క్రీస్తు ప్రేమను ఊరువాడలనే చాటెదున్",
        "శిరమును వంచి కరములు జీడించి ప్రార్థనాత్మతోనే వేడెదన్",
        "శిలువ ప్రేమ నాలో ప్రజలకు చూపింతును",
        "కొండలైన లోయలైన యేసుతో కొనసాగెదన్"
      ],
      "english": [
        "Shiluvanu moyuchu Kreesthu premanu ooruvaadalane chaatedhun",
        "Shiramunu vanchi karamulu jodinchi praarthanaathmathone vededhan",
        "Shiluva prema naalo prajalaku choopinthunu",
        "Kondalaina loyalaina Yesutho konasaagedhan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నాశనమునకు జోగువారిని క్రీస్తు ప్రేమతో రక్షింతును",
        "నరకము నుండి మోక్షమునకు మార్గమేనని ప్రకటింతును",
        "నేను వెళ్ళెదన్ వెళ్ళువారిని నే పంపెదన్",
        "కొండలైన లోయనైన యేసుతో కొనసాగెదన్"
      ],
      "english": [
        "Naashanamunaku joguvaarini Kreesthu prematho rakshinthunu",
        "Narakamu nundi mokshamunaku maargamenani prakatinthunu",
        "Nenu velledhan velluvaarini ne pampedhan",
        "Kondalaina loyanaina Yesutho konasaagedhan"
      ]
    }
  ]
