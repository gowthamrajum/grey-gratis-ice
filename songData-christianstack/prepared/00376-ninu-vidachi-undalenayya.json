{
  "song_name": "Ninu Vidachi Undalenayya",
  "author": {
    "Authored by": "Bandela Naga Raju",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసయ్యా",
      "నీవే నాకు మార్గము, సత్యము, జీవమయ్యా"
    ],
    "english": [
      "Yesayyaa",
      "neeve naaku maargamu, sathyamu, jeevamayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిను విడచి ఉండలేనయ్యా",
        "నీ ప్రేమను మరువలేనయ్యా",
        "నను ప్రేమించెను నను విడిపించెను",
        "నను దీవించెను నను బ్రతికించెను",
        "అనుక్షణము రక్షించెను",
        "యేసు నన్ను అనుక్షణము రక్షించెను",
        "నా దేవుడు గొప్ప దేవుడు",
        "నా యేసయ్యా ప్రేమామయుడు"
      ],
      "english": [
        "Ninu vidachi undalenayyaa",
        "nee premanu maruvalenayyaa",
        "nanu preminchenu nanu vidipinchenu",
        "nanu dheevinchenu nanu brathikinchenu",
        "anukshanamu rakshinchenu",
        "yesu nannu anukshanamu rakshinchenu",
        "naa devudu goppa devudu",
        "naa yesayyaa premaamayudu"
      ]
    }
  ]
}
