      "english": [
        "Lokaadhipathi sarvonnathudaa kaarana janmudaa",
        "Lokaaniki velugainavaadaa thejomayudaa",
        "Dhayaadhaakshinyapoornudaa mahimaanvithudaa",
        "Ghanathaku paathruda neevayyaa",
        "Galameththi ninnu pogadedhamayya"
