  "main_stanza": {
    "telugu": [
      "దేవుని ఉపకారంబులలోన - దేనిని మరువకుము",
      "ఆయన చేసిన మేలులన్నియు - అనుదినమును ధ్యానించుము"
    ],
    "english": [
      "Devuni Upakaarambulalona - Denini Maruvakumu",
      "Aayana Chesina Melulanniyu - Anudinamunu Dhyaaninchumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిరాశతో మనమున్నప్పుడు - నిరసించిపడియున్నప్పుడు (2X)",
        "మరణ చాయలో నున్నప్పుడు - మరువకుండ కాపాడెనుగా"
      ],
      "english": [
        "Niraashatho Manamunnappudu - Nirasinchipadiyunnappudu (2X)",
        "Marana Chaayalo Nunnappudu - Maruvakunda Kaapaadenugaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వ్యాధులలో మనమున్నప్పుడు - బాధలలో మనమున్నప్పుడు (2X)",
        "వ్యాధుల బాధల తొలగించి - ఆదరించి కాపాడెనుగా"
      ],
      "english": [
        "Vyaadhulalo Manamunnappudu - Baadhalalo Manamunnappudu (2X)",
        "Vyaadhula Baadhala Tholaginchi - Aadarinchi Kaapaadenugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మహోపకారములన్నియును - యెహోవ దేవుడె చేసెనుగా (2X)",
        "అహోరాత్రులు ధ్యానించి - మహోన్నతుని స్తుతియించుము"
      ],
      "english": [
        "Mahopakaaramulanniyunu - Yehova Devude Chesenugaa (2X)",
        "Ahoraathrulu Dhyaaninchi - Mahonnathuni Sthuthiyinchumu"
      ]
    }
  ]
