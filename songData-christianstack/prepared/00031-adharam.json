  "main_stanza": {
    "telugu": [
      "ఆధారం నీవే యేషువా",
      "ఆశ్రయము నీవే నా దేవా"
    ],
    "english": [
      "Aadharam neeve Yeshuva",
      "Aasrayamu neeve naa deva"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఏమైనా చేస్తావని నాకోసం",
        "కడవరకు నడిపిస్తావని విశ్వాసం"
      ],
      "english": [
        "Emaina chesthavani naakosam",
        "Kadavaraku nadipisthavani viswasam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యేషువా నడిపించే నా దేవా",
        "యేషువా నా కొరకై నువ్వు రావా"
      ],
      "english": [
        "Yeshuva nadipinche naa dheva",
        "Yeshuva naa korakai nuvvu raava"
      ]
