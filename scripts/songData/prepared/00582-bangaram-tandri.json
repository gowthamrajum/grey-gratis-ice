{
  "song_name": "Bangaram Tandri",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "బంగారం తండ్రి నా యేసయ్యా",
      "స్తోత్రము చెల్లింతును యేసయ్యా",
      "నేరము చేసితిని నేనయ్యా",
      "నా భారాన్ని మోసిన యేసయ్యా"
    ],
    "english": [
      "Bangaram Tamdri Na Yesayya",
      "Stotramu Chellimtunu Yesayya",
      "Neramu Chesithini Nenayya",
      "Na Baranni Mosina Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపమునుండి నన్ను విడిపించి నీ రక్తము నాకై",
        "నీవు చిందించి రక్షణ వస్త్రమును నాకిచ్చి",
        "నా రక్షకుడైనావు యేసయ్యా"
      ],
      "english": [
        "Papamunumdi Nannu Vidipimchi Ni Raktamu Nakai",
        "Nivu Chimdimchi Rakshana Vastramunu Nakichchi",
        "Na Rakshakudainavu Yesayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శత్రువు నుండి నన్ను విడిపించి నీ రెక్కల నీడలో",
        "దాచితివి దుఃఖములన్నియు బాపితివా",
        "నా చక్కని తండ్రివయ్యా యేసయ్యా"
      ],
      "english": [
        "Satruvu Numdi Nannu Vidipimchi Ni Rekkala Nidalo",
        "Dachithivi Duhkamulanniyu Bapithiva",
        "Na Chakkani Tamdrivayya Yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అడుగులు జారక నను నడిపితివి నీ ఉన్నత సేవకై",
        "పిలిచితివి ఎన్నిక లేని నన్ను ఎన్నుకొని",
        "ఇంత భాగ్యము నిచ్చావు యేసయ్యా"
      ],
      "english": [
        "Adugulu Jaraka Nanu Nadipithivi Ni Unnata Sevakai",
        "Pilichithivi Ennika Leni Nannu Ennukoni",
        "Imta Bagyamu Nichchavu Yesayya"
      ]
    }
  ]
}
