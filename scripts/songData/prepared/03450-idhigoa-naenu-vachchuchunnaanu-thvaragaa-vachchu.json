{
  "song_name": "Idhigoa Naenu Vachchuchunnaanu Thvaragaa Vachchuchunnaanu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇదిగో నేను వచ్చుచున్నాను - త్వరగా వచ్చుచున్నాను",
      "ఎవని క్రియల ఫలితము - వానికియ్య వచ్చుచున్నాను"
    ],
    "english": [
      "Idhigoa Naenu Vachchuchunnaanu - Thvaragaa Vachchuchunnaanu",
      "Evani Kriyala Phalithamu - Vaanikiyya Vachchuchunnaanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మేఘారూఢుడనై నిక్కముగా - తిరిగి వచ్చుచున్నాను",
        "ప్రతి నేత్రము వీక్షించును - పరిశుద్ధులై యుండుడి"
      ],
      "english": [
        "Maeghaaroodudanai Nikkamugaa - Thirigi Vachchuchunnaanu",
        "Prathi Naethramu Veekshimchunu - Parishudhdhulai Yumdudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నేను త్వరగా వచ్చుచున్నాను - ఎవడు నీ కిరీటమును",
        "అపహరింప కుండునట్లు - జాగ్రత్తగా చూచుకో"
      ],
      "english": [
        "Naenu Thvaragaa Vachchuchunnaanu - Evadu Nee Kireetamunu",
        "Apaharimpa Kumdunatlu - Jaagraththagaa Choochukoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసు ప్రభువే సర్వమును - నూతన పరచుచున్నాడు",
        "క్రీస్తుని రాకడను ప్రేమించి - కాయువారే ధన్యులు"
      ],
      "english": [
        "Yaesu Prabhuvae Sarvamunu - Noothana Parachuchunnaadu",
        "Kreesthuni Raakadanu Praemimchi - Kaayuvaarae Dhanyulu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేవేగరా మా ప్రభు యేసు - వేచియున్నాను నీ కొరకే",
        "నీ దూతలతో వినుతించుచు - హల్లెలూయ పాడెదము"
      ],
      "english": [
        "Vaevaegaraa Maa Prabhu Yaesu - Vaechiyunnaanu Nee Korakae",
        "Nee Dhoothalathoa Vinuthimchuchu - Hallelooya Paadedhamu"
      ]
    }
  ]
}
