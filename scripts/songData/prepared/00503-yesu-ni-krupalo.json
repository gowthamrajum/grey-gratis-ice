{
  "song_name": "Yesu Nee Krupalo",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసు నీ క్రుపలో యేసు నీ క్రుపలో",
      "మము కాపాడుము దేవా మమ్ము రక్షించి",
      "నిత్య రాజ్యములో నడుపము మా ప్రభువా - నడుపుము మా ప్రభువా"
    ],
    "english": [
      "Yesu Nee Krupalo Yesu Nee Krupalo",
      "Mamu Kaapaadumu Devaa Mammu Rakshinchi",
      "Nithya Raajyamulo Nadupama Maa Prabhuvaa - Nadupumu Maa Prabhuvaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కృంగిన వేళలలో - అలసిన సమయములో",
        "నా చేయి విడువకను - నన్ను నిలబెట్టు",
        "నన్ను నీ ఆత్మతో పూర్ణముగా చేసి",
        "నిలుపుము జ్యోతివలె - నిలుపుము జ్యోతివలె"
      ],
      "english": [
        "Krungina Velalalo - Alasina Samayamulo",
        "Naa Cheyi Viduvakanu - Nannu Nilabettu",
        "Nannu Nee Aathmatho Poornamugaa Chesi",
        "Nilupumu Jyothivale - Nilupumu Jyothivale"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సిలువను మోసికొని - సువార్త చాటింప",
        "విలువగు నీ శక్తిచే - నిత్యము నడిపించు",
        "యేసు నీ రాకడలో - నిన్ను ఎదుర్కొనుటకు",
        "నీ కృప నీయుమయా - నీ కృప నీయుమయా"
      ],
      "english": [
        "Siluvanu Mosikoni - Suvaartha Chaatimpa",
        "Viluvagu Nee Shakthiche - Nithyamu Nadipinchu",
        "Yesu Nee Raakadalo - Ninnu Edurkonutaku",
        "Nee Krupa Neeyumayaa - Nee Krupa Neeyumayaa"
      ]
    }
  ]
}
