{
  "song_name": "Vinarae Yaesukreesthu Boadha Madhini",
  "author": {
    "Authored by": "",
    "రచన": "పులిపాక జగన్నాధము"
  },
  "main_stanza": {
    "telugu": [
      "వినరే యేసుక్రీస్తు బోధ మదిని గొనరే యాతని సత్య బోధ",
      "వినిన యేసుని బోధ విశ్వాసమున మీరు గొనయెదరు నిజముగ గొప్ప భాగ్యంబులు"
    ],
    "english": [
      "Vinarae Yaesukreesthu Boadha Madhini Gonarae Yaathani Sathya Boadha",
      "Vinina Yaesuni Boadha Vishvaasamuna Meeru Gonayedharu Nijamuga Goppa Bhaagyambulu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దారి దొలఁగియున్న వారినెల్లను బ్రోవఁ",
        "గోరివచ్చితి నంచు కూర్మి యేసువు తెల్పె"
      ],
      "english": [
        "Dhaari Dholagiyunna Vaarinellanu Broava",
        "Goarivachchithi Nanchu Koormi Yaesuvu Thelpe"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మన పాపముల నెల్ల మన కొరకు వహియించి",
        "మన యందు దయచేతఁ దన ప్రాణమర్పించి"
      ],
      "english": [
        "Mana Paapamula Nella Mana Koraku Vahiyinchi",
        "Mana Yandhu Dhayachaetha Dhana Praanamarpinchi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మారు మనసు నొంది మరల రమ్మంచువే",
        "మారు బిలుచు యేసు మైత్రిని దలఁచుచు"
      ],
      "english": [
        "Maaru Manasu Nondhi Marala Rammanchuvae",
        "Maaru Biluchu Yaesu Maithrini Dhalachuchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తన యాజ్ఞ గైకొని తన సేవజేసెడి",
        "మనుజుల కొసఁగును మనసున నెమ్మది"
      ],
      "english": [
        "Thana Yaagna Gaikoni Thana Saevajaesedi",
        "Manujula Kosagunu Manasuna Nemmadhi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తాను నడచిన త్రోవ తన జనులు ద్రొక్కును",
        "తానెపుడు చేయును తగిన సహాయ్యంబు"
      ],
      "english": [
        "Thaanu Nadachina Throava Thana Janulu Dhrokkunu",
        "Thaanepudu Chaeyunu Thagina Sahaayyambu"
      ]
    }
  ]
}
