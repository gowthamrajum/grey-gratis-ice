{
  "song_name": "Vyarthamu vyartham sarvamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వ్యర్థము, వ్యర్థం, సర్వము వ్యర్థం",
      "నశించు లోకం నాశము తధ్యం"
    ],
    "english": [
      "Vyarthamu, vyartham, sarvamu vyartham",
      "Nashinchu lokam naashamu thadhyam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దుష్టలోకములో సర్వము చెడెను",
        "దీని యందంవాడి పోవుచున్నది - పోవుచున్నది || వ్యర్థం ||"
      ],
      "english": [
        "Dushtalokamulo sarvamu chedenu",
        "Deeni yandamvaadi povuchunnadhi - Povuchunnadhi || Vyartham ||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చూడన్ మనసేలాగు నాశనమైపోయెన్",
        "నిండియున్నదిపుడే పాపపుపాత్ర, పాపపుపాత్ర || వ్యర్థం ||"
      ],
      "english": [
        "Choodan manaselaagu naashanamaipoyen",
        "Nindiyunnadhipude paapapupaathra, paapapupaathra || Vyartham ||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నలుదిశల చూడుమా పాపము కలదు",
        "కలహ కలవరముతో నిండియున్నది, నిండియున్నది || వ్యర్థం ||"
      ],
      "english": [
        "Naludhishala choodumaa paapamu kaladu",
        "Kalaha kalavaramutho nindiyunnadhi, nindiyunnadhi || Vyartham ||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "లోకంలో నన్ని గతించి పోవునవి",
        "లోకం యెంతో అయోగ్యంబైయున్నది, అయోగ్యంబదే || వ్యర్థం ||"
      ],
      "english": [
        "Lokamlo nanni gathinchi povunavi",
        "Lokam entho ayogyambaiyunnadhi, ayogyambadhe || Vyartham ||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యిద్ధరలో మనకేమియు లేదు",
        "స్వార్థము, శతృత్వము, ఈర్ష్యమయము, ఈర్ష్యమయము || వ్యర్థం ||"
      ],
      "english": [
        "Iddharalo manakemiyu ledu",
        "Swaarthamu, shathruthvamu, eershyamayamu, eershyamayamu || Vyartham ||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఒకనాడీ మహిని ప్రభువు దహించును",
        "సకలంబును నాశనంబుచేయును, నాశనముచేయును || వ్యర్థం ||"
      ],
      "english": [
        "Okanaadee mahini Prabhuvu dahinchunu",
        "Sakalambunu naashanambucheyunu, naashanamucheyunu || Vyartham ||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఒక రాజ్యము వచ్చునందు దీవెన కలదు",
        "సకల శాంతి సంతోషమందు కలదు, అందునగలదు || వ్యర్థం ||"
      ],
      "english": [
        "Oka raajyamu vachchunandhu deevena kaladu",
        "Sakala shaanthi santhoshamandhu kaladu, andhunagaladhu || Vyartham ||"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ఆ రాజ్యంలో నీవు ప్రవేశించుటకు",
        "మారు మనస్సునొంది యేసుని నమ్ము, యేసుని నమ్ము || వ్యర్థం ||"
      ],
      "english": [
        "Aa raajyamlo neevu praveshinchutaku",
        "Maaru manassunondhi Yesuni nammu, Yesuni nammu || Vyartham ||"
      ]
    }
  ]
}
