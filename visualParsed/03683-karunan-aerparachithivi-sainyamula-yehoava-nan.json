    },
    {
      "stanza_number": 5,
      "telugu": [
        "జెరుబ్బాబెలున్ కోరుకొని - ముద్రయుంగరముగ జేసెన్",
        "నిర్మించెను ప్రభుని ఆలయమున్ - విరివైన యిరుకుల యందు"
      ],
      "english": [
        "Jerubbaabelun korukoni - Mudhrayungaramuga jesen",
        "Nirminchenu Prabhuni aalayamun - Virivaina irukula yandu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "స్తెఫెనును కోరుకొని - నింపెను తన యాత్మతో",
        "సంపూర్ణమగు తన సాక్షిగా - పంపెను తన హతహాక్షునిగ"
      ],
      "english": [
        "Sthephenunu korukoni - Nimpenu thana yaathmatho",
        "Sampoornamagu thana saakshigaa - Pampenu thana hathahaakshuniga"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పౌలును కోరుకొనెన్ - సౌలుగ నున్నయపుడే",
        "పలుసంఘముల నిల స్థాపించెన్",
        "ఎల్ల మేలులకు హల్లెలూయ ప్రభో"
