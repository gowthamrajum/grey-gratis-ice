  "main_stanza": {
    "telugu": [
      "నా జీవిత కాలమంత",
      "నిను కీర్తించిన చాలునా",
      "నా సమస్త సంపద",
      "నీకిచ్చిన చాలునా",
      "యేసు నీదు మేలులకై",
      "నే బదులుగా యేమిత్తును",
      "నా దేహమే యాగముగా",
      "అర్పించిన చాలునా ||నా జీవిత||"
    ],
    "english": [
      "Naa jeevitha kaalamantha",
      "Ninu keerthinchina chaaluna",
      "Naa samastha sampada",
      "Neekichchina chaaluna",
      "Yesu needu melulakai",
      "Ne badhulugaa emitthunu",
      "Naa dehame yaagamugaa",
      "Arpinchina chaaluna ||Naa jeevitha||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా బాల్యమంతా - నా తోడుగా నిలచి",
        "ప్రతి కీడునుండి - తప్పించినావు",
        "యవ్వన కాలమున - నే త్రోవ తొలగిన",
        "మన్నించి నాతోనే - కొనసాగినావు",
        "ఎన్నో శ్రమలు - ఆపదలన్నిటిలో",
        "నను ధైర్యపరచి - నను ఆదుకున్నావు",
        "యేసు నీవే - నీవే యేసు",
        "నీవే నా - సర్వస్వమూ  ||నా||"
      ],
      "english": [
        "Naa baalyamanthaa - Naa thodugaa nilachi",
        "Prathi keedunundi - Thappinchinaavu",
        "Yavvana kaalamuna - Ne throva tholagina",
        "Manninchi naathone - Konasaaginaavu",
        "Enno shramalu - Aapadhalannitilo",
        "Nanu dhairyaparachi - Nanu aadhukunnaavu",
        "Yesu neeve - Neeve Yesu",
        "Neeve naa - Sarvasvamoo ||Naa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కన్నీటి రాత్రులు - నే గదిపిన వెంటనే",
        "సంతోష ఉదయాలు - నాకిచ్చినావు",
        "హృదయాశలన్నీ - నేరవెర్చినావు",
        "యొగ్యుడను కాక్నున్న - హెచ్చించినావు",
        "ఎంతో ప్రేమ - మితిలేని కృపను",
        "నాపై చూపించి - నను హత్తుకున్నావు",
        "యేసు నీవే - నీవే యేసు",
        "నీవే నా - ఆనందమూ  ||నా||"
      ],
      "english": [
        "Kanneeti raathrulu - Ne gadipina ventane",
        "Santhosha udhayaalu - Naakichchinaavu",
        "Hrudhayaashalannee - Neraverchinaavu",
        "Yogyudanu kaakunna - Hechchinchinaavu",
        "Entho prema - Mithileni krupanu",
        "Naapai choopinchi - Nanu hatthukunnaavu",
        "Yesu neeve - Neeve Yesu",
        "Neeve naa - Aanandhamoo ||Naa||"
      ]
    }
  ]
}
