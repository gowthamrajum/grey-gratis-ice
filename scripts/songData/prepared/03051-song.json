{
  "song_name": "Aedhaen Vanmbunmdhu Aadhi Vivaahamun",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ కెబిల్"
  },
  "main_stanza": {
    "telugu": [
      "ఏదేన్ వనంబునందు ఆది వివాహమున్",
      "విధించినట్టి వాక్కు వర్థిల్లు నిప్పుడున్."
    ],
    "english": [
      "Aedhaen VanMbunMdhu Aadhi Vivaahamun",
      "ViDhiMchinatti Vaakku VarThillu Nippudun."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పవిత్ర కల్యాణంబున్ పదిలపర్చుచు",
        "దైవ త్రిత్వంబు నేఁడున్ దీవింప వత్తురు."
      ],
      "english": [
        "Pavithra KalyaaNMbun Padhilaparchuchu",
        "Dhaiva ThrithvMbu NaeAOdun DheeviMpa Vaththuru."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంతాన వరమును సంతోష ప్రేమయు",
        "వింతైన యైక్యత్వంబు నెంతయు నిత్తురు."
      ],
      "english": [
        "SMthaana Varamunu SMthoaSh Praemayu",
        "ViMthaina YaikyathvMbu NeMthayu Niththuru."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆదామునకుఁ దండ్రీ, హవ్వ నొ సంగితి",
        "వాదరముగ నీమె నీ ధన్యున కిమ్ము"
      ],
      "english": [
        "AadhaamunakuAO DhMdree, Havva No SMgithi",
        "Vaadharamuga Neeme Nee Dhanyuna Kimmu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీ ఱెక్క క్రింద వీరిఁ బరిగ్రహించుచు",
        "వైరి తంత్రంబునుండి దూరంబుఁ జేయుము."
      ],
      "english": [
        "Nee Rekka KriMdha VeeriAO BarigrahiMchuchu",
        "Vairi ThMthrMbunuMdi DhoorMbuAO Jaeyumu."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఈ రీతిన్ బ్రత్కి యంత క్రీస్తేసు పెండ్లికి",
        "వీరిద్దరును జేరి బరంగఁ జేయుమి."
      ],
      "english": [
        "Ee Reethin Brathki YMtha Kreesthaesu PeMdliki",
        "Veeridhdharunu Jaeri BarMgAO Jaeyumi."
      ]
    }
  ]
}
