        "ఒంటరిగా ఉన్న మరియను",
        "యేసు యోహానును అప్పగించితివి (2) ||అయ్యా వందనమయ్యా||"
      ],
      "english": [
        "Anaatha nenu kaadani",
        "Siluvapai naaku chepputaku",
        "Ontarigaa unna Mariyanu",
        "Yesu Yohaanunu appaginchithivi (2) ||Ayyaa vandanamayyaa||"
      ]
    }
  ]
