  "main_stanza": {
    "telugu": [
      "రాజులకు రాజంట ప్రభువులకు ప్రభువంట",
      "బెల్లేహేము పురములోన పుట్టెనంట",
      "సూడసక్కనోడంట పశులపాకలోనంట",
      "దావీదు కుమారుడంట లోక రక్షకుడంట",
      "కనులారా. ఓహెూ కనులారా.",
      "ఆహా. కనులారా సూద్దాము రారండి బాలయేసుని",
      "మనసారా కొనియాడ సేరండి సిన్ని క్రీస్తుని"
    ],
    "english": [
      "Raajulaku raajanta prabhuvulaku prabhuvanta",
      "Bethlehemu puramulona puttenanta",
      "Soodasakkanodanta pashulapaakalonanta",
      "Daaveedu kumaarudanta loka rakshakudanta",
      "Kanulaaraa. Oho kanulaaraa.",
      "Aahaa. Kanulaaraa sooddaamu raarandi baala Yesuni",
      "Manasaaraa koniyaada serandi sinni Kreesthuni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపమంత బాపునంట దోషమంత మాపునంట",
        "కరుణశీలుడు ఆ యేసు కనికరించె దేవుడంట 2",
        "ఇమ్మానుయేలుగ తోడుండునంట సిన్ని యేసయ్య",
        "ఎన్నడు విడువక ఎడబాయడంట మంచిమెస్సయ్య 2"
      ],
      "english": [
        "Paapamantha baapunanta dhoshamanta maapunanta",
        "Karunasheeludu aa Yesu kanikarinche dhevudanta 2",
        "Immaanuyeluga thodundunanta sinni Yesayya",
        "Ennadu viduvaka edabaayadanta manchi Messayya 2"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "జ్ఞానులంత జూచిరంట గొల్లలంత గూడిరంట",
        "బాలయేసు పాదచెంత చేరి స్తుతియించారంట",
        "బంగారు సాంబ్రాణి బోళములతో ఘనపరిచినారంట",
        "దివిలోన దూతలు పరిశుద్దుడంటూ కొనియాడినారంట"
      ],
      "english": [
        "Gnaanulanta joochiranta gollalanta goodiranta",
        "Baala Yesu paadhachentha cheri sthuthiyinchaaranta",
        "Bangaaru saambraani bolamulatho ghanaparichinaaranta",
        "Dhivilona doothalu parishuddhudantoo koniyaadinaaranta"
      ]
    }
  ]
