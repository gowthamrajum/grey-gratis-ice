{
  "song_name": "Reference: Ee maatalu vininappudu nenu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆకాశమందలి దేవుని యెదుట విజ్ఞాపన చేసితిని. నెహెమ్యా నెహెమయా 1:4",
      "ఎజ్రా ఎజ్రా 10:1",
      "విలపింతువా నెహెమ్యావలె? - విలపింతువా ఎజ్రావలె? (2)",
      "కూర్చుండి దుఃఖముతో ఉపవాసముతో",
      "పడిపోయిన ప్రభుని యింటిని గూర్చి విలపింతువా? (2)"
    ],
    "english": [
      "Aakaashamandhali Devuni eduta vijnaapana chesithini. Nehemyaa Nehemiah 1:4",
      "Ezraa Ezra 10:1",
      "Vilapinthuvaa Nehemyaavale? - Vilapinthuvaa Ezraavale? (2)",
      "Koorchundi duhkhamutho upavaasamutho",
      "Padipoyina Prabhuni intini goorchi vilapinthuvaa? (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆత్మీయ గ్రహింపు లేకయే",
        "ఆత్మ ఐక్యంబు కోల్పోతిమి",
        "ఎటుచూచిన ప్రభు యిల్లు పడిపోయెను",
        "ప్రభు ప్రత్యక్షత కోల్పోతిమి"
      ],
      "english": [
        "Aathmeeya grahimpu lekaye",
        "Aathma aikyambu kolpothimi",
        "Etuchoochina Prabhu illu padipoyenu",
        "Prabhu prathyakshatha kolpothimi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అగ్నిచే కాల్చబడిన గుమంబులన్",
        "పడిపోయిన ప్రాకారమున్",
        "పునహ్నిర్మించి నిందను తొలగించెదమా?",
        "ప్రభు హస్తంబుతోడుండగన్"
      ],
      "english": [
        "Agniche kaalchabadina gummambulan",
        "Padipoyina praakaaramun",
        "Punarnirminchi nindanu tholaginchedhamaa?",
        "Prabhu hasthambuthodundagan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆత్మీయ ప్రేమ సహవాసంబుతో",
        "ఆత్మకలిగించు ఐక్యతతో",
        "ఒకరినొకరు క్షమించి, సహించుచూ",
        "ప్రభు ప్రత్యక్షత పొందెదమా?"
      ],
      "english": [
        "Aathmeeya prema sahavaasambutho",
        "Aathmakaliginchu aikyathatho",
        "Okarinokaru kshaminchi, sahinchuchoo",
        "Prabhu prathyakshatha pondhedhamaa?"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నెహెమ్యావలె హృదయంబుల చింపుకొని",
        "పశ్చాత్తాపముతో ప్రభుని చేరి",
        "ఒక చేత ఆయుధము పట్టుకొని",
        "ప్రభుయింటిని కట్టెదమా"
      ],
      "english": [
        "Nehemyaavale hrudhayambula chimpukoni",
        "Pashchaatthaapamutho Prabhuni cheri",
        "Oka chetha aayudhamu pattukoni",
        "Prabhu intini kattedhamaa"
      ]
    }
  ]
}
