      "లోకాన చాటేద్దాం"
    ],
    "english": [
      "Lyrics:-",
      "Yesayya janminche ee nelapai",
      "Sambaraalu chesedhdhaam ekamai…",
      "Lokamunu preminchi vachchina",
      "Priya kumaarunikai…",
      "Oorooraa velledhaam suvaartha chesedam",
      "Lokaana chaatedhdhaam"
    ]
  },
  "stanzas": [
    {
