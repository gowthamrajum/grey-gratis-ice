{
  "song_name": "Dinamulu cheddavigaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దినములు చెడ్డవిగా అజ్ఞానము విడిచెదవా",
      "జ్ఞానముతో బ్రతికెదవా క్రీస్తు సాక్షగా నిలిచెదవా (2)",
      "మేలుకో ఓ. సోదరా మేలుకో ఓ. సోదరీ (2)"
    ],
    "english": [
      "Dinamulu cheddavigaa ajnaanamu vidichedavaa",
      "Jnaanamutho brathikedavaa Kreesthu saakshigaa nilichedavaa (2)",
      "Meluko o. sodaraa meluko o. sodaree (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పనులకు సమయము వున్నా",
        "క్రీస్తు సేవకు సమయము లేదా (2)",
        "ప్రయాస పడుటకు సమయము నీకున్నా",
        "ప్రార్థించుటకు సమయము లేదా (2)",
        "ప్రశ్నించుకో ఓ సోదరా పరీక్షించుకో ఓ సోదరీ"
      ],
      "english": [
        "Panulaku samayamu vunnaa",
        "Kreesthu sevaku samayamu ledaa (2)",
        "Prayaasa padutaku samayamu neekunnaa",
        "Praarthinchutaku samayamu ledaa (2)",
        "Prashninchuko o sodaraa pareekshinchuko o sodaree"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అన్ని వినుటకు సమయము వున్నా",
        "యేసు మాటకు సమయము లేదా (2)",
        "మందితో గడిపే సమయము నీకున్నా",
        "మందిరమునకు సమయము లేదా (2)",
        "ప్రశ్నించుకో ఓ సోదరా పరీక్షించుకో ఓ సోదరీ"
      ],
      "english": [
        "Anni vinutaku samayamu vunnaa",
        "Yesu maataku samayamu ledaa (2)",
        "Manditho gadipe samayamu neekunnaa",
        "Mandiramunaku samayamu ledaa (2)",
        "Prashninchuko o sodaraa pareekshinchuko o sodaree"
      ]
    }
  ]
}
