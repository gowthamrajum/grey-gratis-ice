{
  "song_name": "Kanche Vesavu",
  "author": {
    "Authored by": "Pastor Prasad Nelapudi",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కంచే వేశావు మా ఇంటికి",
      "కరుణ చూపావు మా బ్రతుకులో",
      "నీతి సూర్యుడా తేజోమయుడా",
      "నీ వెలుగు మా ఇంట నింపావయ్యా"
    ],
    "english": [
      "Kanche vesaavu maa intiki",
      "karuna choopaavu maa brathukulo",
      "neethi sooryudaa thejomayudaa",
      "nee velugu maa inta nimpaavayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీవుండగా ఏ లోటు లేనెలేదు యేసయ్యా",
        "నేను నా ఇంటివారము నిన్నే సేవించెదం"
      ],
      "english": [
        "Neevundagaa ey lotu leneledhu yesayyaa",
        "nenu naa intivaaramu ninne sevinchedam"
      ]
    }
  ]
}
