  },
  "main_stanza": {
    "telugu": [
      "నీ నామంలో సంతోషం పూజ్యనీయుడా",
      "నీ కొరకే నా తృష్ణంతా ప్రాణ ప్రియుడా",
      "నిన్ ఆశించును నా ప్రాణమంతా",
      "నీకర్పింతును నా హృదయమంతా"
    ],
    "english": [
      "Nee naamamlo santhosham poojyaneeyudaa",
      "nee korake naa thrushnanthaa praana priyudaa",
      "nin aasinchunu naa praanamanthaa",
      "neekarpinthunu naa hrudhayamanthaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆరాధన ఆరాధన",
        "ఆరాధన నీకే"
      ],
      "english": [
        "Aaraadhana aaraadhana",
        "aaraadhana neeke"
      ]
    }
  ]
}
