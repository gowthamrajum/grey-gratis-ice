{
  "song_name": "Dhappigonina Vaanipai Neetin Kummarinchunu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దప్పిగొనిన వానిపై నీటిన్ కుమ్మరించును ఆ ప్రభువే",
      "ఎండియున్న భూమిపై జలముల్ - ప్రవహింప జేయునాయనే"
    ],
    "english": [
      "Dhappigonina vaanipai neetin kummarinchunu aa Prabhuve",
      "Endiyunna bhoomipai jalamul - Pravahimpa jeyunaayane"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వడిగల జలములలో దారిన్ - నిర్మించును ఆ ప్రభువే",
        "అడవులలో రాజబాటలను - స్థాపించును మన ప్రభువే"
      ],
      "english": [
        "Vadigala jalamulalo dhaarin - Nirminchunu aa Prabhuve",
        "Adavulalo raajabaatalanu - Sthaapinchunu mana Prabhuve"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మన సంతతిపై ఆత్మన్ - కుమ్మరించును మన ప్రభువే",
        "తన ఆత్మలో వారిని నింపి - నిర్మించును సంఘముగా"
      ],
      "english": [
        "Mana santhathipai aathman - Kummarinchunu mana Prabhuve",
        "Thana aathmalo vaarini nimpi - Nirminchunu sanghamugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీటికాలువలయొద్ద - నిరవంజి చెట్లవలె",
        "గడ్డిలో యెదుగునట్లు - వారు వర్ధిల్లెదరు"
      ],
      "english": [
        "Neetikaaluvalayodhdha - Niravanji chetlavale",
        "Gaddilo edhugunatlu - Vaaru vardhilledharu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కరుణాపీఠము పై నుండి - మాట్లాడెను మన దేవుడే",
        "పరలోకము నుండి స్వరమున్ వినిపించెను మన దేవుడే"
      ],
      "english": [
        "Karunaapeethamu pai nundi - Maatlaadenu mana Devude",
        "Paralokamu nundi svaramun vinipinchenu mana Devude"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఆకాశము తెరువబడగా - మాట్లాడెను మన దేవుడే",
        "ఒక శబ్దముచే తన సుతుని - ఘనపరచెను మన దేవుడే"
      ],
      "english": [
        "Aakaashamu theruvabadagaa - Maatlaadenu mana Devude",
        "Oka shabdhamuche thana suthuni - Ghanaparachenu mana Devude"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మందసమున్ దేవుని ప్రజలు - మందిరమందుంచగనే",
        "మందిరమున్ క్రమ్మెను ప్రభుని - తేజోమహిమంతటను"
      ],
      "english": [
        "Mandhasamun Devuni prajalu - Mandhiramandhunchagane",
        "Mandhiramun krammenu Prabhuni - Thejomahimanthatanu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "తన ప్రజలెల్లప్పుడు క్రీస్తున్ - సేవింతురు హర్షముతో",
        "దిన దినము దేవునికొల్చి - హల్లెలూయ పాడెదరు"
      ],
      "english": [
        "Thana prajalellappudu Kreesthun - Sevinthuru harshamutho",
        "Dina dinamu Dhevunikolchi - Hallelooya paadedaru"
      ]
    }
  ]
}
