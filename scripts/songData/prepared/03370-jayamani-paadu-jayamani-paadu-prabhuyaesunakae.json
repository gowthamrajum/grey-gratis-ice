{
  "song_name": "Jayamani Paadu Jayamani Paadu Prabhuyaesunakae",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జయమని పాడు జయమని పాడు ప్రభుయేసునకే",
      "మహాదేవుండు విశ్వవిధాత రక్షకుడాయనే"
    ],
    "english": [
      "Jayamani Paadu Jayamani Paadu Prabhuyaesunakae",
      "Mahaadhaevumdu Vishvavidhaatha Rakshakudaayanae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆది అంతము అల్ఫ ఓమేగా ఆయనే ప్రభువు",
        "ఆయన యేగా రానున్నవాడు శక్తిమంతుడు"
      ],
      "english": [
        "Aadhi Amthamu Alpha Oamaegaa Aayanae Prabhuvu",
        "Aayana Yaegaa Raanunnavaadu Shakthimamthudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభు యేసునందు మమ్మును పిలచి ఏర్పరచుకొనెను",
        "ప్రేమతో మమ్ము పవిత్ర పరచి నిర్దోషులుగ తీర్చె"
      ],
      "english": [
        "Prabhu Yaesunamdhu Mammunu Pilachi Aerparachukonenu",
        "Praemathoa Mammu Pavithra Parachi Nirdhoashuluga Theerche"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసులో మమ్ము రక్తముద్వారా విమోచించితివి",
        "యెంతో కృపతో మమ్మును కడిగి మన్నించి నావుగా"
      ],
      "english": [
        "Yaesuloa Mammu Rakthamudhvaaraa Vimoachimchithivi",
        "Yemthoa Krupathoa Mammunu Kadigi Mannimchi Naavugaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసులో మాకు యేశిక్షలేదు భయము బాపెగా",
        "వాసిగా మరణబలము తొలగించి పాపము బాపెగా"
      ],
      "english": [
        "Yaesuloa Maaku Yaeshikshalaedhu Bhayamu Baapegaa",
        "Vaasigaa Maranabalamu Tholagimchi Paapamu Baapegaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "క్రీస్తులో మమ్ము నూతన పరచి తండ్రిని తెలిపెను",
        "కరుణించి మమ్ము అంగీకరించె ఎంతో అద్భుతము"
      ],
      "english": [
        "Kreesthuloa Mammu Noothana Parachi Thamdrini Thelipenu",
        "Karunimchi Mammu Amgeekarimche Emthoa Adhbhuthamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మా స్వాస్థ్యమునకు సంచకరువుగా ఆత్మ ముద్ర నిచ్చెను",
        "మనోనేత్రములు వెలిగించి మాకు గొప్ప నిరీక్షణ నచ్చె"
      ],
      "english": [
        "Maa Svaasthyamunaku Samchakaruvugaa Aathma Mudhra Nichchenu",
        "Manoanaethramulu Veligimchi Maaku Goppa Nireekshana Nachche"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ప్రభు క్రీస్తులో వాడబారని స్వాస్థ్యముగ నైతిమి",
        "పరిశుద్ధులలో మహిమైశ్వరంబు యెంతో గొప్పది"
      ],
      "english": [
        "Prabhu Kreesthuloa Vaadabaarani Svaasthyamuga Naithimi",
        "Parishudhdhulaloa Mahimaishvarambu Yemthoa Goppadhi"
      ]
    }
  ]
}
