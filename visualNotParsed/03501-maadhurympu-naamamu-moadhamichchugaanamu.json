  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మహావైద్యుండు వచ్చెను - బ్రజాళి బ్రోచు యేసు",
        "సహాయ మియ్యవచ్చెను - సంధింపరండి యేసున్",
        "మాధుర్యంపు నామము - మోదమిచ్చుగానము",
        "వేదవాక్య సారము - యేసు దివ్యయేసు"
      ],
      "english": [
        "Mahaavaidhyundu vachchenu - Brajaali brochu Yesu",
        "Sahaaya miyyavachchenu - Sandhimparandi Yesun",
        "Maadhuryampu naamamu - Modhamichchugaanamu",
        "Vedhavaakya saaramu - Yesu divya Yesu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మీపాపమెల్ల బోయెను - మేలొందు డేసు పేరన్",
        "గృపా సంపూర్ణ మొందుడి - యపార శాంతుడేసు"
      ],
      "english": [
        "Meepaapamella boyenu - Melondu desu peran",
        "Krupaa sampoorna mondudi - Yapaara shaanthudesu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వినుండి గొర్రెపిల్లను - విశ్వాసముంచి యేసున్",
        "ఘనంబుగన్ స్తుతించుడి - మనంబుప్పొంగ యేసున్"
      ],
      "english": [
        "Vinundi gorrepillanu - Vishvaasamunchi Yesun",
        "Ghanambugan sthuthinchudi - Manambuppomga Yesun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆ రమ్యమైన నామము - అణంచు నెల్ల భీతిన్",
        "శరణ్యులైనవారి నా - దరించు నెంత ప్రీతిన్"
      ],
      "english": [
        "Aa ramyamaina naamamu - Ananchu nella bheethin",
        "Sharanyulainavaari naa - Dharinchu nentha preethin"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఓ యన్నలారా - పాడుడీ యౌదార్యతన్ సర్వేశున్",
        "ఓ యమ్మలారా మ్రొక్కుడీ - ప్రియాతి ప్రియుడేసు"
      ],
      "english": [
        "O yannalaaraa - Paadudee yaudaaryathan sarveshun",
        "O yammalaaraa mrokkudee - Priyaathi priyudesu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఓ పిల్లలారా కొల్వుడీ - యౌన్నత్యరాజు నేసున్",
        "దపించువారి దాతయౌ - దయామయున్ శ్రీ యేసు"
      ],
      "english": [
        "O pillalaaraa kolvudee - Yaunnathyaraaju nesun",
        "Thapinchuvaari dhaathayau - Dhayaamayun Shree Yesu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "శ్రీయేసుకై యర్పించుడీ - మీ యావజ్జీవమును",
        "ప్రియంపు దాసులౌచుచు - రయంబు కొల్వుడేసున్"
      ],
      "english": [
        "Shreeyesukai yarpinchudee - Mee yaavajjeevamunu",
        "Priyampu dhaasulauchuchu - Rayambu kolvudesun"
      ]
    }
  ]
}
