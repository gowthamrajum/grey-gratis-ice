      ],
      "english": [
        "Dinamella Prabhukai vadhiyimpa",
        "Badi yunnatti gorrelamu",
        "Ayinanu - Preminchinavaani",
        "Premanu battiye pondithimi vijayamunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మోసము శిక్షయు దుఃఖమును",
