      "Israelu kaapari maa manchi yesayyaa",
      "aaraadhana yesu aaraadhana",
      "aaraadhana sthuthi aaraadhana",
      "aaraadhana yesu aaraadhana",
      "aaraadhana neeke aaraadhana"
    ]
  },
