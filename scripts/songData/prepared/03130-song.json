{
  "song_name": "Priyamainatti Naa Yaathma Sthoathrambu",
  "author": {
    "Authored by": "",
    "రచన": "జె నియాండెర్"
  },
  "main_stanza": {
    "telugu": [
      "ప్రియమైనట్టి నా యాత్మ స్తోత్రంబు చెల్లింపు",
      "మహిమ శక్తులుగల నా ఱేని మన్నింపు",
      "కూడుడిట వీణెల గానమున సన్నుతు లొసంగ రండి."
    ],
    "english": [
      "Priyamainatti Naa Yaathma Sthoathrambu Chellimpu",
      "Mahima Shakthulugala Naa Raeni Mannimpu",
      "Koodudita Veenela Gaanamuna Sannuthu Losamga Randi."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వము వింతగ పాలనచేయుచు నిన్ను",
        "గరుడ విహగ పక్షము లందిడి మిన్ను నొరయగా నడిపి",
        "సుఖముగా నిత్యంబు గాచిన ప్రభు నుతింపు."
      ],
      "english": [
        "Sarvamu Vimthaga Paalanachaeyuchu Ninnu",
        "Garuda Vihaga Pakshamu Lamdhidi Minnu Norayagaa Nadipi",
        "Sukhamugaa Nithyambu Gaachina Prabhu Nuthimpu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఎంతో చమత్కతిగా నా యాత్మ! నిన్ సృజించి",
        "క్షేమ మారోగ్యము నెసగగా నడిపించి",
        "కష్టములలో బొదివి ఱెక్కలతో బ్రోచిన ప్రభునుతింపు"
      ],
      "english": [
        "Emthoa Chamathkathigaa Naa Yaathma! Nin Srujimchi",
        "Kshaema Maaroagyamu Nesagagaa Nadipimchi",
        "Kashtamulaloa Bodhivi Rekkalathoa Broachina Prabhunuthimpu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అందరు గాంచెడులాగు నీ స్థితి దీవించి",
        "యాకసమందున నుండి కృపన్ గురిపించి",
        "ప్రేమతో జూచు నాతండెవ్వడో శక్తు నా ప్రభు నుతింపు"
      ],
      "english": [
        "Amdharu Gaamchedulaagu Nee Sthithi Dheevimchi",
        "Yaakasamamdhuna Numdi Krupan Guripimchi",
        "Praemathoa Joochu Naathamdevvadoa Shakthu Naa Prabhu Nuthimpu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సకలాంతః కరణంబులతోడ నుతింపు",
        "ఆయన నామ ప్రసిద్ధి గీర్తింపు",
        "వెలుంగులో నా బ్రహాం సంతతితో ప్రభునుతింపుమి ఆమేన్"
      ],
      "english": [
        "Sakalaamthah Karanambulathoda Nuthimpu",
        "Aayana Naama Prasidhdhi Geerthimpu",
        "Velumguloa Naa Brahaam Samthathithoa Prabhunuthimpumi Aamaen"
      ]
    }
  ]
}
