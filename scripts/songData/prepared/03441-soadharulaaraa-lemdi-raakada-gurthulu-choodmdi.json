    ],
    "english": [
      "Soadharulaaraa LeMdi - Raakada Gurthulu ChoodMdi",
      "Dhiviteela Noonethoa NiMpi - SidhDhapadMdi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
