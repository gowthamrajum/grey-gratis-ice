{
  "song_name": "Oohinchalenu Prabhu",
  "author": {
    "Authored by": "Joshua Shaik, Passion For Christ Ministries",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఊహించలేను ప్రభూ నీ మమతను",
      "వివరించలేను యేసు నీ ప్రేమను",
      "నువు లేక ఇలలో నేను బ్రతికేదెలా",
      "ఎనలేని నీ ప్రేమను కొలిచేదెలా"
    ],
    "english": [
      "Oohinchalenu prabhu nee mamathanu",
      "vivarinchalenu yesu nee premanu",
      "nuvu leka ilalo nenu brathikedhelaa",
      "enaleni nee premanu kolichedhelaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోక గాయాలతో నిను చూడగా",
        "లోతైన నీ ప్రేమతో కాపాడగా"
      ],
      "english": [
        "Ee loka gaayaalatho ninu choodagaa",
        "lothaina nee prematho kaapaadagaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కొరతంటు లేదే ప్రభూ నీ కరుణకు",
        "అలుపంటు రాదే సదా నీ కనులకు"
      ],
      "english": [
        "korathantu ledhe prabhu nee karunaku",
        "alupantu raadhe sadhaa nee kanulaku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రతీ దినం ప్రతీ క్షణం",
        "నీ ప్రేమ లేకపోతే నిరుపేదనూ"
      ],
      "english": [
        "prathii dhinam prathii kshanam",
        "nee prema lekapothe nirupedhanuu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాలోని ఆవేదనే నిను చేరగా",
        "నా దేవ నీ వాక్యమే ఓదార్చగా"
      ],
      "english": [
        "Naaloni aavedhane ninu cheragaa",
        "naa dheva nee vaakyame odhaarchagaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఘనమైన నీ నామమే కొనియాడనా",
        "విలువైన నీ ప్రేమనే నే పాడనా"
      ],
      "english": [
        "ghanamaina nee naamame koniyaadanaa",
        "viluvaina nee premane ne paadanaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఇదే వరం నిరంతరం",
        "నీతోనే సాగిపోనా – నా యేసయ్య"
      ],
      "english": [
        "idhey varam nirantharam",
        "neethone saagiponaa – naa yesayya"
      ]
    }
  ]
}
