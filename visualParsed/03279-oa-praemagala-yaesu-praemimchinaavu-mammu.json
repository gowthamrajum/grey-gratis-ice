    {
      "stanza_number": 3,
      "telugu": [
        "క్షమాపణానందముతో - సాగింపచేసి మమ్ము",
        "యాత్రలో మాకు తోడై - విజయము నిచ్చితివి"
      ],
      "english": [
        "Kshamaapanaanandhamutho - Saagimpachesi mammu",
        "Yaathralo maaku thodai - Vijayamu nichchithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఎడారి అడవిలోన - ఊటల నదులు నడిపి",
        "ఎండిన నేలనంత - పచ్చిక బయలు చేసెన్"
      ],
      "english": [
        "Edaari adavilona - Ootala nadulu nadipi",
        "Endina nelanantha - Pachchika bayalu chesen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "బాబెలు నుండి మమ్ము - విడిపించితివి నీవు",
        "బంధకముల తెంచి - తప్పు బోధ బాపినావు"
      ],
      "english": [
        "Baabelu nundi mammu - Vidipinchithivi neevu",
        "Bandhakamula thenchi - Thappu bodha baapinaavu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సహవాసమిచ్చి సంఘ - అంగముల జేసినావు",
        "సాక్షులను చేసి మమ్ము - శత్రువుల సిగ్గుపరచె"
      ],
      "english": [
        "Sahavaasamichchi sangha - Angamula jesinaavu",
        "Saakshulanu chesi mammu - Shathruvula sigguparache"
      ]
