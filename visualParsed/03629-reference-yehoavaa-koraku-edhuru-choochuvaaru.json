      "english": [
        "Sooryachandhra thaaralandhu - Vintha soochanalu",
        "Jaruga janulu dhairyamu chedi - Kooli choochedharu",
        "Ayithe neekai choochu memu - Balamu nondhedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సమాజముగ కూర్చి నీదు - సన్నిధియందు",
