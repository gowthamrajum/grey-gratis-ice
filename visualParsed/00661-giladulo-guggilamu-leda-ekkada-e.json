      "ఎందుకో నా జనులకు స్వస్ధత కలుగకున్నది",
      "నీ యేసు అడుగుచున్నాడు"
    ],
    "english": [
      "Gilaadhulo guggilamu ledaa",
      "Ekkadaa e vaidhyudu ledaa",
      "Enduko naa janulaku swasthatha kalugakunnadhi",
      "Nee Yesu aduguchunnaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకము గిలాదువంటిది",
