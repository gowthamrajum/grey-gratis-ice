{
  "song_name": "Kaaparivai",
  "author": {
    "Authored by": "Ameeth Evans",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కాపరివై నన్ను కాచవే",
      "నా యేసయ్యా నీవే నా ఆశ్రయం"
    ],
    "english": [
      "Kaaparivai nannu kaachave",
      "Naa Yesayya neeve naa ashrayam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాయకుడై నన్ను నడిపావే",
        "నా యేసయ్యా నీవే నా మార్గము"
      ],
      "english": [
        "Naayakudai nannu nadipave",
        "Naa Yesayya neeve Naa maarghamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గాఢాంధకార లోయలో",
        "నె సంచరించు వెలలో",
        "మార్గము నీవై నన్ను నడిపించితివే"
      ],
      "english": [
        "Gaadhandha kaara loyalo",
        "Ne sancharinchu velalo",
        "Maarghamu neevai nannu nadipinchitive"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రళయం లోనున్న వేళలో",
        "మునిగిపోతున్న వేళలో",
        "నీ ప్రేమ నాపై చూపి రక్షించితివే"
      ],
      "english": [
        "Pralayam lonunna velalo",
        "Munigipothunna velalo",
        "Nee prema naapai choopi rakshinchitive"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జీవితమే నీకంకితం నా మెస్సయ్యా"
      ],
      "english": [
        "Jeevithame nee kankitham. Naa Messiah"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీకే నీకే నా ఆరాధన",
        "నీకే నీకే నా స్తుతి ప్రార్థన"
      ],
      "english": [
        "Neeke neeke Naa aaradhana",
        "Neeke neeke Naa stuthi prardhana"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీవే నీవే నా స్తోత్రహుడా",
        "నీవే నీవే నా స్తుతి పాత్రుడా"
      ],
      "english": [
        "Neeve neeve Naa sthothrahuda",
        "Neeve neeve Naa sthuthi paathruda"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మార్గమే తెలియక మౌనినై ఉండగా",
        "గమ్యముకే నన్ను చేర్చితివే"
      ],
      "english": [
        "Marghame teliyaka mouninai undaga",
        "gamyamuke nannu cherchitive"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ఒడిపోయుండి తప్పిపోతుండగా",
        "జీవముతో నన్ను నింపితివే"
      ],
      "english": [
        "Odipoyundi tappipothundaga",
        "Jeevamutho nannu nimpithive"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "నీ వాక్యం శ్వాసగా నాలో నింపి",
        "నీ సత్యం జ్యోతిగా నన్ను నడిపి",
        "నా శూన్యం ఆశగా నువ్వు మలచి",
        "నా స్వరమే రాగముగా మార్చి"
      ],
      "english": [
        "nee vakyam swasaga naalo nimpi",
        "nee sathyam jyothiga nannu nadipi",
        "naa shoonyam aashaga nuvvu malachi",
        "naa swarame raagamu ga maarchi"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "యోగ్యతే లేని నన్ను వెంటాడి వచ్చితివే",
        "నా లోక పయనం లోనే స్థంభముగా నిలిచితివే"
      ],
      "english": [
        "yogyathe leni nannu ventaadi vacchithive",
        "Naa loka payanamu lone sthambhamuga nilichitive"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "కనీరె తుడచి",
        "ఆనందమే నింపి"
      ],
      "english": [
        "Kaneere thudachi",
        "Aanandame nimpi"
      ]
    },
    {
      "stanza_number": 12,
      "telugu": [
        "కాపరివై నన్ను కాచవే",
        "నా యేసయ్యా నీవే నా ఆశ్రయం"
      ],
      "english": [
        "Kaaparivai nannu kaachave",
        "Naa Yesayya neeve naa ashrayam"
      ]
    },
    {
      "stanza_number": 13,
      "telugu": [
        "నాయకుడై నన్ను నడిపావే",
        "నా యేసయ్యా నీకే నా వందనం"
      ],
      "english": [
        "Naayakudai nannu nadipave",
        "Naa Yesayya neeke Naa vandhanam"
      ]
    }
  ]
}
