  "main_stanza": {
    "telugu": [
      "బూరధ్వనికై యేసుని రాకకై",
      "ఎదురుచూచుచున్నాను",
      "ఎదురుచూచుచున్నాను ఎదురుచూచుచున్నాను",
      "మహిమ యేసుకే మహామహిమ నా యేసుకే",
      "నేను జీతము పొందుటకై",
      "అక్షయమైన దేహముకై",
      "దూతలతో స్తుతించుటకై",
      "ఆత్మలో పరవశమొందుటకై",
      "నా పరుగును ముగియించి",
      "క్షేమ దేశాన్ని చేరాలని",
      "సమీపించరాని తేజస్సులో",
      "యేసుతో జీవించుటకై"
    ],
