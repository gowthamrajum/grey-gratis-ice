{
  "song_name": "Kristhu Puttuka",
  "author": {
    "Authored by": "Bro. Yosepu",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తు పుట్టుకా నువ్వు పండుగా చేయటానికా",
      "యేసయ్య పుట్టుకా నువ్వు గట్టిగా త్రాగి ఊగడానికా",
      "కొట్టుకుంటు తిట్టుకుంటు అల్లరితో ఆలయాన్ని నింపడానికా",
      "అరటి పళ్ళు యాపిల్ పళ్ళు కానుకిచ్చి పాడుకొని తినడానికా",
      "ఎందుకూ పుట్టాడొ తెలుసుకో",
      "ప్రభుకిష్టమైన ఆరాధన నేర్చుకో"
    ],
    "english": [
      "Kristhu puttuka nuvvu panduga cheyattaanika",
      "Yesayya puttuka nuvvu gattiga thragi oogadanika",
      "Kottukuntu thittukuntu allaritho aalayani nimpadanika",
      "Arati pallu apple pallu kanukichchi paadukoni thinadanika",
      "Enduku puttado thelusuko",
      "Prabhuku ishtamaina aaradhana nerchuko"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సమీపించరాని తేజస్సులో నివసించు యేసయ్య మనకోసం",
        "అవనిలో అవతరించు శిశువుగా",
        "ఘనమైన ప్రేమ చూపించగా",
        "విలువైన మనులు, వెలగల మాణిక్యాలు",
        "ఇచ్చినా దొరకనీ రక్షణా",
        "ఇచ్చుటకే పుట్టినాడు తెలుసునా",
        "ఎందుకూ పుట్టాడో తెలుసుకో",
        "ప్రభుకిష్టమైన ఆరాధన నేర్చుకో",
        "షడ్రక్ మేషక్ అబేద్నగోవలే",
        "లోకానికి లొంగిపోక సాగిపో"
      ],
      "english": [
        "Sameepincharani thejassulo nivasinche Yesayya manakosam",
        "Avanilo avatharinchu shishuvuga",
        "Ghanamaina prema choopinchaga",
        "Viluvaina manulu velagala manikyaalu",
        "Ichchina dhorakani rakshana",
        "Ichutake puttinadu telusuna",
        "Enduku puttado telusuko",
        "Prabhuku ishtamaina aaradhana nerchuko",
        "Shadrak Meshak Abednago vale",
        "Lokhaniki longipoka saagipo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వధకు తెబడిన గొరియపిల్లగా",
        "సర్వశక్తుడొచ్చాడు మనకోసం",
        "తనప్రాణం బలిచేయగ సిలువలో",
        "బాలుడై పుట్టే బెత్లెహేములో",
        "విలువైన రుదిరం, యనలేని ప్రేమ ఉచితంగ పంచుటకై ఆయనా",
        "బాలునిగా పుట్టినాడు తెలుసునా",
        "ఎందుకూ పుట్టాడో తేలుసుకో",
        "ప్రభుకిష్టమైన ఆరాధన నేర్చుకో",
        "హనోకు నోవాహు పౌలులా",
        "రక్షకుని వెంబడీ నడుచుకో"
      ],
      "english": [
        "Vadhaku thebadina goriya pillagaa",
        "Sarvashakthudu ochchaadu manakosam",
        "Thana pranam balicheyaga siluvalo",
        "Baludai putte Bethlehemulo",
        "Viluvaina rudhiram enaleni prema",
        "Uchithanga panchutakai ayana",
        "Baaluniga puttinadu telusunaa",
        "Enduku puttado thelusuko",
        "Prabhuku ishtamaina aaradhana nerchuko",
        "Hanoku Novahu Paulula",
        "Rakshakuni vembadi naduchuko"
      ]
    }
  ]
}
