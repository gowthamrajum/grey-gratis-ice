{
  "song_name": "Merise Ningilo",
  "author": {
    "Authored by": "Dr. Visranth Christian",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పాడంగా దూతల్ పాడంగా",
      "ఆడంగా గొల్లలు ఆడంగా",
      "పాడంగా జ్ఞానులు పాడంగా",
      "జగమంతా సంబరమాయెనే"
    ],
    "english": [
      "Paadangaa dhoothalu paadanga",
      "aadangaa gollalu aadanga",
      "paadanga gnaanulu paadanga",
      "jagamantha sambaramaayene"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మెరిసే నింగిలో మెరిసే ఓ తార",
        "కురిసే మహిమలే కురిసే ఈవేళ",
        "ధర ఎంతో పులకించే నీ స్పర్శతో",
        "దివిలోక పరిమళమే భువి చేరగా"
      ],
      "english": [
        "Merise ningilo merise o thaara",
        "kurise mahimale kurise ee vela",
        "dhara entho pulakinche nee sparsatho",
        "dhiviloka parimalame bhuvi cheragaa"
      ]
    }
  ]
}
