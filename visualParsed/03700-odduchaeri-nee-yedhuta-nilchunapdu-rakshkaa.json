{
  "song_name": "Oddhucheri nee eduta nilchunapdu rakshakaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒడ్డుచేరి నీ యెదుట నిల్చునప్డు రక్షకా",
        "ఒక్క యాత్మనైన లేక సిగ్గుపడి పోదునా?",
        "ఒక్క యాత్మనైన నేను - రక్షించక యేసువా",
        "వట్టి చేతులతో నిన్ను - దర్శించుట తగునా?"
      ],
      "english": [
        "Oddhucheri nee eduta nilchunapdu rakshakaa",
        "Okka yaathmanaina leka siggupadi podhunaa?",
        "Okka yaathmanaina nenu - Rakshinchaka Yesuvaa",
        "Vatti chethulatho ninnu - Dharshinchuta thagunaa?"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆత్మలందు వాంఛలేక - సోమరులై కాలమున్",
        "వ్వర్థపర్చు వారన్నాట - చింతతోడ నిల్తురు"
      ],
      "english": [
        "Aathmalandhu vaanchhaleka - Somarulai kaalamun",
        "Vyarthaparchu vaarannaata - Chinthathoda nilthuru"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసువా నా స్వరక్షణ - నిశ్చయంబు ఐనదే",
        "అయిన ఫలితంబు చూడ - కష్టపడక పోతినే"
      ],
      "english": [
        "Yesuvaa naa svarakshana - Nishchayambu ainadhe",
        "Ayina phalithambu chooda - Kashtapadaka pothine"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కాలమెల్ల గడ్చిపోయెన్ - మోసపోతి నేనయ్యో",
        "గడ్చినట్టి కాలమైతే - ఏడ్చినను వచ్చునా?"
      ],
      "english": [
        "Kaalamella gadchipoyen - Mosapothi nenayyo",
        "Gadchinatti kaalamaithe - Edchinanu vachchunaa?"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "భక్తులార ధైర్యముతో - లేచి ప్రకాశించుడీ",
        "ఆత్మలెల్ల యేసునొద్ద - చేరునట్లు చేయుడీ"
      ],
      "english": [
        "Bhakthulaara dhairyamutho - Lechi prakaashinchudee",
        "Aathmalella Yesunoddha - Cherunatlu cheyudee"
      ]
    }
  ]
}
