  "main_stanza": {
    "telugu": [
      "ఓహోహో మా యన్నలారా యుద్యోగింపండి యిపుడే",
      "త్రాహి త్రాహి యనుచుఁ క్రీస్తుని దయను గోరండి"
    ],
    "english": [
      "Oahoahoa Maa Yannalaaraa Yudhyoagimpandi Yipudae",
      "Thraahi Thraahi Yanuchu Kreesthuni Dhayanu Goarandi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంత్యదినము నాటి బాధ లాలకించండి",
        "నరక ప్రాంతమునకుఁ బోకమునుపే ప్రభువును వేడండి"
      ],
      "english": [
