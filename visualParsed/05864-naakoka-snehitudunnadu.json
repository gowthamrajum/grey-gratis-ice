{
  "song_name": "Naakoka snehithudunnaadu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నాకొక స్నేహితుడున్నాడు – నేనున్నాను భయపడకన్నాడు /2/",
      "ఆయనే యేసు – నాప్రియ యేసు /2/"
    ],
    "english": [
      "Naakoka snehithudunnaadu – Nenunnaanu bhayapadakannaadu /2/",
      "Aayane Yesu – Naa priya Yesu /2/"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "​ఆపద వేళల్లో నా వెంట ఉంటాడు",
        "నాఆనందంలో పాలుపంచుకొంటాడు /2/ఆయనే/"
      ],
      "english": [
        "Aapada velallo naa venta untaadu",
        "Naa aanandhamlo paalupanchukontaadu /2/Aayane/"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నాపాపం కొరకు ఆ సిల్వ మోసాడు",
        "తన ప్రాణంనిచ్చి నాకు జీవం పోశాడు /2/ఆయనే/"
      ],
      "english": [
        "Naa paapam koraku aa silva mosaadu",
        "Thana praanamichchi naaku jeevam poshaadu /2/Aayane/"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నేనేది అడిగిన తనువెంటనే ఇస్తాడు",
        "చెదిరిపోకుండా తను కావలి కాస్తాడు /2/ఆయనే/"
      ],
      "english": [
        "Nenedhi adigina thanu ventane isthaadu",
        "Chedhiripokundaa thanu kaavali kaasthaadu /2/Aayane/"
      ]
    }
  ]
}
