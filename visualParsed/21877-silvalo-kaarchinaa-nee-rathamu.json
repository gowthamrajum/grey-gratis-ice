  "main_stanza": {
    "telugu": [
      "సిల్వలో కార్చినా నీ రక్తము కాల్వరీలో విడిచిన నీ ప్రాణము ||2 ||",
      "పాపముల నుండి విడిపించావు ||2 ||"
    ],
    "english": [
      "Silvalo kaarchinaa nee rakthamu Kaalvareelo vidichina nee praanamu ||2 ||",
      "Paapamula nundi vidipinchaavu ||2 ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రాణమును సహితము నీవు లెక్క చేయకా",
        "మా కొరకు నీ ప్రాణం పెట్టినావయ్యా ||2 ||",
        "ఎంత ప్రేమ మాపై ఎంత జాలి యేసయ్య ||2  ||సిల్వలో||"
      ],
      "english": [
        "Praanamunu sahithamu neevu lekka cheyakaa",
        "Maa koraku nee praanam pettinaavayyaa ||2 ||",
        "Entha prema maapai entha jaali Yesayya ||2  ||Silvalo||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చేతులలో మేకులను కొట్టినాను",
        "శిరస్సున ముండ్ల కిరీటం పెట్టినాను ||2 ||"
      ],
      "english": [
        "Chethulalo mekulanu kottinaanu",
        "Shirassuna mundla kireetam pettinaanu ||2 ||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భరియించావు మా పాపముల కొరకై",
        "సహియించావు మా దోసములకై ||2  ||సిల్వలో||"
      ],
      "english": [
        "Bhariyinchaavu maa paapamula korakai",
        "Sahiyinchaavu maa dhosamulakai ||2  ||Silvalo||"
      ]
    }
  ]
