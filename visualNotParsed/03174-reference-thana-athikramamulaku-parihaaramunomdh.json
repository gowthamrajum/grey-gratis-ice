  },
  "main_stanza": {
    "telugu": [
      "ఎవ్వని అతిక్రమములు మన్నింపబడెనో",
      "పాప పరిహార మెవడోందెనో వాడే ధన్యుడు"
    ],
    "english": [
      "Evvani athikramamulu manninpabadeno",
      "Paapa parihaara mevadondheno vaade dhanyudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెహోవాచే నిర్దోషిగా తీర్చబడియు",
        "ఆత్మలో కపటము లేనివాడే ధన్యుడు"
      ],
      "english": [
        "Yehovaache nirdhoshigaa theerchabadiyu",
        "Aathmalo kapatamu lenivaade dhanyudu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మౌనినై యుండిన దినమెల్ల నే జేసినట్టి",
        "ఆర్తధ్వనిచే నా యెముకలు క్షీణించెను"
      ],
      "english": [
        "Mauninai yundina dinamella ne jesinatti",
        "Aarthadhvaniche naa emukalu ksheeninchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దివారాత్రుల్ నీ చేయి నా పై బరువై యుండ",
        "నా సారము వేసవిలో ఎండినట్లాయె"
      ],
      "english": [
        "Dhivaaraathrul nee cheyi naa pai baruvai yunda",
        "Naa saaramu vesavilo endinatlaaye"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నేను నా దోషమును కప్పుకొనక",
