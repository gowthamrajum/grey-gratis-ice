{
  "song_name": "Nee Krupaye",
  "author": {
    "Authored by": "Benny Joshua",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నన్ను పిలిచిన దేవా",
      "నన్ను ముట్టిన ప్రభువా",
      "నీవు లేనిదే నేను లేనయ్యా"
    ],
    "english": [
      "Nannu pilichina devaa",
      "nannu muttina prabhuva",
      "neevu lenidhey nenu lenayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నే జీవించునది నీ కృప",
        "ఎదుగించునది నీ కృప",
        "హెచ్చించినది నీ కృప మాత్రమే"
      ],
      "english": [
        "Ne jeevinchunadhi nee krupa",
        "edhuginchunadhi nee krupa",
        "hechinchinadhi nee krupa maathramey"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ కృపయే కావలెను",
        "నీ కృపయే చాలును",
        "నీ కృప లేకుంటేనే నేనేమిలేనయ్యా",
        "యేసయ్యా"
      ],
      "english": [
        "Nee krupa ye kaavalenu",
        "nee krupa ye chaalunu",
        "nee krupalekunte ney nenemilenayya",
        "yesayya"
      ]
    }
  ]
}
