  "main_stanza": {
    "telugu": [
      "కళ్యాణమే వైబోగం కమనీయ కాంతుల దీపం",
      "శృతిలయల సుమధురగీతం దైవరచిత సుందరకావ్యం"
    ],
    "english": [
      "Kalyaaname vaibhogam kamaneeya kaanthula deepam",
      "Shruthilayala sumadhurageetham dhaivarachitha sundharakaavyam"
