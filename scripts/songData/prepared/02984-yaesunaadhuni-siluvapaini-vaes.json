{
  "song_name": "Yaesunaadhuni Siluvapaini Vaesi",
  "author": {
    "Authored by": "",
    "రచన": "జుటిక దావీదు"
  },
  "main_stanza": {
    "telugu": [
      "యేసునాధుని సిలువపైని వేసి శ్రమఁబొదించినది",
      "నా దోసమే దుస్సహ వాసమే"
    ],
    "english": [
      "Yaesunaadhuni Siluvapaini Vaesi Shramabodhinchinadhi",
      "Naa Dhoasamae Dhussaha Vaasamae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కంటక కిరీట మౌదల నంటగొట్టించినది",
        "నాచెడు తలఁపులే పాపపు పలుకులే"
      ],
      "english": [
        "Kantaka Kireeta Maudhala Nantagottinchinadhi",
        "Naachedu Thalapulae Paapapu Palukulae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మృదుకరంబుల మేకులందింపి నదితలఁప",
        "నా హస్తకృత కా ర్యంబులే దుష్క ర్మంబులే"
      ],
      "english": [
        "Mrudhukarambula Maekulandhimpi Nadhithalapa",
        "Naa Hasthakrutha Kaa Ryambulae Dhushka Rmambulae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాదయుగమున నాటిచీలలు బాధ నొందించినది",
        "నా చెడు నడకలే దోసపు పడకలే"
      ],
      "english": [
        "Paadhayugamuna Naaticheelalu Baadha Nondhinchinadhi",
        "Naa Chedu Nadakalae Dhoasapu Padakalae"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దాహముం గొనఁజేదు చిరకను ద్రావదలఁచినది",
        "మధుపానా సక్తియే యందను రక్తియే"
      ],
      "english": [
        "Dhaahamum Gonajaedhu Chirakanu Dhraavadhalachinadhi",
        "Madhupaanaa Sakthiyae Yandhanu Rakthiyae"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "హెచ్చుగ లోహిత పతనముగఁ గ్రుచ్చిన కుంతంబు",
        "నా పా పేచ్ఛలే హృదయదు రేచ్ఛలే"
      ],
      "english": [
        "Hechchuga Loahitha Pathanamuga Gruchchina Kunthambu",
        "Naa Paa Paechchalae Hrudhayadhu Raechchalae"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పావనగాత్రంబు క్షతమయ మై వెతలపాల్జేసినది",
        "నా దేహమే యఘ సం దోహమే"
      ],
      "english": [
        "Paavanagaathrambu Kshathamaya Mai Vethalapaaljaesinadhi",
        "Naa Dhaehamae Yagha Sam Dhoahamae"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దీనిఁగని నా మానసాబ్జము లోని కలుషము",
        "దూరపర్చక నడుతునా ధారుణిఁ గడుతు నా"
      ],
      "english": [
        "Dheenigani Naa Maanasaabjamu Loani Kalushamu",
        "Dhooraparchaka Naduthunaa Dhaaruni Gaduthu Naa"
      ]
    }
  ]
}
