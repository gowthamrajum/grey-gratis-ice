  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓ యేసు భక్తులారా - మీ రాజు ధ్వజము",
        "గ్రహించి సాహసించి పోరాడి గెల్వుడీ",
        "విశ్వాసులారా, రండి - మీ రక్షణార్థమై",
        "ప్రయాసపడ్డ యేసు - విజయమిచ్చును"
      ],
      "english": [
        "O Yesu bhakthulaaraa - Mee raaju dhvajamu",
        "Grahinchi saahasinchi poraadi gelvudee",
        "Vishvaasulaaraa, randi - Mee rakshanaarthamai",
        "Prayaasapadda Yesu - Vijayamichchunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మీ యందసూయబట్టి - మీ ఆత్మ నాశనము",
        "నెల్లప్పుడు గోరునట్టి యనేకులుందురు",
        "మీ రెల్ల రేసు పేరు - వచించి యాయనే",
        "సర్వాధికారి యంచు - సేవింపవలెను"
      ],
      "english": [
        "Mee yandhasooyabatti - Mee aathma naashanamu",
        "Nellappudu gorunatti yanekulundhuru",
        "Mee rella Resu peru - Vachinchi yaayane",
        "Sarvaadhikaari yanchu - Sevimpavalenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రచండమైన దండు - పోరాడ లేచినన్",
        "విరోధి శక్తికొద్ది మరీ తెగించుడీ",
        "స్వకీయ శక్తిగాక - శ్రీ యేసు నామమున్",
        "స్మరించి వానియందు - విశ్వాస ముంచుడి"
      ],
      "english": [
        "Prachandamaina dandu - Poraada lechinan",
        "Virodhi shakthikoddhi maree theginchudee",
        "Svakeeya shakthigaaka - Shree Yesu naamamun",
        "Smarinchi vaaniyandhu - Vishwaasa munchudi"
      ]
    }
  ]
}
