{
  "song_name": "Kanyaka garbhamu dharinchunanumaata pravachanamu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Vijay Prasad Reddy"
    ],
    "రచన": [
      "విజయ్ ప్రసాద్ రెడ్డి"
    ]
  },
  "main_stanza": {
    "telugu": [
      "కన్యక గర్భము ధరించుననుమాట ప్రవచనము",
      "ఓ కన్యక దానికి అంగీకరించుట సాహసము",
      "జ్ఞానులు తారలు పరిశీలించుట శాస్త్రము",
      "ఆ తార జ్ఞానులకు దారిని చూపుట అద్భుతము",
      "గొఱ్ఱెల కాపరులు పొందిన దర్శనము",
      "దేవదూతల సువార్తమానము",
      "రాజు పన్నిన కపటోపాయము",
      "పసిపిల్లల వధ జరుగుట ఘోరము",
      "తరములు యుగములు ఘనముగ",
      "పలికిన క్రీస్తు జననసుధ",
      "నిశిగల బ్రతుకుల శశికళలొసగిన",
      "రారాజు ఆత్మకథ"
    ],
    "english": [
      "Kanyaka garbhamu dharinchunanumaata pravachanamu",
      "O kanyaka daaniki angeekarinchuta saahasamu",
      "Gnaanulu thaaralu parisheelinchuta shaasthramu",
      "Aa thaara gnaanulaku daarini chooputa adbhuthamu",
      "Gorrela kaaparulu pondina darshanamu",
      "Dhevadhoothala suvaarthamaanamu",
      "Raaju pannina kapatopaayamu",
      "Pasipillala vadha jaruguta ghoramu",
      "Tharamulu yugamulu ghanamuga",
      "Palikina Kreesthu jananasudha",
      "Nishigala brathukula shashikalalosagina",
      "Raaraaju aathmakatha"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కలిగినవన్నియు ఆయన లేకుండా కలుగలేదట",
        "అయినా సత్రమున చోటు దొరుకుట సాధ్యపడలేదట",
        "ఆకాశములను పరచిన వానికి ఆయన తనయుడట",
        "పశువుల తొట్టిలో శిశువైపరుండుట ఎంత దీనమట",
        "కాలాతీతుడు కాలవశుడిగా మారిన వైనమట",
        "సత్యము గూర్చి సాక్ష్యమిచ్చుటకు పుట్టినాడట",
        "మన కొరకే శిశువు పుట్టెను అనుమాట ప్రవచనము",
        "ఆ ప్రభువే శిశువై జన్మించడం మన అదృష్టము",
        "వింత వింత ఎంత వింత క్రీస్తు శాంతిసుధ",
        "వింత వింత ఎంతో వింత యేసు కీర్తిప్రధ"
      ],
      "english": [
        "Kaliginavanniyu aayana lekundaa kalugaledhata",
        "Ayinaa sathramuna chotu dhorukuta saadhyapadaledhata",
        "Aakaashamulanu parachina vaaniki aayana thanayudata",
        "Pashuvula thottilo shishuvaiparunduta entha dheenamata",
        "Kaalaatheethudu kaalavashudigaa maarina vainamata",
        "Sathyamu goorchi saakshyamichchutaku puttinaadata",
        "Mana korake shishuvu puttenu anumaata pravachanamu",
        "Aa Prabhuve shishuvai janminchadam mana adrushtamu",
        "Vintha vintha entha vintha Kreesthu shaanthisudha",
        "Vintha vintha entho vintha Yesu keerthipradha"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అంతములేని ఆయన రాజ్యము రక్షణ శృంగమట",
        "రిక్తునిగా మారి శక్తిని విడనాడి నరునిగా పుట్టేనట",
        "సృష్టిని మొత్తం చెక్కినశిల్పి జ్ఞానపుగని ఇచ్చట",
        "వడ్లవానిగా బీదల ఇంటిలో కాలము గడిపెనట",
        "రత్నవర్ణుడు రక్తమివ్వగా దేహము పొందేనట",
        "గొఱ్ఱెపిల్లగా లోకపాపము మోసుకు పోయేనట",
        "ఇమ్మానుయేలని పేరు పెట్టుటయే ప్రవచనము",
        "ఆ దేవుడు మనకు తోడు అని దాని భావము",
        "వింత వింత ఎంత వింత క్రీస్తు శాంతిసుధ",
        "వింత వింత ఎంతో వింత యేసు కీర్తిప్రధ"
      ],
      "english": [
        "Anthamuleni aayana raajyamu rakshana shrungamata",
        "Rikthunigaa maari shakthini vidanaadi narunigaa puttenata",
        "Srushtini motham chekkinashilpi gnaanapugani ichchata",
        "Vadlavaanigaa beedhala intilo kaalamu gadipenata",
        "Rathnavarnudu rakthamivvagaa dehamu pondhenata",
        "Gorrepillagaa lokapaapamu mosuku poyenata",
        "Immaanuyelani peru pettutaye pravachanamu",
        "Aa Devudu manaku thodu ani daani bhaavamu",
        "Vintha vintha entha vintha Kreesthu shaanthisudha",
        "Vintha vintha entho vintha Yesu keerthipradha"
      ]
    }
  ]
}
