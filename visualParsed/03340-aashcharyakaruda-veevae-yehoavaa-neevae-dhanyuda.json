{
  "song_name": "Aashcharyakaruda veeve - Yehova neeve dhanyudavu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆశ్చర్యకరుడ వీవే - యెహోవా నీవే ధన్యుడవు"
    ],
    "english": [
      "Aashcharyakaruda veeve - Yehova neeve dhanyudavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కృప నింగినంటెను",
        "వచ్చినవారే దయ పొందెదరు - నీవే దయాళుడవు"
      ],
      "english": [
        "Nee krupa ninginantenu",
        "Vachchinavaare daya pondedaru - Neeve dhayaaludavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ విశ్వాస్యత గొప్పది",
        "ఉన్నతమైనది అందరి యెడల - ఎన్నడు మారనిది"
      ],
      "english": [
        "Nee vishwaasyatha goppadi",
        "Unnathamainadi andari edala - Ennadu maaranidi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ నీతి స్థిరమైనది",
        "పరిశీలించెదవు యెల్ల ప్రజలను - సరిదిద్దువాడ వీవే"
      ],
      "english": [
        "Nee neethi sthiramainadhi",
        "Parisheelinchedhavu ella prajalanu - Saridhidhdhuvaada veeve"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అమూల్యము నీ కరుణ",
        "వచ్చినవారికి ఆశ్రయమిచ్చి - రెక్కలతో కప్పెదవు"
      ],
      "english": [
        "Amoolyamu nee karuna",
        "Vachchinavaariki aashrayamichchi - Rekkalatho kappedhavu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ యింట తృప్తిగలదు",
        "ఆనంద జలములను త్రాగనిచ్చెదవు - నీ ప్రజలందరికి"
      ],
      "english": [
        "Nee intha thrupthigaladhu",
        "Aananda jalamulanu thraaganichchedhavu - Nee prajalandhariki"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీ ప్రకాశము నిలుచు",
        "నిన్నెరిగియున్న వారిపై నిరతం - మెండైన కృపనిత్తువు"
      ],
      "english": [
        "Nee prakaashamu niluchu",
        "Ninnerigiyunna vaaripai niratham - Mendaina krupanitthuvu"
      ]
    }
  ]
}
