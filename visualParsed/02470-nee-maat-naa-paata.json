        "స్థిరమైన ఉజ్జీవము - లోలోన రగిలించనీ  ||నీ||"
      ],
      "english": [
        "E chota galameththinaa - Nee prema dhwaniyinchanee",
        "Paadeti prathi paatalo - Nee roopu kanipinchanee = 2",
        "Vinipinchuchunnappude - Udrekamunu repaka",
        "Sthiramaina ujjeevamu - Lolona ragilinchanee  ||Nee||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దివ్య గానామృతం - జలధారలుగా పొంగనీ",
        "తాకేటి ప్రతి వారినీ - ఫలవంతముగా మార్చనీ = 2",
        "శృతిలయలు లోపించక - విసిగింపు కలిగించక",
        "నిజమైన ఉల్లాసమై - నిలువెల్లా కదిలించనీ  ||నీ||"
      ],
      "english": [
        "Nee divya gaanaamrutham - Jaladhaaralugaa ponganee",
        "Thaaketi prathi vaarinee - Phalavanthamugaa maarchanee = 2",
        "Shruthilayalu lopinchaka - Visigimpu kaliginchaka",
        "Nijamaina ullaasamai - Niluvellaa kadhilinchanee  ||Nee||"
      ]
