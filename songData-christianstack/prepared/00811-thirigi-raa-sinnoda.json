{
  "song_name": "Thirigi Raa Sinnoda",
  "author": {
    "Authored by": "C Y Joshua",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తండ్రి నే విడచి ఇంటినే మరచి",
      "ఆస్తి లో వాటాని అడిగావే నాయని",
      "ఒంటరివై మిగిలిపోయావా",
      "బంధాన్ని తెంచుకున్నావా",
      "సిన్నోడా ఊరుమీలేక నువ్వు నలిగావా",
      "సిన్నోడా మాట ఒగ్గేసి దూరాన పోయావా",
      "తోడు లేక నీడ లేక చావలేక బ్రతుకుతున్నావా"
    ],
    "english": [
      "Thandrine vidachi intine marachi",
      "aasthilo vaataani adigaave naayani",
      "ontarivai migilipoyaavaa",
      "bhandhaanni thenchukunnaavaa",
      "sinnodaa oorumileka nuvvu naligaava",
      "sinnodaa maata oggesi dhooraana poyaava",
      "thodu leka needa leka chaavaleka brathukuthunnavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఉన్నోడు లేనోడు అయినోడు కానోడు",
        "నీ చెంత చేరి జల్సాలు చేసే",
        "లోకంలో మోసపోయావా",
        "తోడు లేక తల్లడిల్లావా",
        "సిన్నోడా శిమ్మ సీకట్లో ఎన్ని ఇక్కట్లు రా",
        "సిన్నోడా తాళలేవురా ఆలస్యమెందుకు రా",
        "నీ కోసం వేచి ఉన్న నీ తండ్రి దరికి నీవు చేరరా"
      ],
      "english": [
        "Unnodu lenodu ayinodu kaanodu",
        "nee chentha cheri jalsaalu chese",
        "lokamlo mosapoyaava",
        "thodu leka thalladillaava",
        "sinnoda simma seekatlo enni ikkattlu raa",
        "sinnoda thaalalevura aalasyamendhuku raa",
        "neekosam vechi unna nee thandri dhariki neevu cheraraa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "విలువైన బంధం కరువైన వేళ",
        "బరువైన గుండె బద్దలయ్యిందే",
        "ఆకాశం మబ్బులు కమ్మినా",
        "కన్నీరే గుండెలు నిండెనే",
        "సిన్నోడా ఆ ప్రేమ పొంద ఇంటికి తిరిగిరా",
        "సిన్నోడా కరము(చేతులు) చాచి నిన్ను పిలిచెరా",
        "కరుణించి ప్రాణమిచ్చి కృప చూపే యేసుని చేరరా"
      ],
      "english": [
        "Viluvaina bandham karuvaina vela",
        "baruvaina gunde baddalayyinde",
        "aakasam mabbulu kamminaa",
        "kanneere gundelu nindene",
        "sinnodaa aa prema ponda intiki thirigiraa",
        "sinnoda karamu chaachi ninnu pilicheraa",
        "karuninchi praanamichi krupa choope yesuni cheraraa"
      ]
    }
  ]
}
