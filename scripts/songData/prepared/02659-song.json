{
  "song_name": "Silva Chentha Naesuvaa Chaerchi Nannu Nunchu",
  "author": {
    "Authored by": "",
    "రచన": "ఫ్రాన్సెస్ జేన్వేన్ ఆల్స్టీన్"
  },
  "main_stanza": {
    "telugu": [
      "సిల్వకే సిల్వకే చెల్లునా విముక్తి",
      "చెల్వ మొప్ప నద్దరిన్ జేర నాకు ముక్తి"
    ],
    "english": [
      "Silvakae Silvakae Chellunaa Vimukthi",
      "Chelva Moppa Naddharin Jaera Naaku Mukthi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సిల్వ చెంత నేసువా చేర్చి నన్ను నుంచు",
        "కల్వరిన్ స్రవించెడు కల్వలో నన్నుంచు."
      ],
      "english": [
        "Silva Chentha Naesuvaa Chaerchi Nannu Nunchu",
        "Kalvarin Sravinchedu Kalvaloa Nannunchu."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కంపితాత్ము నంధునై కానలేక యుండ",
        "సొంపు మీరఁ బ్రోచితి సూర్యతేజ స్కుండ"
      ],
      "english": [
        "Kampithaathmu Nandhunai Kaanalaeka Yunda",
        "Sompu Meera Broachithi Sooryathaeja Skunda"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవ గొఱ్ఱె పిల్ల ఈన దీప్తి నాకుఁ జూపు",
        "నీ వధా ప్రభావముల్ పావనుండ నేర్పు."
      ],
      "english": [
        "Dhaeva Gorre Pilla Eena Dheepthi Naaku Joopu",
        "Nee Vadhaa Prabhaavamul Paavanunda Naerpu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నే నిరీక్షణంబుతో నెప్డు వేచి యుందున్",
        "భూ నితాంత వారధిన్ బూని యీది మందున్"
      ],
      "english": [
        "Nae Nireekshanambuthoa Nepdu Vaechi Yundhun",
        "Bhoo Nithaantha Vaaradhin Booni Yeedhi Mandhun"
      ]
    }
  ]
}
