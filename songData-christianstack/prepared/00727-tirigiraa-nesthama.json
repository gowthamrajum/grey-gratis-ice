{
  "song_name": "Tirigiraa Nesthama",
  "author": {
    "Authored by": "Dr. John Wesly",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తిరిగి రా నేస్తమా తిరిగి రా నేస్తమా",
      "ఎన్నాలిలా మోసపోదువు",
      "తిరిగి రా నేస్తమా తిరిగి రా నేస్తమా",
      "ఎన్నాలిలా గాయపడుదువు"
    ],
    "english": [
      "Thirigi raa nesthamaa thirigiraa nesthamaa",
      "ennaalilaa mosapodhuvu",
      "thirigi raa nesthamaa thirigiraa nesthamaa",
      "ennaalilaa gaayapadudhuvu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కడదాకా నీ తోడు మేమని",
        "మేము గాక మరి ఎవ్వరు లేరని",
        "నిన్ను వంచించిన వ్యక్తులున్నను",
        "నిన్ను విస్మరించిన మనుషులున్నను",
        "మరణమైన జీవమైన",
        "నిన్ను నేను విడువనన్న యేసు ప్రేమను",
        "గుర్తించు… గుర్తించు… గుర్తించు",
        "ఎన్నో కలలు నీపైన ఉండగా",
        "ఎన్నో ఆశయాలు ఎదురుచూస్తుండగా",
        "క్షణికమైన సుఖము కోసం",
        "లోకమందు తిరిగి తిరిగి",
        "అలసియున్న నీవు తిరిగిరా తిరిగిరా మరలిరా",
        "తొలగనిచ్చిన యేసు నొద్దకు",
        "సేదదీర్చెడి ప్రభువు నొద్దకు",
        "తిరిగిరా… తిరిగిరా…తిరిగిరా"
      ],
      "english": [
        "Kadadhaakaa nee thodu memani",
        "memu gaaka mari evvaru lerani",
        "ninnu vanchinchina vakthulunnanu",
        "ninnu vismarinchina manushulunnanu",
        "maranamaina jeevamaina",
        "ninnu nenu viduvananna yesu premanu",
        "gurthinchu… gurthinchu… gurthinchu",
        "Enno kalalu neepaina undagaa",
        "enno aasayaalu edhuruchoosthundagaa",
        "kshanikamaina sukhamu kosam",
        "lokamandhu thirigi thirigi",
        "alasiyunna neevu thirigiraa thirigiraa maraliraa",
        "tholaganichina yesu noddhaku",
        "sedhadheerchedi prabhuvu noddhaku",
        "thirigiraa… thirigiraa… thirigiraa"
      ]
    }
  ]
}
