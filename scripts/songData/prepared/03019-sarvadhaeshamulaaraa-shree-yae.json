{
  "song_name": "Sarvadhaeshamulaaraa Shree Yaesae Dhaevundu",
  "author": {
    "Authored by": "",
    "రచన": "నరెళ్ల నమూయేలు సుబ్బయ్య"
  },
  "main_stanza": {
    "telugu": [
      "సర్వదేశములారా శ్రీ యేసే దేవుండు",
      "ఉర్వి నుత్సాహముతో గురుస్తోత్రము జేయను రండి"
    ],
    "english": [
      "Sarvadhaeshamulaaraa Shree Yaesae Dhaevundu",
      "Urvi Nuthsaahamuthoa Gurusthoathramu Jaeyanu Randi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆ ప్రభువే దేవుండు అధికస్తోత్రార్హుండు",
        "భూప్రజలు నందరిని బుట్టించిన భగవంతుండు"
      ],
      "english": [
        "Aa Prabhuvae Dhaevundu Adhikasthoathraarhundu",
        "Bhooprajalu Nandharini Buttinchina Bhagavanthundu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మనము దేవుని వార మును మరి యాయన ప్రజల",
        "మనయము నా ఘనప్రభువు నెనరుతో మేపెడి గొఱ్ఱెలము"
      ],
      "english": [
        "Manamu Dhaevuni Vaara Munu Mari Yaayana Prajala",
        "Manayamu Naa Ghanaprabhuvu Nenaruthoa Maepedi Gorrelamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కృతజ్ఞతార్పణలు కొల్లగను జెల్లింప",
        "నాతని యావరణములో నతి వినయముతోఁజేరండి"
      ],
      "english": [
        "Kruthajnathaarpanalu Kollaganu Jellimpa",
        "Naathani Yaavaranamuloa Nathi Vinayamuthoa Jaerandi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆయన దయామయుఁడు ఆయన కృపామయుఁడు",
        "ఆయన ప్రేమ సత్యం బనవరతం బుండును నిజమే"
      ],
      "english": [
        "Aayana Dhayaamayudu Aayana Krupaamayudu",
        "Aayana Praema Sathyam Banavaratham Bundunu Nijamae"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శుభనామం మదినుంచి ప్రభునామం స్తుతియించి",
        "ఘననామం బతిభక్తిన్ అనయము గొలువుడి జనులారా"
      ],
      "english": [
        "Shubhanaamam Madhinunchi Prabhunaamam Sthuthiyinchi",
        "Ghananaamam Bathibhakthin Anayamu Goluvudi Janulaaraa"
      ]
    }
  ]
}
