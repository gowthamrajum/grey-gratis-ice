{
  "song_name": "Yesu raajun nee edalo vasiyimpa neeyavaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు రాజున్ నీ యెదలో - వసియింప నీయవా?",
        "నీదు భారమును మోసెన్ - నేడంగీకరింపవా?",
        "యేసు మహారాజు ఇదిగో - వాకిట నిల్చియుండగా",
        "పాపీ! యేసు ప్రేమనెంచి - తలుపును తీయుము"
      ],
      "english": [
        "Yesu raajun nee edalo - Vasiyimpa neeyavaa?",
        "Needu bhaaramunu mosen - Nedangeekarimpavaa?",
        "Yesu mahaaraaju idigo - Vaakita nilchiyundagaa",
        "Paapee! Yesu premanenchi - Thalupunu theeyumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోక ఆశా పాశముల - చేత నిండియున్నావా?",
        "నీకై సిల్వన్ ప్రాణమిడిన - యేసుకు చోటులేదా?"
      ],
      "english": [
        "Loka aashaa paashamula - Chetha nindiyunnaavaa?",
        "Neekai silvan praanamidina - Yesuku chotuledhaa?"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇంక తామసించినచో - వెనుక మోసమగును",
        "ఇపుడే రక్షణ దినము - వెనుక రక్షనబ్బదు"
      ],
      "english": [
        "Inka thaamasinchinacho - Venuka mosamagunu",
        "Ipude rakshana dinamu - Venuka rakshanabbadhu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పిల్చినిల్చు రక్షకునికి - తలుపును తీయుము",
        "నీదు జీవబలముల - నేడే సమర్పింపుము"
      ],
      "english": [
        "Pilchinilchu rakshakuniki - Thalupunu theeyumu",
        "Needu jeevabalamula - Nede samarpimpumu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రేపు యని తామసింప - నష్టము సల్గు సదా",
        "మంచి సమయము వృధా - యగున్ కష్టపడెదవు"
      ],
      "english": [
        "Repu ani thaamasimpa - Nashtamu salgu sadaa",
        "Manchi samayamu vrudhaa - Yagun kashtapadedhavu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యోహాను మూడు పదహా-రును విశ్వసింపుము",
        "దప్పిగొన్న వారిన్ పిల్చున్ - రూక కాసు లేకయే"
      ],
      "english": [
        "Yohaanu moodu padhahaa-runu vishwasimpumu",
        "Dhappigonna vaarin pilchun - Rooka kaasu lekaye"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాడుటకై - వల్లభుని యొద్దకురా",
        "త్రోసివేయడెన్నడును - మంచి యేసునాథుడు"
      ],
      "english": [
        "Hallelooya paadutakai - Vallabhuni yodhdhakuraa",
        "Throsiveyadennadunu - Manchi Yesunaathudu"
      ]
    }
  ]
}
