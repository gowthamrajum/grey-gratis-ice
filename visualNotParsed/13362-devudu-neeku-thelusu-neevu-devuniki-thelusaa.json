    "english": [
      "Devudu neeku thelusu – Neevu devuniki thelusaa",
      "Neevu devuni namminaa – Ninnu devudu nammaali (2)",
      "Avasaraalaku devuni nammaka",
      "Aathmaku thandhrani nammaali (2)",
      "Nee aathmaku thandhrani nammaali ||Devudu||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాలుగు గోడల మధ్య నీవు నలిగిపోక",
