{
  "song_name": "Pashushalalo Neevu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పశుశాలలో నీవు పవళించినావు",
      "పరమాత్ముడవు నీవు పసిబాలుడవు కావు"
    ],
    "english": [
      "Pashushaalalo Neevu Pavalinchinaavu",
      "Paramaathmudavu Neevu Pasibaaludavu Kaavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్థాపించలేదే తరగతులు ప్రతి చోట చూడ నీ పలుకే",
        "ధరియించలేదే ఆయుధం వశమాయే జనుల హృదయాలు"
      ],
      "english": [
        "Sthaapinchalede Tharagathulu Prathi Chota Chooda Nee Paluke",
        "Dhariyinchalede Aayudham Vashamaaye Janula Hrudayaalu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "చిరు ప్రాయమందే శాస్త్రులు సరితూగలేదే పాదములు",
        "స్థలమైన లేదే జన్మకు తలవంచే సర్వ లోకము"
      ],
      "english": [
        "Chiru Praayamande Shaasthrulu Sarithoogalede Paadamulu",
        "Sthalamaina Lede Janmaku Thalavanche Sarva Lokamu"
      ]
    }
  ]
}
