  "main_stanza": {
    "telugu": [
      "పరలోకమును చూడాలిరో,",
      "పసుల పాకలో ప్రసవించేనురో",
      "ప్రభుయేసును చూడాలిరో",
      "పసుల తొట్టెలో పవళించేనురో",
      "ఎంత అద్భుతమో దేవుడే",
      "దీనుడై దిగి వచ్చేనురో"
    ],
    "english": [
      "Paralokamunu choodaaliro,",
      "Pasula paakalo prasavinchenuro",
      "Prabhu Yesunu choodaaliro",
      "Pasula tottelo pavalinchenuro",
      "Entha adbhuthamo Devude",
      "Deenudai digi vachchenuro"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కాలము పరిపూర్ణమాయేనురో",
        "దేవుడు తన కుమారుని పంపేనురో",
        "పాపము పరిపక్వమాయేనురో",
        "పాపముకు ప్రాయశ్ఛిత్తము చేసేనురో",
        "మనిషికి రక్షణను తెచ్చేనురో",
        "లోక రక్షకుడై నిలిచేనురో"
      ],
      "english": [
        "Kaalamu paripoornamaayenuro",
        "Devudu thana kumaaruni pampenuro",
        "Paapamu paripakvamaayenuro",
        "Paapamuku praayashchiththamu chesenuro",
        "Manishiki rakshananu thechchenuro",
        "Loka rakshakudai nilichenuro"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దీనులను పైకి లేవనెత్తేనురో",
        "ప్రజల పెద్దలతో కూర్చోబెట్టేనురో",
        "దైవ మానవ, సమ సమాజములో",
        "దేవుని రాజ్యము స్థాపించేరో",
        "పేదలు ప్రభువులు కలవాలిరో",
        "క్రిస్మస్ పండుగ చేయాలిరో"
      ],
      "english": [
        "Deenulanu paiki levanetthenuro",
        "Prajala peddalatho koorchobettenuro",
        "Daiva maanava, sama samaajamulo",
        "Devuni raajyamu sthaapinchero",
        "Pedhalu prabhuvulu kalavaaliro",
        "Krismas panduga cheyaaliro"
      ]
    }
  ]
