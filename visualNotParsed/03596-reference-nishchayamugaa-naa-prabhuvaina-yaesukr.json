  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పూర్వమాశీర్వాదము - నేడు శ్రీయేసే",
        "మున్ను నా యాలోచన - నేడు తనమాట",
        "మున్ను వరము కోరితి - నే డేసగు వానిన్",
        "మున్ను స్వస్థత కోరితి - నేడు వానినే",
        "సర్వములో సర్వదా - యేసునే పాడెద",
        "యేసులో సమస్తము - సమస్తము యేసే"
      ],
      "english": [
        "Poorvamaasheervaadhamu - Nedu Shreeyese",
        "Munnu naa yaalochana - Nedu thanamaata",
        "Munnu varamu korithi - Ne desagu vaanin",
        "Munnu swasthatha korithi - Nedu vaanine",
        "Sarvamulo sarvadaa - Yesune paadeda",
        "Yesulo samasthamu - Samasthamu Yese"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మున్ను శోధన శ్రమ - నేడు నమ్మకం",
        "ముందు అర్థరక్షణ - నేడు సంపూర్ణం",
        "మున్ను విడువనిపట్టు - నేడేసు నన్ బట్టెన్",
        "పూర్వము నే నస్థిరం - నేడు - స్థిరమైతి"
      ],
      "english": [
        "Munnu shodhana shrama - Nedu nammakam",
        "Mundu artharakshana - Nedu sampoornam",
        "Munnu viduvanipattu - Nedesu nan batten",
        "Poorvamu ne nasthiram - Nedu - Sthiramaithi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మున్నునా ప్రయత్నము - నేడు ప్రార్థన",
        "పూర్వమెంతో జాగ్రత్త - నేడతని శ్రద్ధ",
        "మున్ను నాదుకోరిక - నేడేసుమాట",
        "పూర్వ మడుగుచుండుట - నేడు సంస్తుతి"
      ],
      "english": [
        "Munnunaa prayathnamu - Nedu praarthana",
        "Poorvamentho jaagraththa - Nedathani shraddha",
        "Munnu naadhukorika - Nedesumaata",
        "Poorva maduguchunduta - Nedu samsthuthi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మున్ను నాపనియది - యికను తన పని",
        "మున్ను తనను వాడితిన్ - నేడు నన్ వాడును",
        "మున్ను శక్తి కోరితిన్ - నేడు శక్తునే",
        "మున్ను నాకై చేసితిన్ - నేడు తనకే"
      ],
      "english": [
        "Munnu naapaniyadhi - Ikanu thana pani",
        "Munnu thananu vaadithin - Nedu nan vaadunu",
        "Munnu shakthi korithin - Nedu shakthune",
        "Munnu naakai chesithin - Nedu thanake"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మున్ను యేసును కోరితిన్ - నా వాడాయె నేడు",
        "మున్ను జ్యోతులుగ నుండే - నే డేంతో కాంతి",
        "మున్ను చావు గోరితి - నేడు తన రాకన్",
        "నా నిరీక్షణలెల్ల – స్థిరమాయెను"
      ],
      "english": [
        "Munnu Yesunu korithin - Naa vaadaaye nedu",
        "Munnu jyothuluga nunde - Ne dentho kaanthi",
        "Munnu chaavu gorithi - Nedu thana raakan",
        "Naa nireekshanalella – Sthiramaayenu"
      ]
    }
  ]
}
