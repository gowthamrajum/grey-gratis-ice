        "Ne viduvanantoo naa Yesu pilichaade",
        "Aaraadhanaa aaraadhanaa",
        "Aaraadhanaa naa Yesuke",
        "Adugulu naavi thadabadinanu",
        "Velle daari naaku theliyakapoyinanu",
        "Daari choopi nadipisthunnaadu",
        "Paadutaye naa pani annaadu",
        "Aaraadhanaa aaraadhanaa",
        "Aaraadhanaa naa Yesuke"
      ]
    }
  ]
