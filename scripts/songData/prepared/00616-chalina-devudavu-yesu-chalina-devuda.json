{
  "song_name": "Chalina Devudavu Yesu Chalina Devuda",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "చాలిన దేవుడవు యేసు చాలిన దేవుడ నీవు",
      "వ్యాధి బాధ సమయములో కష్టసుడుల తరంగములో",
      "ఏమున్నా లేకున్నా ఏ స్ధితికైనా చాలిన దేవుడ నీవే"
    ],
    "english": [
      "Chalina Devudavu Yesu Chalina Devuda Nivu",
      "Vyadhi Badha Samayamulo Kashtasudula Taramgamulo",
      "Emunna Lekunna E Sdhitikaina Chalina Devuda Nive"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంజూర చెట్లు పూయకున్నను ద్రాక్ష చెట్లు ఫలింపకున్నను",
        "చేనులోని పైరు పండకపోయినను శాలలోని పశువులు లేక పోయినను"
      ],
      "english": [
        "Amjura Chetlu Puyakunnanu Draksha Chetlu Palimpakunnanu",
        "Chenuloni Pairu Pamdakapoyinanu Salaloni Pasuvulu Leka Poyinanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గాఢాంధకారాన పయనించిన పొంగు సాగరా లెదురైన",
        "లోకమంత ఒకటైన అన్యాయ తీర్పుకు గురిచేసిన",
        "సత్యము పలుకుటచే నష్టము కలిగినను"
      ],
      "english": [
        "Gadhamdhakarana Payanimchina Pomgu Sagara Leduraina",
        "Lokamamta Okataina Anyaya Tirpuku Gurichesina",
        "Satyamu Palukutache Nashtamu Kaliginanu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దారిచెడినపుడు యేసయ్య అందరు విడచిన యేసయ్యా",
        "శాశ్వతమైన ప్రేమతో కన్నీళ్ళు తుడిచితివే",
        "ననునీచుడని త్రోయక నీ కౌగిట దాచితివే"
      ],
      "english": [
        "Darichedinapudu Yesayya Amdaru Vidachina Yesayya",
        "Sasvatamaina Premato Kannillu Tudichitive",
        "Nanunichudani Troyaka Ni Kaugita Dachitive"
      ]
    }
  ]
}
