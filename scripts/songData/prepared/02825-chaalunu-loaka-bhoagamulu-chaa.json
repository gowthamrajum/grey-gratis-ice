{
  "song_name": "Chaalunu Loaka Bhoagamulu Chaalunu",
  "author": {
    "Authored by": "",
    "రచన": "బేతాళ జాన్"
  },
  "main_stanza": {
    "telugu": [
      "చాలును లోక భోగములు చాలును",
      "చాలును మీనమును బట్టు గాలమైయున్న భోగములు"
    ],
    "english": [
      "Chaalunu Loaka Bhoagamulu Chaalunu",
      "Chaalunu Meenamunu Battu Gaalamaiyunna Bhoagamulu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఎండమావులే నీరనుచు మెండుగఁ బరుగిడు జింక కుప",
        "మండనై బలహీను నైతిఁ"
      ],
      "english": [
        "Endamaavulae Neeranuchu Menduga Barugidu Jinka Kupa",
        "Mandanai Balaheenu Naithi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బూరుగ పండారగింపఁ గోరి కాచికొని యున్నట్టి",
        "కీరసామ్య మైతి నయ్యో"
      ],
      "english": [
        "Booruga Pandaaragimpa Goari Kaachikoni Yunnatti",
        "Keerasaamya Maithi Nayyoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దీపపు దీప్తి నాశించి యూపిరి విడు పురుగు రీతిఁ",
        "బాపపు భ్రమచే నట్లయితిఁ"
      ],
      "english": [
        "Dheepapu Dheepthi Naashinchi Yoopiri Vidu Purugu Reethi",
        "Baapapu Bhramachae Natlayithi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పూలతో ఁటయందుఁ బెరుగు బూరుగ వృక్షంబునై నే",
        "మేలునకు మూలముగాన నైతిఁ"
      ],
      "english": [
        "Poolathoantayandhu Berugu Booruga Vrukshambunai Nae",
        "Maelunaku Moolamugaana Naithi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "చల్లిన వితనము ల్జంపు చౌట భూమి వలె నేఁ గాఁగ",
        "సత్యము నిష్ఫలమయ్యొ నకట"
      ],
      "english": [
        "Challina Vithanamul Jampu Chauta Bhoomi Vale Nae Gaaga",
        "Sathyamu Nishphalamayyo Nakata"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మాయ సంత నైతి యేసు నాయక నన్విడక",
        "మార్పు జేయుమి నెన రుంచి నాపైఁ"
      ],
      "english": [
        "Maaya Santha Naithi Yaesu Naayaka Nanvidaka",
        "Maarpu Jaeyumi Nenarunchi Naapai"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "తొల్లి నన్ రప్పించినట్టి చల్లని సువార్త తేజ",
        "ముల్లమందు నుండఁ జేయ"
      ],
      "english": [
        "Tholli Nan Rappinchinatti Challani Suvaartha Thaeja",
        "Mullamandhu Nunda Jaeya"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "మంచు పోల్కె ననుఁ జేయుటకై ముంచుమీ నీ రక్తాంబుధిలోఁ",
        "బెంచుమి నీ వాక్సారము చేఁ"
      ],
      "english": [
        "Manchu Poalke Nanu Jaeyutakai Munchumee Nee Rakthaambudhiloa",
        "Benchumi Nee Vaaksaaramu Chae"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "చెడ్డ బిడ్డ నయ్య నేను దొడ్డ రక్షకుండ వీవు",
        "అడ్డులేక నన్నుఁ బ్రోవు"
      ],
      "english": [
        "Chedda Bidda Nayya Naenu Dhodda Rakshakunda Veevu",
        "Addulaeka Nannu Broavu"
      ]
    }
  ]
}
