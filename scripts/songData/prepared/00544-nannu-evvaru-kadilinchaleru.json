{
  "song_name": "Nannu Evvaru Kadilinchaleru",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నన్ను ఎవ్వరు కదిలించలేరు దేనికి ఆ శక్తి లేదు",
      "నా దర్శనము చెదరి పోదులే",
      "వెన్నంటి యున్న సహవాసమును బట్టి"
    ],
    "english": [
      "Nannu Evvaru Kadilinchaleru Deniki Aa Shakthi Ledu",
      "Naa Darshanamu Chedari Podule",
      "Vennanti Yunna Sahavaasamunu Batti"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా దేవుడు తన జేనతో ఆకాశము కొలువగలడు",
        "నన్ను సర్వోన్నతమైన సంకల్పములో స్థిరపరచినాడు"
      ],
      "english": [
        "Naa Devudu Thana Jenatho Aakaashamu Koluvagaladu",
        "Nannu Sarvonnathamaina Sankalpamulo Sthiraparachinaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా దేవుడు సింహముల నోళ్లను మూయించినాడు",
        "నన్ను నిర్దోషిగా రాజుల ఎదుట నిలబెట్టినాడు"
      ],
      "english": [
        "Naa Devudu Simhamula Nollanu Mooyinchinaadu",
        "Nannu Nirdoshigaa Raajula Eduta Nilabettinaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా దేవుడు లేని వాటిని ఉన్నట్లుగానే పిలుచువాడు",
        "నా జీవితములో ఏదైనను చేయగలడు"
      ],
      "english": [
        "Naa Devudu Leni Vaatini Unnatlugaane Piluchuvaadu",
        "Naa Jeevithamulo Edainanu Cheyagaladu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా దేవుడు ఉన్న వాటిని లేనట్లుగానే చేయగలడు",
        "నన్ను ఆ విశ్వాసమే నడిపించెను"
      ],
      "english": [
        "Naa Devudu Unna Vaatini Lenatlugaane Cheyagaladu",
        "Nannu Aa Vishwaasame Nadipinchenu"
      ]
    }
  ]
}
