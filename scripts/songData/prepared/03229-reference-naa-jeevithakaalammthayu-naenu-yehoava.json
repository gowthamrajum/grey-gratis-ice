    {
      "stanza_number": 11,
      "telugu": [
        "సీయోను నీ దేవుడు - తరతరములు రాజ్య మేలును",
        "యెహోవాను స్తుతించుడి - హల్లెలూయా ఆమెన్"
      ],
      "english": [
        "Seeyoanu Nee Dhaevudu - Tharatharamulu Raajya Maelunu",
