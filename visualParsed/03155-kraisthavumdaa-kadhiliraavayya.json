      "english": [
        "Sathyavaakyamu santhalodhulipi bodhakulu dhorala",
        "Bhathyamulapai bhraanthulu nilipi chithramagu anukoola",
        "Bodhalu chesi prajalanu mosaginchu soothradhaarula",
        "Chera raadhayyaa sukhabhogamidichi sathyavaakyamu",
        "Chaata raavayyaa ||Kraisthavundaa||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శక్తిహీనుడనందు వేమయ్యా సౌజన్యమగు శుద్ధాత్మశక్తిని",
        "పొందుకొనుమయ్యా భక్తిహీనత పారద్రోలు భ్రష్ట",
        "మనస్సు బయలుపరచు శక్తికలుగు సువార్త చాటుదువు",
        "సువార్త చేయ జయమొంది ఆత్మలను రక్షించెదవు  ||క్రైస్తవుండా||"
      ],
      "english": [
