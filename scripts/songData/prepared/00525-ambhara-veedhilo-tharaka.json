{
  "song_name": "Ambara Veedhilo Thaaraka",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అంబరవీధిలో తారక - వెలసెను తూర్పున వింతగా",
      "యూదుల రాజుని పుట్టుక - లోకానికి ప్రకటించగా"
    ],
    "english": [
      "Ambaraveedhilo Thaaraka - Velasenu Thoorpuna Vinthagaa",
      "Yoodula Raajuni Puttuka - Lokaaniki Prakatinchagaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జ్ఞానులు తారను గమనించి - బెత్లెహేమునకు పయనించి",
        "శిశువును గని సంతోషించి - మ్రొక్కిరి కానుకలర్పించి"
      ],
      "english": [
        "Gnaanulu Thaaranu Gamaninchi - Bethlehemunaku Payaninchi",
        "Shishuvunu Gani Santhoshinchi - Mrokkiri Kaanukalarpinchi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అంధకారమును తొలగించి - హృదయపు దీపము వెలిగించి",
        "వాక్యమే ఇల నిజతారకలా -"
      ],
      "english": [
        "Andhakaaramunu Tholaginchi - Hrudayapu Deepamu Veliginchi",
        "Vaakyame Ila Nijathaarakalaa -"
      ]
    }
  ]
}
