        "జీవకీరీటము పొందెదము (2)",
        "క్రీస్తుని పోలి యుందుము"
      ],
      "english": [
        "E Gadiyaina Varudu Sriyesu Megarudhudai Ranumde",
        "Akasamamdayananu Samdhimpa",
        "Yesuto Nega Ayattama? (2)",
        "Jivakiritamu Pomdedamu (2)",
        "Kristuni Poli Yumdumu"
      ]
    }
  ]
