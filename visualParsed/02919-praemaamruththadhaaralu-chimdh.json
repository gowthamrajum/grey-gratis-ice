  "main_stanza": {
    "telugu": [
      "ప్రేమామృత్తధారలు చిందించిన యేసుకు సమమెవరు?",
      "ఆ-ఆ-ఆ ప్రేమయెతానై నిలచి ప్రేమవాక్కులనే బలికి",
      "ప్రేమతో ప్రాణము బెట్టి ప్రేమనగరికి చనియె ||ప్రేమా||"
    ],
    "english": [
      "Premaamruththadhaaralu chindhinchina Yesuku samamevaru?",
      "Aa-aa-aa premayethaanai nilachi premavaakkulane baliki",
      "Prematho praanamu betti premanagariki chaniye ||Premaa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
