  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వలోకుల పాప - పరిహారార్థము శ్రీ యేసు",
        "పరిశుద్ధ రక్తము చిందించి - బలియాయెను శ్రీ యేసు"
      ],
      "english": [
        "Sarvalokula paapa - Parihaaraarthamu Shree Yesu",
        "Parishuddha rakthamu chindinchi - Baliyaayenu Shree Yesu"
      ]
