  "main_stanza": {
    "telugu": [
      "నీవే మా తండ్రివి నీవే మా తల్లివి",
      "నీవే మా కాపరి నీవే మా ఊపిరి",
      "యేసయ్య.యేసయ్య.యేసయ్య. నీవే యేసయ్య"
    ],
    "english": [
      "Neeve maa thandrivi neeve maa thallivi",
      "Neeve maa kaapari neeve maa oopiri",
      "Yesayya.Yesayya.Yesayya. Neeve Yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమచేత తాలిమి చేత",
        "మము నడిపించిన కాపరి",
        "కోపించుచునే కృపను చూపుచు",
        "మము పోషించిన మా తండ్రివి"
      ],
      "english": [
        "Premachetha thaalimi chetha",
        "Mamu nadipinchina kaapari",
        "Kopinchuchune krupanu choopuchu",
        "Mamu poshinchina maa thandrivi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శక్తిచేత బలముచేత",
        "మము కాపాడిన మా తండ్రివి",
        "సరిచేయుచునే నీ రూపులోనికి",
        "మము నడిపించిన నాయకుడవు"
      ],
      "english": [
        "Shakthichetha balamuchetha",
        "Mamu kaapaadina maa thandrivi",
        "Saricheyuchune nee roopuloniki",
        "Mamu nadipinchina naayakudavu"
      ]
    }
  ]
