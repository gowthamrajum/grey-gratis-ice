  "main_stanza": {
    "telugu": [
      "దేవా మా ప్రార్థన వినవా",
      "ఆవేదన ఆలకించవా",
      "నీ ప్రజల కన్నీరు చూచి",
      "దాటి వెళ్లకు ప్రభువా",
      "మా దేశ క్షేమము చూసే",
      "ఆశ్రయమైన దేవుడవు",
      "సుర్యుడే లేక వేకువ రాదే",
      "కెరటాలు లేక సాగరము కాదే",
      "నీవు లేక జీవించగలమా",
      "కానరాక వ్యాధి మూలం",
      "దేశమంత శిలగ మారే",
      "కనులకాంతి చీకటాయే",
      "దేశశాంతి మూగబోయే",
      "జనులఘోష గగనమంతే",
      "ఘోర శిక్ష బారమాయే",
      "నీవే రావా కన్నీరు చూసి",
      "రక్షింపుము మా దేశమును",
      "దయ చూపవా యేసయ్య"
    ],
