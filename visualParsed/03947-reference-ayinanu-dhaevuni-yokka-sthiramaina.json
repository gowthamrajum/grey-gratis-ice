  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓ పావనులారా - మీరు విశ్వాసంపు",
        "పునాది యెంతెంతో - స్థిరమైనది",
        "శ్రేష్ఠంపు వాక్య - మా కందము",
        "నిచ్చున్ - శ్రీ యేసు నాశ్రయించు",
        "శ్రీ యేసు నాశ్రయించు - తన్నాశ్రయించు వారే ధన్యులు"
      ],
      "english": [
        "O paavanulaaraa - Meeru vishvaasampu",
        "Punaadi enthentho - Sthiramainadhi",
        "Shreshthampu vaakya - Maa kandhamu",
        "Nichchun - Shree Yesu naashrayinchu",
        "Shree Yesu naashrayinchu - Thannaashrayinchu vaare dhanyulu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ కెట్టి విపత్తు - సంభవింపగాను",
        "నే నీతో నున్నాను భయ - మేటికి",
        "దేవుడన్ - నే నీ కొనర్తున్ సాయం",
        "నా గొప్ప శక్తితోను - నా గొప్పశక్తితోను",
        "నా గొప్ప శక్తితోను - నిన్నిల్పుదు"
      ],
      "english": [
        "Nee ketti vipatthu - Sambhavimpagaanu",
        "Ne neetho nunnaanu bhaya - Metiki",
        "Dhevudan - Ne nee konarthun saayam",
        "Naa goppa shakthithonu - Naa goppashakthithonu",
        "Naa goppa shakthithonu - Ninnilpudhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవాగ్ని పరీక్షలు - నీకు కల్గగాను",
        "కృపాశక్తి మెండుగా - నీకిత్తును",
        "ఆ మంట నిన్ను - నావరింపగాను",
        "నీలోని కల్మషంబు - నీ లోని కల్మషంబు",
        "నీలోని కల్మషంబు - దహించును"
      ],
      "english": [
        "Dhevaagni pareekshalu - Neeku kalgagaanu",
        "Krupaashakthi mendugaa - Neekitthunu",
        "Aa manta ninnu - Naavarimpagaanu",
        "Neeloni kalmashambu - Nee loni kalmashambu",
        "Neeloni kalmashambu - Dhahinchunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వృద్ధాప్యము నందు - స్వంత ప్రజలెల్ల",
        "నా మారని ప్రేమ రుచి - చూతురు",
        "ప్రాయమున్ ప్రొద్దు - గ్రుంకినట్టి వేళన్",
        "నే కౌగిలింతు వారిన్ - నే కౌగిలింతు వారిన్",
        "నే కౌగిలింతు వారిన్ - నా కౌగిటన్"
      ],
      "english": [
        "Vruddhaapyamu nandu - Swantha prajalella",
        "Naa maarani prema ruchi - Choothuru",
        "Praayamun proddhu - Grunkinatti velan",
        "Ne kaugilinthu vaarin - Ne kaugilinthu vaarin",
        "Ne kaugilinthu vaarin - Naa kaugitan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నా యందు విశ్వాస - ముంచునట్టి",
        "యాత్మన్ - నే విడ్వను శత్రుకోటి - చేతికిన్",
        "పాతాళ మెల్లన్ - వాని మ్రింగజూడన్",
        "నే నెల్ల వేళలందు - నే నెల్ల వేళలందు",
        "నే నెల్ల వేళలందు - రక్షింతును"
      ],
      "english": [
        "Naa yandu vishwaasa - Munchunatti",
        "Yaathman - Ne vidvanu shathrukoti - Chethikin",
        "Paathaala mellan - Vaani mringajoodan",
        "Ne nella velalandu - Ne nella velalandu",
        "Ne nella velalandu - Rakshinthunu"
      ]
    }
  ]
