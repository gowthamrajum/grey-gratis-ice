{
  "song_name": "Yaesuprabhuvu Yerooshalemu Pravaeshinchina Vidhamu",
  "author": {
    "Authored by": "",
    "రచన": "గేరా ప్రేమయ్య"
  },
  "main_stanza": {
    "telugu": [
      "యేసుప్రభువు యెరూషలేము ప్రవేశించిన విధము",
      "భాసురముగ తన మహిమ చూడగా జేసెను ఆ దినము"
    ],
    "english": [
      "Yaesuprabhuvu Yerooshalemu Pravaeshinchina Vidhamu",
      "Bhaasuramuga Thana Mahima Choodagaa Jaesenu Aa Dhinamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భారవాహక గార్ధభమెక్కి బాహాటముగాను",
        "బయలుదేరెను జేజేలనగా ప్రియమొప్పగతాను"
      ],
      "english": [
        "Bhaaravaahaka Gaardhabhamekki Baahaatamugaanu",
        "Bayaludhaerenu Jaejaelanagaa Priyamoppagathaanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గట్గి పాడుచు గంతులు వేయుచు అట్టహాసముతో",
        "కొట్టుచు కరతాళములను పెద్దగా కూరిమి చూపిరిగా"
      ],
      "english": [
        "Gatgi Paaduchu Ganthulu Vaeyuchu Attahaasamuthoa",
        "Kottuchu Karathaalamulanu Peddhagaa Koorimi Choopirigaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పిల్లలు పెద్దలు మెల్లగ బోవుచు ఉల్లాసముతోను",
        "చల్లని ప్రభువని జయములు గొట్టిరి సంతోషముతోను"
      ],
      "english": [
        "Pillalu Peddhalu Mellaga Boavuchu Ullaasamuthoanu",
        "Challani Prabhuvani Jayamulu Gottiri Santhoashamuthoanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కొందరు మూర్ఖులు తొందర చేయుచు ముందుకు వచ్చిరిగా",
        "అందరు మానిన అరచును రాళ్లని అపుడా ప్రభువనగా"
      ],
      "english": [
        "Kondharu Moorkhulu Thondhara Chaeyuchu Mundhuku Vachchirigaa",
        "Andharu Maanina Arachunu Raallani Apudaa Prabhuvanagaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "చిగురుటాకు చెట్ల కొమ్మలను సొగసుగ మార్గములో",
        "బాగుగ పరిరచిరి భక్తిని చూపిరి సాగుచు జనులంతా"
      ],
      "english": [
        "Chigurutaaku Chetla Kommalanu Sogasuga Maargamuloa",
        "Baaguga Parirachiri Bhakthini Choopiri Saaguchu Janulanthaa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యెరూషలేము గతిగని ప్రభువు ఏడ్చెను ఎలుగెత్తి",
        "మరియు యెరుషలేం దేవాలయమును పరిశుభ్రత చేసె"
      ],
      "english": [
        "Yerooshalemu Gathigani Prabhuvu Aedchenu Elugeththi",
        "Mariyu Yerushalem Dhaevaalayamunu Parishubhratha Chaese"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "మనలోనున్న పాపము లెల్ల మనుపును ఆ ప్రభువే",
        "ఘనకృపశాంతులు గల్గించియు మరి ననయము బ్రోచునిలన్"
      ],
      "english": [
        "Manaloanunna Paapamu Lella Manupunu Aa Prabhuvae",
        "Ghanakrupashaanthulu Galginchiyu Mari Nanayamu Broachunilan"
      ]
    }
  ]
}
