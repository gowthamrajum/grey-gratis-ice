{
  "song_name": "Chakkani Baaludamma",
  "author": {
    "Authored by": "Suneel",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "చక్కని బాలుడమ్మ చూడచక్కంగా ఉన్నాడమ్మా",
      "కన్నీయ మరియమ్మ ఒడిలోన",
      "భలే బంగారు బాలుడమ్మ"
    ],
    "english": [
      "Chakkani baaludamma chuudachakkangaa unnaadammaa",
      "Kanniiya mariyamma odiloona",
      "Bhalea bangaaru baaludamma"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గొల్లలంతా గొప్ప దేవుడంటు – కూడినారు పశులపాకలో",
        "జ్ఞానులంతా తూర్పు చుక్క చూస్తూ – చేరినారు బెత్లహేములో",
        "బంగారు సాంబ్రాణి బోలములు అర్పించి ఆరాధించిరి",
        "లోక రక్షకుడు మా రారాజని కీర్తించి కొనియాడిరి"
      ],
      "english": [
        "Gollalanthaa goppa devudantu – kuudinaadu pasulapaakaloo",
        "Gnanulanthaa thuurpu chukka chuusthuu – chearinaaru bethlehemuloo",
        "Bangaaru saambraanni boolamulu arpinchi aaraadhinchiri",
        "Looka rakshakudu maa raaraajani kiirthinchi koniyaadiri"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నింగిలోన పరిశుద్ధులంతా ప్రభువును స్తుతియించిరి",
        "బెత్లెహేము పురములోన భక్తులంతా పూజించిరి",
        "సర్వోన్నతమైన స్థలములలోన దేవునికే మహిమ",
        "అని దూతలంతా దివిలోన పరవశించి పాడిరి"
      ],
      "english": [
        "Ningiloona parisuddulanthaa prabhuvunu stuthiyinchiri",
        "Bethlehemu puramuloona bhakthulanthaa puujinchiri",
        "Sarvoonnathamaina sthalamulaloona deavunikea mahima",
        "Ani duuthalantaa diviloona paravasinchi paadiri"
      ]
    }
  ]
}
