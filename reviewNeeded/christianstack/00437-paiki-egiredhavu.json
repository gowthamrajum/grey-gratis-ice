{
  "song_name": "Paiki Egiredhavu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవుని ఆనందం నిను కమ్మును",
      "ఉన్నతమైన స్థలములు నిను ఆహ్వానించున్"
    ],
    "english": [
      "Dhevuni aanandam ninu kammunu",
      "unnathamaina sthalamulu ninu aahwaaninchun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోక స్వాస్థ్యముతో పోషించును నిన్ను",
        "ఆకాశపు వాకిళ్లు తెరుచును నీకు"
      ],
      "english": [
        "Paraloka swaasthyamutho poshinchunu ninnu",
        "aakaasapu vaakillu theruchunu neeku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీవు పైకి లేచెదవు పై పైన ఎగిరెదవు",
        "నీవు వేచియున్న దినముల యొక్క ఫలమును పొందెదవు",
        "కోల్పోయినవన్ని రెండింతలుగా మరలా పొందెదవు"
      ],
      "english": [
        "Neevu paiki lechedhavu pai paina egiredhavu",
        "neevu vechiyunna dhinamula yokka phalamunu pondhedhavu",
        "kolpoyinavanni rendinthalugaa maralaa pondhedhavu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బాధించు బంధకములు ఈ దినమే విప్పబడున్",
        "నీ ముందు అడ్డుగా నిలిచే సంకెళ్లు తెగిపడున్",
        "నీకున్న దర్శనం నెరవేర త్వరపడున్",
        "అనుకూల ద్వారములు నీ కొరకు తెరవబడున్"
      ],
      "english": [
        "Baadhinchu bandhakamulu ee dhinamey vippabadun",
        "nee mundu addugaa nilichey sankellu thegipadun",
        "neekunna dharsanam neravera thwarapadun",
        "anukoola dhwaaramulu nee koraku theravabadun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీవు పైకి లేచెదవు పై పైన ఎగిరెదవు",
        "నీవు వేచియున్న దినముల యొక్క ఫలమును పొందెదవు",
        "కోల్పోయినవన్ని రెండింతలుగా మరలా పొందెదవు"
      ],
      "english": [
        "Neevu paiki lechedhavu pai paina egiredhavu",
        "neevu vechiyunna dhinamula yokka phalamunu pondhedhavu",
        "kolpoyinavanni rendinthalugaa maralaa pondhedhavu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీతి సూర్యుడు నీ పైన ఉదయించును",
        "యేసుని రెక్కల క్రింద ఆరోగ్యమొందెదవు",
        "నీ కాలి క్రింద దుష్టుడు దూళిగా మారును",
        "నింగిలో మెరుపు వలె శత్రువు కూలును"
      ],
      "english": [
        "Neethi sooryudu nee paina udhayinchunu",
        "yesuni rekkala krindha aarogyamondhedhavu",
        "nee kaali krindha dhushtudu dhooligaa maarunu",
        "ningilo merupu valey sathruvu koolunu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీవు పైకి లేచెదవు పై పైన ఎగిరెదవు",
        "నీవు వేచియున్న దినముల యొక్క ఫలమును పొందెదవు",
        "కోల్పోయినవన్ని రెండింతలుగా మరలా పొందెదవు"
      ],
      "english": [
        "Neevu paiki lechedhavu pai paina egiredhavu",
        "neevu vechiyunna dhinamula yokka phalamunu pondhedhavu",
        "kolpoyinavanni rendinthalugaa maralaa pondhedhavu"
      ]
    }
  ]
}
