{
  "song_name": "Edho Aasha Naalo",
  "author": {
    "Authored by": "Pastor Ramesh",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఏదో ఆశ నాలో నీతోనే జీవించనీ",
      "యేరై పారే ప్రేమ నాలోనే ప్రవహించనీ",
      "మితిలేని ప్రేమ చూపించినావు",
      "శృతి చేసి నన్ను పలికించినావు",
      "ఈ స్తోత్రగానం నీ సొంతమే"
    ],
    "english": [
      "Edho aasha naalo neethone jeevinchani",
      "yerai paare prema naalone pravahinchani",
      "mithileni prema choopinchinaavu",
      "sruthi chesi nannu palikinchinaavu",
      "ee sthothragaanam nee sonthame"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరవాసిననైన కడుపేదను నాకేల ఈ భాగ్యము",
        "పరమందు నాకు నీ స్వాస్థ్యము నీవిచ్చు బహుమానము",
        "తీర్చావులే నా కోరిక తెచ్చానులే చిరుకానుక",
        "అర్పింతును స్తుతిమాలిక",
        "కరుణామయా నా యేసయ్య",
        "నీ పాదసేవ నే చేయనా నా ప్రాణమర్పించనా",
        "నా సేద తీర్చిన నీ కోసమే ఘనమైన ప్రతిపాదన",
        "ప్రకటింతును నీ శౌర్యము",
        "కీర్తింతును నీ కార్యము",
        "చూపింతును నీ శాంతము",
        "తేజోమయా నా యేసయ్య"
      ],
      "english": [
        "Paravaasinanaina kadupedhanu naakela ee baagyamu",
        "paramandhu naaku nee swaasthyamu neevichu bahumaanamu",
        "theerchaavule naa korika thechaanule chiru kaanuka",
        "arpinthunu sthuthimaalika",
        "karunaamayaa naa yesayya",
        "Nee paadhaseva ne cheyanaa naa praanamarpinchinaa",
        "naa sedha theerchina nee kosame ghanamaina prathipaadhana",
        "prakatinthunu nee souryamu",
        "keerthinthunu nee kaaryamu",
        "choopinthunu nee saanthamu",
        "thejomayaa naa yesayya"
      ]
    }
  ]
}
