  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసు నీతి రక్తమేను నా నిరీక్షణంతయును",
        "నే వేరెవ్వని నమ్మను యేసు నామము మాత్రమే",
        "క్రీస్తు యేసు నా బండ",
        "మిగతా యంత యూబియే"
      ],
      "english": [
        "Yesu neethi rakthamenu naa nireekshanamthayunu",
        "Ne verevvani nammanu Yesu naamamu maathrame",
        "Kreesthu Yesu naa banda",
        "Migathaa yantha oobiye"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రీస్తు మోము మరుగైన తన కృపయే నాదగు",
        "అల్లలాడు అలల్ లేవన్ నాదు లంగరు నిల్పెదన్"
      ],
      "english": [
        "Kreesthu momu marugaina thana krupaye naadhagu",
        "Allalaadu alal levan naadu langaru nilpedhan"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అతని వాగ్దాన మేను నన్ను బలపరచును",
        "ఎల్లవారు ఓడినను అతడే నా నిరీక్షణ"
      ],
      "english": [
        "Athani vaagdhaana menu nannu balaparachunu",
        "Ellavaaru odinanu athade naa nireekshana"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బూరధ్వనితో రాగన్ ఆయనయందు నిలిచియుందున్",
        "ఆయన నీతినే దాల్చి గద్దెదుట నుందు నిర్దోషినై"
      ],
      "english": [
        "Booradhwanitho raagan aayanayandhu nilichiyundhun",
        "Aayana neethine daalchi gaddedhuta nundu nirdhoshinai"
      ]
    }
  ]
}
