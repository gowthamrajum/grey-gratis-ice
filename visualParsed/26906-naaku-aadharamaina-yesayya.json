  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా దుఃఖములో ఓదార్పు నీవై",
        "విశ్వాసమునకు ఆధారమైన",
        "మితిలేని కనికరం, నాపై చూపి",
