{
  "song_name": "Nee Sannidhi Chalu",
  "author": {
    "Authored by": "Evangelist Sam Prasad",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మేఘస్తంభమైన సన్నిధిని రూపు మార్చగల సన్నిధిని",
      "నడిపించే సన్నిధిని నను వీడి పోనివ్వకు"
    ],
    "english": [
      "Megha sthambamaina sannidhini",
      "roopu maarchagala sannidhini",
      "nadipinche sannidhini",
      "nanu veedi ponivvaku",
      "balaheenudu balavanthudavune",
      "nee sannidhi vachutache",
      "emi lekapoyina ninduga undedhan",
      "nee sannidhilo nenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బలహీనుడు బలవంతుడవునే",
        "నీ సన్నిధి వచ్చుటచే",
        "ఏమి లేకపోయినా నిండుగా ఉండెదన్",
        "నీ సన్నిధిలో నేను"
      ],
      "english": [
        "Nee sannidhiye naku chalaya",
        "na hrudhi vaancha neevenaya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ సన్నిధియే నాకు చాలయా నా హృదివాంఛ నీవెనయా"
      ],
      "english": [
        "Mannanu pakshulanu",
        "neetini andinchavu",
        "anniyu adhikamuga unnavi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మన్నాను పక్షులను నీటిని అందించావు అన్నియు అధికముగా ఉన్నవి"
      ],
      "english": [
        "Anni undi neevu lekapothe",
        "payanam aagipovunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అన్ని ఉండి నీవు లేకపోతే పయనం ఆగిపోవును",
        "నీవు రావా నా యొద్దకురా ఈ విశ్వాస యాత్రలో",
        "నువ్వు నడువు నా ముందు నడువు ఈ విశ్వాస యాత్రలో"
      ],
      "english": [
        "Nuvvu raava naa yoddhaku raa",
        "e vishwasa yathralo",
        "neevu naduvu naa mundu naduvu",
        "e vishwasa yathralo"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
