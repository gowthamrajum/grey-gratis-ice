{
  "song_name": "Ebenezere",
  "author": {
    "Authored by": "M.S.Suneeth Vardhan",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ సన్నిధి నాతో వెంటరాని నీ ఆత్మ నాలో",
      "మండనివ్వని",
      "పాపిని ప్రభువా క్షమియించవా దోషిని ప్రభువా సరిచేయవా",
      "ఎబినేజరే ఎబినేజరే – ఎబినేజరే ఎబినేజరే"
    ],
    "english": [
      "Nee sannidhi naatho ventarani",
      "nee aatma nalo mandanivani",
      "paapini prabhuva kshamiyinchava, dooshini prabhuva saricheyava",
      "ebenezere ebenezere ebenezere ebenezere"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వాగ్ధాన ప్రదాత – నమ్మదగిన దేవ",
        "ఆశ్రయ దుర్గమా – బలమైన దేవ",
        "సమాధాన ప్రదాత – కృపగల దేవ",
        "ఆనంద కారకుడ – ప్రియమైన దేవ",
        "సమృద్ధి ప్రదాత – మహిమగల దేవ",
        "జీవిత నావికుడ – నిత్యుడైన దేవ",
        "నిత్య జీవ ప్రదాత – నీతిగల దేవ",
        "స్తుతులకు పాత్రుడ – ఘనమైన దేవ"
      ],
      "english": [
        "Vaakdhana pradatha – nammadhagina deva",
        "ashraya durgama – balamina deva",
        "Samadhana pradatha – krupagala deva",
        "aanandha kaarakuda – priyamaina deva",
        "Samruddhi pradatha – mahimagala deva",
        "jeevitha naavikuda – nithyudaina deva",
        "Nithya jeeva pradatha – neethigala deva",
        "stuthulaku paathruda – ghanamaina deva"
      ]
    }
  ]
}
