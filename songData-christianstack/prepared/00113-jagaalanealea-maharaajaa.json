{
  "song_name": "Jagaalanealea Maharaajaa",
  "author": {
    "Authored by": "Ps. Israel",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జగాలనేలే మహారాజా – సృష్టికే యజమానుడా",
      "రమ్యమైన పోలికలో – మమ్ము చేసిన యేసయ్య",
      "నీ మనోహర ప్రతిరూపం – మానవాళికిచ్చావే",
      "నీ జనాంగమే మోసపోయేనే – ఆదిసర్పమే మమ్ము ఈడ్చుకెళ్ళనే",
      "జీవవృక్షమే మాకు దూరమాయేనే – చిమ్మచీకటే భూమి నావరించెనే",
      "పంపావే సహాయం పుడమి పొంగిపొర్లునట్లు – ఆపావే ప్రమాదం పాతాళం భయపడునట్లు",
      "నీలోనే పొందామే నిత్యజీవమే – చేస్తామే ఊరంతా నిత్య పండుగే"
    ],
    "english": [
      "Jagaalanelae Mahaaraajaa",
      "Srushtike yajamaanudaa",
      "Ramyamaina polikalo",
      "Mammu chesina Yesayya",
      "Nee manohara prathirupam",
      "Maanavaaliki ichchaave",
      "Nee janaangame mosapoyene",
      "Aadi sarpame mammu eedchukellane",
      "Jeevavrukshame maaku dooramaayene",
      "Chimma cheekate bhoomi naavarinchene",
      "Pampaave sahaayam",
      "Pudami pongiporlunatlu",
      "Apaave pramadam",
      "Paathaalam bhayapadunatlu",
      "Neelone pondhame nithya jeevame",
      "Chesthame ooranthaa nithya panduge"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హ్యాపీ హ్యాపీ హ్యాపీ హ్యాపీ క్రిస్మస్ –",
        "మెర్రీ మెర్రీ మెర్రీ మెర్రీ క్రిస్మస్"
      ],
      "english": [
        "Happy Happy Happy Happy Christmas",
        "Merry Merry Merry Merry Christmas"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దూత వచ్చి చాటిచెప్పెను – రక్షకుని రాక",
        "తరము వెంబడి తరము దొర్లి – మాకు చేరింది లే యేసే ప్రభువని మా నోటితో ఒప్పుకొని –",
        "మృత్యుంజయుడని మనసారా నమ్మితే",
        "మదిలో పొంగునే రక్షణ ప్రవాహమే –",
        "మనసంతా నిండునే క్రిస్మస్ ఉల్లాసమే"
      ],
      "english": [
        "Dootha vacchi chaticheppenu",
        "Rakshakuni raaka",
        "Tharamu vembadi tharamu dhorli",
        "Maaku cherindhile",
        "Yesae Prabhuvani",
        "Maa notitho oppukoni",
        "Mruthyunjayudani",
        "Manasaara nammithea",
        "Madilo pongune rakshana pravaahame",
        "Manasanthaa nindune Christmas ullaasame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తారచూచి వెదకవచ్చిరి – ఆనాటి జ్ఞానులే",
        "తూచరాని మణి మాణిక్యములతో – నిన్నే చేరిరి",
        "మా ప్రేమ మధురిమలే – ప్రాణ ప్రియునికే అంకితమై ఆజన్మాంతము – నీ కొరకే నిలువగా",
        "మదిలో పొంగునే రక్షణ ప్రవాహమే – మనసంతా నిండునే క్రిస్మస్ ఉల్లాసమే"
      ],
      "english": [
        "Thaara choosi vedakavachchiri",
        "Aanaati jnaanule",
        "Thoocharaani mani maanikyamulatho",
        "Ninne cheriri",
        "Maa prema madhurimale",
        "Praana priyunike ankithamai",
        "Aajanmaanthamu ne korake niluvaga",
        "Madhilo pongune rakshana pravaahame",
        "Manasanthaa nindune Christmas ullaasame"
      ]
    }
  ]
}
