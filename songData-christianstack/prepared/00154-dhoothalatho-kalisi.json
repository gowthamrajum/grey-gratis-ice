{
  "song_name": "Dhoothalatho Kalisi",
  "author": {
    "Authored by": "Seenanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దూతలతో కలసి – సెరాపులలో నిలచీ",
      "నీ మహిమను – చూడాలనీ",
      "నా ఆశతీరా – పాడాలనీ",
      "ఆరాధించాలనీ – ఆస్వాదించాలనీ"
    ],
    "english": [
      "Dhoothalatho kalasi – serapulalo nilachi",
      "Nee mahimanu – choodaalaanee",
      "Naa aashatheeraa – paadaalaanee",
      "Aaraadhinchaalaanee – aasvaadhinchaalaanee"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు గానాల – స్తోత్రార్హుడా",
        "కోరాహు కుమారుల – స్తుతి పాత్రుడా",
        "నాస్తుతులన్నిటిపై – ఆసీనుడవయ్యా"
      ],
      "english": [
        "Dhaaveedhu gaanala – sthothraarhudaa",
        "Koraahu kumaarula – sthuthi paathrudaa",
        "Naa sthuthulannitipai – aaseenudavayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అత్యున్నతమైన – సింహాసనమందు",
        "ఆసీనుడవైన ప్రభు – నీ వుండగా",
        "నీచొక్కాయి అంచులు",
        "– దేవాలయమే నిండగా"
      ],
      "english": [
        "Athyunnathamaina – simhaasanamandhu",
        "Aaseenudavaina Prabhu – nee vundaga",
        "Nee chokkaayi anchulu –",
        "Dhevaalayame nindaga"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వేవేల దూతలు – నిను పాడగా",
        "ఆ కంఠస్వరములే – ధ్వనించగా",
        "ఆ మందిరమంతా – ధూమముచే నిండగా"
      ],
      "english": [
        "Veavela dhoothalu – ninu paadaga",
        "Aa kanttaswaramule – dhvaninchaga",
        "Aa mandhiramanthaa – dhoomamuche nindaga"
      ]
    }
  ]
}
