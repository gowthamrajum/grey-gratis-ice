{
  "song_name": "Goppa Karyamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కృంగియున్న వేళల యందు"
    ],
    "english": [
      "Goppa kaaryamu chesedhavani nenerugudhun",
      "nee shakthitho nee aathmatho",
      "nee prematho jayinthunu",
      "goppa kaaryamu chesedhavani nenerugudhun"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అలలు నాపై లేచినను",
        "నేను మునిగిపోనెప్పుడు",
        "ఎటు తోచని స్తితి యందు",
        "నీవు నా చేయి విడువవు"
      ],
      "english": [
        "Alalu naapai lechinanu",
        "nenu munigiponeppudu",
        "etu thochani sthithi yandhu",
        "neevu naa cheyi viduvavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గొప్ప కార్యము చేసెదవని నేనెరుగుదున్",
        "నీ శక్తితో నీ ఆత్మతో",
        "నీ ప్రేమతో జయింతును",
        "గొప్ప కార్యము చేసెదవని నేనెరుగుదున్"
      ],
      "english": [
        "Pre chorus:",
        "krungiyunna velala yandhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గాడాంధకార లోయలో నేను",
        "సంచరించిన భయపడను",
        "నాముందు నడచు వాడావు నీవే",
        "నన్ను విడువవు యెడబాయవు"
      ],
      "english": [
        "Gaadaandhakaara loyalo nenu",
        "sancharinchina bhayapadanu",
        "naamundhu nadachu vaadaavu neeve",
        "nannu viduvavu yedabaayavu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బ్రిడ్జ్:",
        "చీకటి వేలలో నా తోడు నీవే",
        "నమ్మదగిన దేవుడా",
        "నా భయ-భీతిలో",
        "విమోచకుడవు",
        "నా గొప్ప దేవుడా"
      ],
      "english": [
        "Bridge:",
        "Cheekati velalo naa thodu neeve",
        "nammadhagina devudaa",
        "naa bhaya-bheethilo",
        "vimochakudavu",
        "naa goppa devudaa"
      ]
    }
  ]
}
