    {
      "stanza_number": 6,
      "telugu": [
        "దూత లంత యేసు ప్రభుని బ్రీతిఁ జేయను",
        "నూతన సంగీతములను జేతురు వినను రండు"
      ],
      "english": [
        "Dhootha Lantha Yaesu Prabhuni Breethi Jaeyanu",
        "Noothana Sangeethamulanu Jaethuru Vinanu Randu"
