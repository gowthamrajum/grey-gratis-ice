  },
  "main_stanza": {
    "telugu": [
      "రమ్మనుచున్నా డేసురాజు రండి సర్వ జనులారా"
    ],
    "english": [
      "Rammanuchunnaadu Yesuraaju randi sarva janulaaraa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇల్లువాకిలి లేనివారలు ఇహాన నమ్మదగనివారలు",
        "తన రాజ్యము మీకిచ్చును యేసు"
      ],
      "english": [
        "Illuvaakili lenivaaralu ihaana nammadhaganivaaralu",
        "Thana raajyamu meekichchunu Yesu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కరవుచే కృశించుచున్న మరణించుచున్న ప్రజలారా",
        "ఆకలిదప్పులు తీర్చును మీకు రండి సర్వజనులారా  ||రమ్మనుచున్నా||"
      ],
      "english": [
        "Karavuche krushinchuchunna maraninchuchunna prajalaaraa",
        "Aakalidhappulu theerchunu meeku randi sarvajanulaaraa ||Rammanuchunnaa||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ముండ్ల మకుటము ప్రక్కన గాయము పాదహస్తములలో",
        "గాయములు పొందిన ప్రభువే పిల్చెను మిమ్ము రండి",
        "సర్వజనులారా  ||రమ్మనుచున్నా||"
      ],
      "english": [
        "Mundla makutamu prakkana gaayamu paadhahasthamulalo",
        "Gaayamulu pondina Prabhuve pilchenu mimmu randi",
        "Sarvajanulaaraa ||Rammanuchunnaa||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "రయమున ప్రియులారా కూడి రండి పరీక్ష చేయండి",
        "భరించును మీ భారములన్నియు రండి సర్వజనులారా  ||రమ్మనుచున్నా||"
      ],
      "english": [
        "Rayamuna priyulaaraa koodi randi pareeksha cheyandi",
        "Bharinchunu mee bhaaramulanniyu randi sarvajanulaaraa ||Rammanuchunnaa||"
      ]
    }
  ]
}
