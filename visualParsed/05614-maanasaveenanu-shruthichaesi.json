{
  "song_name": "Maanasaveenanu shruthichesi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "మానసవీణను శృతిచేసి",
      "మనసు నిండా కృతజ్ఞత నింపి",
      "గొంతెత్తి స్తుతిగీతములే పాడవా",
      "వింతైన దేవుని ప్రేమను నీవిల చాటవా"
    ],
    "english": [
      "Maanasaveenanu shruthichesi",
      "Manasu nindaa kruthagnatha nimpi",
      "Gontheththi sthuthigeethamule paadavaa",
      "Vinthaina Devuni premanu neevila chaatavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వేకువనే పక్షులు లేచి స్తుతి కేకలు వేయవా",
        "సాయంసమయాన పిచ్చుకలు దేవుని కీర్తించవా",
        "స్తుతి చేయుట క్షేమకరం - ఘనపరచుట మేలుకరం",
        "దేవుని ఉపకారములకై సదా కీర్తించుట ధన్యకరం"
      ],
      "english": [
        "Vekuvane pakshulu lechi sthuthi kekalu veyavaa",
        "Saayamsamayaana pichchukalu Devuni keerthinchavaa",
        "Sthuthi cheyuta kshemakaram - Ghanaparachuta melukaram",
        "Devuni upakaaramulakai sadaa keerthinchuta dhanyakaram"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శ్రమలతో తడబడితే ప్రార్ధనతో సరిచేయి",
        "దిగులుతో శృతి తగ్గితే నమ్మికతో సాగనీయి",
        "మనమే జగతికి వెలుగిస్తే - విశ్వాసగళాలు కలిస్తే",
        "స్తుతిధూపం పైపైకెగసి దీవెనలే వర్షింపవా"
      ],
      "english": [
        "Shramalatho thadabadithe praardhanatho saricheyi",
        "Dhigulutho shruthi thaggithe nammikatho saaganeeyi",
        "Maname jagathiki velugisthe - Vishvaasagalaalu kalisthe",
        "Sthuthidhoopam paipaikegasi dheevenale varshimpavaa"
      ]
    }
  ]
}
