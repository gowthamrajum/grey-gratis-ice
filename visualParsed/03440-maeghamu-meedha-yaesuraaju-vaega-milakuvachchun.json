    {
      "stanza_number": 3,
      "telugu": [
        "వేల వేలగు ఆయన మాటలు రాకను దెల్పెను",
        "ప్రవక్తలపొస్తలులు దానిని గూర్చియే ప్రకటించిరి"
      ],
      "english": [
        "Vela velagu aayana maatalu raakanu dhelpenu",
        "Pravakthalaposthalulu dhaanini goorchiye prakatinchiri"
      ]
