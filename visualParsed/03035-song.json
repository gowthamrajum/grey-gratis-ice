{
  "song_name": "Naa Yaathma Neelo Melkoni Dhayaaluni",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఎస్ మెడ్లే"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నా యాత్మ నీలో మేల్కొని",
      "దయాళుని కీర్తింపుము",
      "ప్రియంబుతో నీరక్షకున్",
      "ప్రపూర్ణ ప్రేమబాడుము."
    ],
    "english": [
      "Naa yaathma neelo melkoni",
      "dhayaaluni keerthimpumu",
      "Priyambutho neerakshakun",
      "prapoorna premabaadumu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "నే పాపమందుఁ గూలగన్",
        "కాపాడి నన్ను లేపెనే",
        "నా పాలి పుణ్యరక్షకున్",
        "ప్రపూర్ణ ప్రేమఁ బాడుము."
      ],
      "english": [
        "Ne paapamandu goolagan",
        "kaapaadi nannu lepene",
        "Naa paali punyarakshakun",
        "prapoorna prema baadumu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఏ పాటి శత్రువైనను",
        "ఏపాట్లు పెట్టలే రిఁకన్",
        "నాపుణ్య మార్గదర్శకున్",
        "ప్రపూర్ణ ప్రేమఁబాడుము."
      ],
      "english": [
        "E paati shathruvainanu",
        "epaatlu pettale rikan",
        "Naapunya maargadharshakun",
        "prapoorna premabaadumu."
      ]
    }
  ]
}
