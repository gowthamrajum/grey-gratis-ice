  },
  "main_stanza": {
    "telugu": [
      "సామ్ 103",
      "స్తుతియించు ప్రభున్ స్తుతియించు నీవు",
      "నా ప్రాణమా నా సమస్తమా"
    ],
    "english": [
      "Psalm 103",
      "Sthuthiyinchu Prabhun sthuthiyinchu neevu",
      "Naa praanamaa naa samasthamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆయన చేసిన ఉపకారములలో",
        "నా ప్రాణమా నీవు మరువకుమా - దేనిన్  ||నా||",
        "నీ దేవుని నీవు మరువకుమా"
      ],
      "english": [
        "Aayana chesina upakaaramulalo",
        "Naa praanamaa neevu maruvakumaa - Dhenin ||Naa||",
        "Nee devuni neevu maruvakumaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దోషములను మన్నించి వేసి",
        "నీ రోగముల నన్నింటిని - ప్రభు - నీ",
        "కుదుర్చి వేయుచున్నాడు"
      ],
      "english": [
        "Nee doshamulanu manninchi vesi",
        "Nee rogamula nannintini - Prabhu - Nee",
        "Kudhurchi veyuchunnaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా ప్రాణమును సమాధి నుండి",
        "విమోచించిన వాడని - ప్రభు - విమో",
        "కరుణా కిరీటము నియ్యన్"
      ],
      "english": [
        "Naa praanamunu samaadhi nundi",
        "Vimochinchina vaadani - Prabhu - Vimo",
        "Karunaa kireetamu niyyan"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పక్షిరాజు యౌవనము వలె",
        "నూతన యౌవన ముండునట్లు - నీకు - నూతన",
        "మేలుతో తృప్తిపరచును"
      ],
      "english": [
        "Pakshiraaju yauvanamu vale",
        "Noothana yauvana mundunatlu - Neeku - Noothana",
        "Melutho thrupthiparachunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "దీర్ఘశాంతుడు దయగల దేవుడు",
        "యెల్లప్పుడు వ్యాజ్యమాడడు - నీతో - ఎల్లప్పుడు",
        "ప్రతీకారము చేయడు"
      ],
      "english": [
        "Dheerghashaanthudu dayagala devudu",
        "Ellappudu vyaajyamaadadu - Neetho - Ellappudu",
        "Pratheekaaramu cheyadu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "భూమికంటె ఎంత ఆకాశమెత్తో",
        "భక్తుల యెడల కృపనంత - తన - భక్తుల",
        "అధికముగా చేసియున్నాడు"
      ],
      "english": [
        "Bhoomikante entha aakaashamettho",
        "Bhakthula edala krupanantha - Thana - Bhakthula",
        "Adhikamugaa chesiyunnaadu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పడమటికి తూర్పెంత యెడమో",
        "పాపములకును మనకంత - మన - పాప",
        "యెడము గలుగ జేసెను"
      ],
      "english": [
        "Padamatiki thoorpentha edamo",
        "Paapamulakunu manakantha - Mana - Paapa",
        "Edamu kaluga jesenu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "తండ్రి తన కుమారుని యెడల",
        "జాలిపడునట్లు యెహోవా - బహు - జాలి",
        "భక్తులపై జాలిపడును"
      ],
      "english": [
        "Thandri thana kumaaruni edala",
        "Jaalipadunatlu Yehova - Bahu - Jaali",
        "Bhakthulapai jaalipadunu"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "మంటివాడవని ఆయన యెరుగున్",
        "నిర్మింపబడిన విధమెరుగున్ - నీవు - నిర్మి",
        "నీ దేవుడు నిన్ను నెరుగును"
      ],
      "english": [
        "Mantivaadavani aayana erugun",
        "Nirmimpabadina vidhamerugun - Neevu - Nirmi",
        "Nee devudu ninnu nerugunu"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "దేవదూతలారా దైవభక్తులారా",
        "యెహోవా మహాసైన్యములారా - ఓ - యెహోవా",
        "హల్లెలూయ పాట పాడుడి"
      ],
      "english": [
        "Dhevadhoothalaaraa dhaivabhakthulaaraa",
        "Yehova mahaasainyamulaaraa - O - Yehova",
        "Hallelooya paata paadudi"
      ]
    }
  ]
