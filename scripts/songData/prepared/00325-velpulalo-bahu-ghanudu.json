{
  "song_name": "Velpulalo Bahu Ghanudu",
  "author": {
    "Authored by": "Bro  Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "వేల్పులలో బహు ఘనుడా -యేసయ్యా",
      "నిను సేవించువారిని - ఘనపరతువు",
      "నిను ప్రేమించువారికి సమస్తము - సమకూర్చి జరిగింతువు",
      "నీ యందు భయభక్తి గల వారికీ - శాశ్వత కృపనిచ్చెదవు"
    ],
    "english": [
      "Velpulalo Bahu Ghanudaa - Yesayyaa",
      "Ninu Sevinchuvaarini - Ghanaparatuvu",
      "Ninu Preminchuvaariki Samastamu - Samakoorchi Jarigintuvu",
      "Nee Yandu Bhayabhakti Gala Vaarikee - Saaswata Krupanichchedavu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సుందరుడైన యోసేపును - అంధకార బంధువర్గాలలో",
        "పవిత్రునిగ నిలిపావు - ఫలించెడి కొమ్మగ చేశావు",
        "మెరుగుపెట్టి నను దాచావు - నీ అంబుల పొదిలో",
        "ఘనవిజయమునిచ్చుట కొరకు - తగిన సమయములో"
      ],
      "english": [
        "Sundarudaina Yosepunu - Andhakaara Bandhuvargaalalo",
        "Pavitruniga Nilipaavu - Phalinchedi Kommaga Chesaavu",
        "Merugupetti Nanu Daachaavu - Nee Ambula Podilo",
        "Ghanavijayamunichchuta Koraku - Tagina Samayamulo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఉత్తముడైన దావీదును - ఇరుకులేని విశాల స్థలములో",
        "ఉన్నత కృపతో నింపావు - ఊహించని స్థితిలో నిలిపావు",
        "విలువపెట్టి నను కొన్నావు - నీ అమూల్య రక్తముతో",
        "నిత్య జీవమునిచ్చుట కొరకు - మహిమ రాజ్యములో"
      ],
      "english": [
        "Uttamudaina Daaveedunu - Irukuleni Visaala Sthalamulo",
        "Unnata Krupato Nimpaavu - Oohinchani Sthitilo Nilipaavu",
        "Viluvapetti Nanu Konnaavu - Nee Amoolya Raktamuto",
        "Nitya Jeevamunichchuta Koraku - Mahima Raajyamulo"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పామరుడైన సీమోనును - కొలతలేని ఆత్మాభిషేకముతో",
        "అజ్ఞానము తొలగించావు - విజ్ఞాన సంపదనిచ్చావు",
        "పేరుపెట్టి నను పిలిచావు - నిను పోలినడుచుటకు",
        "చెప్ప శక్యము కాని ప్రహర్షముతో - నిను స్తుతించెదను"
      ],
      "english": [
        "Paamarudaina Seemonunu - Kolataleni Aatmaabhishekamuto",
        "Ajnaanamu Tolaginchaavu - Vijnaana Sampadanichchaavu",
        "Perupetti Nanu Pilichaavu - Ninu Polinaduchutaku",
        "Cheppa Sakyamu Kaani Praharshamuto - Ninu Stutinchedanu"
      ]
    }
  ]
}
