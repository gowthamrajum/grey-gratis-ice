  "main_stanza": {
    "telugu": [
      "నీ కృపలోన ఇంతకాలం",
      "నన్ను నిలిపిన నా యేసయ్య",
      "భయపడవద్దని అభయమిచ్చిన",
      "దేవదేవుడవు నీవేనయ్యా",
      "నీ దయ కిరీటముగా",
      "ఈ నూతన సంవత్సరములో",
      "నన్ను అభివృద్ధి పరచుము",
      "నా యేసయ్య"
    ],
    "english": [
      "Nee krupalona intha kaalam",
      "nannu nilipina naa yesayya",
      "bhayapadavaddani abhayamichhina",
      "devadevudavu neevenayya",
      "nee daya keeritamuga",
      "ee noothana samvatsaramulo",
      "nannu abhivruddhi parachumu",
      "naa yesayya"
    ]
  },
  "stanzas": [
