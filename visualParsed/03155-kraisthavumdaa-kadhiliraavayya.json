  "main_stanza": {
    "telugu": [
      "క్రైస్తవుండా కదిలిరావయ్యా కలుషాత్ములకు యీ",
      "సిలువశక్తి జాటవేమయ్యా యెండవానలనియు జడిసి",
      "ఎంతకాలము మూలనుందువు కండలను ప్రేమింతువేమన్నా",
      "ఈ మంటికండలు ఎంత బెంచిన మంటికేనన్నా ||క్రైస్తవ||"
    ],
    "english": [
      "Kraisthavundaa kadhiliraavayyaa kalushaathmulaku ee",
      "Siluvashakthi chaatavemayyaa endavaanalaniyu jadisi",
      "Enthakaalamu moolanundhuvu kandalanu preminthuvemannaa",
      "Ee mantikandalu entha penchina mantikenannaa ||Kraisthava||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వసుధలో ప్రజలెల్లరు యేసు వాక్యంబు వివక్షుద్భాధకొని",
        "వాంఛించుచుండగను మిషనులెల్లను మిషలచేత",
