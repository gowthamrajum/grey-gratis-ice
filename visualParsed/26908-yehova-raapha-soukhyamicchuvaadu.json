  "main_stanza": {
    "telugu": [
      "యెహోవా రాఫా సౌఖ్యమిచ్చువాడు",
      "వ్యాధులింక నాకు లేదే",
      "యెహోవా రాఫా నా బలమాయనే",
      "తెగులు రోగము నాకు లేదే",
      "సిలువలో నాకై ప్రాణము ఇచ్చెను",
      "ఐగుప్తు రోగము నాకు లేదే",
      "మరణము జయించి జీవముతో లేచెను",
      "మరణ భయము నాకు లేదే",
      "నిన్ను నమ్మువారికి భయము లేదే",
      "నిన్ను వెదకు వారికి కొరత లేదే"
    ],
    "english": [
      "Yehovaa Raaphaa soukhyamichchuvaadu",
      "Vyaadhulinka naaku lede",
      "Yehovaa Raaphaa naa balamaayane",
      "Thegulu rogamu naaku lede",
      "Siluvalo naakai praanamu ichchenu",
      "Aigupthu rogamu naaku lede",
      "Maranamu jayinchi jeevamutho lechenu",
      "Marana bhayamu naaku lede",
      "Ninnu nammuvaariki bhayamu lede",
      "Ninnu vedhaku vaariki koratha lede"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "యెహోవా షాలోం సమాధానమిచ్చువాడు",
        "చేయి పట్టి నన్ను నడిపించును",
        "యెహోవా రూహ్ నా మంచి కాపరి",
        "శాంతి జలముల చెంత నడిపించును",
        "యెహోవా యిరే అన్నియు ఇచ్చువాడు",
        "పొషించుటకు శక్తుడాయనే",
        "ఇస్సాకు పంటను ఆశీర్వదించువాడు",
        "నూరంతలుగా నింపి వేయునే",
        "యేసయ్యా నా నమ్మకము నీవే",
        "యేసయ్యా నా ఆశ్రయము నీవే  ||యెహోవా||"
      ],
      "english": [
        "Yehovaa Shaalom samaadhaanamichchuvaadu",
        "Cheyi patti nannu nadipinchunu",
        "Yehovaa Rooh naa manchi kaapari",
        "Shaanthi jalamula chentha nadipinchunu",
        "Yehovaa Yire anniyu ichchuvaadu",
        "Poshinchutaku shakthudaayane",
        "Issaaku pantanu aasheervadhinchuvaadu",
        "Nooranthalugaa nimpi veyune",
