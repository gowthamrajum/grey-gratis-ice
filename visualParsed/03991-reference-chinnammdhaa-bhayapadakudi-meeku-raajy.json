        "Unnatha pilupu neeku nichchenu",
        "Thanarakthamichchi ninnu konnaadu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దేవుని రాజ్య మహిమను బొంద",
        "సువార్త ద్వారా నిన్ను పిలిచెను",
