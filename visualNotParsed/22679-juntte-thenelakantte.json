  "main_stanza": {
    "telugu": [
      "జుంటెతేనెల కంటే",
      "అతి మధురం అది దేవుని స్వరం",
      "దరిచేరి నిలిచావంటే",
      "ఈ క్షణమే నీ జయం",
      "కాలం కరిగినా జీవితం",
      "కాలం మరుక్షణం అది ఓ గతం",
      "రేపో మాపని గడపకు",
      "నేడు నాదని తలచకు",
      "ఏ క్షణమేమి జరుగునో",
      "దేవునికే అది తెలియును",
      "నేడే రక్షణ దినమని",
      "నిను పిలిచెను",
      "యవ్వనమెగసిన కెరటం",
      "అది తిరిగి చేరును సంద్రములో",
      "దేవుని కాడిని మోసిన",
      "అది ఆరిన నేలై లోబడదా",
      "మేలుతో నీ హృదయమును",
      "తృప్తి పరచును నీ ప్రియుడు",
      "రాజుల రాజ్యములెదుట",
      "నిను నిలుపును దీవెనగా",
      "పూర్ణ శక్తితో పూర్ణ బలముతో కొత్త పాట పాడు",
      "గుండె నిండుగ యేసు నిండగా ప్రేమ పండుగేగా",
      "ఉత్సహించి పాడుము",
      "ఉల్లసించి వేడుము",
      "నేడే రక్షణ దినమని ప్రకటించుము",
      "జుంటెతేనెల కంటే",
      "అతి మధురం అది దేవుని స్వరం",
      "రుచిచూచి తెలుసుకుంటే",
      "ఈ క్షణమే నీ జయం"
    ],
