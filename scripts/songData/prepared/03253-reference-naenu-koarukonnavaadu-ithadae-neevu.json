  },
  "main_stanza": {
    "telugu": [
      "సంస్తుతింతుము నిన్నే - సౌలును విడచితివి",
      "దావీదును కోరుకొని - దీవించిన యెహోవా"
    ],
    "english": [
      "SMsthuthiMthumu Ninnae - Saulunu Vidachithivi",
      "Dhaaveedhunu Koarukoni - DheeviMchina Yehoavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "యెష్షయి పుత్రులలో - ఎర్రని వాడతడు",
        "నేత్రాలు చక్కనివి - నేర్పరి మాటలలోన"
      ],
      "english": [
        "YeShShyi Puthrulaloa - Errani Vaadathadu",
        "Naethraalu Chakkanivi - Naerpari Maatalaloana"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రత్నవర్ణుడు యేసు - మాటలు దయగలవి",
        "గువ్వలవలె వెలయు - కన్నులు గలవాడేసు"
      ],
      "english": [
        "RathnavarNudu Yaesu - Maatalu Dhayagalavi",
        "Guvvalavale Velayu - Kannulu Galavaadaesu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బెత్లెహేమునందు - ఖ్యాతిగా వాయించి",
        "సొంపగు పాటలు పాడే - సుగుణాల సుందరుడు"
      ],
      "english": [
        "BethlehaemunMdhu - Khyaathigaa VaayiMchi",
        "SoMpagu Paatalu Paadae - SuguNaala SuMdharudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరమగీతము పాడే - పావనుడు మన యేసు",
        "నేర్పరి మాటలలోన - నజరేతు నివాసి"
      ],
      "english": [
        "Paramageethamu Paadae - Paavanudu Mana Yaesu",
        "Naerpari Maatalaloana - Najaraethu Nivaasi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వీరుడగు యౌవనుడు - శూరుడు యుద్ధమున",
        "తల్లిని మించి యెహోవా - తనతోడై యున్నాడు"
      ],
      "english": [
        "Veerudagu Yauvanudu - Shoorudu YudhDhamuna",
        "Thallini MiMchi Yehoavaa - Thanathoadai Yunnaadu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నేను కోరిన దితడే - వాని అన్నలముందు",
        "అభిషేక తైలముతో - అభిషేకించుము వాని"
      ],
      "english": [
        "Naenu Koarina Dhithadae - Vaani AnnalamuMdhu",
        "AbhiShaeka Thailamuthoa - AbhiShaekiMchumu Vaani"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "సంఘవరుడగు క్రీస్తు - సత్యముగ మన శిరస్సు",
        "ఆత్మాభిషిక్తుండై - అలరారుచున్నాడు"
      ],
      "english": [
        "SMghavarudagu Kreesthu - Sathyamuga Mana Shirassu",
        "AathmaabhiShikthuMdai - Alaraaruchunnaadu"
      ]
    }
  ]
}
