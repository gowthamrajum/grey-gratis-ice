{
  "song_name": "JeeviMpachaeyumu Nammi PraarThiMthumu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "జీవింపచేయుము నమ్మి ప్రార్థింతుము",
      "వాక్కు నెరవేరువరకు - కాచియుండెదము"
    ],
    "english": [
      "JeeviMpachaeyumu Nammi PraarThiMthumu",
      "Vaakku Neravaeruvaraku - KaachiyuMdedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వశక్తి యుతుడా - సభకు శిరస్సా",
        "కొఱతయెక్కువాయెను - త్వరగా కృపనిమ్ము"
      ],
      "english": [
        "Sarvashakthi Yuthudaa - Sabhaku Shirassaa",
        "KoRathayekkuvaayenu - Thvaragaa Krupanimmu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రేమతో పిల్చితివి - నన్ను రక్షించితివి",
        "నీ జీవము నాలో వాడెను - నాదేవా దిగుము"
      ],
      "english": [
        "Praemathoa Pilchithivi - Nannu RakShiMchithivi",
        "Nee Jeevamu Naaloa Vaadenu - Naadhaevaa Dhigumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమ చల్లారెనే - ఆత్మ కొఱతచే",
        "శవమువలె నైతిని - నీ చేత నన్నెత్తు"
      ],
      "english": [
        "Praema Challaarenae - Aathma KoRathachae",
        "Shavamuvale Naithini - Nee Chaetha Nanneththu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రార్థన వాంఛయు - వాక్యంబు నాసక్తి",
        "నాలో నూటగా రానిమ్ము - సర్వం సమర్పింతున్"
      ],
      "english": [
        "PraarThana VaaMChayu - VaakyaMbu Naasakthi",
        "Naaloa Nootagaa Raanimmu - SarvaM SamarpiMthun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వైరి చెఱ వీడన్ - పోరుపట్టుదలతో",
        "సల్పి జీవపత్రిక గా - నీచే ప్రకాశింతున్"
      ],
      "english": [
        "Vairi CheRa Veedan - Poarupattudhalathoa",
        "Salpi Jeevapathrika Gaa - Neechae PrakaashiMthun"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆత్మ పెండ్లికుమారా - నీరాక కొరకై",
        "నిర్భయముతో వేచియుండ - నానిద్ర పోగొట్టు"
      ],
      "english": [
        "Aathma PeMdlikumaaraa - Neeraaka Korakai",
        "Nirbhayamuthoa VaechiyuMda - Naanidhra Poagottu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయ పాడను - మరుపులు తొలగును",
        "శుద్ధాత్మను వెదకును - ఎల్లరకున్ చాటన్"
      ],
      "english": [
        "Hallelooya Paadanu - Marupulu Tholagunu",
        "ShudhDhaathmanu Vedhakunu - Ellarakun Chaatan"
      ]
    }
  ]
}
