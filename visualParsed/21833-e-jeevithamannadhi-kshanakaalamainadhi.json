{
  "song_name": "Ee jeevithamannadhi kshanakaalamainadhi",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Praveen VB"
    ],
    "రచన": [
      "ప్రవీణ్ వి బి"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఈ జీవితమన్నది క్షణకాలమైనది పరలోకంలోనిది శాశ్వతమైనది || 2 ||"
    ],
    "english": [
      "Ee jeevithamannadhi kshanakaalamainadhi paralokamlonidhi shaashwathamainadi || 2 ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆస్తులు ఎన్ని ఉన్న అంతస్తులు ఎన్ని ఉన్న",
        "క్రీస్తు లేని ఈ జీవితం ఈ లోకంలో సున్నా || 2  ||ఈ||",
        "గొప్ప ప్రణాళికా నాకై సిద్దము చేసి తల్లి గర్భంలో రూపించావు || 2 ||"
      ],
      "english": [
        "Aasthulu enni unna anthasthulu enni unna",
        "Kreesthu leni ee jeevitham ee lokamlo sunnaa || 2  ||Ee||",
        "Goppa pranaalikaa naakai siddhamu chesi thalli garbhamlo roopinchaavu || 2 ||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సృష్టాంతటిని నీ నోటిమాట ద్వారా చేసావు",
        "పరిశుద్ధమైన చేతులతో నన్ను చెక్కావు || 2 ||",
        "ఈ సృష్టిపై ఉన్న ప్రేమకంటే నాపై ఉన్న || 2 ||",
        "కలువారి సిలువపై ప్రాణం పెట్టి కనుపరిచావయ్యా || 2  ||ఈ||"
      ],
      "english": [
        "Srushtaanthatini nee notimaata dwaaraa chesaavu",
        "Parishuddhamaina chethulatho nannu chekkaavu || 2 ||",
        "Ee srushtipai unna premakante naapai unna || 2 ||",
        "Kalvari siluvapai praanam petti kanuparichaavayyaa || 2  ||Ee||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఉన్నతమైన స్థితిని నాకై నీవు సిద్దము చేసి",
        "నీ వాక్యమును ప్రకటించుటకు నన్ను ఏర్పరిచావు || 2 ||"
      ],
      "english": [
        "Unnathamaina sthithini naakai neevu siddhamu chesi",
        "Nee vaakyamunu prakatinchutaku nannu erparichaavu || 2 ||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తప్పిపోయిన నన్ను నీవు రక్షించుటకై",
        "దీనునిగా ఈ భువిపై నీవు జన్మించావు || 2 ||",
        "ఈ సృష్టిపై ఉన్న ప్రేమకంటే నాపై ఉన్న || 2 ||",
        "కలువారి సిలువపై ప్రాణం పెట్టి కనుపరిచావయ్యా || 2  ||ఈ||"
      ],
      "english": [
        "Thappipoyina nannu neevu rakshinchutakai",
        "Dheenunigaa ee bhuvipai neevu janminchaavu || 2 ||",
        "Ee srushtipai unna premakante naapai unna || 2 ||",
        "Kalvari siluvapai praanam petti kanuparichaavayyaa || 2  ||Ee||"
      ]
    }
  ]
}
