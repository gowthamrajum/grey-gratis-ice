  "main_stanza": {
    "telugu": [
      "నా కష్టకాలములో నాదుఃఖ సమయములో",
      "నావేదన శ్రమల బాధల మధ్యలో \"2\"",
      "నను ఆదరించి నీ ప్రేమను చూపావు",
      "నీ తోడుగా నేనుండగా దిగులెందుకు అన్నావు\"2\"",
      "యేసయ్యా యేసయ్యా నీ ప్రేమే చాలయ్యా",
      "యేసయ్యా యేసయ్యా నీఉంటే చాలయ్యా \"2\"",
      "\"నాకష్టకాలములో\""
    ],
    "english": [
      "Naa kashtakaalamulo naa duhkha samayamulo",
      "Naa vedhana shramala baadhala madhyalo \"2\"",
      "Nanu aadarinchi nee premanu choopaavu",
      "Nee thodugaa nenundagaa digulenduku annaavu\"2\"",
      "Yesayya Yesayya nee preme chaalayya",
      "Yesayya Yesayya nee unte chaalayya \"2\"",
      "\"Naa kashtakaalamulo\""
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా అన్న వారే నను బాధపరచిన",
        "తోడున్న వారే నను త్రోసివేసినా",
        "ఆత్మీయులకు నేను అపార్థమైన",
        "నే నమ్మిన వారే నను మోసము చేసినా \"2\"",
        "నా తల్లిలా నీవుండి నను హత్తుకున్నావు",
        "నినువిడువను ఎడబాయనని వాగ్దానమునిచ్చావు\"2\""
      ],
      "english": [
        "Naa anna vaare nanu baadhaparachina",
        "Thodunna vaare nanu throsivesinaa",
        "Aathmeeyulaku nenu apaarthamaina",
        "Ne nammina vaare nanu mosamu chesinaa \"2\"",
        "Naa thallilaa neevundi nanu hatthukunnaavu",
        "Ninu viduvanu edabaayanani vaagdhaanamunichchaavu\"2\""
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "⁠ ⁠నా స్థితిని చూసి అవమానపరచిన",
        "నీకేమీ లేదని అపహేళన చేసినా",
        "మనుషులంత కలిసి మనసును కలచివేసిన",
        "నిరీక్షణ కరువై నీరాసలో నేనున్నా \"2\"",
        "నా తండ్రిలా నీవుండి నా తల పైకెత్తెదవు",
        "నీవు ఎన్నటికి నన్ను సిగ్గుపరచవు\"2\"",
        "ఊహించ లేని మేలు సాంగ్ లింక్ :",
        "యేసయ్య నాపైన చూపిన నీ ప్రేమ సాంగ్ లింక్:"
      ],
      "english": [
        "Naa sthithini choosi avamaanaparachina",
        "Neekemee ledani apahelana chesinaa",
        "Manushulantha kalisi manasunu kalachivesina",
        "Nireekshana karuvai niraashalo nenunnaa \"2\"",
        "Naa thandrilaa neevundi naa thala paiketthedhavu",
