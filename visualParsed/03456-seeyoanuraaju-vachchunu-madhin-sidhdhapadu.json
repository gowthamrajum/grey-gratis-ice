    ],
    "english": [
      "Seeyonuraaju vachchunu madhin sidhdhapadu",
      "Mee thanuvul shudhdhicheyudi mee raajukorake"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
