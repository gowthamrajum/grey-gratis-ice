{
  "song_name": "Nee Karyamulu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ కార్యములు ఆశ్చర్యములు దేవా",
      "నీవు సెలవియ్యగా – సూన్యము సృష్టిగా మారేనె",
      "నీవు సెలవియ్యగా – మారా మధురం ఆయనె",
      "నీవు సెలవియ్యగా – దురాత్మలు పారిపోయేనె",
      "నీవు సెలవియ్యగా – దరిద్రము తొలగిపోయేనె"
    ],
    "english": [
      "Nee kaaryamulu ascharyamulu deva",
      "neevu selaviyagaa – soonyamu shristiga maarene",
      "neevu selaviyagaa – maaraa madhuramayene",
      "neevu selaviyagaa – dhurathmalu paaripoyene",
      "neevu selaviyagaa – dharidhramu tholagipoyene"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ కార్యముతో",
        "సెలవిమ్మయ్య సెలవిమ్మయ్య – ఈ క్షణమే యేసయ్య"
      ],
      "english": [
        "nee kaaryamutho",
        "selvimmayaa selvimmayaa – ee kshanamey yesayya"
      ]
    }
  ]
}
