  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నడ్పుమా మహా యెహోవా - లోకయాత్ర యందున",
        "నీదు శక్తి నాకు దిక్కు - నన్ రక్షంప జేపట్టు",
        "దివ్యమన్నా దివ్యమన్నా - నా కాహారమై యుండు"
      ],
      "english": [
        "Nadpumaa mahaa Yehova - Lokayaathra yanduna",
        "Needu shakthi naaku dikku - Nan rakshampa jepattu",
        "Dhivyamannaa dhivyamannaa - Naa kaahaaramai yundu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఊటగా స్వచ్ఛజలంబు - బండనుండి పారనీ",
        "అగ్ని మేఘ స్తంభాలచే - నడవిన్ నన్ దాటించు",
        "గొప్ప ప్రాపూ గొప్ప ప్రాపూ - నాకు డాలు నీవే"
      ],
      "english": [
        "Ootagaa svachchhajalambu - Bandanundi paaranee",
        "Agni megha sthambhaalache - Nadavin nan dhaatinchu",
        "Goppa praapoo goppa praapoo - Naaku daalu neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యోర్దాన్ నది దాటువేళ - భీతులెల్ల బాపుము",
        "మృత్యు శ్రమలన్ని నన్ను - క్షేమ కానాన్ జేర్చును",
        "స్తుతిగీతి స్తుతిగీతి - నీ కర్పింతు నిత్యము"
      ],
      "english": [
        "Yordhaan nadi dhaatuvela - Bheethulella baapumu",
        "Mruthyu shramalanni nannu - Kshema Kaanaan jerchunu",
        "Sthuthigeethi sthuthigeethi - Nee karpinthu nithyamu"
      ]
    }
  ]
