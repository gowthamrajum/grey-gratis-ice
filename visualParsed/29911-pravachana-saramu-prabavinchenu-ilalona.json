{
  "song_name": "Pravachana saaramu prabhavinchenu ilalona",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రవచన సారము - ప్రభవించెను ఇలలోన",
      "వాగ్దాన రూపము - వర్ధిల్లెను మన పక్షాన",
      "ఏలీయ పలికిన - యెషయా చాటిన",
      "మెస్సయ్య జన్మించెను - మన విముక్తి మార్గమున ||ప్రవచన||"
    ],
    "english": [
      "Pravachana saaramu - Prabhavinchenu ilalona",
      "Vaagdhaana roopamu - Vardhillenu mana pakshaana",
      "Eleeya palikina - Yeshayaa chaatina",
      "Messayya janminchenu - Mana vimukthi maargamuna ||Pravachana||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యెషయా పలికిన కన్యక గర్భ ఫలము",
        "ఇమ్మానుయేలుగా మనకు తోడైన దైవము",
        "దావీదు సింహాసనపు నిత్య వారసుడు",
        "శాంతికి అధిపతిగా - శరణాగత వత్సలుడు",
        "అంధకార లోకమున - అద్భుత జ్యోతి వెలిగెను",
        "తొట్టిలో పరుండి - తగ్గించుకొనుట నేర్పెను  ||ప్రవచన||"
      ],
      "english": [
        "Yeshayaa palikina kanyaka garbha phalamu",
        "Immaanuyelugaa manaku thodaina daivamu",
        "Daaveedu simhaasanapu nithya vaarasudu",
        "Shaanthiki adhipathigaa - Sharanaagatha vathsaludu",
        "Andhakaara lokamuna - Adbhutha jyothi veligenu",
        "Thottilo parundi - Thagginchukonuta nerpenu ||Pravachana||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మీకా చెప్పిన బేత్లెహేము పురమున",
        "అల్పుడైన అక్షయుడు - అవతరించెను దీనునిగా",
        "గొర్రెపిల్లగా వచ్చి - గురిని మనకు చూపెను",
        "బలియాగపు వేదికకై - బాటను సిద్ధము చేసెను",
        "ఆదికాండపు వాగ్దానము - నేడు నెరవేరెను",
        "సర్పము తల చితుకద్రొక్క - సర్వేశ్వరుడు దిగివచ్చెను  ||ప్రవచన||"
      ],
      "english": [
        "Meekaa cheppina Bethlehemu puramuna",
        "Alpudaina akshayudu - Avatharinchenu dheenunigaa",
        "Gorrepillagaa vachchi - Gurini manaku choopenu",
        "Baliyaagapu vedhikakai - Baatanu siddhamu chesenu",
        "Aadhikaandapu vaagdhaanamu - Nedu neraverenu",
        "Sarpamu thala chithukadhrokka - Sarveshvarudu dhigivachchenu ||Pravachana||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మహిమను వీడి - మట్టి రూపము దాల్చినది",
        "మరణపు లోయలో ఉన్న - మనల వెదకి వచ్చినది",
        "పాపపు బంధాలు తెంపి - శాశ్వత జీవమిచ్చుటకు",
        "నీతి సూర్యుడుగా - నిత్య రాజ్యము చేరుటకు",
        "యేసయ్యా నీ జననమే - మాకు రక్షణ భాగ్యము",
        "చివరికి నీ కృపతో - మమ్మును పరలోకం చేర్చుదువు  ||ప్రవచన||"
      ],
      "english": [
        "Mahimanu veedi - Matti roopamu dhaalchinadhi",
        "Maranapu loyalo unna - Manala vedaki vachchinadhi",
        "Paapapu bandhaalu thempi - Shaashwatha jeevamichchutaku",
        "Neethi sooryudugaa - Nithya raajyamu cherutaku",
        "Yesayyaa nee jananame - Maaku rakshana bhaagyamu",
        "Chivariki nee krupatho - Mammunu paralokam cherchudhuvu ||Pravachana||"
      ]
    }
  ]
}
