    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గగనము చీల్చుకొని యేసు ఘనులను తీసికొని",
      "వేలాది దూతలతో భువికి వేగమె రానుండె"
    ],
    "english": [
      "Gaganamu Cheelchukoni Yaesu Ghanulanu Theesikoni",
      "Vaelaadhi Dhoothalathoa Bhuviki Vaegame Raanunde"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరలోక పెద్దలతో పరివారముతో కదలి",
        "ధరసంఘ వధువునకై తరలెను వరుడదిగో"
      ],
      "english": [
        "Paraloaka Pedhdhalathoa Parivaaramuthoa Kadhali",
        "Dharasangha Vadhuvunakai Tharalenu Varudadhigoa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మొదటగను గొఱ్ఱెగను ముదమారగ వచ్చెను",
        "కొదమసింహపురీతి కదలెను గర్జనతో"
      ],
      "english": [
        "Modhataganu Gorreganu Mudhamaaraga Vachchenu",
        "Kodhamasimhapureethi Kadhalenu Garjanathoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కనిపెట్టు భక్తాళీ కనురెప్పలో మారెదరు",
        "ప్రథమమున లేచెదరు పరిశుద్ధులు మృతులు"
      ],
      "english": [
        "Kanipettu Bhakthaalee Kanureppaloa Maaredharu",
        "Prathamamuna Laechedharu Parishudhdhulu Mruthulu"
      ]
    }
  ]
}
