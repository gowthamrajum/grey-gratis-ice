      ],
      "english": [
        "Mandhabudhdhi Chaetha Ninnu Marachi Yuntimi",
        "Sundharaaptha Needhaya Maa Yandhu Joopumaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "చదువు వేదవాక్య సరణి నడువ నేర్పుమీ",
