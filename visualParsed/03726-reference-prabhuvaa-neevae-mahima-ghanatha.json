      ],
      "english": [
        "Santhasamuna doothalu samsthuthinchagaa",
        "Paadi mokshamandhuna modhamondhedhan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శత్రువునకు వెరువనేల సోదరులారా",
        "దైవపుత్రులారా నిద్ర లేచి పాడుడి"
      ],
      "english": [
        "Shathruvunaku veruvanela sodharulaaraa",
        "Dhaivaputhrulaaraa nidra lechi paadudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యేసురాక వార్త మ్రోగె భాసురంబుగా",
        "వచ్చుచున్నాడేసు సంఘ వధువు కొరకు"
      ],
      "english": [
        "Yesuraaka vaartha mroge bhaasurambugaa",
        "Vachchuchunnaadesu sangha vadhuvu koraku"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "తెల్లవస్త్రములు లేక వెళ్ళజాలవు",
        "రక్తములో కడుగుము వస్త్రములను"
