{
  "song_name": "Devuni sannidhilo sampoorna santhosham",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "దేవుని సన్నిధిలో సంపూర్ణ సంతోషం",
      "ఆ శిలువ నీడలో సంపూర్ణ క్షేమము",
      "నా యేసులో దొరుకునులే నిత్యాజీవము",
      "నా క్రీస్తులో దొరుకునులే నిత్యానందము"
    ],
    "english": [
      "Devuni sannidhilo sampoorna santhosham",
      "Aa shiluva needalo sampoorna kshemamu",
      "Naa Yesulo dhorukunule nithyaajeevamu",
      "Naa Kreesthulo dhorukunule nithyaanandamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రాజులను అధికారులను నమ్ముకొనుటకంటే",
        "నా యేసుని నమ్ముటలో నా జీవిత ధన్యకరం",
        "నా యేసు సన్నిధి అదే నాకు పెన్నిధి",
        "తోడుగా నీడగా నను నడిపించునులే",
        "జీవము జీవకీరీటము నా యేసులో దొరుకునులే"
      ],
      "english": [
        "Raajulanu adhikaarulanu nammukonutakante",
        "Naa Yesuni nammutalo naa jeevitha dhanyakaram",
        "Naa Yesu sannidhi adhe naaku pennidhi",
        "Thodugaa needagaa nanu nadipinchunule",
        "Jeevamu jeevakeereetamu naa Yesulo dhorukunule"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కునుకడు నిద్రపోడు నా దేవుడు ఎన్నడు",
        "కంటికి రెప్పవలే ననుకాచి కాపాడును",
        "కరువైన కారు చీకటైనా భయమికలేదులే",
        "కరుణించి తన కృప చూపి నను నడిపించును"
      ],
      "english": [
        "Kunukadu nidhrapodu naa Devudu ennadu",
        "Kantiki reppavale nanukaachi kaapaadunu",
        "Karuvaina kaaru cheekatainaa bhayamikaledhule",
        "Karuninchi thana krupa choopi nanu nadipinchunu"
      ]
    }
  ]
}
