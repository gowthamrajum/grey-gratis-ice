    {
      "stanza_number": 4,
      "telugu": [
        "భక్తులెల్లరు సిద్ధపడి సిద్ధపడి సిద్ధపడి",
        "భక్తులెల్లరు సిద్ధపడి కాచియుందురు"
      ],
      "english": [
        "Bhakthulellaru Sidhdhapadi Sidhdhapadi Sidhdhapadi",
        "Bhakthulellaru Sidhdhapadi Kaachiyumdhuru"
      ]
