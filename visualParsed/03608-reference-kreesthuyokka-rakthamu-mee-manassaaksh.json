{
  "song_name": "O Prabhuvaa ne daari tholagithi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఓ ప్రభువా నే దారి తొలగితి",
      "నీ శరణు జొచ్చితిని - నీ ప్రేమను పొందితిని"
    ],
    "english": [
      "O Prabhuvaa ne daari tholagithi",
      "Nee sharanu jochchithini - Nee premanu pondithini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా పాపముల నే నొప్పుకొని",
        "పశ్చాత్తాప పడితిని - పాపక్షమాపణ కలిగె"
      ],
      "english": [
        "Naa paapamula ne noppukoni",
        "Pashchaaththaapa padithini - Paapakshamaapana kalige"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభుయేసు నీ రక్తము ద్వార",
        "ప్రాయశ్చిత్తము జేసితివి - కడుగ బడితిని నేను"
      ],
      "english": [
        "Prabhuyesu nee rakthamu dhvaara",
        "Praayashchiththamu jesithivi - Kaduga badithini nenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీ రక్తముతో నామది కడిగి",
        "పాపఋణము తీర్చితివి - స్వతంత్రుని జేసితివి"
      ],
      "english": [
        "Nee rakthamutho naamadhi kadigi",
        "Paaparunamu theerchithivi - Svathanthruni jesithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీ రక్తముచే పాపము తొలగె",
        "రక్షణ నే పొందితిని - పాపడాగులను తుడిచె"
      ],
      "english": [
        "Nee rakthamuche paapamu tholage",
        "Rakshana ne pondithini - Paapadaagulanu thudiche"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ రక్తముచే నా శిక్ష తొలగె",
        "బంధకముల తెంచితివి - నిర్దోషిగా తీర్చితివి"
      ],
      "english": [
        "Nee rakthamuche naa shiksha tholage",
        "Bandhakamula thenchithivi - Nirdhoshigaa theerchithivi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీరక్తముచే సహవాసమును",
        "పరిపూర్ణత నొందుటకు - నను విజయుని జేసితివి"
      ],
      "english": [
        "Neerakthamuche sahavaasamunu",
        "Paripoornatha nondhutaku - Nanu vijayuni jesithivi"
      ]
    }
  ]
}
