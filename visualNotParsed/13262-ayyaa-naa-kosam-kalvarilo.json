      "Siluvanu mosithivaa",
      "Ayyaa vandanamayyaa",
      "Yesu vandanamayyaa (2) ||Ayyaa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పడిపోయి ఉన్న వేళలో",
        "నా చేయి పట్టి లేపుటకు",
