        "Praarthana sahavaasamulalo - Sthirulajeyumu",
        "Theri choosthoo nee raakadakai - Sthuthula narpinthumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "శత్రుటురులు త్రుంచివేసి - జీవమిచ్చితివి",
        "ఆహా! యేమర్పింతుము - నీ ఉపకారములకై",
        "చేతబట్టి రక్షణపాత్ర - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Shathru urulu thrunchivesi - Jeevamichchithivi",
        "Aahaa! Emarpinthumu - Nee upakaaramulakai",
        "Chethabatti rakshanapaathra - Sthuthula narpinthumu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "గతబ్రతుకులో వాత్సల్యమున - గాచి యీ క్షితిన్",
        "నడిపె నవ్యవత్సరముకై - కృపాక్షేమములతో",
        "సత్యుడ సిల్వశక్తి నొసగు - సాగముందుకు"
      ],
      "english": [
        "Gathabrathukulo vaathsalyamuna - Gaachi ee kshithin",
        "Nadipe navyavathsaramukai - Krupaakshemamulatho",
        "Sathyuda silvashakthi nosagu - Saagamundhuku"
      ]
    }
  ]
