{
  "song_name": "Mahaganudavu Mahonnathudavu",
  "author": {
    "Authored by": "Bro. Yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మహాఘనుడవు మహోన్నతుడవు",
      "పరిశుద్ధ స్థలములోనే నివసించువాడవు",
      "కృపాసత్యసంపూర్ణమై మా మధ్యలో",
      "నివసించుట న్యాయమా",
      "నను పరిశుద్ధ పరచుటే నీ ధర్మమా"
    ],
    "english": [
      "Mahaghanudavu mahonnathudavu",
      "parishuddha sthalamulone nivasinchuvaadavu",
      "krupaa satya sampoornamai maa madhyalo",
      "nivasinchuta nyaayamaa",
      "nanu parishuddha parachutey nee dharmamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హల్లెలుయా స్తోత్రమయా",
        "హల్లెలుయా యేసయ్య నీకే స్తోత్రమయా"
      ],
      "english": [
        "Hallelujah sthothramayaa",
        "Hallelujah yesayya neeke sthothramayaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ చేతితోనే నను లేపినావు",
        "నీ చేతిలోనే నన్ను చెక్కుకొంటివి",
        "నీ చేతినీడలో నన్ను దాచుకొంటివి"
      ],
      "english": [
        "Nee chethithoney nanu lepinaavu",
        "nee chethiloney nannu chekkukontivi",
        "nee chethineedalo nannu daachukontivi"
      ]
    }
  ]
}
