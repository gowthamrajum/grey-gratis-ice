  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చీకటి కాలము వచ్చుచుండె - కృపకాలము నుపయోగించు",
        "తలుపులు తెరచియుండగనే - విరిగిన మనస్సుతో సాగెదవా?",
        "తలుపులు తెరచియుండగనే - విరిగిన మనస్సుతో సాగెదవా?",
        "కాలమపాయముగా నుండె - సమయము సద్వినియోగించు"
      ],
      "english": [
        "Cheekati kaalamu vachchuchunde - Krupakaalamu nupayoginchu",
        "Thalupulu therachiyundagane - Virigina manassutho saagedhavaa?",
        "Thalupulu therachiyundagane - Virigina manassutho saagedhavaa?",
        "Kaalamapaayamugaa nunde - Samayamu sadhviniyoginchu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "బీడుభూములధికముగా - చూచిన నీవు సాగిరా",
        "యేసుని వారికి చూపించు - ప్రేమా వార్తను చాటించు"
      ],
      "english": [
        "Beedubhoomuladhikamugaa - Choochina neevu saagiraa",
        "Yesuni vaariki choopinchu - Premaa vaarthanu chaatinchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎన్నో రాజ్యము లీనాడు - దేవుని పనికి మూయబడె",
        "తెరచిన తలుపులు యెదురుండన్ - ప్రవేశింతురు జ్ఞానులు"
      ],
      "english": [
        "Enno raajyamu leenaadu - Devuni paniki mooyabade",
        "Therachina thalupulu edhurundan - Praveshinthuru gnaanulu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విశ్వాసుల సహవాసమున - ప్రేమా ఐక్యతగలదు",
        "అని చెప్పెడి దినములు - మన మధ్యకు రావలెను"
      ],
      "english": [
        "Vishvaasula sahavaasamuna - Premaa aikyathagaladhu",
        "Ani cheppedi dinamulu - Mana madhyaku raavalenu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రానై యున్న భాధ్యతలు - మనకధికము ప్రియులారా",
        "మనకు జయము కలుగుటకై - వినమున పోరాడెదము"
      ],
      "english": [
        "Raanai yunna baadhyathalu - Manakadhikamu priyulaaraa",
        "Manaku jayamu kaluguthakai - Vinayamuna poraadedhamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "మాదు హృదయముల నింపు - నీదు ప్రేమతో మా ప్రభువా",
        "హిందూ దేశపు వీధులలో - నాథా నిన్నే చాటెదము"
      ],
      "english": [
        "Maadu hrudhayamula nimpu - Needu prematho maa Prabhuvaa",
        "Hindhoo deshapu veedhulalo - Naathaa ninne chaatedhamu"
      ]
    }
  ]
