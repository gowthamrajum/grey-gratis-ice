      ],
      "english": [
        "Janulu aninappudu santhoshinchithini",
        "Yehova mandhiramunaku nadichedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెరూషలేము నగరు నీ గుమ్మములలో",
        "మా పాదములు బాగుగా నిలుచుచున్నవి"
      ],
      "english": [
        "Yerooshalemu nagaru nee gummamulalo",
        "Maa paadamulu baagugaa niluchuchunnavi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యెరూషలేమా బాగుగా కట్టబడిన",
        "పట్టణమువలె కట్టబడియున్నావు"
      ],
      "english": [
