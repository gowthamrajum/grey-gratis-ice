  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓహో! యెరూషలేమా - బంగారు పట్నమా",
        "నీయందు దృష్టి క్షేమ - మింపార నుండుగా",
        "ఆ కాంతి సంబరమ్ము - ఏ కన్ను కాంచెను",
        "జీవంపు భోజనము నీలోను తిందుము"
      ],
      "english": [
        "Oho! Yerooshalemaa - Bangaaru patnamaa",
        "Neeyandu drushti kshema - Mimpaara nundugaa",
        "Aa kaanthi sambarammu - E kannu kaanchenu",
        "Jeevampu bhojanamu neelonu thindhumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సీయోను కొండపైన దూతాళి భక్తులు",
        "ఆ రక్త సాక్షులైన - వారెల్ల బాడుచు",
        "ఆ నిత్య కాంతిలోను - మహా ముదంబుతో",
        "శ్రీ యేసు క్రీస్తుతోను - సదా సుఖింతురహో"
      ],
      "english": [
        "Seeyonu kondapaina doothaali bhakthulu",
        "Aa raktha saakshulaina - Vaarella baaduchu",
        "Aa nithya kaanthilonu - Mahaa mudhambutho",
        "Shree Yesu Kreesthuthonu - Sadaa sukhinthuraho"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "విముక్తులైనవారు - శ్రీ యేసుతోడున",
        "జయంబు గొన్నవారు - నిత్యంబు నందున",
        "శ్రీ యేసు గద్దెచుట్టి - తెల్లంగి ధారులై",
        "కీర్తించి కేలుతట్టి - హర్షింతు నిత్యులై"
      ],
      "english": [
        "Vimukthulainavaaru - Shree Yesuthoduna",
        "Jayambu gonnavaaru - Nithyambu nanduna",
        "Shree Yesu gaddechutti - Thellangi dhaarulai",
        "Keerthinchi kelutatti - Harshinthu nithyulai"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఓ దివ్య పట్టణంబ విశ్రాంతి స్థానమా",
        "భక్తాళి వాంఛితంబ - ఆశింతు నిన్ సదా",
        "ఓ యేసు నన్నుగూడ - అచ్చోట జేర్చుము",
        "ఆ భాగ్యమేను జూడ - స్తోత్రింతు నెన్నడు"
      ],
      "english": [
        "O divya pattanamba vishraanthi sthaanamaa",
        "Bhakthaali vaanchhithamba - Aashinthu nin sadaa",
        "O Yesu nannugooda - Achchota jerchumu",
        "Aa bhaagyamenu jooda - Sthothrinthu nennadu"
      ]
    }
  ]
}
