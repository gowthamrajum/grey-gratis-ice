{
  "song_name": "Aathmaparishuddhaathmudaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆత్మపరిశుద్దాత్ముడా - నాలో నివసించుము",
      "జీవింపజేసే సత్యస్వరూపుడా - నితో నడించుము",
      "నా ప్రాణ ఆత్మ శరీరమును",
      "యేసయ్య రాకకై సిద్దపరచుము"
    ],
    "english": [
      "Aathmaparishuddhaathmudaa - Naalo nivasinchumu",
      "Jeevimpajese sathyasvaroopudaa - Neetho nadinchumu",
      "Naa praana aathma shareeramunu",
      "Yesayya raakakai siddhaparachumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిర్జీవమైన నా జీవితములో - నిరీక్షణ కలిగించితివి",
        "లెక్కింపశక్యముగాని - సైన్యములో నను నిలిపితివి",
        "నాలో నివసించుము - నీతో నడిపించుము"
      ],
      "english": [
        "Nirjeevamaina naa jeevithamulo - Nireekshana kaliginchithivi",
        "Lekkimpashakyamugaani - Sainyamulo nanu nilipithivi",
        "Naalo nivasinchumu - Neetho nadipinchumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పెంతుకొస్తు దినమందున - బలముగ దిగివచ్చితివి",
        "అన్యభాషలు మాట్లాదుతకు - వాక్ శక్తి నొసగితివి",
        "నాలో నివసించుము - నీతో నడిపించుము"
      ],
      "english": [
        "Penthekosthu dinamanduna - Balamuga dhigivachchithivi",
        "Anyabhaashalu maatlaadutaku - Vaak shakthi nosagithivi",
        "Naalo nivasinchumu - Neetho nadipinchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రియునికి కలిగిన సంపూర్ణతలు - నా యందు ఏర్పరుచుటకే",
        "ఆరొగ్యకరమైన ఉపదేసములో - కృపతో స్దిరపరచితివి",
        "నాలో నివసించుము - నీతో నడిపించుము"
      ],
      "english": [
        "Priyuniki kaligina sampoornathalu - Naa yandu erparuchutake",
        "Aarogyakaramaina upadheshamulo - Krupatho sthiraparachithivi",
        "Naalo nivasinchumu - Neetho nadipinchumu"
      ]
    }
  ]
}
