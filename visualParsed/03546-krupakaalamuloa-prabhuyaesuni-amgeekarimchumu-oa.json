{
  "song_name": "Krupakaalamulo Prabhuyesuni angeekarinchumu o priyudaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "6:2",
      "కృపకాలములో - ప్రభుయేసుని",
      "అంగీకరించుము - ఓ ప్రియుడా"
    ],
    "english": [
      "6:2",
      "Krupakaalamulo - Prabhuyesuni",
      "Angeekarinchumu - O priyudaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వలోకము సంపాదించి నీ ఆత్మను కోల్పోయిన",
        "మిత్రుడా నీ కేమి లాభముండును (2) ఈ లాటి జీవముతో",
        "యేసుని ప్రేమ స్వరము విని - తెరువు నీ హృదయము",
        "ప్రభు యేసుని ల్ చేరి అనంత ముక్తి పొందు"
      ],
      "english": [
        "Sarvalokamu sampaadhinchi nee aathmanu kolpoyina",
        "Mithrudaa nee kemi laabhamundunu (2) ee laati jeevamutho",
        "Yesuni prema swaramu vini - Theruvu nee hrudayamu",
        "Prabhu Yesunin cheri anantha mukthi pondu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ధర్మ కర్మ సంస్కారమువలన పరిశుద్ధుడవు కానేరవు",
        "భక్తి వేషాలు ధరించుకొన్న (2) పరలోకము చేరవు",
        "కాగా మిత్రుడా నీ పాపములను ఒప్పుకొను యేసు నొద్ద",
        "మహాప్రభుని ల్ చేరి అర్పించుకో నిన్నే"
      ],
      "english": [
        "Dharma karma samskaaramuvalana parishuddhudavu kaaneravu",
        "Bhakthi veshaalu dharinchukonna (2) paralokamu cheravu",
        "Kaagaa mithrudaa nee paapamulanu oppukonu Yesu nodda",
        "Mahaaprabhunin cheri arpinchuko ninne"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభుయేసుక్రీస్తు నిత్యరక్షణకు ఏకైక మార్గం గ్రహించుకో",
        "పాపమార్గం వదలి పశ్చాత్తాపముతో (2) ప్రభుశరణము చేరి",
        "నీ పాపములను ప్రభురక్తమందు కడిగి శుద్ధిచేసుకో",
        "పరలోక ఆశీర్వాదములు నిత్య జీవము పొందు"
      ],
      "english": [
        "Prabhuyesukreesthu nithyarakshanaku ekaika maargam grahinchuko",
        "Paapamaargam vadhali paschaaththaapamutho (2) prabhusharanamu cheri",
        "Nee paapamulanu prabhurakthamandhu kadigi shudhdhichesuko",
        "Paraloka aasheervaadhamulu nithya jeevamu pondu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తులో పూర్ణ నిత్యజీవం పరలోక ఆశీర్వాదములు",
        "ఓ మరణమా నీ ముల్లెక్కడ (2) క్రీస్తునందు విజయమే",
        "శిక్ష దండన తొలగింపబడె ప్రభుయేసు క్రీస్తునందే",
        "ప్రభు శక్తిచే పాతాళ ద్వారం సదా ఓడింపబడె"
      ],
      "english": [
        "Kreesthulo poorna nithyajeevam paraloka aasheervaadhamulu",
        "O maranamaa nee mullekkada (2) Kreesthunandu vijayame",
        "Shiksha dandana tholaginpabade Prabhuyesu Kreesthunandhe",
        "Prabhu shakthiche paathaala dwaaram sadaa odinpabade"
      ]
    }
  ]
}
