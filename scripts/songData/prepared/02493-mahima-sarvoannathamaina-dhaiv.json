{
  "song_name": "Mahima Sarvoannathamaina Dhaivamunaki",
  "author": {
    "Authored by": "",
    "రచన": "బేతాళ జాన్"
  },
  "main_stanza": {
    "telugu": [
      "మహిమ సర్వోన్నతమైన దైవమునకి మ్మహి సమాధానానుగ్రహము గల్గున్ర్పభో"
    ],
    "english": [
      "Mahima Sarvoannathamaina Dhaivamunaki Mmahi Samaadhaanaanugrahamu Galgunrpabhoa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిన్ను స్తోత్రించుచు నిన్ను బూజించుచు",
        "నిన్ను మహిమపర్చుచున్నాము లోక ప్రభో"
      ],
      "english": [
        "Ninnu Sthoathrinchuchu Ninnu Boojinchuchu",
        "Ninnu Mahimaparchuchunnaamu Loaka Prabhoa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభువైన దేవుండా పరమండలపు రాజా",
        "ప్రబలంబు గల తండ్రి పరిశుద్ధంబగు ప్రభో"
      ],
      "english": [
        "Prabhuvaina Dhaevundaa Paramandalapu Raajaa",
        "Prabalambu Gala Thandri Parishudhdhambagu Prabhoa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వినయంబుతో నీదు ఘన మహిమార్థంబై",
        "వందనములర్పించి వినుతింతుము సత్ర్వభో"
      ],
      "english": [
        "Vinayambuthoa Needhu Ghana Mahimaarthambai",
        "Vandhanamularpinchi Vinuthinthumu Sathrvabhoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "జనితైక పుత్రుడగు ఘన క్రీస్తేసు ప్రభు",
        "దేవుని గొర్రెపిల్ల జనకుని కుమారుడ ప్రభో"
      ],
      "english": [
        "Janithaika Puthrudagu Ghana Kreesthaesu Prabhu",
        "Dhaevuni Gorrepilla Janakuni Kumaaruda Prabhoa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ధర పాపములమోయు వరపుణ్య శీలుండా",
        "కరుణించి మా బీద మొరలాలించుము ప్రభో"
      ],
      "english": [
        "Dhara Paapamulamoayu Varapunya Sheelundaa",
        "Karuninchi Maa Beedha Moralaalinchumu Prabhoa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "తండ్రియైన దేవుని దక్షిణ్ భాగమున",
        "గూర్చుండి యున్నావు కృపజూపుమి సత్ర్పభో"
      ],
      "english": [
        "Thandriyaina Dhaevuni Dhakshin Bhaagamuna",
        "Goorchundi Yunnaavu Krupajoopumi Sathrpabhoa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పరిశుద్ధుడవు నీవే పరమ ప్రభుడవు నీవే",
        "దురితాత్ములను గాన మరణంబైతివి ప్రభో"
      ],
      "english": [
        "Parishudhdhudavu Neevae Parama Prabhudavu Neevae",
        "Dhurithaathmulanu Gaana Maranambaithivi Prabhoa"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "పరమ జనకుని మహిమన్ పరిశుద్దాత్మైక్యంబై",
        "సరణి మాకై యున్న సర్వోన్నత ప్రభో"
      ],
      "english": [
        "Parama Janakuni Mahiman Parishudhdhaathmaikyambai",
        "Sarani Maakai Yunna Sarvoannatha Prabhoa"
      ]
    }
  ]
}
