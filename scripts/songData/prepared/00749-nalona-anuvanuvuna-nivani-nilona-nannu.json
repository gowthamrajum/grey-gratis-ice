{
  "song_name": "Nalona Anuvanuvuna Nivani",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నాలోన అణువణువున నీవని",
      "నీలోన నన్ను దాచినది శాశ్వతమైన కృపయేనని",
      "యేసయ్యా నీ అపురూపమైన ప్రతిరూపమునై ఆరాదించెదను"
    ],
    "english": [
      "Nalona Anuvanuvuna Nivani",
      "Nilona Nannu Dachinadi Sasvatamaina Krupayenani",
      "Yesayya Ni Apurupamaina Pratirupamunai Aradimchedanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అరుణోదయ దర్శనమిచ్చి ఆవేదనలు తొలగించితివి",
        "అమృతజల్లులు కురిపించించే - అనందగానాలు పాడుచునే",
        "కలిగియుందునే - నీ దైవత్వమే"
      ],
      "english": [
        "Arunodaya Darsanamichchi Avedanalu Tolagimchitivi",
        "Amrutajallulu Kuripimchimche - Anamdaganalu Paduchune",
        "Kaligiyumdune - Ni Daivatvame"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఇమ్మానుయేలుగా తొడైయుండి ఇంపైన నైవెద్యముగ మర్చితివే",
        "ఈ పరిచర్యలో నేను - వాగ్దానఫలములు పొందుకుని",
        "ధరించుకుందునే - నీ దీనత్వమే"
      ],
      "english": [
        "Immanuyeluga Todaiyumdi Impaina Naivedyamuga Marchitive",
        "I Paricharyalo Nenu - Vagdanapalamulu Pomdukuni",
        "Dharimchukumdune - Ni Dinatvame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వివేక హృదయము - అనుగ్రహించి విజయపధములో నడిపించెదవు",
        "వినయభయభక్తితో నేను - నిశ్చల రాజ్యము పొందుటకు",
        "స్మరించుకుందునే - నీ ఆమరత్వమే"
      ],
      "english": [
        "Viveka Hrudayamu - Anugrahimchi Vijayapadhamulo Nadipimchedavu",
        "Vinayabayabaktito Nenu - Nischala Rajyamu Pomdutaku",
        "Smarimchukumdune - Ni Amaratvame"
      ]
    }
  ]
}
