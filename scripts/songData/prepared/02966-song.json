{
  "song_name": "Shraeshtudellavaariloanu Maa Yaesuvae",
  "author": {
    "Authored by": "",
    "రచన": "జాన్ న్యూటన్"
  },
  "main_stanza": {
    "telugu": [
      "శ్రేష్ఠుఁడెల్లవారిలోను మా యేసువే",
      "తల్లికంటె ప్రియుడౌను మా యేసువే",
      "లోకస్నే హమస్థిరంబు నేఁడు ప్రేమరేపు కక్ష",
      "స్థిరుడైన మిత్రుడౌను మా యేసువే."
    ],
    "english": [
      "Shraeshtudellavaariloanu Maa Yaesuvae",
      "Thallikante Priyudaunu Maa Yaesuvae",
      "Loakasnae Hamasthirambu Naedu Praemaraepu Kaksha",
      "Sthirudaina Mithrudaunu Maa Yaesuvae."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాకు నిత్యజీవమౌను మా యేసువే",
        "సర్వమందు సర్వమౌను మా యేసువే",
        "నన్ను మేలుకొల్పి ప్రోచి శుద్ధిచేసి ప్రేమతోడ",
        "నన్ను తన మందఁజేర్చె మా యేసువే."
      ],
      "english": [
        "Naaku Nithyajeevamaunu Maa Yaesuvae",
        "Sarvamandhu Sarvamaunu Maa Yaesuvae",
        "Nannu Maelukolpi Proachi Shuddhichaesi Praemathoada",
        "Nannu Thana Mandhajaerche Maa Yaesuvae."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రేమమూర్తి సత్యవర్తి మా యేసువే",
        "ఇహపరభాగ్యమిచ్చు మా యేసువే",
        "క్రీస్తుకిమ్ము నీదుయాత్మ నీకు శాంతినిచ్చి",
        "కాచి తుదిఁజేర్చు మోక్షమందు మా యేసువే."
      ],
      "english": [
        "Praemamoorthi Sathyavarthi Maa Yaesuvae",
        "Ihaparabhaagyamichchu Maa Yaesuvae",
        "Kreesthukimmu Needhuyaathma Neeku Shaanthinichchi",
        "Kaachi Thudhijaerchu Moakshamandhu Maa Yaesuvae."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "బాధనొందు మేము చేర మా యేసువా!",
        "మాకు హర్ష మిచ్చినావు మా యేసువా!",
        "ఇహమందు నడిపించు అవసానకాలమందు",
        "మోక్షసౌఖ్య మొందనిమ్ము మా యేసువా!"
      ],
      "english": [
        "Baadhanondhu Maemu Chaera Maa Yaesuvaa!",
        "Maaku Harsha Michchinaavu Maa Yaesuvaa!",
        "Ihamandhu Nadipinchu Avasaanakaalamandhu",
        "Moakshasaukhya Mondhanimmu Maa Yaesuvaa!"
      ]
    }
  ]
}
