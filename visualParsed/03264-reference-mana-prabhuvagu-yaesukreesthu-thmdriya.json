{
  "song_name": "Parama pavithra svargapitha",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పరమ పవిత్ర స్వర్గపిత - జై ప్రభు జై ప్రభు - సర్వ సదా",
      "యుగయుగములకు - రక్షకుడా - మమ్ములను రక్షించితివి",
      "జీవుండ ప్రభు పాపుల రక్షకా - జై ప్రభు"
    ],
    "english": [
      "Parama pavithra svargapitha - Jai Prabhu jai Prabhu - Sarva sadaa",
      "Yugayugamulaku - Rakshakudaa - Mammulanu rakshinchithivi",
      "Jeevunda Prabhu paapula rakshakaa - Jai Prabhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమరూపి నీవే - నన్ను ప్రేమించితివి",
        "శ్రమలను పొందితివి - నీ ప్రేమ మూలమున"
      ],
      "english": [
        "Premaroopi neeve - Nannu preminchithivi",
        "Shramalanu pondhithivi - Nee prema moolamuna"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రాణమిడి సిలువన్ - నన్ను రక్షించితివి",
        "పాపము తీసితివి - నీ కౄప ఉన్నతము"
      ],
      "english": [
        "Praanamidi siluvan - Nannu rakshinchithivi",
        "Paapamu theesithivi - Nee krupa unnathamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శత్రు సైతానున్ - ఓడించితివీవు",
        "నీ మరణము వలన - విమోచించితివి"
      ],
      "english": [
        "Shathru saithaanun - Odinchithiveevu",
        "Nee maranamu valana - Vimochinchithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శక్తిగలవాడా - చావున్ గెల్చితివి",
        "శక్తితో లేచితివి - తండ్రితో కలిపితివి"
      ],
      "english": [
        "Shakthigalavaadaa - Chaavun gelchithivi",
        "Shakthitho lechithivi - Thandritho kalipithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమగల ప్రభువా - మరల వచ్చెదవు",
        "శ్రమలను తొలగించి - నను చేర్చుకొందువు"
      ],
      "english": [
        "Premagala Prabhuvaa - Marala vachchedavu",
        "Shramalanu tholaginchi - Nanu cherchukondhuvu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రవాహములోన - ప్రభు నేనుండినను",
        "నిన్ను బట్టి నే - క్షేమముగా నుందున్"
      ],
      "english": [
        "Pravaahamulona - Prabhu nenundinanu",
        "Ninnu batti ne - Kshemamugaa nundhun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "జై జై యని పాడుడి - యేసునకే మహిమ",
        "జై జై హల్లెలూయా - జై జై హల్లెలూయా"
      ],
      "english": [
        "Jai jai yani paadudi - Yesunake mahima",
        "Jai jai hallelooyaa - Jai jai hallelooyaa"
      ]
    }
  ]
}
