{
  "song_name": "Devuni Seeyon puramaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "జాన్ న్యూటన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "దేవుని సీయోన్ పురమా!",
      "శ్రేష్టమౌ పట్టణమా!",
      "స్థావరంబైన పురమా!",
      "దేవుని నివాసమా!",
      "యుగముల శిలయైన",
      "దేవుడే నీ పునాదీ!",
      "శత్రువు జయించలేని",
      "రక్షణ నీ దుర్గము."
    ],
    "english": [
      "Devuni Seeyon puramaa!",
      "shreshtamau pattanamaa!",
      "sthaavarambaina puramaa!",
      "Devuni nivaasamaa!",
      "Yugamula shilayaina",
      "Devude nee punaadhee!",
      "shathruvu jayinchaleni",
      "rakshana nee durgamu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "కాంచుమా సజీవధారల్",
        "శాశ్వత ప్రేమధారల్",
        "నీదు పుత్రికా పుత్రులన్",
        "తృప్తిపర్చు ధారలన్",
        "అలసి సొలయకుండ",
        "దాహమున్ దీర్చుధార",
        "దాతయౌ దేవుని కృప",
        "సర్వకాలంబు పారున్"
      ],
      "english": [
        "Kaanchumaa sajeevadhaaral",
        "shaashwatha premadhaaral",
        "needu puthrikaa puthrulan",
        "thrupthiparchu dhaaralan",
        "Alasi solayakunda",
        "dhaahamun dheerchudhaara",
        "dhaathayau Devuni krupa",
        "sarvakaalambu paarun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కాంచుమా నీ యిండ్లమీద",
        "అగ్ని మేఘంబుల్దిగె",
        "ప్రభుని రాక సమయం",
        "బని మహిమ దెల్ప!",
        "ప్రార్థన ఫలంబులిచ్చి",
        "మన్నా నిచ్చిన ప్రభు",
        "సింహాసనాసీనుడై సు",
        "నాదుస్తోత్రంబుల్ వినెన్"
      ],
      "english": [
        "Kaanchumaa nee indlameedha",
        "agni meghambuldige",
        "prabhuni raaka samayam",
        "bani mahima dhelpa!",
        "Praarthana phalambulichchi",
        "mannaa nichchina Prabhu",
        "simhaasanaaseenudai su",
        "naadhusthothrambul vinen"
      ]
    }
  ]
