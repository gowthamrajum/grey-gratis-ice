{
  "song_name": "Kreesthu Yaesu Vachchunu Aayaththamuga Numdudi",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తు యేసు వచ్చును ఆయత్తముగ నుండుడి",
      "అను సూచనలు చూపుచున్నవి - వేచియుండుడి ఆయనకై"
    ],
    "english": [
      "Kreesthu Yaesu Vachchunu Aayaththamuga Numdudi",
      "Anu Soochanalu Choopuchunnavi - Vaechiyumdudi Aayanakai"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్షణ సంపూర్తిచేయుటకై - అక్షయుడేసు వచ్చును",
        "అక్షణ పొందిన వారెల్లరు - తక్షణమే ఎత్తబడెదరు"
      ],
      "english": [
        "Rakshana Sampoorthichaeyutakai - Akshayudaesu Vachchunu",
        "Akshana Pomdhina Vaarellaru - Thakshanamae Eththabadedharu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధులందు మహిమ నొంద - పరమ యేసు వచ్చును",
        "పరిశుద్ధులు వింతపడునట్లు - అరయునేసు వేగమే"
      ],
      "english": [
        "Parishudhdhulamdhu Mahima Nomdha - Parama Yaesu Vachchunu",
        "Parishudhdhulu Vimthapadunatlu - Arayunaesu Vaegamae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మరుగైనవి బయలు పరచ - వరుడు యేసు వచ్చును",
        "హృదయ ఆలోచనలెల్ల - సదయుడు బయలుపరచును"
      ],
      "english": [
        "Marugainavi Bayalu Paracha - Varudu Yaesu Vachchunu",
        "Hrudhaya Aaloachanalella - Sadhayudu Bayaluparachunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేయేండ్ల పాలన చేయుటకై - రయముగ యేసు వచ్చును",
        "సర్వరాజ్యములు అన్నియు - సర్వేశుడేసుని రాజ్యమగున్"
      ],
      "english": [
        "Vaeyaemdla Paalana Chaeyutakai - Rayamuga Yaesu Vachchunu",
        "Sarvaraajyamulu Anniyu - Sarvaeshudaesuni Raajyamagun"
      ]
    }
  ]
}
