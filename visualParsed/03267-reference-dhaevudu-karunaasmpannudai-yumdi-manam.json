  },
  "main_stanza": {
    "telugu": [
      "ప్రభుని స్మరించు యేసుని స్మరించు",
      "ఓ మనసా! నా మనసా!"
    ],
    "english": [
      "Prabhuni smarinchu Yesuni smarinchu",
      "O manasaa! Naa manasaa!"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ ప్రేమ ధాటికి - సాటియే లేదు",
        "నీ మహిమే మేటి"
      ],
      "english": [
        "Nee prema dhaatiki - saatiye ledu",
        "Nee mahime meti"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభునీ శరణాగతులగువారు",
        "విడుదల నొందెదరు"
      ],
      "english": [
        "Prabhunee sharanaagathulaguvaaru",
        "Vidudala nondhedharu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపుల కొరకై సిలువను మోసి",
        "ప్రాణంబిడె నిలలో"
      ],
      "english": [
        "Paapula korakai siluvanu mosi",
        "Praanambide nilalo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మా ప్రభువా మా మొరనాలించి",
        "నీ జ్ఞానంబిమ్ము"
      ],
      "english": [
        "Maa Prabhuvaa maa moranaalinchi",
        "Nee gnaanambimmu"
      ]
    }
  ]
}
