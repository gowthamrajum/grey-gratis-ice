{
  "song_name": "Yaesukreesthuni Dhaasulaaraa",
  "author": {
    "Authored by": "",
    "రచన": "సి విజయ చార్లెస్"
  },
  "main_stanza": {
    "telugu": [
      "యేసుక్రీస్తుని దాసులారా మీ సుతులకును నేర్పరె",
      "ఆశతో యెహోవ యాజ్ఞల నభ్యసింపగ జేయరే"
    ],
    "english": [
      "Yaesukreesthuni Dhaasulaaraa Mee Suthulakunu Naerpare",
      "Aashathoa Yehoava Yaajnala Nabhyasimpaga Jaeyarae"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పిల్లలెప్పుడు ననుసరింతురు తల్లిదండ్రుల నడతలన్",
        "ఎల్ల విషయము లందు మాదిరి పిల్లలకు గనుపర్చరే"
      ],
      "english": [
        "Pillaleppudu Nanusarinthuru Thallidandrula Nadathalan",
        "Ella Vishayamu Landhu Maadhiri Pillalaku Ganuparcharae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మోదమిచ్చు కుటుంబ ప్రార్థన నేదినంబును మానక",
        "ఆదివారపు బడికి బిడ్డల నాదరముతో బంపరే"
      ],
      "english": [
        "Moadhamichchu Kutumba Praarthana Naedhinambunu Maanaka",
        "Aadhivaarapu Badiki Biddala Naadharamuthoa Bamparae"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసునాధుని బోలు నాయకు డే జగంబున లేడని",
        "యేసు కే నిజ శిష్యులగుటకు నేర్పరే యౌవనులకు"
      ],
      "english": [
        "Yaesunaadhuni Boalu Naayaku Dae Jagambuna Laedani",
        "Yaesu Kae Nija Shishyulagutaku Naerparae Yauvanulaku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసు శౌశీల్యమును వారికి బోధింపరే",
        "పసితనమునె వారి హృదయము యేసురూపము దాల్చును"
      ],
      "english": [
        "Yaesu Shausheelyamunu Vaariki Boadhimparae",
        "Pasithanamune Vaari Hrudhayamu Yaesuroopamu Dhaalchunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసుక్రీస్తులొ నిలిచి వారలు యేపుమీర ఫలింపగా",
        "యేసు వాక్యము వారి యెదలలో నాశతోడను నాటరే"
      ],
      "english": [
        "Yaesukreesthulo Nilichi Vaaralu Yaepumeera Phalimpagaa",
        "Yaesu Vaakyamu Vaari Yedhalaloa Naashathoadanu Naatarae"
      ]
    }
  ]
}
