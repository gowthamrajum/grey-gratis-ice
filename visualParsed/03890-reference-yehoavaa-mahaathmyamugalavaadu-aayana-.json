{
  "song_name": "Ghanatha mahima Prabhuke",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఘనత మహిమ ప్రభుకే",
      "తర తరములలో తనకే చెల్లును గాక"
    ],
    "english": [
      "Ghanatha mahima Prabhuke",
      "Thara tharamulalo thanake chellunu gaaka"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీతిమంతుడు మహానీయుడు స్తుతికీర్తనలతో సన్నుతించెదము",
        "అద్భుతములను చేయు దేవుడు వినుతించెదము విమలాత్ముడని"
      ],
      "english": [
        "Neethimanthudu mahaaneeyudu sthuthikeerthanalatho sannuthinchedhamu",
        "Adbhuthamulanu cheyu Devudu vinuthinchedhamu vimalaathmudani"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పావన ప్రభుయేసుండు పరమ దీవెనలు మనకిచ్చెను",
        "తరతరములలో ఎరిగిన తండ్రిని నిరంతరము స్తుతియించెదము"
      ],
      "english": [
        "Paavana Prabhuyesundu parama deevenalu manakichchenu",
        "Tharatharamulalo erigina thandrini nirantharamu sthuthiyinchedhamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మనలను సిలువ రక్తముతో కొని సమకూర్చెను సంఘముగాను",
        "తన శిరసత్వములో మనలుంచి మనల నడుపు రారాజునకే"
      ],
      "english": [
        "Manalanu siluva rakthamutho koni samakoorchenu sanghamugaanu",
        "Thana shirasathvamulo manalunchi manala nadupu raaraajunake"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "మాట తప్పని దేవుడేగ మేటిగ నెరవేర్చె వాగ్దానము",
        "ధీటైన జనముగ మము జేసెనుగ మెండుగ మమ్ము దీవించెనుగా"
      ],
      "english": [
        "Maata thappani Dhevudega metiga neraverche vaagdhaanamu",
        "Dheetaina janamuga mamu jesenuga menduga mammu dheevinchenugaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరమప్రభువు మనకొరకు అర్పించుకొనెను తన్ను తానే",
        "సర్వము మనకు యిచ్చిన ప్రభునే సర్వద మనము స్తుతియించెదము"
      ],
      "english": [
        "Paramaprabhuvu manakoraku arpinchukonenu thannu thaane",
        "Sarvamu manaku ichchina Prabhune sarvadha manamu sthuthiyinchedhamu"
      ]
    }
  ]
}
