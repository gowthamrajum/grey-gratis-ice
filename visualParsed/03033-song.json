      ],
      "english": [
        "Sthothramul maa swaamiki",
        "Chellunu",
        "Preethin maakai maranamondhuchu",
        "(Yesu",
        "Prema joopi prajala brochithe",
        "Raathi kota vaithivi maaku neevu",
        "Rakshakunda karunasaagaraa."
      ]
