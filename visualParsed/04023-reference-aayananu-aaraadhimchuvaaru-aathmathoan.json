    "english": [
      "Sthuthiyoo, prashamsayoo, mahimayoo",
      "Naa mukthi dhaathake",
      "Aathmasathyamutho - Aaraadhinchedhan",
      "Hrudayapoorvaka - Kruthagnathalan",
      "Sadaa sarvadaa chellinthun (2)"
