{
  "song_name": "Maranamunaku Vijaya Maedhi",
  "author": {
    "Authored by": "",
    "రచన": "తూలూరి కొర్నేలియస్"
  },
  "main_stanza": {
    "telugu": [
      "మరణమునకు విజయ మేది మరణ మోడిపోయెరా",
      "మరణ మొంది యేసు ప్రభువు మఱల బ్రతికి లేచెరా"
    ],
    "english": [
      "Maranamunaku Vijaya Maedhi Marana Moadipoayeraa",
      "Marana Mondhi Yaesu Prabhuvu Marala Brathiki Laecheraa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్షయమందు విత్తఁబడి య క్షయమునందు లేచురా",
        "ప్రియుడు క్రీస్తునందు మృతులు పెం పొసంగు ధన్యులు"
      ],
      "english": [
        "Kshayamandhu Viththambadi Ya Kshayamunandhu Laechuraa",
        "Priyudu Kreesthunandhu Mruthulu Pem Posangu Dhanyulu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లౌకిక దేహము విడి పర లోక దేహి యగునురా",
        "భీకర యోర్దాను యేసు ప్రేమతో దాఁటించురా"
      ],
      "english": [
        "Laukika Dhaehamu Vidi Para Loaka Dhaehi Yagunuraa",
        "Bheekara Yoardhaanu Yaesu Praemathoa Dhaantinchuraa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ధరణి దుఃఖ బాధ లన్ని ధరణియందె విడుతుము",
        "పరమ దేవుని డుండునట్టి పరదైసునకుఁ బోదుము"
      ],
      "english": [
        "Dharani Dhuhkha Baadha Lanni Dharaniyandhe Viduthumu",
        "Parama Dhaevuni Dundunatti Paradhaisunakun Boadhumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "గగన వీధినండి యేసుఁ గ్రక్కున వేం చేయురా",
        "జగతి సర్వ మృతుల నొక్క క్షణములో బ్రతికించురా"
      ],
      "english": [
        "Gagana Veedhinandi Yaesun Grakkuna Vaem Chaeyuraa",
        "Jagathi Sarva Mruthula Nokka Kshanamuloa Brathikinchuraa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "బూర రావ మాలకించి భూమి యెల్ల వణఁకురా",
        "వారధిలో మృతులు జీవ ధారులై లేచెదరురా"
      ],
      "english": [
        "Boora Raava Maalakinchi Bhoomi Yella Vanankuraa",
        "Vaaradhiloa Mruthulu Jeeva Dhaarulai Laechedharuraa"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "భక్తులు విశ్వాసమునకు ఫలము నొందఁ బోదురు",
        "ముర్తి కిరీటము ధరించి రక్తితో జీవింతురు"
      ],
      "english": [
        "Bhakthulu Vishvaasamunaku Phalamu Nondhan Boadhuru",
        "Murthi Kireetamu Dharinchi Rakthithoa Jeevinthuru"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "కరుణలేని మరణమునకు వెరవకుండ నుండుఁడి",
        "మరణవిజయుఁడైన ప్రభుని చరణములు నుతించుఁడీ"
      ],
      "english": [
        "Karunalaeni Maranamunaku Veravakunda Nundundi",
        "Maranavijayundaina Prabhuni Charanamulu Nuthinchundee"
      ]
    }
  ]
}
