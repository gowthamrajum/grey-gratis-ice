{
  "song_name": "Akshayuda",
  "author": {
    "Authored by": "Pastor Ramesh, Hosanna Ministries",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "అక్షయుడా నా ప్రియ యేసయ్యా",
      "నీకే నా అభివందనం",
      "నీవు నాకోసమే తిరిగి వస్తావని",
      "నేను నీసొంతమై కలసిపోదామని",
      "యుగయుగములు నన్నేలుతావని",
      "నీకే నా ఘనస్వాగతం"
    ],
    "english": [
      "Akshayudaa naa priya yesayya",
      "neeke naa abhivandhanam",
      "neevu naakosame tirigi vasthaavani",
      "nenu neesonthamai kalasipodamani",
      "yugayugamulu nanneluthaavani",
      "neeke naa ghanasvaagatham"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ బలిపీఠమందు పక్షులకు వాసమే దొరికెనే",
        "అవి అపురూపమైన నీ దర్శనం కలిగి జీవించునే",
        "నేనేముందును – ఆకాక్షింతును",
        "నీతో ఉండాలనే కల నెరవేరున",
        "నా ప్రియుడా యేసయ్యా చిరకాల ఆశను నెరవేర్చుతావని మదిలో చిరుకోరిక"
      ],
      "english": [
        "Nee balipeetamandu pakshilaku vaasame dhorikene",
        "avi apuroopamaina nee dharshanam kaligi jeevinchune",
        "neenemundunu – aakaakshinthunu",
        "neetho undaalane kala neraveruna",
        "naa priyudaa yesayya",
        "chirakaala aashanu neraverchuthaavani madhilo chirukorika"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ అరచేతిలో నను చెక్కుకొని మరువలేనంటివే",
        "నీ కనుపాపగా నను చూచుకొని కాచుకున్నావులే",
        "నను రక్షించిన – ప్రాణమర్పించిన",
        "నను స్నేహించిన – నను ముద్రించిన",
        "నా ప్రియుడా యేసయ్యా",
        "పానార్పణముగా నా జీవితమును అర్పించుకున్నానయ"
      ],
      "english": [
        "Nee arachethilo nanu chekkukoni maravalenantive",
        "nee kanupaapaga nanu choochukoni kaachukunnavule",
        "nanu rakshinchina – praanamarpinchina",
        "nanu snehinchina – nanu mudhrinchina",
        "naa priyudaa yesayya",
        "paanarapanamuga naa jeevithamunu arpinchukunnanaya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీవు స్థాపించిన ఏ రాజ్యమైన కొదువ లేకుండునే",
        "బహు విస్తారమైన నీ కృపయే మేలుతో నింపునే",
        "అది స్థిరమైనదై – క్షేమము నొందునే",
        "నీ మహిమాత్మతో – నెమ్మది పొందునే",
        "నా ప్రియుడా యేసయ్యా",
        "రాజ్యాలనేలే శకపురుషుడ నీకు సాటేవ్వరు"
      ],
      "english": [
        "Neevu sthaapinchina ye raajyamaina koduva lekundune",
        "bahu visthaaramaina nee krupaye melutho ninpune",
        "adhi sthiramainadai – kshemamu nondhune",
        "nee mahimaathmatho – nemmadhi pondhune",
        "naa priyudaa yesayya",
        "raajyala neele shakapurushuda neeku saatevvaru"
      ]
    }
  ]
}
