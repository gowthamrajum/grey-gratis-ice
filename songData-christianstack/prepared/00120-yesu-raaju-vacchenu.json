  "main_stanza": {
    "telugu": [
      "యేసు రాజు వచ్చెను,",
      "మన హృదయంలో నిలిచెను",
      "ఎమ్మానుయేలు మనతో ఉన్నాడు,",
      "యుగయుగాల రాజు యేసయ్యా"
    ],
    "english": [
      "Yesu raaju vachenu",
      "Mana hrudayamlo nilichenu",
      "Emmanuel manatho unnaadu",
      "Yugayugaala raaju Yesayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆయనే జీవం, ఆయనే శాంతి,",
        "నక్షత్రం చూపే మార్గమంతా",
        "హల్లేలూయా, హల్లేలూయా,",
        "క్రిస్మస్ సంతోషం ప్రతి ఇంటా"
      ],
      "english": [
        "Ayane jeevam, ayane shaanthi",
        "Nakshathram choope margamantha",
        "Halleluya, Halleluya",
        "Christmas santhosham prathi intaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
