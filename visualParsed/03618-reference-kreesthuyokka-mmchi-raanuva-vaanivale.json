{
  "song_name": "Nee vaathma yuddhamulo jaya mondhumu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నీ వాత్మ యుద్ధములో జయ మొందుము",
      "ఓ నా సోదరా వెనుకంజ వేయకు",
      "ఓ నా సోదరి వెనుకంజ వేయకు"
    ],
    "english": [
      "Nee vaathma yuddhamulo jaya mondhumu",
      "O naa sodaraa venukanja veyaku",
      "O naa sodhari venukanja veyaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్వామి యేసు తన సిలువను మోసి",
        "సైతాను రాజ్యము - పూర్తిగా జయించె",
        "నీవును యేసుని వెంబడి వెళ్ళుమా  ||క్రీస్తుయొక్క||"
      ],
      "english": [
        "Swaami Yesu thana siluvanu mosi",
        "Saithaanu raajyamu - Poorthigaa jayinche",
        "Neevunu Yesuni vembadi vellumaa ||Kreesthuyokka||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శిరమున ముండ్ల మకుటము ధరించి",
        "సిపాయిచే తలపై కొట్టబడె",
        "నీ శిరస్సు నట్లే సమర్పించు  ||క్రీస్తుయొక్క||"
      ],
      "english": [
        "Shiramuna mundla makutamu dharinchi",
        "Sipaayiche thalapai kottabade",
        "Nee shirassu natle samarpinchu ||Kreesthuyokka||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కల్వరి పైకి - ఒంటరిగానే",
        "వెళ్ళెను యేసు - త్యాగ సహితుడై",
        "నీవును ఆ దారినే వెళ్ళుమా  ||క్రీస్తుయొక్క||"
      ],
      "english": [
        "Kalvari paiki - Ontarigaane",
        "Vellenu Yesu - Thyaaga sahithudai",
        "Neevunu aa daarine vellumaa ||Kreesthuyokka||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "లోకస్తులంతా - నిద్రించుచుండగా",
        "మోకాళ్ళపై యేసు - కొండపై నుండె",
        "నీవును ప్రార్థన శక్తి నొందుమా  ||క్రీస్తుయొక్క||"
      ],
      "english": [
        "Lokasthulanthaa - Nidhrinchuchundagaa",
        "Mokaallapai Yesu - Kondapai nunde",
        "Neevunu praarthana shakthi nondhumaa ||Kreesthuyokka||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సాహసమున నీ - వాత్మ ఖడ్గమున",
        "సైతాను బంధము - ఖండించివేసి",
        "క్రీస్తుని సంఘమా - ముందంజ వేయుమా  ||క్రీస్తుయొక్క||"
      ],
      "english": [
        "Saahasamuna nee - Vaathma khadgamuna",
        "Saithaanu bandhamu - Khandinchivesi",
        "Kreesthuni sanghamaa - Mundhanja veyumaa ||Kreesthuyokka||"
      ]
    }
  ]
}
