{
  "song_name": "ParamathMdri Karamuleththi Sthuthula NarpiMthumu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పరమతండ్రి కరములెత్తి - స్తుతుల నర్పింతుము",
      "శిరములెత్తి స్వామి నీకై చూచుచుంటిమి",
      "ఉజ్జీవ నాత్మ నొసగు నిలువ సజీవ సాక్షిగ"
    ],
    "english": [
      "ParamathMdri Karamuleththi - Sthuthula NarpiMthumu",
      "Shiramuleththi Svaami Neekai ChoochuchuMtimi",
      "Ujjeeva Naathma Nosagu Niluva Sajeeva SaakShiga"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాప శాపములందు మేము - పడి చెడి యుండగా",
        "దేవ మాదు దరికి జేరి - లేవ నెత్తితివి",
        "ఎంత జాలి ఎంత ప్రేమ - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Paapa ShaapamulMdhu Maemu - Padi Chedi YuMdagaa",
        "Dhaeva Maadhu Dhariki Jaeri - Laeva Neththithivi",
        "EMtha Jaali EMtha Praema - Sthuthula NarpiMthumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దినదినము నిను శోధించి - దుఃఖ పెట్టితిమి",
        "కేవలము శరీరులమని - కనికరించితివి",
        "క్షమించి మమ్ము కడిగితివి - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Dhinadhinamu Ninu ShoaDhiMchi - DhuHkha Pettithimi",
        "Kaevalamu Shareerulamani - KanikariMchithivi",
        "KShamiMchi Mammu Kadigithivi - Sthuthula NarpiMthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నింద వేదన శ్రమలు బహు - నిట్టూర్పులయందు",
        "విసుగకుండ సేవచేయ - నొసగు నోర్పును",
        "నింపు నీ శుద్ధాత్మతోను - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "NiMdha Vaedhana Shramalu Bahu - NittoorpulayMdhu",
        "VisugakuMda Saevachaeya - Nosagu Noarpunu",
        "NiMpu Nee ShudhDhaathmathoanu - Sthuthula NarpiMthumu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సూర్యచంద్ర తారలందు - వింత సూచనలు",
        "జరుగ జనులు ధైర్యము చెడి - కూలి చూచెదరు",
        "అయితే నీకై చూచు మేము - బలము నొందెదము"
      ],
      "english": [
        "SooryachMdhra ThaaralMdhu - ViMtha Soochanalu",
        "Jaruga Janulu Dhairyamu Chedi - Kooli Choochedharu",
        "Ayithae Neekai Choochu Maemu - Balamu NoMdhedhamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సమాజముగ కూర్చి నీదు - సన్నిధియందు",
        "ప్రార్థన సహవాసములలో - స్థిరులజేయుము",
        "తేరి చూస్తూ నీ రాకడకై - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Samaajamuga Koorchi Needhu - SanniDhiyMdhu",
        "PraarThana Sahavaasamulaloa - SThirulajaeyumu",
        "Thaeri Choosthoo Nee Raakadakai - Sthuthula NarpiMthumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "శత్రుటురులు త్రుంచివేసి - జీవమిచ్చితివి",
        "ఆహా! యేమర్పింతుము - నీ ఉపకారములకై",
        "చేతబట్టి రక్షణపాత్ర - స్తుతుల నర్పింతుము"
      ],
      "english": [
        "Shathruturulu ThruMchivaesi - Jeevamichchithivi",
        "Aahaa! YaemarpiMthumu - Nee Upakaaramulakai",
        "Chaethabatti RakShaNapaathra - Sthuthula NarpiMthumu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "గతబ్రతుకులో వాత్సల్యమున - గాచి యీ క్షితిన్",
        "నడిపె నవ్యవత్సరముకై - కృపాక్షేమములతో",
        "సత్యుడ సిల్వశక్తి నొసగు - సాగముందుకు"
      ],
      "english": [
        "Gathabrathukuloa Vaathsalyamuna - Gaachi Yee KShithin",
        "Nadipe Navyavathsaramukai - KrupaakShaemamulathoa",
        "Sathyuda Silvashakthi Nosagu - SaagamuMdhuku"
      ]
    }
  ]
}
