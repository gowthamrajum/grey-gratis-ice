{
  "song_name": "Kadavari Varshamu",
  "author": {
    "Authored by": "Ashirwad Kodavalli & Selvin Gana",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కుమ్మరించుము కడవరి వర్షము",
      "నీ అభిషేకము నాపై దేవా",
      "నా నిరీక్షణ నీ ప్రత్యక్షత",
      "నా సంపూర్ణత నీవే దేవా"
    ],
    "english": [
      "Kummarinchumu kadavari varshamu",
      "nee abhishekamu naapai devaa",
      "naa nireekshana nee prathyakshatha",
      "naa sampoornatha neeve devaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరిశుద్ధుడా నా నాయకుడా",
        "న్యాయాధిపతి నా భోదకుడా",
        "నావికుడా నా స్నేహితుడా",
        "అత్యున్నతుడా నీవే"
      ],
      "english": [
        "Parishuddhudaa naa naayakudaa",
        "nyaayadhipathi naa bhodhakudaa",
        "naavikudaa naa snehithudaa",
        "athyunnathudaa neeve"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధుడా నా దేవా",
        "జీవాధిపతి నా జీవమా",
        "నా బలమా నా ఆధరణ",
        "పరమోన్నతుడా నీవే"
      ],
      "english": [
        "Parishuddhudaa naa devaa",
        "jeevaadhipathi naa jeevamaa",
        "naa balamaa naa aadharana",
        "paramonnathudaa neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "Bridge:",
        "నీ సత్యములో నన్ను నడుపుము",
        "నీ శక్తితో నన్ను నింపుము",
        "దయచేయుము నీ దర్శనము",
        "దేవా నే సిద్ధము",
        "దేవా వెనుదిరుగము"
      ],
      "english": [
        "Bridge:",
        "Nee sathyamulo nannu nadupumu",
        "nee sakthitho nannu nimpumu",
        "dhaya cheyumu nee dharsanamu",
        "devaa ne siddhamu",
        "devaa venudhirugamu"
      ]
    }
  ]
}
