{
  "song_name": "Deva Vembadinchithi",
  "author": {
    "Authored by": "Rev. Acharya Dr. A B Masilamani",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవా! వెంబడించితి నీ నామమున్",
      "జీవితేశ్వర నా జీవితాశ నీవే",
      "రావె నా భాగ్యమా యేసువా"
    ],
    "english": [
      "Deva! Vembadinchithi nee naamamun",
      "jeevitheswara na jeevithaasha neeve",
      "raave na bhaagyama yesuva"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసూ! నీదు ప్రేమను నే వింటిని",
        "భాసురంబగు నీ సిలువ నే గంటిని",
        "యేసువాడను నే నంటిని ||దేవా||",
        "ప్రభో! ప్రారంభించితి ప్రయాణమున్",
        "పరలోక యెరూషలేము పురికిన్",
        "పావనా జూపుము మార్గము ||దేవా||",
        "నాధా! ఈదలేను ఈ ప్రవాహమున్",
        "నీదరిన్ గాన నీ కెరటాలధాటిచే",
        "నావికా రమ్ము నన్ బ్రోవుము ||దేవా||",
        "స్వామి! నీదు ప్రేమకు నే సాక్షిని",
        "సంఘమందున నా పొరుగువారికి నీ",
        "సత్య సువార్త నే జాటుదున్ ||దేవా||",
        "రాజా! నీదు రాజ్యములో జేరితి",
        "రమ్యమౌ రాజ్యమందున నన్ వాడుము",
        "రక్షణానందము గూర్చుము ||దేవా||"
      ],
      "english": [
        "Yesu! needhu premanu ne vintini",
        "bhaasurambagu nee siluva ne gantini",
        "yesuvaadanu ne nantini || Deva ||",
        "Prabho! prarambinchithi prayaanamun",
        "paraloka yerushalemu purikin",
        "paavana joopumu maargamu || Deva ||",
        "Naadha! eedhalenu ee pravahaamun",
        "needharin gaana nee kerataala dhaatiche",
        "naavika rammu nan brovumu || Deva ||",
        "Swami! needhu premaku ne sakshini",
        "sanghamandhuna na poruguvaariki ni",
        "satya suvartha ne jaatudhun || Deva ||",
        "Raja! needhu rajyamulo jerithi",
        "ramyamou raajyamandhuna nan vaadumu",
        "rakshanandam goorchumu || Deva ||"
      ]
    }
  ]
}
