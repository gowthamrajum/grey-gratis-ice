  "main_stanza": {
    "telugu": [
      "అమ్మ ప్రేమ కన్న నీ ప్రేమ గొప్పది",
      "నాన్న జాలి కన్న నీ జాలి గొప్పది",
      "ఆ ప్రేమా.. ఆ జాలీ.. నా జీవితాన్ని మార్చేసింది",
      "ఆ ఆ ఆ.. జీవితాన్ని మార్చేసింది"
    ],
    "english": [
      "Amma prema kanna nee prema goppadhi",
      "Naanna jaali kanna nee jaali goppadi",
      "Aa premaa.. aa jaalee.. naa jeevithaanni maarchesindhi",
      "Aa aa aa.. jeevithaanni maarchesindi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అలనాడు ఒక తండ్రి దేవుని మాట విని",
        "కన్న కొడుకునే.. బలి అర్పించెను",
        "క్షణమైనా గాని మరువక నీవు",
        "రక్షించినావు ఇస్సాకును – కాపాడినావు ఇస్సాకును"
      ],
      "english": [
        "Alanaadu oka thandri Devuni maata vini",
        "Kanna kodukune.. bali arpinchenu",
        "Kshanamainaa gaani maruvaka neevu",
        "Rakshinchinaavu Issaakunu",
        "Kaapaadinaavu Issaakunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అలనాడు ఒక తల్లి రాజుకు భయపడి",
        "కన్న కొడుకునే.. నీళ్లలో పడవేసెను",
        "క్షణమైనా గాని మరువక నీవు",
        "రక్షించినావు ఆ మోషేను – కాపాడినావు ఆ మోషేను"
      ],
      "english": [
        "Alanaadu oka talli raajuku bhayapadi",
        "Kanna kodukune.. neellalo padavesenu",
        "Kshanamainaa gaani maruvaka neevu",
        "Rakshinchinaavu aa Moshenu",
        "Kaapaadinaavu aa Moshenu"
      ]
