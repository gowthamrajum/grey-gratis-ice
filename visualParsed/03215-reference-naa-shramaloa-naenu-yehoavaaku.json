{
  "song_name": "Naa shramalo nenu Yehovaaku",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "నా శ్రమలో నేను యెహోవాకు మొఱలిడితిని"
    ],
    "english": [
      "Naa shramalo nenu Yehovaaku moralidithini"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాకాయన ఉత్తరమిచ్చెన్ - అబద్ధమాడు వారి నుండి",
        "యెహోవా నా ప్రాణమును విడిపించుము"
      ],
      "english": [
        "Naakaayana uttharamichchen - Abaddhamaadu vaari nundi",
        "Yehova naa praanamunu vidipinchumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "మోసకరమగు నాలుకా - ఆయన నీకేమి చేయును?",
        "తంగేడు నిప్పుల బాణముల నీపై వేయును"
      ],
      "english": [
        "Mosakaramagu naalukaa - Aayana neekemi cheyunu?",
        "Thangedu nippula baanamula neepai veyunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అయ్యో నేను మెషెకులో - పరదేశినై యున్నాను",
        "కేదారు గుడారముల యొద్ద కాపురమున్నాను"
      ],
      "english": [
        "Ayyo nenu meshekulo - Paradheshinai yunnaanu",
        "Kedhaaru gudaaramula yodda kaapuramunnaanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కలహప్రియుని యొద్ద - చిరకాలము నివసించితిని",
        "నేను కోరునది సమాధానమే"
      ],
      "english": [
        "Kalahapriyuni yodda - Chirakaalamu nivasinchithini",
        "Nenu korunadhi samaadhaaname"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అయినను మాట నా నోట వచ్చిన తోడనే వారు",
        "యుద్ధమునకు సిద్ధము అయ్యెదరు"
      ],
      "english": [
        "Ayinanu maata naa nota vachchina thodane vaaru",
        "Yudhdhamunaku siddhamu ayyedaru"
      ]
    }
  ]
}
