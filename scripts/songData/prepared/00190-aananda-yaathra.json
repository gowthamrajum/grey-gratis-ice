{
  "song_name": "Aananda Yaathra",
  "author": {
    "Authored by": "bro yesanna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆనంద యాత్ర ఇది ఆత్మీయ యాత్ర",
      "యేసుతో నూతన యెరుషలేము యాత్ర (2)"
    ],
    "english": [
      "Aananda Yaathra Idi Aathmeeya Yaathra",
      "Yesutho Noothana Yerushalemu Yaathra (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసుని రక్తము పాపములనుండి విడిపించును",
        "వేయి నోళ్ళతో స్తుతించినను తీర్చలేము ఆ ఋణమును"
      ],
      "english": [
        "Yesuni Rakthamu Paapamulanundi Vidipinchunu",
        "Veyi Nollatho Sthuthinchinanu Theerchalemu Aa Runamunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రాత్రియు పగలును పాదములకు రాయి తగలకుండా",
        "మనకు పరిచర్య చేయుట కొరకు దేవదూతలు మనకుండగా"
      ],
      "english": [
        "Raathriyu Pagalunu Paadamulaku Raayi Thagalakunda",
        "Manaku Paricharya Cheyuta Koraku Deva Doothalu Manakundagaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కృతజ్ఞత లేని వారు వేలకొలదిగ కూలిననూ",
        "కృపా వాక్యమునకు సాక్షులమై కృప వెంబడి కృప పొందెదము"
      ],
      "english": [
        "Kruthagnatha Leni Vaaru Velakoladiga Koolinanu",
        "Krupaa Vaakyamunaku Saakshulamai Krupa Vembadi Krupa Pondedamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆనందం ఆనందం యేసుని చూచే క్షణం ఆసన్నం",
        "ఆత్మానంద భరితులమై ఆగమనాకాంక్షతో సాగెదన్"
      ],
      "english": [
        "Aanandam Aanandam Yesuni Chooche Kshanam Aasannam",
        "Aathmaananda Bharithulamai Aagamanaakaankshatho Saagedan"
      ]
    }
  ]
}
