{
  "song_name": "Ninu Chere",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నిను చేరే ప్రతీ క్షణం ప్రభాతమే నాలో",
      "స్మరింతునూ నీ నామం నిరంతరం యేసు"
    ],
    "english": [
      "Ninu chere prathi kshanam prabhaathame naalo",
      "smarinthunu nee naamam nirantharam yesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ పిలుపే నా కోసం – నీ పలుకే ఆధారం",
        "నీకే ఆరాధనా",
        "కన్నుల్లో నీ రూపం – కనిపించే నా దైవం",
        "నిన్ను నే చేరగా",
        "నీ ప్రేమే మాధుర్యం – నడిపించే నా దీపం",
        "నీవు నా తోడుగా",
        "నీ వరమే ఈ స్నేహం – నాతోనే కలకాలం",
        "యేసయ్య నా రక్షకా",
        "వేవేల స్తోత్రాలతో నిన్ను కీర్తింతును",
        "ఆనంద గానాలతో నిన్ను స్తుతియింతును",
        "నీ తలపే నా ధ్యానం – నా మనసే నీ సొంతం",
        "నిన్ను ప్రేమింతును",
        "నీతోనే సహవాసం – నను కోరే అనురాగం",
        "యేసయ్య నా ప్రాణమా",
        "నీతోనే చిరకాలం – సాగాలి నా పయనం",
        "గమ్యమే నీవుగా",
        "నీ ప్రేమే అపురూపం – మన్నించే మమకారం",
        "నీవే నా ప్రేరణ",
        "ఏరీతి నే పాడనూ నీదు ఘన ప్రేమను",
        "యేసయ్య నీ సేవలో నేను తరియింతును"
      ],
      "english": [
        "Ni pilupe naa kosam – nee paluke aadhaaram",
        "neeke araadhana",
        "kannullo nee roopam – kanipinche naa dhaivam",
        "ninnu ne cheragaa",
        "nee preme maadhuryam – nadipinche naa dheepam",
        "neevu naa thodugaa",
        "nee varame ee sneham – naathone kalakaalam",
        "yesayya naa rakshakaa",
        "vevela stothraalatho ninnu keerthinthunu",
        "aanandha gaanaalatho ninnu sthuthiyinthunu",
        "Nee thalape naa dhyaanam – naa manase nee sontham",
        "ninnu preminthunu",
        "neethone sahavaasam – nanu kore anuraagam",
        "yesayya naa praanamaa",
        "neethone chirakaalam – saagaali naa payanam",
        "gamyame neevugaa",
        "nee preme apuroopam – manninche mamakaaram",
        "nee naa prerana",
        "ey reethi ne paadanu needhu ghana premanu",
        "yesayya nee sevalo nenu thariyinthunu"
      ]
    }
  ]
}
