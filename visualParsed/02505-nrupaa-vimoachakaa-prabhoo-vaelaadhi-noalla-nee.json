{
  "song_name": "Nrupaa vimochakaa Prabhoo velaadi nolla nee",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "చార్ల్స్ వెస్లీ"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నృపా! విమోచకా! ప్రభూ వేలాది నోళ్ల నీ",
      "కృపా జయప్రభావముల్ నుతింతు నెంతయున్."
    ],
    "english": [
      "Nrupaa! vimochakaa! Prabhoo velaadi nolla nee",
      "Krupaa jayaprabhaavamul nuthimthu nenthayun."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "కృపాధికార! దేవ! నీ సాయంబు జేయుమా",
        "భవత్ర్పభావ కీర్తులన్ జాటంగ నెల్లెడన్."
      ],
      "english": [
        "Krupaadhikaara! Deva! nee saayambu jeyumaa",
        "Bhavathprabhaava keerthulan jaatamga nelledan."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "భయంబు చింతఁ బాపును హర్షంబు పాపికి",
        "సౌఖ్యంబు జీవశాంతులు నీ నామ మిచ్చును."
      ],
      "english": [
        "Bhayambu chimtha baapunu harshambu paapiki",
        "Saukhyambu jeevashaamthulu nee naama michchunu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "విముక్తి జేయు ఖైదిని పాపంబు బాపును",
        "పాపాత్ము శుద్ధుజేఁయును శ్రీయేసు రక్తము."
      ],
      "english": [
        "Vimukthi jeyu khaidhini paapambu baapunu",
        "Paapaathmu shuddhujeyunu Shreeyesu rakthamu."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జనాళి! పాపు లెల్లరు! శ్రీయేసున్ నమ్ముఁడి",
        "కృపావిముక్తులందుఁడి సంపూర్ణ భక్తితో."
      ],
      "english": [
        "Janaali! paapu lellaru! Shreeyesun nammudi",
        "Krupaavimukthulandhudi sampoorna bhakthitho."
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అర్పించె యేసు ప్రాణమున్ నరాళిఁగావను;",
        "యజ్ఙంపు దేవు గొఱ్ఱెపై నఘంబు వేయుఁడి."
      ],
      "english": [
        "Arpimche Yesu praanamun naraaligaavanu;",
        "Yajnampu Devu gorrepai naghambu veyudi."
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "సత్కీర్తి స్తోత్ర ప్తేమల నభాన భూమిని",
        "సర్వత్ర దేవుఁడొందుగా సద్భక్త పాళిచే."
      ],
      "english": [
        "Sathkeerthi sthothra premala nabhaana bhoomini",
        "Sarvathra Dhevudondhugaa sadbhaktha paaliche."
      ]
    }
  ]
}
