        "శత్రు ప్రణాళిక ఆగిపోయెను ” నీ ముఖ “"
      ],
      "english": [
        "Vishwaasame shodhimpabadagaa",
        "Nee krupaye naatho nilichenu  ||El||",
        "Shathru pranaalika aagipoyenu ” Nee mukha “"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఒంటరినై నేను నిను చేరగా",
        "నా పక్షమై నీవు నిలచితివే  ||ఎల్||",
        "శత్రువే పారిపోయెను ” నీ ముఖ “"
      ],
      "english": [
        "Ontarinai nenu ninu cheragaa",
        "Naa pakshamai neevu nilachithive  ||El||",
        "Shatruve paaripoyenu ” Nee mukha “"
      ]
