        "VarShamu Dhaya Chaeyu Milaloa",
        "Pairu Moluchunatlu Prathi Chaeni Loanu",
        "Merupulanu PuttiMchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
