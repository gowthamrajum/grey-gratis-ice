{
  "song_name": "Adiyu Neeve",
  "author": {
    "Authored by": "Joel Kodali",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఆదియు నీవె అంతము నీవె",
      "ఆదారం నీవె ఆశ్రయం నీవె",
      "నా ఆశయు నా శ్వాసయు",
      "నా ఆశయం నా సర్వం నీవె"
    ],
    "english": [
      "Aadiyu neeve anthamu neeve",
      "aadhaaram neeve aashrayam neeve",
      "naa aasayu naa swaasayu",
      "naa aasayam naa sarvam neeve"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రొత్త పాట నే పాడెదన్",
        "గలమెత్తి కీర్తించెదన్",
        "నీవె నా రాగము",
        "నీవె నా గానము",
        "రక్షణ నీవె ప్రభు",
        "నా నిరీక్షణ నీవె",
        "నీవె నా మార్గము",
        "నీవె నా గమ్యము",
        "స్తుతి ఘనత మహిమలు",
        "నీకె చెల్లింతును",
        "నిన్నే ప్రేమింతును",
        "నీకై జీవింతును"
      ],
      "english": [
        "Krotha paata ne paadedan",
        "galamethi keertinchedan",
        "neeve naa raagamu",
        "neeve naa gaanamu",
        "Rakshana neeve prabhu",
        "naa nireekshana neeve",
        "neeve naa maargamu",
        "neeve naa gamyamu",
        "Stuthi ganata mahimalu",
        "neeke chellinthunu",
        "ninne preminthunu",
        "neekai jeevinthunu"
      ]
    }
  ]
}
