  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యేసురాజు వచ్చును దూతలతో వచ్చును",
        "దాసుల పరమున జేర్చుటకు",
        "యేసుని ముఖజ్యోతిని జూచెదము",
        "జయ ధ్వనులచే నుప్పొంగెదము"
      ],
      "english": [
        "Yesuraaju vachchunu doothalatho vachchunu",
        "Daasula paramuna jerchutaku",
        "Yesuni mukhajyothini joochedhamu",
        "Jaya dhvanulache nuppongedhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంఘ వధువు పెండ్లి కుమారుండేసుతో",
        "మంగళ గీతము పాడును",
        "నాడు మహిమలో మనము పాడెదము",
        "యేసు స్నేహంపు లోతును రుచియింతుము"
      ],
      "english": [
        "Sangha vadhuvu pendli kumaarundesutho",
        "Mangala geethamu paadunu",
        "Naadu mahimalo manamu paadedamu",
        "Yesu snehampu lothunu ruchiyinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ముద్ర నొంది శుద్ధులు తెల్ల నంగి ధరించి",
        "శుద్ధుని ముంగిట నిలిచెదరు నాడు",
        "స్వర్ణ కిరీటమును దాల్చి",
        "అందు పాడుచు ప్రకాశించెదము"
      ],
      "english": [
        "Mudra nondi shuddhulu thella nangi dharinchi",
        "Shuddhuni mungita nilichedharu naadu",
        "Swarna kireetamunu daalchi",
        "Andu paaduchu prakaashinchedhamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసునే ప్రేమించితి",
        "లోక స్నేహం వీడితి",
        "సదా నా యేసుతో ముచ్చటింతున్",
        "నాడు ప్రభు యేసునితో సుఖ మొందెదన్"
      ],
      "english": [
        "Yesune preminchithi",
        "Loka sneham veedithi",
        "Sadaa naa Yesutho muchchatinthun",
        "Naadu Prabhu Yesunitho sukha mondhedhan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరలోక బూరధ్వని మ్రోగగానే",
        "పరిశుద్ధులెగిరి వెళ్ళెదరు - ఆ",
        "సత్యుని కల్యాణ విందులో",
        "మన మేసుతో నార్భటించెదము"
      ],
      "english": [
        "Paraloka booradhvani mrogagaane",
        "Parishuddhulegiri velledharu - Aa",
        "Sathyuni kalyaana vindulo",
        "Mana Yesutho naarbhatinchedhamu"
      ]
    }
  ]
}
