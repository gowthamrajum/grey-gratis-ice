{
  "song_name": "Opaapi jeevapu yootakuraa paapabhaaramu thodaraa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓపాపి జీవపు యూటకురా - పాపభారము తోడరా",
        "రక్షకుడు నిన్ను పిల్చుచున్నాడు - అక్షయ జీవమీయను",
        "తామసము చేయకుము - తరుణమును వీడకుము",
        "కృపతో నిన్ను రక్షించును - కృపతో రమ్మనెను"
      ],
      "english": [
        "Opaapi jeevapu yootakuraa - Paapabhaaramu thodaraa",
        "Rakshakudu ninnu pilchuchunnaadu - Akshaya jeevameeyanu",
        "Thaamasamu cheyakumu - Tharunamunu veedakumu",
        "Krupatho ninnu rakshinchunu - Krupatho rammanenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఉన్న పాటున రము యేసు నొద్దకు - పన్నుగ కాచియున్నాడు",
        "సింధుర పాపమైనను - బంధరముగ మాయమౌ"
      ],
      "english": [
        "Unna paatuna ramu Yesu noddaku - Pannuga kaachiyunnaadu",
        "Sindhura paapamainanu - Bandharamuga maayamau"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రక్షకుని వాక్కులన్నియు - రయమున నమ్ముచు",
        "పశ్చాత్తాపమొందువారలకు - నిశ్చయ రక్షణ నిచ్చున్"
      ],
      "english": [
        "Rakshakuni vaakkulanniyu - Rayamuna nammuchu",
        "Paschaaththaapamonduvaaralaku - Nischaya rakshana nichchun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపి మనస్సు మారునపుడు - పరమందలి దూతలు",
        "సంతోషగాన వితతులచే - వింతగ పాడుదురు"
      ],
      "english": [
        "Paapi manassu maarunapudu - Paramandhali doothalu",
        "Santhoshagaana vithathulache - Vinthaga paadudhuru"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "వాక్కుల నెరవేర్చిన యేసు - మాట తప్పనివాడు",
        "సాకు చెప్పువారల నెల్ల - శిక్షకై నియమించెను"
      ],
      "english": [
        "Vaakkula neraverchina Yesu - Maata thappanivaadu",
        "Saaku cheppuvaarala nella - Shikshakai niyaminchenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యేసు నంగీకరించువారలను - చేయును శుద్ధులుగా",
        "యెల్లరకును మేలుచేసెను - పిల్చుచున్నాడిపుడు"
      ],
      "english": [
        "Yesu nangeekarinchuvaaralanu - Cheyunu shuddhulugaa",
        "Ellarakunu meluchesenu - Pilchuchunnaadipudu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయా పాటపాడెదవు - చల్లని ఆత్మవలన",
        "నాథుని నీవు వెదకిన - సాధుగ ఈవుల నిచ్చున్"
      ],
      "english": [
        "Hallelooyaa paatapaadedhavu - Challani aathmavalana",
        "Naathuni neevu vedakina - Saadhuga eevula nichchun"
      ]
    }
  ]
}
