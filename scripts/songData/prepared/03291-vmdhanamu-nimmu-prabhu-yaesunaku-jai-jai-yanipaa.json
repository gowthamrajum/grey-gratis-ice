{
  "song_name": "Vandhanamu Nimmu Prabhu Yaesunaku Jai Jai Yanipaadu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "వందనము నిమ్ము ప్రభు యేసునకు జై జై యనిపాడు"
    ],
    "english": [
      "Vandhanamu Nimmu Prabhu Yaesunaku Jai Jai Yanipaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా జీవితపు ప్రముఖుడు ప్రభువే",
        "నన్నేలెడు ప్రభు నా రాజాయనే",
        "యుగుయుగ మహిమ ప్రభువునకే",
        "పాడుచుండెదను భజియించెదను జయధ్వనుల జేతున్"
      ],
      "english": [
        "Naa Jeevithapu Pramukhudu Prabhuvae",
        "Nannaeledu Prabhu Naa Raajaayanae",
        "Yuguyuga Mahima Prabhuvunakae",
        "Paaduchundedhanu Bhajiyinchedhanu Jayadhvanula Jaethun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ఆదర్శము మహిమయు తానే",
        "తన యధికారము సర్వము నేలును",
        "తన నామము బహు అద్భుతము"
      ],
      "english": [
        "Naa Aadharshamu Mahimayu Thaanae",
        "Thana Yadhikaaramu Sarvamu Naelunu",
        "Thana Naamamu Bahu Adhbhuthamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యెహోవా బహుస్తుతికి యోగ్యుడు",
        "భక్తుల స్మరణ నీతియు నాయనే",
        "మహాప్రభావము గలవాడు"
      ],
      "english": [
        "Yehoavaa Bahusthuthiki Yoagyudu",
        "Bhakthula Smarana Neethiyu Naayanae",
        "Mahaaprabhaavamu Galavaadu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బుద్దియు బలము జ్ఞానము ప్రభువే",
        "తన నీతి బహు ఉన్నతమైనది",
        "సైన్యముల కధిపతి నా తోడు"
      ],
      "english": [
        "Budhdhiyu Balamu Jnyaanamu Prabhuvae",
        "Thana Neethi Bahu Unnathamainadhi",
        "Sainyamula Kadhipathi Naa Thoadu"
      ]
    }
  ]
}
