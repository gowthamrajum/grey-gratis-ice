{
  "song_name": "O sodaraa anduko",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Dr A R Stevenson"
    ],
    "రచన": [
      "డాక్టర్ ఏ ఆర్ స్టీవెన్సన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఓ సోదరా అందుకో ఈ స్వాగత కుసుమాంజలి",
      "ఫీమేల్ సింగర్",
      "ఓ సోదరా అందుకో ఈ స్వాగత కుసుమాంజలి",
      "మేలుదొరికె నేడు చూసుకో నీ జీవితం పండించుకో /2/"
    ],
    "english": [
      "O sodaraa anduko ee swaagatha kusumaanjali",
      "Female Singer",
      "O sodaraa anduko ee swaagatha kusumaanjali",
      "Meludhorike nedu choosuko nee jeevitham pandinchuko /2/"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తలితండ్రుల విడచి – తన ఇంటిని మరచి",
        "నీతోనె లోకమై జీవించగా /2/",
        "కలకాలం ఈ ధరలో నీతో నడువ /2/",
        "నీముందర నిలచే సతి చేయి అందుకో /ఓ/",
        "ఓ సోదరి అందుకో ఈ స్వాగత కుసుమాంజలి",
        "వెలుగుతో నిన్ను నింపుకో నీజీవితం పండించుకో"
      ],
      "english": [
        "Thalidhandrula vidachi – Thana intini marachi",
        "Neethone lokamai jeevinchagaa /2/",
        "Kalakaalam ee dharalo neetho naduva /2/",
        "Neemundhara nilache sathi cheyi anduko /O/",
        "O sodari anduko ee swaagatha kusumaanjali",
        "Velugutho ninnu nimpuko neejeevitham pandinchuko"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పుట్టినింటి ఘనత – తరతరములు నిలుప",
        "నీ భర్త గౌరవం కాపాడగా /2/",
        "అణకువతో మెళకువతో ఇంటిని తీర్చ /2/",
        "వినయముతో నిను పతికి అర్పించుకో /ఓ/",
        "ఓ సోదరా అందుకో ఈ స్వాగత కుసుమాంజలి",
        "వెలుగుతో నిన్ను నింపుకో నీజీవితం పండించుకో"
      ],
      "english": [
        "Puttininti ghanatha – Tharatharamulu nilupa",
        "Nee bhartha gauravam kaapaadagaa /2/",
        "Anakuvatho melakuvatho intini theercha /2/",
        "Vinayamutho ninu pathiki arpinchuko /O/",
        "O sodaraa anduko ee swaagatha kusumaanjali",
        "Velugutho ninnu nimpuko neejeevitham pandinchuko"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "(పరలోక సైన్యం తిలకించుచుండ – పరిశుద్ధుల సంఘం ప్రార్ధించుచుండ /2/",
        "అనురాగం ఐక్యతతో జతకమ్మని /2/) ఫస్ట్ ఫీమేల్ అండ్ దెన్ మేల్ ఈచ్ లైన్",
        "పలికింది ప్రకృతి ఈ స్వాగతం /ఓ/"
      ],
      "english": [
        "(Paraloka sainyam thilakinchuchunda – Parishuddhula sangham praardhinchuchunda /2/",
        "Anuraagam aikyathatho jathakammani /2/) First female and then male each line",
        "Palikindhi prakruthi ee swaagatham /O/"
      ]
    }
  ]
}
