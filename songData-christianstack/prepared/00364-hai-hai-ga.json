{
  "song_name": "Hai Hai Ga",
  "author": {
    "Authored by": "Daniel M",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఓ క్రొత్త పాటపాడి నా యేసయ్య ఎదుట",
      "ఉత్సాహంతో నేను ఆడనా",
      "సంగీత గానముతో ఉత్సాహ ధ్వనులతో",
      "యేసయ్య కీర్తి చాటనా"
    ],
    "english": [
      "Oh krottha paatapaadi naa yesayya edhuta",
      "uthsaahamtho nenu aadanaa",
      "sangeetha gaanamutho uthsaaha dhwanulatho",
      "yesayya keerthi chaatanaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హాయి హాయిగా నేను పాడనా",
        "ఎల్లవేళల హల్లెలూయ పాట పాడనా"
      ],
      "english": [
        "Haayi haayigaa nenu paadanaa",
        "ellavelala halleluya paata paadanaa"
      ]
    }
  ]
}
