    {
      "stanza_number": 6,
      "telugu": [
        "నిజమైన దేవా నీలా ఎవరయ్యా",
        "యేసు క్రీస్తు ప్రభువా నీవే నిజ రక్షకా"
      ],
      "english": [
        "Nijamaina Dhevaa neela evarayya",
        "Yesu Kreesthu Prabhuvaa neeve nija rakshakaa"
      ]
