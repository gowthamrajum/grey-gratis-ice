{
  "song_name": "Nee Premey",
  "author": {
    "Authored by": "Revanth Reynold & Reshma Reigna",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ ప్రేమే నాతో పలికే ప్రతిదినం",
      "నన్ను నడిపే ప్రతిక్షణం",
      "నాతో నడిచే నీ ప్రేమే నీ ప్రేమే"
    ],
    "english": [
      "Nee premey naatho palike prathidinam",
      "nannu nadipe prathikshanam",
      "naatho nadiche nee premey nee premey"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "Bridge:",
        "నా యేసు నీ కృప వెన్నంటి నిలచినా",
        "నీ మాట చాటున సంద్రాలు దాటనా"
      ],
      "english": [
        "Bridge:",
        "Naa yesu nee krupa vennanti nilachina",
        "nee maata chaatuna sandraalu daatana"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "Outro:",
        "రెక్కల పైన మోసావే",
        "నాతో నీవు నడిచావే"
      ],
      "english": [
        "Outro:",
        "Rekkala paina moasaavea",
        "naatoa neevu naDichaavea"
      ]
    }
  ]
}
