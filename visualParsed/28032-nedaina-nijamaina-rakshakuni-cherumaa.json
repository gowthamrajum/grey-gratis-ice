  "main_stanza": {
    "telugu": [
      "నేడైనా నిజమైన రక్షకుని చేరుమా",
      "పాడైన నీ స్థితిలో స్వస్థతను కోరుమా",
      "నా దేశమా – నా భారతదేశమా",
      "నువ్వొస్తే మనసిస్తే మార్చబడతావు",
      "నా క్రీస్తే సెలవిస్తే బాగుపడతావు",
      "నా దేశమా – నా భారతదేశమా"
    ],
    "english": [
      "Nedainaa nijamaina rakshakuni cherumaa",
      "Paadaina nee sthithilo svasthathanu korumaa",
      "Naa deshamaa – Naa bhaarathadheshamaa",
      "Nuvvosthe manasisthe maarchabadathaavu",
      "Naa Kreesthe selavisthe baagupadathaavu",
      "Naa deshamaa – Naa bhaarathadheshamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
