{
  "song_name": "Oka aasha undayyaa naa korika theerchayyaa",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Pastor Anand Babu"
    ],
    "రచన": [
      "పాస్టర్ ఆనంద్ బాబు"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఒక ఆశ ఉందయ్యా నా కోరిక తీర్చయ్యా",
      "నా మనవిను యేసయ్యా ప్రత్యుత్తరమిమ్మయ్య",
      "యవనకాలమందు నీ కాడి మోయగా",
      "బలమైన విల్లుగా నన్ను మార్చవా"
    ],
    "english": [
      "Oka aasha undayyaa naa korika theerchayyaa",
      "Naa manavinu Yesayyaa prathyuttharamimmayya",
      "Yavanakaalamandhu nee kaadi moyagaa",
      "Balamaina villugaa nannu maarchavaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యూదుల రక్షణకై రాజు శాసనము మార్చి-",
        "ఎస్తేరు ఆశను తీర్చిన దేవా",
        "ఈ తరములో మా మనవులను ఆలకించవా –",
        "మా దేశములో మహా రక్షణ కలుగజేయవా"
      ],
      "english": [
        "Yoodula rakshanakai raaju shaasanamu maarchi-",
        "Estheru aashanu theerchina Deva",
        "Ee tharamulo maa manavulanu aalakinchavaa –",
        "Maa deshamulo mahaa rakshana kalugajeyavaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నత్తివాడైనను ఫరో ఎదుట నిలబెట్టి-",
        "మోషే ఆశను తీర్చిన దేవా",
        "ఈ తరములో నీ చిత్తముకై ఎదురు చూడగా",
        "అగ్ని చేత నను దర్శించి నీ చిత్తము తెలుపవా"
      ],
      "english": [
        "Natthivaadainanu Pharo eduta nilabetti-",
        "Moshe aashanu theerchina Deva",
        "Ee tharamulo nee chitthamukai eduru choodagaa",
        "Agni chetha nanu darshinchi nee chitthamu thelupavaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మేడ గదిలో అగ్నివoటి ఆత్మతో నింపి-",
        "అపోస్తులల ఆశను తీర్చిన దేవా",
        "ఈ తరములో నీ సేవకై మేము నిలువగా",
        "అగ్ని వంటి ఏడంతల ఆత్మతో ఆశ తీర్చవా"
      ],
      "english": [
        "Meda gadhilo agnivanti aathmatho nimpi-",
        "Aposthalula aashanu theerchina Deva",
        "Ee tharamulo nee sevakai memu niluvagaa",
        "Agni vanti edanthala aathmatho aasha theerchavaa"
      ]
    }
  ]
}
