      ],
      "english": [
        "Atuchesi ituchesi andarini mosam chesi",
        "Sanghaanni renduga cheelchaave ayyayyo",
        "Nee gothilo nuvve paddaave ayyayyo!"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నువు వేసిన వేషాలు నువు చేసిన మోసాలు",
        "నరకాగ్నికి నిను చేర్చునులే అయ్యయ్యో",
