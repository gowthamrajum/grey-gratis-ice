      "కమనీయమైన కళ్యాణమే"
    ],
    "english": [
      "Kaliseti andaala anubandhame",
      "Idi enaatikainaa mahaneeyame",
      "Ennenno kaalaala anuraagame",
      "Eenaade ilalo shreekaarame",
      "Kamaneeyamaina kalyaaname"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇరువురు ఏకమై జీవించాలి",
