  "main_stanza": {
    "telugu": [
      "తంబుర సితారతో - మా ప్రభుని ఆరాధించెదము",
      "తన నివాసముగ - మమ్ము సృష్టించిన",
      "నాథుని పొగడెదము స్తుతిగానము చేసెదము"
    ],
    "english": [
      "Thambura sithaaratho - Maa prabhuni aaraadhinchedamu",
      "Thana nivaasamuga - Mammu srushtinchina",
      "Naathuni pogadedhamu sthuthigaanamu chesedamu"
    ]
  },
  "stanzas": [
    {
