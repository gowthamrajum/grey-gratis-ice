{
  "song_name": "Hrudhaya Marpinchedhamu Prabhunaku",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "హృదయ మర్పించెదము ప్రభునకు స్తుతి ప్రశంసలతో పరిశుద్దులము చేరి"
    ],
    "english": [
      "Hrudhaya Marpinchedhamu Prabhunaku Sthuthi Prashamsalatho Parishudhdhulamu Cheri"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపభారము మోయన్ వచ్చె నేసు జగతిన్",
        "పాపుల పాపము తొలగించుటకు నిత్యజీవము నిచ్చెన్"
      ],
      "english": [
        "Paapabhaaramu Moyan Vachche Nesu Jagathin",
        "Paapula Paapamu Tholaginchutaku Nithyajeevamu Nichchen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సంకట క్లేశము భరించెన్ నమ్రతతో దీనుడై",
        "రక్షణ ద్వారము తెరచెను ప్రభువు నిత్య నిరీక్షణ నిచ్చెన్"
      ],
      "english": [
        "Sankata Kleshamu Bharinchen Namrathatho Dheenudai",
        "Rakshana Dhvaaramu Therachenu Prabhuvu Nithya Nireekshana Nichchen"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆశ్చర్య పరలోక ప్రేమ పాపులమగు మనకే",
        "తిరిగి వెళ్ళకు పాపమునకు నిలువకు పాపములో"
      ],
      "english": [
        "Aashcharya Paraloka Prema Paapulamagu Manake",
        "Thirigi Vellaku Paapamunaku Niluvaku Paapamulo"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "అర్పించెదము ప్రభువా ఆత్మ ప్రాణ దేహం",
        "కాపాడు మా జీవితముల ఇదియే మా వినతి"
      ],
      "english": [
        "Arpinchedhamu Prabhuvaa Aathma Praana Dheham",
        "Kaapaadu Maa Jeevithamula Idhiye Maa Vinathi"
      ]
    }
  ]
}
