  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సరస్సు ప్రక్కన రొట్టెలను",
        "వడ్డించునట్లుగా నాకు",
        "ప్రభూ! నీ జీవాహారము వడ్డించుము",
        "అదే నా యాత్మకెంతో ప్రియము"
      ],
      "english": [
        "Sarassu prakkana rottelanu",
        "Vaddinchunatlugaa naaku",
        "Prabhoo! Nee jeevaahaaramu vaddinchumu",
        "Adhe naa yaathmakentho priyamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "రొట్టెలను దీవించిన ప్రకారము",
        "నన్ను సత్యంబుతో దీవించుము",
        "కీడులోనుండి నన్ రక్షించుము",
        "నీ శాంతి నకనుగ్రహించుము"
      ],
      "english": [
        "Rottelanu deevinchina prakaaramu",
        "Nannu sathyambutho dheevinchumu",
        "Keedulonundi nan rakshinchumu",
        "Nee shaanthi nakanugrahinchumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గలిలయ యందు నీ శిష్యులు",
        "జీవించునట్లుగా నాకు నేర్పు",
        "నా చింతలన్నిటిన్ జయించుచు",
        "జీవుడవైన నిన్ను జూతును"
      ],
      "english": [
        "Galilaya yandu nee shishyulu",
        "Jeevinchunatlugaa naaku nerpu",
        "Naa chinthalannitin jayinchuchu",
        "Jeevudavaina ninnu joothunu"
      ]
    }
  ]
