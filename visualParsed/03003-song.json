  "main_stanza": {
    "telugu": [
      "సిల్వయొద్దఁ జేరుదున్",
      "బీద హీనయంధుఁడన్",
      "లోకమున్ త్యజింతును",
      "పూర్ణముక్తి నొందుదున్",
      "||కర్త, నిన్నె నమ్ముదున్",
      "కల్వరీ గొఱ్ఱెపిల్లా",
      "మోకరించి వేఁడెదన్",
      "నన్నుఁ గావుమో ప్రభో!||"
    ],
    "english": [
      "Silvayodhdha jerudhun",
      "beeda heenayandhudan",
      "lokamun thyajinthunu",
      "poornamukthi nondhudhun",
      "||Kartha, ninne nammudhun",
      "Kalvaree gorrepillaa",
      "mokarinchi vededan",
      "nannu gaavumo prabho!||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "నిన్ నేఁజేరఁ గోరఁగా",
        "నన్ను ఁబాయు పాపము",
        "శుద్ధిఁజేతునంచును",
        "యేసు మాటనిచ్చెను."
      ],
      "english": [
        "Nin nejera goragaa",
        "nannu baayu paapamu",
        "shuddhi jethunanchunu",
        "Yesu maatanichchenu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నన్ను ను నా మిత్రులన్",
        "లోక యాస్తిఁ గాలమున్",
        "దేహయాత్మయంతయు",
        "నీకర్పింతునిప్పుడు."
      ],
      "english": [
        "Nannunu naa mithrulan",
        "loka yaasthi gaalamun",
        "dhehayaathmayanthayu",
        "neekarpinthunippudu."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "యేసుమాట నమ్మెదన్",
        "క్రీస్తు రక్త పుణ్యముఁ",
        "జూచి మ్రొక్కి యేసుతో",
        "నేను మృతినొందితిన్."
      ],
      "english": [
        "Yesumaata nammedhan",
        "Kreesthu raktha punyamu",
        "joochi mrokki Yesutho",
        "nenu mruthinondhithin."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసు తాను వచ్చును",
        "నాకు నిచ్చు పూర్ణతన్",
        "శుద్ధ సౌఖ్య మొందుదున్",
        "జయస్తోత్ర మేసుకు."
      ],
      "english": [
        "Yesu thaanu vachchunu",
        "naaku nichchu poornathan",
        "shudhdha saukhya mondhudhun",
        "jayasthothra mesuku."
      ]
    }
  ]
