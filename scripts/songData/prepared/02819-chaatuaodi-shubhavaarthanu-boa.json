{
  "song_name": "Chaatudi Shubhavaarthanu Boadhakulaaraa",
  "author": {
    "Authored by": "",
    "రచన": "పులిపాక జగన్నాధము"
  },
  "main_stanza": {
    "telugu": [
      "చాటుఁడి శుభవార్తను బోధకులారా చాటుఁడి శుభవార్తను",
      "జాటుఁ డి శుభవార్త సకల రాష్ట్రములలోఁ",
      "జాటించుఃడని చెప్పె ఢాటిగఁ ప్రభు యేసు"
    ],
    "english": [
      "Chaatudi Shubhavaarthanu Boadhakulaaraa Chaatudi Shubhavaarthanu",
      "Jaatu Di Shubhavaartha Sakala Raashtramulaloa",
      "Jaatinchuhdani Cheppe Daatiga Prabhu Yaesu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకమును ప్రేమించి లోకరక్షణ కొఱకు",
        "ప్రాకటంబుగ సుతునిఁ బంపె దేవుఁడటంచుఁ"
      ],
      "english": [
        "Loakamunu Praeminchi Loakarakshana Koraku",
        "Praakatambuga Suthuni Bampe Dhaevudatanchu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శత్రువుల రక్షింప మిత్రుఁడుగా వచ్చి",
        "మైత్రి నసుపు నిచ్చి మరల లేచెన టంచుఁ"
      ],
      "english": [
        "Shathruvula Rakshimpa Mithrudugaa Vachchi",
        "Maithri Nasupu Nichchi Marala Laechena Tanchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎట్టి పాపు లైనఁ బట్టి యేసుని మాట",
        "దిట్టముగ నమ్మినఁ బట్టుగ క్షమియించుఁ"
      ],
      "english": [
        "Etti Paapu Laina Batti Yaesuni Maata",
        "Dhittamuga Nammina Battuga Kshamiyinchu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "హృదయ శుద్ధిని గోరి సదయుఁడగు రక్షకునిఁ",
        "పదిలముగఁ ప్రార్ధింపఁ పరిశుద్ధాత్మ నొసంగుఁ"
      ],
      "english": [
        "Hrudhaya Shudhdhini Goari Sadhayudagu Rakshakuni",
        "Padhilamuga Praardhimpa Parishudhdhaathma Nosangu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నమ్మి బాప్తిస్మంబు నెమ్మిఁ బొందిన మనుజు",
        "లిమ్ముగఁ బొందుదు రిలను ఘన రక్షణముఁ"
      ],
      "english": [
        "Nammi Baapthismambu Nemmi Bondhina Manuju",
        "Limmuga Bondhudhu Rilanu Ghana Rakshanamu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఇందు నందు మికుఁ బొందుగ నొసఁగును",
        "సందియము లేకుండ సకల భాగ్యము లనుచుఁ"
      ],
      "english": [
        "Indhu Nandhu Miku Bondhuga Nosangunu",
        "Sandhiyamu Laekunda Sakala Bhaagyamu Lanuchu"
      ]
    }
  ]
