      ],
      "english": [
        "Mana kosam puttaadu",
        "Aashcharyakarudu aalochanakartha",
        "Balavanthudaina Devude naa Yesayya",
        "Ho..nithyudavagu thandree samaadhaanakartha",
        "Karunaamoorthi naa Yesayya",
        "Nee jananam bandhakaalaku",
        "Vimochanaa tharunam ॥2॥"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాపముల భయమునుండి",
