  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్షణంపు వార్తను విని - రక్షకుండగు యేసుని",
        "పిల్పుకు లోబడెదవా - అలయక యేసును జూతువా",
        "నమ్మిరమ్ము నమ్మిరమ్ము - ఇమ్ముగ బ్రతుకుము",
        "నమ్మిరమ్ము నమ్మిరమ్ము - ఇమ్ముగ బ్రతుకుము"
      ],
      "english": [
        "Rakshanampu vaarthanu vini - Rakshakundagu Yesuni",
        "Pilpuku lobadedhavaa - Alayaka Yesunu joothuvaa",
        "Nammirammu nammirammu - Immuga brathukumu",
        "Nammirammu nammirammu - Immuga brathukumu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వేసవి కాలమెల్ల గడిపి - కోతల ననుభవించితి",
        "వేసవి వర్షమును చూచితివి - ఇంక పాపమందున్నావే"
      ],
      "english": [
        "Vesavi kaalamella gadipi - Kothala nanubhavinchithi",
        "Vesavi varshamunu choochithivi - Inka paapamandhunnaave"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యేసు నీ తీర్మానముకై - వేచియుండగా తీర్మానించు",
        "ఆత్మ పోరాడుచున్నప్పుడే - అప్పగించుకో ప్రక్కజూచి"
      ],
      "english": [
        "Yesu nee theermaanamukai - Vechiyundagaa theermaaninchu",
        "Aathma poraaduchunnappude - Appaginchuko prakkajoochi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "తగుదునా యని యను కొనక - వేరు స్పర్శల నొందకుము",
        "తలంపు కాదు నమ్మికయే - ఆత్మ ముద్రనిచ్చును"
      ],
      "english": [
        "Thagudunaa yani yanu konaka - Veru sparshala nondhakumu",
        "Thalampu kaadu nammikaye - Aathma mudhranichchunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "చిత్తము దేవదత్తముజేయ - ప్రాయశ్చిత్త రక్తము నమ్ము",
        "నాకమందుండు యేసుని చూడు - మారని వాక్యమును చేరుము"
      ],
      "english": [
        "Chitthamu dhevadhatthamujeya - Praayashchittha rakthamu nammu",
        "Naakamandhundu Yesuni choodu - Maarani vaakyamunu cherumu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "యెషయా ఒకటి పదునెమ్మిది - నలభై ఐఫు ఇరవై రెండును",
        "యేసు అరచి చెప్పుదాని - ఆయనన్ కూడ పొందుము"
      ],
      "english": [
        "Eshayaa okati padhunemmidhi - Nalabhai aidu iravai rendunu",
        "Yesu arachi cheppudhaani - Aayanan kooda pondumu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యిర్మియా ఎన్మిదిరవైయును - రెండవ కొరింథీ ఆరు రెండును",
        "కార్యములు నాలుగు పండ్రెండును - పొంది హల్లెలూయ పాడుమా"
      ],
      "english": [
        "Irmiyaa enmidhiravaiyunu - Rendava Korinthee aaru rendunu",
        "Kaaryamulu naalugu pandrendunu - Pondi halleluya paadumaa"
      ]
    }
  ]
