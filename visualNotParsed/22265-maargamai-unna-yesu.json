  "main_stanza": {
    "telugu": [
      "మార్గమై ఉన్న యేసు",
      "నీ మార్గములో నను నడుపు",
      "జీవమై ఉన్న క్రీస్తు",
      "నీ జీవముతో నను నింపు",
      "సత్య మానలో వసియించుమా",
      "నీ రూపముకు మార్చుమా",
      "ఓ ఓ ఓ ఓ ఓ ఓ",
      "గమ్యం లేని ప్రయాణం",
      "నీ నుండి చేసెను దూరం",
      "నా జీవితములో పాపం",
      "హరించివేసెను జీవం",
      "సత్య స్వరూపమా కనిపించవా",
      "నే నిన్ను చూడగ కనులీయవా",
      "నీ చెంతకే చేర్చవా",
      "అంతే లేని ఈ లోకం",
      "పాపం శాపముకు మూలం",
      "లోకం దాని వైభోగం",
      "గాఢందకార విశాలం",
      "జీవన దాయకా కృప చూపవా",
      "నీ నిత్య జీవమే వరమీయవా",
      "నీ కాంతిలో నిలుపవా"
    ],
