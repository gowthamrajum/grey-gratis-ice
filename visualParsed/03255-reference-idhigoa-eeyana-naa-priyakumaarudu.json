{
  "song_name": "Idigo eeyana naa priyakumaarudu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఆనందమానంద మాయెను - నాదు",
      "ప్రియకుమారుని యందు - మహాదానంద",
      "నా తనయుని మాట వినండని",
      "శబ్దమొక్కటి యా మేఘములో",
      "ఉద్భవించె నద్భుతముగ"
    ],
    "english": [
      "Aanandhamaanandha maayenu - Naadu",
      "Priyakumaaruni yandu - Mahaadhaanandha",
      "Naa thanayuni maata vinandani",
      "Shabdhamokkati yaa meghamulo",
      "Udbhavinche nadbhuthamuga"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమించుచున్నాను నీతిని - దుర్నీతిని ద్వేషించినావు - నీవు",
        "అందుచే నీతోటి వారికంటె - ఆనంద తైలముతో తండ్రి నిన్ను",
        "అధికంబుగ నభిషేకించెను ǁమహానందమానంద"
      ],
      "english": [
        "Preminchuchunnaanu neethini - Dhurneethini dhveshinchinaavu - Neevu",
        "Andhuche neethoti vaarikante - Aananda thailamutho thandri ninnu",
        "Adhikambuga nabhishekinchenu ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అంత్య దినముల యందున - ఆ వింత కుమారుని ద్వరా - ఈ",
        "మానవులతోడ మాట్లాడెను - సర్వంబునకు తండ్రి తనయుని",
        "వారసునిగా నియమించెను ǁమహానందమానంద"
      ],
      "english": [
        "Anthya dinamula yanduna - Aa vintha kumaaruni dwaaraa - Ee",
        "Maanavulathoda maatlaadenu - Sarvambunaku thandri thanayuni",
        "Vaarasunigaa niyaminchenu ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "తనయుండె ఆ తండ్రి మహిమ - ఆ తత్వంపు రూపంబు తానే",
        "మహాత్మ్యమైనట్టి మాటచేత - నమస్తమును నిర్వహించుచు",
        "అందరిలో అతి శ్రేష్టుండాయె ǁమహానందమానంద"
      ],
      "english": [
        "Thanayunde aa thandri mahima - Aa thathvampu roopambu thaane",
        "Mahaathmyamainatti maatachetha - Samasthamunu nirvahinchuchu",
        "Andarilo athi shreshtundaaye ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీవు నాదు కుమారుండవు - నిన్ను ప్రేమించి కన్నాను నేను - నేడు",
        "దండిగ తనయుని ముద్దాడెను - నిండుగాయన నాశ్రయించుడి",
        "రండి రండి ధన్యులు కండి ǁమహానందమానంద"
      ],
      "english": [
        "Neevu naadu kumaarundavu - Ninnu preminchi kannaanu nenu - Nedu",
        "Dhandiga thanayuni mudhdhaadenu - Nindugaayana naashrayinchudi",
        "Randi randi dhanyulu kandi ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "విజ్ఞాన సంపాద లెల్లను - ఆ సుజ్ఞానిలో గుప్తమాయెను - ఆ",
        "సంతోషమును పరిశుద్ధత - నమాధానము నీతి శక్తియు",
        "విమోచన మాయెను యేసు ǁమహానందమానంద"
      ],
      "english": [
        "Vijnaana sampaadha lellanu - Aa sujnaanilo gupthamaayenu - Aa",
        "Santhoshamunu parishuddhatha - Samaadhaanamu neethi shakthiyu",
        "Vimochana maayenu Yesu ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "అందరికన్నా నీవెంతనో అతి సుందరుడవై యున్నావు - నీవు",
        "నీ పెదవులమీద పోయబడి - నిండి యున్నది దయారసము",
        "నిన్నాశీర్వదించెను తండ్రి ǁమహానందమానంద"
      ],
      "english": [
        "Andharikannaa neeventhano athi sundharudavai yunnaavu - Neevu",
        "Nee pedhavulameedha poyabadi - Nindi yunnadi dhayaarasamu",
        "Ninnaasheervadhinchenu thandri ||Mahaanandhamaanandha||"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "దివ్య రారాజై కుమారుడు - ఒక వెయ్యి వర్షాలు పాలించును - మహా",
        "అంతము లేని రాజ్యమేలును - ఎందరు జయంబు నొందుదురో",
        "అందరును పాలించెదరు ǁమహానందమానంద"
      ],
      "english": [
        "Divya raaraajai kumaarudu - Oka veyyi varshaalu paalinchunu - Mahaa",
        "Anthamu leni raajyamelunu - Endaru jayambu nondhudhuro",
        "Andharunu paalinchedharu ||Mahaanandhamaanandha||"
      ]
    }
  ]
}
