  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ధనధాన్యములు సర్వసంపదలు",
        "సర్వ సుఖములు నిను కోరలేదు",
        "నీ ప్రేమ నీ కరుణ నీ కృపయే చాలు",
