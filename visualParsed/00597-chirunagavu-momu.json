        "దరను వీడి ఆల నరులకొరకు ఇల",
        "కురిసే కరుణ రుధిరం"
      ],
      "english": [
        "Thrunapraaya jeevithamu niluvella vishamayamu",
        "Vidudala kaanaraadhu janmakarmadharmamutho",
        "Nararoopadhaarigaa ekaika suthunigaa",
        "Dharanu veedi aala narulakoraku ila",
        "Kurise karuna rudhiram"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఇరుకైన ఈగమనం విశ్వాస యానం",
        "త్రోవనిశాలం నరకమే అంతం",
        "రక్షణ వెదకిన పాపము వీడిన",
        "జేర్చు చెంతకు నొసగు వరములు",
        "తెరచు పరము మనకు"
      ],
      "english": [
        "Irukaina eegamanam vishwaasa yaanam",
        "Throvanishaalam narakame antham",
        "Rakshana vedakina paapamu veedina",
        "Jerchu chenthaku nosagu varamulu",
        "Therachu paramu manaku"
      ]
    }
  ]
