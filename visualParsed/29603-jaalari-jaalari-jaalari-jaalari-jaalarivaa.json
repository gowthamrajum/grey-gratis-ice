  },
  "main_stanza": {
    "telugu": [
      "జాలరి జాలరి జాలరి జాలరి జాలరివా యేసు జారి పోయిన వారి కోసం వచ్చేవా"
    ],
    "english": [
      "Jaalari jaalari jaalari jaalari jaalarivaa Yesu jaari poyina vaari kosam vachchevaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒంకరిగా ఉన్న వారిని వడివడిగా పిలిచేవా",
        "ఒంగిపోయిన ఆ స్త్రీని ముట్టి బాగు చేసేవా",
        "మారు మనస్సు పొందుటకు పాపులను పిలిచేవా",
        "మార్పు లేని వారికి మార్గము చూపేవా",
        "కుష్టి రోగిని ముట్టేవా కృంగిన వారిని చూసేవా",
        "మార్గమధ్యలోనా సమరయ స్త్రీని మార్చేవా",
        "అపవాదిని చూసేవా ఆపదలు మార్చేవా",
        "ఆటంకం చూసి అపవాదిని తొక్కేవా"
      ],
      "english": [
        "Vankarigaa unna vaarini vadivadigaa pilichevaa",
        "Ongipoyina aa sthreeni mutti baagu chesevaa",
        "Maaru manassu pondutaku paapulanu pilichevaa",
        "Maarpu leni vaariki maargamu choopevaa",
        "Kushti rogini muttevaa krungina vaarini choosevaa",
        "Maargamadhyalonaa samaraya sthreeni maarchevaa",
        "Apavaadhini choosevaa aapadhalu maarchevaa",
        "Aatankam choosi apavaadhini thokkevaa"
      ]
    }
  ]
}
