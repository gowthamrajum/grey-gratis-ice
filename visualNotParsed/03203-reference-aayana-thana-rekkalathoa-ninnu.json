{
  "song_name": "Aayana thana rekkalatho ninnu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సర్వోన్నతుని చాటున నివసించెడి వాడే",
        "సర్వశక్తుని నీడను విశ్రమించును పరమ ధన్యత యిదియే",
        "తన రెక్కల క్రింద ఆశ్రయము - తన రెక్కలతో కప్పును"
      ],
      "english": [
        "Sarvonnathuni chaatuna nivasinchedi vaade",
        "Sarvashakthuni needanu vishraminchunu parama dhanyatha idiye",
        "Thana rekkala krinda aashrayamu - Thana rekkalatho kappunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఆయనే నా ఆశ్రయము - నా కోటయు దుర్గమును",
        "ఆయన సత్యము నా కేడెమును నేనమ్ముకొను దేవుడు"
      ],
      "english": [
        "Aayane naa aashrayamu - Naa kotayu durgamunu",
        "Aayana sathyamu naa kedemunu nenammukonu devudu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పగటి బాణమున కైనా రాత్రి భయమున కైనా",
        "చీకటిలో తిరిగు తెగులుకైనా నేనేమి భయపడను"
      ],
      "english": [
        "Pagati baanamuna kainaa raathri bhayamuna kainaa",
        "Cheekatilo thirigu thegulukainaa nenemi bhayapadanu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేయి పదివేలు కుడిప్రక్కను కూలినను",
        "దయచూపు దేవుడు నీకుండ అపాయము రాదు"
      ],
      "english": [
        "Veyi padhivelu kudiprakkanu koolinanu",
        "Dayachoopu devudu neekunda apaayamu raadu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నీ ప్రభువాశ్రయమే యెహోవా నివాసం",
        "అపాయము తెగులు - నీ గుడారము సమీపించవు"
      ],
      "english": [
        "Nee prabhuvaashrayame Yehova nivaasam",
        "Apaayamu thegulu - Nee gudaaramu sameepinchavu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "నీదు మార్గంబులలో - నిన్ను దూతలు కాయున్",
        "పాదములకు రాయి తగులకుండ నిన్నెత్తికొందురు"
      ],
      "english": [
        "Needu maargambulalo - Ninnu doothalu kaayun",
        "Paadamulaku raayi thagulakunda ninnetthikonduru"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "కొదమ సింహముల నాగుపాముల నణచెదవు",
        "అతడు నా నామము నెరిగెను అతని తప్పించెదను"
      ],
      "english": [
        "Kodama simhamula naagupaamula nanachedavu",
        "Athadu naa naamamu nerigenu athani thappinchedhanu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "అతడు నను ప్రేమించెన్ - నామమున మొఱ్ఱపెట్టెన్",
        "అతని విడిపించి ఘనపరతున్ అతని కుత్తరమిత్తున్"
      ],
      "english": [
        "Athadu nanu preminchen - Naamamuna morrapetten",
        "Athani vidipinchi ghanaparathun athani kuttharamitthun"
      ]
    }
  ]
}
