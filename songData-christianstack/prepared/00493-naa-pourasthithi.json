{
  "song_name": "Naa Pourasthithi",
  "author": {
    "Authored by": "A R Stevenson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా పౌర స్థితి పరమందున్నది",
      "ఇల నా ఉనికి అస్థిరమైనది",
      "యాత్రికుడననీ నేనెరుగుదును",
      "ఒక నాడు నా యింటికి చేరెదను"
    ],
    "english": [
      "Naa Pourasthithi paramandhunnadhi",
      "ila naa uniki asthiramainadhi",
      "yaathrikudanani ne nerugudhunu",
      "oka naadu naa intiki cheredhanu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నాశనకరమైన గుంటను పోలిన",
        "లోకమునుండి లాగబడియున్నాను",
        "తిరిగి జన్మించిన పరదేశీయుడను",
        "పరలోక పిలుపును ఎరిగియున్నాను",
        "నరులారా తిరిగి రండని పిలిచిన",
        "నేనూ అచటికి వెళ్లిపోవలయును",
        "నిత్యత్వమందున దేవునితో ఉందును",
        "పరలోక మహిమను అనుభవించెదను"
      ],
      "english": [
        "Naasanakaramaina guntanu polina",
        "lokamunundi laagabadiyunnaanu",
        "thirigi janminchina paradheseeyudanu",
        "paraloka pilupunu erigiyunnaanu",
        "Narulaaraa thirigi randani pilichina",
        "nenu achatiki vellipovalayunu",
        "nithyathwamandhuna dhevunitho undhunu",
        "paraloka mahimanu anubhavinchedhanu"
      ]
    }
  ]
}
