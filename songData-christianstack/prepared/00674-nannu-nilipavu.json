  "main_stanza": {
    "telugu": [
      "నన్ను నిలిపావు – నన్ను నడిపావు",
      "నాకోసమే నీవు నలుగగొట్టబడినావు",
      "నీ త్యాగమే నన్ను బలపరిచెను",
      "హల్లెలూయా… హల్లెలూయా…"
    ],
    "english": [
      "Nannu nilipaavu – nannu nadipaavu",
      "naa kosame neevu nalugagottabadinaavu",
      "nee thyagame nannu balaparachenu",
      "hallelujah….hallelujah…."
    ]
  },
