        "Nivu Chepina Kanikaram Nivu Nerpina Satvikam",
        "Anugrahimchi Nadipimchuma"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఇహలోకభోగముపై మనసుంచక",
        "పరలోక భాగ్యముపై క్ష్యముంచగ",
        "నీకెంతో ఇష్టులై ధరలో నీ సాక్షులై",
        "సాగే కృప దయచేయుమా"
      ],
      "english": [
        "Ehalokabogamupai Manasumchaka",
