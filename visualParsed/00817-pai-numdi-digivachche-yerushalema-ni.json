    "english": [
      "Pai nundi dhigivachche Yerushalemaa",
      "Nee samayam sampoornamaa ee gadiyaku . . (2)",
      "Raajaadhi raajunaku aahvaanamu",
      "Prabhuvula prabhuvuku jayageethamu (2)",
      "Dhagadhaga meriyuchu sogasuga nunnaadhi aa divya nagari",
      "Thalathala mantu prathibhimbisthundhi (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భూలోక గోళముపై దైవపుత్ర సహవాసం",
        "హృదయాలలో ఒక్కటిగ జేరి ఆత్మ పూర్ణులైతిరి",
        "చేనెలోని ద్రవ్యమా మేలిమైన ముత్యమా",
        "సంతసించు ఉల్లసించు వేచిన నీ దినము వచ్చె"
      ],
      "english": [
        "Bhooloka golamupai dhaivaputhra sahavaasam",
        "Hrudayaalalo okkatiga jeri aathma poornulaithiri",
        "Cheneloni dhravyamaa melimaina muthyamaa",
        "Santhasinchu ullasinchu vechina nee dinamu vachche"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరలోక పట్టనము రతనాల రమణియం",
        "వివిధ వర్ణ భూషితము సృష్టి కర్త నైపుణ్యం",
        "జేష్టులైన బృందమా కీర్తిగొన్న నేస్తమా",
        "దవళవస్త్ర సైన్యమా నింగి నేల నేలుమా"
      ],
      "english": [
        "Paraloka pattanamu rathanaala ramaniyam",
        "Vividha varna bhooshithamu srushti kartha naipunyam",
        "Jeshtulaina brundhamaa keerthigonna nesthamaa",
        "Dhavalavasthra sainyamaa ningi nela nelumaa"
      ]
    }
  ]
