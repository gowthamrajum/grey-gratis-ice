{
  "song_name": "Israyelu Raja",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఇశ్రాయేలు రాజా నీకే స్తోత్రము –",
      "దావీదు తనయ నీకే స్తోత్రము",
      "పరిశుద్ధాత్మ దేవా నీకే స్తోత్రము",
      "త్రియేక దేవా స్తుతి స్తోత్రము"
    ],
    "english": [
      "Israyelu Raja neeke sthothramu",
      "Dhaaveedhu thanayya neeke sthothramu",
      "Parishuddhaathma dhevaa neeke sthothramu",
      "Thriyeka dhevaa sthuthi sthothramu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా సృష్టి కర్తవు నీవే దేవా –",
        "నా శాసన కర్తవు నీవే ప్రభు",
        "నా తండ్రి నీవే – నా తల్లి నీవే",
        "నా ప్రతిరూపము నీవే"
      ],
      "english": [
        "Naa srushtikarthavu neeve dhevaa",
        "Naa shaasanakarthavu neeve prabhu",
        "Naa thandri neeve naa thalli neeve",
        "Naa prathiroopamu neeve"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా రక్షణ కర్తవు నీవే యేసయ్య-",
        "నా ఆలోచన కర్తవు నీవే మెస్సయ్య",
        "నా జీవం నీవే – నిత్యజీవం నీవే",
        "నా అణువణువు నీవే"
      ],
      "english": [
        "Naa rakshanakarthavu neeve Yesayya",
        "Naa aalochanakarthavu neeve Mesayyaa",
        "Naa jeevam neeve nithyajeevam neeve",
        "Naa anuvu neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా ఆదరణ కర్త పరిశుద్ధాత్ముడా –",
        "నా సమాధాన కర్త షాలేము రాజా",
        "నా తోడు నీవే – నా నీడవు నీవే",
        "నా ఆత్మ దీపము నీవే"
      ],
      "english": [
        "Naa aadharanakartha parishuddhaathmudaa",
        "Naa samaadhaanakartha Shaalemu raajaa",
        "Naa thodu neeve naa needavu neeve",
        "Naa aathma dheepamu neeve"
      ]
    }
  ]
}
