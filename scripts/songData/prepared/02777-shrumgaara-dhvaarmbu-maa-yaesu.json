    {
      "stanza_number": 4,
      "telugu": [
        "ఇరుకైన నేమది సరియైన ద్వారంబు",
        "సంకటంబైనను సౌఖ్యన జేర్చు"
      ],
      "english": [
        "Irukaina Naemadhi Sariyaina Dhvaarambu",
        "Sankatambainanu Saukhyana Jaerchu"
      ]
    }
  ]
