{
  "song_name": "Nannu Viduvaka",
  "author": {
    "Authored by": "Dr P Satish Kumar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నను విడువక – నాతో వస్తున్నా",
      "నను మరువక – నను దీవిస్తానన్నా"
    ],
    "english": [
      "nanu viduvaka – naatho vasthunna",
      "nanu maruvaka – nanu deevistannanna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆ.ప:",
        "యేసయ్య నాతో ఉండగా – ఈ వత్సరమే ఓ .. పండగ",
        "హల్లేలూయా – హల్లేలూయా – హల్లేలూయా – హల్లేలూయా"
      ],
      "english": [
        "A.P.:",
        "yesayya naatho undaga – ee vatsarame o.. pandaga",
        "hallelujah – hallelujah – hallelujah – hallelujah"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రతి పనిలో తోడుండి – ప్రతిఫలమే ఇస్తాడన్నా",
        "ప్రతి దినము ప్రతి క్షణము – ప్రాణంగా పోషిస్తాడన్నా",
        "నీడైనా వీడినను – నావెంటే వుంటాడన్నా",
        "చేతుల్లో చెక్కుకుని – నిత్యము నను గమనించే"
      ],
      "english": [
        "1.",
        "Prathi panilo thodundi – prathi phalame istadanna",
        "prathi dinam prathi kshanamu – prananga poshistadanna",
        "needaina veedinanu – naavente vuntadanna",
        "chethullo chekkukoni – nithyamu nanu gamanishe"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అడ్డులనే తొలగించి – అద్దరికే చేరుస్తాడన్నా",
        "ఆదరణే కరువైన – ఆప్యాయత కురిపిస్తాడన్నా",
        "కడవరకు తన కృపతో – నను కాచి కాపాడునన్నా",
        "శత్రువులే లేచినను – నా పక్షముగా పోరాడే"
      ],
      "english": [
        "2.",
        "Addulane tholaginchi – addarike cherustadanna",
        "aadarané karuvaina – aapyayatha kurupistadanna",
        "kadavaraku tana krupatho – nanu kaachi kaapadunnanna",
        "shathruvule lechinanu – naa pakshamuga porade"
      ]
    }
  ]
}
