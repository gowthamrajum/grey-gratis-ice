{
  "song_name": "Prabhuyesu rammanuchunde paapula nellarini",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభుయేసు రమ్మనుచుండె - పాపుల నెల్లరిని",
      "వచ్చిన వారికి ప్రభుయేసుండే - విశ్రాంతి నిచ్చు"
    ],
    "english": [
      "Prabhuyesu rammanuchunde - Paapula nellarini",
      "Vachchina vaariki prabhuyesunde - Vishraanthi nichchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోకములో మానవులెల్ల ఘోరపాపములు జేసి",
        "దేవుని మహిమకు దూరమైపోయిరి",
        "మానవుల నీతి క్రియలు - మురికి పేలికలే"
      ],
      "english": [
        "Lokamulo maanavulella ghorapaapamulu jesi",
        "Devuni mahimaku dhooramaipoyiri",
        "Maanavula neethi kriyalu - Muriki pelikale"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభు యేసుక్రీస్తు నందు ఏ పాప దోషము లేదు",
        "మ్రానుపై వ్రేలాడెనుగా మన దోషముల కొరకై",
        "మరణము గ్లెచి విజయమునిచ్చి - నీతిగా తీర్చె"
      ],
      "english": [
        "Prabhu Yesukreesthu nandu e paapa doshamu ledu",
        "Mraanupai vrelaadenugaa mana dhoshamula korakai",
        "Maranamu gelchi vijayamunichchi - Neethigaa theerche"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎందరు విశ్వసింతురో ప్రభువైన యేసుని",
        "వారే పొందెదరుగా నిత్యమైన రక్షణ",
        "నేడె మీ కనుకూల సమయము - రక్షణ దినము"
      ],
      "english": [
        "Endaru vishwasinthuro prabhuvaina Yesuni",
        "Vaare pondhedharugaa nithyamaina rakshana",
        "Nede mee kanukoola samayamu - Rakshana dinamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపమును క్షమించుటకు - ప్రభుకే అధికారము కలదు",
        "ఎవరి పాపదోషములు - పరిహరింపబడునో",
        "వారే ధన్యులు పరలోకములో నిశ్చయముగా"
      ],
      "english": [
        "Paapamunu kshaminchutaku - Prabhuke adhikaaramu kaladu",
        "Evari paapadhoshamulu - Pariharimpabaduno",
        "Vaare dhanyulu paralokamulo nishchayamugaa"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరలోకపు తండ్రికి పుత్రులు విశ్వసించిన వారెగా",
        "తీర్పు మరణము లేక జీవము పొందెదరు",
        "పరిపూర్ణులుగా కడుగ బడుడి యేసుని రక్తములో"
      ],
      "english": [
        "Paralokapu thandriki puthrulu vishwasinchina vaaregaa",
        "Theerpu maranamu leka jeevamu pondedaru",
        "Paripoornulugaa kaduga baududi Yesuni rakthamulo"
      ]
    }
  ]
}
