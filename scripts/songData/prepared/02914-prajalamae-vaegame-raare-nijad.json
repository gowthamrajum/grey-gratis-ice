{
  "song_name": "Prajalamae Vaegame Raare Nijadhaivamunu Kanugonare",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ప్రజలమే వేగమె రారె నిజదైవమును కనుగొనరె"
    ],
    "english": [
      "Prajalamae Vaegame Raare Nijadhaivamunu Kanugonare"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపాత్ములనబడు వారి భారంబు దీయనుగోరి",
        "ప్రభుయేసు జూపినదారి పరమందు సుఖమిడుదారి"
      ],
      "english": [
        "Paapaathmulanabadu Vaari Bhaarambu Dheeyanugoari",
        "Prabhuyaesu Joopinadhaari Paramamdhu Sukhamidudhaari"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏ జాతివారలనైనన్ యే దేశవాసులనైనన్",
        "యేమైన బేధము లేక యేసయ్య బ్రోచునువేగ"
      ],
      "english": [
        "Ae Jaathivaaralanainan Yae Dhaeshavaasulanainan",
        "Yaemaina Baedhamu Laeka Yaesayya Broachunuvaega"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపాత్ములే తన సుతులు ప్రభు యేసునికి స్నేహితులు",
        "నీ పాపమెల్లను బోయెన్ నీకింక మోక్షము కలుగున్"
      ],
      "english": [
        "Paapaathmulae Thana Suthulu Prabhu Yaesuniki Snaehithulu",
        "Nee Paapamellanu Boayen Neekimka Moakshamu Kalugun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రయాసపడి భారమును మోసెడు ఓ ప్రజలారా",
        "ప్రభుయేసుక్రీస్తే మీకు విశ్రాంతి నిచ్చునురండి"
      ],
      "english": [
        "Prayaasapadi Bhaaramunu Moasedu Oa Prajalaaraa",
        "Prabhuyaesukreesthae Meeku Vishraamthi Nichchunuramdi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసయ్యగాకను వేరే యెవరైన లేరిక రారే",
        "దోషంబులలెల్నను బాపి ఆశీర్వదించునుగాచి"
      ],
      "english": [
        "Yaesayyagaakanu Vaerae Yevaraina Laerika Raarae",
        "Dhoashambulalelnanu Baapi Aasheervadhimchunugaachi"
      ]
    }
  ]
}
