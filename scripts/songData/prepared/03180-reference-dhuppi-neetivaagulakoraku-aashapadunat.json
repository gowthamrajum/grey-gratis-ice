{
  "song_name": "Neeti Vaagula Koraku Dhuppi Aashapadunatlu Dhevaa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీటి వాగుల కొరకు దుప్పి ఆశపడునట్లు దేవా",
      "నీ కొరకు నా ప్రాణము ఆశపడు చున్నది"
    ],
    "english": [
      "Neeti Vaagula Koraku Dhuppi Aashapadunatlu Dhevaa",
      "Nee Koraku Naa Praanamu Aashapadu Chunnadhi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జీవముగల దేవుని కొరకు తృష్ణగొనుచున్నది",
        "దేవుని సన్నిధికి నే నెప్పుడు వచ్చెదను"
      ],
      "english": [
        "Jeevamugala Dhevuni Koraku Thrushnagonuchunnadhi",
        "Dhevuni Sannidhiki Ne Neppudu Vachchedhanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ దైవమేమాయెనని నిత్యము నాతో ననగా",
        "రాత్రింబగల్లు కన్నీరే నా అన్న పానములాయె"
      ],
      "english": [
        "Nee Dhaivamemaayenani Nithyamu Naatho Nanagaa",
        "Raathrimbagallu Kanneere Naa Anna Paanamulaaye"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఉత్సాహ స్తుతులతో సమాజమును పండుగకు",
        "దేవుని మందిరమునకు నడిపించితిని"
      ],
      "english": [
        "Uthsaaha Sthuthulatho Samaajamunu Pandugaku",
        "Dhevuni Mandhiramunaku Nadipinchithini"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఇది తలంచగా నా ప్రాణము కరుగుచున్నది",
        "నాదు ప్రాణమా యేల కృంగి తొందర పడుచున్నావు?"
      ],
      "english": [
        "Idhi Thalanchagaa Naa Praanamu Karuguchunnadhi",
        "Naadhu Praanamaa Yela Krungi Thondhara Paduchunnaavu?"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షకుడగు దేవునిపైన నిరీక్షణ యుంచుము",
        "ఆయన రక్షకుడని నేనింక స్తుతించెదను"
      ],
      "english": [
        "Rakshakudagu Dhevunipaina Nireekshana Yunchumu",
        "Aayana Rakshakudani Neninka Sthuthinchedhanu"
      ]
    }
  ]
}
