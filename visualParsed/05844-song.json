{
  "song_name": "Sri Yesu putte jagamandu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "శ్రీ యేసు పుట్టె జగమందు - సమస్త పాపులకు విందు",
      "సాతాను శక్తులిక బందు - ఈ భాగ్యమెరుగ రిలముందు ||శ్రీ యేసు ||"
    ],
    "english": [
      "Sri Yesu putte jagamandu - Samastha paapulaku vindu",
      "Saathaanu shakthulika bandhu - Ee bhaagyameruga rilamundu ||Sri Yesu ||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బీదల కష్టము గాంచి - సదా తా సౌఖ్యమునుడించి",
        "పశుల తొట్టి మదినెంచి - శ్రీ మేరి సుతుడుగా నెంచి  ||శ్రీ||"
      ],
      "english": [
        "Beedhala kashtamu gaanchi - Sadaa thaa saukhyamunudinchi",
        "Pashula thotti madhinenchi - Sri Meri suthudugaa nenchi  ||Sri||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "భక్తాళి నెల్ల బోషింప - ప్రశస్త కాంతి వెలిగింప",
        "బ్రేమాది సుగుణముల నింప - సిలువపై మరణింప  ||శ్రీ||"
      ],
      "english": [
        "Bhakthaali nella poshimpa - Prashastha kaanthi veligimpa",
        "Premaadhi sugunamula nimpa - Siluvapai maranimpa  ||Sri||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వేదామృతంబు చవినిల - సుఖంబు మదికినిడు చాల",
        "చూపింప నేగె నీలీల - నరావతారుడై యిల  ||శ్రీ||"
      ],
      "english": [
        "Vedhaamruthambu chavinila - Sukhambu madhikinidu chaala",
        "Choopimpa nege neeleela - Naraavathaarudai ila  ||Sri||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆనందమూర్తి మదివేడ - సమస్త దుఃఖమును వీడ",
        "యత్యానందంబునం -బాడ- శ్రీ మేరి భాగ్యమనియాడ  ||శ్రీ||"
      ],
      "english": [
        "Aanandhamoorthi madhiveda - Samastha duhkhamunu veeda",
        "Athyaanandhambunam -Baadha- Sri Meri bhaagyamaniyaada  ||Sri||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "మోక్షంపు దారి జూపింప - రక్షణవార్త వినిపింప",
        "యక్షయ జయములను బాపి - రక్షణసేవ ధరనింప  ||శ్రీ||"
      ],
      "english": [
        "Mokshampu daari joopimpa - Rakshanavaartha vinipimpa",
        "Akshaya jayamulanu baapi - Rakshanaseva dharanimpa  ||Sri||"
      ]
    }
  ]
}
