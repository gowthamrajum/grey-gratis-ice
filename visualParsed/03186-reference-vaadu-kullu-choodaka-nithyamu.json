{
  "song_name": "Vaadu kullu choodaka nithyamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "సర్వజనులారా వినుడి - మీరేకంబుగా వినుడి"
    ],
    "english": [
      "Sarvajanulaaraa vinudi - Meerekambugaa vinudi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లోక నివాసులారా సామాన్యులు ఘనులేమి",
        "దరిద్రులు ధనికులేమి - సర్వజనులారా వినుడి"
      ],
      "english": [
        "Loka nivaasulaaraa saamaanyulu ghanulemi",
        "Dharidhrulu dhanikulemi - Sarvajanulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా హృదయ ధ్యానము పూర్ణ - వివేకమును గూర్చినది",
        "నే పల్కెద జ్ఞానాంశముల - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Naa hrudaya dhyaanamu poorna - Vivekamunu goorchinadhi",
        "Ne palkedha gnaanaamshamula - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "గూడార్థాంశము వినెద - చేతబట్టి సితార",
        "మర్మము దెల్పెద నేను - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Goodaarthaamshamu vinedha - Chethabatti sithaara",
        "Marmamu dhelpedha nenu - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నాకై పొంచిన దోషుల - క్రియలు నన్ను చుట్టన్",
        "ఆపదలో భయపడనేల - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Naakai ponchina dhoshula - Kriyalu nannu chuttan",
        "Aapadalo bhayapadanela - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "తమ ధన సంపదనుబట్టి - పొగడుకొనెడు వారికి",
        "నేనేల భయపడవలెను - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Thama dhana sampadhanubatti - Pogadukonedu vaariki",
        "Nenela bhayapadavalenu - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఎవడేరీతినైన నిత్యము బ్రతుకునట్లు",
        "సోదరుని రక్షించలేడు - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Evadereethinaina nithyamu brathukunatlu",
        "Sodharuni rakshinchaledu - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "వాని నిమిత్తము దైవ - సన్నిధి ప్రాయశ్చిత్తము",
        "చేయువాడెవ్వడు లేడు - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Vaani nimitthamu daiva - Sannidhi praayashchitthamu",
        "Cheyuvaadevvadu ledu - Sarva janulaaraa vinudi"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ప్రాణ విమోచన ధనము - బహు గొప్ప దెన్నటికిని",
        "తీరక యుండవలసినదే - సర్వ జనులారా వినుడి"
      ],
      "english": [
        "Praana vimochana dhanamu - Bahu goppa dhennatikini",
        "Theeraka yundavalasinadhe - Sarva janulaaraa vinudi"
      ]
    }
  ]
}
