{
  "song_name": "O bhakthulaaraa manamandaramu nithyamu Yesuni sthuthiyinchedhamu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఓ భక్తులారా మనమందరము",
      "నిత్యము యేసుని స్తుతియించెదము"
    ],
    "english": [
      "O bhakthulaaraa manamandaramu",
      "Nithyamu Yesuni sthuthiyinchedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గత కాలమున మన ప్రభుయేసు",
        "నూతన దీవెనలను - ఖ్యాతిగా నొసగే మనకు",
        "స్తుతియించెద మేసుని",
        "నూతన అనుభవములను - ఖ్యాతిగా సర్వశక్తుని"
      ],
      "english": [
        "Gatha kaalamuna mana prabhu Yesu",
        "Noothana dheevenalanu - Khyaathigaa nosage manaku",
        "Sthuthiyinchedam Yesuni",
        "Noothana anubhavamulanu - Khyaathigaa sarvashakthuni"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శక్తిమంతుడు మన ప్రభు యేసు",
        "నిత్యమును దీవించును - రక్షించును మనలను తానే",
        "సంపూర్ణముగా కాయున్",
        "సత్యవంతుడు మన ప్రభువు - మాట తప్పని మహారాజు"
      ],
      "english": [
        "Shakthimanthudu mana prabhu Yesu",
        "Nithyamunu deevinchunu - Rakshinchunu manalanu thaane",
        "Sampoornamugaa kaayun",
        "Sathyavanthudu mana prabhuvu - Maata thappani mahaaraaju"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎన్ని శోధనలు భువినున్న",
        "తానే మనలను విడిపించును - శోధింపబడెను యేసు",
        "తన సహాయము నొసగున్",
        "కనుపాపవలె ప్రభువు కాయున్ - నిత్యము నిలుచు మనతో"
      ],
      "english": [
        "Enni shodhanalu bhuvinunna",
        "Thaane manalanu vidipinchunu - Shodhimpabadenu Yesu",
        "Thana sahaayamu nosagun",
        "Kanupaapavale prabhuvu kaayun - Nithyamu niluchu manatho"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శక్తిమంతుడు మన ప్రభు యేసు",
        "తొట్రిల్లకుండ కాపాడును - నిర్దోషులనుగా ప్రభువు",
        "నిలుపును తన మహిమతో",
        "తలచుము తన కృపలను - ఎన్నడు విడువడు మనల"
      ],
      "english": [
        "Shakthimanthudu mana prabhu Yesu",
        "Thotrillakunda kaapaadunu - Nirdhoshulanugaa prabhuvu",
        "Nilupunu thana mahimatho",
        "Thalachumu thana krupalanu - Ennadu viduvadu manala"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కృంగిన భక్తులారా మీరు",
        "భంగపర్చు శత్రువుపై జగముపై చాటుడి - జయము",
        "జయము జయమని ప్రభుకే",
        "యుగ యుగములు మన ప్రభుకే - హల్లెలూయ గీతములతో"
      ],
      "english": [
        "Krungina bhakthulaaraa meeru",
        "Bhangaparchu shathruvupai jagamupai chaatudi - Jayamu",
        "Jayamu jayamani prabhuke",
        "Yuga yugamulu mana prabhuke - Hallelooya geethamulatho"
      ]
    }
  ]
}
