  },
  "main_stanza": {
    "telugu": [
      "హల్లెలూయ నా ప్రాణమా - యెహోవాను స్తుతించు"
    ],
    "english": [
      "Hallelooya Naa Praanamaa - Yehoavaanu Sthuthinchu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా జీవితకాలమంతయు నే నెహోవాను స్తుతించెదను",
        "నా బ్రతుకు కాలమంతయు నా దేవుని కీర్తింతును"
      ],
      "english": [
