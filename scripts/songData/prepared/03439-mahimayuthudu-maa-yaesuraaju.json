  "main_stanza": {
    "telugu": [
      "మహిమయుతుడు మా యేసు రాజు",
      "మహిమదూత సైన్యము తోడ ఇహకు వచ్చున్ మహానందము"
    ],
    "english": [
      "Mahimayuthudu Maa Yaesu Raaju",
      "Mahimadhootha Sainyamu Thoad Ihaku Vachchun MahaanMdhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇమ్మహి అతిశయిల్లు - దూతలు ఆర్భటించ",
        "దూత వెల్గుతోడ మేఘముపై యేసు",
