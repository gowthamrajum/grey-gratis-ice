{
  "song_name": "Paralokamnundi",
  "author": {
    "Authored by": "Bro M Moses",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పరలోకము నుండి భువికరుదెంచెను లోకరక్షకుడు",
      "తన ప్రజలను వారి పాపములనుండి ఆయనే రక్షించున్",
      "దైవ కుమారుడు ఇమ్మానుయేలనువాడు",
      "ఆ దైవ కుమారుడు ఇమ్మానుయేలనువాడు"
    ],
    "english": [
      "Paralokamu nundi bhuvikarudhenchenu loka rakshakudu",
      "thana prajalanu vaari paapamulanundi aayane rakshinchunu",
      "daivakumaarudu emmanuyelanuvaada",
      "aa daivakumaarudu emmanuyelanuvaada"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "యూదయ దేశపు బేత్లెహేములో",
        "కన్య మరియ గర్భమందున",
        "యూదుల రాజుగా పుట్టిన యేసు",
        "సర్వశక్తి గల దేవుని సుతుడు",
        "మరణచ్చాయలో ఉండిన ప్రజలకై",
        "జీవపు వెలుగై ఇలకేతెంచెన్",
        "లోకపాపము తానె భరించి",
        "ప్రతీ మనిషికి జీవమునిచ్చును"
      ],
      "english": [
        "Yudahaya dhesapu bethlehemulo",
        "kanya mariya garbamandhuna",
        "yudhula raajuga puttina yesu",
        "sarvasakthi gala devuni suthudu",
        "Maranachaayalo undina prajalakai",
        "jeevapu velugai ilakethenchenu",
        "lokapaapamu thaane barinchi",
        "prathi manishiki jeevamunichenu"
      ]
    }
  ]
}
