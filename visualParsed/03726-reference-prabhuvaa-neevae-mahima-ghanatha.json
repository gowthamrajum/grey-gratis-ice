      ],
      "english": [
        "Shaanthi naathudesuni samukhamulo",
        "Santhasame nithyamu chinthaledhugaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నా ప్రభువు తుడుచును నా కన్నీటిని",
