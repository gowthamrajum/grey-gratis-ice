    {
      "stanza_number": 2,
      "telugu": [
        "పాపపరిహారార్థము - పావన రక్తము నిచ్చిన",
        "యేసుని చేర ప్రియుడా - సంశయమదియేల"
      ],
      "english": [
        "Paapaparihaaraarthamu - Paavana rakthamu nichchina",
