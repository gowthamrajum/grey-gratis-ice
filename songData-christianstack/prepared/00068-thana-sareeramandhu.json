{
  "song_name": "Thana Sareeramandhu",
  "author": {
    "Authored by": "Dr. A.R.Stevenson",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "తన శరీరమందు మన పాపములు మోసెను క్రీస్తు",
      "పాపమేమియు చేయకున్నను మనకై బాధపడెను",
      "మనదే ఆ దండన – నిరపరాధికది తగునా"
    ],
    "english": [
      "Thana sareeramandhu mana paapamulu mosenu Kreesthu",
      "Paapamemiyu cheyakunnanu manakai baadhapadenu",
      "Manadhe aa dhandana – niraparaadhikadhi thagunaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దూషించి నిందలేస్తున్నా బదులు పలకలేదు",
        "యేసుని అడుగుజాడలలో",
        "మనము శ్రమను పొందుట హితమగును"
      ],
      "english": [
        "Dhooshinchi nindhalesthunnaa badhulu palakaledhu",
        "Yesuni adugujaadalalo",
        "Manamu sramanu pondhuta hithamagunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఘోరంగా చంపచూస్తున్నా పగను నిలుపలేదు",
        "ఆయన పొందిన దెబ్బలలో",
        "మనకు స్వస్థతనుగ్రహించబడెను"
      ],
      "english": [
        "Ghoranga champachoosthunnaa paganu nilupaledhu",
        "Aayana pondhina dhebbalalo",
        "Manaku swasthathanugrahinchabadenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "అన్యాయతీర్పు చేస్తున్నా తిరిగి అడుగలేదు",
        "న్యాయాధిపతి దేవునికి",
        "తనను తాను అప్పగించుకొనెను"
      ],
      "english": [
        "Anyaaya theerpu chesthunnaa thirigi adugaledhu",
        "Nyaayaadhipathi Dhevuniki",
        "Thananu thaanu appaginchukonenu"
      ]
    }
  ]
}
