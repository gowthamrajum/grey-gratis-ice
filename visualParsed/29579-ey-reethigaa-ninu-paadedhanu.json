{
  "song_name": "E reethigaa ninu paadedanu",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Paul Moses"
    ],
    "రచన": [
      "పాల్ మోసెస్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "ఏ రీతిగా నిను పాడెదను నా ఆశ్రయదుర్గమా",
      "ఏ రీతిగా నిన్ను వర్ణించెదను నా రక్షణ శైలమా"
    ],
    "english": [
      "E reethigaa ninu paadedanu naa aashrayadhurgamaa",
      "E reethigaa ninnu varninchedanu naa rakshana shailamaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇన్నాళ్లుగా నన్ను పోషించినందుకు",
        "ఎనలేని ప్రేమను చూపించినందుకు",
        "పాడెద స్తుతి గానము – కొనియాడెద నీ నామము"
      ],
      "english": [
        "Innaallugaa nannu poshinchinanduku",
        "Enaleni premanu choopinchinanduku",
        "Paadeda sthuthi gaanamu – Koniyaadeda nee naamamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తూలనాడిన నా పాప జీవితం",
        "తిరిగి చేర్చేను నీ కరుణా హస్తం",
        "నడుపుము దేవా సరియైన త్రోవలో",
        "దరి చేర్చావే నను నీ నావలో",
        "చీకటి బ్రతుకులో వెలుగు దీపమై",
        "చెదరిన వారికి నీవే మార్గమై",
        "మరువను దేవా నీ ఘన మేళ్లను",
        "నీతో నడుచును నా జీవిత పరుగును"
      ],
      "english": [
        "Thoolanaadina naa paapa jeevitham",
        "Thirigi cherchenu nee karunaa hastham",
        "Nadupumu Deva sariyaina throvalo",
        "Dari cherchaave nanu nee naavalo",
        "Cheekati brathukulo velugu deepamai",
        "Chedarina vaariki neeve maargamai",
        "Maruvanu Deva nee ghana mellanu",
        "Neetho naduchunu naa jeevitha parugunu"
      ]
    }
  ]
}
