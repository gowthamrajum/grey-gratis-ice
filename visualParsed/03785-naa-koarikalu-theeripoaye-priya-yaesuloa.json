    },
    {
      "stanza_number": 3,
      "telugu": [
        "తీర్చును నా దాహమును జీవజలంబుతో",
        "నీరుకట్టిన తోటవలె వృద్ధి చేయును"
      ],
      "english": [
        "Theerchunu naa dhaahamunu jeevajalambutho",
        "Neerukattina thotavale vruddhi cheyunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బలహీనతలయందు తన బలమునిచ్చును",
        "కొల్లగ శక్తి నిచ్చి విజయముతో నడుపును"
      ],
      "english": [
        "Balaheenathalayandhu thana balamunichchunu",
        "Kollaga shakthi nichchi vijayamutho nadupunu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "నిరీక్షణను కలిగి స్వాస్థ్యమును పొందెదన్",
        "నను పుత్రునిగా జేసి ఆనంద మొసగెను"
      ],
      "english": [
        "Nireekshananu kaligi svaasthyamunu pondhedhan",
        "Nanu puthrunigaa jesi aananda mosagenu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వెలిగించె ప్రభువు నన్ను ఆత్మీయముగను",
        "విలువైన నగరమందు నన్నుచేర్చుకొనును"
      ],
      "english": [
        "Veliginche Prabhuvu nannu aathmeeyamuganu",
        "Viluvaina nagaramandhu nannucherchukonunu"
      ]
