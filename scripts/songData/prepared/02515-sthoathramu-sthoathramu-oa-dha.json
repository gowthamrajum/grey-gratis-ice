{
  "song_name": "Sthoathramu Sthoathramu Oa Dhaevaa",
  "author": {
    "Authored by": "",
    "రచన": "బన్యన్ జోసఫ్"
  },
  "main_stanza": {
    "telugu": [
      "స్తోత్రము స్తోత్రము ఓ దేవా ఈ వేకువనే",
      "స్తోత్రము జేతుము మా దేవా",
      "రాత్రియందున మమ్ము రక్షించి గాపాడి ధాత్రి",
      "మరియొక దినమున్ దయతో నిచ్చెన దేవా"
    ],
    "english": [
      "Sthoathramu Sthoathramu Oa Dhaevaa Ee Vaekuvanae",
      "Sthoathramu Jaethumu Maa Dhaevaa",
      "Raathriyandhuna Mammu Rakshinchi Gaapaadi Dhaathri",
      "Mariyoka Dhinamun Dhayathoa Nichchena Dhaevaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపశోధనలనుండి ప్రభువా మమ్ము కాపాడి బ్రోవుమయ్య",
        "ఏ పాపము మమ్మున్ ఏల నియ్యకుండ",
        "మాపు రేపులుమమ్ము మనిపి బ్రోవుమయ్య"
      ],
      "english": [
        "Paapashoadhanalanundi Prabhuvaa Mammu Kaapaadi Broavumayya",
        "Ae Paapamu Mammun Aela Niyyakunda",
        "Maapu Raepulumammu Manipi Broavumayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కన్న తండ్రికంటెను కనికరమున కాపాడెడి మా దేవా",
        "అన్న దమ్ములవలె మే మందరిని ప్రేమించి",
        "మన్ననతో నీదినము మన నియ్యుమో దేవా"
      ],
      "english": [
        "Kanna Thandrikantenu Kanikaramuna Kaapaadedi Maa Dhaevaa",
        "Anna Dhammulavale Mae Mandharini Praeminchi",
        "Mannanathoa Needhinamu Mana Niyyumoa Dhaevaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పితా సుతా శుద్ధాత్మలనెడి దేవా ప్రీతితో గావుమయ్యా",
        "నీతిమార్గములందు నిరతము మముగాచి",
        "ఖ్యాతిగా నీకొరకు బ్రతుకనిమ్మో దేవా"
      ],
      "english": [
        "Pithaa Suthaa Shuddhaathmalanedi Dhaevaa Preethithoa Gaavumayyaa",
        "Neethimaargamulandhu Nirathamu Mamugaachi",
        "Khyaathigaa Neekoraku Brathukanimmoa Dhaevaa"
      ]
    }
  ]
}
