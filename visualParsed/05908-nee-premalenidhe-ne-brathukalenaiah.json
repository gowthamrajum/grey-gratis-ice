  "main_stanza": {
    "telugu": [
      "నీ ప్రేమలేనిదే నే బ్రతుకలేనయ్యా -",
      "నాజీవితాంతము నీతోడు చాలయ్యా (2)",
      "ధనరాసులెన్నున్న, మేడమిద్దేలెన్నున్న –",
      "లోకమంతా నాదైనా అంతానావారైనా"
    ],
    "english": [
      "Nee premalenidhe ne brathukalenayyaa -",
      "Naajeevithaanthamu neethodu chaalayyaa (2)",
      "Dhanaraasulennunna, medamiddhelennunna –",
      "Lokamanthaa naadhainaa anthaanaavaarainaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కష్టకాలములందు నేకృంగియున్నపుడు- నీతోడు ఉంటేచాలయ్యా",
        "వ్యాధి బాధలయందు నేనలిగియున్నపుడు – నీప్రేమఉంటే చాలయ్యా",
        "విడువనని ఎడబాయనని – వాగ్దానము చేసినదేవా (2)",
        "నాకాపరి నీవైయుంటివా – నా ఊపిరి నీవైయుంటివా (యేసయ్యా) (2)"
      ],
      "english": [
        "Kashtakaalamulandhu nekrungiyunnapudu- Neethodu untechaalayyaa",
        "Vyaadhi baadhalayandhu nenaligiyunnapudu – Neepremaunte chaalayyaa",
        "Viduvanani edabaayanani – Vaagdhaanamu chesinadhevaa (2)",
        "Naakaapari neevaiyuntivaa – Naa oopiri neevaiyuntivaa (Yesayyaa) (2)"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అపవాది శోధనలో నే అలసిఉన్నపుడు - నీతోడుఉంటే చాలయ్యా",
        "మరణకర సమయములో నేకృంగియున్నపుడు- నీ ప్రేమ ఉంటేచాలయ్యా",
        "విడిపించి నడిపించి - రక్షించిన నా యేసయ్యా (2)",
        "నా తోడుగ నీవైయుంటివా – నా నీడగ నీవైయుంటివా (యేసయ్యా) (2)"
      ],
      "english": [
        "Apavaadi shodhanalo ne alasiunnapudu - Neethoduunte chaalayyaa",
        "Maranakara samayamulo nekrungiyunnapudu- Nee prema untechaalayyaa",
        "Vidipinchi nadipinchi - Rakshinchina naa Yesayyaa (2)",
        "Naa thoduga neevaiyuntivaa – Naa needaga neevaiyuntivaa (Yesayyaa) (2)"
      ]
