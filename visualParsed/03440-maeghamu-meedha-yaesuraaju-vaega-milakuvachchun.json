  "main_stanza": {
    "telugu": [
      "మేఘము మీద యేసురాజు వేగ మిలకువచ్చున్",
      "సిద్ధముగా నుండువారల జేర్చును శీఘ్రముగా దిగును"
    ],
    "english": [
      "Meghamu meeda Yesuraaju vega milakuvachchun",
      "Siddhamugaa nunduvaarala jerchunu sheeghramugaa dhigunu"
