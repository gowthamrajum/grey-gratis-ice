  "main_stanza": {
    "telugu": [
      "క్రీస్తేసే మన మహిమ నిరీక్షణయై యున్నాడు",
      "ఆ నిరీక్షణ పరలోకమందు",
      "మన కొరకై ఉంచబడి యున్నది"
    ],
    "english": [
      "Kreesthese mana mahima nireekshanayai yunnaadu",
      "Aa nireekshana paralokamandu",
      "Mana korakai unchabadi yunnadi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సంపూర్ణము చేయబడిన - సిలువ కార్యమునందు",
        "విశ్వాసము ద్వార మనలను - ఆయనే ఆయన యందు",
        "నిరీక్షించు నటుల జేసెను"
      ],
      "english": [
        "Sampoornamu cheyabadina - Siluva kaaryamunandhu",
        "Vishwaasamu dvaara manalanu - Aayane aayana yandu",
        "Nireekshinchu natula jesenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
