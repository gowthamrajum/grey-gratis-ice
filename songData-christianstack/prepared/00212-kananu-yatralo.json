{
  "song_name": "Kananu Yatralo",
  "author": {
    "Authored by": "Pastor David Paul",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కానాను యాత్రలో – యోర్దాను అలలకు నా హృదయం కలువరపడెను",
      "మందసమైన నా దేవుడా – నాతోనే ఉన్నావయ్యా",
      "పగలు మేఘస్తంభమై – రాత్రి అగ్నిస్తంభమై",
      "నన్ను కాచితివయ్యా"
    ],
    "english": [
      "Kaanaanu yaathralo – Yordaanu alalaku naa hrudayam kaluvarapadena",
      "Mandasamaina naa Devudaa – naathone unnavaiyya",
      "Pagalu meghasthambhamai – raatri agnisthambhamai",
      "Nannu kaachitivaayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అంధకార లోయలో నాకు నీ హస్తము చాపితివయ్యా",
        "అన్ని సమయాలలో నాతోడు నీడవై",
        "కౌగిటిలో దాచితివయ్యా"
      ],
      "english": [
        "Andhakaara loyalo naaku nee hastamu chaapitivaayya",
        "Anni samayaalalo naatodu needavai",
        "Kaugitilo daachitivaayya"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా వేదనలో నా బాధలలో నీ సన్నిధి చూపితివయ్యా",
        "కన్నీటి ధారలను నీ హస్తముతో",
        "కృపగలిగి తుడిచితివయ్యా"
      ],
      "english": [
        "Naa vedanalo naa baadhalalo nee sannidhi choopitivaayya",
        "Kanneeti dhaaralanu nee hastamutho",
        "Kripagaligi tudichitivaayya"
      ]
    }
  ]
}
