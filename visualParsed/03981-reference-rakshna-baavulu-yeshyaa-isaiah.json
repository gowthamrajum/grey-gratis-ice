  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బలవంతుడేసు మహిమ - పాడి వీలగునే వివరింప",
        "కల్వరి రక్షణవిలువ ఎల్లరికిని దొరుకును",
        "హా! రక్షణంపు బావులెల్లను అంతులేని లోతుగలవి",
        "ఎండిపోవు ఎన్నడైనను చేదికొందు మెన్నడందున"
      ],
      "english": [
        "Balavanthudesu mahima - Paadi veelagune vivarimpa",
        "Kalvari rakshanaviluva ellarikini dorukunu",
        "Haa! rakshanampu baavulellanu anthuleni lothugalavi",
        "Endipovu ennadainanu chedhikondu mennadandhuna"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీళ్ళు లేని శ్రమ యెంతయో - దీని నాలోచించరే యెవ్వరు",
        "విలువైన ప్రభుని మాటలను ఆలకించి యంగీకరించు"
      ],
      "english": [
        "Neellu leni shrama enthayo - Dheeni naalochinchare evvaru",
        "Viluvaina prabhuni maatalanu aalakinchi yangeekarinchu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఉప్పునీళ్ళ బావులున్నను ఇక ఉపయోగము యుండదు",
        "తప్పులన్ని త్రోసివేయుము అప్పుడే యానందమబ్బును"
      ],
      "english": [
        "Uppuneella baavulunnanu ika upayogamu yundadu",
        "Thappulanni throsiveyumu appude yaanandhamabbunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కలహముల మానివేతుము మంచి - జలముల త్రాగి యానందింతుం",
        "ఎల్లర మేకమౌదము తొలగద్రోసి యడ్డులన్నియు"
      ],
      "english": [
        "Kalahamula maanivethumu manchi - Jalamula thraagi yaanandhinthum",
        "Ellara mekamaudhamu tholagadhrosi yaddulanniyu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జీవజలముల త్రాగినవారు - మీరు దేవుని సాక్షులై యుండుడి",
        "భువి నెందరో దప్పిగొన్నారు త్రోవ జూపుడి వారికి"
      ],
      "english": [
        "Jeevajalamula thraaginavaaru - Meeru Devuni saakshulai yundudi",
        "Bhuvi nendharo dhappigonnaaru throva joopudi vaariki"
      ]
    }
  ]
