    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "యేసు రక్తమే జయము",
      "పరిశుధ్ధ రక్తమే జయము ॥2॥"
    ],
    "english": [
      "Yesu rakthame jayamu",
      "Parishuddha rakthame jayamu ॥2॥"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా కొరకూ మానవులందరి కొరకు",
        "కార్చిన రక్తముకే జయము ॥2॥  ||యేసు||"
      ],
      "english": [
        "Naa korakoo maanavulandhari koraku",
        "Kaarchina rakthamuke jayamu ॥2॥  ||Yesu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెరుషలేము వీధులలో చిందించిన రక్తము",
        "పాపుల కొరకై కార్చబడిన రక్తము ॥2॥"
      ],
      "english": [
        "Yerushalemu veedhulalo chindhinchina rakthamu",
        "Paapula korakai kaarchabadina rakthamu ॥2॥"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమకు ప్రతిరూపముగా కార్చబడిన రక్తము",
        "పరిపూర్ణతకై చిందించిన రక్తము ॥2॥  ||యేసు||"
      ],
      "english": [
        "Premaku prathiroopamugaa kaarchabadina rakthamu",
        "Paripoornathakai chindhinchina rakthamu ॥2॥  ||Yesu||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కల్వరి సిలువపై చిందించిన రక్తము",
        "చివరి బొట్టు వరకు కార్చబడిన రక్తము ॥2॥"
      ],
      "english": [
        "Kalvari siluvapai chindhinchina rakthamu",
        "Chivari bottu varaku kaarchabadina rakthamu ॥2॥"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "చీకటిని తొలగించుటకై చిందించిన రక్తము",
        "వారసత్వమిచ్చుటకై కార్చబడిన రక్తము ॥2॥  ||యేసు||"
      ],
      "english": [
        "Cheekatini tholaginchutakai chindhinchina rakthamu",
        "Vaarasathvamichchutakai kaarchabadina rakthamu ॥2॥  ||Yesu||"
      ]
    }
  ]
}
