{
  "song_name": "Vandanamu nimmu Prabhu Yesunaku jai jai yanipaadu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వందనము నిమ్ము ప్రభు యేసునకు జై జై యనిపాడు"
    ],
    "english": [
      "Vandanamu nimmu Prabhu Yesunaku jai jai yanipaadu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా జీవితపు ప్రముఖుడు ప్రభువే",
        "నన్నేలెడు ప్రభు నా రాజాయనే",
        "యుగుయుగ మహిమ ప్రభువునకే",
        "పాడుచుండెదను భజియించెదను జయధ్వనుల జేతున్"
      ],
      "english": [
        "Naa jeevithapu pramukhudu Prabhuve",
        "Nanneledu Prabhu naa raajaayane",
        "Yuguyuga mahima Prabhuvunake",
        "Paaduchundedanu bhajiyinchedanu jayadhvanula jethun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ఆదర్శము మహిమయు తానే",
        "తన యధికారము సర్వము నేలును",
        "తన నామము బహు అద్భుతము"
      ],
      "english": [
        "Naa aadharshamu mahimayu thaane",
        "Thana yadhikaaramu sarvamu nelunu",
        "Thana naamamu bahu adbhuthamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "యెహోవా బహుస్తుతికి యోగ్యుడు",
        "భక్తుల స్మరణ నీతియు నాయనే",
        "మహాప్రభావము గలవాడు"
      ],
      "english": [
        "Yehova bahusthuthiki yogyudu",
        "Bhakthula smarana neethiyu naayane",
        "Mahaaprabhaavamu galavaadu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బుద్దియు బలము జ్ఞానము ప్రభువే",
        "తన నీతి బహు ఉన్నతమైనది",
        "సైన్యముల కధిపతి నా తోడు"
      ],
      "english": [
        "Budhdhiyu balamu gnaanamu Prabhuve",
        "Thana neethi bahu unnathamainadi",
        "Sainyamula kadhipathi naa thodu"
      ]
    }
  ]
}
