      "నా ప్రభువా నా రక్షకా ఉత్సహించి ఆరాధింతును",
      "నిన్నే ప్రమించుచున్నాను నీకై జీవించుచున్నాను (2)"
    ],
    "english": [
      "Naa raajaa naa Deva sthothra geetham paadedanu",
      "Naa Prabhuvaa naa rakshakaa uthsahinchi aaraadhinthunu",
      "Ninne preminchuchunnaanu neekai jeevinchuchunnaanu (2)"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
