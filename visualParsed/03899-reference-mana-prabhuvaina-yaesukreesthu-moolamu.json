  "main_stanza": {
    "telugu": [
      "విజయుండు క్రీస్తు ప్రభావముతో",
      "ఘనవిజయుండాయెను",
      "సాతానుని తలను చితుక ద్రొక్కెను",
      "సదా రాజ్యమేలును"
    ],
    "english": [
      "Vijayundu Kreesthu prabhaavamutho",
      "Ghanavijayundaayenu",
      "Saathaanuni thalanu chithuka dhrokkenu",
      "Sadaa raajyamelunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఓ మరణమా నీ ముల్లు యెక్కడ?",
        "ఓ సమాధి నీ విజయమెక్కడ?",
        "సిలువ శక్తితో విరుగగొట్టెను",
        "విజయుండు సర్వంబులో"
      ],
      "english": [
        "O maranamaa nee mullu ekkada?",
        "O samaadhi nee vijayamekkada?",
        "Siluva shakthitho virugagottenu",
        "Vijayundu sarvambulo"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యూదా గోత్రంపు సింహమాయనే",
        "గ్రంథమును విప్ప యోగ్యుండు తానే",
        "ఏడు ముద్రలను విప్పెడివాడు",
        "యోగ్యుండు సర్వమందు"
      ],
      "english": [
        "Yoodaa gothrampu simhamaayane",
        "Granthamunu vippa yogyundu thaane",
        "Edu mudhralanu vippedivaadu",
        "Yogyundu sarvamandhu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆయనే శిరస్సు తన సంఘమునకు",
        "మృతులలో నుండి ప్రథముడై లేచె",
        "మన ప్రభుయేసే మరణమును గెల్చె",
        "సర్వములో ప్రధానుడై"
      ],
      "english": [
        "Aayane shirassu thana sanghamunaku",
        "Mruthulalo nundi prathamudai leche",
        "Mana Prabhuyese maranamunu gelche",
        "Sarvamulo pradhaanudai"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సింహాసనమందు వున్న మన ప్రభువే",
        "పద్మరాగముల మరకతముల బోలి",
        "సూర్యకాంతివలె ప్రకాశించెను",
        "జయమని పాడెదము"
      ],
      "english": [
        "Simhaasanamandhu vunna mana Prabhuve",
        "Padhmaraagamula marakathamula boli",
        "Sooryakaanthivale prakaashinchenu",
        "Jayamani paadedamu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఆయన యెదుట సాగిలపడి",
        "నాలుగు జీవులు పెద్దలందరును",
        "సర్వసృష్టికి దేవుండవని",
        "ఆరాధించి మ్రొక్కిరి"
      ],
      "english": [
        "Aayana eduta saagilapadi",
        "Naalugu jeevulu peddhalandharunu",
        "Sarvasrushtiki Dhevundavani",
        "Aaraadhinchi mrokkiri"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "క్రీస్తు యేసు ద్వారా దేవునికే స్తుతులు",
        "విజయమునిచ్చె తన ద్వారా మనకు",
        "అధిక విజయము మనకిచ్చు ప్రభువే",
        "అందరిలో అతిశ్రేష్టుండు"
      ],
      "english": [
        "Kreesthu Yesu dwaaraa Devunike sthuthulu",
        "Vijayamunichche thana dwaaraa manaku",
        "Adhika vijayamu manakichchu Prabhuve",
        "Andarilo athishreshtundu"
      ]
    }
  ]
