{
  "song_name": "Ne Paadu Paataku Kaaranama",
  "author": {
    "Authored by": "Pastor John Jebaraj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "మంచివాడా నా యేసయ్య",
      "నే పాడు పాటకు కారణమా",
      "లాభము ఆశించి ఆదుకొనక",
      "దీనుడను నన్ను నీవు మరువ లేదయ్యా"
    ],
    "english": [
      "Manchivaadaa na yesayya",
      "ne paadu paataku kaaranaamaa",
      "laabhamu aasinchi aadhukonaka",
      "dheenudanu nannu neevu maruva ledhayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతి నీకే మహిమ నీకే",
        "స్తుతి నీకే మహిమ నీకే"
      ],
      "english": [
        "Sthuthi neeke mahima neeke",
        "sthuthi neeke mahima neeke"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అను పల్లవి:",
        "స్తుతి నీకే మహిమ నీకే",
        "కీర్తి ఘనతయు నీకేనయా"
      ],
      "english": [
        "Sthuthi neeke mahima neeke",
        "keerthi ghanathayu neekenayaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "స్తుతి నీకే మహిమ నీకే",
        "కీర్తి ఘనతయు నీకేనయా"
      ],
      "english": [
        "Sthuthi neeke ghanatha neeke",
        "keerthi ghanathayu neekenayaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నీకే స్తుతి నీకే ఘనత",
        "నీకే మహిమ నా యేసయ్యా"
      ],
      "english": [
        "neeke sthuthi neeke ghanatha",
        "neeke mahima naa yesayyaa"
      ]
    }
  ]
}
