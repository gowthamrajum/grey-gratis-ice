{
  "song_name": "Mahimathoa Mana Yaesu Ihamunaku Vaenchaeyun",
  "author": {
    "Authored by": "",
    "రచన": "గొల్లపల్లి నతానియేలు"
  },
  "main_stanza": {
    "telugu": [
      "మహిమతో మన యేసు ఇహమునకు వేంచేయున్",
      "సహోదరులారా మన మా మహిమలో వెలుఁగుదుము"
    ],
    "english": [
      "Mahimathoa Mana Yaesu Ihamunaku Vaenchaeyun",
      "Sahoadharulaaraa Mana Maa Mahimaloa Velugudhumu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మోములు వంచి యేసు నామము నుతియించు",
        "పామరులమైన మనలఁ బ్రేమతోఁ గప్పినాఁడే"
      ],
      "english": [
        "Moamulu Vanchi Yaesu Naamamu Nuthiyinchu",
        "Paamarulamaina Manala Braemathoa Gappinaadae"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పాత్రులమా మనము శత్రులమే కాదా",
        "మిత్రులన్ జేసిన వి చిత్రము తెలియలేము"
      ],
      "english": [
        "Paathrulamaa Manamu Shathrulamae Kaadhaa",
        "Mithrulan Jaesina Vi Chithramu Theliyalaemu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శిరముల పైని జీవ కిరీటములతోను",
        "బరమ దేవుని వరములు మురి యుచు మరువలేము"
      ],
      "english": [
        "Shiramula Paini Jeeva Kireetamulathoanu",
        "Barama Dhaevuni Varamulu Muri Yuchu Maruvalaemu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వీణెలతో మనము నాణెమైన పాట ఋణము",
        "చెల్లింపలేమని యణఁ గి మణఁగి పాడుదుము"
      ],
      "english": [
        "Veenelathoa Manamu Naanemaina Paata Runamu",
        "Chellimpalaemani Yana Gi Managi Paadudhumu"
      ]
    }
  ]
}
