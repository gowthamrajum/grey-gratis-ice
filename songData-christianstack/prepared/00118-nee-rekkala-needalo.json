{
  "song_name": "Nee Rekkala Needalo",
  "author": {
    "Authored by": "Manirajesh Jonnala",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "యేసయ్య – నీవే నా ప్రాణము",
      "మెస్సయ్య – నీవే నా ధ్యానము",
      "యేసయ్య – నీవే నా జీవము",
      "మెస్సయ్య – నీవే ఆధారము"
    ],
    "english": [
      "Yesayya – neeve naa praanamu",
      "messayya – neeve naa dhyaanamu",
      "yesayya – neeve naa jeevamu",
      "messayya – neeve aadhaaramu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నీ రెక్కల నీడలో – నను కాచావయ్యా",
        "నీ అక్కున చేర్చుకుని – నను మలిచావయ్యా"
      ],
      "english": [
        "Nee rekkala needalo – nanu kaachaavayyaa",
        "nee akkuna cherchukuni – nanu malichaavayya"
      ]
    }
  ]
}
