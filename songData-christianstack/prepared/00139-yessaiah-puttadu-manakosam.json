    ],
    "english": [
      "Raajulaku Raaju puttaadayyaa",
      "Prabhuvula Prabhuvu puttaadayyaa",
      "Raaraju Yesu puttaadayyaa",
      "Paapamu baapa vacchaadayyaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆనందమే సంతోషమే",
