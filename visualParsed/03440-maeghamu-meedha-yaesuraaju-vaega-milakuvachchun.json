    {
      "stanza_number": 7,
      "telugu": [
        "హల్లెలూయా గీతముపాడి ఆర్భాటించెదము",
        "వల్లభుడిదిగో వచ్చెడు వేళ సమీపమాయెను"
      ],
      "english": [
        "Hallelooyaa geethamupaadi aarbhaatinchedhamu",
