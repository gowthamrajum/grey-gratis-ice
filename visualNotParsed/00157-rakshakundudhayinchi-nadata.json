{
  "song_name": "Rakshakundudhayinchi naadata",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "రక్షకుండుదయించి నాడట - మన కొరకు - బరమ రక్షకుండుదయించి",
      "నాడట - రక్షకుండుదయించి నాడట - రారె - గొల్లబోయలార",
      "తక్షణమున - బోయి మన నిరీక్షణ ఫలమొందెదము",
      "..రక్షకుండు.."
    ],
    "english": [
      "Rakshakundudhayinchi naadata - Mana koraku - Parama rakshakundudhayinchi",
      "Naadata - Rakshakundudhayinchi naadata - Raare - Gollaboyalaara",
      "Thakshanamuna - Boyi mana nireekshana phalamondedhamu",
      "..Rakshakundu.."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దావీదు వంశమందు ధన్యుండు జన్మించినాడు దేవుడగు",
        "యెహోవా మన దిక్కు జేరి చూచినాడు  ||రక్షకుండుదయించి||"
      ],
      "english": [
        "Daaveedu vamshamandhu dhanyundu janminchinaadu Dhevudagu",
        "Yehova mana dikku jeri choochinaadu  ||Rakshakundudhayinchi||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "గగనమునుండి దిగి - ఘనుడు గబ్రియేలు దూత తగినట్టు",
        "చెప్పె వారికి మిగుల సంతోషవార్త  ||రక్షకుండుదయించి||"
      ],
      "english": [
        "Gaganamunundi digi - Ghanudu Gabriyelu dootha thaginattu",
        "Cheppe vaariki migula santhoshavaartha  ||Rakshakundudhayinchi||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వర్తమానము జెప్పి దూత - వైభవమున బోవుచున్నాడు కర్తను",
        "జూచిన వెనుక కాంతుము విశ్రమం బప్పుడు  ||రక్షకుండుదయించి||"
      ],
      "english": [
        "Varthamaanamu jeppi dootha - Vaibhavamuna bovuchunnaadu karthanu",
        "Joochina venuka kaanthumu vishramam bappudu  ||Rakshakundudhayinchi||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పశువుల తొట్టిలోన - భాసిల్లు వస్త్రముల జుట్టి శిశువును",
        "గనుగొందురని - శీఘ్రముగను దూత తెల్పె  ||రక్షకుండుదయించి||"
      ],
      "english": [
        "Pashuvula thottilona - Bhaasillu vasthramula jutti shishuvunu",
        "Ganugondhurani - Sheeghramuganu dootha thelpe  ||Rakshakundudhayinchi||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అనుచు గొల్ల లొకరి కొక రానవాలు జెప్పుకొనుచు - అనుమతించి",
        "కడకు క్రీస్తు నందరికినీ దెల్పినారు  ||రక్షకుండుదయించి||"
      ],
      "english": [
        "Anuchu golla lokari koka raanavaalu jeppukonuchu - Anumathinchi",
        "Kadaku Kreesthu nandharikinee dhelpinaaru  ||Rakshakundudhayinchi||"
      ]
    }
  ]
}
