  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రేపు మాపు గూడ రమ్యమైన గింజల్",
        "ప్రీతితోను జల్లివేసి యుందుము",
        "కాపుతోడనుండి దాపునుండు పంట",
        "నేపు మీరబంటగోసి కొందము",
        "పంట పండగన్ గోసి కొందము",
        "కంట నీరు పోవ గోసి కొందము"
      ],
      "english": [
        "Repu maapu gooda ramyamaina ginjal",
        "Preethithonu jallivesi yundhumu",
        "Kaaputhodanundi dhaapunundu panta",
        "Nepu meera panta gosi kondhamu",
        "Panta pandagan gosi kondhamu",
        "Kanta neeru pova gosi kondhamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సందియంబు లేల స్వామి సేవ యందు",
        "నందనంబు తోడ విత్తుచుందుము",
        "కొందలంబులేక కష్టవృత్తిచేసి",
        "యందరము చేరి యానందింతుము"
      ],
      "english": [
        "Sandhiyambu lela swaami seva yandu",
        "Nandhanambu thoda viththuchundhumu",
        "Kondhalambuleka kashtavruththichesi",
        "Yandharamu cheri yaanandhinthumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమ విత్తనంబుల క్షేమ యంకురంబుల్",
        "ప్రీతిన్ గాలమెల్ల ప్రాంతమంతటన్",
        "నేను మొప్ప నాటి నాయకుండు",
        "నిండు పంట గోసి గూర్చుకొందము"
      ],
      "english": [
        "Prema viththanambula kshema yankurambul",
        "Preethin gaalamella praanthamanthatan",
        "Nenu moppa naati naayakundu",
        "Nindu panta gosi goorchukondhamu"
      ]
    }
  ]
