  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సంస్తుతింతుము నిన్నే - సౌలును విడచితివి",
        "దావీదును కోరుకొని - దీవించిన యెహోవా"
      ],
      "english": [
        "Samsthuthinthumu ninne - Saulunu vidachithivi",
        "Dhaaveedhunu korukoni - Deevinchina Yehova"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "యెష్షయి పుత్రులలో - ఎర్రని వాడతడు",
        "నేత్రాలు చక్కనివి - నేర్పరి మాటలలోన"
      ],
      "english": [
        "Yeshshayi puthrulalo - Errani vaadathadu",
        "Nethraalu chakkanivi - Nerpari maatalalona"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రత్నవర్ణుడు యేసు - మాటలు దయగలవి",
        "గువ్వలవలె వెలయు - కన్నులు గలవాడేసు"
      ],
      "english": [
        "Rathnavarnudu Yesu - Maatalu dhayagalavi",
        "Guvvalavale velayu - Kannulu galavaadesu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "బెత్లెహేమునందు - ఖ్యాతిగా వాయించి",
        "సొంపగు పాటలు పాడే - సుగుణాల సుందరుడు"
      ],
      "english": [
        "Bethlehemunandhu - Khyaathigaa vaayinchi",
        "Sompagu paatalu paade - Sugunaala sundarudu"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పరమగీతము పాడే - పావనుడు మన యేసు",
        "నేర్పరి మాటలలోన - నజరేతు నివాసి"
      ],
      "english": [
        "Paramageethamu paade - Paavanudu mana Yesu",
        "Nerpari maatalalona - Nazarethu nivaasi"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వీరుడగు యౌవనుడు - శూరుడు యుద్ధమున",
        "తల్లిని మించి యెహోవా - తనతోడై యున్నాడు"
      ],
      "english": [
        "Veerudagu yauvanudu - Shoorudu yuddhamuna",
        "Thallini minchi Yehova - Thanathodai yunnaadu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "నేను కోరిన దితడే - వాని అన్నలముందు",
        "అభిషేక తైలముతో - అభిషేకించుము వాని"
      ],
      "english": [
        "Nenu korina dhithade - Vaani annalamundhu",
        "Abhisheka thailamutho - Abhishekinchumu vaani"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "సంఘవరుడగు క్రీస్తు - సత్యముగ మన శిరస్సు",
        "ఆత్మాభిషిక్తుండై - అలరారుచున్నాడు"
      ],
      "english": [
        "Sanghavarudagu Kreesthu - Sathyamuga mana shirassu",
        "Aathmaabhishikthundai - alaraaruchunnaadu"
      ]
    }
  ]
}
