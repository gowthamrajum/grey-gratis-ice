  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప:- ఇది చిత్రం కాదా దేవుడే భువికి వచ్చెను-ఇది చిత్రం కాదా పరమునే విడిచి వచ్చెను",
        "నిన్ను నన్ను రక్షింపను పాప శాపం తొలగింపను",
        "ఈ లోకానికి వచ్చెను",
        "ఇదియే క్రిస్మస్ అర్ధం గ్రహియించు ఈ పరమార్ధం",
        "అర్పించు నీ హృదయం"
      ],
      "english": [
        "Idi chitram akaadaa deavudea bhuviki vacchhenu – idi chitram kaadaa paramunea vidichi vacchhenu",
        "Ninnu nannu rakshimpanu paapa saapam tholagimpanu",
        "Ii lookaaniki vacchhenu",
        "Idiyea christmas ardham grahiyinchu ii paramaardham",
        "Arpinchu nii hrudayam"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకాన్నే ఏలేటోడు దీనుడై దిగివచ్చాడు",
        "తల్లిలా లాలించేటోడు తల్లి ఒడిలో పవళించాడు",
        "దీనత్వం చూపించాడు"
      ],
      "english": [
        "Lookaannea ealeatodu diinudai digivacchhadu",
        "Thallilaa laalincheatoodu thalli odiloo pavallinchhaadu",
        "Diinathvam chuupinchaadu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపులకు రక్షణ తెచ్చాడు రోగులకు స్వస్థతనిచ్చాడు",
        "జీవ వాక్యం బోధించాడు జీవితాలను వెలిగించాడు",
        "నిత్యజీవాన్ని మనకిచ్చాడు"
      ],
      "english": [
        "Paapulaku rakshanna thecchhaadu roogulaku svasthathanicchhaadu",
        "Jiiva vaakyam boodhinchaadu jiivithaalanu veliginchaadu",
        "Nithyajiivaanni manakicchhaadu"
      ]
    }
  ]
