{
  "song_name": "Parama Pavithra Svargapitha",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పరమ పవిత్ర స్వర్గపిత - జై ప్రభు జై ప్రభు",
      "సర్వ సదా యుగయుగములకు - రక్షకుడా",
      "మమ్ములను రక్షించితివి జీవుండ ప్రభు పాపుల రక్షకా - జై ప్రభు"
    ],
    "english": [
      "Parama Pavithra Svargapitha - Jai Prabhu Jai Prabhu",
      "Sarva Sadhaa Yugayugamulaku - RakShkudaa",
      "Mammulanu RakShiMchithivi JeevuMda Prabhu Paapula RakShkaa - Jai Prabhu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ప్రేమరూపి నీవే - నన్ను ప్రేమించితివి",
        "శ్రమలను పొందితివి - నీ ప్రేమ మూలమున"
      ],
      "english": [
        "Praemaroopi Neevae - Nannu PraemiMchithivi",
        "Shramalanu PoMdhithivi - Nee Praema Moolamun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రాణమిడి సిలువన్ - నన్ను రక్షించితివి",
        "పాపము తీసితివి - నీ కౄప ఉన్నతము"
      ],
      "english": [
        "PraaNamidi Siluvan - Nannu RakShiMchithivi",
        "Paapamu Theesithivi - Nee Kroapa Unnathamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "శత్రు సైతానున్ - ఓడించితివీవు",
        "నీ మరణము వలన - విమోచించితివి"
      ],
      "english": [
        "Shathru Saithaanun - OadiMchithiveevu",
        "Nee MaraNamu Valana - VimoachiMchithivi"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శక్తిగలవాడా - చావున్ గెల్చితివి",
        "శక్తితో లేచితివి - తండ్రితో కలిపితివి"
      ],
      "english": [
        "Shakthigalavaadaa - Chaavun Gelchithivi",
        "Shakthithoa Laechithivi - ThMdrithoa Kalipithivi"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ప్రేమగల ప్రభువా - మరల వచ్చెదవు",
        "శ్రమలను తొలగించి - నను చేర్చుకొందువు"
      ],
      "english": [
        "Praemagala Prabhuvaa - Marala Vachchedhavu",
        "Shramalanu TholagiMchi - Nanu ChaerchukoMdhuvu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ప్రవాహములోన - ప్రభు నేనుండినను",
        "నిన్ను బట్టి నే - క్షేమముగా నుందున్"
      ],
      "english": [
        "Pravaahamuloana - Prabhu NaenuMdinanu",
        "Ninnu Batti Nae - KShaemamugaa NuMdhun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "జై జై యని పాడుడి - యేసునకే మహిమ",
        "జై జై హల్లెలూయా - జై జై హల్లెలూయా"
      ],
      "english": [
        "Jai Jai Yani Paadudi - Yaesunakae Mahim",
        "Jai Jai Hallelooyaa - Jai Jai Hallelooyaa"
      ]
    }
  ]
}
