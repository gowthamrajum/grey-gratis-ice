{
  "song_name": "Naa Hrudhayam",
  "author": {
    "Authored by": "Samy Pachigalla",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ ప్రేమను మరతునా",
      "నీ జాలిని మరతునా",
      "నా దైవమా .. నా యేసయ్య.."
    ],
    "english": [
      "Nee premanu marathunaa",
      "nee jaalini marathunaa",
      "naa daivamaa .. naa yesayya.."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నా హృదయం పాడెనే నీ ప్రేమనే",
        "నా హృదయ దైవమా నీకే నా గీతమే",
        "ఎల్లప్పుడు నీ ధ్యానం నిరతము నీ నామం",
        "నే పాడెదా నా జీవితాంతము"
      ],
      "english": [
        "Naa hrudhayam paadene nee premane",
        "naa hrudhaya daivamaa neeke naa geethame",
        "ellappudu nee dhyaanam nirathamu nee naamam",
        "ne paadedhaa naa jeevithaanthamu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ప్రాణం ఆశించే నీ ప్రేమకై",
        "ఆనంద గీతాలే నా హృదయం పాడెనే",
        "ఎల్లప్పుడు నీ ధ్యానం నిరతము నీ నామం",
        "నే పాడెదా నా జీవితాంతము"
      ],
      "english": [
        "Naa praanam aasinche nee premakai",
        "aananda geethaale naa hrudhayam paadene",
        "ellappudu nee dhyaanam nirathamu nee naamam",
        "ne paadedhaa naa jeevithaanthamu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎల్లప్పుడు నీ ధ్యానం నిరతము నీ నామం",
        "ఎల్లప్పుడు నీకై నే పాడెదా"
      ],
      "english": [
        "ellappudu nee dhyaanam nirathamu nee naamam",
        "ellappudu neekai ne paadedhaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నా జీవితం అర్పింతున్ నీ కోసమే",
        "నా శ్వాస యేసయ్య నీ కొరకే",
        "ఎల్లప్పుడు నీ ధ్యానం నిరతము నీ నామం",
        "నే పాడెదా నా జీవితాంతము"
      ],
      "english": [
        "Naa jeevitham arpinthun nee kosame",
        "naa swaasa yesayya nee korake",
        "ellappudu nee dhyaanam nirathamu nee naamam",
        "nea paadedhaa naa jeevithaanthamu"
      ]
    }
  ]
}
