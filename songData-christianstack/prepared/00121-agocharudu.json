  "main_stanza": {
    "telugu": [
      "రక్షకుని జన్మస్థలమా",
      "యూదయ బెత్లహేమా",
      "ఆరాధనలకు ఆరంభమా",
      "హృదయార్పణలకు నివాసమా",
      "ఎందుకో ఇంత భాగ్యము",
      "దాచిఉంచే ప్రభు నీకోసము"
    ],
    "english": [
      "Rakshakuni janmasthalamaa",
      "yudhaya bethlehemaa",
      "aaradhanalaku aarambhamaa",
      "hrudhayaarpanalaku nivaasamaa",
      "endhuko intha bhaagyamu",
      "dhaachi unche prabhu neekosamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "స్తుతియు మహిమ ప్రభావము",
        "ఎల్ల వేళల ప్రభుకే చెందును"
      ],
      "english": [
        "Sthuthiyu mahima prabhaavamu",
        "ella vela la prabhuke chendhunu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "స్తుతియు మహిమ ప్రభావము",
        "ఎల్ల వేళల ప్రభుకే చెందును"
      ],
