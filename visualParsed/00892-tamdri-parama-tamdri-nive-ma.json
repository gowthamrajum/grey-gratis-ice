        "విడువని కృపతో అదరించితివి",
        "కల్వరి నాధా స్తుతించెదను"
      ],
      "english": [
        "Oohinchaleni eevula nosagi",
        "Kantipaapalaa kaapaadu thandri",
        "Prematho pilachi sthiraparachithivi",
        "Viduvani krupatho aadharinchithivi",
        "Kalvari naadhaa sthuthinchedanu"
      ]
