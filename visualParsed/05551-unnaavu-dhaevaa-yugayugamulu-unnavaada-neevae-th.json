{
  "song_name": "Unnaavu Deva yugayugamulu - Unnavaada neeve tharatharamulu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ఉన్నావు దేవా యుగయుగములు - ఉన్నవాడ నీవే తరతరములు",
      "ఉందునన్నావు సదాకాలము",
      "యుగ సమ ఆప్తి వరకు - మాతోడై నీడై ||ఉన్నావు||"
    ],
    "english": [
      "Unnaavu Deva yugayugamulu - Unnavaada neeve tharatharamulu",
      "Undhunannaavu sadaakaalamu",
      "Yuga samaapthi varaku - Maathodai needai ||Unnaavu||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మోషేకు తోడై ఉన్నవాడనీవే",
        "నీ జనుల నడిసంద్రాన నడిపించినావే (2)",
        "అరణ్య యాత్రలో అద్భుతములు చేసితివే",
        "ఆకాశమునుండి ఆహార మిచ్చితివే",
        "బండ చీల్చి దాహము తీర్చిన అండవైన దేవుడ నీవే  ||ఉన్నావు||"
      ],
      "english": [
        "Mosheku thodai unnavaada neeve",
        "Nee janula nadisandhraana nadipinchinaave (2)",
        "Aranya yaathralo adbhuthamulu chesithive",
        "Aakaashamunundi aahaara michchithive",
        "Banda cheelchi daahamu theerchina andavaina Devuda neeve  ||Unnaavu||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సింహాల బోనులో దానియేలుతో",
        "ఆ అగ్నిగుండములో ఆబెద్నగోలతో (2)",
        "ఐగుప్తునందున యేసేపుకు తోడై",
        "ఆశీర్వదించి అధిపతిగ చేసితివే",
        "శ్రమలలో నాతోడై వుందనన్నావే  ||ఉన్నావు||"
      ],
      "english": [
        "Simhaala bonulo Dhaaniyeluthoa",
        "Aa agnigundamulo Aabedhnagolatho (2)",
        "Aiguptunandhuna Yosepuku thodai",
        "Aasheervadhinchi adhipathiga chesithive",
        "Shramalalo naathodai vundhanannaave  ||Unnaavu||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కన్నీటి లోయలో కష్టాల కడలిలో",
        "అద్దరికి చేర్చి నన్నాదు కొందువే (2)",
        "నా కన్న తండ్రి వలే కన్నీరు తుడిచితివే",
        "నీ కంటి పాపలా కాపాడు దేవుడవే",
        "ఇమ్మానుయేలువై నీవు నాకున్నావే  ||ఉన్నావు||"
      ],
      "english": [
        "Kanneeti loyalo kashtaala kadalilo",
        "Addariki cherchi nannaadhukonduve (2)",
        "Naa kanna thandri vale kanneeru thudichithive",
        "Nee kanti paapalaa kaapaadu Dhevudave",
        "Immaanuyeluvai neevu naakunnaave  ||Unnaavu||"
      ]
    }
  ]
}
