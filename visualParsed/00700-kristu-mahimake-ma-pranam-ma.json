  "main_stanza": {
    "telugu": [
      "క్రీస్తు మహిమకే మా ప్రాణం మా జీవం మా సర్వం",
      "లోకము మరచి పాడెదము స్తుతి గీతం కలకాలం",
      "చప్పట్లతో తాళాలతో నాట్యముతో కొనియాడెదం",
      "తప్పెట్లతో భజనలతో శాంతి సువార్తను ప్రకటించెదమ్"
    ],
    "english": [
      "Kreesthu mahimake maa praanam maa jeevam maa sarvam",
      "Lokamu marachi paadedamu sthuthi geetham kalakaalam",
      "Chappatlatho thaalaalatho naatyamutho koniyaadedam",
      "Thappetlatho bhajanalatho shaanthi suvaarthanu prakatinchedam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అడుగులు తడబడు వేళ",
