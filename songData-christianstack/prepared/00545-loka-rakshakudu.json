{
  "song_name": "Loka Rakshakudu",
  "author": {
    "Authored by": "Samuel Karmoji",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "లోక రక్షకుడు మనకొరకుదయించెను",
      "మన పాప శాపములన్ని తొలగింపను",
      "ఇమ్మానుయేలుగా మన తోడు ఉండను",
      "లోక రక్షకుడు మనకొరకుదయించెను"
    ],
    "english": [
      "Loka rakshakudu mana korakudhayinchenu",
      "mana paapa shaapamulanni tholagimpanu",
      "emmanueluga mana thodu undanu",
      "loka rakshakudu mana korakudhayinchenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కన్య కుమారునిగా మనకై పుట్టెను",
        "లోక రాజులందరికి దడ పుట్టించెను",
        "సాతాను కోట గోడలన్నీ కూల్చివేయను",
        "కన్య కుమారునిగా మనకై పుట్టెను"
      ],
      "english": [
        "Kanya kumaaruniga manakai puttenu",
        "loka raajulandhariki dhada puttinchenu",
        "sathaanu kota godalanni koolchiveyanu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దావీదు సుతినిగా మన కొరకొచ్చెను",
        "గొల్యాతులందరు ఇక కూలిపోవును",
        "ఆశ్చర్యకరుడిక ఆలోచనిచ్చును"
      ],
      "english": [
        "Dhaaveedhu suthuniga mana korakochenu",
        "golyaathulandharu ika koolipovunu",
        "ascharyakarudika aalochanichunu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "రక్షకుండు ఉదయించెన్",
        "మన పాప శిక్ష తొలగింపఁన్",
        "తన రాజ్యమున ఇక మనలన్",
        "శాశ్వతముగా నిలువనిచ్చెన్"
      ],
      "english": [
        "Rakshakundu udhayinchen",
        "mana paapa siksha tholgimpan",
        "thana rajyamuna ika manalan",
        "saashwathamuga niluvanichen"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆశ్చర్యములను చేసెన్",
        "ఆలోచనను ఇచ్చెన్",
        "బలమును చూపి నిత్యము నిలచి",
        "సమాధానము నొసఁగెన్"
      ],
      "english": [
        "Aascharyamulanu chesen",
        "aalochananu icchen",
        "balamunu choopi nithyamu nilachi",
        "samaadhaanamu nosagen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "ఏది ఎంత మాత్రము నీకు హాని చేయదు",
        "అభిషక్తుడు నీకు అధికారమిచ్చెను",
        "నీ కాళ్ళ క్రింద శత్రువును చితుక ద్రొక్కును"
      ],
      "english": [
        "Edhi entha mathramu neeku haani cheyadhu",
        "abhishakthudu neeku adhikaaramichenu",
        "nee kaalla krindha sathruvunu chithuka dhrokkunu"
      ]
    }
  ]
}
