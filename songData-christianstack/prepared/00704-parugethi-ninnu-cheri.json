{
  "song_name": "Parugethi Ninnu Cheri",
  "author": {
    "Authored by": "Guru Krishna Kadoni, Vishal Dass & Annoz Kamalakar",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పరుగెత్తి నిను చేరి",
      "నీ సన్నిధిలో మోకరించెదా",
      "యేసు నీతో నే నడచి",
      "నీ అడుగులన్ని లెక్కించెదా",
      "నా హృదయం నా మనసు",
      "నా సమస్తము నీకేనయ్యా",
      "అత్మతోను సత్యముతో",
      "నిన్నే నే సేవించెదా"
    ],
    "english": [
      "Parugetthi ninu cheri",
      "nee sannidhilo mokarinchedaa",
      "yesu neetho ne nadachi",
      "nee adugulanni lekkinchedaa",
      "naa hrudhayam naa manasu",
      "naa samasthamu neekenayyaa",
      "athma thonu satyamutho",
      "ninne ne sevinchedaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఆరాధన నీకే ఆరాధన",
        "హల్లేలూయా హల్లేలూయా",
        "హల్లేలూయా ఆమేన్"
      ],
      "english": [
        "Aaraadhana neeke aaraadhana",
        "hallelujah hallelujah",
        "hallelujah amen"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా మార్గము నీవే నా గమ్యము నీవే",
        "నా వెలుగు నీవే ఆధారము నీవే",
        "నా సైన్యము నీవే నా ఖడ్గము నీవే",
        "నా ధైర్యము నీవే నా విజయము నీవే"
      ],
      "english": [
        "Naa maargamu neeve naa gamyamu neeve",
        "naa velugu neeve aadhaaramu neeve",
        "naa sainyamu neeve naa Kadgamu neeve",
        "naa dhairyamu neeve naa vijayamu neeve"
      ]
    }
  ]
}
