{
  "song_name": "Telugu Christmas Mashup 2",
  "author": {
    "Authored by": "Various Artists",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "పాట 1:",
      "నర జన్మమెత్తి వరసుతునిగా",
      "అరుదెంచే నేడు సరసముగా",
      "శ్రీ వేల్పుడగు, ఆనందమూర్థి",
      "క్రీస్తేసు స్వామి ఈ భువిలోన"
    ],
    "english": [
      "Song 1:",
      "Nara janmamethi varasuthiniga",
      "arudhenche nedu sarasamugaa",
      "sri velpudagu, aanandamurthi",
      "kreesthesu swami ee bhuvilona"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "మానసవేది, పావనమూర్థి,",
        "మానవులను పాలించుకర్త",
        "నర జన్మమెత్తి"
      ],
      "english": [
        "Maanasavedhi, pavana murthi,",
        "maanavulanu, paalinchukartha",
        "nara janmamethi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "లోకముద్ధరింప పరిశుద్ధ జన్మ",
        "మెత్తి కన్య మరియ గర్భవతియాయే"
      ],
      "english": [
        "Lokamuddharimpa parishuddha janma",
        "methi kanya mariya garbhavathiyaaye"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాట 2:",
        "బంతియనగ యాడరే మన",
        "బాల చిన్న ముద్దుల యేసుకు"
      ],
      "english": [
        "Song 2:",
        "Banthi yanaga yaadare mana",
        "bala chinna muddhula yesuku"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ముత్తిక తోడ కూడి యాడి",
        "ముద్దుల పరుడు పల్క పరుడు",
        "గ గ గ రి గ మ మ మ మ ప మ ప మ ప ద ని స",
        "ప ద ని స ప ద ని స",
        "ప ద ప ద గ మ గ మ గ రి స రి"
      ],
      "english": [
        "Mutthika thoda kudi yaadi",
        "muddhula parudu palka parudu",
        "Ga ga ga ri ga ma ma ma ma pa ma pa ma pa da ni sa",
        "Pa da ni sa pa da ni sa",
        "Pa da pa da ga ma ga ma ga ri sa ri"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "జ్ఞానులెల్ల వచ్చిరి మంచి కానుకలర్పించిరి"
      ],
      "english": [
        "Gnanulella vachiri manchi kaanukalarpinchiri"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పాట 3:",
        "జననము నొందెను జయ యేసు",
        "జయ గీతములు పాడుడి",
        "ఆ ఆ ఆ ఆ ఆ ఆ",
        "ఆ ఆ ఆ ఆ ఆ ఆ",
        "ఆ ఆ ఆ ఆ ఆ ఆ ఆ"
      ],
      "english": [
        "Song 3:",
        "Jananamu nondhenu jaya yesu",
        "jaya geethamulu paadudi",
        "aa aa aa aa aa aa",
        "aa aa aa aa aa aa",
        "aa aa aa aa aa aa aa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "గొర్రెల కాపరులకు దూత",
        "గొప్ప వార్తను తెలిపెనట"
      ],
      "english": [
        "Gorrela kaaparulaku dhootha",
        "goppa vaarthanu thelipenata"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "పాట 4:",
        "శ్రీ యేసుండు జన్మించె రేయిలో",
        "నేడు పాయక బెత్లేహేమయురిలో"
      ],
      "english": [
        "Song 4:",
        "Sri yesundu janminche reyilo",
        "nedu paayaka bethlehemayurilo",
        "sathramandhuna pasuvula saalayandhuna",
        "devaputhrundu manujundaayenandhuna"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [
        "సత్రమందున పశువుల శాలయందున",
        "దేవపుత్రుండు మనుజుండాయేనందున"
      ],
      "english": [
        "Song 5:",
        "Chuda bodhaamu raare sakala janambulaara",
        "sri yesu naadhuni janmambu",
        "aanandhamutho mana mandharam",
        "aha chuda bodhaamu raare sakala janambulaara",
        "sri yesu naadhuni janmambu"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [
        "పాట 5:",
        "చూడ బోదాము రారె సకల జనంబులార",
        "శ్రీ యేసు నాధుని జన్మంబు",
        "ఆనందముతో మన మందరం",
        "అహ చూడ బోదాము రారె సకల జనంబులార",
        "శ్రీ యేసు నాధుని జన్మంబు"
      ],
      "english": [
        "Ghallu ghalluna manamelli yesuni",
        "padhambu jambulaku mrokkedhamu",
        "aanandhamutho mana mandharam",
        "aha chuda aha chuda",
        "aha chudabodhamu raaresakala janambulaara",
        "sri yesu naadhuni janmambu"
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [
        "గల్లు గల్లున మనమెల్లి యేసుని",
        "పాదంబు జంబులకు మ్రొక్కెదము",
        "ఆనందముతో మన మందరం",
        "అహ చూడ అహ చూడ",
        "అహ చూడ బోదాము రారె సకల జనంబులార",
        "శ్రీ యేసు నాధుని జన్మంబు"
      ],
