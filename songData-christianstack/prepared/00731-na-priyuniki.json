  },
  "main_stanza": {
    "telugu": [
      "నా ప్రియునికి ఒక తోట వున్నది",
      "దానిలో మందను మేపుచుండెను",
      "పద్మములు వికసించెను – పరిమళము వ్యాపించెను"
    ],
    "english": [
      "Na priyuniki oka thota unnadhi",
      "dhaanilo mandhanu mepuchundenu",
      "padmamulu vikasinchenu – parimalamu vyaapinchenu"
    ]
  },
