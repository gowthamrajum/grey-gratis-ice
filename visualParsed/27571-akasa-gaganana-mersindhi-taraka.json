      "english": [
        "*1 )* Bethlahemu nagaraana",
        "Kanya Mariya garbhaana",
        "Pashulapaakalo pavalinchaadu Yesayya \" 2 \"",
        "Velaadi doothala gaanaprathi gaanamulatho",
        "Kotlaadi doothala sainya samoohamutho \" 2 \"",
        "Naakosame bhuvikethenchenu",
        "Najarethu vaanigaa \" 2 \"  ||Aakaashagaganaana||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "*2 )* గాబ్రియేలు దేవ దూత",
