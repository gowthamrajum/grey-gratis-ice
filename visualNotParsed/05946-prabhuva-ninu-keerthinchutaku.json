{
  "song_name": "Prabhuvaa Ninu Keerthinchutaku",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "ప్రభువా నిను కీర్తించుటకు వేనోళ్ళ చాలునా",
      "దేవా నీకు అర్పించుటకు పొట్టేళ్లు చాలునా.",
      "ఎంతగ నిను కీర్తించినను యేమేమి అర్పించినను",
      "ఎంతగ నిన్ను కీర్తించినను యేమేమి అర్పించినను (2)",
      "నీ ఋణము నే తీర్చగలనా",
      "తగిన కానుక నీకు అర్పింపగలనా"
    ],
    "english": [
      "Prabhuvaa ninu keerthinchutaku venolla chaalunaa",
      "Deva neeku arpinchutaku pottellu chaalunaa.",
      "Enthaga ninu keerthinchinanu ememi arpinchinanu",
      "Enthaga ninnu keerthinchinanu ememi arpinchinanu (2)",
      "Nee runamu ne theerchagalanaa",
      "Thagina kaanuka neeku arpimpagalanaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కుడి ఎడమవైపుకు విస్తరింపజేసి నా గుడారమునే విశాల పరచి",
        "ఇంతగ నను హెచ్చించుటకు నే తగుదునా ..... నే తగుదునా.....",
        "వింతగ నను దీవించుటకు నేనర్హుడనా. నేనర్హుడనా...."
      ],
      "english": [
        "Kudi edamavaipuku vistharimpajesi naa gudaaramune vishaala parachi",
        "Inthaga nanu hechchinchutaku ne thagudunaa ..... ne thagudunaa.....",
        "Vinthaga nanu dheevinchutaku nenarhudanaa. Nenarhudanaa...."
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీ నోటి మాట నా ఊటగ నుంచి నా జీవితమునే నీ సాక్షిగ నిలిపి",
        "ఇంతగ నను వాడుకొనుటకు నే తగుదునా... నే తగుదునా...",
        "వింతగ నన్ను హెచ్చించుటకు నేనర్హుడనా. నేనర్హుడనా....."
      ],
      "english": [
        "Nee noti maata naa ootaga nunchi naa jeevithamune nee saakshiga nilipi",
        "Inthaga nanu vaadukonutaku ne thagudunaa... ne thagudunaa...",
        "Vinthaga nannu hechchinchutaku nenarhudanaa. Nenarhudanaa....."
      ]
    }
  ]
}
