{
  "song_name": "Viswaasa vanithalam Yehova needana nivaasulam",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Joshua Shaik"
    ],
    "రచన": [
      "జాషువా షేక్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "విశ్వాస వనితలం – యెహోవా నీడన నివాసులం",
      "కన్నీటి ప్రార్ధనే మా బలం",
      "ఆత్మ ఫలములే మా వరం",
      "జయగీతం పాడెదం – విజయ కీర్తన పాడెదం"
    ],
    "english": [
      "Viswaasa vanithalam – Yehova needana nivaasulam",
      "Kanneeti praardhane maa balam",
      "Aathma phalamule maa varam",
      "Jayageetham paadedam – Vijaya keerthana paadedam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "జ్ఞానము కలిగి జీవించెదం – యేసుని ప్రేమలో నిలిచెదం",
        "విశ్వాసములో ఎదిగెదం – దేవుని సాక్షిగా బ్రతికెదం"
      ],
      "english": [
        "Gnaanamu kaligi jeevinchedham – Yesuni premalo nilichedham",
        "Viswaasamulo edhigedham – Devuni saakshigaa brathikedham"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శోధనలెన్నో కలిగిన – వాక్యపు వెలుగులో నడిచెదం",
        "ఎర్ర సముద్రములెదురైన – దేవుని కృపతో దాటెదం",
        "నీవే ఇల ఆధారం నీవే ఇల ఆనందం నీతోనే మా పయనం యేసయ్య",
        "నీవే మా విశ్వాసం నీవే మా ఉత్సాహం నీతోనే మా విజయం యేసయ్య"
      ],
      "english": [
        "Shodhanalenno kaligina – Vaakyapu velugulo nadichedham",
        "Erra samudhramuledhuraina – Devuni krupatho daatedham",
        "Neeve ila aadhaaram neeve ila aanandam neethone maa payanam Yesayya",
        "Neeve maa viswaasam neeve maa uthsaaham neethone maa vijayam Yesayya"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవుని చిత్తమునే చేసెదం – యేసుని నామమే ప్రకటించెదం",
        "సువార్త భారముతో సాగెదం – సర్వలోకానికి చాటెదం"
      ],
      "english": [
        "Devuni chitthamune chesedam – Yesuni naamame prakatinchedham",
        "Suvaartha bhaaramutho saagedam – Sarvalokaaniki chaatedham"
      ]
    }
  ]
}
