{
  "song_name": "Raraju Puttadoi",
  "author": {
    "Authored by": "Joshua Shaik",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "రారాజు పుట్టాడోయ్ మారాజు పుట్టాడోయ్",
      "సూడంగ రారండోయ్ వేడంగ రారండోయ్"
    ],
    "english": [
      "Raaraaju puttaadoi",
      "maaraaju puttaadoi",
      "soodanga raarandoi",
      "vedanga raarandoi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఈ లోకమునకు రక్షకుడిక పుట్టినాడండోయ్",
        "మన కొరకు దేవదేవుడు దిగి వచ్చినాడండోయ్",
        "నింగి నేల పొంగిపోయే",
        "ఆ తార వెలసి మురిసిపోయే సంబరమాయెనే"
      ],
      "english": [
        "Ee lokamunaku rakshakudika puttinaadandoi",
        "mana koraku devadevudu dhigi vachinaadandoi",
        "ningi nela pongipoye",
        "aa thaara velasi murisipoye sambaramaayeney"
      ]
    }
  ]
}
