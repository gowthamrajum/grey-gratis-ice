      ],
      "english": [
        "Akkada Daaveedu vamsheeyula yokka",
        "Neethi simhaasanamu sthaapinchabadenu"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "యెరూషలేము క్షేమము కొరకు",
        "యెడతెగక ప్రార్థన చేయుడి"
      ],
      "english": [
        "Yerooshalemu kshemamu koraku",
        "Edathegaka praarthana cheyudi"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "యెరూషలేమా నిన్ను ప్రేమించువారు",
