      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దైవ ప్రేమ పారుచున్నది (3) కల్వరిగిరి మీదనుండి",
        "నీ పాపమెల్ల అందుపోవును (3) స్నానంబుచేసినన్"
      ],
      "english": [
        "Daiva prema paaruchunnadhi (3) Kalvarigiri meedhanundi",
        "Nee paapamella andhupovunu (3) Snaanambuchesinan"
