{
  "song_name": "Parishuddha parishuddha Prabhuyesu rammu",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పరిశుద్ధ పరిశుద్ధ ప్రభుయేసు రమ్ము",
      "మాకు నేడే నీ దీవెనలిమ్ము"
    ],
    "english": [
      "Parishuddha parishuddha Prabhuyesu rammu",
      "Maaku nede nee dheevenalimmu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సంపూర్ణ హృదయముతో నిన్ను స్తుతించుటకు",
        "కృపనిమ్మయా - కృపనిమ్మయా"
      ],
      "english": [
        "Sampoorna hrudayamutho ninnu sthuthinchutaku",
        "Krupanimmayaa - Krupanimmayaa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వేడుచున్నాము యేసు - వేగిరముగా రమ్ము",
        "రమ్ము ప్రియుడా - రమ్ము ప్రియుడా"
      ],
      "english": [
        "Veduchunnaamu Yesu - Vegiramugaa rammu",
        "Rammu priyudaa - Rammu priyudaa"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "హృదయముల నీరక్తముచే శుద్ధి చేయుమా",
        "శుద్ధిచేయుమా - శుద్ధిచేయుమా"
      ],
      "english": [
        "Hrudhayamula neerakthamuche shuddhi cheyumaa",
        "Shuddhicheyumaa - Shuddhicheyumaa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ఆత్మతో మా హృదయముల - నిప్పుడు నింపుమా",
        "ప్రభు నింపుమా - ప్రభు నింపుమా"
      ],
      "english": [
        "Aathmatho maa hrudhayamula - Nippudu nimpumaa",
        "Prabhu nimpumaa - Prabhu nimpumaa"
      ]
    }
  ]
}
