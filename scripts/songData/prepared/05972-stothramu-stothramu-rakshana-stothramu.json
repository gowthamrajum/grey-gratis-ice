{
  "song_name": "Stothramu Stothramu Rakshana Stothramu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "స్తోత్రము స్తోత్రము - రక్షణస్తోత్రము స్తోత్రము దేవుని గొర్రెపిల్లకు-స్తోత్రము జేసెద-శ్రీయేసునకు స్తోత్రార్డుండగు జయ విజయునకు"
    ],
    "english": []
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దాస్యము బోయెను-యేసు రక్తముచే దాస్యము బోయి-స్వతంత్రుడనైతిని2.చీకటి తొలగెను-యేసు రక్తముచే చీకటి తొలగెను -తేజము వచ్చెను"
      ],
      "english": []
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాప క్షమాపణ-యేసు రక్తముచే పాప క్షమాపణ-పరమానందము"
      ],
      "english": []
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పాపము బాసెను-యేసు రక్తముచే పాపము బాసెను-శుద్దుడనైతిని"
      ],
      "english": []
    },
    {
      "stanza_number": 5,
      "telugu": [
        "శాపము బోయెను-యేసు రక్తముచే శాపము బోయెను-నీతియు వచ్చెను"
      ],
      "english": []
    },
    {
      "stanza_number": 6,
      "telugu": [
        "సైతానోడెను-యేసు రక్తముచే సైతానోడెను-విజయము వచ్చెను"
      ],
      "english": []
    }
  ]
