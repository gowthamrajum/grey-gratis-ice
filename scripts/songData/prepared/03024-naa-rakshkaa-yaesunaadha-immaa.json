{
  "song_name": "Naa Rakshakaa Yaesunaadha Immaanuyaelu",
  "author": {
    "Authored by": "",
    "రచన": "తిరుకోవళ్లూరి స్టీవెన్"
  },
  "main_stanza": {
    "telugu": [
      "నా రక్షకా యేసునాధ ఇమ్మానుయేలు",
      "ఘోర పాపుల పాప భార విమోచక"
    ],
    "english": [
      "Naa Rakshakaa Yaesunaadha Immaanuyaelu",
      "Ghoara Paapula Paapa Bhaara Vimoachaka"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నిత్యకాలమునందు నిజమైన దేవుని",
        "సత్యవాక్యమై యున్న స్వామి నిన్నుతియింతు"
      ],
      "english": [
        "Nithyakaalamunandhu Nijamaina Dhaevuni",
        "Sathyavaakyamai Yunna Svaami Ninnuthiyinthu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సర్వ లోకంబులను సత్యవాక్యమై యుండి",
        "నిర్వహించిన దేవుని నిజబాహువా స్తుతింతు"
      ],
      "english": [
        "Sarva Loakambulanu Sathyavaakyamai Yundi",
        "Nirvahinchina Dhaevuni Nijabaahuvaa Sthuthinthu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవజనులకు సువార్త దెలుప నభిషేకంబు",
        "పూని నొందిన దేవపుత్రుడ నుతియింతు"
      ],
      "english": [
        "Dhaevajanulaku Suvaartha Dhelupa Nabhishaekambu",
        "Pooni Nondhina Dhaevaputhruda Nuthiyinthu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "దేవ మహిమ ప్రకాశ దీనరక్షక మాను",
        "ష్యావతారము దాల్చి యావదాజ్ఞల దీర్చిన"
      ],
      "english": [
        "Dhaeva Mahima Prakaasha Dheenarakshaka Maanu",
        "Shyaavathaaramu Dhaalchi Yaavadhaajnala Dheerchina"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పావనాద్భుతుడవై పరమ జ్ఞానము దెల్పిన",
        "దేవస్వభావ ముద్ర దేదీప్యుడా స్తుతింతు"
      ],
      "english": [
        "Paavanaadhbhuthudavai Parama Jnaanamu Dhelpina",
        "Dhaevasvabhaava Mudhra Dhaedheepyudaa Sthuthinthu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పాపాత్ములను గావ శాపభారము క్రింద",
        "నోపికతో నిల్చి ప్రాపు జూపిన ప్రభువా"
      ],
      "english": [
        "Paapaathmulanu Gaava Shaapabhaaramu Krindha",
        "Noapikathoa Nilchi Praapu Joopina Prabhuvaa"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "ఈ వసుధను ప్రేమ నెసగునట్లుగ జూపి",
        "చావు గెల్చిన సర్వ సామర్థ్యుడా స్తుతింతు"
      ],
      "english": [
        "Ee Vasudhanu Praema Nesagunatluga Joopi",
        "Chaavu Gelchina Sarva Saamarthyudaa Sthuthinthu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "ఘన దేవుని కుడి పార్శ్వమున గూర్చుండి",
        "విజ్ఞప్తి నొనరించు నా యేసు వినయ స్తోత్రంబిదిగో"
      ],
      "english": [
        "Ghana Dhaevuni Kudi Paarshvamuna Goorchundi",
        "Vijnapthi Nonarinchu Naa Yaesu Vinaya Sthoathrambidhigoa"
      ]
    }
  ]
}
