    {
      "stanza_number": 8,
      "telugu": [
        "రాజాధిరాజు యేసే - ప్రభుల ప్రభు యేసే",
        "పరమందు దూతలు - యిహమందు నరులు హల్లెలూయ పాడుడి"
      ],
      "english": [
        "Raajaadhiraaju Yese - Prabhula prabhu Yese",
        "Paramandu doothalu - Ihamandu narulu halleluya paadudi"
