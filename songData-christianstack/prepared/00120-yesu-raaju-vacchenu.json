        "దూతల గానం మ్రోగెను,",
        "ఆకాశమంతా స్తోత్రం నీకే యేసయ్యా"
      ],
      "english": [
        "Aakashamanta velugaipoyenu",
        "Aathmagaanam vinipinchenu",
        "Dhuthala gaanam mrogenu",
        "Aakashamantha sthothram neeke Yesayya"
      ]
    },
    {
      "stanza_number": 3,
