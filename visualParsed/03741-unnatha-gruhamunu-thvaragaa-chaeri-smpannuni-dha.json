  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఉన్నత గృహమును త్వరగా చేరి",
        "సంపన్నుని దర్శింతును - ఈ",
        "పేదగు నా కోర్కె సఫలము చేసిన",
        "నాథుని కొనియాడుదున్"
      ],
      "english": [
        "Unnatha gruhamunu thvaragaa cheri",
        "Sampannuni darshinthunu - Ee",
        "Pedhagu naa korke saphalamu chesina",
        "Naathuni koniyaadudhun"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "దూతల మధ్యను స్తోత్రము లొందెడు",
        "ప్రభుని స్తోత్రింతును - సు",
        "గంధము వీచెడి పుష్ప రాజంబుల",
        "మధ్యను నిద్రింతున్"
      ],
      "english": [
        "Doothala madhyanu sthothramu londedu",
        "Prabhuni sthothrinthunu - Su",
        "Gandhamu veechedi pushpa raajambula",
        "Madhyanu nidhrinthun"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆకాశ గణములు సేవించుచుండగ",
        "వీకతో వారిజేరుదున్ - నా",
        "యేసుని స్తుతుల నోరార పాడి",
        "భాసురముగ నుతింతున్"
      ],
      "english": [
        "Aakaasha ganamulu sevinchuchundaga",
        "Veekatho vaarijerudhun - Naa",
        "Yesuni sthuthula noraara paadi",
        "Bhaasuramuga nuthinthun"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "స్ఫటిక నది తీరమున నేను",
        "పాడుచు తిరుగుదును - ఆ",
        "బంగారు వీధిలో యేసుతో నేను",
        "రంగుగ నడుగిడుదున్"
      ],
      "english": [
        "Sphatika nadi theeramuna nenu",
        "Paaduchu thirugudhunu - Aa",
        "Bangaaru veedhilo Yesutho nenu",
        "Ranguga nadugidudhun"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "పలువిధ మృగములు పైబడినను",
        "నెవ్విధమున భయపడను - ఆ",
        "వెంగియు సింహము నాపై వచ్చిన",
        "నగవుతో రమ్మనెదన్"
      ],
      "english": [
        "Paluvidha mrugamulu paibadinanu",
        "Nevvidhamuna bhayapadanu - Aa",
        "Vengiyu simhamu naapai vachchina",
        "Nagavutho rammanedhan"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "పక్షులు అయ్యెడ ననేకముండును",
        "వృక్షఫలములుండున్ - నా",
        "రక్షకుడగు యేసు నాకై చేర్చిన",
        "అక్షయ ధనముండున్"
      ],
      "english": [
        "Pakshulu ayyeda nanekamundunu",
        "Vrukshaphalamulundun - Naa",
        "Rakshakudagu Yesu naakai cherchina",
        "Akshaya dhanamundun"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [
        "పేతురు యోహాను పౌలుతో నేనును",
        "ప్రీతితో వసియింతును - నా",
        "చల్లని మిత్రుని ఇంటను హర్షముతో",
        "హల్లెలూయ పాడెదను"
      ],
      "english": [
        "Pethuru Yohaanu Paulutho nenunu",
        "Preethitho vasiyinthunu - Naa",
        "Challani mithruni intanu harshamutho",
        "Halleluya paadedanu"
      ]
    }
  ]
