{
  "song_name": "Gaganana Ontari O’ Tara",
  "author": {
    "Authored by": "Jayadev Nada",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గగనాన ఒంటరి- ఓ తార-",
      "తలలెత్తి ఒంటెలు చూసాయా?"
    ],
    "english": [
      "Gaganaana ontari – O thaara –",
      "Thalaletthi ontelu choosaayaa?"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఒంటెల కంటికి వింతగా-",
        "కనిపించెను ఈ చుక్కా –",
        "వెలుగు పీల్చిన ఇసుక దూదిపై-",
        "(అవి) నడచెను ఎంచక్క…"
      ],
      "english": [
        "Ontela kantiki vinthagaa –",
        "Kanipinchenu ee chukka –",
        "Velugu pelchina isuku dhoodhipai –",
        "(Avi) nadachenu enchakka…"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కాపరి వేసే -ఈలలే –",
        "గొర్రెల చెవులకు – వీణలే",
        "కురిసెను మంచు-పూవులై",
        "పక్రృతి అంతా-నిశ్శబ్ధమై-",
        "” దేవునికి మహిమ -ఇల మనుషులకు శాంతి”",
        "వేలాది దూతలు భువి కొచ్చి పాడిరి",
        "అద్భుత ఈ గీతం.",
        "“విన్నారు గొల్లలు -వీక్షించె గొర్రెలు-”",
        "పరలోక పాటను -వినిన వీరలు",
        "చరితలో మిగిలారు."
      ],
      "english": [
        "Kaapari vese eelale –",
        "Gorrela chevulaku veenale",
        "Kurisenu manchu – poovulai",
        "Prakruthi anthaa – nisshabdhamai –"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆ….హల్లెలూయా..హల్లెలూయా..హల్లెలూయా….",
        "హో సన్నా…యేసన్నా..,స్వాగతం."
      ],
      "english": [
        "“Dhevuniki mahima – ila manushulaku shaanthi”",
        "Velaadhi dhoothalu bhuvi kochchi paadiri",
        "Adbhutha ee geetham."
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కధయో?కల్పనో? కాదు ఇది",
        "ప్రభుని చరిత -చెరగనిది",
        "ఇలపై ఇక ఇది -జరగనిది",
        "ఇకపై మనమిక కనము ఇది",
        "“పాపుల పుణ్యమిది-",
        "ప్రభు యేసుని జన్మమిది”"
      ],
      "english": [
        "“Vinnaru gollalu – veekshinche gorrelu”",
        "Paraloka paatanu – vinina veerulu",
        "Charithalo migilaaru."
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "రక్షణను ఈ క్రిస్మస్ పండుగ",
        "మనకై తెచ్చినది",
        "” దేవునికివ్వు మది-",
        "అనుమానం ఏమున్నది?”",
        "దేవుని రాకడ ప్రకటించుటయే-",
        "మనకిక మిగిలున్నది."
      ],
      "english": [
        "Aa… halleluya… halleluya… halleluya…",
        "Hosanna… Yesanna… swaagatham."
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "ఆ…హలెలూయా -హలెలూయా -హలెలూయా",
        "హో సన్నా …యేసన్న – స్వాగతం"
      ],
      "english": [
        "Kadhayo? Kalpano? Kaadu idhi",
        "Prabhuni charitha – cheraganidhi",
        "Ilapai ika idhi – jaraganidhi",
        "Ikapai manam ika kanamu idhi"
      ]
    },
    {
      "stanza_number": 7,
      "telugu": [],
      "english": [
        "“Paapula punyam idhi –",
        "Prabhu Yesuni janmam idhi”"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [],
      "english": [
        "Rakshananu ee Christmas panduga",
        "Manakai thechchinadhi"
      ]
    },
    {
      "stanza_number": 9,
      "telugu": [],
      "english": [
        "“Dhevuniki ivvu madhi –",
        "Anumaanam emunnadhi?”"
      ]
    },
    {
      "stanza_number": 10,
      "telugu": [],
      "english": [
        "Dhevuni raakada prakatinchutaye –",
        "Manaki ika migilunnadhi."
      ]
    },
    {
      "stanza_number": 11,
      "telugu": [],
      "english": [
        "Aa… halleluya… halleluya… halleluya…",
        "Hosanna… Yesanna… swaagatham."
      ]
    }
  ]
}
