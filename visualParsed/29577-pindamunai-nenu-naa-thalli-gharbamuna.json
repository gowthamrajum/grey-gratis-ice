  "main_stanza": {
    "telugu": [
      "పిండమునై నేను నా తల్లి గర్భమున",
      "ఉండగానే నన్ను పిలిచిన నా దేవా",
      "పాపములో నుండి నన్ను రక్షించి",
      "తండ్రివై నన్ను నడిపిన నా నాధా"
    ],
    "english": [
      "Pindamunai nenu naa thalli garbhamuna",
      "Undagaane nannu pilichina naa Deva",
      "Paapamulo nundi nannu rakshinchi",
      "Thandrivai nannu nadipina naa naadhaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "కంటిపాపలా కాయు నా దేవా",
        "చేయి విడువక నడిపిన నా ప్రభువా"
      ],
      "english": [
        "Kantipaapalaa kaayu naa Deva",
        "Cheyi viduvaka nadipina naa Prabhuva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నా ఆధారం నీవే నా సర్వస్వం నీవే",
        "నా ప్రాణం నీవే నా సహాయం నీవే"
      ],
      "english": [
        "Naa aadhaaram neeve naa sarvasvam neeve",
        "Naa praanam neeve naa sahaayam neeve"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నడకను నాకు నేర్పిన",
        "నా పరమ తండ్రివి నీవే దేవా",
        "జీవితమే బహుమానముగా",
        "నాకు ఇచ్చిన నా జీవ దాత",
        "కునుకడు నిదురించడు",
        "మరువడు విడనాడడు",
        "చేయిపట్టి నడుపును",
        "శిఖరముపైన నిలుపును"
      ],
      "english": [
        "Nadakanu naaku nerpina",
        "Naa parama thandrivi neeve Deva",
        "Jeevithame bahumaanamugaa",
        "Naaku ichchina naa jeeva daatha",
        "Kunukadu nidhurinchadu",
        "Maruvadu vidanaadadu",
        "Cheyipatti nadupunu",
        "Shikharamupaina nilupunu"
      ]
    }
  ]
