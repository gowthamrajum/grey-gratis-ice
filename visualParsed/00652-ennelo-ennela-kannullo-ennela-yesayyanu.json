    {
      "stanza_number": 4,
      "telugu": [
        "సక్కనయ్య మోముజూడ సిక్కులన్ని తీరిపోవు",
        "మక్కువతో శరణువేడ బతుకంతా మనలగాయు"
      ],
      "english": [
        "Sakkanayya momujooda sikkulanni theeripovu",
        "Makkuvatho sharanuveda bathukanthaa manalagaayu"
