{
  "song_name": "Pavithra parachumu naa hrudayam",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "పవిత్ర పరచుము నా హృదయం-నీ వాక్యమే నా ఆధారం",
      "పరిశుద్ధ పరచుము నానడతన్"
    ],
    "english": [
      "Pavithra parachumu naa hrudayam - Nee vaakyame naa aadhaaram",
      "Parishuddha parachumu naa nadathan"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అగ్నివంటి వాక్యముతో-మలినమైన నా హృదయం",
        "పరిశుద్ధ పరచుమయ-దయగల యేసయ్య  ||పవిత్ర||"
      ],
      "english": [
        "Agnivanti vaakyamutho - Malinamaina naa hrudayam",
        "Parishuddha parachumaya - Dayagala Yesayya  ||Pavithra||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "సుత్తెవంటి వాక్యముతో-మెత్తన చేయము నా హృదయం",
        "అతి వినయము తోనే-వెంబడించెదను  ||పవిత్ర||"
      ],
      "english": [
        "Sutthevanti vaakyamutho - Metthana cheyamu naa hrudayam",
        "Athi vinayamu thone - Vembadinchedanu  ||Pavithra||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "వెలుగువంటి వాక్యముతో-వెలిగి నన్ను నింపుమయ",
        "పెనుతుఫానులలో-వెలుగుగా జేయుమయ  ||పవిత్ర||"
      ],
      "english": [
        "Veluguvanti vaakyamutho - Veligi nannu nimpumaya  ||Pavithra||",
        "Penuthuphaanulalo - Velugugaa jeyumaya  ||Pavithra||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సజీవమైన వాక్యముతో-నిత్యము నడుపుము ఓ ప్రభువా",
        "జీవితకాలమంతా-నిన్ను నే సేవింతున్  ||పవిత్ర||"
      ],
      "english": [
        "Sajeevamaina vaakyamutho - Nithyamu nadupumu O Prabhuvaa  ||Pavithra||",
        "Jeevithakaalamanthaa - Ninnu ne sevinthun  ||Pavithra||"
      ]
    }
  ]
}
