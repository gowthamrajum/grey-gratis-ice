{
  "song_name": "Anduko Naa Upavasa",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "సుసాధ్యమేగా",
      "అసాధ్యములన్నీ",
      "ఉపవాస ప్రార్థనలో",
      "ఆ…ఆ…ఉపవాస ప్రార్థనలో"
    ],
    "english": [
      "Susadhyamega",
      "Asadhyamulanni",
      "Upavaasa prarthanalo",
      "Aa… Aa… Upavaasa prarthanalo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "అందుకో నా ఉపవాస ప్రార్థన",
        "ధూపమువోలె నా యేసయ్యా",
        "అన్నపానములు విడచి నీ సన్నిధిలో",
        "చేసెద నీతో సహవాసమే"
      ],
      "english": [
        "Anduko naa upavaasa prarthana",
        "Dhoopamuvole naa Yesayya",
        "Annapaanamulu vidachi nee sannidhilo",
        "Cheseda neetho sahavasame"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "అతిక్రమములు జరిగించి",
        "అణచబడిరి మా పితరులు",
        "ఉపవాసముతో పోరాడగా ఊరేగింపాయెను ఆ ఉరియే",
        "అమ్మబడిన వారిని అధిపతులనుగా చేసిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Atikramamulu jariginchi",
        "Anachabadiri maa pitarulu",
        "Upavaasamutho poradaga ooregimpayena aa uriye",
        "Ammabadina vaarini adhipathulanu ga chesina",
        "Needu kriyalu aascharyame mahadascharyame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కుడి ఎడమలు ఎరుగక",
        "దోషము చేసిన ఆ జనములు",
        "పశ్చాత్తాప్తులై పసికందులతో ప్రలాపించిరే పరివర్తనతో",
        "ఉగ్రత నుండి భద్రతకు శీఘ్రముగా నడిపించిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Kudi edamalu erugaka",
        "Doshambu chesina aa janamulu",
        "Paschattaptulai pasikandulatho pralapinchire parivartanatho",
        "Ugrata nundi bhadrataku sheeghramuga nadipinchina",
        "Needu kriyalu aascharyame mahadascharyame"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "కన్నీటి నైవేద్యము కానుకగా నీకర్పింపగా",
        "కనుమరుగాయే కన్నీటి కడలి",
        "దీవెనలాయే ఆ నిందలే",
        "మా ఉపవాసమునే చూచిన",
        "మా స్థితిగతులన్నీ మార్చిన",
        "నీదు క్రియలు ఆశ్చర్యమే మహదాశ్చర్యమే"
      ],
      "english": [
        "Kanniti naivedhyamu kanukaga neekarpinchaga",
        "Kanumurugaaye kanniti kadali",
        "Deevenalaaye aa nindale",
        "Aa upavaasamune choochina",
        "Maa sthitigatulanni maarchina",
        "Needu kriyalu aascharyame mahadascharyame"
      ]
    }
  ]
}
