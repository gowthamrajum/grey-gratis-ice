{
  "song_name": "Naa Jeevitham Neekankitham",
  "source": "wtc",
  "author": {
    "Authored by": [
      "Bro Yesanna"
    ],
    "రచన": [
      "బ్రదర్ యేసన్న"
    ]
  },
  "main_stanza": {
    "telugu": [
      "నా జీవితం - నీకంకితం",
      "కడవరకు సాక్షిగా - నన్ను నిలుపుమా - ప్రభూ"
    ],
    "english": [
      "Naa jeevitham - Neekankitham",
      "Kadavaraku saakshigaa - Nannu nilupumaa - Prabhoo"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బీడుబారినా  ||నా||",
        "నీ సిలువ జీవ ఊటలు - నన్ను చిగురింపజేసెనే ॥ నా జేవితం ॥"
      ],
      "english": [
        "Beedubaarinaa  ||Naa||",
        "Nee siluva jeeva ootalu - Nannu chigurimpajesene ||Naa jeevitham||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పచ్చని ఒలీవనై - నీ మందిరావరణములో",
        "నీ తోనే ఫలించెదా - బ్రతుకు దినములన్నిట ॥ నా జేవితం ॥"
      ],
      "english": [
        "Pachchani oleevanai - Nee mandhiraavaranamulo",
        "Nee thone phalinchedhaa - Brathuku dhinamulannita ||Naa jeevitham||"
      ]
    }
  ]
}
