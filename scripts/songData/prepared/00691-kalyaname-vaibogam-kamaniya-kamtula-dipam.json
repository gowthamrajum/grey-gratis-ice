{
  "song_name": "Kalyaname Vaibogam Kamaniya Kamtula Dipam",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "కళ్యాణమే వైబోగం కమనీయ కాంతుల దీపం",
      "శృతిలయల సుమధురగీతం దైవరచిత సుందరకావ్యం"
    ],
    "english": [
      "Kalyaname Vaibogam Kamaniya Kamtula Dipam",
      "Srutilayala Sumadhuragitam Daivarachita Sumdarakavyam"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పరమదైవమే ప్రారంభించిన పరిశుద్ధమైన కార్యం",
        "నరుని మంచికై తన చేతులతో ప్రభు రాసిచ్చిన పత్రం"
      ],
      "english": [
        "Paramadaivame Prarambimchina Parisuddhamaina Karyam",
        "Naruni Mamchikai Tana Chetulato Prabu Rasichchina Patram"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కీడు తొలగించి మేలుతో నింపు ఆశీర్వాదాల వర్షం",
        "మోడుగానున్న జీవితాలు చిగురింపజేసే వసంతం"
      ],
      "english": [
        "Kidu Tolagimchi Meluto Nimpu Asirvadala Varsham",
        "Moduganunna Jivitalu Chigurimpajese Vasamtam"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "దేవదూతలే తొంగిచూసేటి రమణీయమైన దృశ్యం",
        "భావమధురిమలు పొంగజేసేటి కమనీయమైన చత్రం"
      ],
      "english": [
        "Devadutale Tomgichuseti Ramaniyamaina Drusyam",
        "Bavamadhurimalu Pomgajeseti Kamaniyamaina Chatram"
      ]
    }
  ]
}
