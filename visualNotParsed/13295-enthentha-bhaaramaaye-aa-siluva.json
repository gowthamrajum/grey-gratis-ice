      "english": [
        "Velalenidhi thandri nee thyaagamu",
        "Nee kashtamanthayu naa paapamu (2)",
        "Madilona koluvundu naa rakshakaa",
        "Vadhiledhi ledu ninnu naa paalika (2) ||Yesayyaa||"
      ]
