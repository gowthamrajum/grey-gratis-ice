{
  "song_name": "Naa Priya Yaesunipai Aanukoni",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నా ప్రియ యేసునిపై ఆనుకొని",
      "అరణ్య మార్గమున నడుచుటయే ఆనంద జీవితము"
    ],
    "english": [
      "Naa Priya Yaesunipai Aanukoni",
      "AraNya Maargamuna Naduchutayae AanMdha Jeevithamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "లిల్లిపుష్పం షారోనురోజ పరిశుద్ధమైన మాదు తండ్రి",
        "పూర్ణరూప సౌందర్యుడే కీర్తింపతగిన దేవ"
      ],
      "english": [
        "LillipuShpM Shaaroanuroaja ParishudhDhamaina Maadhu ThMdri",
        "PoorNaroopa SauMdharyudae KeerthiMpathagina Dhaeva"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "కన్యకలు ప్రేమించుదేవ నా ప్రభునామము పరిమళమే",
        "యేసుని వెనుక వచ్చితిమి నన్ను ఆకర్షించెను"
      ],
      "english": [
        "Kanyakalu PraemiMchudhaeva Naa Prabhunaamamu ParimaLamae",
        "Yaesuni Venuka Vachchithimi Nannu AakarShiMchenu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రేమధ్వజ మెగురుచుండగ ప్రియునిసముఖము కలుగుటచే",
        "జల్దరు వృక్షము క్రింద కలిగెను ప్రియుని ఆదరణ"
      ],
      "english": [
        "PraemaDhvaja MeguruchuMdaga Priyunisamukhamu Kalugutachae",
        "Jaldharu VrukShmu KriMdha Kaligenu Priyuni AadharaNa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "నిద్రించు రాత్రిసమయమునందు నిత్యం నా ఆత్మ మేలుకొని",
        "నా తలుపు నొద్ద నిలచిన యేసుని ప్రేమించెదన్"
      ],
      "english": [
        "NidhriMchu RaathrisamayamunMdhu NithyM Naa Aathma Maelukoni",
        "Naa Thalupu Nodhdha Nilachina Yaesuni PraemiMchedhan"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "అగ్నిజ్వాల యేసుని ప్రేమ మరణమువలె బలవంతమైనది",
        "నీటి ప్రవాహమువలన ఆప్రేమ చల్లారదు"
      ],
      "english": [
        "Agnijvaala Yaesuni Praema MaraNamuvale BalavMthamainadhi",
        "Neeti Pravaahamuvalana Aapraema Challaaradhu"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "దీనస్థంభము వలె దిగివచ్చును దేవకుమారుడు మహిమతో",
        "ఘనులైన వారి రథమువలె పై కెగిరిపోదును"
      ],
      "english": [
        "DheenasThMbhamu Vale Dhigivachchunu Dhaevakumaarudu Mahimathoa",
        "Ghanulaina Vaari RaThamuvale Pai Kegiripoadhunu"
      ]
    }
  ]
}
