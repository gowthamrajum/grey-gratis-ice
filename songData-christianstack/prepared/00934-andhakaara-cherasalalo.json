  },
  "main_stanza": {
    "telugu": [
      "అంధకార చెరసాలలో",
      "బంధకాల ఇరుకులో",
      "పౌలు సీలలు ప్రార్ధించిరి",
      "కీర్తనలు పాడిరి",
      "భూమియే కంపించెను",
      "చెరసాల అదిరెను",
      "వారి సంకెళ్లు ఊడిపోయెను",
      "విడుదల దొరికెను"
    ],
    "english": [
      "Andhakaara cherasaalalo",
      "bandhakaala irukulo",
      "paulu seelalu praardhinchiri",
      "keerthanalu paadiri",
      "bhoomiey kampinchenu",
      "cherasaala adhirenu",
      "vaari sankellu oodipoyenu",
      "vidudhala dhorikenu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "వ్యాధులు ఆవరించగా",
        "మరణము తరుముచుండగా",
        "రండి పారి పొదుము",
        "ఇంక దాగి యుందుము",
        "ఏ తెగులు దరిచేరని",
        "ఏ దిగులు ఉండని",
        "మన దాగుస్థలములో",
        "యేసుని సన్నిధిలో",
        "ప్రార్ధన చేసేదము",
        "దేవుని సముఖములో",
        "ఈ శోధన సమయములో",
        "విరిగిన హృదయముతో",
        "ఈ లోక రక్షణకై",
        "జనముల స్వస్థతకై",
        "యేసుని వేడెదము",
        "శోకము తొలగించమని",
        "మొరలను ఆలకించును",
        "యేసు మనలను విడిపించును",
        "ఈ లోకమును శుద్ధిచేయును",
        "మరణమును తప్పించును",
        "మన రక్షణ వలయముగా",
        "తన రెక్కలు చాపును",
        "దుఃఖమును సంతోషముగా",
        "మార్చివేయును త్వరలో"
      ],
      "english": [
        "Vyaadhulu aavarinchagaa",
        "maranamu tharumuchundagaa",
        "randi paaripodhumu",
        "inka dhaagiyundhumu",
        "ey thegulu dharicherani",
        "ey dhigulu undani",
        "mana dhaagu sthalamulo",
        "yesuni sannidhilo",
        "Prarthana chesedhamu",
        "dhevuni samukamulo",
        "ee shodhana samayamulo",
        "virigina hrudhayamutho",
        "ee loka rakshankai",
        "janamula swasthathakai",
        "yesuni vededhamu",
        "shokamu tholaginchamani",
        "Moralanu aalakinchunu",
        "yesu manalanu vidipinchunu",
        "ee lokamunu shuddhi cheyunu",
        "maranamunu thappinchunu",
        "mana rakshana valayamuga",
        "thana rekkalu chaapunu",
        "dhukkamunu santhoshamuga",
        "maarchiveyunu thwaralo"
      ]
    }
  ]
}
