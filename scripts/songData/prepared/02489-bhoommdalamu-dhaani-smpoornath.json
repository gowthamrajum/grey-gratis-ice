    {
      "stanza_number": 7,
      "telugu": [
        "ఇలలో మహా మహిమంబు గలిగిన యీ రాజెవఁడు",
        "బలశౌర్యముల యెహోవ బహుశూరుడౌ యెహోవ"
      ],
      "english": [
