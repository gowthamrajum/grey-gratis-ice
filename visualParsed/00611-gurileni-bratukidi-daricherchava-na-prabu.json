  },
  "main_stanza": {
    "telugu": [
      "గురిలేని బ్రతుకిది దరిచేర్చవా నా ప్రభూ",
      "నీ తోడు లేక నే సాగలేను నీ నీడనే కోరితి"
    ],
    "english": [
      "Gurileni brathukidhi dharicherchavaa naa Prabhoo",
      "Nee thodu leka ne saagalenu nee needane korithi"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గాలికెగరు పొట్టువంటిది నిలకడలేని నా బ్రతుకు",
        "అంతలోనే మాయమగును ఆవిరివంటి నా బ్రతుకు"
      ],
      "english": [
        "Gaalikegaru pottuvantidhi nilakadaleni naa brathuku",
        "Anthalone maayamagunu aaviriventi naa brathuku"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "వాడిపోయి రాలిపోవును పువ్వులాంటి నా బ్రతుకు",
        "చిటికెలో చితికిపోవును బుడగవోలె నా బ్రతుకు"
      ],
      "english": [
        "Vaadipoyi raalipovunu puvvulaanti naa brathuku",
        "Chitikelo chithikipovunu budagavole naa brathuku"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "కలకాలం నిలుచునది ప్రభువా నీ దివ్వ వాక్యం",
        "నిత్యజీవమొసగునది పరిశుద్ధుడా నీ నామం"
      ],
      "english": [
        "Kalakaalam niluchunadhi Prabhuvaa nee divya vaakyam",
        "Nithyajeevamosagunadhi parishuddhudaa nee naamam"
      ]
    }
  ]
