  },
  "main_stanza": {
    "telugu": [
      "ప్రజలమే వేగమె రారె నిజదైవమును కనుగొనరె||"
    ],
    "english": [
      "Prajalame vegame raare nijadhaivamunu kanugonare||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "పాపాత్ములనబడు వారి భారంబు దీయనుగోరి",
        "ప్రభుయేసు జూపినదారి పరమందు సుఖమిడుదారి  ||ప్రజలమే||"
      ],
      "english": [
        "Paapaathmulanabadu vaari bhaarambu dheeyanugori",
        "Prabhuyesu joopinadhaari paramandu sukhamidudhaari  ||Prajalame||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఏ జాతివారలనైనన్ యే దేశవాసులనైనన్",
        "యేమైన బేధము లేక యేసయ్య బ్రోచునువేగ  ||ప్రజలమే||"
      ],
      "english": [
        "E jaathivaaralanainan e dheshavaasulanainan",
        "Emaina bedhamu leka Yesayya brochunuvega  ||Prajalame||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పాపాత్ములే తన సుతులు ప్రభు యేసునికి స్నేహితులు",
        "నీ పాపమెల్లను బోయెన్ నీకింక మోక్షము కలుగున్  ||ప్రజలమే||"
      ],
      "english": [
        "Paapaathmule thana suthulu Prabhu Yesuniki snehithulu",
        "Nee paapamellanu boyen neekinka mokshamu kalugun  ||Prajalame||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "ప్రయాసపడి భారమును మోసెడు ఓ ప్రజలారా",
        "ప్రభుయేసుక్రీస్తే మీకు విశ్రాంతి నిచ్చునురండి  ||ప్రజలమే||"
      ],
      "english": [
        "Prayaasapadi bhaaramunu mosedu o prajalaaraa",
        "Prabhuyesukreesthe meeku vishraanthi nichchunurandi  ||Prajalame||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "యేసయ్యగాకను వేరే యెవరైన లేరిక రారే",
        "దోషంబులలెల్నను బాపి ఆశీర్వదించునుగాచి  ||ప్రజలమే||"
      ],
      "english": [
        "Yesayyagaakanu vere evaraina lerika raare",
        "Dhoshambulanellanu baapi aasheervadhinchunugaachi  ||Prajalame||"
      ]
    }
  ]
