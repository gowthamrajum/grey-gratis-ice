  "main_stanza": {
    "telugu": [
      "వేల్పులలో బహుఘనుడా యేసయ్యా",
      "నిను సేవించువారిని ఘనపరతువు (2)",
      "నిను ప్రేమించువారికి సమస్తము",
      "సమకూర్చి జరిగింతువు. . . .",
      "నీయందు భయభక్తి గల వారికీ",
      "శాశ్వత క్రుపనిచ్చేదవు. . . . ||వేల్పులలో||"
    ],
    "english": [
      "Velpulalo bahughanudaa Yesayya",
      "Ninu sevinchuvaarini ghanaparathuvu (2)",
      "Ninu preminchuvaariki samasthamu",
      "Samakoorchi jariginthuvu. . . .",
      "Neeyandhu bhayabhakthi gala vaarikee",
      "Shaashwatha krupanichchedhavu. . . . ||Velpulalo||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "సుందరుడైన యోసేపును అంధకార బంధువర్గాలలో",
        "పవిత్రునిగ నిలిపావు ఫలించేడి కొమ్మగ చేసావు (2)",
        "మెరుగుపెట్టి నను దాచావు నీ అంబుల పొదిలో",
        "ఘనవిజయమునిచ్చుట కొరకు తగిన సమయములో (2)  ||వేల్పులలో||"
      ],
      "english": [
        "Sundharudaina Yosepunu andhakaara bandhuvargaalalo",
        "Pavithruniga nilipaavu phalinchedi kommaga chesaavu (2)",
        "Merugupetti nanu daachaavu nee ambula podhilo",
        "Ghanavijayamunichchuta koraku thagina samayamulo (2)  ||Velpulalo||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ఉత్తముడైన దావీదును ఇరుకులేని విశాల స్ధలములో",
        "ఉన్నత కృపతో నింపావు ఉహించని స్దితిలో నిలిపావు (2)",
        "విలువపెట్టి నను కొన్నావు నీ అమూల్య రక్తముతో",
        "నిత్య జీవమునిచ్చుటకొరకు మహిమ రాజ్యములో (2)  ||వేల్పులలో||"
      ],
      "english": [
        "Utthamudaina Daaveedhunu irukuleni vishaala sthalamulo",
        "Unnatha krupatho nimpaavu oohinchani sthithilo nilipaavu (2)",
        "Viluvapetti nanu konnaavu nee amoolya rakthamutho",
        "Nithya jeevamunichchutakoraku mahima raajyamulo (2)  ||Velpulalo||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పామరుడైన సీమోనును కొలతలేని అత్మాభిషేకముతో",
        "ఆజ్ఞనము తొలగించావు విజ్ఞాన సంపదనిచ్చావు (2)",
        "పేరుపెట్టి నను పిలిచావు నిను పోలినడుచుటకు",
        "చెప్పశక్యముకాని ప్రహర్షముతో నిను స్తుతించేదను (2)  ||వేల్పులలో||"
      ],
      "english": [
        "Paamarudaina Seemonunu kolathaleni aathmaabhishekamutho",
        "Agnaanamu tholaginchaavu vignaana sampadhanichchaavu (2)",
        "Perupetti nanu pilichaavu ninu polinaduchutaku",
        "Cheppashakyamukaani praharshamutho ninu sthuthinchedanu (2)  ||Velpulalo||"
      ]
    }
  ]
