      "యేసే ఆరాధ్యుడు నా యేసే ప్రాణ ప్రియుడు"
    ],
    "english": [
      "Yammaayi daarulalo, krungina velalalo",
      "Naa Yesu nadichenugaa naa kannulu terichenugaa",
      "Yese ajeyudu naa Yese sajeevudu hallelooya",
      "Yese aaraadhyudu naa Yese praana priyudu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
