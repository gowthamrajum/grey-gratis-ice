  "main_stanza": {
    "telugu": [
      "ఓ యేసు భక్తులారా,",
      "మీ రాజు ధ్వజము",
      "గ్రహించి సాహసించి",
      "పోరాడి గెల్వుఁడీ",
      "విశ్వాసులార, రండి",
      "మీ రక్షణార్థమై",
      "ప్రయాసపడ్డ యేసు",
      "విజయ మిచ్చును."
    ],
    "english": [
      "O Yesu bhakthulaaraa,",
      "Mee raaju dhvajamu",
      "Grahinchi saahasinchi",
      "Poraadi gelvudee",
      "Vishvaasulaara, randi",
      "Mee rakshanaarthamai",
      "Prayaasapadda Yesu",
      "Vijaya michchunu."
    ]
  },
  "stanzas": [
    {
      "stanza_number": 2,
      "telugu": [
        "మీయం దసూయఁ బట్టి",
        "మీ యాత్మ నాశము",
        "నెన్నండుఁ గోరునట్టి",
        "యనేకు లుందురు",
        "మీ రెల్ల రేసు పేరు",
        "వచించి యాయనే",
        "సర్వాధికారి యంచు",
        "సేవింపవలెను."
      ],
      "english": [
        "Meeyam dasooya batti",
        "Mee yaathma naashamu",
        "Nennandu gorunatti",
        "Aneku lunduru",
        "Mee rella resu peru",
        "Vachinchi yaayane",
        "Sarvaadhikaari yanchu",
        "Sevimpavalenu."
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రచండ మైన దండు",
        "పోరాడ లేచినన్",
        "విరోధి శక్తి కొద్ది",
        "మరీ తెగించుఁడీ",
        "స్వకీయ శక్తిఁగాక",
        "శ్రీ యేసు నామమున్",
        "స్మరించి వానియందు",
        "విశ్వాస ముంచుండీ."
      ],
      "english": [
        "Prachanda maina dandu",
        "Poraada lechinan",
        "Virodhi shakthi koddi",
        "Maree theginchudee",
        "Svakeeya shakthigaaka",
        "Shree Yesu naamamun",
        "Smarinchi vaaniyandhu",
        "Vishwaasa munchundee."
      ]
