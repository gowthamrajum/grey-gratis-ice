    "english": [
      "Baalakula Vinnapamu Laalinchu Rakshakaa",
      "Paalanambu Saeyumaa Parama Poashakaa"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "బాలలారా రండియంచు బిలిచిన యేసూ",
