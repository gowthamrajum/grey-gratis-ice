  "main_stanza": {
    "telugu": [
      "నీతోడు చాలయ్య నా బలము నీవయ్యా",
      "నా నిరీక్షణాస్పదం నీవే యేసయ్య"
    ],
    "english": [
      "Neethodu chaalayya naa balamu neevayyaa",
      "naa nireekshanaaspadham neeve yesayya"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "తరములకైనా యుగములకైనా నీవే ఆధారం",
        "ఆశ్రయం ఆనందం నీవే నా ప్రభువా"
      ],
      "english": [
        "Tharamulakainaa yugamulakainaa neeve aadhaaram",
        "aasrayam aanandam neeve naa prabhuva"
      ]
