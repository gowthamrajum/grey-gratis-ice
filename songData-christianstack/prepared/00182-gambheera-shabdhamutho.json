{
  "song_name": "Gambheera Shabdhamutho",
  "author": {
    "Authored by": "Martin Luther King MV",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "గంభీర శబ్దముతో పాడేదను",
      "నేను ఆనంద ధ్వనితో పొగడేదను",
      "లెక్కించలేని మేళ్ళను తలచి",
      "పొగడి పాడి కీర్తితును"
    ],
    "english": [
      "Gambheera shabdamutho padedhanu",
      "Nenu anandha dhvanitho pogadedhanu",
      "Lekkichaleni mellanu thalachi",
      "Pogadi paadi keerthithunu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "ఇక్కట్లో నేను నిన్ను పిలువగానే",
        "వేగమే వచ్చి నన్ను తప్పించితివే",
        "నీ రెక్కలలో దాచి నన్ను",
        "కనుపాపల నిత్యం కాయుచున్నావు"
      ],
      "english": [
        "Ikkatlo nenu ninnu piluvagane",
        "Vegame vacchi nannu thappinchithivi",
        "Nee rekkalalo dhaachi nannu",
        "Kanupapalu nithyam kaayuchunnavu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నే కన్నులెత్తి నిన్ను చూడగానే",
        "బలమునిచ్చి నన్ను రక్షించితివి",
        "నీ కౌగిలిలో కాచి నన్ను",
        "కాపరిల నిత్యం మోయుచున్నావు"
      ],
      "english": [
        "Ne kannu lethhi ninnu choodagane",
        "Balamunichchi nannu rakshinchithivi",
        "Nee kaugililo kaachi nannu",
        "Kaaparila nithyam moyuchunnavu"
      ]
    }
  ]
}
