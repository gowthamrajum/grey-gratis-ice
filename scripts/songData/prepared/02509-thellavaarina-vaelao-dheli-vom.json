  "main_stanza": {
    "telugu": [
      "తెల్లవారిన వేళఁ దెలి వొంది",
      "మన క్రీస్తు దివ్య నామముఁ బాడెరె",
      "యో ప్రియులార దివస రక్షణ వేఁడరే",
      "తల్లి రొమ్మున దాఁచు పిల్ల రీతిని మనలఁ",
      "జల్లదనముగ రాతి రెల్లఁ గాచిన విభునిఁ"
    ],
    "english": [
      "Thellavaarina Vaela Dheli Vondhi",
      "Mana Kreesthu Dhivya Naamamu Baadere",
      "Yoa Priyulaara Dhivasa Rakshana Vaedarae",
      "Thalli Rommuna Dhaachu Pilla Reethini Manala",
      "Jalladhanamuga Raathi Rella Gaachina Vibhuni"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
