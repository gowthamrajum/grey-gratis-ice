{
  "song_name": "Yesunaadhaa raaraaraa maa jeevanaadhaa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": [
      "ఫిలిప్ బెంజమిన్"
    ]
  },
  "main_stanza": {
    "telugu": [
      "యేసునాధా రారారా మా జీవనాధా రారారా||"
    ],
    "english": [
      "Yesunaadhaa raaraaraa maa jeevanaadhaa raaraaraa||"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దోసములు బాప నీవు వాసిగ జన్మించినావు  ||యేసునాధా||"
      ],
      "english": [
        "Dhosamulu baapa neevu vaasiga janminchinaavu  ||Yesunaadhaa||"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీచులను బ్రేమించి నీ కరుణఁ జూపినావు  ||యేసునాధా||"
      ],
      "english": [
        "Neechulanu breminchi nee karuna joopinaavu  ||Yesunaadhaa||"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "నీతిలేని వారి కెల్ల నిత్యజీవ మిచ్చినావు  ||యేసునాధా||"
      ],
      "english": [
        "Neethileni vaari kella nithyajeeva michchinaavu  ||Yesunaadhaa||"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "పొందరాని కష్టములను బొంది యుంటివి తండ్రి  ||యేసునాధా||"
      ],
      "english": [
        "Pondharaani kashtamulanu bondhi yuntivi thandri  ||Yesunaadhaa||"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "లోకపాపమును జయించి లోకుల రక్షించితివి  ||యేసునాధా||"
      ],
      "english": [
        "Lokapaapamunu jayinchi lokula rakshinchithivi  ||Yesunaadhaa||"
      ]
    },
    {
      "stanza_number": 6,
      "telugu": [
        "వేడుకతోడ మేము వేఁడుకొందుమో తండ్రి  ||యేసునాధా||"
      ],
      "english": [
        "Vedukathoda memu vedukondhumo thandri  ||Yesunaadhaa||"
      ]
    }
  ]
}
