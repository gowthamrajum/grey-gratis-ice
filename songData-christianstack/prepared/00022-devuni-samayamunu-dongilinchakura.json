{
  "song_name": "Devuni Samayamunu Dongilinchakura",
  "author": {
    "Authored by": "D.Isaac Gnana Raj",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "దేవుని సమయమును దొంగిలించకురా",
      "ఆరాధన సమయం దేనికి ఇవ్వకురా",
      "ఆరోగ్యం ఆయుష్కాలం దేవుని దానమే",
      "దేవుని సమయమును దొంగిలించకురా"
    ],
    "english": [
      "Devuni samayamunu dongilinchakura",
      "Aaraadhana samayam dheniki ivvakura",
      "Aarogyam aayushkaalam devuni daaname",
      "Devuni samayamunu dongilinchakura"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "దేవుని భాగమును దాచుకొనకురా",
        "దేవుని యొద్దనే దొంగిలించెదవా",
        "దేవుడే నిన్ను కాపాడనిచో",
        "ఎప్పుడో కాలము చేసియుందువు"
      ],
      "english": [
        "Devuni bhaagamunu daachukonakura",
        "Devuni yoddhane dongilinchedhava",
        "Devude ninnu kaapaadanicho",
        "Eppudo kaalamu chesiyunduvu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్షణమైన నిన్ను విడవక కాపాడు",
        "దేవుని సన్నిధికి పరుగున రాలేవా",
        "సంతోషముగా పరుగున వచ్చి",
        "కృతజ్ఞతను చూపలేవా"
      ],
      "english": [
        "Kshanamaina ninnu vidavaka kaapaadu",
        "Devuni sannidhiki paruguna raaleva",
        "Santhoshamuga paruguna vachhi",
        "Kruthagnathanu choopaleva"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "పనులెన్నియున్నా పేరంటాలకు",
        "సెలవైనా పెట్టి పరుగున పోతావు",
        "ప్రాణం పెట్టిన దేవుడు నీకు",
        "ప్రియమైన వాడు కాదా"
      ],
      "english": [
        "Panulenniyunna perantaalaku",
        "Selavaina petti paruguna pothaavu",
        "Praanam pettina devudu neeku",
        "Priyamaina vaadu kaada"
      ]
    }
  ]
}
