      "english": [
        "Katina dhuhkha baadhal - Kaligina norchuchu",
        "Vibhavaanandha praapthi - Labhimpagoruchu",
        "Aa swarga pankthijeri - Yaanandha mondhuchun",
        "Ee sangha mesu goodi - Vishraanthi bondhunu"
