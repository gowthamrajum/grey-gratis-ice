{
  "song_name": "Kreesthu Yesu vachchunu aayaththamuga nundudi",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "క్రీస్తు యేసు వచ్చును ఆయత్తముగ నుండుడి",
      "సూచనలు చూపుచున్నవి - వేచియుండుడి ఆయనకై"
    ],
    "english": [
      "Kreesthu Yesu vachchunu aayaththamuga nundudi",
      "Soochanalu choopuchunnavi - Vechiyundudi aayanakai"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "రక్షణ సంపూర్తిచేయుటకై - అక్షయుడేసు వచ్చును",
        "అక్షణ పొందిన వారెల్లరు - తక్షణమే ఎత్తబడెదరు"
      ],
      "english": [
        "Rakshana sampoorthicheyutakai - Akshayudesu vachchunu",
        "Rakshana pondina vaarellaru - Thakshaname eththabadedharu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "పరిశుద్ధులందు మహిమ నొంద - పరమ యేసు వచ్చును",
        "పరిశుద్ధులు వింతపడునట్లు - అరయునేసు వేగమే"
      ],
      "english": [
        "Parishudhdhulandhu mahima nondha - Parama Yesu vachchunu",
        "Parishuddhulu vinthapadunatlu - Arayunesu vegame"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "మరుగైనవి బయలు పరచ - వరుడు యేసు వచ్చును",
        "హృదయ ఆలోచనలెల్ల - సదయుడు బయలుపరచును"
      ],
      "english": [
        "Marugainavi bayalu paracha - Varudu Yesu vachchunu",
        "Hrudaya aalochanalella - Sadhayudu bayaluparachunu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "వేయేండ్ల పాలన చేయుటకై - రయముగ యేసు వచ్చును",
        "సర్వరాజ్యములు అన్నియు - సర్వేశుడేసుని రాజ్యమగున్"
      ],
      "english": [
        "Veyendla paalana cheyutakai - Rayamuga Yesu vachchunu",
        "Sarvaraajyamulu anniyu - Sarveshudesuni raajyamagun"
      ]
    }
  ]
}
