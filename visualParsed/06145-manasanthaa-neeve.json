  "main_stanza": {
    "telugu": [
      "మనసంతా నీవే - ఊహల్లో నీవే",
      "కనుపాపలో నీవే - నా జీవం నీవే"
    ],
    "english": [
      "Manasanthaa neeve - Oohallo neeve",
      "Kanupaapalo neeve - Naa jeevam neeve"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "నరనరములో నీవే - నా సర్వం నీవే",
        "హృదయంలో నీవే - యెసయ్యా నీవే",
