  "main_stanza": {
    "telugu": [
      "కాపాడును నన్ను కాపాడును",
      "కాలమంతా నన్ను కాపాడును",
      "కలత చెందను నేను కలవరపడను",
      "కడవరకు నన్ను కాపాడునే"
    ],
    "english": [
      "Kaapaadunu nannu kaapaadunu",
      "kaalamanthaa nannu kaapaadunu",
      "kalatha chendhanu nenu kalavarapadunu",
      "kadavaraku annu kaapaadune"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "హల్లెలూయ హల్లెలూయ నా యేసయ్యకె హల్లెలూయ",
        "స్తోత్రమే స్తోత్రమే నా యేసయ్యకె స్తోత్రము"
      ],
      "english": [
        "Hallelujah Hallelujah naa yesayyake Hallelujah",
        "sthothrame sthothrame naa yesayyake sthothramu"
      ]
    }
  ]
}
