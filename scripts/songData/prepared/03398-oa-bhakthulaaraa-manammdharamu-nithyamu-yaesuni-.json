{
  "song_name": "Oa Bhakthulaaraa Manamandharamu Nithyamu Yaesuni Sthuthiyinchedhamu",
  "author": {
    "Authored by": "",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "ఓ భక్తులారా మనమందరము నిత్యము యేసుని స్తుతియించెదము"
    ],
    "english": [
      "Oa Bhakthulaaraa Manamandharamu Nithyamu Yaesuni Sthuthiyinchedhamu"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "గత కాలమున మన ప్రభుయేసు",
        "నూతన దీవెనలను - ఖ్యాతిగా నొసగే మనకు",
        "స్తుతియించెద మేసుని",
        "నూతన అనుభవములను - ఖ్యాతిగా సర్వశక్తుని"
      ],
      "english": [
        "Gatha Kaalamuna Mana Prabhuyaesu",
        "Noothana Dheevenalanu - Khyaathigaa Nosagae Manaku",
        "Sthuthiyinchedha Maesuni",
        "Noothana Anubhavamulanu - Khyaathigaa Sarvashakthuni"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "శక్తిమంతుడు మన ప్రభు యేసు",
        "నిత్యమును దీవించును - రక్షించును మనలను తానే",
        "సంపూర్ణముగా కాయున్",
        "సత్యవంతుడు మన ప్రభువు - మాట తప్పని మహారాజు"
      ],
      "english": [
        "Shakthimanthudu Mana Prabhu Yaesu",
        "Nithyamunu Dheevinchunu - Rakshinchunu Manalanu Thaanae",
        "Sampoornamugaa Kaayun",
        "Sathyavanthudu Mana Prabhuvu - Maata Thappani Mahaaraaju"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఎన్ని శోధనలు భువినున్న",
        "తానే మనలను విడిపించును - శోధింపబడెను యేసు",
        "తన సహాయము నొసగున్",
        "కనుపాపవలె ప్రభువు కాయున్ - నిత్యము నిలుచు మనతో"
      ],
      "english": [
        "Enni Shoadhanalu Bhuvinunna",
        "Thaanae Manalanu Vidipinchunu - Shoadhimpabadenu Yaesu",
        "Thana Sahaayamu Nosagun",
        "Kanupaapavale Prabhuvu Kaayun - Nithyamu Niluchu Manathoa"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "శక్తిమంతుడు మన ప్రభు యేసు",
        "తొట్రిల్లకుండ కాపాడును - నిర్దోషులనుగా ప్రభువు",
        "నిలుపును తన మహిమతో",
        "తలచుము తన కృపలను - ఎన్నడు విడువడు మనల"
      ],
      "english": [
        "Shakthimanthudu Mana Prabhu Yaesu",
        "Thotrillakunda Kaapaadunu - Nirdhoashulanugaa Prabhuvu",
        "Nilupunu Thana Mahimathoa",
        "Thalachumu Thana Krupalanu - Ennadu Viduvadu Manala"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "కృంగిన భక్తులారా మీరు",
        "భంగపర్చు శత్రువుపై జగముపై చాటుడి - జయము",
        "జయము జయమని ప్రభుకే",
        "యుగ యుగములు మన ప్రభుకే - హల్లెలూయ గీతములతో"
      ],
      "english": [
        "Krungina Bhakthulaaraa Meeru",
        "Bhangaparchu Shathruvupai Jagamupai Chaatudi - Jayamu",
        "Jayamu Jayamani Prabhukae",
        "Yuga Yugamulu Mana Prabhukae - Hallelooya Geethamulathoa"
      ]
    }
  ]
}
