      "english": [
        "Pentaga kanupinche ee lokamanthayu",
        "Prabhuni chooda naa hrudayamu aashapadinadhi"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "తీర్చును ఆకలిని జీవాహారంబుతో",
        "తృప్తిని యిచ్చినాకు తన శాంతి నొసగును"
      ],
      "english": [
        "Theerchunu aakalini jeevaahaarambutho",
        "Thrupthini ichchinaaku thana shaanthi nosagunu"
