{
  "song_name": "Ichchunatti Vidhamu Theliyandi",
  "author": {
    "Authored by": "",
    "రచన": "బన్యన్ జోసఫ్"
  },
  "main_stanza": {
    "telugu": [
      "ఇచ్చునట్టి విధము తెలియండి ప్రియులారా",
      "మీరు హెచ్చు పొందు విధము ఇది నుండి",
      "పుచ్చుకొనుట కన్న నెప్పు డిచ్చుటయే కడు ధన్యత యని",
      "హెచ్చరించి చెప్పలేదా యేసు ప్రభు వపొస్తలులకు"
    ],
    "english": [
      "Ichchunatti Vidhamu Theliyandi Priyulaaraa",
      "Meeru Hechchu Pondhu Vidhamu Idhi Nundi",
      "Puchchukonuta Kanna Neppu Dhichchutayae Kadu Dhanyatha Yani",
      "Hechcharinchi Cheppalaedhaa Yaesu Prabhu Vaposthalulaku"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "శక్తికొలఁది దాన మీయుండి సోదరులార",
        "భక్తికొలఁది పరుల కీయుఁ డి శక్తి లేదని",
        "సాకు చెప్పక సణగ కేమియు సరగ శ్రద్ధా సక్తితో",
        "పేదలకు నిచ్చుట యుక్త మని భావించి మదిలో"
      ],
      "english": [
        "Shakthikoladhi Dhaana Meeyundi Soadharulaara",
        "Bhakthikoladhi Parula Keeyu Di Shakthi Laedhani",
        "Saaku Cheppaka Sanaga Kaemiyu Saraga Shraddhaa Sakthithoa",
        "Paedhalaku Nichchuta Yuktha Mani Bhaavinchi Madhiloa"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "నీతిబోధలు చేయువారికి బోధకులైన",
        "నిఖల పాలకులైన వారికి ఆతురముతో నీయవలెనని",
        "యనుభవముగల మీరలెల్లరు చేతులార నీయు డయ్య",
        "ప్రీతి తోడును వారవార"
      ],
      "english": [
        "Neethiboadhalu Chaeyuvaariki Boadhakulaina",
        "Nikhala Paalakulaina Vaariki Aathuramuthoa Neeyavalenani",
        "Yanubhavamugala Meeralellaru Chaethulaara Neeyu Dayya",
        "Preethi Thoadunu Vaaravaara"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ఆలయ కృత్యములు జరిగించు యాజకుఁ డెపుడు",
        "నాలయంబువలన జీవించు ప్రాలుమాలక పనిని జేయఁ",
        "బరఃగ మీ యర్పణలఁ గాన్కల బలవంతము లేక",
        "మీరు పలువిధంబు నియ్య వెదకుడి"
      ],
      "english": [
        "Aalaya Kruthyamulu Jariginchu Yaajaku Depudu",
        "Naalayambuvalana Jeevinchu Praalumaalaka Panini Jaeya",
        "Barahga Mee Yarpanala Gaankala Balavanthamu Laeka",
        "Meeru Paluvidhambu Niyya Vedhakudi"
      ]
    }
  ]
}
