      ],
      "english": [
        "Visthaara jalapravaahamulu porlinanu",
        "Nishchayamugaa navi vaari meediki raavu"
      ]
    },
    {
      "stanza_number": 8,
      "telugu": [
        "నాకు దాగుచోటు నీవే శ్రమలో నుండి",
