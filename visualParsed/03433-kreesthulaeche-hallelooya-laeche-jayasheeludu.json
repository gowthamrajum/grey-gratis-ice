  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "క్రీస్తులేచె! హల్లెలూయ! లేచె జయశీలుడు!",
        "స్తోత్రమైన హల్లెలూయ! క్రీస్తు మళ్ళీ లేచెను",
        "చూచి మళ్ళీ తనకాంతి - హృదుల్ నాయనన్",
        "చింతవీడి సంతసాన వంగి క్రీస్తునెదుట",
        "క్రీస్తులేచె! హల్లెలూయ! లేచె జయశీలుడు!",
        "స్తోత్రమైన హల్లెలూయ! క్రీస్తు మళ్ళీ లేచెను"
      ],
      "english": [
        "Kreesthuleche! hallelooya! leche jayasheeludu!",
        "Sthothramaina hallelooya! Kreesthu mallee lechenu",
        "Choochi mallee thanakaanthi - Hrudul naayanan",
        "Chinthaveedi santhasaana vangi Kreesthunedhuta",
        "Kreesthuleche! hallelooya! leche jayasheeludu!",
        "Sthothramaina hallelooya! Kreesthu mallee lechenu"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "క్రీస్తులేచె! మండలపు - చింతయంత తీరెను!",
        "హర్ష ద్వార మొప్పదీసి - మళ్ళీ జీవ మొందెను",
        "చావు నరకాలు మ్రొక్కి - దూతలెల్ల గల్వను",
        "కోట్లు చుట్టు కాంతి గూడ - లేచెనిప్డు శూరుడు"
      ],
      "english": [
        "Kreesthuleche! mandalapu - Chinthayantha theerenu!",
        "Harsha dhvaara moppadheesi - Mallee jeeva mondenu",
        "Chaavu narakaalu mrokki - Doothalella galvanu",
        "Kotlu chuttu kaanthi gooda - Lechenipdu shooradu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "క్రీస్తులేచె! నాటి వంత - యంత యంత మొందెను",
        "నేడు గొప్ప హర్షమాయె - క్రీస్తు లేచినందునన్",
        "శుద్ధ భూసమాధి తొలి - పంటను గల్గించెను",
        "వింతగన్ సజీవుడాయె - బోయిమళ్ళి కన్పడెన్"
      ],
      "english": [
        "Kreesthuleche! naati vantha - Yantha yantha mondenu",
        "Nedu goppa harshamaaye - Kreesthu lechinandhunan",
        "Shuddha bhoosamaadhi tholi - Pantanu galginchenu",
        "Vinthagan sajeevudaaye - Boyimalli kanpaden"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "క్రీస్తులేచె! నింక చావు! నరకాల భయము",
        "లేనె లేదు! క్రీస్తు నందు నన్ని గెల్చినారము",
        "మా భయాదులన్ని పోయి - శంకదిగులుంబాసె",
        "నేడు పునరుత్థానంపు - దీవెనల నొందుదము"
      ],
      "english": [
        "Kreesthuleche! ninka chaavu! narakaala bhayamu",
        "Lene ledu! Kreesthu nandu nanni gelchinaaramu",
        "Maa bhayaadhulanni poyi - Shankadhigulumbaase",
        "Nedu punarutthaanampu - Dheevenala nondhudhamu"
      ]
    }
  ]
}
