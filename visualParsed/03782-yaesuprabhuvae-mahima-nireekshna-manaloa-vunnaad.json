    {
      "stanza_number": 6,
      "telugu": [
        "ప్రభు యేసు మహిమతో వచ్చునప్పుడు మనలను కొనిపోవును",
        "శుభప్రదనిరీక్షణ కలిగిన మనము ఎదురుచూచెదము"
      ],
      "english": [
        "Prabhu Yesu mahimatho vachchunappudu manalanu konipovunu",
        "Shubhapradhanireekshana kaligina manamu edhuruchoochedhamu"
      ]
