{
  "song_name": "Nee Prema Naalo",
  "author": {
    "Authored by": "Pastor John Wesley",
    "రచన": ""
  },
  "main_stanza": {
    "telugu": [
      "నీ ప్రేమ నాలో మధురమైనది",
      "అది నా ఊహకందని క్షేమ శిఖరము",
      "ఏరి కోరుకున్నావు ప్రేమ చూపి నన్ను",
      "పరవశించి నాలో మహిమపరతు నిన్నే",
      "సర్వ కృపానిధి నీవు – సర్వాధికారివి నీవు",
      "సత్యా స్వరూపివి నీవు – ఆరాధింతును నిన్నే"
    ],
    "english": [
      "Nee prema naalo madhuramainadhi",
      "adi naa oohakandhani kshema sikharamu",
      "eri korukunnaavu prema choopi nannu",
      "paravasinchi naalo mahimaparathu ninne",
      "sarva krupaanidhi neevu – sarvaadhikaarivi neevu",
      "sathyaa swaroopivi neevu – aaraadhinthunu ninne"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "చేరితిని నిన్నే విరిగిన మనస్సుతో – కాదనలేదే నా మనవును నీవు",
        "హృదయం నిండిన గానం – నను నడిపే ప్రేమ కావ్యం",
        "నిరతము నాలో నీవే – చెరగని దివ్య రూపం",
        "ఇది నీ బహు బంధాల అనుబంధమా",
        "తేజోవిరాజా స్తుతి మహిమలు నీకే",
        "నా యేసురాజా ఆరాధన నీకే",
        "నా ప్రతి పదములో జీవము నీవే",
        "నా ప్రతి అడుగులో విజయము నీవే",
        "ఎన్నడు విడువని ప్రేమ – నిను చేరే క్షణము రాదా",
        "నీడగా నాతో నిలిచే – నీ కృపయే నాకు చాలును",
        "ఇది నీ ప్రేమ కురిపించు హేమంతమా",
        "తేజోవిరాజా స్తుతి మహిమలు నీకే",
        "నా యేసురాజా ఆరాధన నీకే",
        "నీ సింహాసనము నను చేర్చుటకు",
        "సిలువను మోయుట నేర్పించితివి",
        "కొండలు లోయలు దాటే – మహిమాత్మతో నింపినావు",
        "దయగల ఆత్మతో నింపి – సమభూమిపై నడిపినావు",
        "ఇది నీ ఆత్మ బంధముకై సంకేతమా",
        "తేజోవిరాజా స్తుతి మహిమలు నీకే",
        "నా యేసురాజా ఆరాధన నీకే"
      ],
      "english": [
        "Cherithini ninne virigina manasutho",
        "kaadhanaledey naa manavunu neevu",
        "hrudhayam nindina gaanam – nanu nadipe prema kaavyam",
        "nirathamu naalo neeve – cheragani divya roopam",
        "idi nee bahu bandhaala anubandhamaa",
        "thejoviraajaa sthuthi mahimalu neeke",
        "naa yesuraajaa aaraadhana neeke",
        "Naa prathi padhamulo jeevamu neeve",
        "naa prathi adugulo vijayamu neeve",
        "ennadu viduvani prema – ninu cherey kshanamu raadhaa",
        "needagaa naatho niliche – nee krupa ey naaku chaalunu",
        "idi nee prema kuripinchu hemanthamaa",
        "thejoviraajaa sthuthi mahimalu neeke",
        "naa yesuraajaa aaraadhana neeke",
        "Nee simhaasanamu nanu cherchutaku",
        "siluvanu moyuta nerpinchithivi",
        "kondalu loyalu dhaatey – mahimaathmatho nimpinaavu",
        "dayagala aathmato nimpi – samabhoomipai nadipinaavu",
        "idi nee aathma bandhamukai sankethamaa",
        "thejoviraajaa sthuthi mahimalu neeke",
        "naa yesuraajaa aaraadhana neeke"
      ]
    }
  ]
}
