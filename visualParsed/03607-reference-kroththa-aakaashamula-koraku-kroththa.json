{
  "song_name": "Reference: kroththa aakaashamula koraku kroththa",
  "source": "wtc",
  "author": {
    "Authored by": [],
    "రచన": []
  },
  "main_stanza": {
    "telugu": [
      "వెళ్ళెదము కూడి వెళ్ళెదము",
      "శ్రేష్ఠ దేశమును చేరుటకు - నీతి నివసించును అందున"
    ],
    "english": [
      "Velledamu koodi velledamu",
      "Shreshta dheshamunu cherutaku - Neethi nivasinchunu andhuna"
    ]
  },
  "stanzas": [
    {
      "stanza_number": 1,
      "telugu": [
        "భయమును కలిగి బ్రతికెదము - పరదేశులమని యెరుగవలె",
        "ప్రవేశించ వలె విశ్రాంతిలో - తప్పిపోదుము మరచినచో"
      ],
      "english": [
        "Bhayamunu kaligi brathikedhamu - Paradheshulamani erugavale",
        "Praveshincha vale vishraanthilo - Thappipodhumu marachinacho"
      ]
    },
    {
      "stanza_number": 2,
      "telugu": [
        "ప్రభువాజ్ఞలను పాలించుటకు - ప్రయాస పడెదము మనమిలలో",
        "పదిలముగా అంతము వరకు - పడిపోకుండా చూచుకొందుము"
      ],
      "english": [
        "Prabhuvaagnalanu paalinchutaku - Prayaasa padedhamu manamilalo",
        "Padilamugaa anthamu varaku - Padipokundaa choochukondhumu"
      ]
    },
    {
      "stanza_number": 3,
      "telugu": [
        "ప్రభువు మన కప్పగించినవి - పట్టుకొని మనముండెదము",
        "దుష్టుని బారిని తప్పించుకో - దోచుకొన నివ్వకు మకుటము"
      ],
      "english": [
        "Prabhuvu mana kappaginchinavi - Pattukoni manamundedhamu",
        "Dhushtuni baarini thappinchuko - Dhochukona nivvaku makutamu"
      ]
    },
    {
      "stanza_number": 4,
      "telugu": [
        "సుళువుగా ఉరియొడ్డు - ప్రతి పాపమున్ - సంపూర్ణముగను తొలగించుచు",
        "సహనముతోడ పరుగెత్తుచు - స్వర్గ దేశము చేరవలెన్"
      ],
      "english": [
        "Suluvugaa uriyoddu - Prathi paapamun - Sampoornamuganu tholaginchuchu",
        "Sahanamuthodha parugeththuchu - Swarga deshamu cheravalen"
      ]
    },
    {
      "stanza_number": 5,
      "telugu": [
        "సంపూర్ణత పొందసాగెదము - సమర్పించుకొని పూర్ణముగా",
        "సహించిన కష్టదుఃఖములు - బహుగా ఫల మొందెదము"
      ],
      "english": [
        "Sampoornatha pondhasaagedhamu - Samarpinchukoni poornamugaa",
        "Sahinchina kashtadhuhkhamulu - Bahugaa phala mondhedhamu"
      ]
    }
  ]
}
